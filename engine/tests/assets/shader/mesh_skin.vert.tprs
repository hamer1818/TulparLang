// kaynak-ozet: f6fc1b17d6b1  (engine/rhi/shaders/mesh_skin.vert)
// Iskeletli (GPU skinning) mesh: mesh.vert'in 4 eklem/4 agirlik surumu.
// G3 (sabit boy dizi) + SSBO kullanir.
str asama = "vert";

vec3 in_pos = girdi(0);
vec2 in_nrm_oct = girdi(1);
vec2 in_uv = girdi(2);
uvec4 in_joints = girdi(3);
vec4 in_weights = girdi(4); // UNORM16, toplam 1

struct Frame {
  mat4 viewproj;
  mat4 view;
  mat4[3] light_viewproj;
  vec4 light_dir;
  vec4 ambient;
  vec4 shadow_params;
  vec4 cluster_params;
  uvec4 cluster_grid;
  vec4 cascade_params;
}
Frame u = tekduze(0, 0);

struct Skin { mat4[] m; }
Skin u_skin = depo(0, 4);

struct Push { mat4 model; vec4 color; uvec4 skin; }
Push pc = itme();

vec3 v_nrm = cikti(0);
vec3 v_color = cikti(1);
vec2 v_uv = cikti(2);
vec3 v_world = cikti(3);
float v_viewz = cikti(4);

func oct_decode(vec2 e): vec3 {
  vec3 n = vec3(e.x, e.y, 1.0 - abs(e.x) - abs(e.y));
  float t = max(-n.z, 0.0);
  n.x += n.x >= 0.0 ? -t : t;
  n.y += n.y >= 0.0 ? -t : t;
  return normalize(n);
}
func main() {
  mat4 skin = in_weights.x * u_skin.m[pc.skin.x + in_joints.x] + in_weights.y * u_skin.m[pc.skin.x + in_joints.y] +
              in_weights.z * u_skin.m[pc.skin.x + in_joints.z] + in_weights.w * u_skin.m[pc.skin.x + in_joints.w];
  mat4 ms = pc.model * skin;
  vec4 world = ms * vec4(in_pos, 1.0);
  gl_Position = u.viewproj * world;
  vec3 wn = normalize(mat3(ms) * oct_decode(in_nrm_oct));
  v_nrm = wn;
  v_color = pc.color.rgb;
  v_uv = in_uv;
  v_world = world.xyz;
  v_viewz = -(u.view * world).z;
}
