// kaynak-ozet: 99071685c1c6  (engine/rhi/shaders/ui_sdf.frag)
// SDF METIN ORNEKLEME. Kapsama smoothstep ile mesafeden; gecis genisligi
// EKRAN UZAYI turevinden (fwidth) gelir.
str asama = "frag";

float kSharpness = ozel(0, 1.0); // gecis genisligi carpani (spec sabiti)

vec2 v_uv = girdi(0);
vec4 v_color = girdi(1);
float v_encode = girdi_duz(2);

sampler2D u_atlas = ornek(1, 0);
vec4 o_color = cikti(0);

func srgb_to_linear(vec3 c): vec3 {
  return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(0.04045, c));
}
func linear_to_srgb(vec3 c): vec3 {
  c = clamp(c, 0.0, 1.0);
  return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(0.0031308, c));
}
func main() {
  float d = texture(u_atlas, v_uv).a;
  float w = max(fwidth(d) * kSharpness, 1e-5);
  float a = smoothstep(0.5 - w, 0.5 + w, d);
  vec4 c = vec4(srgb_to_linear(v_color.rgb), v_color.a * a);
  if (v_encode > 0.5) { c.rgb = linear_to_srgb(c.rgb); }
  o_color = c;
}
