// kaynak-ozet: 769826224d83  (engine/rhi/shaders/post.vert)
// Tam ekran ucgeni (vertex tamponu YOK): 3 kose, gl_VertexIndex'ten uretilir.
// G1 (f32) ve G4 (bit islemleri) kullanir — ikisi de bugunku Tulpar'da YOK.
str asama = "vert";

vec2 v_uv = cikti(0);

func main() {
  vec2 p = vec2(f32((gl_VertexIndex << 1) & 2), f32(gl_VertexIndex & 2));
  v_uv = p;
  gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
}
