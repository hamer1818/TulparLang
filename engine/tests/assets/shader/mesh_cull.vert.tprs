// kaynak-ozet: c077a1446cbe  (engine/rhi/shaders/mesh_cull.vert)
// DOLAYLI (indirect) yolun vertex shader'i. mesh.vert ile AYNI aritmetik.
// G3 kullanir.
str asama = "vert";

vec3 in_pos = girdi(0);
vec2 in_nrm_oct = girdi(1); // oktahedral SNORM16x2
vec2 in_uv = girdi(2);

struct Frame {
  mat4 viewproj;
  mat4 view;
  mat4[3] light_viewproj;
  vec4 light_dir;
  vec4 ambient;
  vec4 shadow_params;
  vec4 cluster_params;
  uvec4 cluster_grid;
  vec4 cascade_params;
}
Frame u = tekduze(0, 0);

struct DrawItem {
  mat4 model;
  vec4 color;
  vec4 sphere;
  uvec4 misc;
}
struct Draws { DrawItem[] d; }
Draws u_draws = depo(0, 5);
struct Visible { uint[] v; }
Visible u_vis = depo(0, 6);

struct Push { mat4 model; vec4 color; uvec4 skin; }
Push pc = itme();

vec3 v_nrm = cikti(0);
vec3 v_color = cikti(1);
vec2 v_uv = cikti(2);
vec3 v_world = cikti(3);
float v_viewz = cikti(4);

func oct_decode(vec2 e): vec3 {
  vec3 n = vec3(e.x, e.y, 1.0 - abs(e.x) - abs(e.y));
  float t = max(-n.z, 0.0);
  n.x += n.x >= 0.0 ? -t : t;
  n.y += n.y >= 0.0 ? -t : t;
  return normalize(n);
}
func main() {
  DrawItem D = u_draws.d[u_vis.v[pc.skin.z + u32(gl_InstanceIndex)]];
  vec4 world = D.model * vec4(in_pos, 1.0);
  gl_Position = u.viewproj * world;
  vec3 wn = normalize(mat3(D.model) * oct_decode(in_nrm_oct));
  v_nrm = wn;
  v_color = D.color.rgb;
  v_uv = in_uv;
  v_world = world.xyz;
  v_viewz = -(u.view * world).z;
}
