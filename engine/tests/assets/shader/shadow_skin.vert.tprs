// kaynak-ozet: ded42b3a1ccb  (engine/rhi/shaders/shadow_skin.vert)
// Golge haritasi, iskeletli: shadow.vert + 4 eklem karisimi. G3 kullanir.
str asama = "vert";

vec3 in_pos = girdi(0);
uvec4 in_joints = girdi(3);
vec4 in_weights = girdi(4);

struct Frame {
  mat4 viewproj;
  mat4 view;
  mat4[3] light_viewproj;
  vec4 light_dir;
  vec4 ambient;
  vec4 shadow_params;
  vec4 cluster_params;
  uvec4 cluster_grid;
  vec4 cascade_params;
}
Frame u = tekduze(0, 0);

struct Skin { mat4[] m; }
Skin u_skin = depo(0, 4);

struct Push { mat4 model; vec4 color; uvec4 skin; }
Push pc = itme();

func main() {
  mat4 skin = in_weights.x * u_skin.m[pc.skin.x + in_joints.x] + in_weights.y * u_skin.m[pc.skin.x + in_joints.y] +
              in_weights.z * u_skin.m[pc.skin.x + in_joints.z] + in_weights.w * u_skin.m[pc.skin.x + in_joints.w];
  gl_Position = u.light_viewproj[pc.skin.y] * pc.model * skin * vec4(in_pos, 1.0);
}
