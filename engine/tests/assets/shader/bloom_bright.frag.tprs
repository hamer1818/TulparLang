// kaynak-ozet: 19cb17936375  (engine/rhi/shaders/bloom_bright.frag)
// bloom_bright.frag'in Tulpar alt kumesi karsiligi (FAZ 8 fizibilite).
// SECICI bloom'un esigi: yalniz esigin USTUNDEKI enerji zincire girer.
str asama = "frag";

vec2 v_uv = girdi(0);

sampler2D u_src = ornek(0, 0);
sampler2D u_src2 = ornek(0, 1); // kullanilmaz (ortak duzen)

struct Push {
  vec4 texel; // xy: 1/kaynak0, zw: 1/kaynak1
  vec4 p;     // x: esik, y: yumusak diz
  vec4 q;     // x: cozunurluk olcegi
}
Push pc = itme();

vec4 o_color = cikti(0);

func main() {
  vec2 uv = clamp(v_uv * pc.q.x, pc.texel.xy * 0.5, vec2(pc.q.x) - pc.texel.xy * 0.5);
  vec3 c = texture(u_src, uv).rgb;
  float luma = dot(c, vec3(0.2126, 0.7152, 0.0722));
  float knee = max(pc.p.y, 1e-4);
  float soft = clamp(luma - pc.p.x + knee, 0.0, 2.0 * knee);
  soft = soft * soft / (4.0 * knee);
  float w = max(soft, luma - pc.p.x) / max(luma, 1e-4);
  o_color = vec4(c * w, 1.0);
}
