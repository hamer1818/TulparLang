// N x N kayan nokta matris carpimi (matmul.c ile ayni algoritma + veri yapisi).
// Diziler TEK CAGRIDA ayriliyor (array_fill), oteki dillerdeki gibi.
int n = toInt(env("BENCH_N"));
if (n <= 0) { n = 256; }
float[] a = array_fill(n * n, 0.0);
float[] b = array_fill(n * n, 0.0);
float[] c = array_fill(n * n, 0.0);
for (int i = 0; i < n; i = i + 1) {
    for (int j = 0; j < n; j = j + 1) {
        a[i * n + j] = toFloat(mod(i + j, 10));
        b[i * n + j] = toFloat(mod(i * j, 7));
    }
}
for (int i = 0; i < n; i = i + 1) {
    for (int k = 0; k < n; k = k + 1) {
        float av = a[i * n + k];
        for (int j = 0; j < n; j = j + 1) { c[i * n + j] = c[i * n + j] + av * b[k * n + j]; }
    }
}
float t = 0.0;
for (int i = 0; i < n * n; i = i + 1) { t = t + c[i]; }
print(toInt(t));
