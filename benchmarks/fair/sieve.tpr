int n = toInt(env("BENCH_N"));
if (n <= 0) { n = 5000000; }
// Oteki dillerin hepsi diziyi TEK CAGRIDA ayiriyor (vec![0;n],
// make([]int32,n), [0]*n, new Int32Array(n)); Tulpar'da da karsiligi var.
array f = array_fill(n + 1, 0);
int c = 0;
int i = 2;
while (i <= n) {
    if (f[i] == 0) {
        c = c + 1;
        int k = i * i;
        while (k <= n) { f[k] = 1; k = k + i; }
    }
    i = i + 1;
}
print(c);
