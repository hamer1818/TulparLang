// ============================================
// Tulpar Tame — 2D Oyun Kütüphanesi
// "Tulpar'ın T'si, Game'in ame'si." 🎮
//
// Native katman: aot_tm_* builtin'leri (runtime/tame_bindings.cpp +
// runtime/tame_impl.c — vendored raylib, lib/raylib/). Bu dosya o katmanın
// üstündeki ergonomik sarmalayıcıdır: kısa isimler, adlı renkler, ufak
// oyun yardımcıları. `import "tame"` eden program otomatik olarak
// libtulpar_tame.a ile linklenir; tame kullanmayan binary'ler pencere/GL
// bağımlılığı almaz.
//
// Kullanım:
//   import "tame";
//   window(800, 450, "Oyunum");
//   while (running()) {
//       frame_begin();
//       clear(DARKBLUE);
//       rect(100, 100, 50, 50, GOLD);
//       text("merhaba!", 20, 20, 24, WHITE);
//       frame_end();
//   }
//   close_window();
//
// Renkler paketlenmiş int'tir: 0xRRGGBBAA. rgb(r,g,b) / rgba(r,g,b,a) ile
// üret ya da aşağıdaki adlı renkleri (raylib paleti) kullan.
// Koordinatlar int veya float olabilir — native katman ikisini de kabul eder.
// ============================================

// ---- Pencere / döngü -------------------------------------------------------

// Oyun penceresini açar (varsayılan hedef 60 FPS). Görüntü ortamı yoksa
// false döner ve stderr'e açıklama basılır.
func window(w, h, title): bool { return tm_window(w, h, title); }

// Ana oyun döngüsünün koşulu: pencere açık ve kapatılmak istenmemiş.
// (Varsayılan olarak ESC veya pencere kapatma düğmesi döngüyü bitirir.)
func running(): bool { return tm_running(); }

// Pencereyi kapatır (döngüden sonra çağır).
func close_window() { tm_close(); }

// Hedef kare hızını değiştirir (varsayılan 60).
func set_fps(n) { tm_set_fps(n); }

// Kare çizimini başlat / bitir. frame_end() ekrana basar ve FPS bekler.
func frame_begin() { tm_begin(); }
func frame_end() { tm_end(); }

func get_fps(): int { return tm_fps(); }

// Son karenin süresi (saniye) — kare-bağımsız hareket için hızla çarp:
//   x = x + 120.0 * frame_time();
func frame_time(): float { return tm_frame_time(); }

// Pencere açıldığından beri geçen süre (saniye).
func elapsed(): float { return tm_time(); }

func screen_width(): int { return tm_width(); }
func screen_height(): int { return tm_height(); }

// Görünür ekranın DÜNYA koordinatındaki kenarları. Masaüstü/web'de 0..w / 0..h;
// Android'de oyun dünyası ekrana ortalandığı için sol/üst NEGATİF, sağ/alt
// dünyadan BÜYÜK olabilir. Dokunmatik butonları gerçek ekran kenarına
// demirlemek için kullan (arcade bunu otomatik yapar).
func view_left(): float    { return tm_view_left(); }
func ekran_sol(): float    { return tm_view_left(); }
func view_right(): float   { return tm_view_right(); }
func ekran_sag(): float    { return tm_view_right(); }
func view_top(): float     { return tm_view_top(); }
func ekran_ust(): float    { return tm_view_top(); }
func view_bottom(): float  { return tm_view_bottom(); }
func ekran_alt(): float    { return tm_view_bottom(); }

// İvmeölçer (telefonu eğerek kontrol). m/s^2; Android'de gerçek sensör,
// masaüstü/web'de 0. accel_available() ile sensör var mı öğren.
func accel_x(): float      { return tm_accel_x(); }
func egim_x(): float       { return tm_accel_x(); }
func accel_y(): float      { return tm_accel_y(); }
func egim_y(): float       { return tm_accel_y(); }
func accel_z(): float      { return tm_accel_z(); }
func egim_z(): float       { return tm_accel_z(); }
func accel_available(): bool { return tm_accel_available(); }
func egim_var(): bool      { return tm_accel_available(); }

// Uygulama önde/odakta mı (arka plana atılınca false).
func is_active(): bool     { return tm_active(); }
func aktif_mi(): bool      { return tm_active(); }

// Dosyasız ses efekti: freq Hz sinüs, ms milisaniye. Kısa oyun sesleri için.
func beep(freq, ms)        { tm_beep(freq, ms); }
func bip(freq, ms)         { tm_beep(freq, ms); }
// tone/ton: ses-seviyeli beep (vol 0..1) — kısık arka plan müziği notaları için.
func tone(freq, ms, vol)   { tm_tone(freq, ms, vol); }
func ton(freq, ms, vol)    { tm_tone(freq, ms, vol); }

// ---- Çizim -----------------------------------------------------------------
// Hepsi frame_begin() ile frame_end() arasında çağrılır.

func clear(color) { tm_clear(color); }
func rect(x, y, w, h, color) { tm_rect(x, y, w, h, color); }
func rect_lines(x, y, w, h, color) { tm_rect_lines(x, y, w, h, color); }
func circle(x, y, radius, color) { tm_circle(x, y, radius, color); }
func line(x1, y1, x2, y2, color) { tm_line(x1, y1, x2, y2, color); }
func pixel(x, y, color) { tm_pixel(x, y, color); }
func text(s, x, y, size, color) { tm_text(s, x, y, size, color); }

// ---- Girdi -----------------------------------------------------------------
// Tuş adları: "A".."Z", "0".."9", "SPACE", "ENTER", "ESC", "TAB",
// "BACKSPACE", "DELETE", "LEFT", "RIGHT", "UP", "DOWN", "SHIFT", "CTRL",
// "ALT", "HOME", "END", "PAGEUP", "PAGEDOWN", "F1".."F12" (büyük/küçük fark etmez).

func key_down(k): bool { return tm_key_down(k); }       // şu an basılı mı
func key_pressed(k): bool { return tm_key_pressed(k); } // bu karede basıldı (tek tetik)
func key_released(k): bool { return tm_key_released(k); }

// Fare düğmeleri: 0 = sol, 1 = sağ, 2 = orta.
func mouse_x(): int { return tm_mouse_x(); }
func mouse_y(): int { return tm_mouse_y(); }
func mouse_down(b): bool { return tm_mouse_down(b); }
func mouse_pressed(b): bool { return tm_mouse_pressed(b); }
func mouse_wheel(): float { return tm_mouse_wheel(); }

// Dokunma (mobil). Çok parmak desteklenir; parmak index'i 0'dan başlar.
// Masaüstünde raylib tek dokunuşu fareye maplediği için mouse_* de çalışır,
// ama mobilde ASIL girdi budur. touched()/dokunuldu(): en az bir parmak var mı.
func touch_count(): int { return tm_touch_count(); }
func dokunma_sayisi(): int { return tm_touch_count(); }
func touch_x(i): int { return tm_touch_x(i); }
func dokunma_x(i): int { return tm_touch_x(i); }
func touch_y(i): int { return tm_touch_y(i); }
func dokunma_y(i): int { return tm_touch_y(i); }
func touched(): bool { return tm_touch_count() > 0; }
func dokunuldu(): bool { return tm_touch_count() > 0; }

// Gamepad (id 0'dan başlar). Butonlar adla: "A"/"B"/"X"/"Y" (Xbox) veya
// "CROSS"/"CIRCLE"/"SQUARE"/"TRIANGLE" (PS), "UP"/"DOWN"/"LEFT"/"RIGHT",
// "LB"/"RB" ("L1"/"R1"), "LT"/"RT" ("L2"/"R2"), "START"/"SELECT"/"GUIDE",
// "L3"/"R3". Eksenler: "LX"/"LY"/"RX"/"RY" (-1..1), "LT"/"RT" (tetik).
func gamepad_available(id): bool { return tm_gamepad_available(id); }
func gamepad_name(id): str { return tm_gamepad_name(id); }
func gamepad_down(id, btn): bool { return tm_gamepad_down(id, btn); }
func gamepad_pressed(id, btn): bool { return tm_gamepad_pressed(id, btn); }
func gamepad_axis(id, axis): float { return tm_gamepad_axis(id, axis); }

// ---- Sprite / texture (Faz 3) ----------------------------------------------
// Kaynaklar int handle'dır (-1 = yükleme başarısız). window() sonrası yükle;
// close_window() canlı kalan her şeyi kendisi bırakır.

func load_texture(path): int { return tm_load_texture(path); }
func draw_texture(tex, x, y) { tm_draw_texture(tex, x, y); }
// scale: 1.0 = orijinal boyut; rotation: derece (saat yönü).
func draw_texture_ex(tex, x, y, scale, rotation) { tm_draw_texture_ex(tex, x, y, scale, rotation); }
func texture_width(tex): int { return tm_texture_width(tex); }
func texture_height(tex): int { return tm_texture_height(tex); }
func unload_texture(tex) { tm_unload_texture(tex); }

// TTF/OTF font (boyut yüklemede sabitlenir; en iyi sonuç için çizim boyutuyla
// aynı tut).
func load_font(path, size): int { return tm_load_font(path, size); }
func text_font(f, s, x, y, size, color) { tm_text_font(f, s, x, y, size, color); }
// Varsayılan fontla yazının piksel genişliği — ortalamak için:
//   text(s, (screen_width() - measure_text(s, 24)) / 2, y, 24, WHITE);
func measure_text(s, size): int { return tm_measure_text(s, size); }

// ---- Ses / müzik (Faz 4) -----------------------------------------------------
// Ses aygıtı ilk load_sound/load_music'te otomatik açılır. Çalan müzik
// stream'leri frame_end() içinde otomatik beslenir — update çağrısı gerekmez.

func load_sound(path): int { return tm_load_sound(path); }
func play_sound(s) { tm_play_sound(s); }
func stop_sound(s) { tm_stop_sound(s); }
func sound_volume(s, v) { tm_sound_volume(s, v); }

func load_music(path): int { return tm_load_music(path); }
func play_music(m) { tm_play_music(m); }
func stop_music(m) { tm_stop_music(m); }
func music_volume(m, v) { tm_music_volume(m, v); }

// ---- Kalıcı kayıt + titreşim (mobil-dostu) ----------------------------------
// save/load: Android'de uygulamanın internal storage'ına, masaüstünde çalışma
// dizinine yazar/okur — AYNI oyun kodu her platformda kalıcı kayıt alır.
// İçerik düz metin: skor için toString/toInt yeterli. Dosya yoksa "" döner.
func save_data(name, text): bool { return tm_save_data(name, text); }
func kayit_yaz(name, text): bool { return tm_save_data(name, text); }
func load_data(name): str { return tm_load_data(name); }
func kayit_oku(name): str { return tm_load_data(name); }
// Titreşim: Android'de cihazı ms milisaniye titretir; masaüstü/web no-op.
func vibrate(ms) { tm_vibrate(ms); }
func titret(ms)  { tm_vibrate(ms); }

// ---- Ek çizim / araç ----------------------------------------------------------

// Dolu üçgen — köşe sırası önemsiz (sarım otomatik düzeltilir).
func triangle(x1, y1, x2, y2, x3, y3, color) { tm_triangle(x1, y1, x2, y2, x3, y3, color); }

// Pencerenin anlık görüntüsünü PNG olarak kaydeder. Not: raylib dosyayı
// her zaman ÇALIŞMA DİZİNİNE yazar; path'teki dizin kısmı kırpılır
// (yalnız dosya adı kullanılır).
func screenshot(path) { tm_screenshot(path); }

// ---- 3D (Faz 0) ---------------------------------------------------------------
// Tek küresel Camera3D + temel primitifler. Kare akışı:
//   window(...); ... begin(); clear(BLACK);
//   camera3d(0,4,8, 0,0,0, 45);   // göz, hedef, FOV
//   space_begin();                // 3D moda gir
//     grid(10, 1);                // referans ızgarası
//     cube(0,0,0, 2,2,2, GOLD);   // dolu küp
//     cube_wires(0,0,0, 2,2,2, BLACK);
//   space_end();                  // 3D modu bitir → sonrası 2D HUD
//   text("Skor", 10, 10, 20, WHITE);
//   end();

// Kamerayı konumla: göz (px,py,pz), bakış hedefi (tx,ty,tz), dikey FOV (derece).
func camera3d(px, py, pz, tx, ty, tz, fov) { tm3_camera(px, py, pz, tx, ty, tz, fov); }
func kamera3d(px, py, pz, tx, ty, tz, fov) { tm3_camera(px, py, pz, tx, ty, tz, fov); }

// 3D çizim modunu başlat/bitir (kamerayı bağlar / çözer).
func space_begin() { tm3_begin(); }
func uzay_basla()  { tm3_begin(); }
func space_end()   { tm3_end(); }
func uzay_bitir()  { tm3_end(); }

// Merkezi (x,y,z), boyutu (w,h,d) olan dolu küp/kutu.
func cube(x, y, z, w, h, d, color) { tm3_cube(x, y, z, w, h, d, color); }
func kup(x, y, z, w, h, d, color)  { tm3_cube(x, y, z, w, h, d, color); }

// Tel-çerçeve küp/kutu.
func cube_wires(x, y, z, w, h, d, color) { tm3_cube_wires(x, y, z, w, h, d, color); }
func kup_tel(x, y, z, w, h, d, color)    { tm3_cube_wires(x, y, z, w, h, d, color); }

// XZ düzleminde referans ızgarası.
func grid(slices, spacing)   { tm3_grid(slices, spacing); }
func izgara(slices, spacing) { tm3_grid(slices, spacing); }

// -- Faz 1 primitifleri --
// Dolu küre (merkez x,y,z; yarıçap r).
func sphere(x, y, z, r, color) { tm3_sphere(x, y, z, r, color); }
func kure(x, y, z, r, color)   { tm3_sphere(x, y, z, r, color); }

// Tel-çerçeve küre (seg = halka/dilim sayısı, ör. 12).
func sphere_wires(x, y, z, r, seg, color) { tm3_sphere_wires(x, y, z, r, seg, color); }
func kure_tel(x, y, z, r, seg, color)     { tm3_sphere_wires(x, y, z, r, seg, color); }

// Taban (x,y,z)'de duran dikey silindir (yarıçap r, yükseklik h).
func cylinder(x, y, z, r, h, color) { tm3_cylinder(x, y, z, r, h, color); }
func silindir(x, y, z, r, h, color) { tm3_cylinder(x, y, z, r, h, color); }

// XZ düzleminde dolu düzlem/zemin (merkez x,y,z; boyut sx×sz).
func plane(x, y, z, sx, sz, color)  { tm3_plane(x, y, z, sx, sz, color); }
func duzlem(x, y, z, sx, sz, color) { tm3_plane(x, y, z, sx, sz, color); }

// 3D uzayda çizgi.
func line3d(x1, y1, z1, x2, y2, z2, color) { tm3_line(x1, y1, z1, x2, y2, z2, color); }
func cizgi3d(x1, y1, z1, x2, y2, z2, color) { tm3_line(x1, y1, z1, x2, y2, z2, color); }

// -- Faz 1 raycast (fare/dokunuş ile tıklama-seçim) --
// Ekran (mx,my)'den kamera ışını ile kutuya/küreye tıklama testi.
// Vurursa çarpışma mesafesini (>=0), ıskalarsa -1 döner. Oyun kodu
// "en küçük pozitif mesafe = tıklanan nesne" ile seçim yapar.
func pick_box(mx, my, bx, by, bz, bw, bh, bd): float { return tm3_pick_box(mx, my, bx, by, bz, bw, bh, bd); }
func sec_kutu(mx, my, bx, by, bz, bw, bh, bd): float { return tm3_pick_box(mx, my, bx, by, bz, bw, bh, bd); }
func pick_sphere(mx, my, cx, cy, cz, r): float { return tm3_pick_sphere(mx, my, cx, cy, cz, r); }
func sec_kure(mx, my, cx, cy, cz, r): float    { return tm3_pick_sphere(mx, my, cx, cy, cz, r); }

// -- Faz 1 vec3 skaler yardımcıları (saf Tulpar) --
// Vektör uzunluğu ve iki nokta arası mesafe (Tulpar'da struct dönüşü yok,
// bu yüzden bileşenler ayrı skaler geçer).
func vec3_len(x, y, z): float { return sqrt(x * x + y * y + z * z); }
func vec3_dist(ax, ay, az, bx, by, bz): float {
    float dx = ax - bx;
    float dy = ay - by;
    float dz = az - bz;
    return sqrt(dx * dx + dy * dy + dz * dz);
}

// -- Faz 2: model yükleme / üretme / çizim / animasyon --
// Dosyadan model yükle (OBJ/GLTF/GLB/IQM) — gömülü animasyonlar da yüklenir.
func load_model(path): int  { return tm3_load_model(path); }
func model_yukle(path): int { return tm3_load_model(path); }

// Prosedürel mesh üreteçleri (dosyasız) → model handle. GenMesh* örtüleri.
func gen_cube(w, h, d): int          { return tm3_gen(0, w, h, d, 0); }
func gen_kup(w, h, d): int           { return tm3_gen(0, w, h, d, 0); }
func gen_sphere(r, rings, slices): int { return tm3_gen(1, r, rings, slices, 0); }
func gen_kure(r, rings, slices): int   { return tm3_gen(1, r, rings, slices, 0); }
func gen_plane(w, len, rx, rz): int  { return tm3_gen(2, w, len, rx, rz); }
func gen_duzlem(w, len, rx, rz): int { return tm3_gen(2, w, len, rx, rz); }
func gen_cylinder(r, h, slices): int { return tm3_gen(3, r, h, slices, 0); }
func gen_silindir(r, h, slices): int { return tm3_gen(3, r, h, slices, 0); }
func gen_torus(radius, size, seg, sides): int { return tm3_gen(4, radius, size, seg, sides); }
func gen_cone(r, h, slices): int     { return tm3_gen(5, r, h, slices, 0); }
func gen_koni(r, h, slices): int     { return tm3_gen(5, r, h, slices, 0); }
func gen_knot(radius, size, seg, sides): int  { return tm3_gen(6, radius, size, seg, sides); }

// Modeli çiz (dokusu varsa dokulu). tint = renk maskesi (WHITE = dokunun aynısı).
func draw_model(h, x, y, z, scale, tint) { tm3_draw_model(h, x, y, z, scale, tint); }
func model_ciz(h, x, y, z, scale, tint)  { tm3_draw_model(h, x, y, z, scale, tint); }

// Y ekseni etrafında yaw (derece) döndürerek çiz.
func draw_model_rot(h, x, y, z, yaw, scale, tint) { tm3_draw_model_rot(h, x, y, z, yaw, scale, tint); }
func model_ciz_don(h, x, y, z, yaw, scale, tint)  { tm3_draw_model_rot(h, x, y, z, yaw, scale, tint); }

// Yüklü dokuyu (load_texture handle'ı) modele bağla.
func model_texture(h, tex) { tm3_model_texture(h, tex); }
func model_doku(h, tex)    { tm3_model_texture(h, tex); }

// Animasyon: sayı / kare-sayısı / pozu uygula / sil.
func anim_count(h): int         { return tm3_anim_count(h); }
func anim_sayisi(h): int        { return tm3_anim_count(h); }
func anim_frames(h, idx): int   { return tm3_anim_frames(h, idx); }
func anim_kare_sayisi(h, idx): int { return tm3_anim_frames(h, idx); }
func anim_play(h, idx, frame)   { tm3_anim(h, idx, frame); }
func anim_oynat(h, idx, frame)  { tm3_anim(h, idx, frame); }
func unload_model(h) { tm3_unload_model(h); }
func model_sil(h)    { tm3_unload_model(h); }

// -- Faz 4: ışıklandırma --
// Gömülü Blinn-Phong shader (asset dosyası yok; masaüstü GL3.3 + web/Android
// GLES2 varyantları derleyicinin içinde). Açtığın anda küp/küre/silindir/
// düzlem ve modeller ışık alır — düz renk yerine gölgeli yüzeyler.
//
//   window(800, 450, "3D");
//   lights_on();                                  // varsayılan güneş gelir
//   sun(0.0-0.6, 0.0-1.0, 0.0-0.4, WHITE);        // yönlü ışık (YÖN verilir)
//   point_light(1, 3.0, 4.0, 2.0, GOLD);          // slot 1: nokta ışık
//   ambient_light(rgb(40, 44, 60));               // taban aydınlık
//
// En çok 4 ışık (slot 0-3). type: 0 = yönlü (güneş), 1 = nokta.
func lights_on(): bool  { return tm3_lights(1); }
func isik_ac(): bool    { return tm3_lights(1); }
func lights_off() { tm3_lights(0); }
func isik_kapat() { tm3_lights(0); }

// Yönlü ışık (güneş): (x,y,z) YÖNdür, konum değil. Slot 0'a yazar.
func sun(x, y, z, color)   { tm3_light_set(0, 0, x, y, z, color); }
func gunes(x, y, z, color) { tm3_light_set(0, 0, x, y, z, color); }

// Nokta ışık: (x,y,z) dünya KONUMU. idx = slot (0-3).
func point_light(idx, x, y, z, color) { tm3_light_set(idx, 1, x, y, z, color); }
func nokta_isik(idx, x, y, z, color)  { tm3_light_set(idx, 1, x, y, z, color); }

// Yönlü ışığı istediğin slota koymak istersen (sun() slot 0'ı kullanır).
func dir_light(idx, x, y, z, color) { tm3_light_set(idx, 0, x, y, z, color); }
func yonlu_isik(idx, x, y, z, color) { tm3_light_set(idx, 0, x, y, z, color); }

func light_off(idx) { tm3_light_off(idx); }
func isik_sil(idx)  { tm3_light_off(idx); }

// Ortam ışığı — hiçbir ışığın vurmadığı yüzeylerin taban rengi.
func ambient_light(color) { tm3_ambient(color); }
func ortam_isik(color)    { tm3_ambient(color); }

// -- Gölgeler (yönlü ışık / güneş için shadow mapping) --
// lights_on()'dan SONRA çağır. Nesneler zemine gölge düşürür → "yerde duruyor"
// hissi. Donanım derinlik dokusu desteklemiyorsa false döner, gölgeler kapalı
// kalır ve ışıklandırma çalışmaya devam eder (sessizce bozulmaz).
//
//   lights_on();
//   sun(0.0-0.6, 0.0-1.0, 0.0-0.4, WHITE);
//   shadows_on();
//   shadow_area(24.0);     // kapsanan alanın yarı-genişliği
//
// NOT: gölge açıkken sahne iki kez çizilir (ışık gözünden + kameradan), yani
// maliyeti vardır. Mobilde ağır gelirse shadow_area'yı küçült veya kapat.
func shadows_on(): bool  { return tm3_shadows(1); }
func golge_ac(): bool    { return tm3_shadows(1); }
func shadows_off() { tm3_shadows(0); }
func golge_kapat() { tm3_shadows(0); }
func shadow_area(a) { tm3_shadow_area(a); }
func golge_alani(a) { tm3_shadow_area(a); }

// Gölge GERÇEKTEN çalışıyor mu? shadows_on() çağırmış olmak yetmez — donanım
// desteklemiyorsa gölge sessizce kapalı kalır. Oyununda "Gölge: açık" yazacaksan
// bunu sor, kendi bayrağını değil.
func shadows_active(): bool { return tm3_shadows_active(); }
func golge_aktif(): bool    { return tm3_shadows_active(); }

// ---- 3D doku / materyal / gökyüzü ------------------------------------------
//
// Doku bir DURUM'dur: bir kez ayarlarsın, sonraki primitifler onu kullanır.
//
//   int t = load_texture("cimen.png");
//   texture3d(t, 20.0, 20.0);   // zemin boyunca 20x20 döşe
//   plane(0.0, 0.0, 0.0, 60.0, 60.0, WHITE);
//   no_texture3d();             // sonrakiler yine düz renk
//
// Renk (son parametre) dokuyla ÇARPILIR — beyaz ver, doku olduğu gibi çıksın;
// renkli ver, dokuyu boya. Modeller kendi dokularını korur (model_texture).
// Dosyasız damalı doku — zemin/duvar karosu için PNG taşımaya gerek yok.
//   int t = checker(128, 128, 8, rgb(150,158,170), rgb(120,128,142));
func checker(w, h, cells, c1, c2): int { return tm_checker(w, h, cells, c1, c2); }
func damali(w, h, cells, c1, c2): int  { return tm_checker(w, h, cells, c1, c2); }

func texture3d(t, tu, tv) { tm3_texture(t, tu, tv); }
func doku3d(t, tu, tv)    { tm3_texture(t, tu, tv); }
func no_texture3d() { tm3_texture(0 - 1, 1.0, 1.0); }
func doku3d_kapat() { tm3_texture(0 - 1, 1.0, 1.0); }

// Parlaklık: shine = specular üssü (büyük = küçük/keskin parlama, "cilalı";
// küçük = geniş/yayvan, "mat"), spec = parlamanın gücü (0 = tamamen mat).
func material3d(shine, spec) { tm3_material(shine, spec); }
func materyal3d(shine, spec) { tm3_material(shine, spec); }
// Hazır iki uç — çoğu oyunun ihtiyacı bu ikisi.
func matte3d()  { tm3_material(4.0, 0.0); }
func mat3d()    { tm3_material(4.0, 0.0); }
func glossy3d() { tm3_material(48.0, 1.4); }
func parlak3d() { tm3_material(48.0, 1.4); }

// Gökyüzü: kameraya duyarlı gradyan (yukarı bakınca zenit gelir), asset yok.
//   sky(rgb(74, 130, 210), rgb(190, 214, 238));   // tepe, ufuk
func sky(top, bottom): bool     { return tm3_sky(top, bottom); }
func gokyuzu(top, bottom): bool { return tm3_sky(top, bottom); }
func sky_off()        { tm3_sky_off(); }
func gokyuzu_kapat()  { tm3_sky_off(); }

// Mesafe sisi — gökyüzü ile zemin arasındaki sert ufuk çizgisini kapatır ve
// derinlik hissi verir. density: 0.02 hafif pus, 0.06 yoğun sis.
//
//   sky(rgb(58,116,200), rgb(196,220,240));
//   fog_sky(0.03);        // sis rengini gökyüzünün UFKUNDAN al (doğrusu bu)
//
// Kendi rengini vermek istersen fog(renk, yogunluk). Sis ışık shader'ında
// hesaplanır, yani lights_off() ile ışığı kapatırsan sis de çizilmez.
func fog(color, density) { tm3_fog(color, density); }
func sis(color, density) { tm3_fog(color, density); }
func fog_sky(density) { tm3_fog(0 - 1, density); }
func sis_gokyuzu(density) { tm3_fog(0 - 1, density); }
func fog_off() { tm3_fog(0 - 1, 0.0); }
func sis_kapat() { tm3_fog(0 - 1, 0.0); }

// ---- Yönetilen oyun döngüsü (Faz 5) -------------------------------------------
// Wings'in listen() modeli: update/draw fonksiyonlarını verirsin, döngüyü,
// kare zamanlamasını VE kare belleğini tame yönetir — her kare sonunda arena
// checkpoint'e geri sarılır (tek-save-çok-restore deseni), döngü bitince
// checkpoint bırakılır ve pencere kapanır.
//
//   func guncelle() { x = x + 2; }          // oyun mantığı
//   func ciz() { clear(BLACK); rect(x, 100, 50, 50, GOLD); }
//   window(800, 450, "Oyunum");
//   run(guncelle, ciz);
//
// KURAL (wings ile aynı): kareler arası yaşayacak oyun durumunu GLOBAL
// değişkenlerde tut — global'e yazılan değer otomatik kalıcılaşır; update
// içindeki yerel string/objeler kare sonunda geri sarılır.
func run(update_fn, draw_fn) {
    var _tame_wm = arena_save();
    while (tm_running()) {
        call(update_fn, 0);
        tm_begin();
        call(draw_fn, 0);
        tm_end();
        arena_restore(_tame_wm);
    }
    arena_drop(_tame_wm);
    tm_close();
}

// ---- Renkler ---------------------------------------------------------------

// r,g,b,a ∈ [0,255] → paketlenmiş 0xRRGGBBAA int'i.
func rgb(r, g, b): int { return r * 16777216 + g * 65536 + b * 256 + 255; }
func rgba(r, g, b, a): int { return r * 16777216 + g * 65536 + b * 256 + a; }

// raylib paleti — önceden paketlenmiş değerler (a=255).
int LIGHTGRAY = 3368601855;  // 200,200,200
int GRAY = 2189591295;       // 130,130,130
