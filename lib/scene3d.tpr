    _g_tip_for3(9470, "Cogalt  (CTRL+D)  —  davranislariyla");
    if (_g_button(9471, lx + half + 4, y, half, _ED_FLD3, "SIL")) { ed_mark3d(); ed_delete3d(id); }
    _g_tip_for3(9471, "Sil  (DEL)  —  CTRL+Z ile geri alinir");
