// scene3d — Tulpar 3D preset motoru (arcade'in 3D kardeşi).
//
// Saf Tulpar; `tame`'in tm3_* 3D binding'leri üzerine kurulu (C/runtime wiring
// YOK — düzenleyince yalnız `./build.sh clean` re-embed yeter). Felsefe arcade
// ile aynı ama 3D: az kod → çalışan oyun. Fark: entity'ler PARALEL DİZİ değil,
// modern `struct Ent3` DİZİSİ (struct-in-array + alan-yazma artık çalışıyor).
//
// Motor her kare şunu yönetir: girdi → hareket → yerçekimi/zemin → AABB
// çarpışma (+ duvar itme) → takip kamerası → tüm entity'lerin çizimi → HUD.
// Kullanıcı yalnız setup + update + çarpışma kancalarını yazar.
//
// "~20 satırda 3D toplayıcı" hedef API'si (bkz. examples/scene3d_collector.tpr):
//
//   import "scene3d";
//   int player = 0;
//   func setup() {
//       player = spawn3(0,1,0,  1,2,1, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
//       camera_follow(player, 12.0, 8.0);
//       spawn3(4,1,3, 1,1,1, GOLD, SHAPE_SPHERE, TAG_ITEM);
//       spawn3(0,1,-9, 24,3,1, GRAY, SHAPE_CUBE, TAG_WALL);
//   }
//   func update() { move3d(player, 8.0); if (jump_pressed()) { jump3d(player, 10.0); } }
//   func collect()  { kill3d(other3d()); score3d_add(10); }
//   scene3d(900, 520, "3D Toplayici");
//   on_setup3d(setup); on_update3d(update); on_hit3d(TAG_PLAYER, TAG_ITEM, collect);
//   play3d();

import "tame";

// ---- Sabitler --------------------------------------------------------------
int SHAPE_CUBE   = 0;
int SHAPE_SPHERE = 1;
int SHAPE_CYL    = 2;
int SHAPE_MODEL  = 3;
// Rampa: üst yüzeyi kendi yerel +Z yönünde düz yükselen kama. Dünyanın tek düz
// düzlem olma kısıtını kaldırır (bkz. _ramp_floor3). Çizimi kademeli — raylib'de
// kama primitifi yok, gerçek eğik yüzey için üretilmiş mesh (Faz 10) gerekir.
int SHAPE_RAMP   = 4;

int TAG_PLAYER = 1;
int TAG_ITEM   = 2;
int TAG_WALL   = 3;
int TAG_ENEMY  = 4;
int TAG_PROP   = 5;
int TAG_BULLET = 6;

// raylib tuş kodları (tame key constant açığa çıkarmıyor — burada tanımlı).
int K_W = 87;   int K_A = 65;   int K_S = 83;   int K_D = 68;
int K_UP = 265; int K_DOWN = 264; int K_LEFT = 263; int K_RIGHT = 262;
int K_SPACE = 32;
int K_Q = 81;   int K_E = 69;   // kamerayı klavyeyle çevir (fare yedeği)
// Menü/duraklat tuşları. K_NONE (0) raylib'in "çıkış tuşu yok" değeridir —
// exit_key(K_NONE) olmadan ESC pencereyi kapatır ve hiç yakalanamaz.
int K_ESC = 256; int K_ENTER = 257; int K_BACKSPACE = 259;
int K_R = 82;    int K_P = 80;      int K_NONE = 0;
int K_F1 = 290;  int K_F2 = 291;    int K_F3 = 292;
int K_F11 = 300;

float DEG2RAD3 = 0.01745329;
float RAD2DEG3 = 57.29578;

// ---- Entity modeli ---------------------------------------------------------
struct Ent3 {
    float x;  float y;  float z;     // konum (merkez)
    float vx; float vy; float vz;    // hız (birim/sn)
    float sx; float sy; float sz;    // TAM boyut (AABB = s/2 yarı-boyut)
    float yaw;                        // Y dönüşü (derece) — hareket yönüne bakar
    int shape;                        // SHAPE_*
    int model;                        // SHAPE_MODEL ise handle, değilse -1
    // Modelin KAYNAK YOLU ("" = yok / prosedürel mesh). Handle süreç içi bir
    // sayı olduğu için sahne dosyasına yazılabilir olan bu.
    str msrc;
    // Yüzey dokusunun YOLU ("" = düz renk) ve döşeme sıklığı. Model yoluyla
    // aynı gerekçe: yol taşınabilir, handle değil.
    //
    // Bu doku İLKEL cisimler için: kutu, küre, silindir, rampa. Yüklü bir
    // modelin dokusu kendi dosyasından geliyor. raylib'de doku KİPSEL bir
    // durum (çiz-kapat), MODELE ait değil — yani iki varlık aynı şekli
    // paylaşsa bile farklı doku alabiliyor, takas yok.
    str tsrc;
    float ttile;
    int color;                        // paketli renk
    int tag;                          // TAG_*
    int grounded;                     // zeminde mi (zıplama için)
    int alive;                        // 1/0
    // KATI GÖVDE: 1 ise bu entity başkalarının içinden GEÇEMEZ; motor her kare
    // örtüşmeyi çözer. Toplanabilirler (TAG_ITEM) ve mermiler katı DEĞİLDİR —
    // onların işi çarpışma kancasıdır, itilmek değil.
    int solid;
    // -- oynanış alanları (Faz 7) --
    int hp;                           // kalan can (0 = can sistemi kullanılmıyor)
    int hpmax;                        // başlangıç canı — HUD barının paydası
    float invuln;                     // kalan dokunulmazlık süresi (sn)
    float life;                       // kalan ömür (sn); <= 0 = ömürsüz (mermi dışı)
    int owner;                        // mermiyi atanın handle'ı; mermi değilse -1
    int pdir;                         // devriye yönü (0 = 2. uca, 1 = 1. uca)
    // Kovalama sırasında SEÇİLEN KAÇINMA TARAFI: 0 = engel yok/serbest,
    // 1 = sola, -1 = sağa. Durum tutmak şart: simetrik bir duvarın önünde
    // "hedefe en yakın açık yön" her karede taraf değiştirebiliyor ve düşman
    // ilerlemek yerine yerinde titriyordu (ölçüldü: vx her kare +6.5 ↔ -6.9).
    // Bir tarafa bağlanınca duvarı gerçekten dolaşıyor.
    int avoid;
    // -- karakter animasyonu (Faz 8); yalnız SHAPE_MODEL entity'lerde anlamlı --
    int anim_idle;                    // boşta animasyon indeksi (-1 = yok)
    int anim_run;                     // koşu animasyon indeksi (-1 = yok)
    float anim_fps;                   // kare/sn
    float anim_t;                     // kesirli kare sayacı (motor sürer)
    // Harmanlama durumu: `anim_a` klibinden `anim_b` klibine, ağırlık
    // `anim_w` (0 = tamamen a, 1 = tamamen b). Motor sürer, çizim yalnız
    // uygular. ÇALIŞMA durumu — sahne dosyasına yazılmıyor.
    //
    // İki klip değil N klip: hedef her kare yeniden hesaplanıyor ve
    // değişirse geçiş (a,b,w) üçlüsü üzerinden yeniden kuruluyor. Boşta↔koşu
    // bunun yalnız bir özel hâli.
    int anim_a;
    int anim_b;
    float anim_w;
    // 1 = klibi OYUN seçiyor (`anim_set3d`), 0 = hızdan türeyen otomatik
    // locomotion. İkisini bir bayrakla ayırmak gerekiyor: otomatik kip her
    // kare hedefi yeniden yazdığı için elle seçilen klibi anında ezerdi.
    int anim_manual;
}

array _e3 = [];             // entity store (slot ile indekslenir, handle ile DEĞİL)

// ---- Entity kimliği: generation'lı handle ----------------------------------
// spawn3 eskiden ham dizi index'i dönüyordu ve kill3d yalnız alive=0 yapıyordu:
// boş slot asla geri kullanılmazdı, yani mermi/parçacık gibi sürekli üreyip
// ölen bir şey eklendiği an _e3 sonsuza kadar büyürdü. arcade aynı duvara
// çarpıp generation'lı handle'a geçti; scene3d de aynı deseni kullanıyor.
//
//     handle = _e3gen[slot] * _ID_STRIDE3 + slot
//
// Öldürmede _e3gen[slot] artar → o slot'a ait TÜM eski handle'lar anında
// bayatlar. Bayat handle _slot_of3'ten -1 döner ve public API sessizce hiçbir
// şey yapmaz — ölmüş bir entity'yi tutan kod, slot geri kullanıldıktan sonra
// yanlışlıkla YENİ entity'yi oynatmaz. Bu, geri kazanımın asıl tehlikesidir.
array _e3gen  = [];         // slot üretim sayacı (bayat handle tespiti)
array _e3free = [];         // boş slot yığını
int   _free_n3 = 0;         // yığın tepesi (_e3free kırpılmaz; bu sayaç sınırlar)
int   _ID_STRIDE3 = 1048576;   // 2^20 slot/sahne — pratikte tavan yok

// Slot -> dışarıya verilen handle.
func _mk_handle3(slot): int { return _e3gen[slot] * _ID_STRIDE3 + slot; }

// Handle -> slot; bayat/geçersizse -1. TÜM public id API'si bundan geçer.
func _slot_of3(h): int {
    if (h < 0) { return 0 - 1; }
    int slot = mod(h, _ID_STRIDE3);
    if (slot >= length(_e3gen)) { return 0 - 1; }
    int gen = toInt((h - slot) / _ID_STRIDE3);
    if (gen != _e3gen[slot]) { return 0 - 1; }   // slot geri kullanılmış → bayat
    return slot;
}

// ---- Kamera / fizik / durum -----------------------------------------------
float _grav      = 26.0;    // birim/sn^2
float _ground_y  = 0.0;     // zemin düzlemi yüksekliği
int   _ground_on = 1;       // zemin+ızgara çiz
float _ground_sz = 40.0;    // zemin/ızgara yarı-genişliği

int   _cam_target = 0 - 1;  // takip edilen entity (-1 = sabit)
float _cam_dist   = 12.0;
float _cam_height = 8.0;
float _cam_fov    = 45.0;

// Kamera modu. SABİT = motorun ilk günkü kamerası: hedefin hep +Z arkasında
// durur, HİÇ dönmez — bu yüzden W tuşu her zaman dünya ekseninde -Z demekti.
// Dönebilen kamera (yörünge/FPS) hem bakışı hem de hareketin yönünü açar:
// yön girdisi artık kameranın baktığı yere göre çevrilir (bkz. move3d).
// Varsayılan SABİT kalıyor — eski sahnelerin görüntüsü ve kontrolü değişmesin.
int CAM_FIXED = 0;
int CAM_ORBIT = 1;
int CAM_FPS   = 2;

int   _cam_mode3  = 0;
// Kamera açıları DERECE. yaw 0 = kamera +Z'de, bakış -Z (sabit kameranın açısı).
// _cam_pitch3 BAKIŞ eğimidir (+ = yukarı bak); yörüngede kameranın yüksekliği
// bunun TERSİDİR — fareyi yukarı ittiğinde yukarı bakarsın, yani kamera alçalır.
float _cam_yaw3   = 0.0;
float _cam_pitch3 = 0.0;
float _cam_sens3  = 0.22;   // derece / piksel (fare)
float _cam_tsens3 = 0.30;   // derece / piksel (dokunmatik — parmak daha kaba)
float _cam_eye3   = 0.0;    // FPS göz yüksekliği (0 = entity boyundan türet)
float _cam_min3   = 3.0;    // yörünge zoom sınırları (tekerlek)
float _cam_max3   = 40.0;
int   _cam_lock3  = 0;      // imleç kilidi (FPS'te varsayılan açık)
// Kamera-duvar çarpışması VARSAYILAN AÇIK: kameranın duvarın içinden bakması
// bir sanat yönü tercihi değil, kusurdur (gölge gibi — bkz. _shadows3).
// Açık alanda hiçbir etkisi yok, çünkü ışın hiçbir duvara çarpmıyor.
int   _cam_collide3 = 1;
// Kamera hedefinin ADI. Biçim entity'lere ADLA atıfta bulunuyor ve handle
// bölüm değişince ölüyor: çok bölümlü bir sahnede kamera her bölümde yeni
// gövdeye yeniden bağlanmak zorunda. Adı saklamadan bu imkânsız.
str   _sc_cam_nm3 = "";
// Geri çekilme ve en yakın mesafe DÜNYA BİRİMİ. Eskiden ikisi de yörünge
// mesafesinin ORANIydı: taban %12 olduğu için `kamera_yorunge(p, 16, ...)`
// diyen bir sahnede kamera, arkada engel varken oyuncunun 1.9 birim yakınına
// giriyordu — pratikte kafasının içine. Oran, kameranın ne kadar uzakta
// kurulduğuna göre anlam değiştiriyordu; mesafe değiştirmiyor.
float _cam_pad3  = 0.35;   // çarpma noktasının bu kadar berisinde dur
float _cam_near3 = 5.0;    // hedefe en fazla bu kadar yaklaş (DÜNYA birimi)
// 2.2 fazla yakındı: 45° FOV'da 2 birimlik gövde ekranı taşırıyor, oyuncu
// kendi kutusunun içinden bakıyor gibi oluyordu (kullanıcı ekran görüntüsü).
float _cam_ease3 = 8.0;    // engel kalkınca geri açılma hızı (1/sn)
float _cam_cur3  = 0.0;    // yumuşatma durumu (0 = henüz kurulmadı → anında)
float _cam_lift3 = 0.0;    // engelin üstüne çıkmak için eklenen eğim (radyan)
float _CAM_LIFT_MAX3  = 0.79;   // ~45° — yakınlaşmaya YEĞLENİR, ama kuş bakışı değil
float _CAM_LIFT_STEP3 = 0.157;  // ~9° adım (gerektiği kadar yükselir)

// RÖNTGEN: kamerayı içeri çekmek yerine, kamerayla oyuncu ARASINA giren
// cisimleri saydam çiz. Üçüncü şahıs oyunlarının standart çözümü ve daha
// doğrusu — kamerayı duvara çarptıkça içeri çekmek, oyuncuyu dev gibi
// yakınlaştırıp yönelimi kaybettiriyordu (duvara sırtını dayamak yeterliydi).
// Varsayılan AÇIK; eski davranış `kamera_seffaf3d(false)`.
int   _cam_xray3 = 1;
int   _fade_a3   = 70;     // araya giren cismin alfası (0-255)
array _fade3 = [];         // slot başına 1 = bu kare saydam çiz

int   _score3 = 0;
int   _game_over3 = 0;
// Işıklandırma varsayılan AÇIK (bkz. play3d). lights3d(false) ile kapatılır —
// düz/ışıksız retro görünüm isteyen oyunlar için.
int   _lights3 = 1;
// Gölgeler de varsayılan AÇIK. Gölge, 3B'de cismin "yerde durduğu" hissini
// veren tek şey — gölgesiz sahnede her şey havada yüzüyormuş gibi görünür.
// Işık kapalıysa gölge de anlamsızdır, o yüzden ışığa bağlı (bkz. play3d).
int   _shadows3 = 1;
// Gölge haritasının kapsadığı alanın yarı-genişliği (dünya birimi). Kamera
// hedefinin çevresini kapsar; küçük = keskin ama dar, büyük = geniş ama kaba.
float _shadow_area3 = 24.0;
// Gökyüzü VARSAYILAN KAPALI — ışık/gölgeden farklı olarak bu bir sanat
// yönü kararı, algı düzeltmesi değil. Karanlık/stilize bir sahnede zorla açık
// mavi gökyüzü yanlış olur. sky3d(tepe, ufuk) ile açılır.
int   _sky3 = 0;
int   _sky_top3 = 0;
int   _sky_bot3 = 0;
// Zemin dokusu (opsiyonel). -1 = dokusuz düz renk (varsayılan).
int   _ground_tex3 = 0 - 1;
float _ground_tile3 = 1.0;
// Zemin dokusunun YOLU — handle taşınabilir değil, yol taşınabilir.
str   _ground_tex_src3 = "";

// ---- Varlık (asset) kaydı --------------------------------------------------
// `load_model`/`load_texture` SÜREÇ İÇİ bir sayı döner. Sahne dosyasına o
// sayıyı yazmak taşınabilir görünüp taşınabilir OLMAYAN bir dosya üretiyordu:
// aynı sahne başka bir çalıştırmada modelleri karışmış ya da hiç yüklenmemiş
// açılır, çünkü handle yükleme SIRASINA bağlı. Kayıt araya giriyor —
// sahne YOLU yazıyor, yükleyen yolu handle'a çeviriyor.
//
// Aynı yol iki kez istendiğinde ikinci kez yüklenmiyor: bir modeli kullanan
// yirmi varlık yirmi kopya değil tek bir GPU yüklemesi demek.
array _as_path3 = [];    // str  — dosya yolu
array _as_kind3 = [];    // int  — AS_MODEL3 / AS_TEX3
array _as_h3    = [];    // int  — yükleme handle'ı (-1 = yüklenemedi)

int AS_MODEL3 = 0;
int AS_TEX3   = 1;
int AS_SOUND3 = 2;

// Türe göre gerçek yükleme.
//
// SINANAMAYAN NOKTA: bu dallanmanın DOĞRU yükleyiciyi seçtiği başsız olarak
// doğrulanamıyor — ses aygıtı ve GL bağlamı yokken `load_sound`,
// `load_texture` ve `load_model` üçü de -1 dönüyor, yani birbirine
// karıştırıldıkları test edilemiyor (enjeksiyonla ölçüldü: `load_sound`
// yerine `load_texture` yazınca hiçbir test kırılmadı). Risk yapısal olarak
// azaltıldı: üç tür ESKİDEN iki ayrı yerde dallanıyordu (al ve yeniden-dene),
// şimdi tek yerde — yani unutulacak ikinci bir kopya yok. Gerçek doğrulama
// aygıtı olan makinede, sesin duyulmasıyla olur.
func _as_load3(path, kind): int {
    if (kind == AS_MODEL3) { return load_model(path); }
    if (kind == AS_TEX3)   { return load_texture(path); }
    return load_sound(path);
}

func _as_find3(path, kind): int {
    int i = 0;
    while (i < length(_as_path3)) {
        if (_as_kind3[i] == kind && _as_path3[i] == path) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// Yol → handle. Yükleme başarısızsa -1 KAYDEDİLİYOR ve kaydı silinmiyor:
// eksik bir dosya her karede yeniden yüklenmeye çalışılırsa editör diske
// takılır. Dosya sonradan gelirse `asset_reload3d` var.
func _as_get3(path, kind): int {
    if (path == "") { return 0 - 1; }
    int k = _as_find3(path, kind);
    if (k >= 0) { return _as_h3[k]; }
    int h = _as_load3(path, kind);
    push(_as_path3, path);
    push(_as_kind3, kind);
    push(_as_h3, h);
    return h;
}

// Modeli yoldan al (bir kez yükler, sonra önbellekten).
//
//   int h = asset_model3d("varliklar/robot.glb");
func asset_model3d(path): int   { return _as_get3(path, AS_MODEL3); }
func varlik_model3d(yol): int   { return _as_get3(yol, AS_MODEL3); }
// Dokuyu yoldan al.
func asset_texture3d(path): int { return _as_get3(path, AS_TEX3); }
func varlik_doku3d(yol): int    { return _as_get3(yol, AS_TEX3); }
// Sesi yoldan al. Ses aygıtı yoksa (başsız test, sessiz makine) -1 döner ve
// -1 KAYDEDİLİR: çalma zaten sessiz bir boş işlem, ama her karede yeniden
// yüklemeye çalışmak diske takılırdı.
func asset_sound3d(path): int   { return _as_get3(path, AS_SOUND3); }
func varlik_ses3d(yol): int     { return _as_get3(yol, AS_SOUND3); }

// Kayıttaki girdi sayısı / i. girdinin yolu, türü, handle'ı. Araçlar ve
// testler kaydın içine bakabilsin diye.
func asset_count3d(): int      { return length(_as_path3); }
func asset_path3d(i): str {
    if (i < 0 || i >= length(_as_path3)) { return ""; }
    return _as_path3[i];
}
func asset_kind3d(i): int {
    if (i < 0 || i >= length(_as_kind3)) { return 0 - 1; }
    return _as_kind3[i];
}
func asset_handle3d(i): int {
    if (i < 0 || i >= length(_as_h3)) { return 0 - 1; }
    return _as_h3[i];
}
// Yüklenememiş (handle < 0) bir girdiyi yeniden dener. Dosya sonradan
// eklenince editörü kapatmak gerekmesin diye.
func asset_reload3d(path, kind): int {
    int k = _as_find3(path, kind);
    if (k < 0) { return _as_get3(path, kind); }
    if (_as_h3[k] >= 0) { return _as_h3[k]; }
    _as_h3[k] = _as_load3(path, kind);
    return _as_h3[k];
}
// Sis yoğunluğu. 0 = kapalı (varsayılan). Rengi gökyüzünün ufkundan alınır.
float _fog3 = 0.0;

// callback'ler (0-arg; arcade deseni — call() ile güvenli).
// fn referansları `var` ile tutulmalı — `int` global fn-değerini bozar.
var _setup3_fn = 0;   int _has_setup3 = 0;
var _update3_fn = 0;  int _has_update3 = 0;
// HUD kancası: 3B sahne çizildikten SONRA, 2B katmanda çağrılır. 3B bir cisme
// bağlı 2B çizimlerin (düşman üstü can barı, hasar sayısı, isim etiketi) tek
// doğru yeri burasıdır — ekran_x3d/ekran_y3d ile konum alınır.
var _hud3_fn = 0;     int _has_hud3 = 0;

// çarpışma kancaları (en çok 16): tagA, tagB, fn
array _hitA = [];
array _hitB = [];
array _hitF = [];

// ölüm kancaları: canı biten entity'nin tag'i → fn (kanca içinde me3d() ölen)
array _deadT = [];
array _deadF = [];

// ---- Bölüm sistemi ---------------------------------------------------------
// Bölümler numara + kurulum fn olarak kaydedilir; play3d en küçük numaralıyla
// başlar. Geçiş İSTEK olarak alınır ve KARE SONUNDA uygulanır (_lvl_pending3):
// çarpışma döngüsünün ortasında entity store'u silmek, o döngünün elindeki
// slot'ları ayağının altından çekmek demektir. arcade'de aynı desen var ve
// orada da kasıtlı — bu bir dil kısıtı değil, doğru oyun-döngüsü tasarımı.
array _lvlN = [];           // bölüm numaraları
array _lvlF = [];           // bölüm kurulum fn'leri
int   _cur_lvl3 = 0;        // yürürlükteki bölüm
int   _lvl_pending3 = 0 - 1; // istenen bölüm (-1 = istek yok)
int   _won3 = 0;            // kayıtlı son bölüm de bitti mi

// Hasar sonrası dokunulmazlık (sn). Olmazsa 60 FPS'te bir düşmana değmek
// tek karede tüm canı götürür — çarpışma her kare yeniden tetiklenir.
float _invuln3 = 0.6;
// Mermilerin öldüğü dünya yarıçapı (zemin yarı-genişliğinden biraz geniş).
float _world_r3 = 60.0;

// çarpışma bağlamı (kanca içinde me3d()/other3d() okur) — HANDLE tutar, slot
// değil: kanca doğrudan kill3d(other3d()) yazabilsin.
int _hit_me = 0 - 1;
int _hit_other = 0 - 1;

int _win_w = 800;
int _win_h = 480;
string _win_title = "Tulpar 3D";

// ---- Entity oluşturma / erişim ---------------------------------------------
// Tag'e göre varsayılan katılık. Toplanabilir ve mermi katı değildir: oyuncu
// altının içinden geçip toplar, mermi hedefe girer — ikisi de kancayla işlenir.
// Geri kalan her şey (oyuncu, düşman, duvar, prop) katıdır.
func _default_solid3(tag): int {
    if (tag == TAG_ITEM || tag == TAG_BULLET) { return 0; }
    return 1;
}

// Katılığı sonradan değiştir — hayalet düşman, geçilebilir duvar, tetikleyici
// bölge gibi şeyler için.
func solid3d(id, on) {
    int s = _slot_of3(id);
    if (s < 0) { return; }
    Ent3 e = _e3[s];
    if (on) { e.solid = 1; } else { e.solid = 0; }
    _e3[s] = e;
}
func kati3d(id, on) { solid3d(id, on); }

// Boş slot varsa onu geri kullan, yoksa diziyi büyüt. SLOT döner (handle değil).
// Geri kullanılan slot'ta _e3gen zaten öldürmede artmıştı → yeni kimlik.
func _alloc_slot3(Ent3 e): int {
    if (_free_n3 > 0) {
        _free_n3 = _free_n3 - 1;
        int s = _e3free[_free_n3];
        _e3[s] = e;
        // Geri kullanılan slot: geniş faz dizilerinde ÖLEN entity'nin konumu
        // duruyor. Bir çarpışma kancası ortasında spawn3 çağrılırsa (patlama,
        // mermi) o bayat konum kalan kareyi yanlış eleyebilirdi.
        _bp_sync3(s);
        return s;
    }
    push(_e3, e);
    push(_e3gen, 1);
    return length(_e3) - 1;
}

// Yeni entity üret → HANDLE döner (ham index değil). sx/sy/sz TAM boyut.
func spawn3(x, y, z, sx, sy, sz, color, shape, tag): int {
    Ent3 e = { x: x, y: y, z: z,  vx: 0.0, vy: 0.0, vz: 0.0,
               sx: sx, sy: sy, sz: sz,  yaw: 0.0,
               shape: shape, model: 0 - 1, msrc: "", tsrc: "", ttile: 1.0,
               color: color, tag: tag,
               grounded: 0, alive: 1, solid: _default_solid3(tag),
               hp: 0, hpmax: 0, invuln: 0.0, life: 0.0, owner: 0 - 1, pdir: 0,
               anim_idle: 0 - 1, anim_run: 0 - 1, anim_fps: 24.0, anim_t: 0.0,
               anim_a: 0 - 1, anim_b: 0 - 1, anim_w: 0.0, anim_manual: 0,
               avoid: 0 };
    return _mk_handle3(_alloc_slot3(e));
}

// SHAPE_MODEL entity: yüklü/üretilmiş model handle'ıyla.
func spawn3_model(x, y, z, scale, model_handle, tag): int {
    Ent3 e = { x: x, y: y, z: z,  vx: 0.0, vy: 0.0, vz: 0.0,
               sx: scale, sy: scale, sz: scale,  yaw: 0.0,
               shape: SHAPE_MODEL, model: model_handle, msrc: "", tsrc: "", ttile: 1.0,
               color: WHITE, tag: tag,
               grounded: 0, alive: 1, solid: _default_solid3(tag),
               hp: 0, hpmax: 0, invuln: 0.0, life: 0.0, owner: 0 - 1, pdir: 0,
               anim_idle: 0 - 1, anim_run: 0 - 1, anim_fps: 24.0, anim_t: 0.0,
               anim_a: 0 - 1, anim_b: 0 - 1, anim_w: 0.0, anim_manual: 0,
               avoid: 0 };
    return _mk_handle3(_alloc_slot3(e));
}

// Yoldan modelli entity — handle'ı da KAYNAK YOLUNU da kurar, yani bu yolla
// üretilen varlık sahne dosyasına taşınabilir biçimde yazılır. `spawn3_model`
// ham handle aldığı için yolu bilemez; sahneye kalıcı model koyacaksan bunu
// kullan.
//
//   int r = spawn3_asset(0.0, 1.0, 0.0, 1.0, "varliklar/robot.glb", TAG_PLAYER);
func spawn3_asset(x, y, z, scale, path, tag): int {
    int id = spawn3_model(x, y, z, scale, asset_model3d(path), tag);
    int sl = _slot_of3(id);
    Ent3 e = _e3[sl];
    e.msrc = path;
    _e3[sl] = e;
    return id;
}
func uret3_varlik(x, y, z, olcek, yol, etiket): int {
    return spawn3_asset(x, y, z, olcek, yol, etiket);
}

// Var olan bir varlığa yoldan model bağla. Şekli de MODEL yapıyor — modeli
// olup şekli küp kalan bir varlık kutu olarak çizilirdi.
func set_model3d(id, path): int {
    int sl = _slot_of3(id);
    if (sl < 0) { return 0; }
    int h = asset_model3d(path);
    Ent3 e = _e3[sl];
    e.model = h;
    e.msrc = path;
    e.shape = SHAPE_MODEL;
    _e3[sl] = e;
    return 1;
}
func model_ata3d(id, yol): int { return set_model3d(id, yol); }

// Modeli kaldır → varlık yeniden bir küp. Şekli de geri almak şart: MODEL
// kalırsa modelsiz bir MODEL varlık, yani hiç çizilmeyen bir şey kalıyor.
func clear_model3d(id): int {
    int sl = _slot_of3(id);
    if (sl < 0) { return 0; }
    Ent3 e = _e3[sl];
    e.model = 0 - 1;
    e.msrc = "";
    e.shape = SHAPE_CUBE;
    e.anim_idle = 0 - 1;
    e.anim_run = 0 - 1;
    _e3[sl] = e;
    return 1;
}
func model_kaldir3d(id): int { return clear_model3d(id); }

// Varlığa yüzey dokusu bağla. `tile` = dokunun kaç kez döşeneceği; büyük bir
// duvarda 1.0 dokuyu gerdirir, 8.0 tuğla gibi tekrarlar.
//
//   set_texture3d(duvar, "dokular/tugla.png", 6.0);
func set_texture3d(id, path, tile): int {
    int sl = _slot_of3(id);
    if (sl < 0) { return 0; }
    Ent3 e = _e3[sl];
    e.tsrc = path;
    if (tile > 0.0) { e.ttile = tile; } else { e.ttile = 1.0; }
    _e3[sl] = e;
    return 1;
}
func doku_ata3d(id, yol, tile): int { return set_texture3d(id, yol, tile); }

// Dokuyu kaldır → varlık yeniden düz renk.
func clear_texture3d(id): int {
    int sl = _slot_of3(id);
    if (sl < 0) { return 0; }
    Ent3 e = _e3[sl];
    e.tsrc = "";
    e.ttile = 1.0;
    _e3[sl] = e;
    return 1;
}
func doku_kaldir3d(id): int { return clear_texture3d(id); }

// Varlığın doku yolu ("" = yok) ve döşeme sıklığı.
func texture_src3d(id): str {
    int sl = _slot_of3(id);
    if (sl < 0) { return ""; }
    return _e3[sl].tsrc;
}
func texture_tile3d(id): float {
    int sl = _slot_of3(id);
    if (sl < 0) { return 1.0; }
    return _e3[sl].ttile;
}

// Varlığın model yolu ("" = yok).
func model_src3d(id): str {
    int sl = _slot_of3(id);
    if (sl < 0) { return ""; }
    return _e3[sl].msrc;
}

// Öldür + slot'u boş yığına iade. _e3gen artar: bu handle ve aynı slot'a ait
// tüm eski handle'lar buradan sonra bayattır. Çift-öldürme zararsız.
func kill3d(id) {
    int s = _slot_of3(id);
    if (s < 0) { return; }
    Ent3 e = _e3[s];
    if (e.alive == 0) { return; }
    e.alive = 0;
    _e3[s] = e;
    _e3gen[s] = _e3gen[s] + 1;
    if (_free_n3 < length(_e3free)) { _e3free[_free_n3] = s; }
    else { push(_e3free, s); }
    _free_n3 = _free_n3 + 1;
}

// Bayat handle "canlı değil" der — ölmüş entity'yi tutan kod doğal olarak
// false görür, slot geri kullanılmış olsa bile yeni entity'yi görmez.
func alive3(id): bool {
    int s = _slot_of3(id);
    if (s < 0) { return false; }
    Ent3 e = _e3[s];
    return e.alive == 1;
}

func get3x(id): float { int s = _slot_of3(id); if (s < 0) { return 0.0; } Ent3 e = _e3[s]; return e.x; }
func get3y(id): float { int s = _slot_of3(id); if (s < 0) { return 0.0; } Ent3 e = _e3[s]; return e.y; }
func get3z(id): float { int s = _slot_of3(id); if (s < 0) { return 0.0; } Ent3 e = _e3[s]; return e.z; }
// BOYUT okuyucuları. `get3x/y/z`'nin kardeşi; ölçek tutamağı seçimin
// tamamını yakalarken gerekti ve bayat handle'da 0 dönüyorlar (öteki
// okuyucularla aynı sözleşme).
func get3sx(id): float { int s = _slot_of3(id); if (s < 0) { return 0.0; } Ent3 e = _e3[s]; return e.sx; }
func get3sy(id): float { int s = _slot_of3(id); if (s < 0) { return 0.0; } Ent3 e = _e3[s]; return e.sy; }
func get3sz(id): float { int s = _slot_of3(id); if (s < 0) { return 0.0; } Ent3 e = _e3[s]; return e.sz; }

func set3pos(id, x, y, z) {
    int s = _slot_of3(id);
    if (s < 0) { return; }
    Ent3 e = _e3[s]; e.x = x; e.y = y; e.z = z; _e3[s] = e;
    _bp_sync3(s);   // kanca içinden ışınlanma geniş fazı bayat bırakmasın
}
func set3vel(id, vx, vy, vz) {
    int s = _slot_of3(id);
    if (s < 0) { return; }
    Ent3 e = _e3[s]; e.vx = vx; e.vy = vy; e.vz = vz; _e3[s] = e;
}

// Y dönüşü (derece). Faz 9'dan beri bu YALNIZ görsel değil: dönük kutular
// SAT ile gerçek yüzeyleriyle çarpışır (bkz. _obb_overlap3).
func set3yaw(id, yaw) {
    int s = _slot_of3(id);
    if (s < 0) { return; }
    Ent3 e = _e3[s]; e.yaw = yaw; _e3[s] = e;
}
func get3yaw(id): float {
    int s = _slot_of3(id);
    if (s < 0) { return 0.0; }
    Ent3 e = _e3[s];
    return e.yaw;
}

// Çarpışma kancası bağlamı — HANDLE döner, böylece kanca içinde doğrudan
// kill3d(other3d()) yazılabilir.
func me3d(): int { return _hit_me; }
func other3d(): int { return _hit_other; }

// Sahneyi sıfırla: tüm entity'ler, skor, çarpışma kancaları, oyun-bitti bayrağı.
// Restart (R ile yeniden başlat) ve otomatik testler için. setup fn'i saklı kalır.
func scene3d_reset() {
    _e3 = [];
    // Generation sayaçları da sıfırlanır: entity store tamamen gittiği için
    // eski handle'ların hepsi zaten anlamsız, slot 0'dan yeniden başlanabilir.
    _e3gen = []; _e3free = []; _free_n3 = 0;
    _bx = []; _by = []; _bz = []; _br = [];   // geniş faz de sahneyle gider
    _rampi3 = [];                             // rampa dizini de
    _plati3 = [];                             // platform dizini de
    _plat_lasty3 = []; _plat_dy3 = []; _plat_seen3 = []; _e_sup3 = [];
    _pl_top3 = []; _pl_pdy3 = []; _pl_x3 = []; _pl_z3 = [];
    _pl_hx3 = []; _pl_hz3 = []; _pl_yaw3 = [];
    _plat_hit3 = 0 - 1;
    // Nav ızgarası da sahneyle gider. Bırakılınca yeni sahne ESKİ duvarların
    // ızgarasını kullanır ve `chase_path3d` var olmayan duvarları dolaşır —
    // üstelik testleri sıraya bağımlı yapıyordu (gerekçe `_slope_lim3` ve
    // parçacık ayarlarıyla aynı; nitekim burada da birebir yaşandı).
    _nav_w3 = 0; _nav_h3 = 0; _nav_block3 = [];
    _nav_wx3 = []; _nav_wz3 = []; _nav_t3 = [];
    // UI durumu da tam teardown'a dahil: reset kancaları ve bölümleri zaten
    // siliyor, bekleyen bir "çıkış" isteği ya da açık kalmış duraklat örtüsü
    // yeni sahneye sızmamalı.
    _s3_ui = UI_NONE; _s3_quit = 0; _s3_tap_prev = 0;
    _s3_sel3 = 0; _s3_ui_prev3 = 0 - 1;
    // Kol: ayarlar (hangi kol, ölü bölge, hız) sahne durumu değil, kullanıcı
    // tercihi — onlar KALIR. Kare tamponu ise sahneyle birlikte sıfırlanır.
    _gp_dx = 0.0; _gp_dz = 0.0; _gp_lx = 0.0; _gp_ly = 0.0;
    _gp_jump = 0; _gp_start = 0; _gp_ok = 0; _gp_back = 0;
    _gp_nav = 0; _gp_nav_prev = 0; _gp_here3 = 0;
    _s3_has_title = 0; _s3_title_txt = ""; _s3_title_sub = "";
    _s3_has_restart = 0;
    // Eğim sınırı da sahne durumu: reset zemini ve araziyi zaten sıfırlıyor,
    // yamaç kuralının ayakta kalması tutarsız olurdu (ve testleri sıraya
    // bağımlı yapıyordu — "varsayılan kapalı" testi bir öncekinin bıraktığı
    // sınırı ölçüyordu).
    _slope_lim3 = 0.0; _slope_cos3 = 0.0; _slide_acc3 = 18.0;
    _chase_avoid3 = 1;   // kaçınma varsayılanı da sahneyle birlikte döner
    // Kalıcılık: BELLEKTEKİ durum sıfırlanır, DİSKTEKİ kayıt durur. reset
    // "sahneyi baştan kur" demek, "oyuncunun rekorunu sil" demek değil.
    _sav_on = 0; _best3 = 0; _new_rec3 = 0; _lvl_done3 = [];
    // Ad kaydı da sahneyle gider. Bırakılınca handle'lar ÇAKIŞIYOR: yeni
    // sahnenin slot 0 / gen 1 varlığı, eski sahnenin aynı handle'lı adını
    // devralıyor ve serileştirme onu yanlış adla yazıyor. (Süitte tam bu
    // oldu: yeni "kutu" varlığı bir önceki testin "kahraman"ı sanıldı.)
    _sc_nm = []; _sc_id = [];
    // Geri-al geçmişi de: başka bir sahnenin anlık görüntüsünü "geri almak"
    // sahneyi alakasız bir şeye çevirirdi. Bölüm ETİKETLERİ de sıfırlanmalı:
    // içerik yığını boşalıp etiket yığını dolu kalırsa ikisi kayar ve ilk
    // geri alma anlık görüntüyü YANLIŞ bölüme yazar. (Testin "eş adımda"
    // iddiası bunu yakaladı — iki yığını ayrı ayrı sıfırlamak, paralel dizi
    // tutmanın klasik bedeli.)
    _ed_undo3 = []; _ed_redo3 = [];
    _ed_undo_lvl3 = []; _ed_redo_lvl3 = [];
    _ed_sel3e = 0 - 1; _ed_drag3 = 0;   // secim sahneyle gider
    _bh3 = [];   // veri-davranislar da sahne durumu
    _rl3 = [];   // veri-kurallar da sahne durumu
    _snd_last_slot3 = 0 - 1;   // ses izi de sahneyle gider
    // Şablonlar da sahne biçiminin parçası: bırakılırsa yeni sahneye önceki
    // sahnenin şablonları sızardı (ve testler sıraya bağımlı olurdu).
    _pf_nm3 = []; _pf_js3 = [];
    _hitA = []; _hitB = []; _hitF = [];
    _deadT = []; _deadF = [];
    _trg_clear3(); _trg_show3 = 0;
    // Işıklar da YERLEŞTİRİLMİŞ sahne içeriği (bölgeler gibi), tek bir dünya
    // ayarı değil — reset onları silmeli. Silmezse editörün OYNAT/DUR
    // döngüsü her turda lambaları ÜST ÜSTE KOYARDI (ölçüldü: üç turda 5
    // lamba 8 oldu) ve seçim yanlış üçlüyü yakardı.
    _lt_x3 = []; _lt_y3 = []; _lt_z3 = []; _lt_col3 = []; _lt_rng3 = [];
    _lt_pick3 = [];
    _lvlN = []; _lvlF = []; _cur_lvl3 = 0; _lvl_pending3 = 0 - 1; _won3 = 0;
    _lvl_js3 = [];            // bölüm içerikleri de sahneyle gider
    _ed_lvl3 = 0;
    _s3_particles_clear();
    // Parçacık AYARLARI da sahneyle gider — havuzu boşaltıp dokusunu ve
    // dönmesini bırakmak yarım bir teardown olurdu. Gerekçe `_slope_lim3` ile
    // aynı ve orada birebir yaşandı: bırakılan ayar testleri SIRAYA BAĞIMLI
    // yapıyor. Nitekim dönmeyi varsayılan AÇIK yapan bozma tam bu yüzden
    // kaçtı — test, varsayılanı değil bir önceki testin bıraktığı 0'ı
    // ölçüyordu.
    _pt3_spin_max = 0.0; _pt3_tex = 0 - 1; _pt3_frames = 1; _pt3_grav = 9.0;
    // Arazi bayrağı sıfırlanır (yükseklik verisi de bırakılır) — sahne
    // sıfırlanınca dünya da sıfırlanmalı, yoksa yeni sahne eski tepeleri sürer.
    _terr_on = 0; _terr_model = 0 - 1; terrain_off3d();
    _terr_kind3 = 0; _terr_lay3 = 0; terrain_layers_off3d();
    _water_on3 = 0; _water_y3 = 0.0; _water_a3 = 150; _water_phys3 = 1;
    _dn_on3 = 0; _dn_h3 = 12.0; _dn_len3 = 120.0; _dn_frozen3 = 0;
    _stars3 = 0.0 - 1.0;
    _score3 = 0;
    _game_over3 = 0;
    _cam_target = 0 - 1;
    // Kamera da sıfırlanır: hedef zaten kayboluyor, mod/açı da setup'ta
    // yeniden kurulur. Bırakılsa yeniden başlatılan sahne önceki turun
    // bakış açısıyla açılırdı.
    _cam_mode3 = CAM_FIXED; _cam_yaw3 = 0.0; _cam_pitch3 = 0.0; _cam_lock3 = 0;
    _cam_cur3 = 0.0; _cam_lift3 = 0.0;
    _cam_near3 = 5.0; _cam_pad3 = 0.35; _cam_ease3 = 8.0;
    // Röntgen de sahne durumu: reset kamerayı zaten sıfırlıyor, saydamlık
    // kuralının ayakta kalması tutarsız olurdu (ve testleri sıraya bağımlı
    // yapıyordu — kapatan bir test sonrakini etkiliyordu).
    _cam_xray3 = 1; _fade_a3 = 70; _fade3 = []; _aim_mode3 = AIM_FLAT; _aim_spread3 = 0.0;
    // Tanılama AYARLARI kullanıcı tercihi, kalır; TAMPON sahneyle gider.
    _lg_txt = []; _lg_sev = []; _lg_n = 0;
    _lg_key = []; _lg_t = []; _lg_cnt = [];
    // Konsolun GÖRÜNÜMÜ de tamponla gidiyor: kayıt silinince "37 satır
    // aşağıda" demek yalan olurdu. Süzgeçler kullanıcı tercihi, kalıyor.
    _ed_cons_scroll3 = 0;
    _w_pen = 0; _w_pen_max = 0.0; _w_cam_in = 0;
    _hit_me = 0 - 1; _hit_other = 0 - 1;
}

func score3d_add(n) { _score3 = _score3 + n; }
func score3d(): int { return _score3; }
// Oyunu bitir. Rekor BURADA işleniyor: hem kaybetme hem kazanma bu kapıdan
// geçiyor, yani skorun kalıcılaşacağı tek doğal kontrol noktası.
func game_over3d() { _game_over3 = 1; _s3_commit_score(); }
// Oyun bitti mi (kazanarak ya da kaybederek)? arcade'de `is_over()` vardı,
// 3B'de yoktu — UI katmanı ve oyunun kendi update'i ikisi de buna bakıyor.
func is_over3d(): bool { return _game_over3 == 1; }

// Yaşayan entity sayısı. Slot'lar geri kullanıldığı için `length(_e3)` yanıltır:
// ölü slot'lar orada durur.
func alive_count3d(): int {
    int c = 0;
    int i = 0;
    int n = length(_e3);
    while (i < n) {
        Ent3 e = _e3[i];
        if (e.alive == 1) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

// ---- Girdi yardımcıları (klavye VEYA dokunmatik) ---------------------------
// Klavye: WASD/oklar (masaüstü; web'de dokunmatik shell sentetik tuş üretir).
// Native dokunmatik (Android): SOL yarı = sanal joystick (yön), SAĞ yarıya
// dokunuş = zıpla. _read_touch3() her kare play3d içinde çağrılır.
// Yön: W/yukarı = -Z (ileri), S/aşağı = +Z, A/sol = -X, D/sağ = +X.

float _t_dx = 0.0;      // bu kareki dokunmatik yön (sol joystick)
float _t_dz = 0.0;
int   _t_jump = 0;      // bu karede sağ-yarı zıplama tetiği (edge)
int   _t_jump_prev = 0;
float _tj_cx = 0.0;     // joystick çıpası (ilk dokunuşta oluşur)
float _tj_cy = 0.0;
int   _tj_active = 0;

// Sağ yarı, kamera dönebiliyorken bir BAKIŞ pedidir: sürükleyince kamera döner,
// dokunup çekince (parmak kaymadan kalkarsa) zıplar. Sabit kamerada eskisi gibi
// yalnız zıplama düğmesi — o modda döndürecek bir şey yok.
float _t_lx = 0.0;      // bu kareki bakış deltası (piksel)
float _t_ly = 0.0;
float _tl_px = 0.0;     // son parmak konumu (delta için)
float _tl_py = 0.0;
int   _tl_active = 0;
float _tl_moved = 0.0;  // parmak toplam ne kadar kaydı (tap ayrımı)

func _read_touch3() {
    _t_dx = 0.0; _t_dz = 0.0;
    _t_lx = 0.0; _t_ly = 0.0;
    int n = touch_count();
    float halfw = _win_w * 0.5;
    int move_seen = 0;
    int look_seen = 0;
    int jump_now = 0;
    int i = 0;
    while (i < n) {
        float tx = touch_x(i) * 1.0;
        float ty = touch_y(i) * 1.0;
        if (tx < halfw) {
            if (_tj_active == 0) { _tj_cx = tx; _tj_cy = ty; _tj_active = 1; }
            float dx = tx - _tj_cx;
            float dy = ty - _tj_cy;
            float dl = sqrt(dx * dx + dy * dy);
            if (dl > 12.0) { _t_dx = dx / dl; _t_dz = dy / dl; }
            move_seen = 1;
        } else {
            if (_cam_mode3 == CAM_FIXED) {
                jump_now = 1;   // sağ yarı basılı
            } else {
                if (_tl_active == 0) {
                    _tl_px = tx; _tl_py = ty; _tl_active = 1; _tl_moved = 0.0;
                } else {
                    float lx = tx - _tl_px;
                    float ly = ty - _tl_py;
                    _t_lx = lx;
                    _t_ly = ly;
                    _tl_moved = _tl_moved + abs_f3(lx) + abs_f3(ly);
                    _tl_px = tx; _tl_py = ty;
                }
                look_seen = 1;
            }
        }
        i = i + 1;
    }
    if (move_seen == 0) { _tj_active = 0; }
    if (_cam_mode3 == CAM_FIXED) {
        // edge: sağ-yarı yeni basıldıysa zıpla (basılı tutmak tekrar tetiklemez)
        if (jump_now == 1 && _t_jump_prev == 0) { _t_jump = 1; } else { _t_jump = 0; }
        _t_jump_prev = jump_now;
        _tl_active = 0;
    } else {
        // bakış pedinde zıplama parmak KALKINCA tetiklenir: kaymadıysa dokunuştur,
        // kaydıysa bakıştır. (Basma anında tetiklersek her bakış hareketi zıplatır.)
        _t_jump = 0;
        if (look_seen == 0) {
            if (_tl_active == 1 && _tl_moved < 16.0) { _t_jump = 1; }
            _tl_active = 0;
        }
        _t_jump_prev = 0;
    }
}

// ---- Gamepad ---------------------------------------------------------------
// tame'de bağlamalar zaten vardı (`gamepad_down`/`gamepad_axis`/...), 3B giriş
// katmanı onları hiç okumuyordu: kolla oynanmıyordu.
//
// Okuma DOKUNMATİKLE AYNI DESENDE: `_read_gamepad3()` kare başına bir kez
// `play3d` içinden çağrılıp durumu buraya yazıyor; `_in_dx`/`jump_pressed`
// yalnız bu tamponu okuyor. Sebebi mimari: motorun fizik/çarpışma katmanı
// pencere AÇMADAN test edilebiliyor ve raylib'in girdi çağrıları pencere
// olmadan çağrılamaz. Girdi okumasını tek bir yere hapsetmek testleri
// grafiksiz tutuyor — aynı gerekçeyle `_read_touch3` de böyle.
//
// OTOMATİK: kol takılıysa çalışır, takılı değilse hiçbir şey olmaz. Klavye ve
// dokunmatik aynı anda açık kalır — biri diğerini kapatmıyor.
int   _gp_id3   = 0;        // hangi kol (0 = ilk)
int   _gp_use3  = 1;        // kullanıcı kapatabilir (gamepad3d(false))
int   _gp_here3 = 0;        // bu karede kol bağlı mı (okuma sonucu)
float _gp_dead3 = 0.22;     // ölü bölge (çubuk boştayken sürüklenmesin)
float _gp_sens3 = 180.0;    // bakış hızı: derece / saniye

float _gp_dx = 0.0;   float _gp_dz = 0.0;    // sol çubuk (hareket)
float _gp_lx = 0.0;   float _gp_ly = 0.0;    // sağ çubuk (bakış)
int   _gp_jump = 0;   int   _gp_start = 0;   // A / START (kenar)
int   _gp_ok = 0;     int   _gp_back = 0;    // A / B (menüde onay / geri)
int   _gp_nav = 0;    int   _gp_nav_prev = 0; // menüde yukarı(-1)/aşağı(+1)

// Ölü bölge + YENİDEN ÖLÇEKLEME: eşiği ham değere uygulayıp bırakmak, çubuk
// eşiği geçtiği anda hızın 0'dan 0.22'ye sıçraması demekti. Kalan aralık
// 0..1'e yayılıyor, böylece hafif itiş gerçekten hafif hareket veriyor.
// SAF eğri: cihazdan okumaz, ham eksen değerini dönüştürür. Cihaz okumasından
// ayrı durmasının sebebi test edilebilirlik — `gamepad_axis` pencere ister,
// bu matematik istemez.
func _gp_curve3(v): float {
    float a = abs_f3(v);
    if (a < _gp_dead3) { return 0.0; }
    float s = (a - _gp_dead3) / (1.0 - _gp_dead3);
    if (s > 1.0) { s = 1.0; }
    if (v < 0.0) { return 0.0 - s; }
    return s;
}

func _gp_axis3(name): float { return _gp_curve3(gamepad_axis(_gp_id3, name)); }

func _read_gamepad3() {
    _gp_dx = 0.0; _gp_dz = 0.0; _gp_lx = 0.0; _gp_ly = 0.0;
    _gp_jump = 0; _gp_start = 0; _gp_ok = 0; _gp_back = 0; _gp_nav = 0;
    _gp_here3 = 0;
    if (_gp_use3 == 0) { return; }
    if (!gamepad_available(_gp_id3)) { _gp_nav_prev = 0; return; }
    _gp_here3 = 1;

    _gp_dx = _gp_axis3("LX");
    _gp_dz = _gp_axis3("LY");     // yukarı = -1, ileri de -Z: doğrudan eşleşiyor
    _gp_lx = _gp_axis3("RX");
    _gp_ly = _gp_axis3("RY");

    if (gamepad_pressed(_gp_id3, "A")) { _gp_jump = 1; _gp_ok = 1; }
    if (gamepad_pressed(_gp_id3, "B")) { _gp_back = 1; }
    if (gamepad_pressed(_gp_id3, "START")) { _gp_start = 1; }

    // Menü gezinme: D-pad KENARI + sol çubuk. Çubuk sürekli bir eksen olduğu
    // için kenara çevriliyor — yoksa yukarı itip tutmak listeyi bir karede
    // sonuna kadar kaydırırdı.
    int nav = 0;
    if (gamepad_down(_gp_id3, "UP"))   { nav = 0 - 1; }
    if (gamepad_down(_gp_id3, "DOWN")) { nav = 1; }
    if (_gp_dz < 0.0 - 0.6) { nav = 0 - 1; }
    if (_gp_dz > 0.6)       { nav = 1; }
    if (nav != 0 && _gp_nav_prev == 0) { _gp_nav = nav; }
    _gp_nav_prev = nav;
}

// Kolu kapat/aç (varsayılan açık), hangi kol, ölü bölge, bakış hızı.
func gamepad3d(on) { if (on) { _gp_use3 = 1; } else { _gp_use3 = 0; } }
func gamepad_id3d(id) { _gp_id3 = id; }
func stick_deadzone3d(d) { _gp_dead3 = d; }
func gamepad_look_speed3d(deg_per_sec) { _gp_sens3 = deg_per_sec; }
// Bu karede kol bağlı mı? (Oyun "kol ipuçlarını göster" diye sorabilsin.)
func gamepad_active3d(): bool { return _gp_here3 == 1; }

func _in_dx(): float {
    float dx = 0.0;
    if (key_down(K_A)) { dx = dx - 1.0; }
    if (key_down(K_LEFT)) { dx = dx - 1.0; }
    if (key_down(K_D)) { dx = dx + 1.0; }
    if (key_down(K_RIGHT)) { dx = dx + 1.0; }
    if (dx > 1.0) { dx = 1.0; }
    if (dx < 0.0 - 1.0) { dx = 0.0 - 1.0; }
    if (dx == 0.0) { dx = _t_dx; }   // klavye yoksa dokunmatik
    if (dx == 0.0) { dx = _gp_dx; }  // o da yoksa kol (analog: değeri KORUNUR)
    return dx;
}
func _in_dz(): float {
    float dz = 0.0;
    if (key_down(K_W)) { dz = dz - 1.0; }
    if (key_down(K_UP)) { dz = dz - 1.0; }
    if (key_down(K_S)) { dz = dz + 1.0; }
    if (key_down(K_DOWN)) { dz = dz + 1.0; }
    if (dz > 1.0) { dz = 1.0; }
    if (dz < 0.0 - 1.0) { dz = 0.0 - 1.0; }
    if (dz == 0.0) { dz = _t_dz; }   // klavye yoksa dokunmatik
    if (dz == 0.0) { dz = _gp_dz; }  // o da yoksa kol
    return dz;
}
func jump_pressed(): bool { return key_pressed(K_SPACE) || _t_jump == 1 || _gp_jump == 1; }

// Hareket preset'i: WASD → yatay hız (çapraz normalize). Y hızına dokunmaz
// (yerçekimi/zıplama onu sürer). Hareket varsa entity o yöne döner (yaw).
//
// Yön KAMERAYA GÖREdir: "ileri", kameranın baktığı yöndür — kamerayı çevirip
// W'ye basınca yeni yöne gidersin. Sabit kamerada yaw hep 0 olduğu için bu
// dönüşüm birim matristir, yani eski sahnelerde hareket birebir aynı kalır.
func move3d(id, speed) {
    int i = _slot_of3(id);
    if (i < 0) { return; }
    float dx = _in_dx();
    float dz = _in_dz();
    float cy = _cam_yaw3 * DEG2RAD3;
    float cs = cos(cy);
    float sn = sin(cy);
    float wx = dx * cs - dz * sn;
    float wz = dx * sn + dz * cs;
    float m = sqrt(wx * wx + wz * wz);
    Ent3 e = _e3[i];
    if (m > 0.0) {
        // Büyüklük 1'i AŞARSA normalize edilir (çapraz klavye = sqrt(2)),
        // altındaysa KORUNUR: analog çubuğu yarım itmek yarım hız versin.
        // Eskiden koşulsuz normalize ediliyordu, yani her girdi tam hızdı —
        // klavye/dokunmatik için farksız (ikisi de zaten 1 üretiyor), kol
        // için ise analogluğun tamamen kaybı demekti.
        float k = 1.0;
        if (m > 1.0) { k = 1.0 / m; }
        e.vx = wx * k * speed;
        e.vz = wz * k * speed;
        e.yaw = atan2(wx, wz) * RAD2DEG3;   // rad→derece, hareket yönüne bak
    } else {
        e.vx = 0.0;
        e.vz = 0.0;
    }
    // Birinci şahısta gövde hareket yönüne değil, BAKIŞ yönüne döner —
    // yoksa geri giderken karakter kameranın içinde ters döner.
    if (_cam_mode3 == CAM_FPS) { e.yaw = _cam_yaw3; }
    _e3[i] = e;
}

// Zıpla: yalnız zemindeyken.
func jump3d(id, force) {
    int i = _slot_of3(id);
    if (i < 0) { return; }
    Ent3 e = _e3[i];
    // SUDA: zemine basmak gerekmez, her basış bir yüzme vuruşudur. Yoksa
    // suya düşen oyuncu dibe çakılıp bir daha çıkamazdı.
    if (_water_on3 == 1 && _water_phys3 == 1 && e.y < _water_y3) {
        e.vy = force * _water_swim3;
        e.grounded = 0;
        _e3[i] = e;
        return;
    }
    if (e.grounded == 1) { e.vy = force; e.grounded = 0; _e3[i] = e; }
}

// ---- Bölüm sistemi ---------------------------------------------------------
// level3d(1, kur_bolum1) ile kaydet; play3d en küçük numaralı bölümle başlar.
func level3d(n, fn) { push(_lvlN, n); push(_lvlF, fn); }

// Sonraki bölüme geç. İSTEKTİR — kare sonunda uygulanır, çağıran satırda değil.
// Kayıtlı sonraki bölüm yoksa oyun KAZANILDI sayılır.
// Sıradaki bölüme geç. `next_level3d()` çağrılması "bu bölüm TEMİZLENDİ"
// demektir, o yüzden ilerleme burada işaretleniyor. `goto_level3d(n)` ise
// serbest atlama (menü, hile, yeniden başlatma) — orada işaretleme YOK,
// yoksa oyuncu atladığı bölümü bitirmiş sayılırdı.
func next_level3d() { _s3_mark_level_done(_cur_lvl3); _lvl_pending3 = _cur_lvl3 + 1; }
func goto_level3d(n) { _lvl_pending3 = n; }
func level_now3d(): int { return _cur_lvl3; }
func won3d(): bool { return _won3 == 1; }

// Kayıtlı bölümler arasında `n` numaralıyı bul; yoksa -1.
func _lvl_index3(n): int {
    int i = 0;
    int cnt = length(_lvlN);
    while (i < cnt) {
        if (_lvlN[i] == n) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// Bekleyen bölüm geçişini UYGULA (yalnız kare sonunda çağrılır).
// Entity store tamamen silinir ama kancalar/callback'ler KALIR — bölüm kurulum
// fn'i sahneyi sıfırdan kurar, oyunun kuralları yerinde durur.
func _s3_apply_level() {
    int want = _lvl_pending3;
    _lvl_pending3 = 0 - 1;
    int idx = _lvl_index3(want);
    if (idx < 0) {
        _won3 = 1;          // kayıtlı bölüm kalmadı → oyun kazanıldı
        _game_over3 = 1;
        return;
    }
    _e3 = []; _e3gen = []; _e3free = []; _free_n3 = 0;
    _trg_clear3();          // bölgeler yerleştirilmiş geometri: bölümle gider
    _s3_particles_clear();  // önceki bölümün patlamaları yeni sahneye taşmasın
    _hit_me = 0 - 1; _hit_other = 0 - 1;
    _cam_target = 0 - 1;    // kurulum fn'i camera_follow'u yeniden çağırır
    _cur_lvl3 = want;
    call(_lvlF[idx]);
}

// ===========================================================================
// Kalıcılık: rekor + bölüm ilerlemesi
// ===========================================================================
// tame `save_data`/`load_data` veriyordu (masaüstünde CWD, Android'de
// internalDataPath) ama scene3d kullanmıyordu: rekor da, açılan bölüm de
// oyunla birlikte yok oluyordu. arcade'de ikisi de vardı.
//
// OPT-IN (`save_progress3d()`), bilerek: kalıcılık **diske yazmak** demek ve
// motor bunu istenmeden yapmamalı — aksi hâlde her örnek çalıştırması çalışma
// dizinine dosya bırakırdı. Açan oyun tek satırla açar.
//
// Anahtar sahne başlığından türetiliyor, yani iki farklı oyun birbirinin
// rekorunu ezmez. arcade ile aynı dosya deseni, farklı önek.
int _sav_on = 0;
int _best3 = 0;
int _new_rec3 = 0;
array _lvl_done3 = [];      // 1-tabanlı: _lvl_done3[k-1] == 1 → k. bölüm bitti

func _sav_key3(): str { return "scene3d_best_" + _win_title + ".txt"; }
func _sav_lvl_key3(k): str {
    return "scene3d_lvl_" + _win_title + "_" + toString(k) + ".txt";
}

// ---- Ses seviyesi -----------------------------------------------------------
// Motorda ANA ses seviyesi yoktu: yalnız müzik başına `music_volume` vardı,
// yani yayınlanmış bir oyunda sesi kısmanın yolu YOKTU. Değer motorda
// tutuluyor ve tame'e itiliyor (`master_volume`), çünkü ekranın göstereceği
// sayıyı geri okuyacak bir builtin yok — ve olsaydı da iki doğruluk kaynağı
// olurdu.
float _s3_vol3 = 1.0;
func _sav_vol_key3(): str { return "scene3d_vol_" + _win_title + ".txt"; }

// Diske yazmak OPT-IN, kaydın geri kalanıyla aynı kural: `kayit_ac3d`
// çağırmayan bir oyun kullanıcının diskine dosya bırakmıyor. Kapalıyken ayar
// yine ÇALIŞIYOR, yalnız oturumla sınırlı.
func ses_seviye3d(v) {
    float x = v * 1.0;
    if (x < 0.0) { x = 0.0; }
    if (x > 1.0) { x = 1.0; }
    _s3_vol3 = x;
    master_volume(_s3_vol3);
    if (_sav_on == 1 && length(_win_title) > 0) {
        save_data(_sav_vol_key3(), toString(toInt(_s3_vol3 * 100.0)));
    }
}
func volume3d(v) { ses_seviye3d(v); }
func ses_seviye_now3d(): float { return _s3_vol3; }
func volume_now3d(): float { return _s3_vol3; }

// Adım 10%: kolla/klavyeyle on basışta uçtan uca gidiliyor. Daha ince bir
// adım, kumandayla ayar yapmayı angaryaya çevirirdi.
func _s3_vol_step3(): float { return 0.1; }

func _s3_load_progress() {
    _best3 = 0;
    _lvl_done3 = [];
    if (_sav_on == 0 || length(_win_title) == 0) { return; }
    str s = load_data(_sav_key3());
    if (length(s) > 0) { _best3 = toInt(s); }
    // Ses seviyesi de kayıttan geliyor ve HEMEN uygulanıyor: yalnız
    // değişkeni doldurmak, oyuncunun geçen sefer kıstığı sesi bu oturumda
    // sessizce tam açık bırakırdı.
    str sv = load_data(_sav_vol_key3());
    if (length(sv) > 0) {
        _s3_vol3 = toInt(sv) / 100.0;
        if (_s3_vol3 < 0.0) { _s3_vol3 = 0.0; }
        if (_s3_vol3 > 1.0) { _s3_vol3 = 1.0; }
        master_volume(_s3_vol3);
    }
    // Bölüm bayrakları: kayıtlı bölüm sayısı kadar oku.
    int n = length(_lvlN);
    int k = 1;
    while (k <= n) {
        str d = load_data(_sav_lvl_key3(k));
        if (d == "1") { push(_lvl_done3, 1); } else { push(_lvl_done3, 0); }
        k = k + 1;
    }
}

// Kalıcılığı aç. `scene3d(w, h, title)`DAN SONRA çağır — anahtar başlıktan
// türetiliyor. play3d() de emniyet için yüklenmemişse yükler.
func save_progress3d() { _sav_on = 1; _s3_load_progress(); }
func kayit_ac3d() { save_progress3d(); }

func best_score3d(): int { return _best3; }
func rekor3d(): int { return _best3; }
func new_record3d(): bool { return _new_rec3 == 1; }
func rekor_kirildi3d(): bool { return _new_rec3 == 1; }

// Skoru rekora işle. Her puanda değil, DOĞAL KONTROL NOKTALARINDA çağrılıyor
// (oyun bitişi) — her `score3d_add` için diske yazmak saçma olurdu.
func _s3_commit_score() {
    if (_score3 > _best3) {
        _best3 = _score3;
        _new_rec3 = 1;
        if (_sav_on == 1 && length(_win_title) > 0) {
            save_data(_sav_key3(), toString(_best3));
        }
    }
}

func level_done3d(k): bool {
    if (k < 1 || k > length(_lvl_done3)) { return false; }
    return _lvl_done3[k - 1] == 1;
}
func bolum_bitti_mi3d(k): bool { return level_done3d(k); }

// Kaldığın yer: 1'den başlayarak KESİNTİSİZ tamamlanan bölümlerin sonrası.
// Kesintisiz olması önemli — 3. bölüm bitmiş ama 2. bitmemişse oyuncu 2'den
// devam etmeli, yoksa atladığı bölümü hiç görmez.
func unlocked_level3d(): int {
    int k = 1;
    while (level_done3d(k)) { k = k + 1; }
    return k;
}
func acik_bolum3d(): int { return unlocked_level3d(); }

func _s3_mark_level_done(k) {
    if (k < 1) { return; }
    while (length(_lvl_done3) < k) { push(_lvl_done3, 0); }
    if (_lvl_done3[k - 1] == 1) { return; }      // zaten işaretli, tekrar yazma
    _lvl_done3[k - 1] = 1;
    if (_sav_on == 1 && length(_win_title) > 0) {
        save_data(_sav_lvl_key3(k), "1");
    }
}

// ===========================================================================
// Menü / UI katmanı
// ===========================================================================
// Motor Faz 7-10'da "üstüne oyun yazılabilir" hale geldi ama YAYINLANABİLİR
// değildi: başlangıç ekranı, duraklatma ve oyun bittiğinde yeniden başlama yoktu
// — oyun-bitti ekranı sadece yazı basıyordu, hiçbir tuş iş yapmıyordu, tek çıkış
// pencereyi kapatmaktı. arcade'de bunların hepsi var; 3B'de yoktu.
//
// Üç kural:
//   • Başlangıç ekranı OPT-IN (`menu3d(...)`). Çağırmayan sahne bit-bit eskisi
//     gibi, doğrudan oyuna girerek çalışır.
//   • Duraklat her zaman açık — ESC/P/GERİ. Bunu mümkün kılan şey
//     `exit_key(K_NONE)`: raylib varsayılanı ESC'ye basılınca pencereyi
//     kapatmak ve bu Tulpar tarafında yakalanamıyordu.
//   • Her düğme klavye + fare + DOKUNMATİK ile çalışır (Android hedefi).

int UI_NONE  = 0;   // oyun akıyor
int UI_TITLE = 1;   // başlangıç ekranı
int UI_PAUSE = 2;   // duraklat örtüsü
int UI_LEVELS = 3;  // bölüm seçme ızgarası
int UI_SETTINGS = 4; // ayarlar (ses)
int _s3_ui = UI_NONE;

int _s3_has_title = 0;
str _s3_title_txt = "";
str _s3_title_sub = "";
// `var`, `int` DEĞİL: fonksiyon referansı boxed bir değer, natif i64 global'e
// yazılınca kırpılır ve call() hiçbir şey çağırmaz. Dosyadaki diğer kancalar
// (_setup3_fn, _update3_fn, _hud3_fn) aynı sebeple `var`.
var _s3_restart_fn = 0;
int _s3_has_restart = 0;
int _s3_quit = 0;          // menüden çıkış istendi → oyun döngüsü biter

str _s3_lang_c = "";
func _s3_lang(): str {
    if (_s3_lang_c == "") {
        if (sys_lang() == "en") { _s3_lang_c = "en"; } else { _s3_lang_c = "tr"; }
    }
    return _s3_lang_c;
}
func _s3_t(tr, en): str { if (_s3_lang() == "en") { return en; } return tr; }

// Başlangıç ekranını aç. Çağrılmazsa oyun doğrudan başlar (eski davranış).
func menu3d(title, subtitle) {
    _s3_has_title = 1;
    _s3_title_txt = title;
    _s3_title_sub = subtitle;
    _s3_ui = UI_TITLE;
}

// Yeniden başlarken çağrılacak kanca. Bölüm kaydedilmiş sahnelerde gerekmez
// (motor en küçük bölüme döner); bölümsüz tek sahnelerde sahneyi kuran şey
// `setup` olduğu için motor onu tek başına tekrarlayamaz — setup kancaları da
// kaydediyor, ikinci kez çalıştırmak onları çoğaltırdı. Bu kanca o boşluğu
// oyunun kendi bilgisiyle dolduruyor.
func on_restart3d(fn) { _s3_restart_fn = fn; _s3_has_restart = 1; }

func pause3d()  { if (_game_over3 == 0 && _s3_ui == UI_NONE) { _s3_ui = UI_PAUSE; } }
func resume3d() { if (_s3_ui == UI_PAUSE) { _s3_ui = UI_NONE; } }
func paused3d(): bool { return _s3_ui == UI_PAUSE; }
func quit3d()   { _s3_quit = 1; }

// Menülerdeki "Çıkış" ve ESC kestirmesi. EDİTÖR UYGULAMASINDA programı
// KAPATMAZ: editör asıl uygulama, oyun onun içinde koşan bir ÖNİZLEME.
//
// Kapatıyordu ve kullanıcı bildirdi: editörde OYNAT'a bas, oyun bitsin
// (kazan/kaybet), ESC'ye bas → bütün editör kapanıyordu, kaydedilmemiş
// sahne dâhil. `_s3_over_step` ESC'yi "çık" sayıyor, o da `_s3_quit = 1`
// yapıp döngüyü kırıyordu. Oyun-bitti ekranından çıkmanın tek anlamı
// editörde düzenlemeye DÖNMEK.
// Menü düğmesinin ETİKETİ. Editörde "Çıkış" yazan bir düğme yalan söylüyordu:
// bastığında program kapanmıyor, düzenlemeye dönüyor.
func _s3_quit_lbl3(): str {
    if (_ed_app3 == 1) { return _s3_t("Duzenle", "Edit"); }
    return _s3_t("Cikis", "Quit");
}

// Menü ADIMININ sonucunu eyleme çevir. Ayrı fonksiyon olmasının sebebi
// SINANABİLİRLİK: bu dağıtım `play3d`'nin döngüsünün göbeğindeydi, yani
// pencere olmadan çalıştırılamıyordu — ve "çıkış artık durdurma"
// düzeltmesini çağrı yerinden geri almak HİÇBİR testi kırmıyordu (bozma
// denendi, kaçtı). Yardımcıyı sınamak yetmiyor; onu ÇAĞIRDIĞINI da
// sınamak gerekiyor.
//   kind: 0 = başlık ekranı, 1 = duraklat, 2 = oyun bitti
func _s3_menu_act3(kind, a) {
    if (a == 0) { return; }
    if (kind == 0) {
        // Konuma göre değil TÜRE göre: düğme listesi duruma göre değişiyor.
        int t = _s3_title_kind3(a - 1);
        if (t == _TB_START3) { _s3_ui = UI_NONE; return; }
        if (t == _TB_CONT3) {
            // Geçiş ERTELENMİŞ (`_lvl_pending3`), kare sonunda uygulanıyor —
            // oyun içindeki bölüm değişimiyle aynı yol. Menüden anında
            // yüklemek, aynı işi ikinci bir yerde yapmak olurdu.
            goto_level3d(unlocked_level3d());
            _s3_ui = UI_NONE;
            return;
        }
        if (t == _TB_LVLS3) { _s3_ui = UI_LEVELS; return; }
        _s3_quit_or_stop3();
        return;
    }
    // Bölüm seçme ızgarası. a = -1 geri, a > 0 seçilen bölüm.
    if (kind == 3) {
        if (a < 0) { _s3_ui = UI_TITLE; return; }
        // KİLİTLİ bölüm iş görmüyor. Kare çiziliyor (kaç bölüm olduğu bilgisi
        // de bir bilgi) ama soluk, yani "olmadı" sessiz değil GÖRÜNÜR.
        if (_s3_lv_open3(a) == false) { return; }
        goto_level3d(a);
        _s3_ui = UI_NONE;
        return;
    }
    if (kind == 1) {
        int pk = _s3_pause_kind3(a - 1);
        if (pk == _PB_RESUME3)  { _s3_ui = UI_NONE; return; }
        if (pk == _PB_RESTART3) { restart3d(); return; }
        if (pk == _PB_SET3)     { _s3_ui = UI_SETTINGS; return; }
        _s3_quit_or_stop3();
        return;
    }
    // Ayarlar. GERİ duraklata dönüyor — ayarlar oradan açıldı ve oyuna
    // doğrudan dönmek, duraklatmayı da sessizce kaldırırdı.
    if (kind == 4) {
        if (a == 1) { ses_seviye3d(_s3_vol3 - _s3_vol_step3()); return; }
        if (a == 2) { ses_seviye3d(_s3_vol3 + _s3_vol_step3()); return; }
        _s3_ui = UI_PAUSE;
        return;
    }
    if (a == 1) { restart3d(); return; }
    _s3_quit_or_stop3();
}

func _s3_quit_or_stop3() {
    if (_ed_app3 == 1) {
        // Bayraklar önce: `ed_stop3d` oynamıyorken erken dönüyor ve o hâlde
        // örtü ekranda kalırdı — yani ESC hiçbir şey yapmaz görünürdü.
        _game_over3 = 0; _won3 = 0;
        _s3_ui = UI_NONE;
        ed_stop3d();
        return;
    }
    _s3_quit = 1;
}

// Baştan başla. Sırayla: bölüm varsa en küçüğüne dön, yoksa on_restart3d
// kancasını çağır, o da yoksa yalnız skoru/durumu sıfırla (sahne yerinde kalır —
// belgelenmiş sınır, sessiz değil).
func restart3d() {
    _score3 = 0;
    _game_over3 = 0;
    _won3 = 0;
    _new_rec3 = 0;   // rekor rozeti YENİ ele ait; kalıcı rekorun kendisi durur
    _s3_ui = UI_NONE;
    _hit_me = 0 - 1; _hit_other = 0 - 1;
    if (length(_lvlN) > 0) {
        int lo = _lvlN[0];
        int li = 1;
        while (li < length(_lvlN)) {
            if (_lvlN[li] < lo) { lo = _lvlN[li]; }
            li = li + 1;
        }
        _lvl_pending3 = lo;
        _s3_apply_level();
        return;
    }
    if (_s3_has_restart == 1) {
        _e3 = []; _e3gen = []; _e3free = []; _free_n3 = 0;
        _bx = []; _by = []; _bz = []; _br = [];
        _s3_particles_clear();
        _cam_target = 0 - 1;
        call(_s3_restart_fn);
    }
}

// ---- Düğme çizimi + isabet testi -------------------------------------------
// Ölçüler pencereye göre oransal: aynı düzen 960x560 masaüstünde de, dar bir
// telefon ekranında da çalışsın.
// Dikey düğme listesi EN ÇOK dört düğme taşıyor (başlık ekranı duruma göre
// 2-4 gösteriyor). Adım sabit 0.15 iken dördüncü düğme ekranın TAM alt
// kenarına dayanıyordu: 0.44 + 3×0.15 + 0.11 = 1.00, yani sıfır boşluk.
// Adım artık tavandan TÜRÜYOR — sayı değişince yerleşim kendini toparlıyor.
int   _S3_BTN_MAX3 = 4;
float _S3_BTN_TOP3 = 0.44;   // ilk düğmenin üstü
float _S3_BTN_BOT3 = 0.97;   // son düğmenin bitebileceği en alt yer
func _s3_btn_w(): float { return _win_w * 0.44; }
func _s3_btn_h(): float { return _win_h * 0.11; }
func _s3_btn_x(): float { return (_win_w - _s3_btn_w()) * 0.5; }
func _s3_btn_step3(): float {
    return (_S3_BTN_BOT3 - _S3_BTN_TOP3 - 0.11) / (_S3_BTN_MAX3 - 1);
}
func _s3_btn_y(i): float { return _win_h * (_S3_BTN_TOP3 + i * _s3_btn_step3()); }

// Menüde SEÇİLİ düğme. Fare/parmak doğrudan tıkladığı için buna ihtiyaç
// duymuyordu; kol ve klavye ise bir imleç olmadan üç düğmeli duraklat
// menüsünde "Yeniden"i seçemez — Enter hep ilk düğmeye giderdi.
int _s3_sel3 = 0;
int _s3_ui_prev3 = 0 - 1;   // imleci sıfırlamak için: bir önceki UI durumu

func _s3_btn_draw(i, label) {
    float bx = _s3_btn_x(); float by = _s3_btn_y(i);
    float bw = _s3_btn_w(); float bh = _s3_btn_h();
    if (i == _s3_sel3) {
        rect(bx, by, bw, bh, rgba(86, 102, 150, 245));
        // Seçiliyi ikinci bir çerçeveyle kalınlaştır: tek renk farkı düşük
        // kontrastlı ekranda kaybolabiliyor.
        rect_lines(bx, by, bw, bh, GOLD);
        rect_lines(bx - 3.0, by - 3.0, bw + 6.0, bh + 6.0, GOLD);
    } else {
        rect(bx, by, bw, bh, rgba(46, 54, 82, 235));
        rect_lines(bx, by, bw, bh, rgba(190, 160, 60, 200));
    }
    int sz = toInt(bh * 0.38);
    text(label, toInt(bx + (bw - measure_text(label, sz)) * 0.5),
         toInt(by + (bh - sz) * 0.5), sz, RAYWHITE);
}

// Seçimi yukarı/aşağı taşı (klavye okları + kol D-pad/sol çubuk). Sarmalamıyor:
// listenin ucunda durmak, kolla hızlı basarken yanlış düğmeye geçmekten iyi.
func _s3_menu_nav(count) {
    int d = 0;
    if (key_pressed(K_UP))   { d = 0 - 1; }
    if (key_pressed(K_DOWN)) { d = 1; }
    if (_gp_nav != 0) { d = _gp_nav; }
    if (d == 0) { return; }
    _s3_sel3 = _s3_sel3 + d;
    if (_s3_sel3 < 0) { _s3_sel3 = 0; }
    if (_s3_sel3 >= count) { _s3_sel3 = count - 1; }
}

// Onay: Enter/Space ya da kolda A.
func _s3_confirm3(): bool {
    return key_pressed(K_ENTER) || key_pressed(K_SPACE) || _gp_ok == 1;
}

// (px,py) i. düğmenin içinde mi?
func _s3_btn_hit(i, px, pz): bool {
    float bx = _s3_btn_x(); float by = _s3_btn_y(i);
    return px >= bx && px <= bx + _s3_btn_w()
        && pz >= by && pz <= by + _s3_btn_h();
}

// Bu karede hangi düğmeye BASILDI (kenar tetikli)? Yoksa -1.
// Fare ve parmak aynı isabet testinden geçer; ikisi de "yeni basıldı" kenarı
// olduğu için basılı tutmak tekrar tetiklemez.
int _s3_tap_prev = 0;
func _s3_btn_pressed(count): int {
    int hit = 0 - 1;
    float px = 0.0; float pz = 0.0;
    int now = 0;
    if (mouse_pressed(0)) { px = mouse_x() * 1.0; pz = mouse_y() * 1.0; now = 1; }
    int tn = touch_count();
    if (tn > 0) {
        float tx = touch_x(0) * 1.0; float ty = touch_y(0) * 1.0;
        if (_s3_tap_prev == 0) { px = tx; pz = ty; now = 1; }
    }
    if (tn > 0) { _s3_tap_prev = 1; } else { _s3_tap_prev = 0; }
    if (now == 0) { return 0 - 1; }
    int i = 0;
    while (i < count) {
        if (_s3_btn_hit(i, px, pz)) { hit = i; }
        i = i + 1;
    }
    return hit;
}

func _s3_dim() {
    rect(0.0, 0.0, _win_w * 1.0, _win_h * 1.0, rgba(8, 10, 16, 190));
}

func _s3_center_text(s, y, size, col) {
    text(s, toInt((_win_w - measure_text(s, size)) * 0.5), toInt(y), size, col);
}

// ---- Başlangıç ekranı ------------------------------------------------------
// Düğme listesi DURUMA göre değişiyor, o yüzden "2. düğme çıkış" gibi sabit
// bir eşleme YOK: her düğmenin NE OLDUĞU soruluyor (`_s3_title_kind3`) ve iş
// ona göre yapılıyor. Konuma göre dağıtmak, listeye bir düğme eklendiğinde
// sessizce yanlış işi yaptırırdı — menü şeridinde tam olarak bu yaşandı.
// Değerler konumlarla çakışmasın diye kaydırılmış (bkz. `_PB_*`): tür
// eşlemesini birim fonksiyona düşürmek, konuma göre dağıtan bir kestirmeyi
// sessizce çalışır kılardı.
int _TB_START3 = 20;   // Başla — 1. bölümden
int _TB_CONT3  = 21;   // Devam — kaldığın bölümden
int _TB_LVLS3  = 22;   // Bölümler — seçme ızgarası
int _TB_QUIT3  = 23;   // Çıkış

// DEVAM yalnız gerçekten ilerleme varsa. "Devam (Bölüm 1)" ile "Başla" aynı
// şeydir ve iki ayrı düğme olarak durmaları kullanıcıya olmayan bir soru
// sordururdu.
func _s3_has_continue3(): bool {
    if (_sav_on == 0) { return false; }
    return unlocked_level3d() > 1;
}
// BÖLÜMLER yalnız çok bölümlü VE kayıt açık sahnede: kayıt yokken hiçbir
// bölüm açılmış olmaz ve ekran tek kilitli kareden ibaret bir çıkmaz olurdu.
// OYNANABİLİR bölüm sayısı `_lvlN`'den geliyor, `level_count3d()`'ten DEĞİL:
// o, sahne JSON'undaki bölüm dizisini sayıyor ve elle yazılmış bir oyunda
// (`level3d(1, "kur1")`) o dizi BOŞ. Menü "kaç bölüm oynanabilir" diye
// soruyor, "kaç bölüm serileştirildi" diye değil.
func _s3_lv_count3(): int { return length(_lvlN); }

func _s3_has_levels3(): bool {
    if (_sav_on == 0) { return false; }
    return _s3_lv_count3() > 1;
}

func _s3_title_n3(): int {
    int n = 2;                                   // Başla + Çıkış hep var
    if (_s3_has_continue3()) { n = n + 1; }
    if (_s3_has_levels3())   { n = n + 1; }
    return n;
}
// ÇIKIŞ her zaman SON düğme: ESC'nin nereye gideceği de buradan geliyor.
func _s3_title_qi3(): int { return _s3_title_n3() - 1; }

func _s3_title_kind3(i): int {
    if (i <= 0) { return _TB_START3; }
    int k = 1;
    if (_s3_has_continue3()) {
        if (i == k) { return _TB_CONT3; }
        k = k + 1;
    }
    if (_s3_has_levels3()) {
        if (i == k) { return _TB_LVLS3; }
        k = k + 1;
    }
    return _TB_QUIT3;
}

func _s3_title_lbl3(i): str {
    int k = _s3_title_kind3(i);
    if (k == _TB_START3) { return _s3_t("Basla", "Start"); }
    if (k == _TB_CONT3) {
        return _s3_t("Devam  (Bolum ", "Continue  (Level ") +
               toString(unlocked_level3d()) + ")";
    }
    if (k == _TB_LVLS3) { return _s3_t("Bolumler", "Levels"); }
    return _s3_quit_lbl3();
}

func _s3_title_draw() {
    _s3_dim();
    int tsz = toInt(_win_h * 0.10);
    _s3_center_text(_s3_title_txt, _win_h * 0.16, tsz, GOLD);
    if (length(_s3_title_sub) > 0) {
        _s3_center_text(_s3_title_sub, _win_h * 0.30, toInt(_win_h * 0.045), RAYWHITE);
    }
    if (_sav_on == 1 && _best3 > 0) {
        _s3_center_text(_s3_t("Rekor: ", "Best: ") + toString(_best3),
                        _win_h * 0.365, toInt(_win_h * 0.04), GOLD);
    }
    int i = 0;
    int n = _s3_title_n3();
    while (i < n) { _s3_btn_draw(i, _s3_title_lbl3(i)); i = i + 1; }
}

// Dönüş: 0 = bekle, aksi hâlde SEÇİLEN DÜĞMENİN sırası + 1.
func _s3_title_step(): int {
    int n = _s3_title_n3();
    _s3_menu_nav(n);
    // Enter/Space SEÇİLİ düğmeyi işletir. İmleç 0'da başladığı için eski
    // "Enter = Basla" davranışı birebir korunuyor.
    if (_s3_confirm3()) { return _s3_sel3 + 1; }
    // ESC = ÇIKIŞ, düğme sırası ne olursa olsun. Sabit "2" yazmak, araya bir
    // düğme girdiğinde ESC'yi "Bölümler"e bağlardı.
    if (key_pressed(K_ESC) || _gp_back == 1) { return _s3_title_qi3() + 1; }
    int b = _s3_btn_pressed(n);
    if (b >= 0) { return b + 1; }
    return 0;
}

// ---- Bölüm seçme ızgarası --------------------------------------------------
// Motor bitirilen bölümleri ZATEN diske yazıyordu (`_s3_mark_level_done`) ve
// kaldığın yeri ZATEN hesaplıyordu (`unlocked_level3d`) — ama hiçbir yer o
// cevabı sormuyordu: beş bölüm bitiren oyuncu ertesi gün yine 1. bölümden
// başlıyordu. Kayıt sisteminin başlığındaki söz burada tutuluyor.
//
// Dikey düğme listesi 4 düğmede ekranı dolduruyor (`_s3_btn_y`), yani sekiz
// bölüm oraya sığmaz — bölümler ayrı bir IZGARADA.
func _s3_lv_cols3(n): int {
    if (n <= 4) { return n; }
    if (n <= 9) { return 3; }
    return 5;
}
func _s3_lv_rows3(n): int {
    int c = _s3_lv_cols3(n);
    if (c < 1) { return 1; }
    return toInt((n + c - 1) / c);
}
// Izgara BİR BANDIN içinde yaşıyor: başlığın altı ile alt kenar payı arası.
// Sınırları sabit tutmak, "ekrandan taşmadı" iddiasını ölçülebilir yapıyor —
// yoksa taşma ancak bölüm sayısı büyüdüğünde ve kimse bakmazken olurdu.
float _S3_LV_TOP3 = 0.26;
float _S3_LV_BOT3 = 0.96;
func _s3_lv_gap3(): float  { return _win_h * 0.03; }

// Hücre boyu SIĞMAYA göre türüyor. Sabit boy, bölüm sayısı arttıkça ızgarayı
// bandın dışına taşırıyordu ve ekranda kaydırma YOK — yani 25 bölümlük bir
// oyunda alt sıra hiç görünmezdi. Tavan da var: üç bölümlük bir oyunda
// ekranı dolduran kocaman kareler saçma olurdu.
func _s3_lv_cell3(n): float {
    int rows = _s3_lv_rows3(n);
    int cols = _s3_lv_cols3(n);
    if (rows < 1) { rows = 1; }
    if (cols < 1) { cols = 1; }
    float g = _s3_lv_gap3();
    float ch = (_win_h * (_S3_LV_BOT3 - _S3_LV_TOP3) - (rows - 1) * g) / rows;
    float cw = (_win_w * 0.80 - (cols - 1) * g) / cols;
    float c = ch;
    if (cw < c) { c = cw; }
    if (c > _win_h * 0.14) { c = _win_h * 0.14; }
    if (c < _win_h * 0.03) { c = _win_h * 0.03; }
    return c;
}

func _s3_lv_x3(i, n): float {
    int c = _s3_lv_cols3(n);
    if (c < 1) { c = 1; }
    int col = mod(i, c);
    float cs = _s3_lv_cell3(n);
    float w = c * cs + (c - 1) * _s3_lv_gap3();
    return (_win_w - w) * 0.5 + col * (cs + _s3_lv_gap3());
}
func _s3_lv_y3(i, n): float {
    int c = _s3_lv_cols3(n);
    if (c < 1) { c = 1; }
    int row = toInt(i / c);
    int rows = _s3_lv_rows3(n);
    float cs = _s3_lv_cell3(n);
    float h = rows * cs + (rows - 1) * _s3_lv_gap3();
    // Izgara BANDIN içinde dikeyde ortalanıyor.
    return _win_h * _S3_LV_TOP3 + (_win_h * (_S3_LV_BOT3 - _S3_LV_TOP3) - h) * 0.5
           + row * (cs + _s3_lv_gap3());
}

// AÇIK bölüm: kesintisiz tamamlananların bir sonrasına kadar. Kilitliyi
// seçilebilir yapmak oyunu atlanabilir kılardı; gizlemek ise "kaç bölüm var"
// bilgisini de götürürdü — o yüzden çiziliyor ama soluk.
func _s3_lv_open3(k): bool { return k <= unlocked_level3d(); }

// Izgarada gezinme: sol/sağ bir hücre, yukarı/aşağı bir SATIR. Dikey listenin
// `_s3_menu_nav`i yalnız yukarı/aşağı biliyor ve satır atlamıyordu.
// Sınırın dışına çıkan hareket YOK SAYILIYOR (sarmalamıyor): kolla hızlı
// basarken karşı köşeye ışınlanmak yanlış bölümü başlatırdı.
func _s3_lv_nav3(sel, n, dx, dy): int {
    int c = _s3_lv_cols3(n);
    if (c < 1) { c = 1; }
    int col = mod(sel, c);
    if (dx != 0) {
        int nc = col + dx;
        if (nc < 0 || nc >= c) { return sel; }
    }
    int t = sel + dx + dy * c;
    if (t < 0 || t >= n) { return sel; }
    return t;
}

func _s3_levels_draw() {
    _s3_dim();
    int n = _s3_lv_count3();
    _s3_center_text(_s3_t("BOLUMLER", "LEVELS"), _win_h * 0.10,
                    toInt(_win_h * 0.075), GOLD);
    _s3_center_text(_s3_t("ESC: geri", "ESC: back"), _win_h * 0.20,
                    toInt(_win_h * 0.035), RAYWHITE);
    float cs = _s3_lv_cell3(n);
    int i = 0;
    while (i < n) {
        float bx = _s3_lv_x3(i, n);
        float by = _s3_lv_y3(i, n);
        bool acik = _s3_lv_open3(i + 1);
        if (i == _s3_sel3) {
            rect(bx, by, cs, cs, rgba(86, 102, 150, 245));
            rect_lines(bx, by, cs, cs, GOLD);
            rect_lines(bx - 3.0, by - 3.0, cs + 6.0, cs + 6.0, GOLD);
        } else {
            rect(bx, by, cs, cs, rgba(46, 54, 82, 235));
            rect_lines(bx, by, cs, cs, rgba(190, 160, 60, 200));
        }
        int col = RAYWHITE;
        if (acik == false) { col = rgba(120, 126, 140, 255); }
        str lab = toString(i + 1);
        int sz = toInt(cs * 0.40);
        text(lab, toInt(bx + (cs - measure_text(lab, sz)) * 0.5),
             toInt(by + (cs - sz) * 0.5), sz, col);
        // BİTMİŞ bölüm işaretli: "açık" ile "bitmiş" ayrı şeyler ve oyuncu
        // nereye kadar geldiğini görmek ister.
        if (level_done3d(i + 1)) {
            int ssz = toInt(cs * 0.22);
            text("*", toInt(bx + cs - ssz * 1.1), toInt(by + ssz * 0.2), ssz, GOLD);
        }
        i = i + 1;
    }
}

// Dönüş: 0 = bekle, -1 = geri, k>0 = k. bölüm seçildi.
func _s3_levels_step(): int {
    int n = _s3_lv_count3();
    if (n < 1) { return 0 - 1; }
    int dx = 0; int dy = 0;
    if (key_pressed(K_LEFT))  { dx = 0 - 1; }
    if (key_pressed(K_RIGHT)) { dx = 1; }
    if (key_pressed(K_UP))    { dy = 0 - 1; }
    if (key_pressed(K_DOWN))  { dy = 1; }
    if (_gp_nav != 0) { dy = _gp_nav; }
    if (dx != 0 || dy != 0) { _s3_sel3 = _s3_lv_nav3(_s3_sel3, n, dx, dy); }
    if (key_pressed(K_ESC) || _gp_back == 1) { return 0 - 1; }
    if (_s3_confirm3()) { return _s3_sel3 + 1; }
    int t = _s3_lv_hit3(n);
    if (t >= 0) { return t + 1; }
    return 0;
}

// Fare/parmak hangi kareye bastı? Yoksa -1. Kenar tetikli — düğme listesinin
// `_s3_btn_pressed`i ile aynı sözleşme.
int _s3_lv_tap_prev3 = 0;
func _s3_lv_hit3(n): int {
    float px = 0.0; float pz = 0.0;
    int now = 0;
    if (mouse_pressed(0)) { px = mouse_x() * 1.0; pz = mouse_y() * 1.0; now = 1; }
    int tn = touch_count();
    if (tn > 0) {
        if (_s3_lv_tap_prev3 == 0) { px = touch_x(0) * 1.0; pz = touch_y(0) * 1.0; now = 1; }
    }
    if (tn > 0) { _s3_lv_tap_prev3 = 1; } else { _s3_lv_tap_prev3 = 0; }
    if (now == 0) { return 0 - 1; }
    float cs = _s3_lv_cell3(n);
    int i = 0;
    int hit = 0 - 1;
    while (i < n) {
        float bx = _s3_lv_x3(i, n);
        float by = _s3_lv_y3(i, n);
        if (px >= bx && px <= bx + cs && pz >= by && pz <= by + cs) { hit = i; }
        i = i + 1;
    }
    return hit;
}

// ---- Duraklat örtüsü -------------------------------------------------------
// AYARLAR duraklat menüsünde, başlık ekranında DEĞİL: dikey liste en çok
// dört düğme taşıyor (`_S3_BTN_MAX3`) ve başlık ekranı zaten dördü de
// kullanabiliyor (Başla / Devam / Bölümler / Çıkış). Duraklat oyunun her
// yerinden bir tuş uzakta, yani ses ayarı erişilemez olmuyor.
//
// Duraklat listesi de TÜRE göre dağıtılıyor — başlıktakiyle aynı sebep:
// araya "Ayarlar" girdiğinde konuma sabitlenmiş bir dağıtıcı "Çıkış"ı
// sessizce ayarlara bağlamıştı (regresyon testi yakaladı).
// Değerler KONUMLARLA ÇAKIŞMASIN diye kaydırılmış. 0,1,2,3 verseydik tür
// eşlemesi şu an birim fonksiyon olurdu ve dağıtıcıyı `a - 1`'e çeviren bir
// kestirme HİÇBİR ŞEYİ bozmadan çalışırdı — yani soyutlama, sırayı
// değiştiren ilk düzenlemeye kadar yalnız kâğıt üstünde var olurdu.
// (Bozma denendi: dejenere hâlde davranışsal test kızarmıyordu.)
int _PB_RESUME3  = 10;
int _PB_RESTART3 = 11;
int _PB_SET3     = 12;
int _PB_QUIT3    = 13;
func _s3_pause_n3(): int { return 4; }
func _s3_pause_kind3(i): int {
    if (i <= 0) { return _PB_RESUME3; }
    if (i == 1) { return _PB_RESTART3; }
    if (i == 2) { return _PB_SET3; }
    return _PB_QUIT3;
}
// ÇIKIŞ her zaman SON düğme.
func _s3_pause_qi3(): int { return _s3_pause_n3() - 1; }

func _s3_pause_draw() {
    _s3_dim();
    _s3_center_text(_s3_t("Duraklatildi", "Paused"), _win_h * 0.18,
                    toInt(_win_h * 0.09), GOLD);
    int pi = 0;
    while (pi < _s3_pause_n3()) {
        int pk = _s3_pause_kind3(pi);
        if (pk == _PB_RESUME3)  { _s3_btn_draw(pi, _s3_t("Devam", "Resume")); }
        if (pk == _PB_RESTART3) { _s3_btn_draw(pi, _s3_t("Yeniden", "Restart")); }
        if (pk == _PB_SET3)     { _s3_btn_draw(pi, _s3_t("Ayarlar", "Settings")); }
        if (pk == _PB_QUIT3)    { _s3_btn_draw(pi, _s3_quit_lbl3()); }
        pi = pi + 1;
    }
}

// 1 = devam, 2 = yeniden, 3 = ayarlar, 4 = çık, 0 = bekle
func _s3_pause_step(): int {
    _s3_menu_nav(_s3_pause_n3());
    // ESC/P/B = "devam" kestirmesi: duraklattığın tuş seni geri çıkarmalı,
    // hangi düğme seçili olursa olsun.
    if (key_pressed(K_ESC) || key_pressed(K_P) || _gp_back == 1) { return 1; }
    if (key_pressed(K_R)) { return 2; }
    if (_s3_confirm3()) { return _s3_sel3 + 1; }
    int b = _s3_btn_pressed(_s3_pause_n3());
    if (b >= 0) { return b + 1; }
    return 0;
}

// ---- Ayarlar ---------------------------------------------------------------
// Tek satırlık bir ekran ve bilerek: motorun gerçekten SAHİP OLDUĞU tek ayar
// ses seviyesi. Dil sistem yerelinden geliyor (`_s3_lang`), FPS'i motor
// sürmüyor. Var olmayan ayarları listelemek, çalışmayan düğmeler demek olurdu.
func _s3_set_draw() {
    _s3_dim();
    _s3_center_text(_s3_t("AYARLAR", "SETTINGS"), _win_h * 0.18,
                    toInt(_win_h * 0.09), GOLD);
    int yuzde = toInt(_s3_vol3 * 100.0 + 0.5);
    _s3_center_text(_s3_t("Ses: ", "Volume: ") + toString(yuzde) + "%",
                    _win_h * 0.33, toInt(_win_h * 0.055), RAYWHITE);
    // Çubuk: sayı tek başına "ne kadar" sorusunu göstermiyor.
    float bw = _win_w * 0.44;
    float bx = (_win_w - bw) * 0.5;
    float by = _win_h * 0.40;
    float bh = _win_h * 0.03;
    rect(bx, by, bw, bh, rgba(46, 54, 82, 235));
    if (_s3_vol3 > 0.0) { rect(bx, by, bw * _s3_vol3, bh, GOLD); }
    rect_lines(bx, by, bw, bh, rgba(190, 160, 60, 200));
    _s3_btn_draw(0, _s3_t("Ses -", "Volume -"));
    _s3_btn_draw(1, _s3_t("Ses +", "Volume +"));
    _s3_btn_draw(2, _s3_t("Geri", "Back"));
}

// 1 = kıs, 2 = aç, 3 = geri, 0 = bekle
func _s3_set_step(): int {
    _s3_menu_nav(3);
    // Sol/sağ okları DOĞRUDAN seviyeyi sürüyor: bir kaydırıcıda beklenen bu,
    // ve seçili düğmeye gitmek için önce aşağı inmek zorunda kalmak angarya.
    if (key_pressed(K_LEFT))  { return 1; }
    if (key_pressed(K_RIGHT)) { return 2; }
    if (key_pressed(K_ESC) || _gp_back == 1) { return 3; }
    if (_s3_confirm3()) { return _s3_sel3 + 1; }
    int b = _s3_btn_pressed(3);
    if (b >= 0) { return b + 1; }
    return 0;
}

// ---- Oyun bitti / kazandın -------------------------------------------------
func _s3_over_draw() {
    _s3_dim();
    if (_won3 == 1) {
        _s3_center_text(_s3_t("KAZANDIN", "YOU WIN"), _win_h * 0.18,
                        toInt(_win_h * 0.10), rgb(120, 240, 140));
    } else {
        _s3_center_text(_s3_t("OYUN BITTI", "GAME OVER"), _win_h * 0.18,
                        toInt(_win_h * 0.10), rgb(255, 90, 90));
    }
    _s3_center_text(_s3_t("Skor: ", "Score: ") + toString(_score3),
                    _win_h * 0.32, toInt(_win_h * 0.05), GOLD);
    if (_sav_on == 1) {
        if (_new_rec3 == 1) {
            _s3_center_text(_s3_t("YENI REKOR!", "NEW RECORD!"), _win_h * 0.375,
                            toInt(_win_h * 0.045), rgb(255, 200, 80));
        } else {
            _s3_center_text(_s3_t("Rekor: ", "Best: ") + toString(_best3),
                            _win_h * 0.375, toInt(_win_h * 0.04), RAYWHITE);
        }
    }
    _s3_btn_draw(0, _s3_t("Tekrar Oyna", "Play Again"));
    _s3_btn_draw(1, _s3_quit_lbl3());
}

// 1 = tekrar, 2 = çık, 0 = bekle
func _s3_over_step(): int {
    _s3_menu_nav(2);
    if (key_pressed(K_R)) { return 1; }   // R hep "tekrar oyna" kestirmesi
    if (_s3_confirm3()) { return _s3_sel3 + 1; }
    if (key_pressed(K_ESC) || _gp_back == 1) { return 2; }
    int b = _s3_btn_pressed(2);
    if (b >= 0) { return b + 1; }
    return 0;
}

// ---- Düşman AI -------------------------------------------------------------
// Üçü de HER KARE çağrılmak üzere tasarlandı (update içinden), böylece hiçbiri
// entity'ye kalıcı durum yazmak zorunda kalmıyor — devriye yönü hariç.

// Hedefe doğru yürü (yatay). Y hızına dokunmaz: yerçekimi/zıplama onun.
// Engelden kaçınma: AÇIK gelir. Bu bir özellik değil KUSUR DÜZELTMESİ —
// düz çizgi kovalayan düşman duvara toslayıp orada titriyordu, ve bu bir 3B
// oyunda en çok göze batan şeydi. Eski davranışı isteyen `chase_direct3d()`
// diyebilir (ör. uçan/hayalet düşman, ya da duvarsız arena).
int _chase_avoid3 = 1;
func chase_avoid3d(on) { if (on) { _chase_avoid3 = 1; } else { _chase_avoid3 = 0; } }
func chase_direct3d() { _chase_avoid3 = 0; }
func takip_kacinma3d(on) { chase_avoid3d(on); }

float _CHASE_PROBE3 = 3.2;   // ileriye bakış mesafesi (dünya birimi)

// XZ düzleminde parça ↔ ŞİŞİRİLMİŞ kutu kesişimi (slab yöntemi).
//
// Şişirme (`pad`) hareket edenin yarıçapıdır ve LOAD-BEARING: ışın sıfır
// kalınlıktadır, gövde değil. Şişirmeden, merkezden geçen "açık" bir yol
// gövdenin duvar köşesine takılmasına yol açıyordu — ölçüldü, düşman köşede
// tam olarak donuyordu (konum 7 basamağa kadar sabit: fizik ilerletiyor,
// çarpışma birebir geri itiyordu). Engeli yarıçap kadar büyütmek klasik
// "konfigürasyon uzayı" numarası: nokta için açık olan yol gövde için de açık.
func _seg_box_xz3(ox, oz, rx, rz, w, pad): bool {
    Ent3 e = _e3[w];
    float hx = e.sx * 0.5 + pad;
    float hz = e.sz * 0.5 + pad;
    float tmin = 0.0;
    float tmax = 1.0;
    if (abs_f3(rx) < 0.000001) {
        if (ox < e.x - hx || ox > e.x + hx) { return false; }
    } else {
        float t1 = (e.x - hx - ox) / rx;
        float t2 = (e.x + hx - ox) / rx;
        if (t1 > t2) { float tmp = t1; t1 = t2; t2 = tmp; }
        if (t1 > tmin) { tmin = t1; }
        if (t2 < tmax) { tmax = t2; }
        if (tmin > tmax) { return false; }
    }
    if (abs_f3(rz) < 0.000001) {
        if (oz < e.z - hz || oz > e.z + hz) { return false; }
    } else {
        float t1 = (e.z - hz - oz) / rz;
        float t2 = (e.z + hz - oz) / rz;
        if (t1 > t2) { float tmp = t1; t1 = t2; t2 = tmp; }
        if (t1 > tmin) { tmin = t1; }
        if (t2 < tmax) { tmax = t2; }
        if (tmin > tmax) { return false; }
    }
    return true;
}

// (x,z)'den (dirx,dirz) yönünde `dist` kadar yatay yol duvarsız mı?
// `pad` hareket edenin yarıçapı (yukarıdaki nota bakın). Y aralığı örtüşmeyen
// duvarlar atlanıyor — üst geçit gibi yapılar yolu kapatmasın.
func _path_clear3(sx, sy, sz, dirx, dirz, dist, pad, syh): bool {
    float rx = dirx * dist;
    float rz = dirz * dist;
    int n = length(_e3);
    int i = 0;
    while (i < n) {
        Ent3 w = _e3[i];
        if (w.alive == 1 && w.tag == TAG_WALL && w.solid == 1) {
            float wh = w.sy * 0.5;
            // dikeyde hiç örtüşmüyorsa bu duvar yolu kapatmıyor
            if (abs_f3(w.y - sy) < wh + syh) {
                if (_seg_box_xz3(sx, sz, rx, rz, i, pad)) { return false; }
            }
        }
        i = i + 1;
    }
    return true;
}

// ===========================================================================
// YOL BULMA (A*) — kaçınmanın çözemediği şey
// ===========================================================================
// `chase3d`in kaçınması TEK engeli çözüyor: duvara değince bir yana bağlanıp
// kayıyor. Labirenti çözmüyor — çıkmaz bir koridora giren düşman orada
// kalıyor, çünkü yerel bir karar küresel bir yolu bulamaz.
//
// Izgara + A*. Saf Tulpar; C tarafına dokunmuyor.
//
// Neden ayrı bir fonksiyon (`chase_path3d`) ve `chase3d` değiştirilmedi:
// A* her çağrıda ızgara taraması demek ve çoğu oyunun buna ihtiyacı yok
// (arenada düz kovalama yeterli, üstelik daha "aç gözlü" ve doğal duruyor).
// Varsayılanı değiştirmek yayınlanmış oyunların düşman davranışını haber
// vermeden değiştirirdi.

int   _nav_w3 = 0;          // ızgara genişliği (hücre)
int   _nav_h3 = 0;
float _nav_cell3 = 2.0;     // hücre kenarı (dünya birimi)
float _nav_x03 = 0.0;       // ızgaranın sol-üst dünya köşesi
float _nav_z03 = 0.0;
array _nav_block3 = [];     // 1 = kapalı
int   _NAV_MAX3 = 4096;     // hücre tavanı (64x64) — üstünde ızgara kurulmaz

// Yol önbelleği, slot'a göre. Her karede A* koşturmak pahalı; düşman başına
// bir ARA HEDEF tutup birkaç karede bir yeniliyoruz. Oyunlarda standart
// çözüm bu ve görsel farkı yok, çünkü ara hedef zaten birkaç hücre ötede.
array _nav_wx3 = [];        // ara hedef x
array _nav_wz3 = [];
array _nav_t3 = [];         // kalan geçerlilik (sn)
float _nav_repath3 = 0.4;   // yeniden hesap aralığı (sn)

func nav_repath3d(sn) { _nav_repath3 = sn; }
func yol_yenileme3d(sn) { nav_repath3d(sn); }

func _nav_idx3(cx, cz): int { return cz * _nav_w3 + cx; }

func _nav_walls3(): int {
    int c = 0;
    int n = length(_e3);
    int i = 0;
    while (i < n) {
        Ent3 w = _e3[i];
        if (w.alive == 1 && w.tag == TAG_WALL && w.solid == 1) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

func _nav_slots3(n) {
    while (length(_nav_wx3) < n) {
        push(_nav_wx3, 0.0); push(_nav_wz3, 0.0); push(_nav_t3, 0.0);
    }
}

// Izgarayı duvarlardan kur. `pad` ajanın yarıçapı: hücre bu kadar
// ŞİŞİRİLMİŞ duvarla kesişiyorsa kapalı sayılıyor — yoksa yol duvara
// sürtüyor ve gövde sıkışıyor.
func nav_build3d(cell, pad) {
    _nav_cell3 = cell;
    if (_nav_cell3 < 0.25) { _nav_cell3 = 0.25; }
    // Sınırlar CANLI HER VARLIKTAN türüyor: dünya sınırsız, ızgara olamaz.
    //
    // Yalnız duvarlara bakmak sessiz bir hataydı ve ilk yazımda tam bu oldu:
    // düşman da hedef de duvarların DIŞINDA duruyordu, başlangıç/hedef
    // hücresi ızgara dışına düşüyordu ve A* hiç yol aramadan false diyordu.
    // Belirti "yol bulunamadı" değil, "düşman kımıldamıyor"du.
    float minx = 0.0; float maxx = 0.0;
    float minz = 0.0; float maxz = 0.0;
    int any = 0;
    int n = length(_e3);
    int i = 0;
    while (i < n) {
        Ent3 w = _e3[i];
        if (w.alive == 1) {
            float hx = w.sx * 0.5; float hz = w.sz * 0.5;
            if (any == 0) {
                minx = w.x - hx; maxx = w.x + hx;
                minz = w.z - hz; maxz = w.z + hz;
                any = 1;
            } else {
                if (w.x - hx < minx) { minx = w.x - hx; }
                if (w.x + hx > maxx) { maxx = w.x + hx; }
                if (w.z - hz < minz) { minz = w.z - hz; }
                if (w.z + hz > maxz) { maxz = w.z + hz; }
            }
        }
        i = i + 1;
    }
    if (any == 0) { _nav_w3 = 0; _nav_h3 = 0; _nav_block3 = []; return; }
    // Duvarsız sahnede ızgara kurmanın anlamı yok: her hücre açık olurdu ve
    // A* düz çizgiyi bulurdu — `chase3d` bunu zaten bedavaya yapıyor.
    if (_nav_walls3() == 0) { _nav_w3 = 0; _nav_h3 = 0; _nav_block3 = []; return; }
    // Kenar payı PAD'İ DE hesaba katmalı. Bir hücrelik sabit pay yetmiyordu:
    // duvar `pad` kadar şişirildiği için şişmiş hâli ızgaranın kenarına
    // dayanıyor ve dışından dolaşacak açık hücre KALMIYORDU. Belirti sinsiydi
    // — A* "yol yok" diyor, oyunda düşman kımıldamıyor, hiçbir hata çıkmıyor.
    // İki hücre + pad: şişmiş duvarın dışında her zaman en az bir tam açık
    // hücre kalıyor.
    float marg = pad + _nav_cell3 * 2.0;
    minx = minx - marg; maxx = maxx + marg;
    minz = minz - marg; maxz = maxz + marg;
    _nav_x03 = minx; _nav_z03 = minz;
    _nav_w3 = toInt((maxx - minx) / _nav_cell3) + 1;
    _nav_h3 = toInt((maxz - minz) / _nav_cell3) + 1;
    if (_nav_w3 < 1) { _nav_w3 = 1; }
    if (_nav_h3 < 1) { _nav_h3 = 1; }
    if (_nav_w3 * _nav_h3 > _NAV_MAX3) {
        // Tavanı aşan sahne: ızgara kurulmuyor ve `chase_path3d` düz
        // kovalamaya düşüyor. Sessizce yanlış bir yol üretmektense
        // bilinen davranışa dönmek doğru.
        uyari3d("nav: ızgara çok büyük (" + toString(_nav_w3) + "x" +
                toString(_nav_h3) + ") — hücreyi büyüt");
        _nav_w3 = 0; _nav_h3 = 0; _nav_block3 = [];
        return;
    }
    _nav_block3 = [];
    int cells = _nav_w3 * _nav_h3;
    int k = 0;
    while (k < cells) { push(_nav_block3, 0); k = k + 1; }

    // Her duvarı ızgaraya bas. Hücre merkezi yerine hücre KUTUSU ile
    // kesişim: merkez testi ince duvarları tamamen kaçırırdı.
    i = 0;
    while (i < n) {
        Ent3 w = _e3[i];
        if (w.alive == 1 && w.tag == TAG_WALL && w.solid == 1) {
            float hx = w.sx * 0.5 + pad;
            float hz = w.sz * 0.5 + pad;
            int c0 = toInt((w.x - hx - _nav_x03) / _nav_cell3);
            int c1 = toInt((w.x + hx - _nav_x03) / _nav_cell3);
            int r0 = toInt((w.z - hz - _nav_z03) / _nav_cell3);
            int r1 = toInt((w.z + hz - _nav_z03) / _nav_cell3);
            if (c0 < 0) { c0 = 0; }
            if (r0 < 0) { r0 = 0; }
            if (c1 > _nav_w3 - 1) { c1 = _nav_w3 - 1; }
            if (r1 > _nav_h3 - 1) { r1 = _nav_h3 - 1; }
            int r = r0;
            while (r <= r1) {
                int c = c0;
                while (c <= c1) {
                    _nav_block3[_nav_idx3(c, r)] = 1;
                    c = c + 1;
                }
                r = r + 1;
            }
        }
        i = i + 1;
    }
}
func yol_izgarasi3d(hucre, pay) { nav_build3d(hucre, pay); }

func nav_ready3d(): bool { return _nav_w3 > 0 && _nav_h3 > 0; }
func yol_hazir3d(): bool { return nav_ready3d(); }
func yol_kapali3d(x, z): bool { return nav_blocked3d(x, z); }
func nav_blocked3d(x, z): bool {
    if (!nav_ready3d()) { return false; }
    int cx = toInt((x - _nav_x03) / _nav_cell3);
    int cz = toInt((z - _nav_z03) / _nav_cell3);
    if (cx < 0 || cz < 0 || cx >= _nav_w3 || cz >= _nav_h3) { return false; }
    return _nav_block3[_nav_idx3(cx, cz)] == 1;
}

// A*: başlangıç hücresinden hedef hücreye. Bulunan yolun İKİNCİ hücresinin
// dünya konumu `_nav_ox3/_nav_oz3`e yazılır (ilk hücre zaten üstünde
// durduğumuz yer). Bulunamazsa false.
float _nav_ox3 = 0.0;
float _nav_oz3 = 0.0;

func _nav_astar3(sx, sz, tx, tz): bool {
    if (!nav_ready3d()) { return false; }
    int scx = toInt((sx - _nav_x03) / _nav_cell3);
    int scz = toInt((sz - _nav_z03) / _nav_cell3);
    int tcx = toInt((tx - _nav_x03) / _nav_cell3);
    int tcz = toInt((tz - _nav_z03) / _nav_cell3);
    // KIRPMA: ızgara canlı varlıklardan kuruluyor ama biri arada dışarı
    // çıkabilir (ışınlanma, dünya sınırı). Hemen vazgeçmek yerine en yakın
    // kenar hücresinden yol aramak doğru — "oraya kadar götür" demek.
    if (scx < 0) { scx = 0; }
    if (scz < 0) { scz = 0; }
    if (scx >= _nav_w3) { scx = _nav_w3 - 1; }
    if (scz >= _nav_h3) { scz = _nav_h3 - 1; }
    if (tcx < 0) { tcx = 0; }
    if (tcz < 0) { tcz = 0; }
    if (tcx >= _nav_w3) { tcx = _nav_w3 - 1; }
    if (tcz >= _nav_h3) { tcz = _nav_h3 - 1; }
    int start = _nav_idx3(scx, scz);
    int goal = _nav_idx3(tcx, tcz);
    if (start == goal) { return false; }
    // Hedef hücresi kapalıysa (duvara yaslanmış oyuncu) yine de deniyoruz:
    // kapalı hücreye komşu açık bir hücrede durmak yeterince iyi.
    int cells = _nav_w3 * _nav_h3;

    array g = [];      // start'tan maliyet; -1 = ziyaret edilmedi
    array f = [];      // g + sezgisel
    array came = [];   // nereden gelindi
    array open = [];   // 1 = açık listede
    int i = 0;
    while (i < cells) { push(g, 0 - 1); push(f, 0.0); push(came, 0 - 1); push(open, 0); i = i + 1; }
    g[start] = 0.0;
    f[start] = _nav_hh3(scx, scz, tcx, tcz);
    open[start] = 1;
    int open_n = 1;

    int guard = 0;
    int found = 0;
    while (open_n > 0 && found == 0 && guard < cells * 2) {
        guard = guard + 1;
        // En küçük f'li açık hücreyi bul. Öbek yok: ızgara tavanı 4096 ve
        // yol birkaç karede bir hesaplanıyor, doğrusal tarama yeterli.
        int cur = 0 - 1;
        float best = 0.0;
        i = 0;
        while (i < cells) {
            if (open[i] == 1) {
                if (cur < 0 || f[i] < best) { cur = i; best = f[i]; }
            }
            i = i + 1;
        }
        if (cur < 0) { open_n = 0; }
        else {
            if (cur == goal) { found = 1; }
            else {
                open[cur] = 0; open_n = open_n - 1;
                int ccx = mod(cur, _nav_w3);
                int ccz = toInt((cur - ccx) / _nav_w3);
                int d = 0;
                while (d < 8) {
                    int ddx = _nav_dx3(d);
                    int ddz = _nav_dz3(d);
                    int nx = ccx + ddx;
                    int nz = ccz + ddz;
                    if (nx >= 0 && nz >= 0 && nx < _nav_w3 && nz < _nav_h3) {
                        int ni = _nav_idx3(nx, nz);
                        if (_nav_block3[ni] == 0) {
                            // KÖŞE KESME yasak: çaprazda iki ortogonal
                            // komşudan biri kapalıysa geçilmiyor, yoksa yol
                            // duvarın köşesinden geçermiş gibi görünürdü.
                            bool ok = true;
                            if (ddx != 0 && ddz != 0) {
                                if (_nav_block3[_nav_idx3(ccx + ddx, ccz)] == 1) { ok = false; }
                                if (_nav_block3[_nav_idx3(ccx, ccz + ddz)] == 1) { ok = false; }
                            }
                            if (ok) {
                                float step = 1.0;
                                if (ddx != 0 && ddz != 0) { step = 1.41421356; }
                                float ng = g[cur] + step;
                                if (g[ni] < 0.0 || ng < g[ni]) {
                                    g[ni] = ng;
                                    f[ni] = ng + _nav_hh3(nx, nz, tcx, tcz);
                                    came[ni] = cur;
                                    if (open[ni] == 0) { open[ni] = 1; open_n = open_n + 1; }
                                }
                            }
                        }
                    }
                    d = d + 1;
                }
            }
        }
    }
    if (found == 0) { return false; }

    // Yolu geri sar, START'tan sonraki İLK hücreyi bul.
    int node = goal;
    int prev = came[node];
    while (prev >= 0 && prev != start) {
        node = prev;
        prev = came[node];
    }
    if (prev != start) { return false; }
    int ox = mod(node, _nav_w3);
    int oz = toInt((node - ox) / _nav_w3);
    _nav_ox3 = _nav_x03 + (ox + 0.5) * _nav_cell3;
    _nav_oz3 = _nav_z03 + (oz + 0.5) * _nav_cell3;
    return true;
}

// Sezgisel: sekiz yönlü ızgarada oktil mesafe. Manhattan burada AŞIRI
// tahmin eder (çapraz adım 1.41 iken 2 sayar) ve A*'ı en kısa yoldan
// saptırır; oktil kabul edilebilir sınırda kalıyor.
func _nav_hh3(ax, az, bx, bz): float {
    float dx = abs_f3((ax - bx) * 1.0);
    float dz = abs_f3((az - bz) * 1.0);
    float lo = dx;
    float hi = dz;
    if (dz < dx) { lo = dz; hi = dx; }
    return (hi - lo) + lo * 1.41421356;
}

func _nav_dx3(d): int {
    if (d == 0) { return 1; }
    if (d == 1) { return 0 - 1; }
    if (d == 2) { return 0; }
    if (d == 3) { return 0; }
    if (d == 4) { return 1; }
    if (d == 5) { return 1; }
    if (d == 6) { return 0 - 1; }
    return 0 - 1;
}
func _nav_dz3(d): int {
    if (d == 0) { return 0; }
    if (d == 1) { return 0; }
    if (d == 2) { return 1; }
    if (d == 3) { return 0 - 1; }
    if (d == 4) { return 1; }
    if (d == 5) { return 0 - 1; }
    if (d == 6) { return 1; }
    return 0 - 1;
}

// A* ile kovala. Izgara kurulu değilse ya da yol bulunamazsa `chase3d`e
// düşer — bilinen davranış, sessiz bir durma değil.
func chase_path3d(id, target, speed) {
    int s = _slot_of3(id);
    int t = _slot_of3(target);
    if (s < 0 || t < 0) { return; }
    if (!nav_ready3d()) { chase3d(id, target, speed); return; }
    _nav_slots3(length(_e3));

    Ent3 e = _e3[s];
    Ent3 tg = _e3[t];

    _nav_t3[s] = _nav_t3[s] - frame_time();
    if (_nav_t3[s] <= 0.0) {
        _nav_t3[s] = _nav_repath3;
        if (_nav_astar3(e.x, e.z, tg.x, tg.z)) {
            _nav_wx3[s] = _nav_ox3;
            _nav_wz3[s] = _nav_oz3;
        } else {
            _nav_wx3[s] = tg.x;      // yol yok → doğrudan hedefe
            _nav_wz3[s] = tg.z;
        }
    }

    float dx = _nav_wx3[s] - e.x;
    float dz = _nav_wz3[s] - e.z;
    float d = sqrt(dx * dx + dz * dz);
    // Ara hedefe vardıysak bir sonrakini hemen iste.
    if (d < _nav_cell3 * 0.4) { _nav_t3[s] = 0.0; }
    if (d <= 0.001) { e.vx = 0.0; e.vz = 0.0; _e3[s] = e; return; }
    e.vx = (dx / d) * speed;
    e.vz = (dz / d) * speed;
    e.yaw = atan2(e.vx, e.vz) * RAD2DEG3;
    _e3[s] = e;
}
func yol_takip3d(i, hedef, hiz) { chase_path3d(i, hedef, hiz); }

// Hedefe doğru yürü; önü kapalıysa AÇIK olan en yakın yöne sap.
//
// Navmesh/A* değil, bilerek: bu bir preset motor, sahne tamamen dinamik ve
// duvarlar da entity. Yön taraması durum tutmuyor, her karede sıfırdan karar
// veriyor — yani duvar hareket etse, yıkılsa ya da yeni duvar doğsa hiçbir
// veri yapısını tazelemek gerekmiyor. Bedeli: tek başına bir U biçimli tuzaktan
// çıkamaz (yerel minimum). Arena/koridor düzenlerinde istenen davranışı veriyor,
// gerçek labirent isteyen oyun kendi yolunu `set3vel` ile sürebilir.
func chase3d(id, target, speed) {
    int s = _slot_of3(id);
    int t = _slot_of3(target);
    if (s < 0 || t < 0) { return; }
    Ent3 e = _e3[s];
    Ent3 tg = _e3[t];
    float dx = tg.x - e.x;
    float dz = tg.z - e.z;
    float d = sqrt(dx * dx + dz * dz);
    if (d <= 0.001) {
        e.vx = 0.0; e.vz = 0.0;
        _e3[s] = e;
        return;
    }
    float ux = dx / d;
    float uz = dz / d;

    if (_chase_avoid3 == 1) {
        // Yalnız hedefe olan mesafeye kadar bak: hedef yakınsa duvarın
        // ARKASINDAKİ bir engel yüzünden gereksiz sapmayalım.
        float probe = _CHASE_PROBE3;
        if (d < probe) { probe = d; }
        float pad = e.sx * 0.5;
        if (e.sz * 0.5 > pad) { pad = e.sz * 0.5; }
        float syh = e.sy * 0.5;
        if (_path_clear3(e.x, e.y, e.z, ux, uz, probe, pad, syh)) {
            e.avoid = 0;      // yol açıldı, bağlılık biter
        } else {
            // TARAFA BAĞLAN. Engel görünce bir kez taraf seçilir ve yol
            // açılana kadar o tarafta kalınır. Bağlanmadan, simetrik bir
            // duvarın önünde "en yakın açık yön" her karede taraf değiştiriyor
            // ve düşman ilerlemeden titriyordu.
            int side = e.avoid;
            if (side == 0) {
                // İlk karar: iki yanı simetrik tara, hedefe en yakın açık yönü
                // seç. Simetri önemli — hep aynı yana bakmak düşmanları duvar
                // boyunca tek sıraya dizerdi.
                float a0 = 25.0;
                while (a0 <= 105.0 && side == 0) {
                    float r0 = a0 * DEG2RAD3;
                    float c0 = cos(r0); float s0 = sin(r0);
                    if (_path_clear3(e.x, e.y, e.z,
                                     ux * c0 - uz * s0, ux * s0 + uz * c0, probe, pad, syh)) {
                        side = 1;
                    } else if (_path_clear3(e.x, e.y, e.z,
                                            ux * c0 + uz * s0, 0.0 - ux * s0 + uz * c0, probe, pad, syh)) {
                        side = 0 - 1;
                    }
                    a0 = a0 + 20.0;
                }
                if (side == 0) { side = 1; }   // hiçbiri açık değil → yine de bir yön tut
            }
            // Seçili tarafta hedefe EN YAKIN açık açıyı bul.
            float ang = 25.0;
            int found = 0;
            while (ang <= 135.0 && found == 0) {
                float ra = ang * DEG2RAD3;
                float c = cos(ra);
                float sn = sin(ra) * side;      // side = -1 → ayna
                float nx2 = ux * c - uz * sn;
                float nz2 = ux * sn + uz * c;
                if (_path_clear3(e.x, e.y, e.z, nx2, nz2, probe, pad, syh)) {
                    ux = nx2; uz = nz2; found = 1;
                }
                ang = ang + 20.0;
            }
            if (found == 0) {
                // Seçili taraf tamamen kapandı (köşeye sıkıştı) → tarafı çevir;
                // sonraki kare öbür yanı dener. Böylece kalıcı kilit olmaz.
                side = 0 - side;
            }
            e.avoid = side;
        }
    } else {
        e.avoid = 0;
    }

    e.vx = ux * speed;
    e.vz = uz * speed;
    e.yaw = atan2(ux, uz) * RAD2DEG3;
    _e3[s] = e;
}

// İki nokta arasında gidip gel. Uca varınca yön döner (pdir entity'de saklı).
func patrol3d(id, x1, z1, x2, z2, speed) {
    int s = _slot_of3(id);
    if (s < 0) { return; }
    Ent3 e = _e3[s];
    float tx = x2;
    float tz = z2;
    if (e.pdir == 1) { tx = x1; tz = z1; }
    float dx = tx - e.x;
    float dz = tz - e.z;
    float d = sqrt(dx * dx + dz * dz);
    if (d < 0.35) {
        if (e.pdir == 1) { e.pdir = 0; } else { e.pdir = 1; }
        e.vx = 0.0; e.vz = 0.0;
    } else {
        e.vx = dx / d * speed;
        e.vz = dz / d * speed;
        e.yaw = atan2(dx, dz) * RAD2DEG3;
    }
    _e3[s] = e;
}

// İki entity r yarıçapı içinde mi (küresel mesafe). Görüş/atış menzili için.
func in_range3d(a, b, r): bool {
    int sa = _slot_of3(a);
    int sb = _slot_of3(b);
    if (sa < 0 || sb < 0) { return false; }
    Ent3 ea = _e3[sa];
    Ent3 eb = _e3[sb];
    float dx = ea.x - eb.x;
    float dy = ea.y - eb.y;
    float dz = ea.z - eb.z;
    return sqrt(dx * dx + dy * dy + dz * dz) <= r;
}

// ---- Mermi -----------------------------------------------------------------
// Sahibin BAKTIĞI yöne (yaw) çıkar, gövdesinin hemen önünde doğar. Yerçekimi
// ve zemin teması mermilere uygulanmaz (bkz. _s3_physics) — düz uçar.
// Ömrü dolan ya da dünya sınırını aşan mermi kendiliğinden ölür; bu olmadan
// ıskalayan her mermi sonsuza kadar entity store'da kalırdı.
// ===========================================================================
// Nişan mekanikleri
// ===========================================================================
// Her oyunun ateş etme hissi farklı: üçüncü şahıs aksiyonda kameranın YATAY
// yönü doğrudur (yere bakmak "yere ateş et" demek değil), nişancı oyunda tam
// bakış yönü gerekir, twin-stick'te gövdenin baktığı yön, boss dövüşünde
// kilitlenme. Motor bunları seçenek olarak veriyor; oyun tek satırla seçiyor.
//
// ⚠️ İKİ AYRI YAW SÖZLEŞMESİ VAR — karıştırmak sessiz 180° hataya yol açar:
//     GÖVDE yönü : (sin(yaw),  cos(yaw))   ← move3d'nin atan2(wx, wz)'si
//     KAMERA ileri: (sin(yaw), -cos(yaw))  ← _s3_camera'daki fx/fz
// Bir kez karıştırıldı ve mermiler tam ters yöne gitti. O yüzden burada açı
// değil, doğrudan YÖN VEKTÖRÜ kuruluyor.
int AIM_FLAT = 0;   // kameranın YATAY yönü — üçüncü şahıs aksiyon (varsayılan)
int AIM_LOOK = 1;   // kameranın TAM yönü, eğim dahil — nişancı / FPS
int AIM_BODY = 2;   // gövdenin baktığı yön — kameradan bağımsız, twin-stick
int AIM_LOCK = 3;   // en yakın hedefe kilitlen; menzilde yoksa AIM_FLAT

float _aim_x3 = 0.0; float _aim_y3 = 0.0; float _aim_z3 = 1.0;
int   _aim_mode3     = 0;
int   _aim_lock_tag3 = 4;      // TAG_ENEMY
float _aim_lock_rng3 = 25.0;
float _aim_spread3   = 0.0;    // konik sapma (derece); 0 = tam isabet

func aim_mode3d(m) { _aim_mode3 = m; }
func nisan_modu3d(m) { aim_mode3d(m); }
// Kilitlenme hedefi ve menzili. Çağırmak modu da AIM_LOCK yapar.
func aim_lock3d(tag, range) {
    _aim_lock_tag3 = tag; _aim_lock_rng3 = range; _aim_mode3 = AIM_LOCK;
}
func nisan_kilit3d(etiket, menzil) { aim_lock3d(etiket, menzil); }
// Saçılma: her mermi bu kadar derecelik koni içinde rastgele sapar.
// Pompalı, otomatik silah geri tepmesi, "acemi nişancı" hissi.
func aim_spread3d(deg) { _aim_spread3 = deg; }
func nisan_sacilma3d(derece) { aim_spread3d(derece); }
// Eski kısayol: dikey nişan = AIM_LOOK, kapalı = AIM_FLAT.
func aim_pitch3d(on) { if (on) { _aim_mode3 = AIM_LOOK; } else { _aim_mode3 = AIM_FLAT; } }
func dikey_nisan3d(ac) { aim_pitch3d(ac); }

// Menzildeki en yakın hedefi bul (kilitlenme). Yoksa -1.
func _aim_nearest3(owner): int {
    int os = _slot_of3(owner);
    if (os < 0) { return 0 - 1; }
    Ent3 o = _e3[os];
    int best = 0 - 1;
    float bd = _aim_lock_rng3 * _aim_lock_rng3;
    int i = 0;
    int n = length(_e3);
    while (i < n) {
        Ent3 e = _e3[i];
        if (e.alive == 1 && e.tag == _aim_lock_tag3 && i != os) {
            float dx = e.x - o.x; float dy = e.y - o.y; float dz = e.z - o.z;
            float d2 = dx * dx + dy * dy + dz * dz;
            if (d2 < bd) { bd = d2; best = i; }
        }
        i = i + 1;
    }
    return best;
}

func _aim_dir3(owner) {
    int s = _slot_of3(owner);
    float fx = 0.0; float fy = 0.0; float fz = 1.0;
    int vertical = 0;              // bu modda dikey bileşen anlamlı mı
    if (s >= 0) {
        Ent3 o = _e3[s];
        float br = o.yaw * DEG2RAD3;
        fx = sin(br); fz = cos(br);          // GÖVDE sözleşmesi
    }
    int use_cam = 0;
    if (owner == _cam_target && _cam_mode3 != CAM_FIXED) { use_cam = 1; }

    if (_aim_mode3 == AIM_BODY || use_cam == 0) {
        // gövde yönü — yukarıda kuruldu
    } else {
        if (_aim_mode3 == AIM_LOCK) {
            int t = _aim_nearest3(owner);
            if (t >= 0 && s >= 0) {
                Ent3 o2 = _e3[s];
                Ent3 tt = _e3[t];
                float dx = tt.x - o2.x; float dy = tt.y - o2.y; float dz = tt.z - o2.z;
                float d = sqrt(dx * dx + dy * dy + dz * dz);
                if (d > 0.001) {
                    fx = dx / d; fy = dy / d; fz = dz / d;
                    vertical = 1;   // kilitlenme hedefin YÜKSEKLİĞİNİ de tutar
                }
            } else {
                float cr = _cam_yaw3 * DEG2RAD3;
                fx = sin(cr); fz = 0.0 - cos(cr);   // menzilde yok → yatay
                fy = 0.0;
            }
        } else {
            float cr = _cam_yaw3 * DEG2RAD3;
            fx = sin(cr); fz = 0.0 - cos(cr);       // KAMERA sözleşmesi
            fy = 0.0;
            if (_aim_mode3 == AIM_LOOK) {
                float pr = _cam_pitch3 * DEG2RAD3;
                float ch = cos(pr);
                fx = fx * ch; fz = fz * ch; fy = sin(pr);
                vertical = 1;
            }
        }
    }

    // Saçılma. Yatay sapma her modda; DİKEY sapma yalnız dikeyin anlamlı
    // olduğu modlarda — yatay nişanlı bir oyunda pompalı mermilerinin yere
    // saçılması istenen şey değil.
    if (_aim_spread3 > 0.0) {
        float sy = (random() - 0.5) * 2.0 * _aim_spread3 * DEG2RAD3;
        float c = cos(sy); float sn = sin(sy);
        float nx = fx * c + fz * sn;
        float nz = 0.0 - fx * sn + fz * c;
        fx = nx; fz = nz;
        if (vertical == 1) {
            float sp = (random() - 0.5) * 2.0 * _aim_spread3 * DEG2RAD3;
            float h = sqrt(fx * fx + fz * fz);
            float k = cos(sp);
            fy = fy * k + h * sin(sp);
            fx = fx * k; fz = fz * k;
        }
    }

    float len = sqrt(fx * fx + fy * fy + fz * fz);
    if (len < 0.000001) { fx = 0.0; fy = 0.0; fz = 1.0; len = 1.0; }
    _aim_x3 = fx / len;
    _aim_y3 = fy / len;
    _aim_z3 = fz / len;
}

// Nişan yönü bileşenleri — kendi silahını yazan oyun için.
func aim_x3d(id): float { _aim_dir3(id); return _aim_x3; }
func aim_y3d(id): float { _aim_dir3(id); return _aim_y3; }
func aim_z3d(id): float { _aim_dir3(id); return _aim_z3; }
func nisan_x3d(id): float { return aim_x3d(id); }
func nisan_y3d(id): float { return aim_y3d(id); }
func nisan_z3d(id): float { return aim_z3d(id); }

func bullet3d(owner, speed, life): int {
    int s = _slot_of3(owner);
    if (s < 0) { return 0 - 1; }
    Ent3 o = _e3[s];
    _aim_dir3(owner);
    float fx = _aim_x3;
    float fy = _aim_y3;
    float fz = _aim_z3;
    // gövdenin önüne çıkar: yarı-boy + merminin yarıçapı kadar
    float off = o.sx * 0.5 + 0.45;
    int id = spawn3(o.x + fx * off, o.y + fy * off, o.z + fz * off,
                    0.4, 0.4, 0.4, rgb(255, 220, 90), SHAPE_SPHERE, TAG_BULLET);
    int bs = _slot_of3(id);
    Ent3 b = _e3[bs];
    b.vx = fx * speed;
    b.vy = fy * speed;      // mermi yerçekimi almıyor, dikey nişan düz uçar
    b.vz = fz * speed;
    b.yaw = atan2(fx, fz) * RAD2DEG3;
    b.life = life;
    b.owner = owner;
    _e3[bs] = b;
    return id;
}

// Merminin dünya sınırını aştı mı (yatay yarıçap).
func _out_of_world3(Ent3 e): bool {
    return sqrt(e.x * e.x + e.z * e.z) > _world_r3;
}

// Pompalı: tek tetikte n mermi. Her mermi `_aim_dir3`'ü yeniden çağırdığı için
// saçılma her birine ayrı uygulanır — `nisan_sacilma3d()` ile koni açılmalı,
// yoksa n mermi üst üste gider.
func shotgun3d(owner, speed, life, n): int {
    int last = 0 - 1;
    int i = 0;
    while (i < n) { last = bullet3d(owner, speed, life); i = i + 1; }
    return last;
}
func pompali3d(sahip, hiz, omur, n): int { return shotgun3d(sahip, hiz, omur, n); }

// ---- Can / hasar -----------------------------------------------------------
func health3d(id, n) {
    int s = _slot_of3(id);
    if (s < 0) { return; }
    Ent3 e = _e3[s];
    e.hp = n;
    e.hpmax = n;
    _e3[s] = e;
}
func hp3d(id): int {
    int s = _slot_of3(id);
    if (s < 0) { return 0; }
    Ent3 e = _e3[s];
    return e.hp;
}

// Ölünce çağrılacak kanca: kanca içinde me3d() ÖLEN entity'nin handle'ı.
func on_death3d(tag, fn) { push(_deadT, tag); push(_deadF, fn); }

// Dokunulmazlık süresini ayarla (sn). 0 = kapalı.
func invuln3d(sec) { _invuln3 = sec; }

// Hasar ver. Dokunulmazlık penceresi açıkken YOK SAYILIR — yoksa temas eden
// düşman 60 FPS'te saniyede 60 hasar vururdu.
func damage3d(id, n) {
    int s = _slot_of3(id);
    if (s < 0) { return; }
    Ent3 e = _e3[s];
    if (e.alive == 0) { return; }
    if (e.invuln > 0.0) { return; }
    e.hp = e.hp - n;
    e.invuln = _invuln3;
    _e3[s] = e;
    if (e.hp <= 0) { _fire_death3(s); }
}

// Can ver. İki şeye BİLEREK dokunmuyor:
//   - hpmax'ı aşmıyor (şifa alanında beklemek canı sonsuza büyütmemeli),
//   - dokunulmazlık penceresine yazmıyor. `damage3d(id, -n)` ile şifa vermek
//     mümkün görünüyor ama yanlış: o yol invuln'ü kuruyor, yani şifa alanında
//     duran oyuncu bir de hasara bağışık olurdu. Şifa "vurulmadın" demek değil.
// Can sistemi kurulmamış entity (hpmax == 0) yok sayılır.
func heal3d(id, n) {
    int s = _slot_of3(id);
    if (s < 0) { return; }
    Ent3 e = _e3[s];
    if (e.alive == 0) { return; }
    if (e.hpmax <= 0) { return; }
    e.hp = e.hp + n;
    if (e.hp > e.hpmax) { e.hp = e.hpmax; }
    _e3[s] = e;
}

// Ölüm kancalarını çalıştır, sonra entity'yi öldür. Kanca kendisi kill3d
// çağırırsa sorun değil — kill3d çift-öldürmeye karşı korumalı.
func _fire_death3(s) {
    Ent3 e = _e3[s];
    int id = _mk_handle3(s);
    int h = 0;
    int hn = length(_deadT);
    while (h < hn) {
        if (_deadT[h] == e.tag) {
            _hit_me = id;
            _hit_other = 0 - 1;
            call(_deadF[h]);
        }
        h = h + 1;
    }
    kill3d(id);
}

// ---- Parçacıklar (Faz 8) ---------------------------------------------------
// Parçacıklar entity DEĞİL: oyun onlara asla tek tek başvurmaz, yalnız "şurada
// patlama olsun" der. Bu yüzden handle/generation makinesine gerek yok —
// paralel dizili basit bir havuz, ölü slot'ları lineer taramayla geri kullanır
// (arcade'in 2B parçacık havuzuyla aynı tasarım).
//
// Çizim BILLBOARD ile: kameraya dönük dörtgen. Küre/kutu ile çizilseydi yandan
// bakınca incelir ve "duman/kıvılcım" hissi kaybolurdu.
array _pt3x = [];    array _pt3y = [];    array _pt3z = [];
array _pt3vx = [];   array _pt3vy = [];   array _pt3vz = [];
array _pt3life = []; // kalan ömür (sn); <= 0 → slot ölü
array _pt3max = [];  // başlangıç ömrü (küçülme/sönme oranı için)
array _pt3col = [];
array _pt3size = [];
array _pt3rot = [];  // o anki açı (derece)
array _pt3spin = []; // açısal hız (derece/sn); işaret rastgele
float _pt3_grav = 9.0;   // parçacık yerçekimi (sahnenin _grav'ından bağımsız)
int   _PT3_CAP = 400;    // havuz tavanı — üstünde yeni parçacık sessizce düşer

// ---- Dönme ve doku atlası ---------------------------------------------------
// Parçacıklar tek boy DÜZ bir dörtgendi: yirmi tanesi de birbirinin aynısı
// duruyordu, çünkü hepsi aynı anda aynı şekilde sönüyordu. Bir toz/duman
// bulutunun canlı görünmesi, tek tek parçacıkların FARKLI dönmesinden geliyor.
//
// Dönme varsayılan olarak KAPALI. Dokusuz parçacık dolu bir KAREDİR ve dolu
// bir kare dönünce siluet de döner (kare↔baklava) — yani "görünmez" değil,
// gayet görünür. Varsayılanı açmak, yayınlanmış her oyunun parçacıklarını
// haber vermeden değiştirirdi. Dokulu parçacıkta ise dönme asıl kazanç:
// `parcacik_donme3d(180.0)` ile açılır.
float _pt3_spin_max = 0.0;     // derece/sn tavanı; 0 = dönme yok

// Doku atlası: parçacık ömrü boyunca kareler ilerler (flipbook). Duman ve
// patlama sprite sayfalarının kullanım biçimi budur — atlas olmadan aynı
// resim yalnız küçülür, DEĞİŞMEZ.
int _pt3_tex = 0 - 1;
int _pt3_frames = 1;

// Parçacıkların dokusu. cols×rows > 1 ise sayfa flipbook olarak oynatılır.
func particle_texture3d(tex, cols, rows) {
    _pt3_tex = tex;
    if (tex >= 0) {
        atlas_grid3d(tex, cols, rows);
        _pt3_frames = atlas_frames3d(tex);
    } else {
        _pt3_frames = 1;
    }
}
func parcacik_doku3d(doku, sutun, satir) { particle_texture3d(doku, sutun, satir); }

func particle_spin3d(deg_per_sec) { _pt3_spin_max = deg_per_sec; }
func parcacik_donme3d(derece_sn) { particle_spin3d(derece_sn); }

// Ömür oranından (k = kalan/başlangıç) atlas karesi. SAF: penceresiz
// sınanabilsin diye çizimden ayrı. k=1 (yeni doğmuş) ilk kare, k→0 son kare;
// son karede KALIYOR, başa sarmıyor — sayfalar bir kez oynanmak üzere çizilir
// ve sarmak patlamayı yeniden başlatırdı.
func _pt3_frame_of3(k, total): int {
    if (total <= 1) { return 0 - 1; }
    int f = toInt((1.0 - k) * total);
    if (f < 0) { f = 0; }
    if (f >= total) { f = total - 1; }
    return f;
}

// n adet parçacık saç: rastgele küresel yön, hafif yukarı eğilim.
func particles3d(x, y, z, n, color, speed, life) {
    int j = 0;
    while (j < n) {
        // küre üzerinde düzgün-ish yön
        float ang = random() * 6.2831853;
        float up  = random();
        float horiz = sqrt(1.0 - up * up);
        float spd = speed * (0.45 + random() * 0.75);
        float pvx = cos(ang) * horiz * spd;
        float pvz = sin(ang) * horiz * spd;
        float pvy = up * spd + speed * 0.35;      // yukarı eğilim
        float plife = life * (0.65 + random() * 0.7);
        float psize = 0.14 + random() * 0.18;
        float prot = random() * 360.0;
        // İşaret rastgele: hepsi aynı yöne dönseydi bulut bir bütün gibi
        // burgaçlanır, dağılmazdı.
        float pspin = (random() * 2.0 - 1.0) * _pt3_spin_max;
        int slot = 0 - 1;
        int i = 0;
        int cnt = length(_pt3life);
        while (i < cnt) {
            if (slot < 0 && _pt3life[i] <= 0.0) { slot = i; }
            i = i + 1;
        }
        if (slot >= 0) {
            _pt3x[slot] = x * 1.0; _pt3y[slot] = y * 1.0; _pt3z[slot] = z * 1.0;
            _pt3vx[slot] = pvx;    _pt3vy[slot] = pvy;    _pt3vz[slot] = pvz;
            _pt3life[slot] = plife; _pt3max[slot] = plife;
            _pt3col[slot] = color;  _pt3size[slot] = psize;
            _pt3rot[slot] = prot;   _pt3spin[slot] = pspin;
        } else {
            if (cnt < _PT3_CAP) {
                push(_pt3x, x * 1.0); push(_pt3y, y * 1.0); push(_pt3z, z * 1.0);
                push(_pt3vx, pvx);    push(_pt3vy, pvy);    push(_pt3vz, pvz);
                push(_pt3life, plife); push(_pt3max, plife);
                push(_pt3col, color);  push(_pt3size, psize);
                push(_pt3rot, prot);   push(_pt3spin, pspin);
            }
            // havuz dolu → bu parçacık düşer (kare hızı, görsel şıklıktan önemli)
        }
        j = j + 1;
    }
}

// Bir entity'nin konumunda patlama — ölüm efekti için en sık kullanım.
func burst3d(id, n, color, speed, life) {
    int s = _slot_of3(id);
    if (s < 0) { return; }
    Ent3 e = _e3[s];
    particles3d(e.x, e.y, e.z, n, color, speed, life);
}

func particle_gravity3d(g) { _pt3_grav = g; }

func _s3_particles(dt) {
    int i = 0;
    int cnt = length(_pt3life);
    while (i < cnt) {
        if (_pt3life[i] > 0.0) {
            _pt3vy[i] = _pt3vy[i] - _pt3_grav * dt;
            _pt3x[i] = _pt3x[i] + _pt3vx[i] * dt;
            _pt3y[i] = _pt3y[i] + _pt3vy[i] * dt;
            _pt3z[i] = _pt3z[i] + _pt3vz[i] * dt;
            _pt3rot[i] = _pt3rot[i] + _pt3spin[i] * dt;
            _pt3life[i] = _pt3life[i] - dt;
        }
        i = i + 1;
    }
}

func _s3_particles_draw() {
    int i = 0;
    int cnt = length(_pt3life);
    while (i < cnt) {
        if (_pt3life[i] > 0.0) {
            // ömür tükendikçe küçül — sönme hissi
            float k = _pt3life[i] / _pt3max[i];
            billboard_pro3d(_pt3_tex, _pt3x[i], _pt3y[i], _pt3z[i],
                            _pt3size[i] * k, _pt3rot[i],
                            _pt3_frame_of3(k, _pt3_frames), _pt3col[i]);
        }
        i = i + 1;
    }
}

func _s3_particles_clear() {
    _pt3x = []; _pt3y = []; _pt3z = [];
    _pt3vx = []; _pt3vy = []; _pt3vz = [];
    _pt3life = []; _pt3max = []; _pt3col = []; _pt3size = [];
    _pt3rot = []; _pt3spin = [];
}

// ---- Karakter animasyonu (Faz 8) -------------------------------------------
// tame'in anim_play builtin'i baştan beri vardı ama scene3d kullanmıyordu:
// modelli entity donuk duruyordu. Motor artık kare sayacını kendisi sürüyor,
// oyunun yapması gereken tek şey hangi animasyonun boşta/koşu olduğunu söylemek.
func anim3d(id, idle_idx, run_idx, fps) {
    int s = _slot_of3(id);
    if (s < 0) { return; }
    Ent3 e = _e3[s];
    e.anim_idle = idle_idx;
    e.anim_run = run_idx;
    e.anim_fps = fps;
    e.anim_t = 0.0;
    // Boştada BAŞLA: a=b=boşta, w=0. İki ucu da aynı klibe kurmak, ilk
    // karede yarım bir poz görünmesini engelliyor.
    e.anim_a = idle_idx;
    e.anim_b = idle_idx;
    e.anim_w = 0.0;
    e.anim_manual = 0;
    _e3[s] = e;
}

// ---- N KLİP: klibi oyun seçiyor --------------------------------------------
// `anim3d` hızdan türeyen otomatik locomotion; üçüncü bir durum (çömelme,
// saldırı, rastgele boşta) için oyunun klibi doğrudan söyleyebilmesi gerekiyor.
//
// Geçiş makinesi AYNI: hedef değişince (a,b,w) üçlüsü yeniden kuruluyor ve
// harmanlama aynı yoldan geçiyor. "İki klip" hiç özel değildi, yalnız hedefi
// hesaplayan kural iki seçenekliydi.
func anim_set3d(id, clip) {
    int s = _slot_of3(id);
    if (s < 0) { return; }
    Ent3 e = _e3[s];
    e.anim_manual = 1;
    _e3[s] = _anim_retarget3(e, clip);
}
func animasyon_sec3d(i, klip) { anim_set3d(i, klip); }

// Otomatik locomotion'a geri dön (hız boştayı/koşuyu seçsin).
func anim_auto3d(id) {
    int s = _slot_of3(id);
    if (s < 0) { return; }
    Ent3 e = _e3[s];
    e.anim_manual = 0;
    _e3[s] = e;
}
func animasyon_otomatik3d(i) { anim_auto3d(i); }

// Şu an GÖRÜNEN klip: harmanlamada baskın olan. Oyun mantığı "hangi
// animasyondayım" diye sorabilsin diye.
func anim_now3d(id): int {
    int s = _slot_of3(id);
    if (s < 0) { return 0 - 1; }
    Ent3 e = _e3[s];
    if (e.anim_w > 0.5) { return e.anim_b; }
    return e.anim_a;
}
func animasyon_su_an3d(i): int { return anim_now3d(i); }

// Harmanlama ağırlığı (0 = a, 1 = b). Test ve tanı için.
func anim_weight3d(id): float {
    int s = _slot_of3(id);
    if (s < 0) { return 0.0; }
    Ent3 e = _e3[s];
    return e.anim_w;
}

// Entity'nin bu karede oynatacağı animasyon indeksi: yatayda hareket varsa
// koşu, yoksa boşta. Koşu tanımlı değilse boştaya düşer.
func _anim_pick3(Ent3 e): int {
    float sp = sqrt(e.vx * e.vx + e.vz * e.vz);
    if (sp > 0.35 && e.anim_run >= 0) { return e.anim_run; }
    return e.anim_idle;
}

// Hedef klip değiştiğinde geçişi yeniden kur. SAF (Ent3 alır, Ent3 döner),
// yani penceresiz sınanabiliyor.
//
// Üç durum var ve üçü de ayrı ayrı önemli:
//   1. Hedef zaten b ise dokunma — yoksa her kare geçiş sıfırlanır ve
//      ağırlık asla ilerlemez.
//   2. Hedef a ise (yarıda GERİ dönüş) geçişi TERS çevir: w = 1-w. Sıfırdan
//      başlatmak, karakterin yarı yoldan tekrar tam koşuya gidip dönmesi
//      demek olurdu.
//   3. Üçüncü bir klip ise BASKIN pozdan başla. Ortada üç yönlü harmanlama
//      yok (VMValue'da tek ağırlık var), o yüzden dominant olanı a yapmak
//      en az sıçratan seçim.
func _anim_retarget3(Ent3 e, want): Ent3 {
    if (want == e.anim_b) { return e; }
    if (want == e.anim_a) {
        int tmp = e.anim_a;
        e.anim_a = e.anim_b;
        e.anim_b = tmp;
        e.anim_w = 1.0 - e.anim_w;
        return e;
    }
    if (e.anim_w > 0.5) { e.anim_a = e.anim_b; }
    e.anim_b = want;
    e.anim_w = 0.0;
    return e;
}

// ---- Animasyon harmanlaması -------------------------------------------------
// `_anim_pick3` bir animasyondan diğerine TEK KAREDE atlıyordu: karakter
// duraklayınca poz sıçrıyordu. Ağırlık artık zamana yayılıyor ve iki poz
// raylib'in kendi skinning yolundan geçen bir ara pozla karıştırılıyor
// (tm3_anim_blend).
//
// Geçiş DOĞRUSAL, üstel yumuşatma değil. Üstelde ağırlık hedefe hiç
// varmıyor, yani "boşta" pozu her zaman biraz koşu taşıyor. Doğrusal olan
// hedefe tam oturuyor ve süresi de tahmin edilebilir: 1/hız saniye.
float _anim_rate3 = 8.0;      // 1/sn — 0→1 geçişi 0.125 sn

func anim_blend_rate3d(r) { _anim_rate3 = r; }
func anim_gecis_hizi3d(h) { anim_blend_rate3d(h); }

// Hedef ağırlık: koşu tanımlı ve yatayda hareket varsa 1, yoksa 0.
// Eşik `_anim_pick3` ile AYNI — ikisi ayrışırsa harmanlama bir yöne,
// tek-poz yolu diğer yöne karar verirdi.
func _anim_target3(vx, vz, run_idx): float {
    if (run_idx < 0) { return 0.0; }
    if (sqrt(vx * vx + vz * vz) > 0.35) { return 1.0; }
    return 0.0;
}

// Ağırlığı hedefe doğru bir adım taşı. Saf: penceresiz sınanabiliyor.
func _anim_step_w3(w, target, dt): float {
    float adim = _anim_rate3 * dt;
    float d = target - w;
    if (abs_f3(d) <= adim) { return target; }
    if (d > 0.0) { return w + adim; }
    return w - adim;
}

// ---- Konumsal ses (Faz 8) --------------------------------------------------
// Ses zaten vardı; eksik olan tek şey mesafe çarpanıydı. Kamera hedefine (yoksa
// dünya merkezine) uzaklığa göre ses seviyesi: uzaktaki patlama kısık duyulur.
float _snd_range3 = 30.0;   // bu mesafede ses tamamen söner

func sound_range3d(r) { _snd_range3 = r; }

// Mesafeden ses seviyesi. Çalmadan AYRI: ses aygıtı olmadan (headless testte)
// doğrulanabilsin diye.
func _snd_vol3(x, y, z): float {
    float lx = 0.0; float ly = 0.0; float lz = 0.0;
    int ct = _slot_of3(_cam_target);
    if (ct >= 0) {
        Ent3 t = _e3[ct];
        lx = t.x; ly = t.y; lz = t.z;
    }
    float dx = x - lx; float dy = y - ly; float dz = z - lz;
    float d = sqrt(dx * dx + dy * dy + dz * dz);
    float v = 1.0 - d / _snd_range3;
    if (v < 0.0) { v = 0.0; }
    if (v > 1.0) { v = 1.0; }
    return v;
}

// ---- Stereo yön ------------------------------------------------------------
// Mesafe zayıflatması "ne kadar uzakta" diyordu ama "hangi yönde" demiyordu:
// solundaki patlama ile sağındakini ayırt edemiyordun.
//
// raylib'in kaydırma anlamı TERS (raudio.c: `left = pan; right = 1 - pan`),
// yani pan=0 SAĞ kanal. Çeviri BURADA yapılıyor ki oyun kodu ve motorun
// geri kalanı "sağdaki ses sağdan gelir" diye düşünsün.
float _snd_pan3 = 1.0;      // 0 = kaydırma kapalı (hep merkez), 1 = tam

func sound_pan_amount3d(k) { _snd_pan3 = k; }
func ses_yon_gucu3d(k) { sound_pan_amount3d(k); }

// Kaydırma değeri (raylib anlamıyla). Çalmadan AYRI: ses aygıtı olmadan,
// penceresiz sınanabilsin diye — `_snd_vol3` ile aynı gerekçe.
func _snd_pan_val3(x, y, z): float {
    float lx = 0.0; float lz = 0.0;
    int ct = _slot_of3(_cam_target);
    if (ct >= 0) {
        Ent3 t = _e3[ct];
        lx = t.x; lz = t.z;
    }
    float dx = x - lx;
    float dz = z - lz;
    float d = sqrt(dx * dx + dz * dz);
    // Dinleyicinin ÜSTÜNDEKİ ses yönsüzdür; 0'a bölmeyi de bu kapatıyor.
    if (d < 0.0001) { return 0.5; }
    // Kameranın SAĞ ekseni. Bakış yönü (sin(yaw), 0, -cos(yaw)) olduğuna
    // göre sağ = ileri × yukarı = (cos(yaw), 0, sin(yaw)). Aynı ifade
    // `move3d`'nin girdi döndürmesinde de var — ikisi ayrışırsa "sağa
    // yürü" ile "sağdan duy" farklı yönleri gösterirdi.
    float yr = _cam_yaw3 * DEG2RAD3;
    float u = (dx * cos(yr) + dz * sin(yr)) / d;   // -1 sol .. +1 sağ
    float p = 0.5 - 0.5 * u * _snd_pan3;
    if (p < 0.0) { p = 0.0; }
    if (p > 1.0) { p = 1.0; }
    return p;
}

func sound3d(handle, x, y, z) {
    sound_volume(handle, _snd_vol3(x, y, z));
    sound_pan(handle, _snd_pan_val3(x, y, z));
    play_sound(handle);
}

// ---- Fizik: hız entegrasyonu + yerçekimi + zemin ---------------------------
func _s3_physics(dt) {
    int n = length(_e3);
    // Rampa dizini kare başına BİR KEZ kuruluyor (O(n)); eskiden zemin
    // sorgusu entity başına bütün diziyi geziyordu, yani O(n²).
    _ramp_index3();
    // Platform dizini de: aynı gerekçe, aynı ömür.
    _plat_index3();
    int i = 0;
    while (i < n) {
        Ent3 e = _e3[i];
        if (e.alive == 1) {
            // dokunulmazlık penceresi geri sayar
            if (e.invuln > 0.0) {
                e.invuln = e.invuln - dt;
                if (e.invuln < 0.0) { e.invuln = 0.0; }
            }
            // Mermi düz uçar: ne yerçekimi ne zemin teması. Yoksa namludan
            // çıkar çıkmaz yere düşerdi.
            int is_bullet = 0;
            if (e.tag == TAG_BULLET) { is_bullet = 1; }
            // Rampalar duvarlar gibi SABİT dünya geometrisidir: düşmezler.
            int is_static = 0;
            if (e.tag == TAG_WALL || e.shape == SHAPE_RAMP) { is_static = 1; }
            // Suda mı? Yerçekimi azalır, sürtünme başlar. Gerçek kaldırma
            // kuvveti (yüzdürme) MODELLENMİYOR — cisim yavaşça batar, yüzeye
            // çıkmak için `zipla3` (yüzme vuruşu) gerekir. Basit ve öngörülebilir.
            int in_water = 0;
            if (_water_on3 == 1 && _water_phys3 == 1 && is_static == 0
                && is_bullet == 0 && e.y < _water_y3) { in_water = 1; }
            // yerçekimi yalnız oyuncu/düşman/prop'a
            if (is_static == 0 && is_bullet == 0) {
                float g = _grav;
                if (in_water == 1) { g = _grav * _water_grav3; }
                e.vy = e.vy - g * dt;
            }
            if (in_water == 1) {
                // Üstel sönüm: kare hızından bağımsız olsun diye dt ile.
                float k = 1.0 - _water_drag3 * dt;
                if (k < 0.0) { k = 0.0; }
                e.vx = e.vx * k;
                e.vy = e.vy * k;
                e.vz = e.vz * k;
            }
            // TAŞIMA: üstünde durduğu platform bu karede kımıldadıysa cisim
            // de onunla gider. Bundan ÖNCE olmalı — taşınmış konum, "yüzeyin
            // üstünde mi başladı" sorusunun sorulacağı konum.
            if (is_bullet == 0 && is_static == 0 && i < length(_e_sup3)) {
                int sup = _e_sup3[i];
                if (sup >= 0 && sup < length(_plat_dy3)) {
                    e.y = e.y + _plat_dy3[sup];
                }
            }
            // Bu karenin BAŞINDAKİ alt yüzeyi, hareket etmeden önce.
            // Platform desteği bunu kullanıyor: "yüzeyin üstünde mi başladı"
            // sorusu, yandan çarpmayı üstüne çıkmaktan ayıran tek şey.
            float onceki_alt = e.y - e.sy * 0.5;
            e.x = e.x + e.vx * dt;
            e.y = e.y + e.vy * dt;
            e.z = e.z + e.vz * dt;
            // Zemin teması. Dünya artık tek düzlem değil: rampaların üzerindeki
            // yükseklik, PLATFORMLARIN üstü de zemin sayılır — en yüksek olan.
            if (is_bullet == 0 && is_static == 0) {
                float half = e.sy * 0.5;
                float floor_y = _plat_top3(e.x, e.z, onceki_alt,
                                           _floor_at3(e.x, e.z)) + half;
                if (e.y <= floor_y) {
                    e.y = floor_y;
                    if (e.vy < 0.0) { e.vy = 0.0; }
                    e.grounded = 1;
                    // Destek kaydı: `_plat_top3` bir platform seçtiyse onun
                    // slotu, zemine/rampaya oturduysa -1.
                    if (i < length(_e_sup3)) { _e_sup3[i] = _plat_hit3; }
                } else {
                    e.grounded = 0;
                    // Havadayken destek YOK: zıplayan cisim eski platformunun
                    // hareketini taşımaya devam etmemeli.
                    if (i < length(_e_sup3)) { _e_sup3[i] = 0 - 1; }
                }
                // Eğim sınırı: dik yamaçta zemine basmak yetmiyor, aşağı
                // kayıyorsun. Normalin YATAY bileşeni tepeden dışarı bakar,
                // yani doğrudan yamaç aşağı yönü verir — ayrıca hesap gerekmiyor.
                // Sınır kapalıyken (varsayılan) bu blok hiç çalışmaz.
                if (_slope_lim3 > 0.0 && _terr_on == 1 && e.grounded == 1) {
                    _terrain_normal3(e.x, e.z);
                    if (_tn_y < _slope_cos3) {
                        float hl = sqrt(_tn_x * _tn_x + _tn_z * _tn_z);
                        if (hl > 0.0001) {
                            e.vx = e.vx + (_tn_x / hl) * _slide_acc3 * dt;
                            e.vz = e.vz + (_tn_z / hl) * _slide_acc3 * dt;
                        }
                    }
                }
            }
            // Ömür / dünya sınırı: ıskalayan mermi burada ölür, yoksa entity
            // store'da sonsuza kadar kalırdı (slot geri kazanımının anlamı bu).
            int expired = 0;
            if (e.life > 0.0) {
                e.life = e.life - dt;
                if (e.life <= 0.0) { expired = 1; }
            }
            if (is_bullet == 1 && _out_of_world3(e)) { expired = 1; }
            // Animasyon kare sayacı: motor sürer, render yalnız uygular.
            if (e.anim_idle >= 0 || e.anim_run >= 0 || e.anim_manual == 1) {
                e.anim_t = e.anim_t + e.anim_fps * dt;
                if (e.anim_t > 100000.0) { e.anim_t = 0.0; }   // taşma koruması
                // OTOMATİK kipte hedef hızdan türüyor. ELLE kipte hedefi
                // `anim_set3d` yazdı, dokunmuyoruz — otomatik kip her kare
                // hedefi yeniden yazdığı için elle seçileni anında ezerdi.
                if (e.anim_manual == 0) {
                    int want = e.anim_idle;
                    if (_anim_target3(e.vx, e.vz, e.anim_run) > 0.5) {
                        want = e.anim_run;
                    }
                    e = _anim_retarget3(e, want);
                }
                e.anim_w = _anim_step_w3(e.anim_w, 1.0, dt);
                // Geçiş bitti: b artık tek başına geçerli. a'yı da b yapmak,
                // sonraki hedef değişiminin "geri dönüş" dalına yanlışlıkla
                // düşmesini engelliyor.
                if (e.anim_w >= 1.0) {
                    e.anim_a = e.anim_b;
                    e.anim_w = 0.0;
                }
            }
            _e3[i] = e;
            if (expired == 1) { kill3d(_mk_handle3(i)); }
        }
        i = i + 1;
    }
}

// ---- AABB örtüşmesi + duvar itme (MTV) -------------------------------------
func _aabb_overlap(a, b): bool {
    Ent3 ea = _e3[a];
    Ent3 eb = _e3[b];
    float dx = ea.x - eb.x; if (dx < 0.0) { dx = 0.0 - dx; }
    float dy = ea.y - eb.y; if (dy < 0.0) { dy = 0.0 - dy; }
    float dz = ea.z - eb.z; if (dz < 0.0) { dz = 0.0 - dz; }
    float rx = (ea.sx + eb.sx) * 0.5;
    float ry = (ea.sy + eb.sy) * 0.5;
    float rz = (ea.sz + eb.sz) * 0.5;
    return dx < rx && dy < ry && dz < rz;
}

func abs_f3(v): float { if (v < 0.0) { return 0.0 - v; } return v; }

// ===========================================================================
// Faz 9 — dünya geometrisi
// ===========================================================================
// Buraya kadar motor HER ŞEYİ eksen-hizalı kutu sayıyordu: küre kutu gibi
// çarpışıyor, yaw ile dönen cismin gövdesi dönmüyor, dünya tek düz düzlem
// oluyordu. Bu bölüm üçünü de düzeltiyor.

// --- Yerel eksenler: yaw YALNIZ Y ekseninde döndürür ------------------------
// move3d'nin düzeni: yaw = atan2(wx, wz), yani yerel +Z (ileri) dünyada
// (sin yaw, cos yaw). Buna dik olan yerel +X ise (cos yaw, -sin yaw).
func _axz3(yaw): float { return cos(yaw * DEG2RAD3); }   // yerel X'in dünya x'i
func _axx3(yaw): float { return 0.0 - sin(yaw * DEG2RAD3); } // yerel X'in dünya z'si
func _azx3(yaw): float { return sin(yaw * DEG2RAD3); }   // yerel Z'nin dünya x'i
func _azz3(yaw): float { return cos(yaw * DEG2RAD3); }   // yerel Z'nin dünya z'si

// --- SAT (dönen kutu) -------------------------------------------------------
// Sonuç global ile dönüyor — Tulpar'da çoklu dönüş yok.
// _sat_nx/_sat_nz: a'yı b'den ayıracak birim yön; _sat_d: o yöndeki girme payı.
float _sat_nx = 0.0;
float _sat_nz = 0.0;
float _sat_d  = 0.0;

// Bir kutunun n eksenine izdüşüm yarıçapı.
func _obb_radius3(hx, hz, yaw, nx, nz): float {
    float ax = _axz3(yaw); float az = _axx3(yaw);   // yerel X ekseni (dünya)
    float bx = _azx3(yaw); float bz = _azz3(yaw);   // yerel Z ekseni (dünya)
    return hx * abs_f3(ax * nx + az * nz) + hz * abs_f3(bx * nx + bz * nz);
}

// Tek eksende ayrılma testi. Ayrıksa true; değilse girme payını _sat_* içine
// yazar (yalnız şimdiye kadarki EN KÜÇÜK pay saklanır → MTV).
func _sat_axis3(nx, nz, dx, dz, ahx, ahz, ayaw, bhx, bhz, byaw): bool {
    float ln = sqrt(nx * nx + nz * nz);
    if (ln < 0.000001) { return false; }        // dejenere eksen — atla
    float ux = nx / ln;
    float uz = nz / ln;
    float ra = _obb_radius3(ahx, ahz, ayaw, ux, uz);
    float rb = _obb_radius3(bhx, bhz, byaw, ux, uz);
    float dist = dx * ux + dz * uz;
    float overlap = ra + rb - abs_f3(dist);
    if (overlap <= 0.0) { return true; }        // AYRIK → çarpışma yok
    if (overlap < _sat_d) {
        _sat_d = overlap;
        // a'yı b'den UZAKLAŞTIRACAK yön. d = merkez_a - merkez_b olduğu için
        // dist > 0 ise a zaten +u tarafındadır → ayırmak için DAHA İLERİ +u'ya
        // itilir. (Ters işaret a'yı b'nin içine sürüyordu.)
        if (dist < 0.0) { _sat_nx = 0.0 - ux; _sat_nz = 0.0 - uz; }
        else { _sat_nx = ux; _sat_nz = uz; }
    }
    return false;
}

// İki dönük kutunun XZ düzleminde çakışması (SAT, 4 eksen). Y ayrı bakılır.
func _obb_overlap3(a, b): bool {
    Ent3 ea = _e3[a];
    Ent3 eb = _e3[b];
    // Y aralığı önce: ucuz ve çoğu ayrık çifti burada eler.
    if (abs_f3(ea.y - eb.y) >= (ea.sy + eb.sy) * 0.5) { return false; }
    _sat_d = 1000000.0;
    float dx = ea.x - eb.x;
    float dz = ea.z - eb.z;
    float ahx = ea.sx * 0.5; float ahz = ea.sz * 0.5;
    float bhx = eb.sx * 0.5; float bhz = eb.sz * 0.5;
    if (_sat_axis3(_axz3(ea.yaw), _axx3(ea.yaw), dx, dz, ahx, ahz, ea.yaw, bhx, bhz, eb.yaw)) { return false; }
    if (_sat_axis3(_azx3(ea.yaw), _azz3(ea.yaw), dx, dz, ahx, ahz, ea.yaw, bhx, bhz, eb.yaw)) { return false; }
    if (_sat_axis3(_axz3(eb.yaw), _axx3(eb.yaw), dx, dz, ahx, ahz, ea.yaw, bhx, bhz, eb.yaw)) { return false; }
    if (_sat_axis3(_azx3(eb.yaw), _azz3(eb.yaw), dx, dz, ahx, ahz, ea.yaw, bhx, bhz, eb.yaw)) { return false; }
    return true;
}

// --- Şekil farkında çakışma -------------------------------------------------
// Yarıçap: küre/silindir çizimi sx*0.5 kullanıyor (bkz. _s3_render), aynısı.
func _radius3(Ent3 e): float { return e.sx * 0.5; }

// Küre ↔ küre
func _sph_sph3(a, b): bool {
    Ent3 ea = _e3[a];
    Ent3 eb = _e3[b];
    float dx = ea.x - eb.x; float dy = ea.y - eb.y; float dz = ea.z - eb.z;
    float r = _radius3(ea) + _radius3(eb);
    return dx * dx + dy * dy + dz * dz < r * r;
}

// Küre ↔ kutu: kutunun küre merkezine EN YAKIN noktası küre içindeyse çarpışma.
// (Kutu eksen-hizalı varsayılır; dönük kutu + küre pratikte yeterince iyi.)
func _sph_box3(s, b): bool {
    Ent3 es = _e3[s];
    Ent3 eb = _e3[b];
    float hx = eb.sx * 0.5; float hy = eb.sy * 0.5; float hz = eb.sz * 0.5;
    // DÖNÜK kutu: kürenin merkezini kutunun YEREL çerçevesine taşı, sonra
    // sıradan eksen-hizalı en-yakın-nokta testini uygula. Dönme mesafeyi
    // koruduğu için sonuç KESİN — yaklaşık değil.
    //
    // Eskiden yaw yok sayılıyordu: kutu-kutu çifti tam SAT'tan geçiyordu ama
    // küre-kutu geçmiyordu, yani 45 derece dönük bir duvarın yanından geçen
    // top ona çarpmış sayılabiliyor (ya da tam tersi, içinden geçebiliyordu).
    // Dönüş yönü `_seg_aabb3` ile AYNI; iki test ayrışsaydı aynı duvar için
    // çarpışma ve kamera farklı cevaplar verirdi.
    float sxp = es.x;
    float szp = es.z;
    if (abs_f3(eb.yaw) > 0.01) {
        float rx = es.x - eb.x;
        float rz = es.z - eb.z;
        float c = cos(eb.yaw * DEG2RAD3);
        float sn = sin(eb.yaw * DEG2RAD3);
        sxp = eb.x + (rx * c - rz * sn);
        szp = eb.z + (rx * sn + rz * c);
    }
    float cx = sxp; float cy = es.y; float cz = szp;
    if (cx < eb.x - hx) { cx = eb.x - hx; }
    if (cx > eb.x + hx) { cx = eb.x + hx; }
    if (cy < eb.y - hy) { cy = eb.y - hy; }
    if (cy > eb.y + hy) { cy = eb.y + hy; }
    if (cz < eb.z - hz) { cz = eb.z - hz; }
    if (cz > eb.z + hz) { cz = eb.z + hz; }
    float dx = sxp - cx; float dy = es.y - cy; float dz = szp - cz;
    float r = _radius3(es);
    return dx * dx + dy * dy + dz * dz < r * r;
}

// Silindir = dikey kapsül yaklaşımı: XZ'de daire, Y'de aralık.
func _cyl_overlap3(a, b): bool {
    Ent3 ea = _e3[a];
    Ent3 eb = _e3[b];
    if (abs_f3(ea.y - eb.y) >= (ea.sy + eb.sy) * 0.5) { return false; }
    float dx = ea.x - eb.x; float dz = ea.z - eb.z;
    float r = _radius3(ea) + _radius3(eb);
    return dx * dx + dz * dz < r * r;
}

func _is_round3(Ent3 e): bool { return e.shape == SHAPE_SPHERE || e.shape == SHAPE_CYL; }

// Motorun TEK çakışma girişi. Şekle göre doğru testi seçer; ikisi de eksen-hizalı
// kutuysa eski (ucuz) AABB yolunda kalır — eski sahnelerin davranışı değişmez.
// ---- Temas payı (contact skin) ---------------------------------------------
// KATI-KATI çarpışma kancaları HİÇ atmıyordu ve bu sessiz bir hataydı:
// `_s3_collision` önce MTV ile cisimleri TAM ayırıyor, kanca taraması ise
// ondan SONRA çakışma arıyor — ayrılmış iki cisim tam teğet duruyor, yani
// çakışma yok. Sonuç: `carpisinca3(TAG_ENEMY, TAG_PLAYER, ...)` kaydeden bir
// oyun (gönderilen scene3d_arena örneği dahil) hiçbir zaman çağrılmıyordu.
// Yalnız katı-KATISIZ çiftler (eşya, mermi) çalışıyordu, çünkü onlar
// ayrılmıyor.
//
// Çözüm fizik motorlarının standardı: temas taraması cisimleri küçük bir payla
// şişirerek bakar. Pay AABB/küre/silindir/SAT ayrımını bilmiyor — cisimlerin
// boyutu geçici olarak büyütülüp AYNI `_overlap3` çağrılıyor. Şekil matematiği
// ikinci bir yerde tekrarlansaydı er geç ondan sapardı.
float _hit_skin3 = 0.06;   // dünya birimi (6 cm)

func _overlap_hit3(a, b): bool {
    Ent3 ea = _e3[a];
    Ent3 eb = _e3[b];
    float ax = ea.sx; float ay = ea.sy; float az = ea.sz;
    float bx = eb.sx; float by = eb.sy; float bz = eb.sz;
    float g = _hit_skin3 * 2.0;   // yarı-boy pay kadar büyüsün
    ea.sx = ax + g; ea.sy = ay + g; ea.sz = az + g;
    eb.sx = bx + g; eb.sy = by + g; eb.sz = bz + g;
    _e3[a] = ea; _e3[b] = eb;
    bool r = _overlap3(a, b);
    ea.sx = ax; ea.sy = ay; ea.sz = az;
    eb.sx = bx; eb.sy = by; eb.sz = bz;
    _e3[a] = ea; _e3[b] = eb;
    return r;
}

func _overlap3(a, b): bool {
    Ent3 ea = _e3[a];
    Ent3 eb = _e3[b];
    int ra = 0; if (_is_round3(ea)) { ra = 1; }
    int rb = 0; if (_is_round3(eb)) { rb = 1; }
    if (ea.shape == SHAPE_CYL || eb.shape == SHAPE_CYL) {
        if (ra == 1 && rb == 1) { return _cyl_overlap3(a, b); }
    }
    if (ra == 1 && rb == 1) { return _sph_sph3(a, b); }
    if (ra == 1) { return _sph_box3(a, b); }
    if (rb == 1) { return _sph_box3(b, a); }
    // ikisi de kutu: biri dönükse SAT, değilse AABB
    if (abs_f3(ea.yaw) > 0.01 || abs_f3(eb.yaw) > 0.01) { return _obb_overlap3(a, b); }
    return _aabb_overlap(a, b);
}

// --- Katı gövde ayırması (MTV) ----------------------------------------------
// _mtv3(a, b): a'yı b'den ayırmak için a'ya uygulanacak EN KISA vektör.
// Çakışma yoksa false. Şekle göre doğru yöntemi seçer — kutu için en sığ eksen,
// küre için merkezler arası doğrultu, silindir için yatay doğrultu.
float _mtv_x = 0.0;
float _mtv_y = 0.0;
float _mtv_z = 0.0;

func _mtv_box_box3(a, b): bool {
    Ent3 ea = _e3[a];
    Ent3 eb = _e3[b];
    // Dönük çift → SAT (yatay). Y'yi ayrıca kontrol ettik, dikey ayırma yok.
    if (abs_f3(ea.yaw) > 0.01 || abs_f3(eb.yaw) > 0.01) {
        if (!_obb_overlap3(a, b)) { return false; }
        _mtv_x = _sat_nx * _sat_d;
        _mtv_y = 0.0;
        _mtv_z = _sat_nz * _sat_d;
        return true;
    }
    float dx = ea.x - eb.x;
    float dy = ea.y - eb.y;
    float dz = ea.z - eb.z;
    float ox = (ea.sx + eb.sx) * 0.5 - abs_f3(dx);
    float oy = (ea.sy + eb.sy) * 0.5 - abs_f3(dy);
    float oz = (ea.sz + eb.sz) * 0.5 - abs_f3(dz);
    if (ox <= 0.0 || oy <= 0.0 || oz <= 0.0) { return false; }
    _mtv_x = 0.0; _mtv_y = 0.0; _mtv_z = 0.0;
    if (ox <= oy && ox <= oz) {
        if (dx > 0.0) { _mtv_x = ox; } else { _mtv_x = 0.0 - ox; }
    } else {
        if (oz <= oy) {
            if (dz > 0.0) { _mtv_z = oz; } else { _mtv_z = 0.0 - oz; }
        } else {
            if (dy > 0.0) { _mtv_y = oy; } else { _mtv_y = 0.0 - oy; }
        }
    }
    return true;
}

// Küre ↔ küre: merkezleri ayıran doğrultu.
func _mtv_sph_sph3(a, b): bool {
    Ent3 ea = _e3[a];
    Ent3 eb = _e3[b];
    float dx = ea.x - eb.x; float dy = ea.y - eb.y; float dz = ea.z - eb.z;
    float r = _radius3(ea) + _radius3(eb);
    float d2 = dx * dx + dy * dy + dz * dz;
    if (d2 >= r * r) { return false; }
    float d = sqrt(d2);
    if (d < 0.00001) { _mtv_x = 0.0; _mtv_y = r; _mtv_z = 0.0; return true; }
    float k = (r - d) / d;
    _mtv_x = dx * k; _mtv_y = dy * k; _mtv_z = dz * k;
    return true;
}

// Küre ↔ kutu: kutu üzerindeki en yakın noktadan küre merkezine.
func _mtv_sph_box3(s, b): bool {
    Ent3 es = _e3[s];
    Ent3 eb = _e3[b];
    float hx = eb.sx * 0.5; float hy = eb.sy * 0.5; float hz = eb.sz * 0.5;
    float cx = es.x; float cy = es.y; float cz = es.z;
    if (cx < eb.x - hx) { cx = eb.x - hx; }
    if (cx > eb.x + hx) { cx = eb.x + hx; }
    if (cy < eb.y - hy) { cy = eb.y - hy; }
    if (cy > eb.y + hy) { cy = eb.y + hy; }
    if (cz < eb.z - hz) { cz = eb.z - hz; }
    if (cz > eb.z + hz) { cz = eb.z + hz; }
    float dx = es.x - cx; float dy = es.y - cy; float dz = es.z - cz;
    float r = _radius3(es);
    float d2 = dx * dx + dy * dy + dz * dz;
    if (d2 >= r * r) { return false; }
    float d = sqrt(d2);
    if (d < 0.00001) {
        // merkez kutunun tam içinde — en sığ yüzeyden dışarı at
        return _mtv_box_box3(s, b);
    }
    float k = (r - d) / d;
    _mtv_x = dx * k; _mtv_y = dy * k; _mtv_z = dz * k;
    return true;
}

// Silindir çifti: yatay doğrultuda ayrılır (dikey kapsül mantığı).
func _mtv_cyl3(a, b): bool {
    Ent3 ea = _e3[a];
    Ent3 eb = _e3[b];
    if (abs_f3(ea.y - eb.y) >= (ea.sy + eb.sy) * 0.5) { return false; }
    float dx = ea.x - eb.x; float dz = ea.z - eb.z;
    float r = _radius3(ea) + _radius3(eb);
    float d2 = dx * dx + dz * dz;
    if (d2 >= r * r) { return false; }
    float d = sqrt(d2);
    if (d < 0.00001) { _mtv_x = r; _mtv_y = 0.0; _mtv_z = 0.0; return true; }
    float k = (r - d) / d;
    _mtv_x = dx * k; _mtv_y = 0.0; _mtv_z = dz * k;
    return true;
}

// Motorun tek ayırma girişi — _overlap3'ün şekil dağıtımıyla AYNI sırayı izler,
// yoksa "çakışıyor ama ayıramıyorum" gibi tutarsız bir durum çıkardı.
func _mtv3(a, b): bool {
    Ent3 ea = _e3[a];
    Ent3 eb = _e3[b];
    int ra = 0; if (_is_round3(ea)) { ra = 1; }
    int rb = 0; if (_is_round3(eb)) { rb = 1; }
    if (ea.shape == SHAPE_CYL || eb.shape == SHAPE_CYL) {
        if (ra == 1 && rb == 1) { return _mtv_cyl3(a, b); }
    }
    if (ra == 1 && rb == 1) { return _mtv_sph_sph3(a, b); }
    if (ra == 1) { return _mtv_sph_box3(a, b); }
    if (rb == 1) {
        // b yuvarlak: b→a vektörünü hesaplayıp TERSİNİ al
        if (!_mtv_sph_box3(b, a)) { return false; }
        _mtv_x = 0.0 - _mtv_x; _mtv_y = 0.0 - _mtv_y; _mtv_z = 0.0 - _mtv_z;
        return true;
    }
    return _mtv_box_box3(a, b);
}

// Ayırmayı uygula: konumu taşı, itilen eksendeki hızı kes. Yukarı itildiyse
// zeminde sayılır (kutunun üstüne çıkmak böyle çalışır).
func _apply_mtv3(s, fx, fy, fz) {
    Ent3 e = _e3[s];
    e.x = e.x + fx;
    e.y = e.y + fy;
    e.z = e.z + fz;
    float ax = abs_f3(fx); float ay = abs_f3(fy); float az = abs_f3(fz);
    if (ay >= ax && ay >= az) {
        if (fy > 0.0 && e.vy < 0.0) { e.grounded = 1; }
        e.vy = 0.0;
    } else {
        if (ax >= az) { e.vx = 0.0; } else { e.vz = 0.0; }
    }
    _e3[s] = e;
    // Ayırma çözümü ENTITY'Yİ OYNATIR ve çarpışma taraması sürüyor. Geniş faz
    // konumu burada tazelenmezse aynı karede itilmiş bir gövde, sonraki
    // çiftlerde eski yerinden değerlendirilir — kaçan çarpışma demek.
    _bp_sync3(s);
}

func _is_solid3(Ent3 e): bool { return e.alive == 1 && e.solid == 1; }
// Statik = dünya geometrisi (itilmez, iter). Hareketli = itilebilir.
func _is_static_solid3(Ent3 e): bool { return e.solid == 1 && e.tag == TAG_WALL; }

// --- Işın ↔ AABB (kamera-duvar çarpışması için) -----------------------------
// Parametrik dilim (slab) yöntemi. o + d*t, t ∈ [0,1] doğru parçası kutuyu
// kesiyorsa ilk kesişme t'sini, kesmiyorsa -1 döner.
func _seg_aabb3(ox, oy, oz, dx, dy, dz, w): float {
    Ent3 e = _e3[w];
    float hx = e.sx * 0.5; float hy = e.sy * 0.5; float hz = e.sz * 0.5;
    // DÖNÜK kutu: ışını cismin YEREL çerçevesine taşı, sonra sıradan dilim
    // testini uygula. Bu olmadan yaw yok sayılıyordu ve dönük bir duvar için
    // TAMAMEN YANLIŞ bir hacim sınanıyordu: 45° dönük 9x0.6'lık duvar,
    // dünya X'i boyunca ince bir dilim sanılıyor. Sonuç, kameranın gerçek
    // duvarın içinden geçip arkasına oturması — oradan bakınca duvar arka yüz
    // ayıklamasıyla kayboluyor ve oyun "duvardan geçiyorum" gibi görünüyor.
    // (Kullanıcının tanılama kaydı bunu duvar#6 = çapraz duvar olarak gösterdi.)
    float rx = ox - e.x;
    float rz = oz - e.z;
    float ldx = dx;
    float ldz = dz;
    if (abs_f3(e.yaw) > 0.01) {
        float c = cos(e.yaw * DEG2RAD3);
        float sn = sin(e.yaw * DEG2RAD3);
        float nrx = rx * c - rz * sn;
        float nrz = rx * sn + rz * c;
        rx = nrx; rz = nrz;
        ldx = dx * c - dz * sn;
        ldz = dx * sn + dz * c;
    }
    ox = e.x + rx;
    oz = e.z + rz;
    dx = ldx;
    dz = ldz;
    float tmin = 0.0;
    float tmax = 1.0;
    // X dilimi
    if (abs_f3(dx) < 0.000001) {
        if (ox < e.x - hx || ox > e.x + hx) { return 0.0 - 1.0; }
    } else {
        float t1 = (e.x - hx - ox) / dx;
        float t2 = (e.x + hx - ox) / dx;
        if (t1 > t2) { float tt = t1; t1 = t2; t2 = tt; }
        if (t1 > tmin) { tmin = t1; }
        if (t2 < tmax) { tmax = t2; }
        if (tmin > tmax) { return 0.0 - 1.0; }
    }
    // Y dilimi
    if (abs_f3(dy) < 0.000001) {
        if (oy < e.y - hy || oy > e.y + hy) { return 0.0 - 1.0; }
    } else {
        float t1 = (e.y - hy - oy) / dy;
        float t2 = (e.y + hy - oy) / dy;
        if (t1 > t2) { float tt = t1; t1 = t2; t2 = tt; }
        if (t1 > tmin) { tmin = t1; }
        if (t2 < tmax) { tmax = t2; }
        if (tmin > tmax) { return 0.0 - 1.0; }
    }
    // Z dilimi
    if (abs_f3(dz) < 0.000001) {
        if (oz < e.z - hz || oz > e.z + hz) { return 0.0 - 1.0; }
    } else {
        float t1 = (e.z - hz - oz) / dz;
        float t2 = (e.z + hz - oz) / dz;
        if (t1 > t2) { float tt = t1; t1 = t2; t2 = tt; }
        if (t1 > tmin) { tmin = t1; }
        if (t2 < tmax) { tmax = t2; }
        if (tmin > tmax) { return 0.0 - 1.0; }
    }
    return tmin;
}

// Kamerayla hedef arasına giren cisimleri işaretle (bu kare saydam çizilecek).
// Hedefin KENDİSİ hariç — oyuncuyu saydamlaştırmak amacın tam tersi olurdu.
// Mermiler de hariç: yanından geçen her mermi duvarı yanıp sönerdi.
func _s3_mark_fade3(cx, cy, cz, tx, ty, tz, ts) {
    _fade3 = [];
    int n = length(_e3);
    int i = 0;
    while (i < n) { push(_fade3, 0); i = i + 1; }
    if (_cam_xray3 == 0) { return; }
    float dx = tx - cx; float dy = ty - cy; float dz = tz - cz;
    i = 0;
    while (i < n) {
        if (i != ts) {
            Ent3 e = _e3[i];
            if (e.alive == 1 && e.tag != TAG_BULLET) {
                // `_seg_aabb3` DOĞRU PARÇASI testi: t yalnız 0..1 aralığında
                // dönüyor, yani kameranın arkasında ya da oyuncunun ötesinde
                // kalan duvarlar zaten -1 veriyor. Ayrıca `t < 1.0` yazmak
                // gereksizdi (ve "arkadakileri eliyorum" diye yanlış bir izlenim
                // veriyordu — elemeyi yapan bu satır değil, ışın testinin
                // kendisi).
                float t = _seg_aabb3(cx, cy, cz, dx, dy, dz, i);
                if (t >= 0.0) { _fade3[i] = 1; }
            }
        }
        i = i + 1;
    }
}

func camera_xray3d(on) { if (on) { _cam_xray3 = 1; } else { _cam_xray3 = 0; _fade3 = []; } }
func kamera_seffaf3d(ac) { camera_xray3d(ac); }
// Araya giren cismin alfası: 0 tamamen görünmez, 255 opak.
func xray_alpha3d(a) { _fade_a3 = a; }
func seffaflik3d(a) { xray_alpha3d(a); }

// Engelin izin verdiği kamera mesafesi. SAF fonksiyon (durum okumaz, ayar
// dışında) — kamera konumu raylib'e yazıldığı için geri okunamıyor, o yüzden
// karar mantığı buraya ayrıldı ve doğrudan test ediliyor.
//
// `full` = engelsizken olması gereken mesafe, `ct` = ışının çarpma oranı
// (1.0 = engel yok). Hesap DÜNYA BİRİMİNDE: oran önce mesafeye çevriliyor,
// pay ve taban da mesafe olarak uygulanıyor. Eskiden taban oran (%12) idi ve
// bu, kameranın ne kadar uzakta kurulduğuna göre anlam değiştiriyordu —
// `kamera_yorunge(p, 16, ...)` sahnesinde arkadaki engel kamerayı oyuncunun
// 1.9 birim yakınına sokuyordu.
func _cam_allowed3(full, ct): float {
    float allowed = full;
    if (ct < 1.0) { allowed = full * ct - _cam_pad3; }
    // Taban: kamera hedefin içine gömülmez. Engel bundan da yakınsa kamera
    // duvara biraz girer — bilinçli takas, alternatifi oyuncunun kafasının
    // içinden bakmak.
    if (allowed < _cam_near3) { allowed = _cam_near3; }
    return allowed;
}

// Yumuşatma ASİMETRİK: içeri ANINDA (yoksa kamera bir kare duvarın içinde
// kalır), dışarı yavaş. Engelin arkasından çıkarken kameranın geri fırlaması,
// girmesinden daha rahatsız edici.
func _cam_smooth3(allowed, dt): float {
    if (_cam_cur3 <= 0.0 || allowed < _cam_cur3) {
        _cam_cur3 = allowed;
    } else {
        float k = _cam_ease3 * dt;
        if (k > 1.0) { k = 1.0; }
        _cam_cur3 = _cam_cur3 + (allowed - _cam_cur3) * k;
    }
    return _cam_cur3;
}

// Hedeften kameraya giden doğru parçasını duvarlara karşı tara; en yakın
// kesişme oranını döner (1.0 = engel yok).
float _CAM_TERR_CLEAR3 = 0.6;   // arazi yüzeyinin bu kadar üstünde kal
int   _CAM_TERR_STEPS3 = 14;    // ışın boyunca örnek sayısı

func _cam_clear_t3(ox, oy, oz, dx, dy, dz): float {
    float best = 1.0;
    int n = length(_e3);
    int i = 0;
    // Duvar taraması HER ZAMAN çalışır. Bir ara röntgen açıkken kapatılmıştı
    // ("saydamlık zaten görüş sağlıyor") — yanlıştı: saydamlık, kamerayla
    // oyuncu ARASINDAKİ cismi çözüyor, kameranın kendisinin duvarın ARKASINA
    // geçmesini değil. Sırtını duvara dayayınca kamera arenanın dışına çıkıyor,
    // dışarıdan bakınca duvarlar arka yüz ayıklamasıyla kayboluyor ve oyuncu
    // "duvarların içinden geçiyorum, yükseklik algım gitti" diyor. Kamera
    // dünyanın içinde kalmak ZORUNDA; saydamlık onun yerine geçemez, yanına
    // gelir.
    while (i < n) {
        Ent3 e = _e3[i];
        if (e.alive == 1 && e.tag == TAG_WALL) {
            float t = _seg_aabb3(ox, oy, oz, dx, dy, dz, i);
            if (t >= 0.0 && t < best) { best = t; }
        }
        i = i + 1;
    }
    // ZEMİN. Yukarıdaki tarama yalnız TAG_WALL kutularına bakıyordu, oysa
    // arazi bir kutu değil sürekli bir yüzey — kamera tepenin İÇİNE girip
    // sahneyi topraktan gösteriyordu. Arazide kapalı biçimli bir kesişim yok,
    // o yüzden ışın boyunca yürüyüp zeminin altına düştüğü ilk yeri buluyoruz.
    // `_floor_at3` kullanıldığı için RAMPALAR da bedavaya kapsanıyor; onlar da
    // TAG_WALL olmadıkları için kutu taramasının dışında kalıyordu.
    if (_terr_on == 1 || _ground_on == 1) {
        float inv = 1.0 / (_CAM_TERR_STEPS3 * 1.0);
        int k = 1;
        while (k <= _CAM_TERR_STEPS3) {
            float t = k * inv;
            float py = oy + dy * t;
            if (py < _floor_at3(ox + dx * t, oz + dz * t) + _CAM_TERR_CLEAR3) {
                // Bir adım geri: son GÜVENLİ örneğe çek.
                float safe = t - inv;
                if (safe < best) { best = safe; }
                k = _CAM_TERR_STEPS3 + 1;
            } else {
                k = k + 1;
            }
        }
    }
    return best;
}

// --- Rampa / eğimli zemin ---------------------------------------------------
// Rampa entity'sinin (x,z) noktasındaki ÜST YÜZEY yüksekliği. Nokta rampanın
// ayak izi dışındaysa -1000000 döner (yani "burada zemin yok").
// Yüzey, rampanın yerel -Z ucundan +Z ucuna doğrusal yükselir; yaw ile döner.
func _ramp_h3(r, px, pz): float {
    Ent3 e = _e3[r];
    // noktayı rampanın yerel uzayına taşı (ters yaw dönüşü)
    float rx = px - e.x;
    float rz = pz - e.z;
    float c = cos(e.yaw * DEG2RAD3);
    float s = sin(e.yaw * DEG2RAD3);
    // yerel = R(-yaw) * dünya; yerel_z = ileri ekseni üzerindeki bileşen
    float lx = rx * c - rz * s;
    float lz = rx * s + rz * c;
    float hx = e.sx * 0.5;
    float hz = e.sz * 0.5;
    if (lx < 0.0 - hx || lx > hx) { return 0.0 - 1000000.0; }
    if (lz < 0.0 - hz || lz > hz) { return 0.0 - 1000000.0; }
    float k = (lz + hz) / e.sz;          // 0 = alçak uç, 1 = yüksek uç
    return e.y - e.sy * 0.5 + e.sy * k;
}

// (x,z) noktasında geçerli zemin yüksekliği: düz zemin ile rampaların EN
// YÜKSEĞİ. Rampa yoksa sonuç düz zemindir, yani eski davranış birebir korunur.
// RAMPA DİZİNİ. `_ramp_floor3` her entity için BÜTÜN entity'leri geziyordu ve
// her adımda bir `Ent3` struct kopyası alıyordu; fizik onu entity başına bir
// kez çağırdığı için maliyet n² idi. Ölçülen tablo (ms/kare, headless):
// 100→0.99, 200→3.72, 400→15.94, 800→69.4 — yani 400 entity'de 60 fps
// bütçesi (16.7 ms) zaten aşılıyordu. Geniş faz ve ızgara bu maliyete hiç
// dokunmuyordu, çünkü maliyet ÇARPIŞMADA değil ZEMİN SORGUSUNDAYDI.
//
// Dizin bir ÜST KÜME: ölmüş ya da slot'u yeniden kullanılmış girdiler
// olabilir, `_ramp_floor3` her girdide `alive`/`shape` denetimini yine
// yapıyor. Bu, dizini kill3d ile senkron tutma zorunluluğunu kaldırıyor —
// senkronu kaçırmak sessiz bir hata olurdu, üst küme olmak değil.
array _rampi3 = [];

// ---- Platform desteği (statik katı kutuların ÜSTÜ zemin sayılır) -----------
// Zemin sorgusu düzlem + arazi + rampa biliyordu, KUTULARI bilmiyordu. Sonucu
// kullanıcı oynayarak buldu: PLATFORM şablonunda toplanacak altınlar
// platformların üstünde durmuyor, dibe düşüyordu (katı olmadıkları için MTV
// de onlara dokunmuyor) — yani "platform oyunu"nun bütün eşyaları yerdeydi.
//
// Aynı sorgu hızlı düşüşteki TÜNELLEMEYİ de kapatıyor: karşılaştırma
// entity'nin bu kareye BAŞLARKENki alt yüzeyiyle yapılıyor, o yüzden bir
// karede kalınlığı aşmak fark etmiyor.
array _plati3 = [];

// Temas payı — bkz. `_plat_top3`. Sığ teması yandan tırmanmadan ayıran sınır.
float _PLAT_SKIN3 = 0.15;

// HAREKETLİ platform taşıması. Salınan bir platformun üstündeki cisim onunla
// birlikte gitmezse platform altından kaçıyor ve cisim düşüyor: şablondaki
// salınan platformun altını YERE düşüyordu, oyuncu da karelerin %43'ünde
// havada kalıyordu (ölçüldü). Taşıma olmadan "hareketli platform" diye bir
// şey yok, sadece ara ara çarpan bir kutu var.
//
// Üç dizi de SLOT'la indeksleniyor (handle ile değil) ve entity deposuyla
// aynı boyda tutuluyor.
array _plat_lasty3 = [];   // geçen karedeki y
array _plat_dy3    = [];   // bu karedeki y değişimi
array _plat_seen3  = [];   // bu slot geçen karede de platform muydu
array _e_sup3      = [];   // cismin üstünde durduğu platformun slotu (-1 = yok)

// Sorgunun okuduğu DÜZ diziler — `_plati3` ile aynı sırada. Sorgu cisim
// başına dönüyor, yani sıcak yol: burada `Ent3` kopyalamak ölçüldü ve
// pahalıydı. Struct kopyası zaten bu depoda bir kez zemin sorgusunu O(n²)
// yapmıştı; aynı tuzağa ikinci kez düşüldü ve ölçüm gösterdi.
//
// 120 kare, platform/cisim sayısına göre (ms):
//     sorgu yok    struct kopyalı    düz dizili
//   50/200   101         222              121
//  200/400   235        1181              386
//  400/600   385        3201              802
//
// Kalan yük hâlâ O(cisim × platform): 400 platformluk bir sahnede kare
// başına ~6.7 ms. Oynanabilir ama bedava değil; bir sahne o ölçeğe çıkarsa
// sıradaki adım ızgaraya (`_grid_near3`) taşımak.
array _pl_top3  = [];   // üst yüzey y'si
array _pl_pdy3  = [];   // bu karedeki y değişimi
array _pl_x3    = [];   array _pl_z3   = [];
array _pl_hx3   = [];   array _pl_hz3  = [];
array _pl_yaw3  = [];

// `_plat_top3`in seçtiği platform. Desteği kaydetmek için: taşıma bir sonraki
// karede HANGİ platformun hareket ettiğini bilmek zorunda.
int _plat_hit3 = 0 - 1;

func _plat_arrays3(n) {
    while (length(_plat_lasty3) < n) {
        push(_plat_lasty3, 0.0);
        push(_plat_dy3, 0.0);
        push(_plat_seen3, 0);
        push(_e_sup3, 0 - 1);
    }
}

func _plat_index3() {
    _plati3 = [];
    _pl_top3 = []; _pl_pdy3 = [];
    _pl_x3 = []; _pl_z3 = []; _pl_hx3 = []; _pl_hz3 = []; _pl_yaw3 = [];
    int n = length(_e3);
    _plat_arrays3(n);
    int i = 0;
    while (i < n) {
        Ent3 e = _e3[i];
        // RAMPA ayrı sorguda (eğimli üstü var); KÜRE dışarıda, bir kürenin
        // "üstü" tek nokta — üzerinde durmak anlamlı değil ve MTV zaten
        // yuvarlak gövdeleri kendi çözüyor.
        if (e.alive == 1 && e.solid == 1 && e.tag == TAG_WALL &&
            e.shape != SHAPE_RAMP && e.shape != SHAPE_SPHERE) {
            // İlk kare: değişim SIFIR. Yoksa bayat bir `lasty` (ya da yeni
            // slotun 0.0'ı) koca bir sıçrama gibi görünür ve üstündeki her
            // şeyi fırlatırdı.
            float dy = 0.0;
            if (_plat_seen3[i] == 1) { dy = e.y - _plat_lasty3[i]; }
            _plat_dy3[i] = dy;
            _plat_lasty3[i] = e.y;
            _plat_seen3[i] = 1;
            push(_plati3, i);
            push(_pl_top3, e.y + e.sy * 0.5);
            push(_pl_pdy3, dy);
            push(_pl_x3, e.x);   push(_pl_z3, e.z);
            push(_pl_hx3, e.sx * 0.5);  push(_pl_hz3, e.sz * 0.5);
            push(_pl_yaw3, e.yaw);
        } else {
            _plat_dy3[i] = 0.0;
            _plat_seen3[i] = 0;
        }
        i = i + 1;
    }
}

// Nokta kutunun XZ izdüşümünde mi? Dönük kutu için nokta kutunun YEREL
// çerçevesine taşınıyor — dönüş ifadesi `_seg_aabb3` ile BİREBİR aynı;
// ikisi ayrışırsa "üstünde durabildiğin yer" ile "ışının çarptığı yer"
// farklı hacimler olurdu.
// `j` = DİZİN sırası (entity slotu değil) — düz dizilerden okuyor.
func _plat_in_xz3(j, px, pz): bool {
    float rx = px - _pl_x3[j];
    float rz = pz - _pl_z3[j];
    float yw = _pl_yaw3[j];
    if (abs_f3(yw) > 0.01) {
        float c = cos(yw * DEG2RAD3);
        float sn = sin(yw * DEG2RAD3);
        float nrx = rx * c - rz * sn;
        float nrz = rx * sn + rz * c;
        rx = nrx; rz = nrz;
    }
    if (abs_f3(rx) > _pl_hx3[j]) { return false; }
    if (abs_f3(rz) > _pl_hz3[j]) { return false; }
    return true;
}

// Ayağın ALTINDA kalan en yüksek platform üstü.
//
// `onceki_alt` = entity'nin bu kareye BAŞLARKENki alt yüzeyi. Şimdiki değil:
// yandan bir platforma yürüyen cisim yükseğe ışınlanmamalı, ve hızlı düşen
// cisim ince platformu delip geçmemeli. İkisini ayıran tek şey "kareye
// yüzeyin ÜSTÜNDE mi başladı" sorusu.
func _plat_top3(px, pz, onceki_alt, base): float {
    float best = base;
    _plat_hit3 = 0 - 1;
    int m = length(_plati3);
    // Platformsuz sahne burada biter: tek bir uzunluk okuması.
    int j = 0;
    while (j < m) {
        float top = _pl_top3[j];
        // "Üstünde miydi" sorusu platformun KARE BAŞINDAKİ üstüne soruluyor,
        // şimdikine değil. İki hareket de sayılmalı: cisim düşerken yüzeyi
        // geçebiliyor, ama YÜKSELEN platform da cismin içinden geçebiliyor —
        // ve ikincisi ölçülene kadar gözden kaçtı: şablondaki salınan
        // platform, üstündeki altını yukarı çıkarken yutup geçiyordu, altın
        // da dibe kadar düşüyordu. Testi yalnız cismin hareketine sormak
        // asimetrikti.
        float onceki_ust = top - _pl_pdy3[j];
        // İki kabul yolu:
        //   (a) cisim kareye yüzeyin ÜSTÜNDE başladı — temiz hâl.
        //   (b) SIĞ TEMAS: yüzeyin biraz altında ama _PLAT_SKIN3'ten daha az.
        //
        // (b) şart, çünkü bir platformun ilk karedeki hareketi ÖLÇÜLEMİYOR
        // (değişim ancak iki kare arasında bilinir). Salınan platformun
        // üstünde tam yüzeyde duran altın o ilk karede 0.1 birim içeride
        // kalıyor ve (a) bir daha asla tutmuyordu: platform yükselirken
        // altını yutup geçiyor, altın dibe düşüyordu.
        //
        // BEDELİ, açıkça: _PLAT_SKIN3 kadar bir BASAMAK. Bu yükseklikteki bir
        // kenara yandan yürüyen cisim üstüne çıkar. 0.15 birim — takılmayı
        // önleyecek kadar küçük, ışınlanma gibi görünmeyecek kadar da.
        bool ustunde = onceki_ust <= onceki_alt + 0.001;
        bool sig_temas = onceki_alt < onceki_ust && onceki_ust - onceki_alt < _PLAT_SKIN3;
        if (top > best && (ustunde || sig_temas)) {
            if (_plat_in_xz3(j, px, pz)) { best = top; _plat_hit3 = _plati3[j]; }
        }
        j = j + 1;
    }
    return best;
}

func _ramp_index3() {
    _rampi3 = [];
    int n = length(_e3);
    int i = 0;
    while (i < n) {
        Ent3 e = _e3[i];
        if (e.alive == 1 && e.shape == SHAPE_RAMP) { push(_rampi3, i); }
        i = i + 1;
    }
}

func _ramp_floor3(px, pz, base): float {
    float best = base;
    int m = length(_rampi3);
    // Rampasız sahne (çoğu sahne) burada biter: tek bir uzunluk okuması.
    int j = 0;
    while (j < m) {
        int i = _rampi3[j];
        Ent3 e = _e3[i];
        if (e.alive == 1 && e.shape == SHAPE_RAMP) {
            float h = _ramp_h3(i, px, pz);
            if (h > best) { best = h; }
        }
        j = j + 1;
    }
    return best;
}

// --- Gerçek arazi (Faz 10) --------------------------------------------------
// Rampa dünyayı düz düzlemden kurtardı ama sınırlıydı (kama entity'leri,
// kademeli çizim). Arazi gerçek çözüm: yükseklik haritasından üretilmiş TEK
// mesh, her (x,z) için sürekli yükseklik. XZ'de dünya merkezinde ORTALI.
//
// Model handle'ı -1 olabilir: yükseklik verisi CPU'da, mesh ise GPU'da yaşıyor,
// dolayısıyla pencere yokken (headless test) fizik çalışır ama çizim olmaz.
int   _terr_on = 0;
int   _terr_model = 0 - 1;
float _terr_sx = 0.0;
float _terr_sz = 0.0;
int   _terr_color = 0;

// Prosedürel arazi (Perlin) — asset dosyası gerekmez.
// res: yükseklik haritası çözünürlüğü, sx/sz: ayak izi, sy: en yüksek tepe,
// scale: gürültü ölçeği (küçük = geniş tepeler), seed: tohum.
// Son arazi çağrısının parametreleri. Katman boyaması mesh ÜRETİM anında
// uygulanıyor, yani "önce katman, sonra arazi" sırası zorunlu olurdu — bu
// sessiz bir tuzak (yanlış sırada hiçbir şey olmaz, hata da vermez). Onun
// yerine parametreleri saklıyoruz ve katman değişince araziyi yeniden
// kuruyoruz: sıra artık önemsiz.
int   _terr_kind3 = 0;      // 0 = yok, 1 = prosedürel, 2 = dosya
int   _terr_res3  = 0;
float _terr_sy3   = 0.0;
float _terr_scale3 = 0.0;
int   _terr_seed3 = 0;
str   _terr_path3 = "";

func terrain3d(res, sx, sy, sz, scale, seed) {
    _terr_kind3 = 1;
    _terr_res3 = res; _terr_sy3 = sy * 1.0;
    _terr_scale3 = scale * 1.0; _terr_seed3 = seed;
    _terr_model = terrain_gen3d(res, sx, sy, sz, _ground_y, scale, seed);
    _terr_on = 1;
    _terr_sx = sx * 1.0;
    _terr_sz = sz * 1.0;
    _terr_color = rgb(96, 132, 88);
}

// Gri tonlamalı yükseklik haritası dosyasından.
func terrain_file3d(path, sx, sy, sz) {
    _terr_kind3 = 2;
    _terr_path3 = path; _terr_sy3 = sy * 1.0;
    _terr_model = terrain_load3d(path, sx, sy, sz, _ground_y);
    _terr_on = 1;
    _terr_sx = sx * 1.0;
    _terr_sz = sz * 1.0;
    _terr_color = rgb(96, 132, 88);
}

// ---- Su yüzeyi -------------------------------------------------------------
// Arazi geldiğinden beri vadiler kuruydu. Su, dünya çapında tek bir YATAY
// düzlem: göl/deniz seviyesi. Arazinin altında kalan her yer sular altında.
//
// Saydam çizilebilmesi bir ön koşula bağlıydı — ışık shader'ı alfayı eziyordu
// (bkz. CHANGELOG). Düzeltilene kadar su opak bir levha olarak görünürdü.
int   _water_on3    = 0;
float _water_y3     = 0.0;
int   _water_col3   = 0;
int   _water_a3     = 150;     // alfa (0-255)
int   _water_phys3  = 1;       // yüzme fiziği
float _water_grav3  = 0.30;    // suda yerçekimi çarpanı (kaldırma kuvveti yerine)
float _water_drag3  = 2.6;     // sürtünme katsayısı (1/sn)
float _water_swim3  = 0.55;    // zıplama kuvvetinin suda kalan oranı

// Suyu aç: y = su seviyesi (dünya Y'si).
func water3d(y) {
    _water_on3 = 1;
    _water_y3 = y * 1.0;
    if (_water_col3 == 0) { _water_col3 = rgb(40, 110, 170); }
}
func su3d(y) { water3d(y); }
func water_off3d() { _water_on3 = 0; }
func su_kapat3d() { water_off3d(); }
func water_color3d(c, alpha) { _water_col3 = c; _water_a3 = alpha; }
func su_renk3d(renk, alfa) { water_color3d(renk, alfa); }
func water_level3d(): float { return _water_y3; }
func su_seviyesi3d(): float { return water_level3d(); }
func water_physics3d(on) { if (on) { _water_phys3 = 1; } else { _water_phys3 = 0; } }
func su_fizigi3d(ac) { water_physics3d(ac); }

// Bir NOKTA suyun altında mı?
func under_water_at3d(x, y, z): bool {
    if (_water_on3 == 0) { return false; }
    return y < _water_y3;
}
// Bir ENTITY suya girmiş mi? Ölçü MERKEZ: yarı bel hizası. Ayak ucu ölçüsü
// su kenarında yürürken sürekli açılıp kapanırdı.
func under_water3d(id): bool {
    if (_water_on3 == 0) { return false; }
    int s = _slot_of3(id);
    if (s < 0) { return false; }
    Ent3 e = _e3[s];
    return e.y < _water_y3;
}
func su_altinda3d(id): bool { return under_water3d(id); }

// ---- Arazi katmanları (çim / toprak / kar + eğimde kaya) -------------------
// Arazi tek renkti. Yükseklik ve eğim zaten fizikte kullanılıyordu; katman
// boyama o veriyi mesh'in tepe noktalarına renk olarak yazıyor.
//
// Katman boyanınca çizim tinti BEYAZA çekiliyor: `_terr_color` tepe renginin
// üstüne çarpılıyor, yeşil bir tint bütün katmanları yeşile boyardı.
int LAYER_LOW  = 0;   // çim
int LAYER_MID  = 1;   // toprak
int LAYER_HIGH = 2;   // kar
int LAYER_ROCK = 3;   // kaya (yükseklikten değil, EĞİMDEN)

int _terr_lay3 = 0;

// Adlar tame'inkilerden AYRI (`terrain_layers3d` orada duruyor ve scene3d onu
// import ediyor): burada yapılan iş fazladan — tint'i beyaza çekmek ve
// araziyi yeniden kurmak.
// Boya parametreleri tame'e gidiyor ve orada okunamıyor — sahne biçimi
// (SCENE_V3) bunları geri yazabilmek için burada da saklıyor.
int   _terr_pl3  = 0;   int   _terr_pm3  = 0;
int   _terr_ph3  = 0;   int   _terr_pr3  = 0;
float _terr_pmy3 = 0.0; float _terr_phy3 = 0.0; float _terr_prs3 = 0.0;

func terrain_paint3d(low, mid, high, rock, mid_y, high_y, rock_slope) {
    terrain_layers3d(low, mid, high, rock, mid_y, high_y, rock_slope);
    _terr_pl3 = low; _terr_pm3 = mid; _terr_ph3 = high; _terr_pr3 = rock;
    _terr_pmy3 = mid_y * 1.0; _terr_phy3 = high_y * 1.0; _terr_prs3 = rock_slope * 1.0;
    _terr_lay3 = 1;
    _terr_color = WHITE;
    _s3_terrain_rebuild();
}
func arazi_boya3d(alt, orta, ust, kaya, orta_y, ust_y, egim) {
    terrain_paint3d(alt, orta, ust, kaya, orta_y, ust_y, egim);
}

// Varsayılan palet — tek satırla makul bir dağ manzarası. Eşikler en yüksek
// tepenin oranı olarak veriliyor, yani arazinin boyu değişince manzara
// bozulmuyor.
//
// 0.35 / 0.62 ÖLÇÜLEREK seçildi, göz kararı değil: Perlin gürültüsü pratikte
// 255'e (yani tam `sy`'ye) çıkmıyor, tepe genelde sy'nin %80'i civarında
// kalıyor. Oranları doğrudan sy'ye göre yüksek tutmak karı "en uç iki noktaya"
// düşürüyordu. Bu değerler üç ayrı tohumda da dengeli dağılım veriyor
// (~%10 çim, ~%35 toprak, ~%10 kar, gerisi eğimden kaya).
func terrain_natural3d(peak_y) {
    terrain_paint3d(rgb(96, 132, 88), rgb(124, 116, 82),
                    rgb(238, 242, 250), rgb(112, 110, 106),
                    peak_y * 0.35, peak_y * 0.62, 42.0);
}
func arazi_dogal3d(tepe_y) { terrain_natural3d(tepe_y); }

func terrain_paint_off3d() {
    terrain_layers_off3d();
    _terr_lay3 = 0;
    _terr_color = rgb(96, 132, 88);
    _s3_terrain_rebuild();
}
func arazi_boya_kapat3d() { terrain_paint_off3d(); }

// Araziyi aynı parametrelerle yeniden kur. Katman ayarı mesh'e yazıldığı için
// değişikliğin görünmesinin tek yolu bu; arazi henüz kurulmadıysa hiçbir şey
// yapmaz (sonraki terrain3d zaten yeni ayarla üretilir).
func _s3_terrain_rebuild() {
    if (_terr_kind3 == 1) {
        _terr_model = terrain_gen3d(_terr_res3, _terr_sx, _terr_sy3, _terr_sz,
                                    _ground_y, _terr_scale3, _terr_seed3);
    } else {
        if (_terr_kind3 == 2) {
            _terr_model = terrain_load3d(_terr_path3, _terr_sx, _terr_sy3,
                                         _terr_sz, _ground_y);
        }
    }
}

// Sorgu için ayrı sarmalayıcı YOK: tame'in `terrain_layer3d(x,z)` /
// `arazi_katmani3d(x,z)` fonksiyonları scene3d üzerinden zaten kapsamda
// (terrain_height3d de böyle çalışıyor).

func terrain_color3d(c) { _terr_color = c; }
func terrain_off3d_scene() { _terr_on = 0; terrain_off3d(); }

// (x,z) noktasındaki zemin: arazi varsa onun yüzeyi, yoksa düz zemin.
// Rampalar HER İKİ durumda da üstüne binebilir (bkz. _ramp_floor3).
func _floor_at3(px, pz): float {
    float base = _ground_y;
    if (_terr_on == 1) { base = terrain_height3d(px, pz); }
    return _ramp_floor3(px, pz, base);
}

// ---- Arazi eğimi: yüzey normali, eğim sınırı, kayma ------------------------
//
// AYRI BİR C BINDING'İ GEREKMİYOR. STATUS.md `tm3_terrain_normal` öneriyordu,
// ama `terrain_height3d` zaten mesh'in üçgenlemesini birebir taklit ediyor —
// komşu örneklerden merkezi farkla türetilen normal yüzeyin GERÇEK eğimini
// veriyor. Saf Tulpar yol hem 5 noktalık bağlamayı hem de wasm/android
// arşivlerini yeniden derlemeyi tamamen atlıyor, ve üç hedefte de anında çalışır.
//
// Merkezi fark hücre sınırlarını yumuşatıyor: üçgen bazlı kesin normal keskin
// sıçrardı ve kayma titrerdi. Oynanış için istenen tam da bu yumuşama.
float _tn_x = 0.0; float _tn_y = 1.0; float _tn_z = 0.0;
float _TN_EPS3 = 0.5;      // örnekleme adımı (dünya birimi)

func _terrain_normal3(px, pz) {
    if (_terr_on == 0) { _tn_x = 0.0; _tn_y = 1.0; _tn_z = 0.0; return; }
    float e = _TN_EPS3;
    float hl = terrain_height3d(px - e, pz);
    float hr = terrain_height3d(px + e, pz);
    float hd = terrain_height3d(px, pz - e);
    float hu = terrain_height3d(px, pz + e);
    float nx = hl - hr;
    float ny = 2.0 * e;
    float nz = hd - hu;
    float len = sqrt(nx * nx + ny * ny + nz * nz);
    if (len < 0.000001) { _tn_x = 0.0; _tn_y = 1.0; _tn_z = 0.0; return; }
    _tn_x = nx / len; _tn_y = ny / len; _tn_z = nz / len;
}

// Yüzeyin "düzlüğü": normalin Y bileşeni, yani eğim açısının KOSİNÜSÜ.
// 1.0 = tam düz, 0.0 = dik duvar. Derece yerine kosinüs veriliyor çünkü dilde
// `acos` yok ve karşılaştırma zaten kosinüs üzerinden yapılıyor — açıya
// çevirip geri dönmek hem gereksiz hem kayıplı olurdu.
func terrain_up3d(px, pz): float { _terrain_normal3(px, pz); return _tn_y; }
func arazi_duzluk3d(px, pz): float { return terrain_up3d(px, pz); }

// Eğim sınırı DERECE cinsinden; 0 = kapalı (varsayılan).
// Kapalı gelmesi bilerek: eğim sınırı doğruluk değil TASARIM tercihi — bazı
// oyunlar serbest tırmanma ister. Açan sahne davranışı seçmiş olur, açmayan
// sahne bit-bit eskisi gibi çalışır.
float _slope_lim3 = 0.0;
float _slope_cos3 = 0.0;
float _slide_acc3 = 18.0;   // yamaç aşağı ivme (birim/sn²)

func slope_limit3d(deg) {
    _slope_lim3 = deg;
    if (deg <= 0.0) { _slope_cos3 = 0.0; return; }
    _slope_cos3 = cos(deg * DEG2RAD3);
}
func egim_siniri3d(derece) { slope_limit3d(derece); }
func slide_accel3d(a) { _slide_acc3 = a; }
func kayma_ivmesi3d(a) { slide_accel3d(a); }

// Bu nokta tırmanılamayacak kadar dik mi? Sınır kapalıyken hep false.
func terrain_steep3d(px, pz): bool {
    if (_slope_lim3 <= 0.0 || _terr_on == 0) { return false; }
    return terrain_up3d(px, pz) < _slope_cos3;
}
func arazi_dik_mi3d(px, pz): bool { return terrain_steep3d(px, pz); }

// Rampa üret: yerel +Z yönünde yükselir, yaw ile döndürülür.
func ramp3d(x, y, z, sx, sy, sz, color, yaw): int {
    int id = spawn3(x, y, z, sx, sy, sz, color, SHAPE_RAMP, TAG_PROP);
    int s = _slot_of3(id);
    Ent3 e = _e3[s];
    e.yaw = yaw;
    // GERÇEK kama mesh'i. Eskiden rampa 12 kademeli kutu olarak çiziliyordu:
    // fizik analitik eğimi kullandığı için yürüyüş pürüzsüzdü ama görüntü
    // merdivendi. Mesh boyutu rampayla birlikte üretiliyor (ölçek 1.0 ile
    // çizilecek), çünkü model çizimi tek ölçek alıyor ve rampaların üç
    // boyutu birbirinden bağımsız.
    //
    // Pencere yoksa (headless test) -1 döner ve çizim eski kademeli yola
    // düşer — motorun penceresiz sınanabilirliği korunuyor.
    e.model = gen_wedge(sx, sy, sz);
    // Dizine ekle: fizik henüz koşmamışken de (kurulum sırasında)
    // `zemin_yukseklik3d` doğru cevap versin.
    push(_rampi3, s);
    // Rampa katı DEĞİL: üzerine basılır (zemin yüksekliğiyle), itilmez. Katı
    // olsaydı kutu gövdesi eğik yüzeyle çelişir, oyuncuyu yandan dışarı iterdi.
    e.solid = 0;
    _e3[s] = e;
    return id;
}

// Mermi kendi sahibine çarpmaz. Bu olmadan hem oyuncunun hem düşmanın ateş
// ettiği bir oyunda herkes kendi mermisiyle vurulurdu (mermi gövdenin hemen
// önünde doğuyor). Sahip HANDLE olarak saklı, karşılaştırma slot üzerinden:
// sahip ölüp slot geri kullanılırsa bayat handle yanlış eşleşme yapmaz.
func _bullet_owner_pair3(a, b): bool {
    Ent3 ea = _e3[a];
    if (ea.tag == TAG_BULLET && _slot_of3(ea.owner) == b) { return true; }
    Ent3 eb = _e3[b];
    if (eb.tag == TAG_BULLET && _slot_of3(eb.owner) == a) { return true; }
    return false;
}

// --- Geniş faz (broad phase) ------------------------------------------------
// Çarpışma her kare tüm çiftleri geziyor ve her çift için _overlap3 / _mtv3
// çağırıyordu. Ölçüm (200 entity = 40.000 çift, headless): boş döngü ~0 ms,
// çift başına iki struct kopyası 1.8 ms, gerçek _overlap3 **23.7 ms**. Yani
// maliyet dizide değil, ZİNCİRİN KENDİSİNDE: şekil seçimi, `Ent3`i değerle
// alan yardımcılar (_is_round3, _radius3) ve tekrar tekrar dizi okuması.
//
// O yüzden çözüm zinciri hızlandırmak değil, ÇAĞIRMAMAK. Kareye bir kez düz
// float dizilerine konum + KAPSAYAN KÜRE yarıçapı yazılır; iki kürenin ayrık
// olduğu çiftler zincire hiç girmez.
//
// Yarıçap kutunun KÖŞEGEN YARISI. Bu üç şeklin de üstünü örtüyor ve eleme bu
// yüzden korumalı — gerçek bir çakışmayı asla atmaz:
//   • kutu   → köşegen yarısı kutuyu tanımı gereği kapsar, yaw'dan bağımsız
//              (döndürme kürenin yarıçapını değiştirmez, OBB/SAT de güvende)
//   • küre   → yarıçapı sx*0.5, köşegen yarısı ondan büyük
//   • silindir → XZ'de sx*0.5, Y'de sy; Minkowski eşitsizliği gereği
//              sqrt(dxz²+dy²) ≤ Ra+Rb olduğunda çakışma zaten mümkün değil
//
// Diziler YALNIZCA eleme için. alive/tag/solid kararları hâlâ `_e3`ten
// okunuyor: bir kanca ortasında kill3d/spawn3 çağırırsa otorite tek yerde
// kalsın istiyoruz. Konum ise elemeyi doğrudan etkilediği için üç mutasyon
// noktasında (_apply_mtv3, set3pos, _alloc_slot3) senkron tutuluyor.
array _bx = [];
array _by = [];
array _bz = [];
array _br = [];

func _bp_build3() {
    _bx = []; _by = []; _bz = []; _br = [];
    int n = length(_e3);
    int i = 0;
    while (i < n) {
        Ent3 e = _e3[i];
        push(_bx, e.x); push(_by, e.y); push(_bz, e.z);
        float hx = e.sx * 0.5; float hy = e.sy * 0.5; float hz = e.sz * 0.5;
        push(_br, sqrt(hx * hx + hy * hy + hz * hz));
        i = i + 1;
    }
}

// Tek slot'u tazele. Diziler kurulu değilken (çarpışma dışında) sessizce çıkar,
// böylece spawn3/set3pos normal akışta hiçbir bedel ödemez.
func _bp_sync3(s) {
    if (s < 0 || s >= length(_bx)) { return; }
    Ent3 e = _e3[s];
    _bx[s] = e.x; _by[s] = e.y; _bz[s] = e.z;
    float hx = e.sx * 0.5; float hy = e.sy * 0.5; float hz = e.sz * 0.5;
    _br[s] = sqrt(hx * hx + hy * hy + hz * hz);
}

// --- Uniform ızgara ---------------------------------------------------------
// Kapsayan küre elemesi çift BAŞINA ucuzdu ama çiftlerin SAYISI hâlâ n²'ydi:
// `_bp_far3` her kare n² kez çağrılıyordu. Ölçüm (headless, 120 kare
// ortalaması, ms/kare):
//
//     100 →  0.99      400 → 15.94   (60 fps bütçesi 16.7 ms — ZATEN AŞILDI)
//     200 →  3.72      800 → 69.43
//                     1600 → 470.4   (n²'nin bile üstünde)
//
// Yani gerçek eşik ~300 entity, TODO'nun tahmin ettiği 800 değil. 400'de oyun
// 60 fps tutamıyor. Izgara bu yüzden yazıldı.
//
// Hücre kenarı = en büyük kapsayan küre ÇAPI. Bu seçim taramayı KORUMALI
// yapıyor: iki cisim çakışıyorsa merkezleri arası mesafe yarıçapları
// toplamından küçüktür, o da bir hücre kenarını aşamaz — dolayısıyla en fazla
// KOMŞU hücrededirler ve 3×3 taraması hiçbir gerçek çakışmayı kaçırmaz.
//
// Izgara SARMALI (mod _GC): dünya ne kadar büyük olursa olsun hücre sayısı
// sabit kalıyor, yani seyrek yayılmış bir sahne bellekte patlamıyor. Sarma
// yalnız UZAK cisimleri aynı kovaya düşürebilir — bu fazladan dar-faz
// sorgusudur, kaçırma değil. Aynı cismin listede İKİ KEZ görünmesi mümkün
// değil: her cisim tam bir kovada ve 3×3'ün dokuz indeksi _GC ≥ 3 iken
// birbirinden farklı.
//
// Kovalar her kare TEMİZLENMİYOR: her kovada bir kare damgası var, damga eski
// ise kova boş sayılıyor. 4096 yazımı kareden silmek için.
int _GC = 64;                  // ızgara kenarı (hücre)
float _gcell = 4.0;            // hücre kenarı (dünya birimi) — her kare türetilir
array _ghead = [];             // _GC*_GC — kovadaki ilk slot, -1 boş
array _gstamp = [];            // kovanın hangi karede yazıldığı
array _gnext = [];             // slot → aynı kovadaki bir sonraki slot
int _gframe = 0;
array _gnear = [];             // yeniden kullanılan aday listesi

func _gidx3(cx, cz): int {
    int a = mod(cx, _GC);
    if (a < 0) { a = a + _GC; }
    int b = mod(cz, _GC);
    if (b < 0) { b = b + _GC; }
    return a * _GC + b;
}

func _grid_build3(n) {
    float rmax = 0.0;
    int i = 0;
    while (i < n) {
        if (_br[i] > rmax) { rmax = _br[i]; }
        i = i + 1;
    }
    _gcell = rmax * 2.0;
    // Taban: hepsi noktasal olsa hücre kenarı 0 olur ve bölme patlardı.
    if (_gcell < 0.5) { _gcell = 0.5; }
    _gframe = _gframe + 1;

    int cells = _GC * _GC;
    if (length(_ghead) != cells) {
        _ghead = []; _gstamp = [];
        int k = 0;
        while (k < cells) {
            push(_ghead, 0 - 1);
            push(_gstamp, 0);
            k = k + 1;
        }
    }
    if (length(_gnext) < n) {
        _gnext = [];
        int k2 = 0;
        while (k2 < n) { push(_gnext, 0 - 1); k2 = k2 + 1; }
    }

    i = 0;
    while (i < n) {
        int c = _gidx3(toInt(floor(_bx[i] / _gcell)),
                       toInt(floor(_bz[i] / _gcell)));
        if (_gstamp[c] != _gframe) {
            _gstamp[c] = _gframe;
            _ghead[c] = 0 - 1;
        }
        _gnext[i] = _ghead[c];
        _ghead[c] = i;
        i = i + 1;
    }
}

// `a`nın 3×3 komşuluğundaki adayları `_gnear`e doldurur. Liste `a`yı da
// içerir; çağıranlar zaten kendini eliyor.
func _grid_near3(a) {
    _gnear = [];
    int cx = toInt(floor(_bx[a] / _gcell));
    int cz = toInt(floor(_bz[a] / _gcell));
    int dx = 0 - 1;
    while (dx <= 1) {
        int dz = 0 - 1;
        while (dz <= 1) {
            int c = _gidx3(cx + dx, cz + dz);
            if (_gstamp[c] == _gframe) {
                int q = _ghead[c];
                while (q >= 0) {
                    push(_gnear, q);
                    q = _gnext[q];
                }
            }
            dz = dz + 1;
        }
        dx = dx + 1;
    }
}

// true → kapsayan küreler ayrık, çakışma İMKÂNSIZ. Sadece bu yönde karar verir;
// false "çakışıyor" demek değil, "dar faza sor" demektir.
func _bp_far3(a, b): bool {
    float dx = _bx[a] - _bx[b];
    float dy = _by[a] - _by[b];
    float dz = _bz[a] - _bz[b];
    float r = _br[a] + _br[b];
    return dx * dx + dy * dy + dz * dz > r * r;
}

// Hareketli katı gövdeleri DÜNYA GEOMETRİSİNDEN dışarı it. Ayrı bir fonksiyon
// çünkü kare başına İKİ KEZ çalışıyor — gerekçe `_s3_collision` içinde.
func _s3_resolve_walls3(n) {
    // Izgara HER FAZIN BAŞINDA kuruluyor: `_apply_mtv3` cisimleri oynatıyor,
    // yani bir önceki fazın kova ataması bayat. Kurulum O(n), tarama n²'den
    // kurtardığı için bu bedel görünmüyor.
    _grid_build3(n);
    int p = 0;
    while (p < n) {
        Ent3 ep = _e3[p];
        if (_is_solid3(ep) && !_is_static_solid3(ep)) {
            _grid_near3(p);
            int gi = 0;
            int gn = length(_gnear);
            while (gi < gn) {
                int w = _gnear[gi];
                // Eleme struct kopyasından ÖNCE: uzak çift `_e3[w]`i hiç okumaz.
                if (p != w && !_bp_far3(p, w)) {
                    Ent3 ew = _e3[w];
                    if (_is_solid3(ew) && _is_static_solid3(ew)) {
                        if (_mtv3(p, w)) { _apply_mtv3(p, _mtv_x, _mtv_y, _mtv_z); }
                    }
                }
                gi = gi + 1;
            }
        }
        p = p + 1;
    }
}

func _s3_collision() {
    int n = length(_e3);
    _bp_build3();
    // 1) KATI GÖVDE ÇÖZÜMÜ — dünya geometrisine karşı.
    // Eskiden yalnız TAG_PLAYER duvarlarla çarpışıyordu; düşmanlar duvarların
    // içinden geçiyordu. Artık her HAREKETLİ katı gövde (oyuncu, düşman, prop)
    // her STATİK katı gövdeye (duvar) karşı dışarı itiliyor.
    _s3_resolve_walls3(n);
    // 1a) Hareketli katı gövdeler BİRBİRİNE karşı: ikisi de itilebildiği için
    // ayırma yarı yarıya paylaşılır — biri diğerini tek başına itseydi hafif
    // olan sürekli duvara sıkışırdı. Her çift bir kez işlenir (b > a).
    _grid_build3(n);
    int ca = 0;
    while (ca < n) {
        Ent3 ea2 = _e3[ca];
        if (_is_solid3(ea2) && !_is_static_solid3(ea2)) {
            _grid_near3(ca);
            int gj = 0;
            int gm = length(_gnear);
            while (gj < gm) {
                int cb = _gnear[gj];
                // Her çift BİR KEZ: `cb > ca` koşulu ızgarada da aynı işi
                // görüyor (eskiden döngü ca+1'den başlıyordu).
                if (cb > ca && !_bp_far3(ca, cb)) {
                    Ent3 eb2 = _e3[cb];
                    if (_is_solid3(eb2) && !_is_static_solid3(eb2)) {
                        if (_mtv3(ca, cb)) {
                            float hx = _mtv_x * 0.5;
                            float hy = _mtv_y * 0.5;
                            float hz = _mtv_z * 0.5;
                            _apply_mtv3(ca, hx, hy, hz);
                            _apply_mtv3(cb, 0.0 - hx, 0.0 - hy, 0.0 - hz);
                        }
                    }
                }
                gj = gj + 1;
            }
        }
        ca = ca + 1;
    }
    // 1c) DUVARLAR SON SÖZÜ SÖYLER. Bu ikinci geçiş şart: yukarıdaki
    // hareketli-hareketli çözümü oyuncuyu duvarın İÇİNE geri itebiliyor
    // (düşmanlar sıkıştırdığında ayırma yarı yarıya paylaşıldığı için oyuncu
    // duvara doğru yarım adım gidiyor) ve o kare bir daha düzeltilmiyordu.
    // Ölçüldü: 4 düşman baskısında 0.15, 8 düşmanda 0.30 birim kalıcı batma —
    // oyuncu duvarın içinde duruyor, kamera ışını geometrinin içinden başlıyor
    // ve oradan sonrası (kameranın bozulması, ulaşılmaz yerlere çıkma) bunun
    // zinciri. Duvarlar cisimlerden daha otoriter olmalı; sıralama bunu söyler.
    _s3_resolve_walls3(n);

    // 1b) Duvara giren mermi ölür — yoksa duvarların içinden geçip giderdi.
    _grid_build3(n);
    int bi = 0;
    while (bi < n) {
        Ent3 eb2 = _e3[bi];
        if (eb2.alive == 1 && eb2.tag == TAG_BULLET) {
            _grid_near3(bi);
            int gk = 0;
            int gq = length(_gnear);
            while (gk < gq) {
                int w2 = _gnear[gk];
                int died = 0;
                if (!_bp_far3(bi, w2)) {
                    Ent3 ew2 = _e3[w2];
                    if (ew2.alive == 1 && ew2.tag == TAG_WALL && _overlap3(bi, w2)) {
                        kill3d(_mk_handle3(bi));
                        died = 1;
                    }
                }
                if (died == 1) {
                    gk = gq;             // bu mermi bitti, duvar taramasını kes
                } else {
                    gk = gk + 1;
                }
            }
        }
        bi = bi + 1;
    }
    // 2) Kayıtlı çarpışma kancaları: tagA × tagB örtüşürse fn çağır
    // Kanca taraması da ızgaradan geçiyor. Kancalar en pahalı faz: kayıtlı
    // her kanca için ayrı bir n² tarama yapılıyordu ve gerçek oyunlar birkaç
    // kanca kaydediyor (arena 4 tane). Ölçüm bunu doğruladı — ızgara yalnız
    // katı-gövde fazlarına uygulandığında 800 entity hâlâ 19.8 ms sürüyordu.
    //
    // Izgara kanca döngüsünün DIŞINDA bir kez kuruluyor: kancalar konum
    // değiştirmiyor (kanca gövdesi `kill3d`/`hasar3d` çağırıyor, `_apply_mtv3`
    // değil), yani kova ataması bu faz boyunca geçerli kalıyor.
    _grid_build3(n);
    int h = 0;
    int hn = length(_hitA);
    while (h < hn) {
        int ta = _hitA[h];
        int tb = _hitB[h];
        int fn = _hitF[h];
        int a = 0;
        while (a < n) {
            Ent3 ea = _e3[a];
            if (ea.alive == 1 && ea.tag == ta) {
                _grid_near3(a);
                int gh = 0;
                int gz = length(_gnear);
                while (gh < gz) {
                    int b = _gnear[gh];
                    if (a != b && !_bp_far3(a, b)) {
                        Ent3 eb = _e3[b];
                        if (eb.alive == 1 && eb.tag == tb && _overlap_hit3(a, b)
                            && !_bullet_owner_pair3(a, b)) {
                            _hit_me = _mk_handle3(a);
                            _hit_other = _mk_handle3(b);
                            call(fn);
                        }
                    }
                    gh = gh + 1;
                }
            }
            a = a + 1;
        }
        h = h + 1;
    }
    // Veri-kuralların KENDİ taraması (kanca tablosundan bağımsız).
    if (length(_rl3) > 0) { _s3_rule_hits(n); }
}

// ===========================================================================
// Tetikleyici bölge (trigger zone)
// ===========================================================================
// "Buraya girince şu olsun" — kapı, kontrol noktası, tuzak, boss arenası,
// bölüm sonu. Her oyunda lazım olan, kendi başına ucuz olan şey.
//
// Şimdiye kadar `solid3d(id, false)` + `carpisinca3` ile TAKLİT ediliyordu.
// O taklidin iki kusuru vardı ve bu katmanın var olma sebebi ikisi:
//
//   1. Kanca ÇAKIŞTIĞI HER KARE çağrılıyor — saniyede 60 kez. İstenen ise
//      "girince BİR KEZ". Oyunlar bunu kendi bayraklarıyla çözmek zorundaydı
//      ve o bayrak her oyunda yeniden yazılıyordu.
//   2. Bölge bir ENTITY oluyordu: çiziliyor (görünmez yapmak ayrı iş), slot
//      yiyor, geniş faza ve MTV çözümüne giriyor, `alive_count3d()` sayıyor.
//      Görünmez bir işaret için fazla bedel.
//
// Bu katman entity DEĞİL, ayrı düz dizilerde duruyor. Kare başına giriş/çıkış
// KENARI hesaplanıyor: `girince` bir kez, `cikinca` bir kez atar; sürekli
// davranış isteyen `icindeyken` kancasını kullanır (eski taklidin davranışı).
//
// ÜYELİK düz çift listesinde tutuluyor (bölge indeksi × entity handle) —
// iç içe dizi yok. Bölge sayısı da içerideki entity sayısı da pratikte tek
// haneli olduğu için doğrusal tarama en ucuz ve en okunur çözüm.
// ---- Sahne ışıkları (nokta ışık) -------------------------------------------
// `point_light()` motorda vardı ve scene3d onu HİÇ çağırmıyordu: sahnedeki
// tek aydınlatma güneş + ortam ışığıydı, yani bir meşale, bir lamba, bir
// yangın ışık vermiyordu. Sahne biçiminde de yeri yoktu.
//
// MOTOR SINIRI, gizlenmiyor: toplam DÖRT ışık yuvası var ve 0'ı güneş
// kullanıyor, yani aynı anda en çok ÜÇ nokta ışık yanabiliyor. Sahneye
// istediğin kadar lamba koyabilirsin — motor her kare kameraya EN YAKIN
// üçünü seçiyor. Sınırı kullanıcıya "3 tane koyabilirsin" diye dayatmak
// yerine eleme yapmak, ışıklı bir koridorda yürümeyi mümkün kılıyor.
array _lt_x3 = [];   array _lt_y3 = [];   array _lt_z3 = [];
array _lt_col3 = []; array _lt_rng3 = [];

// Motorun serbest yuva sayısı (0 = güneş).
func light_slots3d(): int { return 3; }

// Sahneye nokta ışık ekle → indeks döner.
//
//   light3d(4.0, 3.0, 0.0, GOLD, 12.0);
func light3d(x, y, z, color, range): int {
    push(_lt_x3, x * 1.0); push(_lt_y3, y * 1.0); push(_lt_z3, z * 1.0);
    push(_lt_col3, color);
    float r = range * 1.0;
    if (r <= 0.0) { r = 10.0; }
    push(_lt_rng3, r);
    return length(_lt_x3) - 1;
}
func isik_ekle3d(x, y, z, renk, menzil): int { return light3d(x, y, z, renk, menzil); }

func light_count3d(): int { return length(_lt_x3); }
func light_valid3d(i): bool { return i >= 0 && i < length(_lt_x3); }
func light_x3d(i): float { if (!light_valid3d(i)) { return 0.0; } return _lt_x3[i]; }
func light_y3d(i): float { if (!light_valid3d(i)) { return 0.0; } return _lt_y3[i]; }
func light_z3d(i): float { if (!light_valid3d(i)) { return 0.0; } return _lt_z3[i]; }
func light_color3d(i): int { if (!light_valid3d(i)) { return 0; } return _lt_col3[i]; }
func light_range3d(i): float { if (!light_valid3d(i)) { return 0.0; } return _lt_rng3[i]; }

func light_move3d(i, x, y, z): int {
    if (!light_valid3d(i)) { return 0; }
    _lt_x3[i] = x * 1.0; _lt_y3[i] = y * 1.0; _lt_z3[i] = z * 1.0;
    return 1;
}
func light_set_color3d(i, c): int {
    if (!light_valid3d(i)) { return 0; }
    _lt_col3[i] = c;
    return 1;
}
func light_set_range3d(i, r): int {
    if (!light_valid3d(i)) { return 0; }
    if (r > 0.0) { _lt_rng3[i] = r * 1.0; }
    return 1;
}

// Işığı sil. Diziler SIRAYI KORUYARAK kayıyor: indeksler sahne dosyasında
// ve editör seçiminde kullanılıyor, son elemanı yerine takas etmek
// (entity deposundaki hızlı yol) burada yanlış ışığı seçili bırakırdı.
func light_del3d(i): int {
    if (!light_valid3d(i)) { return 0; }
    int n = length(_lt_x3);
    int k = i;
    while (k < n - 1) {
        _lt_x3[k] = _lt_x3[k + 1]; _lt_y3[k] = _lt_y3[k + 1]; _lt_z3[k] = _lt_z3[k + 1];
        _lt_col3[k] = _lt_col3[k + 1]; _lt_rng3[k] = _lt_rng3[k + 1];
        k = k + 1;
    }
    pop(_lt_x3); pop(_lt_y3); pop(_lt_z3); pop(_lt_col3); pop(_lt_rng3);
    return 1;
}
func isik_sil3d(i): int { return light_del3d(i); }

// Dinleyici (kamera hedefi) konumuna göre ışığın "yakınlık" ölçüsü — küçük
// olan önce seçiliyor. MENZİLE bölünüyor: geniş menzilli bir ışık uzaktan da
// sahneye katkı verir, dar menzilli bir mum vermez. Ham mesafeyle sıralamak
// yanı başındaki mumu uzaktaki projektöre tercih ederdi.
func _lt_score3(i, cx, cy, cz): float {
    float dx = _lt_x3[i] - cx;
    float dy = _lt_y3[i] - cy;
    float dz = _lt_z3[i] - cz;
    return sqrt(dx * dx + dy * dy + dz * dz) / _lt_rng3[i];
}

// En yakın N ışığın indekslerini seç (N = serbest yuva sayısı).
// Seçim sonucu ayrı: yükleme yapmadan, penceresiz sınanabilsin diye —
// `_snd_vol3`/`_plat_top3` ile aynı gerekçe.
array _lt_pick3 = [];

func _lt_select3(cx, cy, cz) {
    _lt_pick3 = [];
    int n = length(_lt_x3);
    int slots = light_slots3d();
    array kullanildi = [];
    int i = 0;
    while (i < n) { push(kullanildi, 0); i = i + 1; }
    int s = 0;
    while (s < slots && s < n) {
        int en_iyi = 0 - 1;
        float en_iyi_p = 0.0;
        i = 0;
        while (i < n) {
            if (kullanildi[i] == 0) {
                float p = _lt_score3(i, cx, cy, cz);
                if (en_iyi < 0 || p < en_iyi_p) { en_iyi = i; en_iyi_p = p; }
            }
            i = i + 1;
        }
        if (en_iyi < 0) { return; }
        kullanildi[en_iyi] = 1;
        push(_lt_pick3, en_iyi);
        s = s + 1;
    }
}

// Seçimi motora yükle. Kullanılmayan yuvalar KAPATILIYOR: bırakılırsa
// oyuncu uzaklaşınca ışık olduğu yerde yanmaya devam ederdi.
// k. yuvaya HANGİ ışık gidiyor (-1 = yuva KAPATILACAK). Yüklemeden ayrı,
// çünkü `point_light`/`light_off` motor çağrıları penceresiz hiçbir şey
// yapmıyor — karar sınanabilir olmalı. (`_snd_vol3`, `_plat_top3`,
// `_lt_select3` ile aynı gerekçe.)
func _lt_slot_light3(k): int {
    if (k < 0 || k >= light_slots3d()) { return 0 - 1; }
    if (k >= length(_lt_pick3)) { return 0 - 1; }
    return _lt_pick3[k];
}

func _lt_upload3() {
    float cx = 0.0; float cy = 0.0; float cz = 0.0;
    int ct = _slot_of3(_cam_target);
    if (ct >= 0) {
        Ent3 t = _e3[ct];
        cx = t.x; cy = t.y; cz = t.z;
    }
    _lt_select3(cx, cy, cz);
    int slots = light_slots3d();
    int k = 0;
    while (k < slots) {
        int li = _lt_slot_light3(k);
        // Yuva 0 GÜNEŞİN: nokta ışıklar 1'den başlıyor.
        if (li >= 0) {
            point_light(k + 1, _lt_x3[li], _lt_y3[li], _lt_z3[li], _lt_col3[li]);
        } else {
            // Boş yuva KAPATILMALI: bırakılırsa oyuncu uzaklaşınca o ışık
            // olduğu yerde yanmaya devam eder.
            light_off(k + 1);
        }
        k = k + 1;
    }
}

array _trg_x = [];   array _trg_y = [];   array _trg_z = [];
array _trg_sx = [];  array _trg_sy = [];  array _trg_sz = [];  // TAM boy (entity ile aynı sözleşme)
array _trg_r = [];        // küre bölgenin yarıçapı
array _trg_shape = [];    // 0 = kutu, 1 = küre
array _trg_tag = [];      // izlenen etiket
array _trg_on = [];       // 1 = etkin
array _trg_once = [];     // 1 = ilk girişten sonra kendini kapat
array _trg_fin = [];   array _trg_hasin = [];    // girince
array _trg_fout = [];  array _trg_hasout = [];   // çıkınca
array _trg_fstay = []; array _trg_hasstay = [];  // içindeyken (her kare)

// ---- Bölge EYLEMİ (veriyle) -------------------------------------------------
// Bölgeler yalnız KANCAYLA iş görüyordu ve kancalar KOD. Yani editörden
// "+ bölge" eklemek, hiçbir şey yapmayan bir kutu koymaktı: konumunu, boyunu,
// etiketini ayarlayabiliyordun ama sahne dosyasında "buraya girince şu olsun"
// diyecek bir yer yoktu. Veriyle kurulmuş bir oyunda bölgeler tümüyle ölüydü.
//
// Eylem listesi ÇARPIŞMA KURALLARININKİNDEN AYRI ve bilerek: kural eylemleri
// bir ÇİFT üzerinden konuşuyor ("ötekini öldür"), bölgede öteki YOK — giren
// gövde var. ACT_* sabitlerini burada kullanmak, "topla"nın sessiz boş işlem
// olduğu bir liste üretirdi (bitince kurallarında tam olarak bu oldu ve
// denetim hâlâ o mirası uyarıyor).
int ZACT_NONE   = 0;   // veri eylemi yok — bölge yalnız kancayla çalışır
int ZACT_WIN    = 1;   // kazan
int ZACT_LOSE   = 2;   // kaybet
int ZACT_KILL   = 3;   // GİRENİ öldür (çukur, lav, sınır dışı)
int ZACT_DAMAGE = 4;   // girene hasar (miktar)
int ZACT_SCORE  = 5;   // skor ekle (miktar)
int ZACT_NEXT   = 6;   // sonraki bölüme geç (çıkış kapısı)

array _trg_act = [];   // ZACT_*
array _trg_amt = [];   // eylemin miktarı (hasar / skor)
// Bölgenin sesi. Kuralların sesi vardı, bölgelerinki YOKTU: "çıkış kapısına
// vardın" ve "çukura düştün" sessizdi — oysa geri bildirimin en çok gerektiği
// an tam olarak o.
array _trg_snd = [];

array _trg_in_t = [];     // üyelik: bölge indeksi
array _trg_in_e = [];     // üyelik: içerideki entity handle
int   _trg_cur3 = 0 - 1;  // kanca içinde: hangi bölge tetikledi
int   _trg_show3 = 0;     // ayıklama çizimi (bölgeler normalde görünmez)

func _trg_new3(shape, x, y, z, sx, sy, sz, r, tag): int {
    push(_trg_shape, shape);
    push(_trg_x, x); push(_trg_y, y); push(_trg_z, z);
    push(_trg_sx, sx); push(_trg_sy, sy); push(_trg_sz, sz);
    push(_trg_r, r);
    push(_trg_tag, tag);
    push(_trg_on, 1);
    push(_trg_once, 0);
    push(_trg_fin, 0);   push(_trg_hasin, 0);
    push(_trg_fout, 0);  push(_trg_hasout, 0);
    push(_trg_fstay, 0); push(_trg_hasstay, 0);
    push(_trg_act, ZACT_NONE);
    push(_trg_amt, 0.0);
    push(_trg_snd, "");
    return length(_trg_shape) - 1;
}

// Kutu bölge: konumu ve TAM boyu entity'ninkiyle aynı sözleşmede.
func trigger3d(x, y, z, sx, sy, sz, tag): int {
    return _trg_new3(0, x, y, z, sx, sy, sz, 0.0, tag);
}
// Küre bölge: "şunun N birim yakınına gelince". Kutu kurmaktan daha doğal
// olduğu yerler var (boss menzili, sesli tetik, toplama alanı).
func trigger_sphere3d(x, y, z, r, tag): int {
    return _trg_new3(1, x, y, z, 0.0, 0.0, 0.0, r, tag);
}

func _trg_valid3(t): bool { return t >= 0 && t < length(_trg_shape); }

func on_enter3d(t, fn)  { if (_trg_valid3(t)) { _trg_fin[t] = fn;   _trg_hasin[t] = 1; } }
func on_exit3d(t, fn)   { if (_trg_valid3(t)) { _trg_fout[t] = fn;  _trg_hasout[t] = 1; } }
func on_stay3d(t, fn)   { if (_trg_valid3(t)) { _trg_fstay[t] = fn; _trg_hasstay[t] = 1; } }

// Bölgenin VERİ eylemi. Sahne dosyasından geliyor, kod istemiyor.
func trigger_action3d(t, act, amount) {
    if (!_trg_valid3(t)) { return; }
    _trg_act[t] = act;
    _trg_amt[t] = amount * 1.0;
}
func bolge_eylem3d(t, eylem, miktar) { trigger_action3d(t, eylem, miktar); }
func trigger_sound3d(t, path) {
    if (!_trg_valid3(t)) { return; }
    _trg_snd[t] = path;
}
func bolge_ses3d(t, yol) { trigger_sound3d(t, yol); }
func trigger_sound_of3d(t): str {
    if (!_trg_valid3(t)) { return ""; }
    return _trg_snd[t];
}

func trigger_action_of3d(t): int {
    if (!_trg_valid3(t)) { return ZACT_NONE; }
    return _trg_act[t];
}
func trigger_amount_of3d(t): float {
    if (!_trg_valid3(t)) { return 0.0; }
    return _trg_amt[t];
}

// Eylemin MİKTARI var mı. Kural panelindeki aynı ayrım: kullanılmayan bir
// alanı göstermek, "buraya ne yazsam?" diye düşündürüp hiçbir şey yapmıyor.
func _zact_uses_amount3(a): bool {
    return a == ZACT_DAMAGE || a == ZACT_SCORE;
}

// Eylem adı. Panelde YARIM sütuna sığması gerekiyor (~11 karakter).
func _zact_nm3(a): str {
    if (a == ZACT_WIN)    { return "kazan"; }
    if (a == ZACT_LOSE)   { return "kaybet"; }
    if (a == ZACT_KILL)   { return "gireni yok"; }
    if (a == ZACT_DAMAGE) { return "hasar ver"; }
    if (a == ZACT_SCORE)  { return "skor ekle"; }
    if (a == ZACT_NEXT)   { return "sonraki bol"; }
    return "eylem yok";
}

// Miktar alanının etiketi — hangi eylemin neyi saydığını alan BAŞLIĞI söylüyor.
func _zact_amount_lbl3(a): str {
    if (a == ZACT_DAMAGE) { return "hasar"; }
    if (a == ZACT_SCORE)  { return "skor"; }
    return "";
}

// Eylem döngüsü KAPALI HALKA: son eylemden sonra başa dönüyor, yoksa düğme
// bir yerde takılır ve önceki eylemlere geri dönülemezdi.
func _zact_next3(a): int {
    if (a >= ZACT_NEXT) { return ZACT_NONE; }
    return a + 1;
}

// Bölge eylemini UYGULA. Giren gövde `h`; "öteki" yok.
//
// Kural dağıtıcısını (`_rl_apply3`) çağırmıyor ve çağırmamalı: o dağıtıcı
// çiftle konuşuyor ve buradaki her eylemin karşılığı orada yok (skor ekle,
// sonraki bölüm). Ortak kod uğruna zorlamak, yarısı sessizce boş işlem olan
// bir liste üretirdi.
func _trg_apply3(t, h) {
    // Ses EN BAŞTA ve eylemden BAĞIMSIZ. Kurallardaki gerekçenin aynısı:
    // aşağıdaki dallar gireni öldürebiliyor ve sonra çalmak konumu
    // kaybettirirdi. Bağımsız olması da bilerek — eylemi olmayan ama sesi
    // olan bir bölge geçerli bir şey (kapı gıcırtısı, ayak sesi bölgesi).
    _rl_snd3(_trg_snd[t], h, 0 - 1);
    int a = _trg_act[t];
    if (a == ZACT_NONE) { return; }
    if (a == ZACT_WIN)    { win3d(); return; }
    if (a == ZACT_LOSE)   { game_over3d(); return; }
    if (a == ZACT_KILL)   { kill3d(h); return; }
    if (a == ZACT_DAMAGE) { damage3d(h, toInt(_trg_amt[t])); return; }
    if (a == ZACT_SCORE)  { score3d_add(toInt(_trg_amt[t])); return; }
    if (a == ZACT_NEXT)   { next_level3d(); return; }
}

// Tek atımlık bölge: ilk girişten sonra kendini kapatır. Kontrol noktası,
// "bir kere anlatılan" mesaj, tek kullanımlık tuzak. Kapandığı için ÇIKIŞ
// kancası artık atmaz — tek atım demek budur.
func trigger_once3d(t, on) {
    if (!_trg_valid3(t)) { return; }
    if (on) { _trg_once[t] = 1; } else { _trg_once[t] = 0; }
}
func trigger_on3d(t, on) {
    if (!_trg_valid3(t)) { return; }
    if (on) { _trg_on[t] = 1; } else { _trg_on[t] = 0; _trg_forget3(t); }
}
// Bölgeyi taşı: asansör güvertesi, hareketli tuzak, oyuncuyu izleyen aura.
func trigger_move3d(t, x, y, z) {
    if (!_trg_valid3(t)) { return; }
    _trg_x[t] = x; _trg_y[t] = y; _trg_z[t] = z;
}

func trigger_count3d(): int { return length(_trg_shape); }
// Kanca içinde: hangi bölge tetikledi. Tek bir callback'i çok bölgeye
// bağlayabilmek için — `ben3()` giren entity'yi, bu bölgeyi söyler.
func trigger_id3d(): int { return _trg_cur3; }

// Şu an bölgenin içinde kaç entity var.
func inside3d(t): int {
    int c = 0;
    int i = 0;
    int n = length(_trg_in_t);
    while (i < n) {
        if (_trg_in_t[i] == t) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

// Ayıklama çizimi: bölgeler normalde GÖRÜNMEZ (bütün mesele o). Yerleştirirken
// nereye koyduğunu görmek için aç.
func trigger_show3d(on) { if (on) { _trg_show3 = 1; } else { _trg_show3 = 0; } }

func _trg_was_in3(t, h): bool {
    int i = 0;
    int n = length(_trg_in_t);
    while (i < n) {
        if (_trg_in_t[i] == t && _trg_in_e[i] == h) { return true; }
        i = i + 1;
    }
    return false;
}

// Bir bölgenin üyeliklerini ÇIKIŞ ATMADAN düşür (kapatma / silme yolu).
func _trg_forget3(t) {
    array nt = [];
    array ne = [];
    int i = 0;
    int n = length(_trg_in_t);
    while (i < n) {
        if (_trg_in_t[i] != t) { push(nt, _trg_in_t[i]); push(ne, _trg_in_e[i]); }
        i = i + 1;
    }
    _trg_in_t = nt; _trg_in_e = ne;
}

// Entity ↔ bölge çakışması. Entity'nin AABB'si kullanılıyor (küre/silindir
// için sx yarıçapın iki katı, yani AABB doğru kapsıyor) — tetikleyici bölgede
// SAT'a gerek yok: bölge eksen hizalı ve amaç "gövde değdi mi", milimetre
// hassasiyeti değil.
func _trg_hit3(t, s): bool {
    Ent3 e = _e3[s];
    float ex = e.sx * 0.5; float ey = e.sy * 0.5; float ez = e.sz * 0.5;
    if (_trg_shape[t] == 1) {
        // Küre bölge ↔ entity kutusu: kutunun bölge merkezine EN YAKIN
        // noktası bulunup yarıçapla karşılaştırılıyor (kapatma yok, tam).
        float cx = _trg_x[t]; float cy = _trg_y[t]; float cz = _trg_z[t];
        if (cx < e.x - ex) { cx = e.x - ex; }
        if (cx > e.x + ex) { cx = e.x + ex; }
        if (cy < e.y - ey) { cy = e.y - ey; }
        if (cy > e.y + ey) { cy = e.y + ey; }
        if (cz < e.z - ez) { cz = e.z - ez; }
        if (cz > e.z + ez) { cz = e.z + ez; }
        float dx = _trg_x[t] - cx; float dy = _trg_y[t] - cy; float dz = _trg_z[t] - cz;
        float r = _trg_r[t];
        return dx * dx + dy * dy + dz * dz <= r * r;
    }
    float hx = ex + _trg_sx[t] * 0.5;
    float hy = ey + _trg_sy[t] * 0.5;
    float hz = ez + _trg_sz[t] * 0.5;
    return abs_f3(e.x - _trg_x[t]) <= hx
        && abs_f3(e.y - _trg_y[t]) <= hy
        && abs_f3(e.z - _trg_z[t]) <= hz;
}

func _trg_fire3(t, h, fn, has) {
    if (has == 0) { return; }
    _trg_cur3 = t;
    _hit_me = h;
    // Bölge entity değil, yani `oteki3()` gösterecek bir şey YOK. Bir önceki
    // çarpışmadan kalan değeri bırakmak sessiz hataya davetiye olurdu.
    _hit_other = 0 - 1;
    call(fn);
    _trg_cur3 = 0 - 1;
}

// Kare adımı: fizik ve çarpışmadan SONRA çalışır, yani bölgeler entity'lerin
// bu karedeki NİHAİ konumunu görür (duvara itilme sonrası).
func _s3_triggers() {
    int tn = length(_trg_shape);
    if (tn == 0) { return; }
    int n = length(_e3);
    // 1) Bu kareki üyelik + GİRİŞ/İÇİNDEYKEN kenarları.
    array nt = [];
    array ne = [];
    int t = 0;
    while (t < tn) {
        if (_trg_on[t] == 1) {
            int tag = _trg_tag[t];
            int s = 0;
            while (s < n) {
                Ent3 e = _e3[s];
                // `_trg_on[t]` her entity için YENİDEN okunuyor: bir kanca
                // (tek atım ya da doğrudan `bolge_etkin3d`) bölgeyi bu taramanın
                // ORTASINDA kapatmış olabilir. Okunmasaydı "tek atım" bölge,
                // içindeki her entity için bir kez atardı — yani tek olmazdı.
                if (_trg_on[t] == 1 && e.alive == 1 && e.tag == tag && _trg_hit3(t, s)) {
                    int h = _mk_handle3(s);
                    if (_trg_was_in3(t, h)) {
                        _trg_fire3(t, h, _trg_fstay[t], _trg_hasstay[t]);
                    } else {
                        _trg_fire3(t, h, _trg_fin[t], _trg_hasin[t]);
                        // VERİ eylemi kancadan SONRA: kanca yazarın kendi
                        // kodu ve gövdeyi CANLI görmeli. Önce çalışsaydı
                        // "gireni yok et" eylemi, kancanın eline ölü bir
                        // handle bırakırdı. Tersi güvenli — `kill3d`/
                        // `damage3d` ölü handle'da sessizce hiçbir şey
                        // yapmıyor.
                        //
                        // Yalnız GİRİŞTE: "içindeyken" her kare atıyor ve
                        // orada bir "kazan" eylemi saniyede altmış kez
                        // kazandırırdı. Tekrarlanabilir hasar isteyen
                        // "tek atım"ı kapalı bırakıp bölgeden çıkıp girer.
                        _trg_apply3(t, h);
                        // Tek atım: girişi işledikten SONRA kapan, yoksa
                        // kancanın kendisi hiç çalışmazdı. Kapatma tek yoldan
                        // (trigger_on3d) geçiyor ki "kapalı bölge" her yerde
                        // aynı anlama gelsin; onun düşürdüğü üyelik `inside3d`
                        // kapanır kapanmaz doğru cevap versin diye. Sahte
                        // ÇIKIŞ'ı engelleyen ise aşağıdaki geçidin _trg_on
                        // kontrolü — ikisi ayrı iş yapıyor (bkz. o yorum).
                        if (_trg_once[t] == 1) { trigger_on3d(t, false); }
                    }
                    // Kanca bölgeyi kapatmış olabilir (tek atım ya da doğrudan
                    // trigger_on3d). Kapalı bölge üyelik TUTMAZ.
                    if (_trg_on[t] == 1) { push(nt, t); push(ne, h); }
                }
                s = s + 1;
            }
        }
        t = t + 1;
    }
    // 2) ÇIKIŞ kenarları: eski kümede olup yenisinde olmayanlar.
    // ÖLEN entity için çıkış ATILMAZ, üyeliği sessizce düşer: handle zaten
    // geçersiz, kanca onunla hiçbir şey yapamazdı. Ölümü izlemek isteyen
    // `olunce3d` kullanır — enter/exit dengesi oraya ait değil.
    int i = 0;
    int m = length(_trg_in_t);
    while (i < m) {
        int ot = _trg_in_t[i];
        int oh = _trg_in_e[i];
        int still = 0;
        int j = 0;
        int nn = length(nt);
        while (j < nn) {
            if (nt[j] == ot && ne[j] == oh) { still = 1; j = nn; } else { j = j + 1; }
        }
        // Kapalı bölge hiç olay üretmez — çıkış da olay. Bu kontrol GEREKLİ,
        // kapatmanın üyeliği düşürmesi tek başına yetmiyor: bölge tarama
        // ORTASINDA kapanırsa (tek atım), kapanmadan önce işlenmiş bir gövde
        // yeni kümeye çoktan yazılmış oluyor. Sonraki kare o gövdeyi "artık
        // kümede yok" diye görüp SAHTE bir çıkış atıyordu.
        if (still == 0 && _trg_on[ot] == 1 && alive3(oh)) {
            _trg_fire3(ot, oh, _trg_fout[ot], _trg_hasout[ot]);
        }
        i = i + 1;
    }
    _trg_in_t = nt;
    _trg_in_e = ne;
}

// Bölge deposunu tamamen boşalt. Bölge YERLEŞTİRİLMİŞ geometridir (kapı, tuzak),
// kural değil: bölüm değişince entity'lerle birlikte gider. Kancalar
// (`carpisinca3`, `olunce3d`) ise kural olduğu için bölümü aşar. Ayrım bu.
func _trg_clear3() {
    _trg_x = []; _trg_y = []; _trg_z = [];
    _trg_sx = []; _trg_sy = []; _trg_sz = [];
    _trg_r = []; _trg_shape = []; _trg_tag = [];
    _trg_on = []; _trg_once = [];
    _trg_fin = []; _trg_hasin = [];
    _trg_fout = []; _trg_hasout = [];
    _trg_fstay = []; _trg_hasstay = [];
    _trg_act = []; _trg_amt = []; _trg_snd = [];
    _trg_in_t = []; _trg_in_e = [];
    _trg_cur3 = 0 - 1;
}

// Bölgenin editördeki rengi. Rengin kendisi bir BİLGİ: sahne denetimi
// "bu bölge hiçbir şey yapmıyor" diyor ve aynı şeyi ekranda da görmek
// gerekiyor — konsola bakmadan.
func _trg_col3(t): int {
    if (_trg_on[t] == 0) { return rgb(110, 110, 120); }          // kapalı
    if (_trg_act[t] == ZACT_NONE && _trg_hasin[t] == 0 &&
        _trg_hasout[t] == 0 && _trg_hasstay[t] == 0) {
        return rgb(190, 150, 90);                                 // ölü: eylemsiz
    }
    return rgb(90, 220, 160);                                     // iş gören
}

func _trg_draw3() {
    // EDİTÖRDE bölgeler her zaman görünür. Görünmediklerinde editör bir kutu
    // koyduruyor ve sonra onu GÖSTERMİYORDU: yerini ancak paneldeki sayı
    // alanlarına bakarak tahmin edebiliyordun, yani bölge yerleştirmek gözle
    // yapılan bir iş olmaktan çıkıyordu. (`_ed_on3` oynarken zaten 0 oluyor,
    // yani oyun görüntüsü tel kafeslerle kirlenmiyor.)
    //
    // OYUNDA varsayılan yine KAPALI: bölge bir mekanik, dekor değil.
    int goster = _trg_show3;
    if (_ed_on3 == 1) { goster = 1; }
    if (goster == 0) { return; }
    int t = 0;
    int n = length(_trg_shape);
    while (t < n) {
        int col = _trg_col3(t);
        // Seçili bölge vurgulanıyor — hiyerarşiden seçtiğin satırın sahnede
        // NEREYE denk geldiğini gösteren tek işaret bu.
        if (_ed_on3 == 1 && _ed_tab3 == 2 && _ed_zsel3 == t) { col = _G_ACC3(); }
        if (_trg_shape[t] == 1) {
            sphere_wires(_trg_x[t], _trg_y[t], _trg_z[t], _trg_r[t], 8, col);
        } else {
            cube_wires(_trg_x[t], _trg_y[t], _trg_z[t],
                       _trg_sx[t], _trg_sy[t], _trg_sz[t], col);
        }
        t = t + 1;
    }
}

// ---- Işın ↔ bölge (seçim) ---------------------------------------------------
// Bölgeler entity DEĞİL, o yüzden `_seg_aabb3` (ki `_e3`'ten okuyor ve dönüşü
// de hesaplıyor) onlara uygulanamıyor. Bunlar saf geometri: parametre
// alıyorlar, veri okumuyorlar — yani penceresiz sınanabiliyorlar.
//
// Dönüş: kesişim parametresi t (0..1) ya da -1. Işının BAŞI hacmin içindeyse
// 0 dönüyor: bölgenin içinden bakarken de onu seçebilmek gerekiyor.
func _seg_box3(ox, oy, oz, dx, dy, dz, cx, cy, cz, hx, hy, hz): float {
    float tmin = 0.0;
    float tmax = 1.0;
    if (abs_f3(dx) < 0.000001) {
        if (ox < cx - hx || ox > cx + hx) { return 0.0 - 1.0; }
    } else {
        float t1 = (cx - hx - ox) / dx;
        float t2 = (cx + hx - ox) / dx;
        if (t1 > t2) { float tt = t1; t1 = t2; t2 = tt; }
        if (t1 > tmin) { tmin = t1; }
        if (t2 < tmax) { tmax = t2; }
        if (tmin > tmax) { return 0.0 - 1.0; }
    }
    if (abs_f3(dy) < 0.000001) {
        if (oy < cy - hy || oy > cy + hy) { return 0.0 - 1.0; }
    } else {
        float t1 = (cy - hy - oy) / dy;
        float t2 = (cy + hy - oy) / dy;
        if (t1 > t2) { float tt = t1; t1 = t2; t2 = tt; }
        if (t1 > tmin) { tmin = t1; }
        if (t2 < tmax) { tmax = t2; }
        if (tmin > tmax) { return 0.0 - 1.0; }
    }
    if (abs_f3(dz) < 0.000001) {
        if (oz < cz - hz || oz > cz + hz) { return 0.0 - 1.0; }
    } else {
        float t1 = (cz - hz - oz) / dz;
        float t2 = (cz + hz - oz) / dz;
        if (t1 > t2) { float tt = t1; t1 = t2; t2 = tt; }
        if (t1 > tmin) { tmin = t1; }
        if (t2 < tmax) { tmax = t2; }
        if (tmin > tmax) { return 0.0 - 1.0; }
    }
    return tmin;
}

func _seg_sphere3(ox, oy, oz, dx, dy, dz, cx, cy, cz, r): float {
    float mx = ox - cx;
    float my = oy - cy;
    float mz = oz - cz;
    float a = dx * dx + dy * dy + dz * dz;
    if (a < 0.000001) { return 0.0 - 1.0; }
    float b = 2.0 * (mx * dx + my * dy + mz * dz);
    float c = mx * mx + my * my + mz * mz - r * r;
    float disc = b * b - 4.0 * a * c;
    if (disc < 0.0) { return 0.0 - 1.0; }
    float sq = sqrt(disc);
    float t1 = (0.0 - b - sq) / (2.0 * a);
    float t2 = (0.0 - b + sq) / (2.0 * a);
    if (t2 < 0.0) { return 0.0 - 1.0; }   // tamamı ışının ARKASINDA
    if (t1 > 1.0) { return 0.0 - 1.0; }   // menzilin ötesinde
    if (t1 < 0.0) { return 0.0; }         // başlangıç noktası İÇERİDE
    return t1;
}

// Ekran ışınının vurduğu bölge (indeks) ya da -1. En yakını kazanıyor.
func _ed_pick_zone3(ox, oy, oz, dx, dy, dz, reach): int {
    float sx = dx * reach;
    float sy = dy * reach;
    float sz = dz * reach;
    float best = 2.0;
    int bi = 0 - 1;
    int t = 0;
    while (t < length(_trg_shape)) {
        float h = 0.0 - 1.0;
        if (_trg_shape[t] == 1) {
            h = _seg_sphere3(ox, oy, oz, sx, sy, sz,
                             _trg_x[t], _trg_y[t], _trg_z[t], _trg_r[t]);
        } else {
            h = _seg_box3(ox, oy, oz, sx, sy, sz,
                          _trg_x[t], _trg_y[t], _trg_z[t],
                          _trg_sx[t] * 0.5, _trg_sy[t] * 0.5, _trg_sz[t] * 0.5);
        }
        if (h >= 0.0 && h < best) { best = h; bi = t; }
        t = t + 1;
    }
    return bi;
}

// ---- Kamera: bakış girdisi + üç mod ----------------------------------------
// Bakışı süren üç girdi de aynı açılara yazar:
//   fare   — FPS'te (imleç kilitli) sürekli, yörüngede SAĞ tuş basılıyken.
//            Kilitliyken mouse_x() sabit kalır, o yüzden delta okunur.
//   parmak — ekranın sağ yarısı (bkz. _read_touch3).
//   Q/E    — klavye yedeği: tarayıcıda Pointer Lock verilmediyse ya da
//            farenin olmadığı yerde kamera yine de çevrilebilsin.
func _s3_camera_input(dt) {
    if (_cam_mode3 == CAM_FIXED) { return; }
    float dx = 0.0;
    float dy = 0.0;
    if (_cam_lock3 == 1 || mouse_down(1)) {
        dx = mouse_dx() * _cam_sens3;
        dy = mouse_dy() * _cam_sens3;
    }
    dx = dx + _t_lx * _cam_tsens3;
    dy = dy + _t_ly * _cam_tsens3;
    if (key_down(K_Q)) { dx = dx - 100.0 * dt; }
    if (key_down(K_E)) { dx = dx + 100.0 * dt; }
    // Sağ çubuk. Fare/parmak PİKSEL deltası verir (kare başına yol), çubuk ise
    // KONUM: itili tuttuğun sürece sabit bir değer okunur. O yüzden tek dt ile
    // ölçeklenen girdi budur — dt'siz olsaydı bakış hızı kare hızına bağlanırdı.
    dx = dx + _gp_lx * _gp_sens3 * dt;
    dy = dy + _gp_ly * _gp_sens3 * dt;

    _cam_yaw3 = _cam_yaw3 + dx;
    // Ekran Y'si aşağı büyür: fareyi yukarı itmek dy'yi negatif yapar, yani
    // yukarı bakmak demektir.
    _cam_pitch3 = _cam_pitch3 - dy;

    if (_cam_yaw3 > 360.0) { _cam_yaw3 = _cam_yaw3 - 360.0; }
    if (_cam_yaw3 < 0.0)   { _cam_yaw3 = _cam_yaw3 + 360.0; }

    // Eğim sınırı: tam tepeye/dibe gelince kamera "takla atar" (up vektörü
    // bakışla hizalanır) — 85° öncesinde kesiyoruz. Yörüngede yukarı bakmak
    // kamerayı yere gömdüğü için üst sınır daha dar.
    float pmax = 85.0;
    if (_cam_mode3 == CAM_ORBIT) { pmax = 25.0; }
    if (_cam_pitch3 > pmax) { _cam_pitch3 = pmax; }
    if (_cam_pitch3 < 0.0 - 85.0) { _cam_pitch3 = 0.0 - 85.0; }

    // Tekerlekle yakınlaş/uzaklaş (yalnız yörünge — FPS'te mesafe yok).
    if (_cam_mode3 == CAM_ORBIT) {
        float w = mouse_wheel();
        if (w != 0.0) { _cam_dist = _cam_dist - w * 1.5; }
        if (_cam_dist < _cam_min3) { _cam_dist = _cam_min3; }
        if (_cam_dist > _cam_max3) { _cam_dist = _cam_max3; }
    }
}

func _s3_camera(dt) {
    // Editör kipinde kamera hedefe bağlı DEĞİL — serbest uçuyor. Takip
    // kamerasını burada erken kesmek, aşağıdaki bütün hedef/saydamlık/engel
    // mantığının editörde hiç çalışmaması demek; istenen de bu.
    if (_ed_on3 == 1) {
        float yr = _ed_yaw3 * DEG2RAD3;
        float pr = _ed_pitch3 * DEG2RAD3;
        float cp = cos(pr);
        camera3d(_ed_cx3, _ed_cy3, _ed_cz3,
                 _ed_cx3 + sin(yr) * cp, _ed_cy3 + sin(pr), _ed_cz3 - cos(yr) * cp,
                 _cam_fov);
        return;
    }
    // Hedef ölmüşse (handle bayat) genel görünüme düş — ölü slot'u okumak,
    // slot geri kullanıldığında kamerayı alakasız bir entity'ye kilitlerdi.
    int ct = _slot_of3(_cam_target);
    if (ct < 0) {
        _fade3 = [];   // hedef yok → bayat saydamlık kalmasın
        camera3d(_cam_dist, _cam_height, _cam_dist,  0.0, 0.0, 0.0, _cam_fov);
        return;
    }
    Ent3 t = _e3[ct];
    if (_cam_mode3 == CAM_FIXED) {
        // Oyuncunun arkasında (+Z) ve yukarıda; oyuncuya bakar.
        _s3_mark_fade3(t.x, t.y + _cam_height, t.z + _cam_dist,
                       t.x, t.y, t.z, ct);
        camera3d(t.x, t.y + _cam_height, t.z + _cam_dist,   t.x, t.y, t.z,  _cam_fov);
        return;
    }
    // Bakış yönünün yatay bileşeni: yaw 0 → (0,0,-1), yani -Z "ileri".
    float yr = _cam_yaw3 * DEG2RAD3;
    float fx = sin(yr);
    float fz = 0.0 - cos(yr);
    if (_cam_mode3 == CAM_FPS) {
        float pr = _cam_pitch3 * DEG2RAD3;
        float ch = cos(pr);
        float eye = _cam_eye3;
        if (eye <= 0.0) { eye = t.sy * 0.35; }   // gövdenin üst tarafı
        float ex = t.x;
        float ey = t.y + eye;
        float ez = t.z;
        camera3d(ex, ey, ez,   ex + fx * ch, ey + sin(pr), ez + fz * ch,  _cam_fov);
        return;
    }
    // Yörünge: hedefin çevresinde bir küre üzerinde. Bakış eğimi negatifken
    // (aşağı bakış) kamera yukarıdadır — o yüzden işaret ters çevriliyor.
    float pr = (0.0 - _cam_pitch3) * DEG2RAD3;
    float horiz = _cam_dist * cos(pr);
    float cx = t.x - fx * horiz;
    float cz = t.z - fz * horiz;
    float cy = t.y + _cam_dist * sin(pr);
    // Kamera-duvar çözümü İKİ AŞAMALI ve sırası önemli:
    //   1. YÜKSELT — engelin üstünden bakmayı dene. Oyuncu ekranda aynı boyda
    //      kalır, yönelim korunur. Sırtını duvara dayamanın doğal karşılığı
    //      kameranın duvarın üstüne çıkmasıdır, oyuncunun ensesine yapışması
    //      değil.
    //   2. Yükselmek yetmediyse YAKINLAŞTIR (eski davranış, dünya birimi
    //      tabanla). Son çare, çünkü yakınlaşmak yönelimi bozuyor.
    if (_cam_collide3 == 1) {
        // Gereken ek eğimi bul: engel temizlenene kadar küçük adımlarla yükselt.
        // ÜST SINIR DAR (30°) ve sonuç YUMUŞATILIYOR — sınır geniş olduğunda
        // (74°) kamera çapraz bakıştan kuş bakışına atlıyordu, üstelik kare
        // kare, çünkü değer doğrudan uygulanıyordu. Yükseltme bir kurtarma
        // hamlesi olmalı, kamera açısını ele geçiren bir şey değil.
        float want = 0.0;
        float ct2 = _cam_clear_t3(t.x, t.y, t.z, cx - t.x, cy - t.y, cz - t.z);
        int tries = 0;
        while (ct2 < 0.999 && tries < 5) {
            want = want + _CAM_LIFT_STEP3;
            if (want > _CAM_LIFT_MAX3) { want = _CAM_LIFT_MAX3; }
            float tp = pr + want;
            float th = _cam_dist * cos(tp);
            ct2 = _cam_clear_t3(t.x, t.y, t.z,
                                (t.x - fx * th) - t.x,
                                (t.y + _cam_dist * sin(tp)) - t.y,
                                (t.z - fz * th) - t.z);
            tries = tries + 1;
            if (want >= _CAM_LIFT_MAX3) { tries = 5; }
        }
        // Yumuşat: yukarı çabuk (görüş açılsın), aşağı yavaş (kamera sallanmasın).
        float lk = 6.0 * dt;
        if (want < _cam_lift3) { lk = 2.5 * dt; }
        if (lk > 1.0) { lk = 1.0; }
        _cam_lift3 = _cam_lift3 + (want - _cam_lift3) * lk;
        pr = pr + _cam_lift3;
        horiz = _cam_dist * cos(pr);
        cx = t.x - fx * horiz;
        cz = t.z - fz * horiz;
        cy = t.y + _cam_dist * sin(pr);
        ct2 = _cam_clear_t3(t.x, t.y, t.z, cx - t.x, cy - t.y, cz - t.z);
        float rdx = cx - t.x;
        float rdy = cy - t.y;
        float rdz = cz - t.z;
        float full = sqrt(rdx * rdx + rdy * rdy + rdz * rdz);
        if (full > 0.001) {
            float s = _cam_smooth3(_cam_allowed3(full, ct2), dt) / full;
            cx = t.x + rdx * s;
            cy = t.y + rdy * s;
            cz = t.z + rdz * s;
        }
    }
    // Kamerayı zeminin altına düşürme — oyuncu bir anda yer katmanının
    // içinden bakmaya başlar (klasik "kamera yere gömüldü" görüntüsü).
    // Çarpışma çözümünden SONRA: çözüm kamerayı aşağı taşımış olabilir.
    if (_ground_on == 1 && cy < _ground_y + 0.8) { cy = _ground_y + 0.8; }
    _s3_mark_fade3(cx, cy, cz, t.x, t.y, t.z, ct);
    _s3_watch_cam3(cx, cy, cz);
    camera3d(cx, cy, cz,   t.x, t.y, t.z,  _cam_fov);
}

// ---- Çizim -----------------------------------------------------------------
func _s3_render() {
    // Arazi varsa düz zemin/ızgara YERİNE onu çiz. Model handle'ı normal model
    // olduğu için gölge/ışık yolları bedavaya çalışıyor. Mesh yerel uzayda
    // 0..sx / 0..sz aralığında, o yüzden yarı-boy kadar geri kaydırıp ortalıyoruz.
    if (_terr_on == 1) {
        if (_terr_model >= 0) {
            draw_model(_terr_model, 0.0 - _terr_sx * 0.5, _ground_y,
                       0.0 - _terr_sz * 0.5, 1.0, _terr_color);
        }
    } else {
    if (_ground_on == 1) {
        if (_ground_tex3 >= 0) {
            // Dokulu zemin: renk beyaz olmalı, yoksa doku boyanır.
            texture3d(_ground_tex3, _ground_tile3, _ground_tile3);
            plane(0.0, _ground_y, 0.0,  _ground_sz * 2.0, _ground_sz * 2.0, WHITE);
            no_texture3d();
        } else {
            plane(0.0, _ground_y, 0.0,  _ground_sz * 2.0, _ground_sz * 2.0, rgb(30, 34, 46));
            grid(toInt(_ground_sz), 1.0);
        }
    }
    }   // arazi else'i
    int n = length(_e3);
    int cts = _slot_of3(_cam_target);   // handle → slot (döngü slot'la geziyor)
    int fn3 = length(_fade3);
    // İKİ GEÇİŞ. Saydam cisimler EN SONA kalmak zorunda: kamerayla oyuncu
    // arasındaki duvar önce çizilirse derinlik tamponuna yazar ve arkasındaki
    // oyuncu elenir — yani saydamlık hiçbir işe yaramaz, duvar delik gibi
    // görünür. Sonra çizildiğinde ise oyuncunun pikselleri tamponda hazırdır
    // ve duvar onların üstüne KARIŞIR.
    int pass = 0;
    while (pass < 2) {
    int i = 0;
    while (i < n) {
        Ent3 e = _e3[i];
        int fade_it = 0;
        if (i < fn3) { fade_it = _fade3[i]; }
        int draw_it = 0;
        if (e.alive == 1 && fade_it == pass) { draw_it = 1; }
        // Birinci şahısta kamera gövdenin İÇİNDEdir: çizersek ekranı kendi
        // kutumuzun iç yüzeyi kaplar.
        if (_cam_mode3 == CAM_FPS && i == cts) { draw_it = 0; }
        if (draw_it == 1) {
            int ecol = e.color;
            if (fade_it == 1) {
                ecol = rgba(_col_r3(e.color), _col_g3(e.color), _col_b3(e.color),
                            _fade_a3);
            }
            // YÜZEY DOKUSU. raylib'de doku KİPSEL: kur, çiz, kapat. Bu yüzden
            // ilkel cisimleri dokulamak modelin materyalini paylaşmak gibi bir
            // takas gerektirmiyor — her varlık kendi dokusunu alabiliyor.
            //
            // Renk BEYAZA çekiliyor (zemin dokusunda olduğu gibi): renk kalırsa
            // doku onunla çarpılıp boyanır ve tuğla duvar mavi tuğla olur.
            // Solma geçişinde alfa korunuyor, yoksa kaybolan cisim doku
            // yüzünden aniden opaklaşırdı.
            int tex = 0 - 1;
            if (e.tsrc != "") { tex = asset_texture3d(e.tsrc); }
            if (tex >= 0) {
                float tl = e.ttile;
                if (tl <= 0.0) { tl = 1.0; }
                texture3d(tex, tl, tl);
                if (fade_it == 1) { ecol = rgba(255, 255, 255, _fade_a3); }
                else { ecol = WHITE; }
            }
            if (e.shape == SHAPE_RAMP) {
                // GERÇEK kama mesh'i varsa tek çağrıda çiz. `ramp3d` onu
                // rampayla birlikte üretiyor, o yüzden ölçek 1.0.
                if (e.model >= 0) {
                    draw_model_rot(e.model, e.x, e.y, e.z, e.yaw, 1.0, ecol);
                } else {
                // Mesh üretilemediyse (pencere yokken) ESKİ yol: rampayı yerel
                // +Z boyunca KADEMELİ dilimle. Fizik analitik eğimi kullanıyor
                // (bkz. _ramp_h3), yani yürüyüş her iki durumda da pürüzsüz —
                // kademe yalnız görsel.
                int steps = 12;
                float c = cos(e.yaw * DEG2RAD3);
                float s = sin(e.yaw * DEG2RAD3);
                float base = e.y - e.sy * 0.5;
                float dz = e.sz / (steps * 1.0);
                int k = 0;
                while (k < steps) {
                    float lz = 0.0 - e.sz * 0.5 + dz * (k + 0.5);
                    float frac = (lz + e.sz * 0.5) / e.sz;
                    float h = e.sy * frac;
                    if (h < 0.02) { h = 0.02; }
                    // yerel (0, lz) → dünya
                    float wx = e.x + s * lz;
                    float wz = e.z + c * lz;
                    cube(wx, base + h * 0.5, wz, e.sx, h, dz, ecol);
                    k = k + 1;
                }
                }   // kama mesh'i yoksa else'i
            } else {
            if (e.shape == SHAPE_CUBE) {
                // Yaw varsa DÖNÜK çiz. Düz `cube()` dönme almıyor; çarpışma
                // ise SAT ile dönük hacmi kullanıyordu, yani görünen duvar
                // çarpışan duvarla aynı yerde DEĞİLDİ — oyuncu görünen
                // duvarın içinden geçiyor gibi oluyordu.
                if (abs_f3(e.yaw) > 0.01) {
                    cube_rot(e.x, e.y, e.z, e.sx, e.sy, e.sz, e.yaw, ecol);
                } else {
                    cube(e.x, e.y, e.z, e.sx, e.sy, e.sz, ecol);
                }
            } else {
                if (e.shape == SHAPE_SPHERE) {
                    sphere(e.x, e.y, e.z, e.sx * 0.5, ecol);
                } else {
                    if (e.shape == SHAPE_CYL) {
                        cylinder(e.x, e.y - e.sy * 0.5, e.z, e.sx * 0.5, e.sy, ecol);
                    } else {
                        if (e.shape == SHAPE_MODEL && e.model >= 0) {
                            // Animasyon: motor kare sayacını sürüyor, burada
                            // yalnız poz uygulanıyor. anim3d çağrılmamışsa
                            // (anim_idle < 0) model eskisi gibi donuk çizilir.
                            // İki poz da sürülüyor ve anim_w ile
                            // harmanlanıyor. Kare sayacı ORTAK: iki
                            // animasyon aynı yürüyüş fazında kalsın diye
                            // (locomotion harmanlamasının standart yolu),
                            // her biri kendi kare sayısına göre mod'lanıyor.
                            int ai = e.anim_a;
                            int bi = e.anim_b;
                            // Geçiş yoksa (a == b) harmanlamaya gerek yok;
                            // ikinci klibi -1 vermek C tarafında tek-poz
                            // yoluna düşürüyor.
                            if (ai == bi) { bi = 0 - 1; }
                            // a hiç kurulmamışsa (anim3d çağrılmamış) b'ye
                            // düş — model eskisi gibi donuk çizilir.
                            if (ai < 0) { ai = bi; bi = 0 - 1; }
                            if (ai >= 0) {
                                int fa = 0;
                                int ca = anim_frames(e.model, ai);
                                if (ca > 0) { fa = mod(toInt(e.anim_t), ca); }
                                int fb = 0;
                                if (bi >= 0) {
                                    int cb = anim_frames(e.model, bi);
                                    if (cb > 0) { fb = mod(toInt(e.anim_t), cb); }
                                }
                                anim_blend(e.model, ai, fa, bi, fb, e.anim_w);
                            }
                            draw_model_rot(e.model, e.x, e.y - e.sy * 0.5, e.z, e.yaw, e.sx, ecol);
                        }
                    }
                }
            }
            }   // SHAPE_RAMP else'i
            // Kipsel durum KAPATILMALI: açık bırakılırsa dokusuz komşu cisim
            // de aynı dokuyla çizilir (ve zemin/su da).
            if (tex >= 0) { no_texture3d(); }
        }
        i = i + 1;
    }
    pass = pass + 1;
    }
    // SU EN SONDA. Saydam ve dünyanın büyük bir kısmını kaplıyor: opak
    // cisimlerden önce çizilirse derinlik tamponuna yazar ve suyun ALTINDA
    // kalan her şey elenir — su, dibi göstermek yerine düz bir levha olur.
    // (Aynı sebep entity'lerin iki geçişli çizilmesinin de sebebi.)
    if (_water_on3 == 1) {
        float sz = _ground_sz * 2.0;
        if (_terr_on == 1) {
            // Arazi varsa onun ayak izini kapsa — göl kıyıda kesilmesin.
            sz = _terr_sx;
            if (_terr_sz > sz) { sz = _terr_sz; }
        }
        plane(0.0, _water_y3, 0.0, sz, sz,
              rgba(_col_r3(_water_col3), _col_g3(_water_col3),
                   _col_b3(_water_col3), _water_a3));
    }
    // Tetikleyici bölgeler entity'lerden SONRA: tel kafes, içindeki cismin
    // üstünde görünsün. Varsayılan kapalı (bkz. trigger_show3d).
    _trg_draw3();
}

// ---- Kayıt / kurulum API'si ------------------------------------------------
func scene3d(w, h, title) { _win_w = w; _win_h = h; _win_title = title; }
func on_setup3d(fn)  { _setup3_fn = fn; _has_setup3 = 1; }
func on_update3d(fn) { _update3_fn = fn; _has_update3 = 1; }
func on_hud3d(fn)    { _hud3_fn = fn; _has_hud3 = 1; }
func on_hit3d(tagA, tagB, fn) { push(_hitA, tagA); push(_hitB, tagB); push(_hitF, fn); }

func ground3d(y) { _ground_y = y; _ground_on = 1; }
func no_ground3d() { _ground_on = 0; }
func gravity3d(g) { _grav = g; }
func camera_follow(target, dist, height) {
    _cam_target = target; _cam_dist = dist; _cam_height = height;
    _cam_mode3 = CAM_FIXED; _cam_yaw3 = 0.0; _cam_pitch3 = 0.0;
}
func camera_fov(f) { _cam_fov = f; }

// ---- Kamera modları --------------------------------------------------------
// YÖRÜNGE (üçüncü şahıs): kamera hedefin çevresinde döner. Fare SAĞ tuşu
// basılıyken sürükle, ekranın sağ yarısına parmakla sürükle ya da Q/E.
// Tekerlek yakınlaştırır. Başlangıç açısı camera_follow ile BİREBİR aynı
// (dist/height aynı anlamda) — fark, artık döndürebilmen.
func camera_orbit(target, dist, height) {
    _cam_target = target;
    _cam_mode3 = CAM_ORBIT;
    // Fare bakışı VARSAYILAN AÇIK: imleç kilitlenir ve fare doğrudan kamerayı
    // çevirir — üçüncü şahıs oyunlarının standardı. Eskiden yalnız SAĞ TUŞ
    // basılıyken dönüyordu, yani "fare çalışmıyor" gibi geliyordu. Menü/duraklat
    // açıldığında döngü imleci kendiliğinden serbest bırakıyor (düğmelere
    // tıklanabilsin), oyuna dönünce yeniden kilitliyor.
    // Kapatmak için: fare_bakis3d(false) — o zaman sağ tuşla sürükleme kalır.
    _cam_lock3 = 1;
    _cam_dist = sqrt(dist * dist + height * height);
    _cam_pitch3 = 0.0 - atan2(height, dist) * RAD2DEG3;
    _cam_yaw3 = 0.0;
    _cam_height = height;
    // Yumuşatma durumunu sıfırla: yeni bölüm/yeni hedef, önceki sahnede
    // sıkışmış mesafeyi miras almasın (kamera açılana kadar bir an dibinde
    // başlardı).
    _cam_cur3 = 0.0; _cam_lift3 = 0.0;
}

// Kamera-engel davranışının ayarları — hepsi DÜNYA BİRİMİ.
//   near : hedefe en fazla bu kadar yaklaşır (engel daha yakınsa duvara girer)
//   pad  : çarpma noktasının bu kadar berisinde durur
//   ease : engel kalkınca geri açılma hızı (1/sn; büyük = daha çabuk)
func camera_near3d(d) { if (d > 0.1) { _cam_near3 = d; } }
func kamera_en_yakin3d(d) { camera_near3d(d); }
func camera_pad3d(p) { if (p >= 0.0) { _cam_pad3 = p; } }
func kamera_pay3d(p) { camera_pad3d(p); }
func camera_ease3d(e) { if (e > 0.0) { _cam_ease3 = e; } }
func kamera_yumusatma3d(e) { camera_ease3d(e); }
func kamera_yorunge(target, dist, height) { camera_orbit(target, dist, height); }

// BİRİNCİ ŞAHIS: kamera hedefin gözünde. Hedef çizilmez (içindesin).
// eye = göz yüksekliği, 0 verirsen gövde boyundan türetilir.
// Masaüstünde imleci kilitler (fareyle sürekli bakış); Escape'in yerine
// camera_lock3d(false) ile bırakabilirsin.
func camera_fps(target, eye) {
    _cam_target = target;
    _cam_mode3 = CAM_FPS;
    _cam_eye3 = eye;
    _cam_yaw3 = 0.0;
    _cam_pitch3 = 0.0;
    _cam_lock3 = 1;
}
func kamera_fpv(target, eye) { camera_fps(target, eye); }
func kamera_birinci_sahis(target, eye) { camera_fps(target, eye); }

// ---- Kameranın editör tarafı -----------------------------------------------
// Kamera sahne biçiminde vardı, kaydediliyordu ve DÜZENLENEMİYORDU: mod,
// hedef, mesafe, fov — hiçbirinin arayüzü yoktu. Yani editörde kurulan bir
// oyunun kamerası ya şablondan geliyordu ya da hiç yoktu, ve şablondan
// gelen de oyuncu silinince sessizce bozuluyordu.
//
// İSİMLENDİRME UYARISI: `CAM_FIXED` "sabit kamera" değil, motorun ilk günkü
// TAKİP kamerasıdır (açı sabit, hedefi izler). Biçimdeki karşılığı "follow"
// ve doğrusu bu — sabit açılı takip. Gerçekten hiçbir şeyi izlemeyen kamera
// ise hedefi olmayan kameradır, ayrı bir mod değil.
func _cam_mode_nm3(m): str {
    if (m == CAM_ORBIT) { return "yorunge"; }
    if (m == CAM_FPS)   { return "1. sahis"; }
    return "takip";
}

// Mod döngüsü KAPALI HALKA: sonuncudan sonra başa dönmezse düğme takılır.
func _cam_next_mode3(m): int {
    if (m == CAM_FIXED) { return CAM_ORBIT; }
    if (m == CAM_ORBIT) { return CAM_FPS; }
    return CAM_FIXED;
}

// Yörünge modunda `_cam_dist` yörünge YARIÇAPI; biçimdeki (ve panelin
// gösterdiği) "mesafe" ise `camera_orbit`'in aldığı yatay değer. Ters
// dönüşüm TEK YERDE: serileştirici de panel de bunu çağırıyor. İki yerde
// ayrı ayrı yazılsaydı biri unutulduğunda kamera her kaydet/yükle turunda
// bir adım daha geri kayardı — bu tam olarak yaşandı (16 → 18.87 → 21.35).
func _cam_dist_logical3(): float {
    if (_cam_mode3 != CAM_ORBIT) { return _cam_dist; }
    float q = _cam_dist * _cam_dist - _cam_height * _cam_height;
    if (q > 0.0) { return sqrt(q); }
    return 0.0;
}

// Kamera hedefi GEÇERLİ mi. Hedef silinince handle bayatlıyor ve kamera var
// olmayan bir cismi izlemeye devam ediyordu; ne onarılıyor ne söyleniyordu.
func camera_target_ok3d(): bool {
    if (_cam_target < 0) { return false; }
    return alive3(_cam_target);
}
func kamera_hedefi_gecerli3d(): bool { return camera_target_ok3d(); }

// Kamerayı ÇERÇEVELEMEYİ KORUYARAK yeniden kur. Mod düğmesi ile hedef
// düğmesi ikisi de bunu çağırıyor: her modun kendi kurucusu var ve onları
// doğrudan çağırmak, mesafe/yükseklik değerlerini modlar arasında
// kaybettirirdi (yörüngeye geçip geri dönmek kamerayı varsayılana atardı).
func _ed_cam_apply3(mode, target, dist, height) {
    float d = dist;
    float h = height;
    if (d < 0.5) { d = 0.5; }
    // Hedefin ADI biçime yazılacak tek şey — handle taşınabilir değil. Adsız
    // bir varlığı hedef yapmak, kaydedince bağın sessizce kopması demekti;
    // o yüzden editör hedefe ad VERİYOR. Ad etiketten türüyor ve
    // benzersizleştiriliyor: iki "player" olsa `find3d` ilkini bulurdu.
    if (target >= 0 && alive3(target) && _sc_nm_of3(target) == "") {
        rename3d(target, _ed_uniq_name3(_sc_tag_nm3(_e3[_slot_of3(target)].tag)));
    }
    _sc_cam_nm3 = "";
    if (target >= 0) { _sc_cam_nm3 = _sc_nm_of3(target); }
    if (mode == CAM_FPS) {
        camera_fps(target, _cam_eye3);
        return;
    }
    if (mode == CAM_ORBIT) { camera_orbit(target, d, h); return; }
    camera_follow(target, d, h);
}

// Hedef döngüsü: -1 (hedefsiz) → yaşayan varlıklar → başa. Hedefsiz durumun
// döngüde YER ALMASI gerekiyor; sahnedeki her cismi gezip de "hiçbiri"ye
// dönememek, yanlışlıkla hedef verildiğinde geri alınamaz olurdu.
func _ed_cam_next_target3(cur): int {
    int bas = 0;
    int s = _slot_of3(cur);
    if (s >= 0) { bas = s + 1; }
    int i = bas;
    while (i < length(_e3)) {
        if (_e3[i].alive == 1) { return _mk_handle3(i); }
        i = i + 1;
    }
    return 0 - 1;
}

// Hedefin panelde görünen adı.
// "hedef: " öneki ATILDI: düğme yarım sütunda (2x ölçekte ~11 karakter) ve
// önekle birlikte "hedef: SILINMIS" 15 karaktere çıkıyor, yani kırpılıyordu.
// Bölüm başlığı zaten KAMERA ve ipucu ne olduğunu söylüyor; önek bilgi
// taşımıyordu, yer yiyordu. Varlık ADI uzun olabilir ve kırpılması normal —
// asıl anlatılması gereken iki DURUM (hedefsiz / silinmiş) artık sığıyor.
func _ed_cam_target_nm3(): str {
    if (_cam_target < 0) { return "hedefsiz"; }
    if (alive3(_cam_target) == false) { return "SILINDI"; }
    str n = _sc_nm_of3(_cam_target);
    if (n == "") { n = _sc_tag_nm3(_e3[_slot_of3(_cam_target)].tag); }
    return n;
}

func _ed_cam_idbase3(): int { return 9780; }

// Bakış hassasiyeti (derece / piksel). Fare ve dokunmatik ayrı ayarlanır.
func camera_sens3d(s) { _cam_sens3 = s; }
func kamera_hassasiyet3d(s) { camera_sens3d(s); }
func camera_touch_sens3d(s) { _cam_tsens3 = s; }
func kamera_dokunma_hassasiyet3d(s) { camera_touch_sens3d(s); }

// Kamerayı belirli bir açıya çevir (derece): yaw 0 = -Z'ye bakar,
// pitch + = yukarı bakar. Bölüm başında sahneyi çerçevelemek için.
func camera_look3d(yaw, pitch) { _cam_yaw3 = yaw; _cam_pitch3 = pitch; }
func kamera_bak3d(yaw, pitch) { camera_look3d(yaw, pitch); }
func camera_yaw3d(): float { return _cam_yaw3; }
func kamera_yon3d(): float { return _cam_yaw3; }
func camera_pitch3d(): float { return _cam_pitch3; }
func kamera_egim3d(): float { return _cam_pitch3; }
func camera_dist3d(): float { return _cam_dist; }
func kamera_mesafe3d(): float { return _cam_dist; }

// Tekerlek zoom sınırları (yörünge).
func camera_zoom3d(min_d, max_d) { _cam_min3 = min_d; _cam_max3 = max_d; }
func kamera_zoom3d(min_d, max_d) { camera_zoom3d(min_d, max_d); }

// İmleç kilidi: açıkken fare pencereye hapsolur ve bakış sürekli fareye bağlı
// olur (FPS'te varsayılan açık). Yörüngede açarsan sağ tuşa basmadan bakarsın.
func camera_lock3d(on) { if (on) { _cam_lock3 = 1; } else { _cam_lock3 = 0; } }
// Serbest fare bakışı (imleç kilidi). Kapalıyken kamera yalnız SAĞ TUŞ
// sürüklemesiyle, Q/E ile ve sağ çubukla döner.
func camera_mouse3d(on) { camera_lock3d(on); }
func fare_bakis3d(ac) { camera_lock3d(ac); }
func fare_hassasiyet3d(s) { camera_sens3d(s); }
func kamera_kilit3d(on) { camera_lock3d(on); }

// Kamera-duvar çarpışması (varsayılan AÇIK). Kapatınca kamera duvarların
// içinden geçer — geniş açık sahnelerde tarama maliyetinden kaçmak isteyen
// ya da eski görüntüyü birebir korumak isteyen oyunlar için.
func camera_collide3d(on) { if (on) { _cam_collide3 = 1; } else { _cam_collide3 = 0; } }
func kamera_carpisma3d(on) { camera_collide3d(on); }
// Motorun varsayılan ışığını aç/kapat (setup'tan ÖNCE, kayıt aşamasında çağır).
// Kapatınca her şey eski düz-renk görünümünde çizilir.
func lights3d(on) { if (on) { _lights3 = 1; } else { _lights3 = 0; } }
func isik3d(on)   { lights3d(on); }
// Gölgeleri aç/kapat (setup'tan ÖNCE). Işık kapalıyken zaten çizilmezler.
func shadows3d(on) { if (on) { _shadows3 = 1; } else { _shadows3 = 0; } }
func golge3d(on)   { shadows3d(on); }
// Gölge alanını daralt/genişlet. Sahnen küçükse küçült — gölge keskinleşir.
func shadow_area3d(a) { _shadow_area3 = a; }
func golge_alani3d(a) { shadow_area3d(a); }

// Gradyan gökyüzünü aç (setup'tan ÖNCE): top = tepe, bottom = ufuk rengi.
//   sky3d(rgb(58, 116, 200), rgb(196, 220, 240));
func sky3d(top, bottom) { _sky3 = 1; _sky_top3 = top; _sky_bot3 = bottom; }
func gokyuzu3d(top, bottom) { sky3d(top, bottom); }
func sky3d_off() { _sky3 = 0; }
func gokyuzu3d_kapat() { sky3d_off(); }

// Zemini dokula. tile = doku, zemin boyunca kaç kez tekrarlansın (ölçek hissi
// buradan gelir). Doku verilince ızgara çizgileri çizilmez — doku zaten
// yüzeyin ölçeğini gösteriyor.
//   int t = checker(128, 128, 8, rgb(158,166,176), rgb(120,128,140));
//   ground_texture3d(t, 24.0);
func ground_texture3d(t, tile) { _ground_tex3 = t; _ground_tile3 = tile; }
// Zemin dokusunu YOLDAN kur — kaydedilebilen sürüm. `ground_texture3d` ham
// handle aldığı için yolu bilemez ve sahneye yazılamaz.
func ground_texture_src3d(path, tile) {
    _ground_tex_src3 = path;
    _ground_tile3 = tile;
    if (path == "") { _ground_tex3 = 0 - 1; }
    else            { _ground_tex3 = asset_texture3d(path); }
}
func zemin_doku_yol3d(yol, tile) { ground_texture_src3d(yol, tile); }
func ground_texture_path3d(): str { return _ground_tex_src3; }
func zemin_doku3d(t, tile)     { ground_texture3d(t, tile); }

// Mesafe sisi (0 = kapalı, 0.02 hafif pus, 0.06 yoğun). Rengi gökyüzünün
// ufkundan alınır, o yüzden sky3d() ile birlikte kullanılmalı — yoksa
// uzaktaki cisimler koyu varsayılan ufuk rengine karışır.
func fog3d(density) { _fog3 = density; }
func sis3d(density) { fog3d(density); }

// ===========================================================================
// Gündüz-gece döngüsü
// ===========================================================================
// Gökyüzü sabitti: sahne hangi saatte kurulduysa sonsuza kadar o saatte
// kalıyordu. Oysa gereken her şey zaten vardı — `sun()`, `ambient_light()`,
// `sky()` ve `fog_sky()` hepsi her kare çağrılabiliyor ve ucuz (gökyüzü
// kubbesi bir kez kuruluyor, sonrası yalnız birkaç float yazımı). Yani bu
// katman tamamen Tulpar tarafında: tek satır C eklenmedi.
//
// Gölge bedava geliyor: gölge haritası 0 numaralı ışığın yönünden türüyor,
// o da güneşle birlikte dönüyor. Sabah uzun gölgeler, öğlen kısa.
int   _dn_on3    = 0;
float _dn_len3   = 120.0;   // tam bir gün kaç saniye sürsün
float _dn_h3     = 12.0;    // günün saati, 0..24
int   _dn_frozen3 = 0;      // saat ilerlemesin (sabit "altın saat" isteyen oyun)
// Yıldızlar: gökyüzü shader'ında prosedürel üretiliyor (sıfır çizim çağrısı).
// -1 = OTOMATİK, yani gece çöktükçe açılır; 0..1 = elle sabitlenmiş yoğunluk.
float _stars3 = 0.0 - 1.0;

// Paketli renk (r*2^24 + g*2^16 + b*2^8 + a) bileşenleri. Hem gökyüzü
// karışımı hem de saydamlaştırma bunları kullanıyor.
func _col_r3(c): int { return mod(toInt(c / 16777216), 256); }
func _col_g3(c): int { return mod(toInt(c / 65536), 256); }
func _col_b3(c): int { return mod(toInt(c / 256), 256); }

func _dn_mix3(a, b, t): int {
    float k = t;
    if (k < 0.0) { k = 0.0; }
    if (k > 1.0) { k = 1.0; }
    int r = toInt(_col_r3(a) * 1.0 + (_col_r3(b) - _col_r3(a)) * k);
    int g = toInt(_col_g3(a) * 1.0 + (_col_g3(b) - _col_g3(a)) * k);
    int b2 = toInt(_col_b3(a) * 1.0 + (_col_b3(b) - _col_b3(a)) * k);
    return rgb(r, g, b2);
}

// Güneşin yüksekliği: +1 tam tepe, 0 ufuk, -1 ayaklar altında.
// Şafak 6, öğlen 12, gün batımı 18, gece yarısı 0.
func sun_height3d(): float { return sin((_dn_h3 - 6.0) / 12.0 * 3.14159265); }
func gunes_yuksekligi3d(): float { return sun_height3d(); }

// Güneşin doğu-batı bileşeni: +1 doğu (şafak), -1 batı (gün batımı).
// Güneş saati / pusula gibi şeyler için, ve ışık yönünün sürekliliğini
// sınayabilmek için.
func sun_east3d(): float { return cos((_dn_h3 - 6.0) / 12.0 * 3.14159265); }
func gunes_dogu3d(): float { return sun_east3d(); }

// Işığın gerçekte kullanılan yüksekliği: ufka İNMEZ. Yatay ışık gölge
// haritasını dejenere ediyor, ayrıca eski "gece = karşı yönden ay" kuralı
// ufuk geçişinde yönü 180° atlatıyordu. Saf fonksiyon — test edilebilir.
func _dn_elev3(ey): float { if (ey < 0.22) { return 0.22; } return ey; }
func light_height3d(): float { return _dn_elev3(sun_height3d()); }

func is_night3d(): bool { return sun_height3d() <= 0.0; }
func gece_mi3d(): bool { return is_night3d(); }

func time_of_day3d(): float { return _dn_h3; }
func gunun_saati3d(): float { return time_of_day3d(); }

// Döngüyü aç. saniye = tam bir günün gerçek süresi.
func daynight3d(seconds_per_day) {
    _dn_on3 = 1;
    _dn_len3 = seconds_per_day * 1.0;
    _dn_frozen3 = 0;
}
func gunduz_gece3d(saniye) { daynight3d(saniye); }
func daynight_off3d() { _dn_on3 = 0; }

// Yıldız yoğunluğu. Varsayılan OTOMATİK: gündüz-gece döngüsü açıkken gece
// çöktükçe beliriyorlar, gündüz kayboluyorlar. Elle sabitlemek isteyen
// `yildiz3d_sabit(0.8)` çağırır (döngüsüz sahnede tek yol budur).
// Otomatik kipte İSTENEN yıldız yoğunluğu. Saf ve okunabilir olması bilerek:
// shader'a yazılan değer geri okunamıyor, testin sınayabileceği tek şey KARAR.
float _dn_day3 = 1.0;    // son hesaplanan gündüzlük (0 gece, 1 tam gündüz)
func _dn_star_want3(): float { return 1.0 - _dn_day3; }

// Shader'a GİDECEK değer: elle sabitlenmişse o, değilse otomatik.
// Tek karar noktası olması bilerek — shader'a yazılan geri okunamadığı için
// testin tutunabileceği yer burası. (İlk sürümde karar `if` ile dağıtılmıştı
// ve "elle sabitleme yok sayılıyor" bozması hiçbir testi kızartmıyordu.)
func _dn_star_out3(): float {
    if (_stars3 >= 0.0) { return _stars3; }
    return _dn_star_want3();
}

// Bulut kapsaması 0..1 (0 = açık gökyüzü). Prosedürel: gökyüzü kubbesinin
// shader'ında üretiliyor, ayrı çizim yok — dağlar bulutları doğru örtüyor
// (2B çizilseydi dağların ÖNÜNE düşerlerdi, yıldızlarla aynı gerekçe).
float _cloud3 = 0.0;

func clouds3d(coverage) {
    _cloud3 = coverage * 1.0;
    if (_cloud3 < 0.0) { _cloud3 = 0.0; }
    if (_cloud3 > 1.0) { _cloud3 = 1.0; }
    sky_clouds3d(_cloud_out3());
}
func bulut3d(kapsama) { clouds3d(kapsama); }
func clouds_now3d(): float { return _cloud3; }

// Gündüz-gece açıkken bulutlar geceye doğru SÖNÜYOR: shader onları beyaza
// karıştırıyor ve gece beyaz bulut yanlış görünürdü. Karar SAF bir fonksiyonda
// ki penceresiz sınanabilsin — yıldızlarda "shader'a giden değer" sınanmadığı
// için bir bozma kaçmıştı, aynı hatayı tekrarlamıyoruz.
func _cloud_out3(): float {
    if (_dn_on3 == 0) { return _cloud3; }
    return _cloud3 * (0.15 + 0.85 * _dn_day3);
}

func stars_auto3d() { _stars3 = 0.0 - 1.0; }
func yildiz_oto3d() { stars_auto3d(); }
func stars3d(amount) { _stars3 = amount * 1.0; sky_stars3d(_stars3); }
func yildiz3d_sabit(miktar) { stars3d(miktar); }
func gunduz_gece_kapat3d() { daynight_off3d(); }

// Saati doğrudan ayarla (0..24). Döngü kapalıyken de çalışır: "sahnem hep
// gün batımında olsun" isteyen oyun saati kurup dondurur.
func set_time3d(hour) {
    _dn_h3 = hour * 1.0;
    while (_dn_h3 >= 24.0) { _dn_h3 = _dn_h3 - 24.0; }
    while (_dn_h3 < 0.0) { _dn_h3 = _dn_h3 + 24.0; }
    _dn_on3 = 1;
}
func saati_ayarla3d(saat) { set_time3d(saat); }
func freeze_time3d(on) { if (on) { _dn_frozen3 = 1; } else { _dn_frozen3 = 0; } }
func saati_dondur3d(ac) { freeze_time3d(ac); }

// Saati ilerlet ve gökyüzü/ışık/sisi o saate göre kur.
func _s3_daynight(dt) {
    if (_dn_on3 == 0) { return; }
    if (_dn_frozen3 == 0 && _dn_len3 > 0.0) {
        _dn_h3 = _dn_h3 + dt * 24.0 / _dn_len3;
        while (_dn_h3 >= 24.0) { _dn_h3 = _dn_h3 - 24.0; }
    }
    float ang = (_dn_h3 - 6.0) / 12.0 * 3.14159265;
    float ex = cos(ang);          // doğu-batı bileşeni
    float ey = sin(ang);          // yükseklik

    // Alacakaranlık ağırlığı: ufka yakınken 1, güneş yükselince 0. Şafak ve
    // gün batımı renklerini bu sürüyor.
    float dusk = 1.0 - abs_f3(ey) / 0.30;
    if (dusk < 0.0) { dusk = 0.0; }
    // Gündüzlük: 0 gece, 1 tam gündüz.
    float day = ey / 0.30;
    if (day < 0.0) { day = 0.0; }
    if (day > 1.0) { day = 1.0; }
    _dn_day3 = day;

    // Işığın rengi gün boyu sürekli: şafak/gün batımında sıcak turuncu,
    // öğlen beyaza, gece sönük maviye gider. Ufuk geçişinde (ey ~ 0) iki dal
    // da SICAK renge yakınsıyor, yani renk atlamıyor.
    int warm = rgb(255, 150, 90);
    int noon = rgb(255, 246, 224);
    int moon = rgb(90, 105, 150);
    int sc = _dn_mix3(warm, noon, day);
    if (ey <= 0.0) {
        float night = (0.0 - ey) / 0.30;
        if (night > 1.0) { night = 1.0; }
        sc = _dn_mix3(warm, moon, night);
    }
    // Işık yönü gün boyu KESİNTİSİZ dönüyor ve yüksekliği ufka inmiyor.
    // İkisi de gözle görülür sebeplerden:
    //   1. Gece ışığını "güneşin tam karşısındaki ay" yapmak, güneş ufku
    //      geçtiği KAREDE yönü 180° atlatıyordu — gölgeler tek karede öbür
    //      tarafa sıçrıyordu. Kullanıcının şafak/gün batımında gördüğü
    //      "ekran yeniden çizildi" hissinin sebebi buydu.
    //   2. Yatay ışık gölge haritasını dejenere ediyor: gölgeler ufka doğru
    //      uzayıp titriyor. Tam da o iki an.
    // Gece/gündüz farkını artık YÖN değil, renk ve ortam ışığı taşıyor.
    float ly = ey;
    if (ly < 0.22) { ly = 0.22; }
    sun(0.0 - ex, 0.0 - ly, 0.0 - 0.25, sc);

    // Ortam ışığı: gece neredeyse yok, gündüz normal.
    int amb_n = rgb(16, 20, 38);
    int amb_d = rgb(46, 50, 66);
    ambient_light(_dn_mix3(amb_n, amb_d, day));

    // Gökyüzü: gece → gündüz, üstüne alacakaranlık karışımı.
    int top_n = rgb(8, 10, 28);      int bot_n = rgb(22, 26, 54);
    int top_d = rgb(40, 90, 170);    int bot_d = rgb(150, 190, 230);
    int top = _dn_mix3(top_n, top_d, day);
    int bot = _dn_mix3(bot_n, bot_d, day);
    if (dusk > 0.0) {
        top = _dn_mix3(top, rgb(70, 50, 110), dusk * 0.8);
        bot = _dn_mix3(bot, rgb(255, 140, 70), dusk);
    }
    sky(top, bot);
    // Yıldızlar geceyle birlikte. `day` 0 gece, 1 tam gündüz olduğu için
    // tersi doğrudan yoğunluk veriyor; alacakaranlıkta da yumuşak sönüyorlar.
    sky_stars3d(_dn_star_out3());
    sky_clouds3d(_cloud_out3());
    // Sis rengini ufuktan YENİDEN al: play3d başlangıçta bir kez kuruyor,
    // güncellenmezse sis bütün gün şafak rengiyle kalırdı.
    if (_fog3 > 0.0) { fog_sky(_fog3); }
}

// ===========================================================================
// Tanılama: kayıt (log) + ekran örtüsü + gözcüler
// ===========================================================================
// Unity'nin Console'u / Unreal'in `stat` komutları gibi: oyunun İÇİNDE ne olup
// bittiğini görmek için. Bu katmanın var olma sebebi somut — bir çarpışma
// hatası masaüstünde görülüyor ama penceresiz testlerde YENİDEN ÜRETİLEMİYORDU.
// Tahmin yürütmek yerine ölçmek gerekiyordu.
//
// Üç parça:
//   1. KAYIT — seviyeli, kategorili, tekrar bastırmalı halka tampon.
//   2. ÖRTÜ  — ekranda canlı durum (F1) + son kayıtlar.
//   3. GÖZCÜ — her kare DEĞİŞMEZLERİ denetler ve bozulanı bağırarak bildirir.
//      Asıl değer burada: "duvarın içinden geçiyorum" gibi bir şikâyet, artık
//      "hangi kare, hangi entity, ne kadar batmış" cevabına dönüşüyor.
int LOG_ERR   = 0;
int LOG_WARN  = 1;
int LOG_INFO  = 2;
int LOG_TRACE = 3;

int   _lg_on    = 0;        // kayıt açık mı
int   _lg_lvl   = 2;        // bu seviyeye kadar kaydet
int   _lg_echo  = 1;        // konsola da bas
int   _lg_ovl   = 0;        // ekran örtüsü
int   _lg_watch = 0;        // gözcüler
int   _LG_CAP   = 240;      // halka tampon boyu
array _lg_txt = [];
array _lg_sev = [];
int   _lg_n   = 0;          // toplam kayıt (tampon sarabilir)

// Tekrar bastırma: aynı anahtar saniyede bir kez. Çarpışma hatası 60 FPS'te
// saniyede 60 satır üretir ve gerçek bilgiyi boğar.
array _lg_key = [];
array _lg_t   = [];
array _lg_cnt = [];

func _lg_now(): float { return elapsed(); }

func log_level3d(n) { _lg_lvl = n; }
func log_seviye3d(n) { log_level3d(n); }
func log_echo3d(on) { if (on) { _lg_echo = 1; } else { _lg_echo = 0; } }

// Kaydı aç. Örtü ve gözcüler de birlikte gelir — tanılama isteyen hepsini ister.
func debug3d(on) {
    if (on) { _lg_on = 1; _lg_ovl = 1; _lg_watch = 1; }
    else { _lg_on = 0; _lg_ovl = 0; _lg_watch = 0; }
}
func hata_ayikla3d(ac) { debug3d(ac); }
func debug_overlay3d(on) { if (on) { _lg_ovl = 1; } else { _lg_ovl = 0; } }
func ekran_log3d(ac) { debug_overlay3d(ac); }
func watch3d(on) { if (on) { _lg_watch = 1; } else { _lg_watch = 0; } }
func gozcu3d(ac) { watch3d(ac); }
func debug_on3d(): bool { return _lg_on == 1; }

// HALKA TAMPONDA SIRA. Tampon dolduktan sonra dizi sırası KRONOLOJİK sıra
// DEĞİL: `_lg_push` en eskinin üstüne yazıyor, yani en eski kayıt bir
// sonraki yazma yuvasında duruyor. Konsol paneli diziyi ham sırayla
// okuyordu ve 240. satırdan sonra kayıt karışık görünüyordu — hiçbir hata
// mesajı vermeden, yalnız "sıra tuhaf" diye.
func _lg_count3(): int { return length(_lg_txt); }
func _lg_idx3(i): int {
    int dolu = length(_lg_txt);
    if (i < 0 || i >= dolu) { return 0 - 1; }
    if (dolu < _LG_CAP) { return i; }
    return mod(_lg_n + i, _LG_CAP);
}

func _lg_sev_ad(sev): str {
    if (sev == LOG_ERR)  { return "[HATA] "; }
    if (sev == LOG_WARN) { return "[UYARI] "; }
    if (sev == LOG_TRACE) { return "[IZ] "; }
    return "[BILGI] ";
}

func _lg_push(sev, msg) {
    if (_lg_on == 0) { return; }
    if (sev > _lg_lvl) { return; }
    str line = _lg_sev_ad(sev) + msg;
    if (length(_lg_txt) < _LG_CAP) {
        push(_lg_txt, line); push(_lg_sev, sev);
    } else {
        int slot = mod(_lg_n, _LG_CAP);
        _lg_txt[slot] = line; _lg_sev[slot] = sev;
    }
    _lg_n = _lg_n + 1;
    if (_lg_echo == 1) { print(line); }
}

// Anahtarlı kayıt: aynı anahtar `sec` saniye içinde yalnız bir kez geçer,
// bastırılan tekrarlar sayılıp bir sonraki satırda bildirilir.
func _lg_once(sev, key, msg, sec) {
    if (_lg_on == 0) { return; }
    if (sev > _lg_lvl) { return; }
    float now = _lg_now();
    int i = 0;
    int n = length(_lg_key);
    while (i < n) {
        if (_lg_key[i] == key) {
            if (now - _lg_t[i] < sec) {
                _lg_cnt[i] = _lg_cnt[i] + 1;
                return;
            }
            str ek = "";
            if (_lg_cnt[i] > 0) { ek = "  (+" + toString(_lg_cnt[i]) + " tekrar)"; }
            _lg_t[i] = now; _lg_cnt[i] = 0;
            _lg_push(sev, msg + ek);
            return;
        }
        i = i + 1;
    }
    push(_lg_key, key); push(_lg_t, now); push(_lg_cnt, 0);
    _lg_push(sev, msg);
}

func log3d(msg) { _lg_push(LOG_INFO, msg); }
func log_warn3d(msg) { _lg_push(LOG_WARN, msg); }
func log_err3d(msg) { _lg_push(LOG_ERR, msg); }
// İZ seviyesi vardı ama yazacak bir fonksiyon YOKTU: `log_level3d(3)`
// açılabiliyor, o seviyeye kayıt düşülemiyordu.
func log_trace3d(msg) { _lg_push(LOG_TRACE, msg); }
func kayit3d(msg) { log3d(msg); }
func iz3d(msg) { log_trace3d(msg); }
func uyari3d(msg) { log_warn3d(msg); }
func hata3d(msg) { log_err3d(msg); }

// Halka tamponu dosyaya yaz. Oyun kapanırken de otomatik çağrılabilir.
func log_dump3d(path) {
    str all = "";
    // Halka aritmetiği `_lg_idx3`'te, tek yerde: burada ikinci bir kopya
    // vardı ve konsol paneli ÜÇÜNCÜ bir (yanlış) kopya yazmıştı.
    int i = 0;
    while (i < _lg_count3()) {
        all = all + _lg_txt[_lg_idx3(i)] + "\n";
        i = i + 1;
    }
    save_data(path, all);
}
func log_kaydet3d(yol) { log_dump3d(yol); }

func _lg_f2(v): str {
    // İki ondalık — ham float ekranda 7 hane basıyor ve okunmuyor.
    float k = v * 100.0;
    int r = toInt(k);
    float f = r * 0.01;
    return toString(f);
}

// ---- Gözcüler: kare sonunda DEĞİŞMEZLERİ denetle ---------------------------
// Bu, log sisteminin asıl işi. Bir şikâyeti ("duvardan geçiyorum") ölçülebilir
// bir olguya çeviriyor: hangi entity, ne kadar batmış, hangi karede.
int _w_pen = 0;         // bu kare tespit edilen batma sayısı
float _w_pen_max = 0.0; // en derin batma
int _w_cam_in = 0;      // kamera geometrinin içinde mi

func _s3_watch3() {
    if (_lg_watch == 0) { return; }
    int n = length(_e3);
    _w_pen = 0; _w_pen_max = 0.0;
    // 1) Hareketli katı gövde, statik katının İÇİNDE kalmış mı?
    // Çarpışma çözümünden SONRA bunun sıfır olması gerekiyor.
    int a = 0;
    while (a < n) {
        Ent3 ea = _e3[a];
        if (_is_solid3(ea) && !_is_static_solid3(ea)) {
            int b = 0;
            while (b < n) {
                if (a != b && !_bp_far3(a, b)) {
                    Ent3 eb = _e3[b];
                    if (_is_solid3(eb) && _is_static_solid3(eb)) {
                        if (_mtv3(a, b)) {
                            float d = sqrt(_mtv_x * _mtv_x + _mtv_y * _mtv_y
                                           + _mtv_z * _mtv_z);
                            if (d > 0.01) {
                                _w_pen = _w_pen + 1;
                                if (d > _w_pen_max) { _w_pen_max = d; }
                                _lg_once(LOG_ERR, "pen" + toString(a) + "_" + toString(b),
                                    "BATMA: entity#" + toString(a) + " (etiket "
                                    + toString(ea.tag) + ") statik#" + toString(b)
                                    + " icinde, derinlik " + _lg_f2(d)
                                    + " @ (" + _lg_f2(ea.x) + "," + _lg_f2(ea.y)
                                    + "," + _lg_f2(ea.z) + ")", 1.0);
                            }
                        }
                    }
                }
                b = b + 1;
            }
        }
        a = a + 1;
    }
    // 2) Oyuncu zeminin altına düştü mü?
    int ts = _slot_of3(_cam_target);
    if (ts >= 0) {
        Ent3 t = _e3[ts];
        float floor_y = _floor_at3(t.x, t.z);
        if (t.y - t.sy * 0.5 < floor_y - 0.5) {
            _lg_once(LOG_ERR, "under", "ZEMIN ALTI: hedef y=" + _lg_f2(t.y)
                + " zemin=" + _lg_f2(floor_y), 1.0);
        }
    }
}

// Kamera geometrinin içinde mi? (Ayrı, çünkü kamera çizimden hemen önce kurulur.)
func _s3_watch_cam3(cx, cy, cz) {
    if (_lg_watch == 0) { return; }
    _w_cam_in = 0;
    int n = length(_e3);
    int i = 0;
    while (i < n) {
        Ent3 e = _e3[i];
        if (e.alive == 1 && e.tag == TAG_WALL) {
            float hx = e.sx * 0.5; float hy = e.sy * 0.5; float hz = e.sz * 0.5;
            // Yaw ve şekil FARKINDA olmalı. İlk sürüm eksen-hizalı kutu
            // varsayıyordu ve dönük duvarla silindir için YANLIŞ ALARM
            // veriyordu (kullanıcının kaydındaki uyarıların çoğu buydu).
            // Yalan söyleyen bir tanılama, tanılama olmaktan çıkar.
            float rx = cx - e.x;
            float rz = cz - e.z;
            if (abs_f3(e.yaw) > 0.01) {
                float c = cos(e.yaw * DEG2RAD3);
                float sn = sin(e.yaw * DEG2RAD3);
                float nrx = rx * c - rz * sn;
                float nrz = rx * sn + rz * c;
                rx = nrx; rz = nrz;
            }
            int ic = 0;
            if (_is_round3(e)) {
                // silindir: XZ'de daire, Y'de aralık
                if (rx * rx + rz * rz < hx * hx && abs_f3(cy - e.y) < hy) { ic = 1; }
            } else {
                if (abs_f3(rx) < hx && abs_f3(cy - e.y) < hy && abs_f3(rz) < hz) { ic = 1; }
            }
            if (ic == 1) {
                _w_cam_in = 1;
                _lg_once(LOG_WARN, "camin" + toString(i),
                    "KAMERA GEOMETRIDE: duvar#" + toString(i)
                    + " icinde @ (" + _lg_f2(cx) + "," + _lg_f2(cy) + ","
                    + _lg_f2(cz) + ")", 1.0);
            }
        }
        i = i + 1;
    }
}

// ---- Ekran örtüsü ----------------------------------------------------------
func _s3_overlay3() {
    if (_lg_ovl == 0) { return; }
    float w = _win_w * 0.42;
    if (w < 300.0) { w = 300.0; }
    rect(_win_w - w - 8.0, 8.0, w, _win_h - 16.0, rgba(6, 8, 14, 205));
    int x = toInt(_win_w - w);
    int y = 16;
    text("TANILAMA  (F1 kapat)", x, y, 18, rgb(120, 220, 255));
    y = y + 24;
    text("FPS " + toString(get_fps()) + "   entity " + toString(alive_count3d())
         + "/" + toString(length(_e3)), x, y, 16, RAYWHITE);
    y = y + 20;
    int ts = _slot_of3(_cam_target);
    if (ts >= 0) {
        Ent3 t = _e3[ts];
        text("poz  " + _lg_f2(t.x) + " " + _lg_f2(t.y) + " " + _lg_f2(t.z),
             x, y, 16, GOLD); y = y + 18;
        text("hiz  " + _lg_f2(t.vx) + " " + _lg_f2(t.vy) + " " + _lg_f2(t.vz),
             x, y, 16, GOLD); y = y + 18;
        str g = "havada";
        if (t.grounded == 1) { g = "zeminde"; }
        text("durum " + g + "   zemin " + _lg_f2(_floor_at3(t.x, t.z)),
             x, y, 16, GOLD); y = y + 20;
    }
    // Kamera
    str md = "sabit";
    if (_cam_mode3 == CAM_ORBIT) { md = "yorunge"; }
    if (_cam_mode3 == CAM_FPS)   { md = "fpv"; }
    text("kamera " + md + "  mesafe " + _lg_f2(_cam_cur3) + "/" + _lg_f2(_cam_dist),
         x, y, 16, SKYBLUE); y = y + 18;
    text("yukselme " + _lg_f2(_cam_lift3 * RAD2DEG3) + " derece", x, y, 16, SKYBLUE);
    y = y + 18;
    int fadec = 0;
    int fi = 0;
    while (fi < length(_fade3)) { if (_fade3[fi] == 1) { fadec = fadec + 1; } fi = fi + 1; }
    text("saydam " + toString(fadec) + "   bolge " + toString(trigger_count3d()),
         x, y, 16, SKYBLUE); y = y + 20;
    // Gözcü durumu — kırmızıysa gerçek bir değişmez bozulmuş demektir.
    int wc = rgb(120, 240, 140);
    str ws = "gozcu: temiz";
    if (_w_pen > 0) {
        wc = rgb(255, 90, 90);
        ws = "BATMA x" + toString(_w_pen) + "  derinlik " + _lg_f2(_w_pen_max);
    }
    if (_w_cam_in == 1) { wc = rgb(255, 170, 60); ws = ws + "  KAMERA ICERIDE"; }
    text(ws, x, y, 16, wc); y = y + 24;
    // Son kayıtlar
    text("--- son kayitlar ---", x, y, 14, rgb(150, 160, 180)); y = y + 18;
    int cap = length(_lg_txt);
    int show = 14;
    int k = 0;
    while (k < show && k < cap) {
        int idx = mod(_lg_n - 1 - k + _LG_CAP * 4, cap);
        int sev = _lg_sev[idx];
        int c = rgb(200, 205, 215);
        if (sev == LOG_ERR)  { c = rgb(255, 110, 110); }
        if (sev == LOG_WARN) { c = rgb(255, 200, 90); }
        text(_lg_txt[idx], x, y, 13, c);
        y = y + 15;
        k = k + 1;
    }
}

// ---- Yönetilen döngü -------------------------------------------------------
func play3d() {
    // Pencere BOYUTLANDIRILABİLİR. Bayrak `window()`'DAN ÖNCE kurulmak
    // zorunda (raylib sözleşmesi) — sonradan kurulan bayrak pencereyi
    // boyutlandırılabilir yapmıyor ve işletim sisteminin BÜYÜTME düğmesi
    // ölü kalıyor. Kullanıcı bildirdi: editör tam ekran yapılamıyor,
    // pencere boyutu değiştirilemiyordu.
    //
    // scene3d için güvenli: 3B sahne çözünürlükten bağımsız çiziliyor,
    // editör yerleşimi zaten `screen_width()`'ten türüyor ve sahne
    // görünümünün render hedefi `_ed_rt_sync3` ile yeniden kuruluyor.
    window_resizable(true);
    if (!window(_win_w, _win_h, _win_title)) { return; }
    set_fps(60);
    // Işıklandırma VARSAYILAN AÇIK — motoru kullanan oyun sıfır konfigürasyonla
    // düz renkli kutular yerine gölgeli yüzeyler görsün. Kapatmak için oyun
    // kodunda isik3d(false) çağır; kendi ışığını kurmak istersen setup içinde
    // sun()/point_light() çağırman yeter (bunlar varsayılanı ezer).
    if (_lights3 == 1) {
        lights_on();
        sun(0.0 - 0.55, 0.0 - 1.0, 0.0 - 0.35, rgb(255, 246, 224));
        ambient_light(rgb(46, 50, 66));
        // Gölgeler de varsayılan açık — cismin yerde durduğu hissi gölgeyle
        // gelir. Donanım kuramazsa tame sessizce ışıkla devam eder (oyun
        // çalışmaya devam eder, sadece gölgesiz), golge3d(false) ile kapat.
        if (_shadows3 == 1) {
            shadows_on();
            shadow_area(_shadow_area3);
        }
    }
    if (_sky3 == 1) { sky(_sky_top3, _sky_bot3); }
    // Sis, gökyüzü ayarlandıktan SONRA — rengini onun ufkundan alıyor.
    if (_fog3 > 0.0) { fog_sky(_fog3); }
    // Kalıcılığı PENCEREDEN SONRA yeniden yükle — koşul yok, idempotent.
    // Android'de dosya erişimi asset manager'a bağlı ve o ancak InitWindow ile
    // kuruluyor; `kayit_ac3d()` üst düzeyde (yani buradan önce) çağrıldığında
    // okuma boş dönüyor. Tek doğru okuma anı burası. Masaüstünde ilk okuma
    // zaten çalışıyordu, o yüzden bu yalnız cihazda görünen bir farktı.
    if (_sav_on == 1) { _s3_load_progress(); }
    if (_has_setup3 == 1) { call(_setup3_fn); }
    // Bölüm kaydedildiyse EN KÜÇÜK numaralıyla başla. setup, bölümlerin ortak
    // kurulumu (kamera ayarı, ışık, kancalar) için kalır; sahneyi bölüm fn'i
    // kurar. Bölüm kaydedilmemişse motor eskisi gibi tek sahne olarak çalışır.
    if (length(_lvlN) > 0) {
        int lo = _lvlN[0];
        int li = 1;
        while (li < length(_lvlN)) {
            if (_lvlN[li] < lo) { lo = _lvlN[li]; }
            li = li + 1;
        }
        _lvl_pending3 = lo;
        _s3_apply_level();
    }
    // İmleç kilidi setup'tan SONRA kuruluyor — kamera modunu setup içinde
    // seçmek serbest (camera_fps varsayılan olarak kilidi ister).
    int _lock_was = 0 - 1;
    // ESC'yi raylib'in elinden al: varsayılanda ESC doğrudan pencereyi kapatır
    // ve running() false döner, yani duraklat menüsü KURULAMAZDI. Bundan sonra
    // ESC sıradan bir tuş; çıkış duraklat menüsünün "Cikis" düğmesinde.
    exit_key(K_NONE);

    // Yazarlık durumunu setup'tan (ve bölüm kurulumundan) SONRA, ilk kareden
    // ÖNCE yakala. Elle yazılmış bir oyunun "yazılmış hâli" tam olarak budur —
    // sahne dosyası olmasa da Oynat/Dur ve geri alma çalışsın diye gerekiyor.
    _ed_capture3();
    // Editör uygulaması: kamerayı sahnenin üstüne kur (editor3d bunu hedefe
    // göre yapıyor). Kurulum bittikten SONRA çağrılıyor, yoksa hedef yok.
    if (_ed_app3 == 1) {
        // Kayıtlı YERLEŞİM önce: ölçeği de taşıyor ve ölçek değişimi fontu
        // kendisi yeniden yüklüyor. "Motor yeniden açıldığında hatırlansın"
        // isteğinin karşılığı bu satır.
        editor_layout_load3d();
        // Font pencere kurulduktan SONRA yüklenebiliyor (raylib GPU dokusu
        // oluşturuyor); bu yüzden setup'ta değil burada.
        _ed_font_load3();
        editor3d(true);
    }

    while (running() && _s3_quit == 0) {
        // Pencere ölçüsünü HER KARE tazele. Menü, duraklat ve oyun-bitti
        // örtüleri `_win_w`/`_win_h` üzerinden konumlanıyor; onlar açılıştaki
        // değerde donsaydı büyütülen pencerede bütün arayüz sol üst köşeye
        // sıkışırdı. (Bu noktada hiçbir render hedefi bağlı değil, yani
        // `screen_width()` gerçek pencereyi veriyor.)
        _ed_sync_window3(screen_width(), screen_height());

        float dt = frame_time();
        if (dt <= 0.0) { dt = 0.0166667; }
        if (dt > 0.05) { dt = 0.05; }

        // Menü/duraklat açıkken imleç SERBEST olmalı, yoksa düğmelere
        // tıklanamaz (FPS modunda imleç kilitli geliyor).
        int want_lock = _s3_want_lock3();
        if (want_lock != _lock_was) { cursor_lock(want_lock); _lock_was = want_lock; }

        // ESC/P/GERİ → duraklat. exit_key(K_NONE) sayesinde ESC artık pencereyi
        // kapatmıyor, sıradan bir tuş; bu satırın mümkün olmasının tek sebebi o.
        // Girdi tamponları HER ŞEYDEN ÖNCE: duraklat kestirmesi de, oyunun
        // update'i de, menü adımı da bu karenin okumasını görsün.
        _read_touch3();     // dokunmatik (move3d/jump_pressed okur)
        _read_gamepad3();   // kol — aynı desen, bkz. _read_gamepad3

        // F1 tanılama örtüsünü aç/kapar. Duraklatmada da çalışır — donmuş bir
        // kareyi incelemek tam da gereken şey.
        // F2: kayıt tamponunu dosyaya dök — hata bildirirken eklenecek şey.
        if (key_pressed(K_F2)) {
            log_dump3d("scene3d_log.txt");
            _lg_push(LOG_INFO, "kayit dosyaya yazildi: scene3d_log.txt");
        }
        // F11: tam ekran. Oyunda da editörde de aynı tuş — sektör standardı.
        if (key_pressed(K_F11)) { tam_ekran(is_fullscreen() == false); }
        if (key_pressed(K_F1)) {
            if (_lg_ovl == 1) { _lg_ovl = 0; }
            else { _lg_on = 1; _lg_ovl = 1; _lg_watch = 1; }
        }

        // Duraklat kestirmesi EDİTÖRDE kapalı. ESC ve BACKSPACE inspector'daki
        // sayı alanının kendi tuşları: bir rakam silmek duraklat örtüsünü
        // açıyordu, sonra iki katman aynı fareyi paylaşıyordu.
        if (_s3_ui == UI_NONE && _game_over3 == 0 && _ed_on3 == 0) {
            if (_ed_app3 == 1) {
                // Editörde oynarken ESC OYUNU DURDURUR (DUR düğmesiyle aynı
                // şey) ve düzenlemeye döner. Önce yalnız imleci serbest
                // bırakıyordu; fare geri geliyor ama simülasyon sürüyordu ve
                // bu yarım bir davranıştı. Durdurmak hem beklenen hem daha az
                // durumlu: düzenlemeye dönünce imleç zaten serbest kalıyor.
                if (key_pressed(K_ESC)) { ed_stop3d(); }
            } else {
                if (key_pressed(K_ESC) || key_pressed(K_P) || key_pressed(K_BACKSPACE)
                    || _gp_start == 1) {
                    _s3_ui = UI_PAUSE;
                }
            }
        }

        // Menü açılınca imleç başa döner. UI durumundaki HER değişimde
        // yapılıyor, tek tek açılış noktalarında değil — oyun-bitti ekranı
        // `_s3_ui` üzerinden gelmiyor, o yüzden kapı burası.
        int ui_now = _s3_ui;
        if (_game_over3 == 1) { ui_now = 3; }
        if (ui_now != _s3_ui_prev3) { _s3_sel3 = 0; _s3_ui_prev3 = ui_now; }
        // Bakış, update'ten ÖNCE: oyunun update'i camera_yaw3d() okuyabilsin ve
        // move3d bu karenin kamera yönünü kullansın (bir kare gecikme olmaz).
        // Menü/duraklat açıkken oyun DONAR: bakış, update, fizik ve çarpışma
        // atlanır. Sahne yine çiziliyor (aşağıda), yalnız ilerlemiyor.
        // Editör: TAB ile geçilir ve oyunu DONDURUR. Editör bir oyun kipi
        // değil — fizik, davranışlar ve kurallar çalışırsa düzenlediğin şey
        // ayağının altından kayar.
        // TAB ile oyundan editöre geçiş KALDIRILDI. Editör artık ayrı bir
        // UYGULAMA (bkz. `editor_app3d`) — Unity/Unreal/Godot'ta da böyle:
        // editörü açarsın, oyun onun içindeki panelde koşar. Çalışan oyunun
        // üstüne kaplama açmak sektör standardı değil ve geçiş garip
        // duruyordu.
        int frozen = 0;
        if (_s3_ui != UI_NONE) { frozen = 1; }
        if (_ed_on3 == 1) { frozen = 1; }
        if (_ed_on3 == 1) { _s3_editor(dt); }

        if (frozen == 0) { _s3_camera_input(dt); }
        // Veri-davranislar update'ten ONCE: ayni varliga elle hareket3()
        // yazan oyun davranisin verdigi hizi EZEBILSIN. Kod veriyi yener.
        if (_game_over3 == 0 && frozen == 0) { _s3_behaviors(dt); }
        if (_has_update3 == 1 && _game_over3 == 0 && frozen == 0) { call(_update3_fn); }
        // Parçacıklar oyun bitse de sönmeye devam eder — son patlama ekranda
        // donup kalmasın (arcade'de de aynı gerekçe). Duraklatmada ise donar.
        if (frozen == 0) { _s3_particles(dt); }
        // Gökyüzü/ışık saati. Duraklatmada donuyor: oyun durduysa zaman da
        // durmalı, yoksa menüden çıkınca gece olmuş buluyorsun.
        if (frozen == 0) { _s3_daynight(dt); }
        // Sahne ışıklarının yuva ataması. DURAKLATMADA DA çalışıyor: seçim
        // kameranın yerine bağlı ve duraklatmada kamera hâlâ dönebiliyor —
        // donarsa oyuncu döndükçe yanlış üçlü yanık kalırdı. `_lights3`
        // kapalıysa motorun ışık sistemi zaten kapalı, yükleme anlamsız.
        if (_lights3 == 1 && length(_lt_x3) > 0) { _lt_upload3(); }
        if (_game_over3 == 0 && frozen == 0) {
            _s3_physics(dt);
            _s3_collision();
            // Bölgeler çarpışmadan SONRA: entity duvara itilmiş, nihai konumda.
            // Bölüm geçişinden ÖNCE: bir bölge kancası `bolum_gec3d()` çağırırsa
            // aşağıdaki satır onu bu karenin sonunda uygular.
            _s3_triggers();
            // Veri-kurallar: "bitince" denetimi carpismalardan SONRA, bu karede
            // toplanan son esya sayilmis olsun diye.
            _s3_rules();
            // Gözcü EN SONDA: bütün çözümler bittikten sonra hâlâ bozuk olan
            // bir değişmez varsa, o gerçekten bozuktur.
            _s3_watch3();
            // Bölüm geçişi KARE SONUNDA, çarpışma döngüsü bittikten sonra:
            // entity store'u döngünün ortasında silmek slot'ları ayağının
            // altından çekerdi. İstek nereden gelirse gelsin burada uygulanır.
            if (_lvl_pending3 >= 0) { _s3_apply_level(); }
        }

        frame_begin();
        clear(rgb(16, 18, 26));
        // Editör kabuğu açıkken sahne EKRANA değil bir RENDER TEXTURE'a
        // çiziliyor ve sonra görünüm paneline yerleştiriliyor. Doğrudan çizip
        // kırpmak yetmezdi: kamera izdüşümü pencerenin en-boy oranını kullanır,
        // görüntü ezik ve merkezi kaymış çıkardı.
        int _rt_on = 0;
        int _skip3d = 0;
        if (_ed_chrome3_on()) {
            _ed_rt_sync3();
            if (_ed_rt3 >= 0) { _rt_on = 1; render_to(_ed_rt3); clear(rgb(16, 18, 26)); }
            // Render texture kurulamadıysa sahneyi TAM EKRANA çizmiyoruz.
            // Eski davranış tam buydu ve sessizdi: sahne pencereyi dolduruyor,
            // paneller onun üstüne biniyor, görünüm paneli boş görünüyordu —
            // yani hata "editörün arkasında duran sahne" gibi görünüyordu.
            // Görünür şekilde başarısız olmak, sessizce yanlış çizmekten iyi.
            else { _skip3d = 1; }
        }
        _s3_camera(dt);
        if (_skip3d == 0) {
        space_begin();
            _s3_render();
            // Parçacıklar entity'lerden SONRA: billboard'lar saydam çizilir,
            // arkalarındaki cisimlerin önceden çizilmiş olması gerekir.
            _s3_particles_draw();
            // Editör çizimi EN SON ve 3B uzayın İÇİNDE: ızgara ile seçim
            // çerçevesi sahnenin derinliğini paylaşmalı, yoksa duvarın
            // arkasındaki seçim önde görünürdü.
            if (_ed_on3 == 1) { _s3_editor_draw(); }
        space_end();
        }

        // Oyunun kendi 2B katmanı — motorun HUD'ından ÖNCE, yani skor/can barı
        // oyunun çizdiklerinin üstünde kalır. Kabuk açıkken HUD sahne
        // GÖRÜNÜMÜNÜN içine çiziliyor (Unity'nin Game view'ı gibi).
        // Oyunun 2B katmanı (kendi HUD'ı + motorun skor/can barı + örtüler)
        // yalnız DÜZENLEME KİPİ KAPALIYKEN çiziliyor ve sahne görünümünün
        // İÇİNDE kalıyor — Unity'nin Game view'ı gibi. Editördeyken oyun
        // arayüzünü göstermek panellerin üstüne binerdi.
        if (_ed_on3 == 0) {
            if (_has_hud3 == 1) { call(_hud3_fn); }
            text(_win_title, 12, 10, 20, RAYWHITE);
            text("Skor: " + toString(_score3), 12, 34, 18, GOLD);
            if (length(_lvlN) > 0) {
                text("Bolum: " + toString(_cur_lvl3), 130, 34, 18, SKYBLUE);
            }
            // Can barı: kamera hedefinin (pratikte oyuncunun) canı varsa çizilir.
            // hpmax health3d ile kuruluyor; can sistemi kullanmayan oyunda 0 kalır
            // ve bar hiç görünmez — eski sahnelerin HUD'ı değişmez.
            int hud_s = _slot_of3(_cam_target);
            if (hud_s >= 0) {
                Ent3 he = _e3[hud_s];
                if (he.hpmax > 0) {
                    float frac = he.hp * 1.0 / (he.hpmax * 1.0);
                    if (frac < 0.0) { frac = 0.0; }
                    rect(12.0, 58.0, 160.0, 14.0, rgba(0, 0, 0, 120));
                    rect(12.0, 58.0, 160.0 * frac, 14.0, rgb(90, 220, 110));
                    rect_lines(12.0, 58.0, 160.0, 14.0, RAYWHITE);
                    text(toString(he.hp) + "/" + toString(he.hpmax), 180, 57, 16, RAYWHITE);
                }
            }

            // Dokunmatik ipucu (yalnız parmak ekrandayken): sol joystick + sağ ped.
            if (_tj_active == 1) {
                circle(toInt(_tj_cx), toInt(_tj_cy), 44.0, rgba(120, 140, 180, 60));
                circle(toInt(_tj_cx + _t_dx * 30.0), toInt(_tj_cy + _t_dz * 30.0), 20.0, rgba(200, 220, 255, 150));
                circle(toInt(_win_w) - 70, toInt(_win_h) - 70, 40.0, rgba(255, 210, 90, 80));
                if (_cam_mode3 == CAM_FIXED) {
                    text("ZIP", toInt(_win_w) - 92, toInt(_win_h) - 80, 18, RAYWHITE);
                } else {
                    // Bu modda sağ yarı bakış pedi: sürükle = bak, dokun = zıpla.
                    text("BAK", toInt(_win_w) - 92, toInt(_win_h) - 80, 18, RAYWHITE);
                }
            }
            // Örtüler HUD'ın üstünde: karartma oyunun kendi çizimini de kapatmalı.
            if (_s3_ui == UI_TITLE)      { _s3_title_draw(); }
            else if (_s3_ui == UI_LEVELS){ _s3_levels_draw(); }
            else if (_s3_ui == UI_SETTINGS) { _s3_set_draw(); }
            else if (_s3_ui == UI_PAUSE) { _s3_pause_draw(); }
            else if (_game_over3 == 1)   { _s3_over_draw(); }
            // Tanılama HER ŞEYİN ÜSTÜNDE: menü örtüsü açıkken de okunabilmeli.
            _s3_overlay3();
        }

        // Sahne dokusunu panele yerleştir, sonra editör kabuğunu ekrana çiz.
        if (_rt_on == 1) {
            render_to_screen();
            render_draw(_ed_rt3, _ed_view_x3(), _ed_view_y3());
        }
        _s3_editor_hud();

        frame_end();

        // Girdi çizimden SONRA okunuyor: düğmeler bu karede zaten çizilmiş
        // oldu, yani oyuncunun tıkladığı şey ekranda gördüğü şeyle aynı.
        if (_s3_ui == UI_TITLE)        { _s3_menu_act3(0, _s3_title_step()); }
        else if (_s3_ui == UI_LEVELS)  { _s3_menu_act3(3, _s3_levels_step()); }
        else if (_s3_ui == UI_SETTINGS){ _s3_menu_act3(4, _s3_set_step()); }
        else if (_s3_ui == UI_PAUSE)   { _s3_menu_act3(1, _s3_pause_step()); }
        else if (_game_over3 == 1)     { _s3_menu_act3(2, _s3_over_step()); }
        if (_s3_quit == 1) { break; }
    }
    // Döngü BİTTİ: ya pencere kapatıldı ya menüden çıkıldı. Kaydedilmemiş iş
    // varsa burada yakalanıyor — kapanışı iptal edemediğimiz için elimizdeki
    // tek an bu.
    ed_recovery_save3d();
    close_window();
}

// ---- Türkçe alias'lar ------------------------------------------------------
func uret3(x, y, z, sx, sy, sz, color, shape, tag): int { return spawn3(x, y, z, sx, sy, sz, color, shape, tag); }
func oldur3(i) { kill3d(i); }
func hareket3(i, speed) { move3d(i, speed); }
func zipla3(i, force) { jump3d(i, force); }
func ziplandi(): bool { return jump_pressed(); }
func skor3_ekle(n) { score3d_add(n); }
func ben3(): int { return me3d(); }
func oteki3(): int { return other3d(); }
func sahne3d(w, h, title) { scene3d(w, h, title); }
func kurulumda3(fn) { on_setup3d(fn); }
func her_kare3(fn) { on_update3d(fn); }
func hud_ciz3(fn) { on_hud3d(fn); }
func carpisinca3(tagA, tagB, fn) { on_hit3d(tagA, tagB, fn); }
func zemin3(y) { ground3d(y); }
func zemin_yok3d() { no_ground3d(); }
func yercekimi3(g) { gravity3d(g); }
func kamera_takip(target, dist, height) { camera_follow(target, dist, height); }
func oyna3d() { play3d(); }

// -- Faz 7: bölüm / düşman / mermi / can --
func bolum3d(n, fn) { level3d(n, fn); }
func bolum_gec3d() { next_level3d(); }
func bolum_git3d(n) { goto_level3d(n); }
func bolum_no3d(): int { return level_now3d(); }
func kazandin_mi3d(): bool { return won3d(); }

// -- Menü / UI --
func baslangic3d(baslik, altbaslik) { menu3d(baslik, altbaslik); }
func yeniden3d() { restart3d(); }
func yeniden_baslayinca3d(fn) { on_restart3d(fn); }
func duraklat3d() { pause3d(); }
func devam3d() { resume3d(); }
func duraklatildi_mi3d(): bool { return paused3d(); }
func cik3d() { quit3d(); }
func bitti_mi3d(): bool { return is_over3d(); }
func yasayan_sayi3d(): int { return alive_count3d(); }

func takip_et3d(i, hedef, hiz) { chase3d(i, hedef, hiz); }
func devriye3d(i, x1, z1, x2, z2, hiz) { patrol3d(i, x1, z1, x2, z2, hiz); }
func menzilde3d(a, b, r): bool { return in_range3d(a, b, r); }

func mermi3d(sahip, hiz, omur): int { return bullet3d(sahip, hiz, omur); }

func can3d(i, n) { health3d(i, n); }
func can_kac3d(i): int { return hp3d(i); }
func hasar3d(i, n) { damage3d(i, n); }
func iyilestir3d(i, n) { heal3d(i, n); }

// -- Gamepad --
func kol3d(ac) { gamepad3d(ac); }
func kol_no3d(id) { gamepad_id3d(id); }
func kol_olu_bolge3d(d) { stick_deadzone3d(d); }
func kol_bakis_hizi3d(derece_sn) { gamepad_look_speed3d(derece_sn); }
func kol_bagli_mi3d(): bool { return gamepad_active3d(); }
func olunce3d(tag, fn) { on_death3d(tag, fn); }
func dokunulmazlik3d(sn) { invuln3d(sn); }

// -- Tetikleyici bölge --
func bolge3d(x, y, z, sx, sy, sz, etiket): int { return trigger3d(x, y, z, sx, sy, sz, etiket); }
func bolge_kure3d(x, y, z, r, etiket): int { return trigger_sphere3d(x, y, z, r, etiket); }
func girince3d(b, fn) { on_enter3d(b, fn); }
func cikinca3d(b, fn) { on_exit3d(b, fn); }
func icindeyken3d(b, fn) { on_stay3d(b, fn); }
func bolge_bir_kere3d(b, ac) { trigger_once3d(b, ac); }
func bolge_etkin3d(b, ac) { trigger_on3d(b, ac); }
func bolge_tasi3d(b, x, y, z) { trigger_move3d(b, x, y, z); }
func icinde3d(b): int { return inside3d(b); }
func bolge_no3d(): int { return trigger_id3d(); }
func bolge_sayisi3d(): int { return trigger_count3d(); }
func bolge_goster3d(ac) { trigger_show3d(ac); }

// -- Faz 8: parçacık / animasyon / konumsal ses --
func parcacik3d(x, y, z, n, renk, hiz, omur) { particles3d(x, y, z, n, renk, hiz, omur); }
func patlat3d(i, n, renk, hiz, omur) { burst3d(i, n, renk, hiz, omur); }
func parcacik_yercekimi3d(g) { particle_gravity3d(g); }
func animasyon3d(i, bosta, kosu, fps) { anim3d(i, bosta, kosu, fps); }
func ses3d(h, x, y, z) { sound3d(h, x, y, z); }
func ses_menzili3d(r) { sound_range3d(r); }

// -- Faz 9: dünya geometrisi --
func rampa3d(x, y, z, sx, sy, sz, renk, yaw): int { return ramp3d(x, y, z, sx, sy, sz, renk, yaw); }
func don3d(i, yaw) { set3yaw(i, yaw); }
func yon3d(i): float { return get3yaw(i); }
func arazi3d(res, sx, sy, sz, olcek, tohum) { terrain3d(res, sx, sy, sz, olcek, tohum); }
func arazi_dosya3d(yol, sx, sy, sz) { terrain_file3d(yol, sx, sy, sz); }
func arazi_renk3d(c) { terrain_color3d(c); }
func zemin_yukseklik3d(x, z): float { return _floor_at3(x, z); }

// ===========================================================================
// SAHNE BİÇİMİ (Faz 13) — sahne artık VERİ
// ===========================================================================
// Buraya kadar bir sahne yalnız KOD olarak vardı: `setup()` içinde elle
// yazılmış `spawn3(...)` çağrıları. Bu, motoru kullanmanın tek yolunu
// "önce Tulpar öğren" yapıyordu ve konumları gözle ayarlamak imkânsızdı —
// sayıyı tahmin et, derle, bak, düzelt.
//
// Bu katman sahneyi JSON olarak tanımlanabilir kılıyor. Kazanç üç yönlü:
//   1. Bir EDİTÖR sahneyi okuyup yazabilir (kod üretmeden önce bile).
//   2. Bölümler dosya olur — oyunu yeniden derlemeden yeni bölüm eklenir.
//   3. Aynı sahne hem web'de hem masaüstünde birebir aynı kurulur.
//
// Anahtarlar İNGİLİZCE ve TEK yazımlı. API'de TR+EN ikizler var ama bir VERİ
// biçiminde iki yazım kabul etmek belirsizlik üretir (hangisi kazanır?) ve
// ayrıştırıcıyı ikiye katlar. Kullanıcıya Türkçe görünen şey editörün
// etiketleri; dosyanın kendisi tek dilde.
int SCENE_V3 = 1;

// ---- Sayı biçimleme --------------------------------------------------------
// toString(120.0) "1.2e+02" veriyor. JSON bunu kabul eder ama ÜRETİLEN TULPAR
// KODU etmez — ve insan da okumaz. Bu yüzden kendi biçimleyicimiz var:
// 3 ondalık (dünya birimi metre → 1 mm çözünürlük), sondaki sıfırlar atılır.
// 3 ondalıkta yuvarlamak gidiş-dönüşü DURAĞAN da yapıyor: bir kez
// yuvarlandıktan sonra tekrar yuvarlamak değeri değiştirmez.
func _sc_num3(v): str {
    float f = v * 1.0;
    str sg = "";
    if (f < 0.0) { sg = "-"; f = 0.0 - f; }
    int ip = toInt(f);
    int t = toInt((f - ip * 1.0) * 1000.0 + 0.5);
    if (t >= 1000) { ip = ip + 1; t = 0; }
    if (t == 0) { return sg + toString(ip); }
    if (mod(t, 100) == 0) { return sg + toString(ip) + "." + toString(toInt(t / 100)); }
    if (mod(t, 10) == 0) {
        int t2 = toInt(t / 10);
        str p2 = toString(t2);
        if (t2 < 10) { p2 = "0" + p2; }
        return sg + toString(ip) + "." + p2;
    }
    str p3 = toString(t);
    if (t < 10) { p3 = "00" + p3; }
    if (t >= 10 && t < 100) { p3 = "0" + p3; }
    return sg + toString(ip) + "." + p3;
}

// ---- Ad kaydı --------------------------------------------------------------
// JSON'daki "name" alanı → handle. Kurallar ve kamera hedefi entity'lere
// ADLA atıfta bulunur; handle'lar yükleme sırasına bağlı olurdu, ad değil.
array _sc_nm = [];
array _sc_id = [];

func _sc_reg3(nm, id) {
    if (nm == "") { return; }
    push(_sc_nm, nm);
    push(_sc_id, id);
}

// Varlığı yeniden adlandır. Eski kayıt DÜŞÜRÜLÜYOR: aynı handle için iki ad
// kalırsa serileştirme hangisini yazacağını bilemezdi (ve `_sc_nm_of3` ilk
// bulduğunu döndürdüğü için eski ad kazanırdı).
func rename3d(id, nm) {
    int i = 0;
    while (i < length(_sc_id)) {
        if (_sc_id[i] == id) {
            int last = length(_sc_id) - 1;
            if (i != last) { _sc_id[i] = _sc_id[last]; _sc_nm[i] = _sc_nm[last]; }
            pop(_sc_id); pop(_sc_nm);
        } else { i = i + 1; }
    }
    _sc_reg3(nm, id);
}
func ad_ver3d(id, ad) { rename3d(id, ad); }

// Adı verilen entity'nin handle'ı; yoksa -1.
func find3d(nm): int {
    int i = 0;
    while (i < length(_sc_nm)) {
        if (_sc_nm[i] == nm) { return _sc_id[i]; }
        i = i + 1;
    }
    return 0 - 1;
}
func bul3d(nm): int { return find3d(nm); }

// Handle → ad (serileştirme için). Yoksa "".
func _sc_nm_of3(id): str {
    int i = 0;
    while (i < length(_sc_id)) {
        if (_sc_id[i] == id) { return _sc_nm[i]; }
        i = i + 1;
    }
    return "";
}

// ---- Sabit ↔ metin ---------------------------------------------------------
// Biçimde sayı yerine ad kullanmak editörü ve elle düzenlemeyi taşınabilir
// yapıyor: SHAPE_CUBE'ün 0 olması bir uygulama ayrıntısı, dosyaya sızmamalı.
func _sc_shape3(s): int {
    if (s == "sphere") { return SHAPE_SPHERE; }
    if (s == "cyl")    { return SHAPE_CYL; }
    if (s == "ramp")   { return SHAPE_RAMP; }
    // "model" dalı EKSİKTİ ve bu sessiz bir kayıptı: yazıcı `_sc_shape_nm3`
    // "model" üretiyor, okuyucu onu tanımayıp SHAPE_CUBE'e düşürüyordu. Yani
    // `spawn3_model` ile kurulmuş her karakter TAB'a basıldığı an gri bir kutu
    // oluyordu (ölçüldü).
    if (s == "model")  { return SHAPE_MODEL; }
    return SHAPE_CUBE;
}
func _sc_shape_nm3(v): str {
    if (v == SHAPE_SPHERE) { return "sphere"; }
    if (v == SHAPE_CYL)    { return "cyl"; }
    if (v == SHAPE_RAMP)   { return "ramp"; }
    if (v == SHAPE_MODEL)  { return "model"; }
    return "cube";
}
func _sc_tag3(s): int {
    if (s == "item")   { return TAG_ITEM; }
    if (s == "wall")   { return TAG_WALL; }
    if (s == "enemy")  { return TAG_ENEMY; }
    if (s == "bullet") { return TAG_BULLET; }
    if (s == "player") { return TAG_PLAYER; }
    return TAG_PROP;
}
func _sc_tag_nm3(v): str {
    if (v == TAG_PLAYER) { return "player"; }
    if (v == TAG_ITEM)   { return "item"; }
    if (v == TAG_WALL)   { return "wall"; }
    if (v == TAG_ENEMY)  { return "enemy"; }
    if (v == TAG_BULLET) { return "bullet"; }
    return "prop";
}

// ---- JSON okuma yardımcıları ----------------------------------------------
// Her alan İSTEĞE BAĞLI: eksikse varsayılan döner. Bu, biçimi ileri uyumlu
// yapıyor (eski dosya yeni motorda açılır) ve editörün yalnız değiştirilen
// alanları yazmasına izin veriyor.
func _sc_has3(o, k): bool { return contains(keys(o), k); }
func _sc_f3(o, k, d): float {
    if (_sc_has3(o, k) == false) { return d * 1.0; }
    return o[k] * 1.0;
}
func _sc_i3(o, k, d): int {
    if (_sc_has3(o, k) == false) { return d; }
    return toInt(o[k]);
}
func _sc_s3(o, k, d): str {
    if (_sc_has3(o, k) == false) { return d; }
    return o[k];
}
func _sc_bool3(o, k, d): int {
    if (_sc_has3(o, k) == false) { return d; }
    if (o[k] == true) { return 1; }
    if (o[k] == false) { return 0; }
    return toInt(o[k]);
}
// Renk [r,g,b] ya da [r,g,b,a] olarak yazılır — editörde bir renk seçici
// doğrudan buna denk düşer; paketli tamsayı (0xRRGGBBAA) insan için okunmaz.
func _sc_col3(o, k, d): int {
    if (_sc_has3(o, k) == false) { return d; }
    json c = o[k];
    if (length(c) < 3) { return d; }
    int a = 255;
    if (length(c) > 3) { a = toInt(c[3]); }
    return rgba(toInt(c[0]), toInt(c[1]), toInt(c[2]), a);
}
func _sc_coljs3(c): str {
    return "[" + toString(_col_r3(c)) + "," + toString(_col_g3(c)) + "," +
           toString(_col_b3(c)) + "]";
}

// ---- Dünya varsayılanları --------------------------------------------------
// Yükleme TAM olmalı: B sahnesini açmak A'nın gökyüzünü devralmamalı.
// scene3d_reset() entity'leri ve oynanış durumunu siliyor ama dünya
// ayarlarının çoğunu (gökyüzü, sis, ışık, kamera mesafesi) bırakıyor — çünkü
// onlar normalde setup'ta bir kez kuruluyor. Editör ise saniyede bir yeniden
// yüklüyor; bırakılan her ayar sıraya bağımlı bir hata olurdu.
func _sc_world_defaults3() {
    _sky3 = 0; _fog3 = 0.0;
    _ground_on = 1; _ground_y = 0.0;
    _ground_tex3 = 0 - 1; _ground_tile3 = 1.0; _ground_tex_src3 = "";
    _grav = 26.0;
    _lights3 = 1; _shadows3 = 1;
    // Işıklar da dünya ayarı: B sahnesini açmak A'nın lambalarını devralmamalı.
    _lt_x3 = []; _lt_y3 = []; _lt_z3 = []; _lt_col3 = []; _lt_rng3 = [];
    _lt_pick3 = [];
    _cam_dist = 12.0; _cam_height = 8.0; _cam_fov = 45.0;
    _cam_collide3 = 1; _cam_eye3 = 0.0; _sc_cam_nm3 = "";
    _dn_on3 = 0; _dn_h3 = 12.0; _dn_len3 = 120.0; _dn_frozen3 = 0;
    _stars3 = 0.0 - 1.0;
    _cloud3 = 0.0;
    terrain_off3d_scene();
    _terr_lay3 = 0; terrain_layers_off3d();
    _water_on3 = 0; _water_col3 = 0; _water_a3 = 150; _water_phys3 = 1;
    _slope_lim3 = 0.0; _slope_cos3 = 0.0; _slide_acc3 = 18.0;
}

// ---- Dünya: JSON → motor ---------------------------------------------------
func _sc_load_world3(w) {
    _sc_title3 = _sc_s3(w, "title", _sc_title3);
    _sc_w3 = _sc_i3(w, "w", _sc_w3);
    _sc_h3 = _sc_i3(w, "h", _sc_h3);
    if (_sc_has3(w, "sky")) {
        json sk = w["sky"];
        sky3d(_sc_col3(sk, "top", rgb(58, 116, 200)),
              _sc_col3(sk, "bottom", rgb(196, 220, 240)));
    }
    fog3d(_sc_f3(w, "fog", 0.0));
    // "ground" YOKLUĞU anlamlı: zemin düzlemi olmayan sahne (yalnız arazi ya
    // da boşlukta duran platformlar). Bu yüzden varsayılan değere düşmüyor.
    if (_sc_has3(w, "ground")) { ground3d(_sc_f3(w, "ground", 0.0)); }
    else { no_ground3d(); }
    str gts = _sc_s3(w, "ground_tex", "");
    if (gts != "") { ground_texture_src3d(gts, _sc_f3(w, "ground_tile", 1.0)); }
    gravity3d(_sc_f3(w, "gravity", 26.0));
    lights3d(_sc_bool3(w, "lights", 1));
    if (_sc_has3(w, "lights_at")) {
        json ls3 = w["lights_at"];
        int li2 = 0;
        while (li2 < length(ls3)) {
            json L = ls3[li2];
            light3d(_sc_f3(L, "x", 0.0), _sc_f3(L, "y", 2.0), _sc_f3(L, "z", 0.0),
                    _sc_col3(L, "color", WHITE), _sc_f3(L, "range", 10.0));
            li2 = li2 + 1;
        }
    }
    shadows3d(_sc_bool3(w, "shadows", 1));

    if (_sc_has3(w, "daynight")) {
        json dn = w["daynight"];
        daynight3d(_sc_f3(dn, "len", 120.0));
        set_time3d(_sc_f3(dn, "time", 12.0));
        freeze_time3d(_sc_bool3(dn, "frozen", 0));
    }
    // Yıldız: -1 = OTOMATİK (geceye bağlı). Elle sabitlemek isteyen 0..1 yazar.
    float st = _sc_f3(w, "stars", 0.0 - 1.0);
    if (st < 0.0) { stars_auto3d(); } else { stars3d(st); }
    clouds3d(_sc_f3(w, "clouds", 0.0));

    if (_sc_has3(w, "terrain")) {
        json tr = w["terrain"];
        if (_sc_has3(tr, "file")) {
            terrain_file3d(_sc_s3(tr, "file", ""), _sc_f3(tr, "sx", 120.0),
                           _sc_f3(tr, "sy", 14.0), _sc_f3(tr, "sz", 120.0));
        } else {
            terrain3d(_sc_i3(tr, "res", 129), _sc_f3(tr, "sx", 120.0),
                      _sc_f3(tr, "sy", 14.0), _sc_f3(tr, "sz", 120.0),
                      _sc_f3(tr, "noise", 4.5), _sc_i3(tr, "seed", 1));
        }
    }
    if (_sc_has3(w, "paint")) {
        json pt = w["paint"];
        terrain_paint3d(_sc_col3(pt, "low",  rgb(96, 132, 88)),
                        _sc_col3(pt, "mid",  rgb(124, 116, 82)),
                        _sc_col3(pt, "high", rgb(238, 242, 250)),
                        _sc_col3(pt, "rock", rgb(112, 110, 106)),
                        _sc_f3(pt, "mid_y", 5.0), _sc_f3(pt, "high_y", 9.0),
                        _sc_f3(pt, "slope", 42.0));
    }
    if (_sc_has3(w, "water")) {
        json wt = w["water"];
        water3d(_sc_f3(wt, "y", 0.0));
        water_color3d(_sc_col3(wt, "color", rgb(40, 110, 170)),
                      _sc_i3(wt, "alpha", 150));
        water_physics3d(_sc_bool3(wt, "physics", 1));
    }
    if (_sc_has3(w, "slope")) {
        json sl = w["slope"];
        slope_limit3d(_sc_f3(sl, "limit", 0.0));
        slide_accel3d(_sc_f3(sl, "slide", 18.0));
    }
}

// Kamera AYRI ve SONRA: hedefini adla gösteriyor, entity'ler yüklenmeden
// çözülemez.
func _sc_load_camera3(w) {
    if (_sc_has3(w, "camera") == false) { return; }
    json cm = w["camera"];
    _sc_cam_nm3 = _sc_s3(cm, "target", "");
    int tgt = find3d(_sc_cam_nm3);
    str md = _sc_s3(cm, "mode", "orbit");
    float ds = _sc_f3(cm, "dist", 12.0);
    float hg = _sc_f3(cm, "height", 8.0);
    if (md == "fps")         { camera_fps(tgt, _sc_f3(cm, "eye", 0.0)); }
    if (md == "follow")      { camera_follow(tgt, ds, hg); }
    if (md == "orbit")       { camera_orbit(tgt, ds, hg); }
    camera_fov(_sc_f3(cm, "fov", 45.0));
    camera_collide3d(_sc_bool3(cm, "collide", 1));
    if (_sc_has3(cm, "lock")) { camera_lock3d(_sc_bool3(cm, "lock", 1)); }
}

// JSON dizesi: tırnak + kaçış. Adlar tarihsel olarak HAM yazılıyor (tırnaksız
// bir ad zaten editörde üretilemiyor), ama DOSYA YOLU kullanıcının diskinden
// geliyor — içinde ters bölü ya da tırnak varsa kaçırılmadan yazmak sahne
// dosyasını ayrıştırılamaz yapardı.
func _sc_q3(v): str {
    str o = "\"";
    int i = 0;
    int n = length(v);
    while (i < n) {
        int c = ord(v, i);
        if (c == 34)      { o = o + "\\\""; }
        else {
            if (c == 92)  { o = o + "\\\\"; }
            else          { o = o + substring(v, i, i + 1); }
        }
        i = i + 1;
    }
    return o + "\"";
}

// ---- Entity: JSON → motor --------------------------------------------------
func _sc_load_ent3(e): int {
    int id = spawn3(_sc_f3(e, "x", 0.0), _sc_f3(e, "y", 0.0), _sc_f3(e, "z", 0.0),
                    _sc_f3(e, "sx", 1.0), _sc_f3(e, "sy", 1.0), _sc_f3(e, "sz", 1.0),
                    _sc_col3(e, "color", WHITE),
                    _sc_shape3(_sc_s3(e, "shape", "cube")),
                    _sc_tag3(_sc_s3(e, "tag", "prop")));
    if (_sc_has3(e, "model") || _sc_has3(e, "model_src")) {
        int sl = _slot_of3(id);
        Ent3 me = _e3[sl];
        // YOL kazanır. Dosyadaki handle yalnız aynı süreçte anlamlı; yol
        // varsa modeli yoldan (önbellekli) yüklemek hem doğru hem taşınabilir.
        str src = _sc_s3(e, "model_src", "");
        if (src != "") {
            me.msrc = src;
            me.model = asset_model3d(src);
        } else {
            me.model = _sc_i3(e, "model", 0 - 1);
        }
        me.anim_idle = _sc_i3(e, "anim_idle", 0 - 1);
        me.anim_run  = _sc_i3(e, "anim_run", 0 - 1);
        me.anim_fps  = _sc_f3(e, "anim_fps", 24.0);
        _e3[sl] = me;
    }
    str tx = _sc_s3(e, "texture", "");
    if (tx != "") { set_texture3d(id, tx, _sc_f3(e, "tile", 1.0)); }
    if (_sc_has3(e, "yaw"))   { set3yaw(id, _sc_f3(e, "yaw", 0.0)); }
    if (_sc_has3(e, "solid")) { solid3d(id, _sc_bool3(e, "solid", 1)); }
    if (_sc_has3(e, "hp"))    { health3d(id, _sc_i3(e, "hp", 0)); }
    _sc_reg3(_sc_s3(e, "name", ""), id);
    if (_sc_has3(e, "behaviors")) {
        json bs = e["behaviors"];
        int i = 0;
        while (i < length(bs)) { _sc_load_bh3(id, bs[i]); i = i + 1; }
    }
    return id;
}

// Davranış: JSON → bileşen. "target" bir ETİKET adı (yokluğu = hedefsiz);
// belirli bir varlığı hedeflemek biçimde YOK, çünkü etiket zaten "en yakın
// oyuncu" demenin doğal yolu ve adla hedeflemek her karede ad araması
// gerektirirdi.
func _sc_load_bh3(id, b) {
    str k = _sc_s3(b, "type", "");
    int tg = 0;
    if (_sc_has3(b, "target")) { tg = _sc_tag3(_sc_s3(b, "target", "player")); }
    if (k == "move") {
        move_behavior3d(id, _sc_f3(b, "speed", 8.0), _sc_f3(b, "jump", 0.0));
    }
    if (k == "chase") {
        if (tg == 0) { tg = TAG_PLAYER; }
        chase_behavior3d(id, tg, _sc_f3(b, "speed", 5.0), _sc_f3(b, "range", 0.0));
    }
    if (k == "patrol") {
        patrol_behavior3d(id, _sc_f3(b, "x1", 0.0), _sc_f3(b, "z1", 0.0),
                          _sc_f3(b, "x2", 0.0), _sc_f3(b, "z2", 0.0),
                          _sc_f3(b, "speed", 4.0));
    }
    if (k == "spin") { spin_behavior3d(id, _sc_f3(b, "speed", 90.0)); }
    if (k == "bob") {
        bob_behavior3d(id, _sc_f3(b, "height", 0.3), _sc_f3(b, "speed", 1.0));
    }
    if (k == "float") {
        float_behavior3d(id, _sc_f3(b, "power", 6.0), _sc_f3(b, "depth", 0.2));
    }
    if (k == "shoot") {
        shoot_behavior3d(id, _sc_f3(b, "interval", 1.0), _sc_f3(b, "speed", 20.0),
                         _sc_f3(b, "life", 2.0), tg, _sc_f3(b, "range", 0.0));
    }
}

// ---- Genel giriş: sahneyi yükle -------------------------------------------
// Yüklenen entity sayısını döndürür; bozuk/boş JSON'da 0. Sahneyi TAMAMEN
// değiştirir (önce reset).
// Sahne biçiminin SAHİP OLDUĞU her şeyi temizler — ve yalnız onları.
//
// Eskiden yükleme `scene3d_reset()` çağırıyordu, yani TAM teardown. Ama o
// teardown sahne JSON'unda KARŞILIĞI OLMAYAN çok şeyi de siliyor: tetikleyici
// bölgeler, çarpışma/ölüm kancaları, kalıcılık (rekor), nişan modu, yeniden
// başlat kancası, kamera ayarları. Yükleme onları silerse geri koyamaz.
//
// Sonuç ölçüldü: editöre girip çıkmak (TAB TAB) bölge sayısını 1'den 0'a,
// kayıt durumunu 1'den 0'a, nişan modunu AIM_LOOK'tan AIM_FLAT'e düşürüyordu.
// Aynı yol her Ctrl+Z'de de işliyordu.
//
// Tek tek "şunu da koru" listesi tutmak bu hatayı yeniden üretirdi: motora
// eklenen her yeni durum listeyi sessizce eskitirdi. Kural yapısal olmalı —
// yükleme, GERİ YÜKLEYEBİLDİĞİ şeyi temizler.
func _sc_clear_for_load3() {
    _e3 = []; _e3gen = []; _e3free = []; _free_n3 = 0;
    _bx = []; _by = []; _bz = []; _br = [];
    _bh3 = []; _rl3 = [];
    _pf_nm3 = []; _pf_js3 = [];
    // Bölgeler artık BİÇİMİN parçası, yani yükleme onları da temizliyor.
    // (Kancaları biçimde taşınmıyor ama geometrileri taşınıyor; eskisini
    // bırakmak yeni sahneye yabancı bölgeler sızdırırdı.)
    _trg_clear3();
    _sc_nm = []; _sc_id = [];
    _s3_particles_clear();
    _fade3 = [];
    _hit_me = 0 - 1; _hit_other = 0 - 1;
    _cam_target = 0 - 1;
    _game_over3 = 0; _won3 = 0;
    // Editör seçimi bayat handle olurdu.
    _ed_sel3e = 0 - 1; _ed_drag3 = 0; _gz_axis3 = 0 - 1;
    _ed_zsel3 = 0 - 1; _ed_msel3 = [];
    // BÖLÜMLER de biçimin parçası, yani yükleme onları da temizlemeli.
    // Temizlenmiyordu ve sonuç sinsi bir VERİ KAYBIYDI: üç bölümlü bir sahne
    // açıkken "Yeni"ye basmak yaşayan sahneyi boşaltıyor ama _lvl_js3'ü
    // bırakıyordu; F5 o dosyaya ESKİ sahnenin varlıklarını "levels" altında
    // yazıyordu. Yani kullanıcının boş istediği dosya, terk ettiği sahnenin
    // içeriğiyle doluyordu. (Ölçüldü: yeni sahneden sonra kaydedilen JSON
    // önceki bölümün kürelerini taşıyordu.) Şablonlar da aynı yoldan geçiyor.
    //
    // Kayıt defteri (_lvlN/_lvlF) yalnız VERİ bölümleri varken siliniyor.
    // Elle yazılmış bir oyunun `level3d(1, "bolum1")` kayıtları KOD, sahne
    // değil; sahne yüklemek onları silmemeli. _lvl_js3 doluyken defter zaten
    // veri bölümlerinin: `ed_level_del3d` de onu bütünüyle yeniden kuruyor.
    if (length(_lvl_js3) > 0) { _lvlN = []; _lvlF = []; _cur_lvl3 = 0; }
    _lvl_js3 = [];
    _ed_lvl3 = 0;
}

func scene_load3d(src): int {
    json sc = fromJson(src);
    if (length(keys(sc)) == 0) {
        log_err3d("sahne yuklenemedi: gecersiz JSON");
        return 0;
    }
    _sc_clear_for_load3();
    _sc_world_defaults3();
    _ed_dirty3 = 0;   // yeni yüklenen sahne "değişmemiş" sayılır
    if (_sc_has3(sc, "world")) { _sc_load_world3(sc["world"]); }
    int n = 0;
    if (_sc_has3(sc, "entities")) {
        json es = sc["entities"];
        int i = 0;
        while (i < length(es)) {
            _sc_load_ent3(es[i]);
            n = n + 1;
            i = i + 1;
        }
    }
    if (_sc_has3(sc, "world")) { _sc_load_camera3(sc["world"]); }
    if (_sc_has3(sc, "prefabs")) { _sc_load_prefabs3(sc["prefabs"]); }
    if (_sc_has3(sc, "zones")) {
        json zs = sc["zones"];
        int z = 0;
        while (z < length(zs)) { _sc_load_zone3(zs[z]); z = z + 1; }
    }
    if (_sc_has3(sc, "rules")) {
        json rs = sc["rules"];
        int r = 0;
        while (r < length(rs)) { _sc_load_rule3(rs[r]); r = r + 1; }
    }
    // ÇOK BÖLÜMLÜ dosya: her bölüm kaydediliyor ve BİRİNCİSİ yükleniyor.
    // Dünya ve şablonlar yukarıda zaten okundu; onlar paylaşılıyor.
    if (_sc_has3(sc, "levels")) {
        json ls = sc["levels"];
        _lvl_js3 = []; _lvlN = []; _lvlF = [];
        int k = 0;
        while (k < length(ls)) {
            push(_lvl_js3, ls[k]);
            level3d(k + 1, "_s3_level_data3");
            k = k + 1;
        }
        if (length(_lvl_js3) > 0) {
            _cur_lvl3 = 1;
            n = _sc_load_level3(_lvl_js3[0]);   // sonunda kamerayı hedefler
        }
        log3d("sahne yuklendi: " + toString(length(_lvl_js3)) + " bolum, " +
              toString(n) + " varlik (1. bolum)");
        return n;
    }
    log3d("sahne yuklendi: " + toString(n) + " varlik");
    return n;
}
func sahne_yukle3d(kaynak): int { return scene_load3d(kaynak); }

// Bölge: JSON → motor. Bölgeler sahne biçiminde YOKTU, yani editörden
// eklenemiyor ve bir sahne dosyası "buraya girince şu olsun" diyemiyordu.
// Kancaları (girince/çıkınca) biçimde taşınmıyor — onlar KOD; taşınan şey
// bölgenin GEOMETRİSİ ve etiketi.
func _sc_load_zone3(z) {
    int tag = _sc_tag3(_sc_s3(z, "tag", "player"));
    int id = 0 - 1;
    if (_sc_s3(z, "shape", "box") == "sphere") {
        id = trigger_sphere3d(_sc_f3(z, "x", 0.0), _sc_f3(z, "y", 0.0),
                              _sc_f3(z, "z", 0.0), _sc_f3(z, "r", 2.0), tag);
    } else {
        id = trigger3d(_sc_f3(z, "x", 0.0), _sc_f3(z, "y", 0.0), _sc_f3(z, "z", 0.0),
                       _sc_f3(z, "sx", 4.0), _sc_f3(z, "sy", 4.0), _sc_f3(z, "sz", 4.0),
                       tag);
    }
    if (_sc_has3(z, "once")) { trigger_once3d(id, _sc_bool3(z, "once", 0)); }
    if (_sc_has3(z, "on"))   { trigger_on3d(id, _sc_bool3(z, "on", 1)); }
    if (_sc_has3(z, "do")) {
        trigger_action3d(id, _zact_of3(_sc_s3(z, "do", "none")),
                         _sc_f3(z, "amount", 0.0));
    }
    trigger_sound3d(id, _sc_s3(z, "sound", ""));
}

// Eylem ↔ dosya anahtarı. Biçimde SAYI değil AD duruyor — ZACT_KILL'in 3
// olması bir uygulama ayrıntısı ve elle düzenlenen bir sahne dosyasında
// "do": 3 hiçbir şey anlatmazdı. (Kural eylemleri de aynı sözleşmede.)
func _zact_key3(a): str {
    if (a == ZACT_WIN)    { return "win"; }
    if (a == ZACT_LOSE)   { return "lose"; }
    if (a == ZACT_KILL)   { return "kill"; }
    if (a == ZACT_DAMAGE) { return "damage"; }
    if (a == ZACT_SCORE)  { return "score"; }
    if (a == ZACT_NEXT)   { return "next_level"; }
    return "none";
}
func _zact_of3(k): int {
    if (k == "win")        { return ZACT_WIN; }
    if (k == "lose")       { return ZACT_LOSE; }
    if (k == "kill")       { return ZACT_KILL; }
    if (k == "damage")     { return ZACT_DAMAGE; }
    if (k == "score")      { return ZACT_SCORE; }
    if (k == "next_level") { return ZACT_NEXT; }
    return ZACT_NONE;
}

// Bölgeler → JSON dizisi.
func _sc_zones_js3(): str {
    int n = length(_trg_x);
    if (n == 0) { return ""; }
    str o = ",\n  \"zones\": [\n";
    int i = 0;
    while (i < n) {
        if (i > 0) { o = o + ",\n"; }
        o = o + "    {\"tag\": \"" + _sc_tag_nm3(_trg_tag[i]) + "\"";
        if (_trg_shape[i] == 1) {
            o = o + ", \"shape\": \"sphere\", \"r\": " + _sc_num3(_trg_r[i]);
        } else {
            o = o + ", \"sx\": " + _sc_num3(_trg_sx[i]) +
                ", \"sy\": " + _sc_num3(_trg_sy[i]) +
                ", \"sz\": " + _sc_num3(_trg_sz[i]);
        }
        o = o + ", \"x\": " + _sc_num3(_trg_x[i]) +
            ", \"y\": " + _sc_num3(_trg_y[i]) +
            ", \"z\": " + _sc_num3(_trg_z[i]);
        if (_trg_once[i] == 1) { o = o + ", \"once\": true"; }
        if (_trg_on[i] == 0)   { o = o + ", \"on\": false"; }
        // Eylem yalnız VARSA yazılıyor: eylemsiz bölgeler (kancayla çalışan
        // eski sahneler) dosyada değişmiyor, git farkı okunur kalıyor.
        if (_trg_act[i] != ZACT_NONE) {
            o = o + ", \"do\": \"" + _zact_key3(_trg_act[i]) + "\"";
            if (_zact_uses_amount3(_trg_act[i])) {
                o = o + ", \"amount\": " + _sc_num3(_trg_amt[i]);
            }
        }
        if (_trg_snd[i] != "") {
            o = o + ", \"sound\": " + _sc_q3(_trg_snd[i]);
        }
        o = o + "}";
        i = i + 1;
    }
    return o + "\n  ]";
}

// Kural: JSON → motor. "on" alanı kuralın TÜRÜNÜ seçiyor; eylem "do".
func _sc_load_rule3(r) {
    str on = _sc_s3(r, "on", "hit");
    int act = _rl_act3(_sc_s3(r, "do", "collect"));
    str snd = _sc_s3(r, "sound", "");
    if (on == "cleared") {
        cleared_rule3d(_sc_tag3(_sc_s3(r, "tag", "item")), act);
        _rl_set_snd3(length(_rl3) - 1, snd);
        return;
    }
    hit_rule3d(_sc_tag3(_sc_s3(r, "a", "player")),
               _sc_tag3(_sc_s3(r, "b", "item")),
               act, _sc_f3(r, "n", 0.0));
    _rl_set_snd3(length(_rl3) - 1, snd);
}

// Kuralın sesini yoldan kur. `hit_rule3d`/`cleared_rule3d`'ye parametre
// EKLENMEDİ: ikisi de kamuya açık ve elle yazılmış oyunlarda çağrılıyor,
// zorunlu bir parametre onları kırardı.
func _rl_set_snd3(i, path) {
    if (i < 0 || i >= length(_rl3)) { return; }
    Rule3 r = _rl3[i];
    r.snd = path;
    _rl3[i] = r;
}

// Kuralın sesini AÇIKÇA kur (oyun kodu ve editör için).
//
//   rule_sound3d(0, "sesler/altin.wav");
func rule_sound3d(i, path) { _rl_set_snd3(i, path); }
func kural_sesi3d(i, yol)  { _rl_set_snd3(i, yol); }
func rule_sound_path3d(i): str {
    if (i < 0 || i >= length(_rl3)) { return ""; }
    return _rl3[i].snd;
}
// Kurallar → JSON dizisi (girintili, entity'ler gibi satır satır).
func _sc_rules_js3(): str {
    if (length(_rl3) == 0) { return ""; }
    str o = ",\n  \"rules\": [\n";
    int i = 0;
    while (i < length(_rl3)) {
        Rule3 r = _rl3[i];
        if (i > 0) { o = o + ",\n"; }
        str sj = "";
        if (r.snd != "") { sj = ", \"sound\": " + _sc_q3(r.snd); }
        if (r.kind == RULE_CLEARED) {
            o = o + "    {\"on\": \"cleared\", \"tag\": \"" + _sc_tag_nm3(r.a) +
                "\", \"do\": \"" + _rl_act_nm3(r.act) + "\"" + sj + "}";
        } else {
            o = o + "    {\"on\": \"hit\", \"a\": \"" + _sc_tag_nm3(r.a) +
                "\", \"b\": \"" + _sc_tag_nm3(r.b) +
                "\", \"do\": \"" + _rl_act_nm3(r.act) + "\"";
            if (r.n != 0.0) { o = o + ", \"n\": " + _sc_num3(r.n); }
            o = o + sj + "}";
        }
        i = i + 1;
    }
    return o + "\n  ]";
}

// ---- Pencere bilgisi -------------------------------------------------------
// Pencere sahne YÜKLENMEDEN önce açılmak zorunda (sahne3d(...) → oyna3d()),
// ama başlık/boyut da sahnenin bir parçası. Bu yüzden ayrı ve HAFİF bir
// okuyucu: yalnız üç alanı alır, sahneye dokunmaz.
str _sc_title3 = "Tulpar 3B Sahne";
int _sc_w3 = 960;
int _sc_h3 = 560;

func scene_meta3d(src) {
    json sc = fromJson(src);
    if (length(keys(sc)) == 0) { return; }
    if (_sc_has3(sc, "world") == false) { return; }
    json w = sc["world"];
    _sc_title3 = _sc_s3(w, "title", _sc_title3);
    _sc_w3 = _sc_i3(w, "w", _sc_w3);
    _sc_h3 = _sc_i3(w, "h", _sc_h3);
}
func scene_meta_file3d(path) {
    if (file_exists(path)) { scene_meta3d(read_file(path)); }
}
func sahne_bilgi3d(kaynak) { scene_meta3d(kaynak); }
func sahne_bilgi_dosya3d(yol) { scene_meta_file3d(yol); }
// Pencere bilgisini doğrudan kur (üretilen kod bunu kullanıyor; JSON'dan
// okumak varken ayrıca gerekiyor çünkü kod JSON taşımıyor).
func scene_meta_set3d(t, w, h) { _sc_title3 = t; _sc_w3 = w; _sc_h3 = h; }
func sahne_bilgi_ayarla3d(baslik, en, boy) { scene_meta_set3d(baslik, en, boy); }

func scene_title3d(): str { return _sc_title3; }
func scene_w3d(): int { return _sc_w3; }
func scene_h3d(): int { return _sc_h3; }
func sahne_basligi3d(): str { return scene_title3d(); }
func sahne_eni3d(): int { return scene_w3d(); }
func sahne_boyu3d(): int { return scene_h3d(); }

// Dosyadan yükle.
// TARAYICIDA dosya sistemi yok. emscripten'in MEMFS'i sayfa ömürlüdür:
// yazılan şey sekme yenilenince kaybolur ve write_file yine de BAŞARILI
// döner — yani sessiz veri kaybı. Ölçüldü (headless Chrome, iki ardışık
// yükleme). Tarayıcının kalıcı deposu localStorage'dır; scene3d oraya
// "sahne:<yol>" anahtarıyla yazıyor.
//
// Yol yine de ANLAMLI: aynı sayfada birden çok sahne ayrı anahtarlarda durur
// ve masaüstünde AYNI çağrı gerçek dosyaya gider. Oyun/editör kodu platform
// ayrımı yapmıyor.
func _s3_key3(path): str { return "sahne:" + path; }

func scene_file3d(path): int {
    // Web'de ÖNCE kullanıcının kendi kaydı: paketlenmiş dosya başlangıç
    // hâlidir, düzenlenmiş hâl onu ezmeli — yoksa her yenileme işi geri alır.
    if (web_mi()) {
        str kayitli = kayit_oku(_s3_key3(path));
        if (kayitli != "") { return scene_load3d(kayitli); }
    }
    if (file_exists(path) == false) {
        log_err3d("sahne dosyasi yok: " + path);
        return 0;
    }
    return scene_load3d(read_file(path));
}
func sahne_dosya3d(yol): int { return scene_file3d(yol); }

// ---- Motor → JSON ----------------------------------------------------------
// Yalnız ETKİN olan yazılır: kapalı su, kurulmamış arazi ya da varsayılan
// gökyüzü dosyaya girmez. Böylece elle yazılmış küçük bir sahne kaydedilince
// şişmiyor ve git farkı okunur kalıyor.
//
// Çıktı satır satır: her entity tek satır. Biçimlendirmenin amacı editörün
// kaydettiği dosyanın da insan tarafından okunup düzenlenebilmesi.
func _sc_world_js3(): str {
    str o = "  \"world\": {\n";
    o = o + "    \"title\": \"" + _sc_title3 + "\", \"w\": " + toString(_sc_w3) +
        ", \"h\": " + toString(_sc_h3) + ",\n";
    if (_sky3 == 1) {
        o = o + "    \"sky\": {\"top\": " + _sc_coljs3(_sky_top3) +
            ", \"bottom\": " + _sc_coljs3(_sky_bot3) + "},\n";
    }
    if (_fog3 > 0.0) { o = o + "    \"fog\": " + _sc_num3(_fog3) + ",\n"; }
    if (_ground_on == 1) { o = o + "    \"ground\": " + _sc_num3(_ground_y) + ",\n"; }
    // Zemin dokusu hiç yazılmıyordu: dokulu bir sahne kaydedilip açıldığında
    // zemin sessizce düz renge dönüyordu. Handle değil YOL yazılıyor.
    if (_ground_tex_src3 != "") {
        o = o + "    \"ground_tex\": " + _sc_q3(_ground_tex_src3) +
            ", \"ground_tile\": " + _sc_num3(_ground_tile3) + ",\n";
    }
    o = o + "    \"gravity\": " + _sc_num3(_grav) + ",\n";
    if (_lights3 == 0)  { o = o + "    \"lights\": false,\n"; }
    if (length(_lt_x3) > 0) {
        o = o + "    \"lights_at\": [";
        int li = 0;
        while (li < length(_lt_x3)) {
            if (li > 0) { o = o + ", "; }
            o = o + "{\"x\": " + _sc_num3(_lt_x3[li]) +
                ", \"y\": " + _sc_num3(_lt_y3[li]) +
                ", \"z\": " + _sc_num3(_lt_z3[li]) +
                ", \"color\": " + _sc_coljs3(_lt_col3[li]) +
                ", \"range\": " + _sc_num3(_lt_rng3[li]) + "}";
            li = li + 1;
        }
        o = o + "],\n";
    }
    if (_shadows3 == 0) { o = o + "    \"shadows\": false,\n"; }
    if (_dn_on3 == 1) {
        o = o + "    \"daynight\": {\"len\": " + _sc_num3(_dn_len3) +
            ", \"time\": " + _sc_num3(_dn_h3);
        if (_dn_frozen3 == 1) { o = o + ", \"frozen\": true"; }
        o = o + "},\n";
    }
    // -1 (otomatik) varsayılan; yalnız elle sabitlenmişse yazılır.
    if (_stars3 >= 0.0) { o = o + "    \"stars\": " + _sc_num3(_stars3) + ",\n"; }
    if (_cloud3 > 0.0) { o = o + "    \"clouds\": " + _sc_num3(_cloud3) + ",\n"; }
    if (_terr_kind3 == 1) {
        o = o + "    \"terrain\": {\"res\": " + toString(_terr_res3) +
            ", \"sx\": " + _sc_num3(_terr_sx) + ", \"sy\": " + _sc_num3(_terr_sy3) +
            ", \"sz\": " + _sc_num3(_terr_sz) + ", \"noise\": " + _sc_num3(_terr_scale3) +
            ", \"seed\": " + toString(_terr_seed3) + "},\n";
    }
    if (_terr_kind3 == 2) {
        o = o + "    \"terrain\": {\"file\": \"" + _terr_path3 +
            "\", \"sx\": " + _sc_num3(_terr_sx) + ", \"sy\": " + _sc_num3(_terr_sy3) +
            ", \"sz\": " + _sc_num3(_terr_sz) + "},\n";
    }
    if (_terr_lay3 == 1) {
        o = o + "    \"paint\": {\"low\": " + _sc_coljs3(_terr_pl3) +
            ", \"mid\": " + _sc_coljs3(_terr_pm3) +
            ", \"high\": " + _sc_coljs3(_terr_ph3) +
            ", \"rock\": " + _sc_coljs3(_terr_pr3) +
            ", \"mid_y\": " + _sc_num3(_terr_pmy3) +
            ", \"high_y\": " + _sc_num3(_terr_phy3) +
            ", \"slope\": " + _sc_num3(_terr_prs3) + "},\n";
    }
    if (_water_on3 == 1) {
        o = o + "    \"water\": {\"y\": " + _sc_num3(_water_y3) +
            ", \"color\": " + _sc_coljs3(_water_col3) +
            ", \"alpha\": " + toString(_water_a3);
        if (_water_phys3 == 0) { o = o + ", \"physics\": false"; }
        o = o + "},\n";
    }
    if (_slope_lim3 > 0.0) {
        o = o + "    \"slope\": {\"limit\": " + _sc_num3(_slope_lim3) +
            ", \"slide\": " + _sc_num3(_slide_acc3) + "},\n";
    }
    // Kamera EN SON ve virgülsüz — nesnenin son alanı.
    str md = "follow";
    if (_cam_mode3 == CAM_ORBIT) { md = "orbit"; }
    if (_cam_mode3 == CAM_FPS)   { md = "fps"; }
    o = o + "    \"camera\": {\"mode\": \"" + md + "\"";
    str tn = _sc_nm_of3(_cam_target);
    // Yaşayan hedef çözülemiyorsa (çok bölümlü sahnede yazarken başka bir
    // bölümdesin) ADI yaz. Yazmasaydı kaydetmek kamera bağını sessizce
    // koparırdı — dosya her turda biraz daha bozulurdu.
    if (tn == "") { tn = _sc_cam_nm3; }
    if (tn != "") { o = o + ", \"target\": \"" + tn + "\""; }
    if (md == "fps") { o = o + ", \"eye\": " + _sc_num3(_cam_eye3); }
    else {
        // YÖRÜNGE modunda _cam_dist YATAY mesafe değil, yörünge YARIÇAPI:
        // camera_orbit(d,h) onu sqrt(d*d + h*h) olarak kuruyor. Biçimdeki
        // "dist" ise camera_orbit'in aldığı değer, yani geri çevirmek gerek —
        // yoksa her kaydet/yükle turunda kamera bir adım daha geri kayardı
        // (16 → 18.87 → 21.35). Ters dönüşüm tam: r*r - h*h = d*d.
        float dh = _cam_dist_logical3();
        o = o + ", \"dist\": " + _sc_num3(dh) +
            ", \"height\": " + _sc_num3(_cam_height);
    }
    o = o + ", \"fov\": " + _sc_num3(_cam_fov);
    if (_cam_collide3 == 0) { o = o + ", \"collide\": false"; }
    o = o + "}\n";
    return o + "  }";
}

func _sc_ent_js3(s): str {
    Ent3 e = _e3[s];
    str o = "    {";
    str nm = _sc_nm_of3(_mk_handle3(s));
    if (nm != "") { o = o + "\"name\": \"" + nm + "\", "; }
    o = o + "\"tag\": \"" + _sc_tag_nm3(e.tag) + "\", " +
        "\"shape\": \"" + _sc_shape_nm3(e.shape) + "\", " +
        "\"x\": " + _sc_num3(e.x) + ", \"y\": " + _sc_num3(e.y) +
        ", \"z\": " + _sc_num3(e.z) + ", " +
        "\"sx\": " + _sc_num3(e.sx) + ", \"sy\": " + _sc_num3(e.sy) +
        ", \"sz\": " + _sc_num3(e.sz) + ", " +
        "\"color\": " + _sc_coljs3(e.color);
    if (e.yaw != 0.0) { o = o + ", \"yaw\": " + _sc_num3(e.yaw); }
    // Katılık yalnız etikete göre BEKLENENDEN farklıysa yazılır.
    if (e.solid != _default_solid3(e.tag)) {
        if (e.solid == 1) { o = o + ", \"solid\": true"; }
        else { o = o + ", \"solid\": false"; }
    }
    if (e.hpmax > 0) { o = o + ", \"hp\": " + toString(e.hpmax); }
    // İKİ alan yazılıyor ve ikisi AYNI ŞEY DEĞİL:
    //   "model"     — süreç içi handle. Yalnız editörün aynı süreçteki
    //                 gidiş-dönüşü (TAB, geri-al) için; bu olmadan modelli
    //                 varlıklar o turda kutuya dönüşüyordu.
    //   "model_src" — DOSYA YOLU. Taşınabilir olan bu; başka bir çalıştırma
    //                 sahneyi yolla yükler ve handle'ı yeniden kurar.
    // Yükleyici yol varsa yolu yeğliyor. Prosedürel mesh'in (gen_kama vb.)
    // yolu yoktur — o durumda yalnız handle kalıyor, yani eskisi kadar.
    // İKİ koruma AYRI, ve ayrı olmaları şart. Tek koruma `model >= 0` idi:
    // dosya o an yüklenemediyse (eksik varlık, pencere yok) handle -1 kalıyor
    // ve blok tümden atlanıyordu — yani sahneyi kaydetmek model referansını
    // SESSİZCE SİLİYORDU. Yol, handle'ın yüklenip yüklenmediğinden bağımsız
    // olarak varlığın ne olmak istediğini söylüyor; yazılması gereken o.
    // Doku her ŞEKİL için geçerli (model dahil değil — onun dokusu kendi
    // dosyasından gelir), o yüzden model bloğunun DIŞINDA yazılıyor.
    if (e.tsrc != "") {
        o = o + ", \"texture\": " + _sc_q3(e.tsrc);
        if (e.ttile != 1.0) { o = o + ", \"tile\": " + _sc_num3(e.ttile); }
    }
    if (e.shape == SHAPE_MODEL) {
        if (e.msrc != "") { o = o + ", \"model_src\": " + _sc_q3(e.msrc); }
        if (e.model >= 0) { o = o + ", \"model\": " + toString(e.model); }
        if (e.anim_idle >= 0) { o = o + ", \"anim_idle\": " + toString(e.anim_idle); }
        if (e.anim_run >= 0)  { o = o + ", \"anim_run\": " + toString(e.anim_run); }
        // Hız da yazılıyor. Yazılmıyordu: elle kurulmuş bir animasyon hızı
        // kaydedip açınca sessizce 24'e dönüyordu. Yalnız varsayılandan
        // FARKLIYSA yazılır — dosyayı gereksiz alanla şişirmemek için.
        if (e.anim_fps != 24.0) { o = o + ", \"anim_fps\": " + _sc_num3(e.anim_fps); }
    }
    str bs = _sc_bh_js3(_mk_handle3(s));
    if (bs != "") { o = o + ", \"behaviors\": [" + bs + "]"; }
    return o + "}";
}

// Bir varlığın davranışları → JSON dizi gövdesi (köşeli parantezsiz).
// Her tür yalnız KENDİ alanlarını yazıyor: ortak 5 float alanını hepsi için
// dökmek dosyayı okunmaz yapardı ve anlamsız alanlar (dönme hızı olan bir
// "bob") elle düzenleyeni yanıltırdı.
func _sc_bh_js3(id): str {
    str o = "";
    int first = 1;
    int i = 0;
    while (i < length(_bh3)) {
        Bh3 b = _bh3[i];
        if (b.id == id) {
            str one = "";
            if (b.kind == BH_MOVE) {
                one = "{\"type\": \"move\", \"speed\": " + _sc_num3(b.a);
                if (b.b > 0.0) { one = one + ", \"jump\": " + _sc_num3(b.b); }
                one = one + "}";
            }
            if (b.kind == BH_CHASE) {
                one = "{\"type\": \"chase\", \"target\": \"" + _sc_tag_nm3(b.tag) +
                      "\", \"speed\": " + _sc_num3(b.a);
                if (b.b > 0.0) { one = one + ", \"range\": " + _sc_num3(b.b); }
                one = one + "}";
            }
            if (b.kind == BH_PATROL) {
                one = "{\"type\": \"patrol\", \"x1\": " + _sc_num3(b.a) +
                      ", \"z1\": " + _sc_num3(b.b) + ", \"x2\": " + _sc_num3(b.c) +
                      ", \"z2\": " + _sc_num3(b.d) + ", \"speed\": " + _sc_num3(b.e) + "}";
            }
            if (b.kind == BH_SPIN) {
                one = "{\"type\": \"spin\", \"speed\": " + _sc_num3(b.a) + "}";
            }
            if (b.kind == BH_BOB) {
                one = "{\"type\": \"bob\", \"height\": " + _sc_num3(b.a) +
                      ", \"speed\": " + _sc_num3(b.b) + "}";
            }
            if (b.kind == BH_FLOAT) {
                one = "{\"type\": \"float\", \"power\": " + _sc_num3(b.a) +
                      ", \"depth\": " + _sc_num3(b.b) + "}";
            }
            if (b.kind == BH_SHOOT) {
                one = "{\"type\": \"shoot\", \"interval\": " + _sc_num3(b.a) +
                      ", \"speed\": " + _sc_num3(b.b) + ", \"life\": " + _sc_num3(b.c);
                if (b.tag != 0) { one = one + ", \"target\": \"" + _sc_tag_nm3(b.tag) + "\""; }
                if (b.d > 0.0) { one = one + ", \"range\": " + _sc_num3(b.d); }
                one = one + "}";
            }
            if (one != "") {
                if (first == 0) { o = o + ", "; }
                o = o + one;
                first = 0;
            }
        }
        i = i + 1;
    }
    return o;
}

// ---- Kod üretimi -----------------------------------------------------------
// Sahneyi okunabilir Tulpar KODUNA çevir. JSON çalışma zamanı biçimi; kod ise
// öğrenme ve devam etme yolu: editörde kurduğun sahneyi açıp "bu böyle
// yazılıyormuş" diyebilmek, sonra elle geliştirebilmek.
//
// Üretilen şey tek bir FONKSİYON (`kur`), tam bir program değil. Sebebi
// sınanabilirlik: aynı fonksiyon hem oyunun `kurulumda3` kancasına hem de
// "kur, sonra sahneyi JSON olarak yazdır" biçimindeki bir doğrulayıcıya
// bağlanabiliyor. Tam program üretseydik denkliği ölçmenin yolu olmazdı.
func _sc_col_code3(c): str {
    return "rgb(" + toString(_col_r3(c)) + ", " + toString(_col_g3(c)) +
           ", " + toString(_col_b3(c)) + ")";
}

func _sc_shape_code3(v): str {
    if (v == SHAPE_SPHERE) { return "SHAPE_SPHERE"; }
    if (v == SHAPE_CYL)    { return "SHAPE_CYL"; }
    if (v == SHAPE_RAMP)   { return "SHAPE_RAMP"; }
    if (v == SHAPE_MODEL)  { return "SHAPE_MODEL"; }
    return "SHAPE_CUBE";
}
func _sc_tag_code3(v): str {
    if (v == TAG_PLAYER) { return "TAG_PLAYER"; }
    if (v == TAG_ITEM)   { return "TAG_ITEM"; }
    if (v == TAG_WALL)   { return "TAG_WALL"; }
    if (v == TAG_ENEMY)  { return "TAG_ENEMY"; }
    if (v == TAG_BULLET) { return "TAG_BULLET"; }
    return "TAG_PROP";
}
func _sc_act_code3(v): str {
    if (v == ACT_DAMAGE) { return "ACT_DAMAGE"; }
    if (v == ACT_KILL)   { return "ACT_KILL"; }
    if (v == ACT_HURT)   { return "ACT_HURT"; }
    if (v == ACT_WIN)    { return "ACT_WIN"; }
    if (v == ACT_LOSE)   { return "ACT_LOSE"; }
    return "ACT_COLLECT";
}
// Negatif sayılar: Tulpar'da tekil eksi yok, `0.0 - x` yazılıyor.
func _sc_f_code3(v): str {
    if (v < 0.0) { return "0.0 - " + _sc_num3(0.0 - v); }
    return _sc_num3(v);
}

func _sc_world_code3(): str {
    str o = "";
    if (_sky3 == 1) {
        o = o + "    gokyuzu3d(" + _sc_col_code3(_sky_top3) + ", " +
            _sc_col_code3(_sky_bot3) + ");\n";
    }
    if (_fog3 > 0.0) { o = o + "    sis3d(" + _sc_num3(_fog3) + ");\n"; }
    if (_cloud3 > 0.0) { o = o + "    bulut3d(" + _sc_num3(_cloud3) + ");\n"; }
    if (_ground_on == 1) { o = o + "    zemin3(" + _sc_f_code3(_ground_y) + ");\n"; }
    else { o = o + "    zemin_yok3d();\n"; }
    o = o + "    yercekimi3(" + _sc_num3(_grav) + ");\n";
    if (_lights3 == 0)  { o = o + "    isik3d(false);\n"; }
    if (_shadows3 == 0) { o = o + "    golge3d(false);\n"; }
    if (_dn_on3 == 1) {
        o = o + "    gunduz_gece3d(" + _sc_num3(_dn_len3) + ");\n";
        o = o + "    saati_ayarla3d(" + _sc_num3(_dn_h3) + ");\n";
    }
    if (_terr_kind3 == 1) {
        o = o + "    arazi3d(" + toString(_terr_res3) + ", " + _sc_num3(_terr_sx) +
            ", " + _sc_num3(_terr_sy3) + ", " + _sc_num3(_terr_sz) + ", " +
            _sc_num3(_terr_scale3) + ", " + toString(_terr_seed3) + ");\n";
    }
    if (_terr_lay3 == 1) {
        o = o + "    arazi_boya3d(" + _sc_col_code3(_terr_pl3) + ", " +
            _sc_col_code3(_terr_pm3) + ", " + _sc_col_code3(_terr_ph3) + ", " +
            _sc_col_code3(_terr_pr3) + ", " + _sc_num3(_terr_pmy3) + ", " +
            _sc_num3(_terr_phy3) + ", " + _sc_num3(_terr_prs3) + ");\n";
    }
    if (_water_on3 == 1) {
        o = o + "    su3d(" + _sc_f_code3(_water_y3) + ");\n";
        o = o + "    su_renk3d(" + _sc_col_code3(_water_col3) + ", " +
            toString(_water_a3) + ");\n";
    }
    if (_slope_lim3 > 0.0) {
        o = o + "    egim_siniri3d(" + _sc_num3(_slope_lim3) + ");\n";
        o = o + "    kayma_ivmesi3d(" + _sc_num3(_slide_acc3) + ");\n";
    }
    return o;
}

// Varlığın değişkeni: adı varsa o, yoksa `v<slot>`. Ad kullanmak üretilen
// kodu okunur yapıyor (kamera hedefi ve kurallar zaten adla düşünülüyor).
func _sc_var_code3(sl): str {
    str nm = _sc_nm_of3(_mk_handle3(sl));
    if (nm != "") { return nm; }
    return "v" + toString(sl);
}

func _sc_ent_code3(sl): str {
    Ent3 e = _e3[sl];
    str v = _sc_var_code3(sl);
    str o = "    int " + v + " = uret3(" +
        _sc_f_code3(e.x) + ", " + _sc_f_code3(e.y) + ", " + _sc_f_code3(e.z) + ",  " +
        _sc_num3(e.sx) + ", " + _sc_num3(e.sy) + ", " + _sc_num3(e.sz) + ",  " +
        _sc_col_code3(e.color) + ", " + _sc_shape_code3(e.shape) + ", " +
        _sc_tag_code3(e.tag) + ");\n";
    if (e.yaw != 0.0) { o = o + "    don3d(" + v + ", " + _sc_f_code3(e.yaw) + ");\n"; }
    if (e.solid != _default_solid3(e.tag)) {
        if (e.solid == 1) { o = o + "    kati3d(" + v + ", true);\n"; }
        else { o = o + "    kati3d(" + v + ", false);\n"; }
    }
    if (e.hpmax > 0) { o = o + "    can3d(" + v + ", " + toString(e.hpmax) + ");\n"; }
    // AD: kamera hedefi ve kurallar varlıklara adla atıfta bulunuyor, yani
    // adsız üretilen kod aynı sahneyi kurmuyor.
    str nm = _sc_nm_of3(_mk_handle3(sl));
    if (nm != "") { o = o + "    ad_ver3d(" + v + ", \"" + nm + "\");\n"; }
    return o;
}

func _sc_bh_code3(sl): str {
    int hnd = _mk_handle3(sl);
    str v = _sc_var_code3(sl);
    str o = "";
    int i = 0;
    while (i < length(_bh3)) {
        Bh3 b = _bh3[i];
        if (b.id == hnd) {
            if (b.kind == BH_MOVE) {
                o = o + "    hareket_davranis3d(" + v + ", " + _sc_num3(b.a) +
                    ", " + _sc_num3(b.b) + ");\n";
            }
            if (b.kind == BH_CHASE) {
                o = o + "    kovala_davranis3d(" + v + ", " + _sc_tag_code3(b.tag) +
                    ", " + _sc_num3(b.a) + ", " + _sc_num3(b.b) + ");\n";
            }
            if (b.kind == BH_PATROL) {
                o = o + "    devriye_davranis3d(" + v + ", " + _sc_f_code3(b.a) +
                    ", " + _sc_f_code3(b.b) + ", " + _sc_f_code3(b.c) + ", " +
                    _sc_f_code3(b.d) + ", " + _sc_num3(b.e) + ");\n";
            }
            if (b.kind == BH_SPIN) {
                o = o + "    don_davranis3d(" + v + ", " + _sc_f_code3(b.a) + ");\n";
            }
            if (b.kind == BH_BOB) {
                o = o + "    salin_davranis3d(" + v + ", " + _sc_num3(b.a) +
                    ", " + _sc_num3(b.b) + ");\n";
            }
            if (b.kind == BH_FLOAT) {
                o = o + "    yuz_davranis3d(" + v + ", " + _sc_num3(b.a) +
                    ", " + _sc_num3(b.b) + ");\n";
            }
            if (b.kind == BH_SHOOT) {
                o = o + "    ates_davranis3d(" + v + ", " + _sc_num3(b.a) + ", " +
                    _sc_num3(b.b) + ", " + _sc_num3(b.c) + ", " +
                    _sc_tag_code3(b.tag) + ", " + _sc_num3(b.d) + ");\n";
            }
        }
        i = i + 1;
    }
    return o;
}

// Sahneyi kuran FONKSİYON. Oyunun `kurulumda3` kancasına da bağlanabiliyor,
// doğrulayıcıya da — denkliğin ölçülebilmesinin sebebi bu.
func scene_code3d(): str {
    str o = "func kur() {\n";
    // Pencere bilgisi de sahnenin parçası; kod onu da taşımalı yoksa üretilen
    // program başka bir başlık/boyutla açılır.
    o = o + "    sahne_bilgi_ayarla3d(\"" + _sc_title3 + "\", " +
        toString(_sc_w3) + ", " + toString(_sc_h3) + ");\n";
    o = o + _sc_world_code3();
    int i = 0;
    while (i < length(_e3)) {
        Ent3 e = _e3[i];
        if (e.alive == 1 && e.tag != TAG_BULLET && e.life <= 0.0) {
            o = o + _sc_ent_code3(i);
        }
        i = i + 1;
    }
    // Davranışlar varlıklardan SONRA: hepsi tanımlı olsun.
    i = 0;
    while (i < length(_e3)) {
        Ent3 e2 = _e3[i];
        if (e2.alive == 1 && e2.tag != TAG_BULLET && e2.life <= 0.0) {
            o = o + _sc_bh_code3(i);
        }
        i = i + 1;
    }
    // Bölgeler
    int z = 0;
    while (z < length(_trg_x)) {
        if (_trg_shape[z] == 1) {
            o = o + "    int b" + toString(z) + " = bolge_kure3d(" +
                _sc_f_code3(_trg_x[z]) + ", " + _sc_f_code3(_trg_y[z]) + ", " +
                _sc_f_code3(_trg_z[z]) + ", " + _sc_num3(_trg_r[z]) + ", " +
                _sc_tag_code3(_trg_tag[z]) + ");\n";
        } else {
            o = o + "    int b" + toString(z) + " = bolge3d(" +
                _sc_f_code3(_trg_x[z]) + ", " + _sc_f_code3(_trg_y[z]) + ", " +
                _sc_f_code3(_trg_z[z]) + ", " + _sc_num3(_trg_sx[z]) + ", " +
                _sc_num3(_trg_sy[z]) + ", " + _sc_num3(_trg_sz[z]) + ", " +
                _sc_tag_code3(_trg_tag[z]) + ");\n";
        }
        if (_trg_once[z] == 1) { o = o + "    bolge_bir_kere3d(b" + toString(z) + ", true);\n"; }
        if (_trg_on[z] == 0)   { o = o + "    bolge_etkin3d(b" + toString(z) + ", false);\n"; }
        z = z + 1;
    }
    // Kurallar
    int r = 0;
    while (r < length(_rl3)) {
        Rule3 ru = _rl3[r];
        if (ru.kind == RULE_HIT) {
            o = o + "    carpisma_kurali3d(" + _sc_tag_code3(ru.a) + ", " +
                _sc_tag_code3(ru.b) + ", " + _sc_act_code3(ru.act) + ", " +
                _sc_num3(ru.n) + ");\n";
        } else {
            o = o + "    bitince_kurali3d(" + _sc_tag_code3(ru.a) + ", " +
                _sc_act_code3(ru.act) + ");\n";
        }
        r = r + 1;
    }
    // Kamera EN SON: hedefi bir varlık ve o tanımlı olmalı.
    int ct = _slot_of3(_cam_target);
    if (ct >= 0) {
        str tv = _sc_var_code3(ct);
        if (_cam_mode3 == CAM_FPS) {
            o = o + "    kamera_fpv(" + tv + ", " + _sc_num3(_cam_eye3) + ");\n";
        } else {
            float dh = _cam_dist;
            if (_cam_mode3 == CAM_ORBIT) {
                float q = _cam_dist * _cam_dist - _cam_height * _cam_height;
                if (q > 0.0) { dh = sqrt(q); } else { dh = 0.0; }
                o = o + "    kamera_yorunge(" + tv + ", " + _sc_num3(dh) + ", " +
                    _sc_num3(_cam_height) + ");\n";
            } else {
                o = o + "    camera_follow(" + tv + ", " + _sc_num3(dh) + ", " +
                    _sc_num3(_cam_height) + ");\n";
            }
        }
        o = o + "    camera_fov(" + _sc_num3(_cam_fov) + ");\n";
    }
    return o + "}\n";
}
func sahne_kod3d(): str { return scene_code3d(); }

// ---- Prefab (şablon) -------------------------------------------------------
// Bir varlığı ADLI ŞABLON olarak sakla, sonra istediğin yere yerleştir.
// Şablon, varlığın KENDİ SERİLEŞTİRMESİ olarak tutuluyor (`_sc_ent_js3`) ve
// yerleştirme aynı yükleyiciden (`_sc_load_ent3`) geçiyor. Ayrı bir şablon
// biçimi yazmak, varlık biçimi her büyüdüğünde ondan sapardı — davranışlar,
// can, katılık hepsi bedava geliyor.
array _pf_nm3 = [];
array _pf_js3 = [];

func prefab_count3d(): int { return length(_pf_nm3); }
func prefab_name3d(i): str {
    if (i < 0 || i >= length(_pf_nm3)) { return ""; }
    return _pf_nm3[i];
}

func _pf_index3(nm): int {
    int i = 0;
    while (i < length(_pf_nm3)) {
        if (_pf_nm3[i] == nm) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// Varlığı şablon olarak kaydet. Aynı ad varsa ÜZERİNE yazılıyor: iki farklı
// şablonun aynı adı taşıması "hangisi geldi?" sorusunu doğururdu.
func prefab_save3d(nm, id): bool {
    int s = _slot_of3(id);
    if (s < 0 || nm == "") { return false; }
    str js = _sc_ent_js3(s);
    int at = _pf_index3(nm);
    if (at >= 0) { _pf_js3[at] = js; return true; }
    push(_pf_nm3, nm);
    push(_pf_js3, js);
    return true;
}
func sablon_kaydet3d(ad, id): bool { return prefab_save3d(ad, id); }

// Şablonu yerleştir. Konum ezilenler DIŞINDA her şey şablondan geliyor.
func prefab_place3d(nm, x, y, z): int {
    int at = _pf_index3(nm);
    if (at < 0) { return 0 - 1; }
    json e = fromJson(_pf_js3[at]);
    if (length(keys(e)) == 0) { return 0 - 1; }
    int id = _sc_load_ent3(e);
    // Şablonun ADI kopyaya taşınmıyor: iki varlığın aynı adı taşıması ad
    // aramasını belirsiz yapardı.
    rename3d(id, "");
    set3pos(id, x, y, z);
    return id;
}
func sablon_koy3d(ad, x, y, z): int { return prefab_place3d(ad, x, y, z); }

func prefab_delete3d(nm) {
    int at = _pf_index3(nm);
    if (at < 0) { return; }
    int last = length(_pf_nm3) - 1;
    if (at != last) { _pf_nm3[at] = _pf_nm3[last]; _pf_js3[at] = _pf_js3[last]; }
    pop(_pf_nm3);
    pop(_pf_js3);
}

// Şablonlar → JSON.
func _sc_prefabs_js3(): str {
    int n = length(_pf_nm3);
    if (n == 0) { return ""; }
    str o = ",\n  \"prefabs\": [\n";
    int i = 0;
    while (i < n) {
        if (i > 0) { o = o + ",\n"; }
        o = o + "    {\"name\": \"" + _pf_nm3[i] + "\", \"ent\": " +
            trim(_pf_js3[i]) + "}";
        i = i + 1;
    }
    return o + "\n  ]";
}

func _sc_load_prefabs3(ps) {
    int i = 0;
    while (i < length(ps)) {
        json p = ps[i];
        str nm = _sc_s3(p, "name", "");
        if (nm != "" && _sc_has3(p, "ent")) {
            push(_pf_nm3, nm);
            push(_pf_js3, toJson(p["ent"]));
        }
        i = i + 1;
    }
}

// Şu anki sahneyi JSON olarak ver.
// ===========================================================================
// ÇOK BÖLÜMLÜ SAHNE — editörle "ekran" değil OYUN yapmak
// ===========================================================================
// Sahne biçimi tek bir bölüm anlatıyordu: bir dosya = bir ekran. Motorda
// `level3d(n, fn)` vardı ama bir FONKSİYON istiyordu, yani bölümler yalnız
// KOD ile yazılabiliyordu — editörle yapılan bir oyun ilk ekranda bitiyordu.
//
// NE PAYLAŞILIR, NE BÖLÜME AİTTİR:
//   paylaşılan — dünya (gökyüzü, sis, zemin, yerçekimi, kamera) ve şablonlar
//   bölüme ait — varlıklar, bölgeler, kurallar
// Gökyüzünü her bölümde tekrar yazmak dosyayı şişirir ve iki bölümün
// sessizce farklı görünmesine yol açar; asıl değişen şey sahnenin İÇİDİR.
//
// Tek bölümlü dosyalar AYNEN çalışıyor: üst düzey "entities" varsa o tek
// bölümdür. Yeni anahtar "levels" yalnız birden çok bölüm varken yazılıyor.
array _lvl_js3 = [];        // bölüm içerikleri (json), _lvlN ile paralel

// Bölümün sahne-kapsamlı parçası.
func _sc_level_js3(): str {
    str o = "    {\n      \"entities\": [\n";
    int i = 0;
    int first = 1;
    while (i < length(_e3)) {
        Ent3 e = _e3[i];
        if (e.alive == 1 && e.tag != TAG_BULLET && e.life <= 0.0) {
            if (first == 0) { o = o + ",\n"; }
            o = o + _sc_ent_js3(i);
            first = 0;
        }
        i = i + 1;
    }
    return o + "\n      ]" + _sc_zones_js3() + _sc_rules_js3() + "\n    }";
}

// Bölümün sahne-kapsamlı parçasını yükle. Dünyaya ve şablonlara DOKUNMAZ:
// onlar bölümler arasında paylaşılıyor.
func _sc_load_level3(j): int {
    _e3 = []; _e3gen = []; _e3free = []; _free_n3 = 0;
    _bx = []; _by = []; _bz = []; _br = [];
    _rampi3 = [];
    _sc_nm = []; _sc_id = [];
    _bh3 = []; _rl3 = [];
    _trg_clear3();
    int n = 0;
    if (_sc_has3(j, "entities")) {
        json es = j["entities"];
        int i = 0;
        while (i < length(es)) { _sc_load_ent3(es[i]); n = n + 1; i = i + 1; }
    }
    if (_sc_has3(j, "zones")) {
        json zs = j["zones"];
        int z = 0;
        while (z < length(zs)) { _sc_load_zone3(zs[z]); z = z + 1; }
    }
    if (_sc_has3(j, "rules")) {
        json rs = j["rules"];
        int r = 0;
        while (r < length(rs)) { _sc_load_rule3(rs[r]); r = r + 1; }
    }
    _sc_cam_retarget3();
    return n;
}

// Kamerayı ADINDAN yeniden hedefle. ÇOK BÖLÜMLÜ sahnelerde kamera hiç
// çalışmıyordu ve sebebi iki katmanlıydı (ölçüldü — hedef her yerde -1):
//   1. `scene_load3d` kamerayı bölümlerden ÖNCE okuyor, yani `find3d`
//      çağrıldığında bölümün gövdeleri henüz YOK.
//   2. Bölüm değiştirmek entity deposunu tamamen siliyor; kod bölümlerinde
//      kurulum fonksiyonu `camera_follow`'u yeniden çağırıyor ama VERİ
//      bölümlerinde öyle bir fonksiyon yok.
// Bölüm içeriğini yükleyen tek huni burası olduğu için düzeltme de burada.
//
// Yalnız hedef GEÇERSİZKEN çalışıyor: yaşayan bir hedefi ezmek, oyun
// sırasında kamerayı elle başka bir şeye çeviren kodu bozardı.
func _sc_cam_retarget3() {
    if (_sc_cam_nm3 == "") { return; }
    if (camera_target_ok3d()) { return; }
    int t = find3d(_sc_cam_nm3);
    if (t >= 0) { _cam_target = t; }
}

// Bölüm sisteminin VERİ tarafı. `level3d` bir fonksiyon istiyor; veri
// bölümlerinin hepsi BUNU kaydediyor ve hangi bölümde olduğumuza bakıp
// kendi içeriğini yüklüyor.
func _s3_level_data3() {
    int idx = _lvl_index3(_cur_lvl3);
    if (idx < 0 || idx >= length(_lvl_js3)) { return; }
    _sc_load_level3(_lvl_js3[idx]);
}

// ===========================================================================
// SAHNE DENETİMİ — sessiz hataları görünür yapmak
// ===========================================================================
// Veriyle kurulan bir oyunun hataları SESSİZDİR. Kazanma şartı olmayan bir
// sahne çalışır ama bitmez. Hiç düşman bulunmayan bir etikete "bunlar bitince
// kazandın" demek, oyunu daha başlamadan kazandırır. Kovalama davranışı
// sahnede olmayan bir etiketi hedefliyorsa düşman hiç hareket etmez. Hiçbiri
// hata mesajı üretmez — oyun "çalışır", sadece oynanmaz.
//
// Bu denetimler bir süre YALNIZ TESTLERDE yaşadı. Oysa asıl ihtiyaç duyan
// kişi editördeki insan; buraya taşındılar.
//
// UYARI, hata değil: yarım kalmış bir sahne geçerli bir ara adımdır ve
// editör insanı durdurmamalı.
array _chk_msgs3 = [];
// Denetimin en son hangi sahne sürümünde koştuğu. `_ed_dirty3` bir BAYRAK
// (0/1), sürüm değil: iki ardışık düzenlemeyi ayırt edemezdi. Ayrı bir sayaç
// her `ed_mark3d`de artıyor.
int _chk_stamp3 = 0 - 1;
int _ed_dirty_seq3 = 0;

func _chk_tag_say3(t): int {
    int c = 0;
    int i = 0;
    while (i < length(_e3)) {
        Ent3 e = _e3[i];
        if (e.alive == 1 && e.tag == t) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

func _chk_has_bh3(kind): bool {
    int i = 0;
    while (i < length(_bh3)) {
        Bh3 b = _bh3[i];
        if (b.kind == kind) { return true; }
        i = i + 1;
    }
    return false;
}

// MERMİ sahneye konmaz, ateş davranışından çalışma zamanında doğar. Doğru
// soru "mermi var mı?" değil "mermi ÜRETEN bir şey var mı?".
func _chk_tag_ok3(t): bool {
    if (t == TAG_BULLET) { return _chk_has_bh3(BH_SHOOT); }
    return _chk_tag_say3(t) > 0;
}

func _chk_add3(m) { push(_chk_msgs3, m); }

// Sahneyi denetle; sorun sayısını döndürür, mesajlar `_chk_msgs3`te.
func scene_check3d(): int {
    _chk_msgs3 = [];
    int oyuncu = _chk_tag_say3(TAG_PLAYER);
    if (oyuncu == 0) {
        _chk_add3("oyuncu yok (oyuncu etiketli varlik ekle)");
    }
    // BİRDEN ÇOK oyuncu neredeyse her zaman kazadır (çoğaltma, yapıştırma).
    // Hareket girdisi global: ikisi de aynı tuşlara cevap verir ve aynı anda
    // yürürler. Kamera yalnız birini izlediği için öteki ekrandan çıkıp
    // gider — sahne "kayıyor" gibi görünür ve sebebi hiçbir yerde yazmaz.
    if (oyuncu > 1) {
        _chk_add3(toString(oyuncu) +
                  " oyuncu var — hepsi ayni tuslarla birlikte hareket eder");
    }

    // Bitiş şartı: KAZAN ya da SONRAKI BÖLÜM. Bölge eylemleri de sayılıyor —
    // "çıkış kapısına gel" tam bir bitiş şartı ve yalnız kurallara bakan bir
    // denetim onu görmeyip yanlış yere uyarı basardı.
    //
    // "Sonraki bölüm" son bölümde de bitiriyor (kayıtlı bölüm kalmayınca
    // `_s3_apply_level` kazandırıyor), yani ayrı bir "son bölümde win olsun"
    // kuralı gerekmiyor.
    bool win = false;
    int i = 0;
    while (i < length(_rl3)) {
        Rule3 r = _rl3[i];
        if (r.act == ACT_WIN || r.act == ACT_NEXT) { win = true; }
        i = i + 1;
    }
    i = 0;
    while (i < length(_trg_act)) {
        if (_trg_act[i] == ZACT_WIN || _trg_act[i] == ZACT_NEXT) { win = true; }
        i = i + 1;
    }
    if (!win) { _chk_add3("kazanma sarti yok — oyun bitirilemez"); }

    // Kuralların etiketleri sahnede karşılığı olan etiketler mi?
    i = 0;
    while (i < length(_rl3)) {
        Rule3 r = _rl3[i];
        if (r.kind == RULE_HIT) {
            if (!_chk_tag_ok3(r.a)) {
                _chk_add3("kural: sahnede '" + _sc_tag_nm3(r.a) + "' yok");
            }
            if (!_chk_tag_ok3(r.b)) {
                _chk_add3("kural: sahnede '" + _sc_tag_nm3(r.b) + "' yok");
            }
        }
        if (r.kind == RULE_CLEARED) {
            if (_chk_tag_say3(r.a) == 0) {
                _chk_add3("'" + _sc_tag_nm3(r.a) +
                          "' bitince kurali ama hic yok — aninda biter");
            }
            // "bitince" kuralı dağıtıcıya çarpışan çift yerine -1 geçiyor,
            // yani topla / öldür / hasar orada SESSİZ boş işlem. Düğme artık
            // onları seçtirmiyor ama daha önce yazılmış (ya da elle
            // düzenlenmiş) dosyalarda duruyor olabilir.
            if (!_ed_act_works_cleared3(r.act)) {
                _chk_add3("'" + _sc_tag_nm3(r.a) +
                          "' bitince kuralinin eylemi bir sey yapmaz");
            }
        }
        i = i + 1;
    }

    // Davranışların hedef etiketleri.
    i = 0;
    while (i < length(_bh3)) {
        Bh3 b = _bh3[i];
        if (b.kind == BH_CHASE && _chk_tag_say3(b.tag) == 0) {
            _chk_add3("kovala: hedef '" + _sc_tag_nm3(b.tag) + "' sahnede yok");
        }
        if (b.kind == BH_SHOOT && b.tag != 0 && _chk_tag_say3(b.tag) == 0) {
            _chk_add3("ates: hedef '" + _sc_tag_nm3(b.tag) + "' sahnede yok");
        }
        i = i + 1;
    }

    // Oyuncu hareket edebiliyor mu? Hareket davranışı olmayan oyuncu
    // tuşlara cevap vermez ve sahne "donmuş" görünür.
    if (oyuncu > 0 && !_chk_has_bh3(BH_MOVE)) {
        _chk_add3("oyuncuda hareket davranisi yok — tuslar islemez");
    }

    // Var olup HİÇBİR kurala girmeyen etiketler: sahnede duruyorlar ama
    // oyuna dokunmuyorlar.
    if (_chk_tag_say3(TAG_ENEMY) > 0 && !_chk_tag_in_rule3(TAG_ENEMY)) {
        _chk_add3("dusman var ama hicbir kurala girmiyor — zararsizlar");
    }
    if (_chk_tag_say3(TAG_ITEM) > 0 && !_chk_tag_in_rule3(TAG_ITEM)) {
        _chk_add3("esya var ama hicbir kurala girmiyor — toplanamazlar");
    }

    // Modeli YÜKLENEMEMİŞ varlıklar. Sahne dosyası artık yol taşıyor, yani
    // dosya taşınınca/silinince bağ kopabiliyor. Kopan bağ sessiz: varlık
    // orada durur, hiçbir şey çizilmez. Denetim onu söylüyor.
    int eksik = 0;
    i = 0;
    while (i < length(_e3)) {
        Ent3 ce = _e3[i];
        if (ce.alive == 1 && ce.msrc != "" && _ed_as_loaded3(ce.msrc) == 0) {
            eksik = eksik + 1;
        }
        i = i + 1;
    }
    if (eksik > 0) {
        _chk_add3(toString(eksik) + " varligin model dosyasi yuklenemedi");
    }

    // Kural sesleri de kopabilir — model dosyalarıyla aynı gerekçe, ve
    // sessizlik daha da sinsi: eksik model boş bir yer bırakır, eksik ses
    // hiçbir iz bırakmaz. Yalnız DENENMİŞ ve olmamış olanlar sayılıyor;
    // hiç çalınmamış bir ses hakkında bir şey bilinmiyor.
    int sesyok = 0;
    i = 0;
    while (i < length(_rl3)) {
        Rule3 sr = _rl3[i];
        if (sr.snd != "" && _as_find3(sr.snd, AS_SOUND3) >= 0) {
            if (_as_h3[_as_find3(sr.snd, AS_SOUND3)] < 0) { sesyok = sesyok + 1; }
        }
        i = i + 1;
    }
    if (sesyok > 0) {
        _chk_add3(toString(sesyok) + " kuralin ses dosyasi yuklenemedi");
    }

    // Bölgeler: eklenip UNUTULAN bölge tam sessiz. Görünmüyor (bölgeler
    // çizilmiyor), hata vermiyor, sahneyi de bozmuyor — sadece hiçbir şey
    // yapmıyor. İki ayrı sessizlik var ve ikisi ayrı ayrı söyleniyor.
    int olu_bolge = 0;
    int etiketsiz = 0;
    i = 0;
    while (i < length(_trg_shape)) {
        // 1) Ne veri eylemi ne de kod kancası: bölge tümüyle ölü.
        if (_trg_act[i] == ZACT_NONE && _trg_hasin[i] == 0 &&
            _trg_hasout[i] == 0 && _trg_hasstay[i] == 0) {
            olu_bolge = olu_bolge + 1;
        }
        // 2) İzlediği etiketten sahnede hiç yok: eylemi olsa da hiç atmaz.
        if (_chk_tag_say3(_trg_tag[i]) == 0) { etiketsiz = etiketsiz + 1; }
        i = i + 1;
    }
    // KAMERA: hedefi olmayan ya da hedefi SİLİNMİŞ kamera hiç kıpırdamaz.
    // Sahne yine açılıyor, hata da vermiyor — oyun sadece tek bir noktadan
    // izleniyor ve oyuncu ekrandan çıkıp gidiyor. Sıfırdan kurulan her sahne
    // bu durumda başlıyor (şablonlar hedefi kendileri kuruyor), yani en çok
    // görülecek uyarı bu.
    if (_cam_target < 0) {
        _chk_add3("kamera hedefi yok — kamera kimseyi izlemiyor");
    } else {
        if (camera_target_ok3d() == false) {
            _chk_add3("kamera hedefi silinmis — kamera bir yere cakili kaldi");
        }
    }

    if (olu_bolge > 0) {
        _chk_add3(toString(olu_bolge) +
                  " bolge hicbir sey yapmiyor (girince eylemi sec)");
    }
    if (etiketsiz > 0) {
        _chk_add3(toString(etiketsiz) +
                  " bolgenin izledigi etiket sahnede yok — hic atmaz");
    }
    return length(_chk_msgs3);
}
func sahne_denetle3d(): int { return scene_check3d(); }

func _chk_tag_in_rule3(t): bool {
    int i = 0;
    while (i < length(_rl3)) {
        Rule3 r = _rl3[i];
        if (r.kind == RULE_HIT && (r.a == t || r.b == t)) { return true; }
        if (r.kind == RULE_CLEARED && r.a == t) { return true; }
        i = i + 1;
    }
    return false;
}

func scene_check_count3d(): int { return length(_chk_msgs3); }
func scene_check_msg3d(i): str {
    if (i < 0 || i >= length(_chk_msgs3)) { return ""; }
    return _chk_msgs3[i];
}

// ===========================================================================
// OYUN ŞABLONLARI — boş başlangıç problemi
// ===========================================================================
// "Yeni sahne" bomboş bir dünya açıyordu. Editörün en çok görülen ilk ekranı
// hiçbir şey içermiyor, üstelik inceleyicide "secili varlik yok" yazıyordu —
// yani yeni gelen kişi, oyunun hangi parçalardan yapıldığını hiç görmeden
// boşluğa bakıyordu.
//
// Şablon TAM OYNANABİLİR bir sahne kuruyor: oyuncu, zemin, duvarlar,
// davranışlar, kurallar ve kazanma şartı. "Oynat"a basınca oyun ÇALIŞIYOR.
// Öğrenme yolu da bu — çalışan bir şeyi kurcalamak, boş sayfayı doldurmaktan
// çok daha kolay.
//
// Yıkıcı bir işlem (sahneyi değiştiriyor) ama ONAY SORULMUYOR: `ed_mark3d`
// ile geri-al noktası bırakılıyor, yani CTRL+Z eski sahneyi geri getiriyor.
// Editörün geri kalanı da kipsiz; bir modal pencere buraya yabancı olurdu.
int TPL_TOPLAYICI = 0;
int TPL_ARENA     = 1;
int TPL_PLATFORM  = 2;

// Yer tutucu dokuların kök dizini — seslerle aynı gerekçe ve aynı bedel:
// yol depo köküne göreli, başka bir dizinden çalıştırılırsa doku yüklenmez
// ve varlık düz renge düşer (çökmez).
func _tpl_doku3(ad): str { return "examples/assets/dokular/" + ad; }

func _tpl_duvarlar3(r) {
    // Duvarlar DOKULU: düz gri kutular editörün "her şey plastik" hâliydi.
    // Döşeme duvarın uzunluğuyla orantılı, yoksa tuğla gerilip bulanıklaşır.
    float dt = r * 0.5;
    int a = uret3(0.0, 1.5, 0.0 - r, r * 2.0 + 2.0, 3.0, 1.0, WHITE, SHAPE_CUBE, TAG_WALL);
    int b = uret3(0.0, 1.5, r,       r * 2.0 + 2.0, 3.0, 1.0, WHITE, SHAPE_CUBE, TAG_WALL);
    int c = uret3(0.0 - r, 1.5, 0.0, 1.0, 3.0, r * 2.0 + 2.0, WHITE, SHAPE_CUBE, TAG_WALL);
    int d = uret3(r, 1.5, 0.0,       1.0, 3.0, r * 2.0 + 2.0, WHITE, SHAPE_CUBE, TAG_WALL);
    set_texture3d(a, _tpl_doku3("tugla.png"), dt);
    set_texture3d(b, _tpl_doku3("tugla.png"), dt);
    set_texture3d(c, _tpl_doku3("tugla.png"), dt);
    set_texture3d(d, _tpl_doku3("tugla.png"), dt);
}

// Her şablonun ortak açılışı: temiz sahne, dünya ayarları, oyuncu.
func _tpl_base3(): int {
    _sc_clear_for_load3();
    _sc_world_defaults3();
    zemin3(0.0);
    // Zemin de dokulu: düz yeşil bir düzlem ölçek hissi vermiyordu, dokulu
    // zeminde ne kadar hızlı gittiğin görünüyor.
    ground_texture_src3d(_tpl_doku3("cimen.png"), 28.0);
    gokyuzu3d(rgb(38, 52, 92), rgb(176, 198, 224));
    sis3d(0.014);
    yercekimi3(26.0);
    int p = uret3(0.0, 1.0, 8.0, 1.2, 2.0, 1.2, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    ad_ver3d(p, "kahraman");
    can3d(p, 100);
    hareket_davranis3d(p, 10.0, 12.0);
    kamera_yorunge(p, 16.0, 11.0);
    return p;
}

// Yer tutucu seslerin kök dizini. Şablonlar bunu kullanıyor, yani editörle
// tek tıkla kurulan oyun kutudan çıktığı gibi DUYULUYOR — sessiz bir şablon
// "ses nasıl eklenir" sorusunu hiç sordurmuyordu. Yol depo köküne göreli;
// başka bir dizinden çalıştırılırsa sahne denetimi eksik dosyaları söylüyor.
func _tpl_ses3(ad): str { return "examples/assets/sesler/" + ad; }

// EN SON eklenen kurala ses bağla — `carpisma_kurali3d`/`bitince_kurali3d`
// diziye ekliyor, yani "son" her zaman az önce yazılan kural.
func _tpl_son_ses3(ad) { _rl_set_snd3(length(_rl3) - 1, _tpl_ses3(ad)); }

func ed_template3d(k) {
    ed_mark3d();
    if (k == TPL_ARENA) {
        int p = _tpl_base3();
        _tpl_duvarlar3(16.0);
        // Sütunlar: siper. Nişancıda siper olmadan kaçacak yer kalmıyor.
        int s1 = uret3(7.0, 2.0, 7.0, 1.6, 4.0, 1.6, WHITE, SHAPE_CYL, TAG_WALL);
        int s2 = uret3(0.0 - 7.0, 2.0, 0.0 - 7.0, 1.6, 4.0, 1.6, WHITE, SHAPE_CYL, TAG_WALL);
        set_texture3d(s1, _tpl_doku3("metal.png"), 2.0);
        set_texture3d(s2, _tpl_doku3("metal.png"), 2.0);
        // Oyuncu ateş eder; düşmanlar kovalar.
        ates_davranis3d(p, 0.45, 26.0, 1.6, TAG_ENEMY, 40.0);
        int i = 0;
        while (i < 4) {
            float ax = 10.0;
            float az = 10.0;
            if (i == 1) { ax = 0.0 - 10.0; }
            if (i == 2) { az = 0.0 - 10.0; }
            if (i == 3) { ax = 0.0 - 10.0; az = 0.0 - 10.0; }
            int e = uret3(ax, 1.0, az, 1.3, 2.0, 1.3, rgb(230, 80, 80), SHAPE_CUBE, TAG_ENEMY);
            can3d(e, 50);
            kovala_davranis3d(e, TAG_PLAYER, 4.2, 40.0);
            i = i + 1;
        }
        carpisma_kurali3d(TAG_BULLET, TAG_ENEMY, ACT_HURT, 25);
        _tpl_son_ses3("vurus.wav");
        carpisma_kurali3d(TAG_ENEMY, TAG_PLAYER, ACT_DAMAGE, 12);
        _tpl_son_ses3("vurus.wav");
        bitince_kurali3d(TAG_ENEMY, ACT_WIN);
        _tpl_son_ses3("kazandin.wav");
        kayit3d("sablon: ARENA — dusmanlari temizle");
        return;
    }
    if (k == TPL_PLATFORM) {
        int p = _tpl_base3();
        // Zemin ÖLDÜRÜCÜ değil (motorda düşme ölümü yok); platformlar
        // yükseklik veriyor ve altınlar tepelerinde.
        _tpl_duvarlar3(14.0);
        float px2 = 0.0 - 8.0;
        int i = 0;
        while (i < 4) {
            float ph = 2.0 + i * 1.6;
            int pl = uret3(px2, ph, 0.0 - i * 4.0, 4.0, 0.6, 3.0,
                           WHITE, SHAPE_CUBE, TAG_WALL);
            set_texture3d(pl, _tpl_doku3("tahta.png"), 2.0);
            // Bir platform salınsın: zıplamayı zamanlamak gerekiyor.
            if (i == 2) { salin_davranis3d(pl, 1.2, 0.8); }
            // Altın platformun ÜST YÜZEYİNDE dinleniyor: platform yarı
            // yüksekliği 0.3 + altın yarıçapı 0.5. Eskiden merkezden 1.2
            // yukarıdaydı, yani havada duruyordu — salınan platform için
            // bu, altının salınım aralığının İÇİNDE kalması demekti.
            uret3(px2, ph + 0.3 + 0.5, 0.0 - i * 4.0, 1.0, 1.0, 1.0, GOLD,
                  SHAPE_SPHERE, TAG_ITEM);
            px2 = px2 + 5.5;
            i = i + 1;
        }
        carpisma_kurali3d(TAG_PLAYER, TAG_ITEM, ACT_COLLECT, 10);
        _tpl_son_ses3("altin.wav");
        bitince_kurali3d(TAG_ITEM, ACT_WIN);
        _tpl_son_ses3("kazandin.wav");
        kayit3d("sablon: PLATFORM — altinlari topla, ziplamayi zamanla");
        return;
    }
    // Varsayılan: TOPLAYICI
    _tpl_base3();
    _tpl_duvarlar3(14.0);
    int i2 = 0;
    while (i2 < 5) {
        float ang = i2 * 1.2566;
        uret3(cos(ang) * 9.0, 1.0, sin(ang) * 9.0, 1.0, 1.0, 1.0,
              GOLD, SHAPE_SPHERE, TAG_ITEM);
        i2 = i2 + 1;
    }
    int d = uret3(0.0 - 9.0, 1.0, 0.0 - 9.0, 1.3, 2.0, 1.3,
                  rgb(230, 80, 80), SHAPE_CUBE, TAG_ENEMY);
    kovala_davranis3d(d, TAG_PLAYER, 3.5, 30.0);
    carpisma_kurali3d(TAG_PLAYER, TAG_ITEM, ACT_COLLECT, 10);
    _tpl_son_ses3("altin.wav");
    carpisma_kurali3d(TAG_ENEMY, TAG_PLAYER, ACT_DAMAGE, 12);
    _tpl_son_ses3("vurus.wav");
    bitince_kurali3d(TAG_ITEM, ACT_WIN);
    _tpl_son_ses3("kazandin.wav");
    kayit3d("sablon: TOPLAYICI — altinlari topla, kirmiziya degme");
}
func sablon_kur3d(k) { ed_template3d(k); }

// --- Editör tarafı: bölümler arasında gezinme ------------------------------
int _ed_lvl3 = 0;           // düzenlenen bölüm (0-tabanlı)

func ed_level_count3d(): int { return length(_lvl_js3); }
func ed_level_now3d(): int { return _ed_lvl3 + 1; }

// Yaşayan sahneyi ŞU ANKİ bölüme geri yaz. Bölüm değiştirmeden, kaydetmeden
// ve oynatmadan önce ŞART: yoksa o bölümde yapılan iş sessizce kaybolur —
// ve sessiz kayıp bu editörde daha önce bir kez gerçekten yaşandı.
func _ed_level_store3() {
    if (_ed_lvl3 < 0 || _ed_lvl3 >= length(_lvl_js3)) { return; }
    _lvl_js3[_ed_lvl3] = fromJson(_sc_level_js3());
}

func ed_level_go3d(k) {
    int i = k - 1;
    if (i < 0 || i >= length(_lvl_js3) || i == _ed_lvl3) { return; }
    _ed_level_store3();
    _ed_lvl3 = i;
    _cur_lvl3 = k;
    _sc_load_level3(_lvl_js3[i]);
    _ed_sel3e = 0 - 1;
    _ed_drag3 = 0;
    _ed_dirty3 = 1;
}
// EDİTÖRÜN bölüm değiştirmesi. Adı `ed_` önekli ve bu ZORUNLU: `bolum_git3d`
// zaten OYUNUN `goto_level3d`'si olarak tanımlıydı (serbest atlama, kare
// sonunda uygulanır) ve iki farklı iş tek adı paylaşıyordu. Derleyici
// uyarmıyor, biri sessizce ölüyor — ölçüldü: editör alias'ı hiç çalışmıyordu,
// `bolum_git3d(2)` editörde bölüm değiştirmek yerine oyuna bir geçiş isteği
// bırakıyordu.
func ed_bolum_git3d(k) { ed_level_go3d(k); }

// Yeni BOŞ bölüm ekle ve ona geç. Tek bölümlü bir sahne burada çok bölümlüye
// DÖNÜŞÜYOR: yaşayan sahne 1. bölüm oluyor.
func ed_level_add3d() {
    // Yaşayan bölüm ÖNCE diziye yazılıyor, sonra yapısal işaret alınıyor:
    // aksi hâlde anlık görüntü, o an ekranda olan düzenlemeleri kaçırırdı.
    _ed_level_store3();
    ed_mark_all3d();
    if (length(_lvl_js3) == 0) {
        push(_lvl_js3, fromJson(_sc_level_js3()));
        level3d(1, "_s3_level_data3");
        _ed_lvl3 = 0;
    } else {
        _ed_level_store3();
    }
    push(_lvl_js3, fromJson("{\"entities\": []}"));
    level3d(length(_lvl_js3), "_s3_level_data3");
    _ed_lvl3 = length(_lvl_js3) - 1;
    _cur_lvl3 = _ed_lvl3 + 1;
    _sc_load_level3(_lvl_js3[_ed_lvl3]);
    _ed_sel3e = 0 - 1;
    _ed_dirty3 = 1;
}
func bolum_ekle3d() { ed_level_add3d(); }

// Bulunulan bölümü sil. SON bölüm silinmiyor: bölümsüz bir oyun yok ve
// "hepsini sildim, sahnem nerede?" durumu geri alınamaz görünürdü.
func ed_level_del3d() {
    if (length(_lvl_js3) < 2) { return; }
    _ed_level_store3();
    ed_mark_all3d();
    int i = _ed_lvl3;
    int last = length(_lvl_js3) - 1;
    int k = i;
    while (k < last) { _lvl_js3[k] = _lvl_js3[k + 1]; k = k + 1; }
    pop(_lvl_js3);
    // Bölüm numaraları 1..N olarak yeniden kuruluyor: aradan biri silinince
    // numaralar delik kalırsa `bolum_gec3d` boşluğa düşer ve oyun biter.
    _lvlN = []; _lvlF = [];
    k = 0;
    while (k < length(_lvl_js3)) { level3d(k + 1, "_s3_level_data3"); k = k + 1; }
    if (_ed_lvl3 > length(_lvl_js3) - 1) { _ed_lvl3 = length(_lvl_js3) - 1; }
    _cur_lvl3 = _ed_lvl3 + 1;
    _sc_load_level3(_lvl_js3[_ed_lvl3]);
    _ed_sel3e = 0 - 1;
    _ed_dirty3 = 1;
}
func bolum_sil3d() { ed_level_del3d(); }

func level_count3d(): int { return length(_lvl_js3); }
func bolum_sayisi3d(): int { return level_count3d(); }

func scene_json3d(): str {
    str o = "{\n  \"v\": " + toString(SCENE_V3) + ",\n" + _sc_world_js3() + ",\n";
    o = o + "  \"entities\": [\n";
    int i = 0;
    int first = 1;
    while (i < length(_e3)) {
        Ent3 e = _e3[i];
        // Mermi ve ömürlü şeyler ÇALIŞMA ZAMANI ürünü — sahne değil.
        if (e.alive == 1 && e.tag != TAG_BULLET && e.life <= 0.0) {
            if (first == 0) { o = o + ",\n"; }
            o = o + _sc_ent_js3(i);
            first = 0;
        }
        i = i + 1;
    }
    return o + "\n  ]" + _sc_zones_js3() + _sc_prefabs_js3() +
           _sc_rules_js3() + "\n}\n";
}

// Çok bölümlü yazım. Tek bölümde ESKİ biçim yazılıyor — yeni bir anahtar
// eklemek, tek bölümlü her dosyayı gereksizce değiştirirdi.
func scene_json_levels3d(): str {
    if (length(_lvl_js3) < 2) { return scene_json3d(); }
    str o = "{\n  \"v\": " + toString(SCENE_V3) + ",\n" + _sc_world_js3() + ",\n";
    str pf = _sc_prefabs_js3();
    if (length(pf) > 0) {
        // _sc_prefabs_js3 ",\n  ..." ile başlıyor; baştaki virgülü atıyoruz.
        o = o + substring(pf, 2, length(pf)) + ",\n";
    }
    o = o + "  \"levels\": [\n";
    int k = 0;
    while (k < length(_lvl_js3)) {
        if (k > 0) { o = o + ",\n"; }
        o = o + toJson(_lvl_js3[k]);
        k = k + 1;
    }
    return o + "\n  ]\n}\n";
}
func sahne_json_bolumlu3d(): str { return scene_json_levels3d(); }
func sahne_json3d(): str { return scene_json3d(); }

// Diske yaz — web'de tarayıcının kalıcı deposuna (bkz. _s3_key3).
func scene_save3d(path): bool {
    if (web_mi()) { return kayit_yaz(_s3_key3(path), scene_json3d()); }
    return write_file(path, scene_json3d());
}

// Sahneyi kullanıcının BİLGİSAYARINA çıkar: web'de tarayıcı indirmesi,
// masaüstünde dosyaya yazma. localStorage sayfanın içinde kalıyor; web
// editöründe yapılan işi dışarı almanın (depoya koymanın, paylaşmanın)
// tek yolu bu.
func scene_export3d(path): bool { return indir(path, scene_json3d()); }
func sahne_disari3d(yol): bool { return scene_export3d(yol); }
func sahne_kaydet3d(yol): bool { return scene_save3d(yol); }

// ===========================================================================
// DAVRANIŞLAR — oynanış da veri (Faz 13)
// ===========================================================================
// Sahne biçimi geometriyi veri yaptı ama oyun hâlâ kod istiyordu: `update()`
// yazmadan hiçbir şey kıpırdamıyor. Bu, bir EDİTÖR için sert bir duvar —
// tarayıcıda çalışan editörün yanında derleyici yok, kullanıcının yazdığı
// Tulpar'ı çalıştıramaz. Yani "Oynat" düğmesinin çalışabilmesi için oynanışın
// da veri olması gerekiyor.
//
// Çözüm Unity/Unreal'ın bileşen listesiyle aynı: varlığa hazır davranış tak.
// Hepsi motorda ZATEN var olan işlevlerin (move3d, chase3d, patrol3d,
// bullet3d) üstüne bindiriliyor — yeni fizik yazılmadı, yalnız veriden
// sürülüyor. Böylece davranışla kurulmuş oyun ile elle yazılmış oyun aynı
// kodu koşturuyor, ikisi ayrışamaz.
//
// KOD VERİYİ EZER: davranışlar kullanıcının `update()`inden ÖNCE işliyor, yani
// aynı varlığa elle `hareket3(p, 15.0)` yazan biri davranışın verdiği hızı
// eziyor. Aynı öncelik kuralı import'larda da geçerli (yerel tanım kazanır).
int BH_MOVE   = 0;   // oyuncu girdisiyle hareket (+zıplama)
int BH_CHASE  = 1;   // en yakın hedefi kovala
int BH_PATROL = 2;   // iki nokta arasında devriye
int BH_SPIN   = 3;   // kendi ekseninde dön (süs)
int BH_BOB    = 4;   // yerinde alçalıp yüksel (toplanabilir parıltısı)
int BH_SHOOT  = 5;   // aralıkla ateş et
// Suda YÜZ. Su fiziği cismi yavaşça batırıyordu; kaldırma kuvveti yoktu, yani
// sandık/varil gibi yüzen bir şey kurmanın yolu da yoktu. Davranış olarak
// eklendi (dünya ayarı değil) çünkü yüzüp yüzmemek CİSMİN özelliği: aynı
// suda taş batar, tahta yüzer.
int BH_FLOAT  = 6;   // suda yüzeye çık

// Metin alanı YOK — hedef daima ETİKET (tag) ya da çözülmüş handle olarak
// saklanıyor. Bir davranışın hedefini adla tutmak, hedef öldüğünde her karede
// ad araması yapmayı gerektirirdi; etiket zaten "en yakın oyuncu" demenin
// doğal yolu.
struct Bh3 {
    int id;        // sahibinin handle'ı
    int kind;      // BH_*
    int tag;       // hedef etiketi (0 = yok)
    int hnd;       // belirli hedef handle (-1 = yok)
    float a; float b; float c; float d; float e;
    float t;       // dahili sayaç (atış zamanlayıcısı / salınım fazı)
    float base;    // dahili taban (bob'un başlangıç yüksekliği)
}
array _bh3 = [];

func _bh_add3(id, kind, tag, hnd, a, b, c, d, e): int {
    Bh3 b = { id: id, kind: kind, tag: tag, hnd: hnd,
              a: a * 1.0, b: b * 1.0, c: c * 1.0, d: d * 1.0, e: e * 1.0,
              t: 0.0, base: 0.0 };
    // Bob'un tabanı EKLENDİĞİ andaki yükseklik: sonradan okumak, salınımın
    // kendi ürettiği yüksekliği taban sanmaya yol açardı.
    int s = _slot_of3(id);
    if (s >= 0) { b.base = _e3[s].y; }
    push(_bh3, b);
    return length(_bh3) - 1;
}

// ---- Genel API -------------------------------------------------------------
// Oyuncu kontrolü: WASD/kol ile hareket, boşlukla zıplama (jump = 0 → zıplama
// yok, tepeden bakışlı oyunlar için).
func move_behavior3d(id, speed, jump) { _bh_add3(id, BH_MOVE, 0, 0 - 1, speed, jump, 0.0, 0.0, 0.0); }
func hareket_davranis3d(id, hiz, zipla) { move_behavior3d(id, hiz, zipla); }

// Kovalama: etiketi verilen en yakın canlıyı kovalar. range = 0 → sınırsız.
func chase_behavior3d(id, target_tag, speed, range) {
    _bh_add3(id, BH_CHASE, target_tag, 0 - 1, speed, range, 0.0, 0.0, 0.0);
}
func kovala_davranis3d(id, hedef_etiket, hiz, menzil) {
    chase_behavior3d(id, hedef_etiket, hiz, menzil);
}

// Devriye: iki nokta arasında gidip gelir (patrol3d zaten uçlarda yön çeviriyor).
func patrol_behavior3d(id, x1, z1, x2, z2, speed) {
    _bh_add3(id, BH_PATROL, 0, 0 - 1, x1, z1, x2, z2, speed);
}
func devriye_davranis3d(id, x1, z1, x2, z2, hiz) {
    patrol_behavior3d(id, x1, z1, x2, z2, hiz);
}

// Dönme (derece/sn) ve salınım (yükseklik birimi, çevrim/sn) — ikisi de süs;
// fiziğe dokunmuyorlar, yalnız yaw ve y yazıyorlar.
func spin_behavior3d(id, deg_per_sec) { _bh_add3(id, BH_SPIN, 0, 0 - 1, deg_per_sec, 0.0, 0.0, 0.0, 0.0); }
func don_davranis3d(id, derece_sn) { spin_behavior3d(id, derece_sn); }
func bob_behavior3d(id, height, speed) { _bh_add3(id, BH_BOB, 0, 0 - 1, height, speed, 0.0, 0.0, 0.0); }
func salin_davranis3d(id, yukseklik, hiz) { bob_behavior3d(id, yukseklik, hiz); }

// Ateş: her `interval` saniyede bir mermi. target_tag = 0 ise nişan yönüne
// (oyuncu), değilse en yakın hedefe döner ve ona atar (düşman kulesi).
// Suda yüz. guc = yüzeye çıkma hızı (batıklıkla orantılı ivme),
// derinlik = yüzeyin ne kadar ALTINDA dengelensin (0 = tam yüzeyde).
func float_behavior3d(id, guc, derinlik) {
    _bh_add3(id, BH_FLOAT, 0, 0 - 1, guc, derinlik, 0.0, 0.0, 0.0);
}
func yuz_davranis3d(id, guc, derinlik) { float_behavior3d(id, guc, derinlik); }

func shoot_behavior3d(id, interval, speed, life, target_tag, range) {
    _bh_add3(id, BH_SHOOT, target_tag, 0 - 1, interval, speed, life, range, 0.0);
}
func ates_davranis3d(id, aralik, hiz, omur, hedef_etiket, menzil) {
    shoot_behavior3d(id, aralik, hiz, omur, hedef_etiket, menzil);
}

// Bir varlığın davranışlarını sil (editörde bileşen kaldırma).
func clear_behaviors3d(id) {
    int i = 0;
    while (i < length(_bh3)) {
        if (_bh3[i].id == id) {
            int last = length(_bh3) - 1;
            if (i != last) { _bh3[i] = _bh3[last]; }
            pop(_bh3);
        } else { i = i + 1; }
    }
}
func davranislari_sil3d(id) { clear_behaviors3d(id); }
func behavior_count3d(): int { return length(_bh3); }
func davranis_sayisi3d(): int { return behavior_count3d(); }

// ---- Hedef seçimi ----------------------------------------------------------
// Etikete göre EN YAKIN canlı — HANDLE döner (`_aim_nearest3` slot döndürüyor
// ve global nişan ayarlarını okuyor; davranışların kendi menzili var).
// range <= 0 → sınırsız.
func _bh_nearest3(owner, tag, range): int {
    int os = _slot_of3(owner);
    if (os < 0) { return 0 - 1; }
    Ent3 o = _e3[os];
    int best = 0 - 1;
    float bd = 0.0 - 1.0;
    if (range > 0.0) { bd = range * range; }
    int i = 0;
    int n = length(_e3);
    while (i < n) {
        Ent3 e = _e3[i];
        if (e.alive == 1 && e.tag == tag && i != os) {
            float dx = e.x - o.x; float dy = e.y - o.y; float dz = e.z - o.z;
            float d2 = dx * dx + dy * dy + dz * dz;
            if (bd < 0.0 || d2 < bd) { bd = d2; best = i; }
        }
        i = i + 1;
    }
    if (best < 0) { return 0 - 1; }
    return _mk_handle3(best);
}

// ---- Tek davranışın karesi -------------------------------------------------
func _bh_tick3(i, dt) {
    Bh3 b = _bh3[i];
    int s = _slot_of3(b.id);

    if (b.kind == BH_MOVE) {
        move3d(b.id, b.a);
        if (b.b > 0.0 && jump_pressed()) { jump3d(b.id, b.b); }
    }

    if (b.kind == BH_CHASE) {
        int t = _bh_nearest3(b.id, b.tag, b.b);
        // Menzil dışındaysa DURUYOR, son hızıyla kaymıyor: kovalamayı bırakan
        // düşmanın süzülerek uzaklaşması hata gibi görünürdü.
        if (t >= 0) { chase3d(b.id, t, b.a); }
        else {
            Ent3 e = _e3[s];
            e.vx = 0.0; e.vz = 0.0;
            _e3[s] = e;
        }
    }

    if (b.kind == BH_PATROL) { patrol3d(b.id, b.a, b.b, b.c, b.d, b.e); }

    if (b.kind == BH_SPIN) {
        Ent3 e = _e3[s];
        e.yaw = e.yaw + b.a * dt;
        // 0..360'a sar: saatlerce dönen bir süs varlığında yaw büyüyüp
        // float çözünürlüğünü yerdi.
        if (e.yaw >= 360.0) { e.yaw = e.yaw - 360.0; }
        if (e.yaw < 0.0)    { e.yaw = e.yaw + 360.0; }
        _e3[s] = e;
    }

    if (b.kind == BH_BOB) {
        b.t = b.t + dt * b.b;
        if (b.t >= 1.0) { b.t = b.t - 1.0; }
        Ent3 e = _e3[s];
        e.y = b.base + sin(b.t * 360.0 * DEG2RAD3) * b.a;
        // Salınım KONUM yazıyor, hız değil — bu yüzden yerçekiminin onu geri
        // çekmemesi için varlık zemine oturmuş sayılıyor.
        e.vy = 0.0;
        e.grounded = 1;
        _e3[s] = e;
    }

    if (b.kind == BH_FLOAT) {
        // Kaldırma kuvveti yalnız SU VARSA ve cisim hedefin ALTINDAysa.
        // Yukarıdayken uygulamak cismi havaya fırlatırdı; yerçekimi zaten
        // aşağı çekiyor ve denge yüzeyde kuruluyor.
        if (_water_on3 == 1) {
            Ent3 e = _e3[s];
            float hedef = _water_y3 - b.b;
            if (e.y < hedef) {
                float derinlik = hedef - e.y;
                // Ayrı bir sönümleme YOK: su sürtünmesi (`_water_drag3`)
                // zaten sönümlüyor. Ölçüldü — 900 karede salınım genliği
                // sönümlemeyle 1e-08, sönümlemesiz 1e-05 birim; ikisi de
                // görünmez. İkinci bir sönümleme yükü taşımayan ama
                // taşıyormuş gibi duran bir satır olurdu.
                e.vy = e.vy + derinlik * b.a * dt;
                _e3[s] = e;
            }
        }
    }

    if (b.kind == BH_SHOOT) {
        b.t = b.t + dt;
        if (b.t >= b.a) {
            b.t = 0.0;
            int fire = 1;
            if (b.tag != 0) {
                int t = _bh_nearest3(b.id, b.tag, b.d);
                if (t < 0) { fire = 0; }
                else {
                    // Hedefe DÖN, sonra gövde yönüne ateş et. bullet3d'yi
                    // baypas edip mermiyi elle üretmek namlu ofsetini ve sahip
                    // kaydını ikinci bir yerde tekrarlamak olurdu — sürüklenir.
                    // Bunun yerine nişan modu geçici olarak AIM_BODY yapılıyor
                    // ve HEMEN geri konuyor: mod global, oyuncununki bozulmamalı.
                    int ts = _slot_of3(t);
                    Ent3 e = _e3[s];
                    Ent3 tg = _e3[ts];
                    e.yaw = atan2(tg.x - e.x, tg.z - e.z) * RAD2DEG3;
                    _e3[s] = e;
                    int prev = _aim_mode3;
                    _aim_mode3 = AIM_BODY;
                    bullet3d(b.id, b.b, b.c);
                    _aim_mode3 = prev;
                    fire = 0;      // atış yapıldı, aşağıdaki dal atlanmalı
                }
            }
            if (fire == 1) { bullet3d(b.id, b.b, b.c); }
        }
    }

    _bh3[i] = b;
}

// ---- Kare -------------------------------------------------------------------
// Sahibi ölen davranış SİLİNİYOR (son elemanla takas + kırp). Yalnız bayrak
// koymak, düşman öldüren bir oyunda diziyi sonsuza kadar büyütürdü.
func _s3_behaviors(dt) {
    int i = 0;
    while (i < length(_bh3)) {
        if (_slot_of3(_bh3[i].id) < 0) {
            int last = length(_bh3) - 1;
            if (i != last) { _bh3[i] = _bh3[last]; }
            pop(_bh3);
        } else {
            _bh_tick3(i, dt);
            i = i + 1;
        }
    }
}

// ===========================================================================
// KURALLAR — "ne olunca ne olur" da veri (Faz 13)
// ===========================================================================
// Davranışlar varlıkları hareket ettirdi ama oyunu bir OYUN yapan şey hâlâ
// koddaydı: altına değince toplansın, düşmana değince canın azalsın, hepsi
// bitince kazan. Editörün "Oynat"ı bunlar olmadan yalnız bir akvaryum.
//
// Kurallar mevcut çarpışma kancasının (`on_hit3d`) üstüne biniyor: her kural
// için TEK ve AYNI dağıtıcı kaydediliyor, dağıtıcı da çarpışan çiftin
// etiketlerinden hangi kuralın işlediğini buluyor. Böylece kurallar için
// ikinci bir çarpışma taraması YOK.
int RULE_HIT     = 0;   // iki etiket çarpıştığında
int RULE_CLEARED = 1;   // bir etiketten hiç kalmayınca

int ACT_COLLECT = 0;   // ötekini öldür + skor ekle
int ACT_DAMAGE  = 1;   // BANA hasar ver (oyuncu düşmana değdi)
int ACT_KILL    = 2;   // ötekini öldür (skorsuz)
int ACT_HURT    = 3;   // ötekine hasar ver (mermi düşmana değdi)
int ACT_WIN     = 4;
int ACT_LOSE    = 5;
// Sonraki bölüme geç. BUNSUZ çok bölümlü bir VERİ sahnesi ilerleyemiyordu:
// `next_level3d()`'i çağıran tek şey KOD'du (bir örnekteki `bolum_gec3d()`),
// yani editörün "+ BOLUM EKLE" düğmesiyle kurulan 2. ve sonraki bölümlere
// oynayarak ULAŞMANIN yolu yoktu. `examples/scenes/iki_bolum.scene.json`
// tam olarak bu durumdaydı: 1. bölüm "altınlar bitince KAZAN" diyordu ve
// oyun orada bitiyordu, 2. bölüm hiç görünmüyordu.
//
// Son bölümde "sonraki" istemek TAKILMIYOR: kayıtlı bölüm kalmayınca
// `_s3_apply_level` zaten kazandırıyor.
int ACT_NEXT    = 6;

struct Rule3 {
    int kind;   // RULE_*
    int a;      // birinci etiket (çarpışmada "ben")
    int b;      // ikinci etiket (çarpışmada "öteki"); CLEARED'da kullanılmaz
    int act;    // ACT_*
    float n;    // skor / hasar miktarı
    int seen;   // CLEARED: bu etiketten en az bir kez GÖRÜLDÜ mü
    // Kural işlerken çalacak sesin YOLU ("" = sessiz). Handle değil yol:
    // sahne dosyası taşınabilir kalmalı (model yollarıyla aynı gerekçe).
    str snd;
}
array _rl3 = [];

func _rl_act3(s): int {
    if (s == "damage")  { return ACT_DAMAGE; }
    if (s == "kill")    { return ACT_KILL; }
    if (s == "hurt")    { return ACT_HURT; }
    if (s == "win")     { return ACT_WIN; }
    if (s == "lose")    { return ACT_LOSE; }
    if (s == "next_level") { return ACT_NEXT; }
    return ACT_COLLECT;
}
func _rl_act_nm3(v): str {
    if (v == ACT_DAMAGE) { return "damage"; }
    if (v == ACT_KILL)   { return "kill"; }
    if (v == ACT_HURT)   { return "hurt"; }
    if (v == ACT_WIN)    { return "win"; }
    if (v == ACT_LOSE)   { return "lose"; }
    if (v == ACT_NEXT)   { return "next_level"; }
    return "collect";
}

// Oyunu KAZANILDI olarak bitir. Bölüm sistemi bunu zaten yapıyordu
// (kayıtlı bölüm kalmayınca) ama dışarıya açık bir yolu yoktu.
func win3d() { _won3 = 1; game_over3d(); }
func kazandi3d() { win3d(); }

// Çarpışma kuralı ekle. Aynı etiket çifti için birden çok kural olabilir
// (hem skor hem hasar) — hepsi işler.
// Kurallar çarpışma kancası TABLOSUNU kullanmıyor, kendi taramaları var.
// Sebep Oynat/Dur: `scene3d_reset` kanca tablosunu siliyor (silmeli — bayat
// kancalar yeni sahneye sızmamalı), ama elle yazılmış bir oyunun `setup()`
// içinde kaydettiği kancalar sahne biçiminde YER ALMIYOR. Kurallar da o
// tabloda otursaydı, "Dur"dan sonra ya oyunun kancaları kaybolur ya da
// kurallar ikinci kez kaydedilip iki kat işlerdi. Ayrı tarama bu bağı kesiyor.
func hit_rule3d(tag_a, tag_b, act, n) {
    Rule3 r = { kind: RULE_HIT, a: tag_a, b: tag_b, act: act, n: n * 1.0, seen: 0,
                snd: "" };
    push(_rl3, r);
}
func carpisma_kurali3d(etiket_a, etiket_b, eylem, n) { hit_rule3d(etiket_a, etiket_b, eylem, n); }

// "Bu etiketten hiç kalmayınca" kuralı. Sahne o etiketle BAŞLAMADIYSA
// tetiklenmez — yoksa altını olmayan bir sahne ilk karede kazanılırdı.
func cleared_rule3d(tag, act) {
    Rule3 r = { kind: RULE_CLEARED, a: tag, b: 0, act: act, n: 0.0, seen: 0,
                snd: "" };
    // "Görüldü" KAYIT ANINDA da bakılıyor, yalnız her karede değil: sahne
    // yüklenirken kurallar varlıklardan SONRA geliyor, ama ilk kare içinde son
    // eşya toplanırsa `_s3_rules` onu hiç saymadan 0 görürdü — ve "hiç
    // başlamamış" sayıp kazanmayı sonsuza kadar bastırırdı.
    int c = 0;
    int k = 0;
    while (k < length(_e3)) {
        if (_e3[k].alive == 1 && _e3[k].tag == tag) { c = c + 1; }
        k = k + 1;
    }
    if (c > 0) { r.seen = 1; }
    push(_rl3, r);
}
func bitince_kurali3d(etiket, eylem) { cleared_rule3d(etiket, eylem); }

func rule_count3d(): int { return length(_rl3); }
func kural_sayisi3d(): int { return rule_count3d(); }

// ---- Eylemin uygulanması ---------------------------------------------------
// Kuralın sesi. ÖNCE çalınıyor, sonra eylem uygulanıyor: `ACT_COLLECT`
// ötekini ÖLDÜRÜYOR ve ölen varlığın konumu okunamaz — sesi sonra çalmak
// "altını nerede topladın" bilgisini kaybettirirdi (konumsal ses o bilgi).
//
// Konum sırası: varsa ÖTEKİ (çarpılan şey), yoksa BEN, yoksa dinleyicinin
// kendi yeri. "Bitince" kuralında ortada çarpışan bir çift yok (ikisi de -1)
// ve o zaman ses yönsüz/tam sesle çalıyor — kazanma sesi bir yerden gelmez.
// Sesin ÇALACAĞI SLOT — çalmadan ayrı. `_snd_vol3`/`_snd_pan_val3` ile aynı
// gerekçe: ses aygıtı olmadan (başsız test) doğrulanabilsin. -1 = konumsuz.
func _rl_snd_slot3(me, other): int {
    int sl = _slot_of3(other);
    if (sl < 0) { sl = _slot_of3(me); }
    return sl;
}

// Sesin en son ÇALINDIĞI yer. Sıra sınanabilsin diye tutuluyor: `_rl_snd3`
// eylemden SONRA çağrılırsa toplanan varlık çoktan ölmüş olur ve burada
// oyuncunun konumu görünür — testin yakaladığı fark tam bu.
float _snd_last_x3 = 0.0;
float _snd_last_y3 = 0.0;
float _snd_last_z3 = 0.0;
int   _snd_last_slot3 = 0 - 1;

func _rl_snd3(path, me, other) {
    if (path == "") { return; }
    int sl = _rl_snd_slot3(me, other);
    _snd_last_slot3 = sl;
    if (sl >= 0) {
        Ent3 e = _e3[sl];
        _snd_last_x3 = e.x; _snd_last_y3 = e.y; _snd_last_z3 = e.z;
    }
    // Yükleme ÇALMADAN SONRA değil önce, ama konum kaydı yüklemeden de önce:
    // ses aygıtı yoksa handle -1 gelir ve çalma sessizce düşer — konumun
    // doğru hesaplandığı yine de sınanabilir olmalı.
    int h = asset_sound3d(path);
    if (h < 0) { return; }
    if (sl < 0) { play_sound(h); return; }
    sound3d(h, _snd_last_x3, _snd_last_y3, _snd_last_z3);
}

func _rl_apply3(act, n, me, other, snd) {
    // Ses EN BAŞTA: aşağıdaki dallar varlık öldürüyor, sonra çalmak konumu
    // kaybettirirdi. Sıra garantisi tek yerde dursun diye ses parametre
    // olarak geçiyor — çağrı yerlerine bırakılsaydı biri unutabilirdi.
    _rl_snd3(snd, me, other);
    if (act == ACT_COLLECT) {
        // Slot denetimi ŞART: aynı çift için ikinci bir "topla" kuralı varsa
        // öteki bu noktada çoktan ölmüş olur ve `_e3[-1]` dizi dışı okuma
        // olurdu. Aynı denetim skorun iki kez sayılmasını da engelliyor.
        int so = _slot_of3(other);
        if (so < 0) { return; }
        burst3d(other, 12, _e3[so].color, 6.0, 0.5);
        kill3d(other);
        score3d_add(toInt(n));
    }
    if (act == ACT_KILL)   { kill3d(other); }
    if (act == ACT_DAMAGE) { damage3d(me, toInt(n)); }
    if (act == ACT_HURT)   { damage3d(other, toInt(n)); }
    if (act == ACT_WIN)    { win3d(); }
    if (act == ACT_LOSE)   { game_over3d(); }
    if (act == ACT_NEXT)   { next_level3d(); }
}

// Kuralların çarpışma taraması. Kanca taramasının aynısı, ama etiket çiftini
// `_rl3`'ten alıyor. `_overlap_hit3` (temas payı) kullanılıyor — kurallar da
// katı-katı temasları görmeli.
func _s3_rule_hits(n) {
    int r = 0;
    while (r < length(_rl3)) {
        Rule3 ru = _rl3[r];
        if (ru.kind == RULE_HIT) {
            // Kanca taramasıyla AYNI ızgara yolu. Veri-kurallar da kayıtlı
            // her kural için ayrı bir n² tarama yapıyordu; veriyle kurulmuş
            // bir oyunun BÜTÜN oynanışı buradan geçtiği için ayrı bırakmak
            // kancaları hızlandırıp asıl yolu yavaş bırakmak olurdu.
            int a = 0;
            while (a < n) {
                Ent3 ea = _e3[a];
                if (ea.alive == 1 && ea.tag == ru.a) {
                    _grid_near3(a);
                    int gr = 0;
                    int gs = length(_gnear);
                    while (gr < gs) {
                        int b = _gnear[gr];
                        if (a != b && !_bp_far3(a, b)) {
                            Ent3 eb = _e3[b];
                            if (eb.alive == 1 && eb.tag == ru.b && _overlap_hit3(a, b)
                                && !_bullet_owner_pair3(a, b)) {
                                _hit_me = _mk_handle3(a);
                                _hit_other = _mk_handle3(b);
                                _rl_apply3(ru.act, ru.n, _hit_me, _hit_other, ru.snd);
                            }
                        }
                        gr = gr + 1;
                    }
                }
                a = a + 1;
            }
        }
        r = r + 1;
    }
}

// ---- "Bitince" kuralları ---------------------------------------------------
// Çarpışmalardan SONRA, kare sonunda: bu karede toplanan son eşya sayılmış
// olsun. Oyun zaten bittiyse hiç bakılmıyor.
func _s3_rules() {
    if (_game_over3 == 1) { return; }
    int i = 0;
    while (i < length(_rl3)) {
        Rule3 r = _rl3[i];
        if (r.kind == RULE_CLEARED) {
            int c = 0;
            int k = 0;
            while (k < length(_e3)) {
                if (_e3[k].alive == 1 && _e3[k].tag == r.a) { c = c + 1; }
                k = k + 1;
            }
            if (c > 0) { r.seen = 1; _rl3[i] = r; }
            if (c == 0 && r.seen == 1) {
                _rl_apply3(r.act, 0.0, 0 - 1, 0 - 1, r.snd);
                return;
            }
        }
        i = i + 1;
    }
}

// ===========================================================================
// EDİTÖR KİPİ — sahneyi gözle kurmak (Faz 13)
// ===========================================================================
// Sahne ve oynanış veri oldu; eksik olan onu GÖZLE düzenlemek. Bu katman
// motorun içinde duruyor çünkü seçim ışını, ızgara ve tutamaklar sahnenin
// gerçek geometrisiyle çalışmak zorunda — tarayıcı tarafında bir taklidini
// yazmak, motorun görünümünü aynalayan bir izleyici yazmakla aynı hata olurdu
// (zamanla sapar ve yalan söyler).
//
// Katman ikiye ayrık:
//   1. SAF matematik (ışın kurma, seçim, ızgara, düzlem kesişimi) — pencere
//      istemiyor, doğrudan sınanıyor.
//   2. KOMUTLAR (taşı, ölçekle, döndür, sil, çoğalt, zemine oturt) — hem
//      klavye/fare hem de (Faz 4) tarayıcıdan gelen JSON bunları çağıracak.
// Girdi işleme yalnız ince bir kabuk; asıl iş 1 ve 2'de.
int ED_SELECT = 0;
int ED_MOVE   = 1;
int ED_SCALE  = 2;
int ED_ROTATE = 3;

int   _ed_on3    = 0;
float _ed_cx3    = 0.0;    // editör kamerası (serbest uçuş — hedefi yok)
float _ed_cy3    = 14.0;
float _ed_cz3    = 26.0;
float _ed_yaw3   = 0.0;
float _ed_pitch3 = 0.0 - 22.0;
float _ed_fly3   = 18.0;   // birim/sn
int   _ed_sel3e  = 0 - 1;  // seçili HANDLE (-1 = yok)
int   _ed_mode3  = 0;
float _ed_grid3  = 0.5;    // ızgara adımı (0 = kapalı)
float _ed_reach3 = 400.0;  // seçim ışınının menzili

// Son kurulan ışın (saf fonksiyonun çıktısı — testler buradan okuyor).
float _ed_rx3 = 0.0;
float _ed_ry3 = 0.0;
float _ed_rz3 = 0.0 - 1.0;

// ---- 1) SAF MATEMATİK ------------------------------------------------------

// Izgaraya oturt. toInt sıfıra doğru kırptığı için negatifte ayrı yuvarlama
// gerekiyor — yoksa -1.6 birim, 0.5 adımda -1.5 yerine -1.5'e değil -1.5...
// (kısaca: yanlış tarafa) düşerdi.
func _ed_snap3(v, step): float {
    if (step <= 0.0) { return v * 1.0; }
    float k = v / step;
    int n = 0;
    if (k < 0.0) { n = toInt(k - 0.5); } else { n = toInt(k + 0.5); }
    return n * step;
}

// Ekran noktasından ışın YÖNÜ (birim). Kamera tabanı `_s3_camera` ile AYNI
// evrimi kullanıyor: yaw 0 → (0,0,-1). Sağ vektörü türetmek sadeleşiyor:
//   ileri = (sin y·cp, sin p, -cos y·cp)  →  sağ = (cos y, 0, sin y)
// (çapraz çarpımın uzunluğu tam cos(pitch), o yüzden bölme temiz.)
// raylib'in fov'u DİKEY olduğu için yatayda en-boy oranıyla çarpılıyor.
// Kameranın TABANI (ileri / sağ / yukarı), birim ve karşılıklı dik. Işın
// kurmak da dünya noktasını ekrana indirmek de aynı tabana dayanıyor; iki
// yerde ayrı yazılsalardı seçim çerçevesi tıklamayla farklı yeri gösterirdi
// ve bunu hiçbir şey söylemezdi. Çoklu dönüş yok, sonuç globallerde.
float _ed_bfx3 = 0.0; float _ed_bfy3 = 0.0; float _ed_bfz3 = 0.0;
float _ed_brx3 = 0.0; float _ed_bry3 = 0.0; float _ed_brz3 = 0.0;
float _ed_bux3 = 0.0; float _ed_buy3 = 0.0; float _ed_buz3 = 0.0;

func _ed_cam_basis3() {
    float yr = _ed_yaw3 * DEG2RAD3;
    float pr = _ed_pitch3 * DEG2RAD3;
    float cp = cos(pr);
    float sp = sin(pr);
    _ed_bfx3 = sin(yr) * cp;
    _ed_bfy3 = sp;
    _ed_bfz3 = 0.0 - cos(yr) * cp;
    _ed_brx3 = cos(yr);
    _ed_bry3 = 0.0;
    _ed_brz3 = sin(yr);
    _ed_bux3 = 0.0 - sin(yr) * sp;
    _ed_buy3 = cp;
    _ed_buz3 = cos(yr) * sp;
}

func _ed_ray3(px, py, w, h, fov) {
    _ed_cam_basis3();
    float fx = _ed_bfx3; float fy = _ed_bfy3; float fz = _ed_bfz3;
    float rx = _ed_brx3; float rz = _ed_brz3;
    float ux = _ed_bux3; float uy = _ed_buy3; float uz = _ed_buz3;

    float ndx = 2.0 * px / (w * 1.0) - 1.0;
    float ndy = 1.0 - 2.0 * py / (h * 1.0);
    float tf = tan(fov * 0.5 * DEG2RAD3);
    float asp = (w * 1.0) / (h * 1.0);

    float dx = fx + rx * (ndx * tf * asp) + ux * (ndy * tf);
    float dy = fy + 0.0        * (ndx * tf * asp) + uy * (ndy * tf);
    float dz = fz + rz * (ndx * tf * asp) + uz * (ndy * tf);
    float L = sqrt(dx * dx + dy * dy + dz * dz);
    if (L < 0.000001) { L = 1.0; }
    _ed_rx3 = dx / L;
    _ed_ry3 = dy / L;
    _ed_rz3 = dz / L;
}

// `_ed_ray3`'ün TERSİ: dünya noktası → GÖRÜNÜM içindeki piksel. Türetmesi
// ışının tanımından çıkıyor — d = f + r·X + u·Y ve taban dik/birim olduğu
// için v = nokta − göz'de X = (v·r)/(v·f), Y = (v·u)/(v·f), oradan da
// piksel. Yani ikisi TANIMDAN tutarlı, "iki formül aynı sonucu veriyor mu"
// diye ummuyoruz.
//
// Kameranın ARKASINDAKİ nokta yansıtılamaz (v·f <= 0) ve `_ed_w2s_ok3`
// sıfır kalıyor: yansıtsaydık arkadaki cisim ekranın karşı köşesinde
// belirir, kutu seçimi de görünmeyen şeyleri toplardı.
int   _ed_w2s_ok3 = 0;
float _ed_w2sx3   = 0.0;
float _ed_w2sy3   = 0.0;

func _ed_world_to_screen3(x, y, z, w, h, fov) {
    _ed_w2s_ok3 = 0;
    _ed_cam_basis3();
    float vx = x - _ed_cx3;
    float vy = y - _ed_cy3;
    float vz = z - _ed_cz3;
    float a = vx * _ed_bfx3 + vy * _ed_bfy3 + vz * _ed_bfz3;
    if (a <= 0.001) { return; }
    float b = vx * _ed_brx3 + vy * _ed_bry3 + vz * _ed_brz3;
    float c = vx * _ed_bux3 + vy * _ed_buy3 + vz * _ed_buz3;
    float tf = tan(fov * 0.5 * DEG2RAD3);
    float asp = (w * 1.0) / (h * 1.0);
    _ed_w2sx3 = ((b / a) / (tf * asp) + 1.0) * 0.5 * (w * 1.0);
    _ed_w2sy3 = (1.0 - (c / a) / tf) * 0.5 * (h * 1.0);
    _ed_w2s_ok3 = 1;
}

// Işın × yatay düzlem (y = pl). Işının ilerisinde değilse -1.
func _ray_planey3(oy, dy, pl): float {
    if (abs_f3(dy) < 0.000001) { return 0.0 - 1.0; }
    float t = (pl - oy) / dy;
    if (t < 0.0) { return 0.0 - 1.0; }
    return t;
}

// Işına çarpan EN YAKIN varlığın handle'ı; yoksa -1. `_seg_aabb3` bir PARÇA
// testi (t 0..1 aralığında) ve dönüşü biliyor — kamera-engel taramasının
// kullandığı testin aynısı. Ayrı bir ışın-kutu testi yazmak, aynı geometriyi
// iki yerde tutmak olurdu.
func _ed_pick3(ox, oy, oz, dx, dy, dz, reach): int {
    float sx = dx * reach;
    float sy = dy * reach;
    float sz = dz * reach;
    float best = 2.0;
    int bs = 0 - 1;
    int i = 0;
    while (i < length(_e3)) {
        if (_e3[i].alive == 1) {
            float t = _seg_aabb3(ox, oy, oz, sx, sy, sz, i);
            if (t >= 0.0 && t < best) { best = t; bs = i; }
        }
        i = i + 1;
    }
    if (bs < 0) { return 0 - 1; }
    return _mk_handle3(bs);
}

// ---- 2) KOMUTLAR -----------------------------------------------------------
// Hepsi HANDLE alıyor ve tek başına anlamlı: klavye de, (Faz 4) tarayıcıdan
// gelen JSON komutu da bunları çağıracak.

// ---- Çoklu seçim -----------------------------------------------------------
// `_ed_sel3e` BİRİNCİL seçim (inspector onu gösteriyor, tutamaklar onun
// üstünde). `_ed_msel3` ise kümenin tamamı ve birincili DE içeriyor — iki ayrı
// gerçek kaynağı tutmak "silinen neydi?" sorusunu belirsiz yapardı.
array _ed_msel3 = [];

func _ed_msel_has3(id): bool {
    int i = 0;
    while (i < length(_ed_msel3)) {
        if (_ed_msel3[i] == id) { return true; }
        i = i + 1;
    }
    return false;
}

func _ed_msel_add3(id) {
    if (_ed_msel_has3(id)) { return; }
    push(_ed_msel3, id);
}

func _ed_msel_remove3(id) {
    int i = 0;
    while (i < length(_ed_msel3)) {
        if (_ed_msel3[i] == id) {
            int last = length(_ed_msel3) - 1;
            if (i != last) { _ed_msel3[i] = _ed_msel3[last]; }
            pop(_ed_msel3);
        } else { i = i + 1; }
    }
}

// Ölü handle'ları at. Seçili bir varlık silinince küme onu tutmaya devam
// ederse sonraki toplu işlem geçersiz handle'larla çalışırdı.
func _ed_msel_prune3() {
    int i = 0;
    while (i < length(_ed_msel3)) {
        if (_slot_of3(_ed_msel3[i]) < 0) {
            int last = length(_ed_msel3) - 1;
            if (i != last) { _ed_msel3[i] = _ed_msel3[last]; }
            pop(_ed_msel3);
        } else { i = i + 1; }
    }
    if (_slot_of3(_ed_sel3e) < 0) {
        _ed_sel3e = 0 - 1;
        if (length(_ed_msel3) > 0) { _ed_sel3e = _ed_msel3[0]; }
    }
}

func ed_select_count3d(): int { return length(_ed_msel3); }

// Birincili verilen konuma taşı, kümenin GERİ KALANINI aynı delta kadar.
// Hepsini aynı mutlak konuma taşımak onları üst üste yığardı.
// Seçimi `delta` derece döndür. Her varlığın YAW'ı dönüyor VE konumu grup
// merkezi etrafında yörüngeye giriyor: yalnız yaw'ı döndürmek, seçili beş
// kutuyu yerinde çevirir ama dizilişlerini olduğu gibi bırakırdı — "grubu
// döndür" jestinin karşılığı bu değil.
//
// Hesap YAKALANAN hâlden yapılıyor, bir öncekinden değil: her karede
// üstüne eklemek yuvarlama hatasını biriktirir ve sürükleme uzadıkça cisim
// kayardı (aynı gerekçeyle eksen sürüklemesi de `_gz_p*3`'ü sabit tutuyor).
//
// Tek seçimde merkez varlığın kendisi, yani yörünge yarıçapı sıfır ve
// hareket saf dönüş. Ayrı bir dal gerekmiyor.
func _ed_rotate_group3(delta) {
    float c = cos(delta * DEG2RAD3);
    float sn = sin(delta * DEG2RAD3);
    // BAYAT HANDLE burada ayrıca denetlenmiyor ve gerekmiyor: handle'lar
    // kuşak etiketli, `ed_move3d`/`set3yaw`/`get3y` üçü de `_slot_of3< 0`
    // durumunda dönüyor. Buraya bir denetim daha koymak denendi ve ÖLÜ
    // çıktı (bozma denemesi hiçbir testi kırmadı) — iki yerde tutulan
    // koruma, hangisinin yük taşıdığını sınanamaz yapıyor.
    int i = 0;
    while (i < length(_gz_g0id3)) {
        int id = _gz_g0id3[i];
        float px = _gz_g0x3[i] - _gz_gcx3;
        float pz = _gz_g0z3[i] - _gz_gcz3;
        // YAW sözleşmesi (sin, cos): +delta, +Z'den +X'e doğru döndürüyor.
        float nx = _gz_gcx3 + px * c + pz * sn;
        float nz = _gz_gcz3 - px * sn + pz * c;
        ed_move3d(id, nx, get3y(id), nz);
        ed_rotate3d(id, _gz_g0yaw3[i] + delta);
        i = i + 1;
    }
}

// Halkaya tutunulduğu andaki hâli sakla. Grup merkezi seçili varlıkların
// ORTALAMASI: birincisini merkez almak, kullanıcının hangi kutuya tıkladığına
// göre bambaşka bir dönüş verirdi.
func _gz_grab_group3() {
    _gz_g0id3 = [];
    _gz_g0x3 = [];
    _gz_g0z3 = [];
    _gz_g0yaw3 = [];
    _gz_g0sx3 = [];
    _gz_g0sy3 = [];
    _gz_g0sz3 = [];
    float sx = 0.0;
    float sz = 0.0;
    int n = 0;
    int i = 0;
    while (i < length(_ed_msel3)) {
        int id = _ed_msel3[i];
        if (_slot_of3(id) >= 0) {
            push(_gz_g0id3, id);
            push(_gz_g0x3, get3x(id));
            push(_gz_g0z3, get3z(id));
            push(_gz_g0yaw3, get3yaw(id));
            push(_gz_g0sx3, get3sx(id));
            push(_gz_g0sy3, get3sy(id));
            push(_gz_g0sz3, get3sz(id));
            sx = sx + get3x(id);
            sz = sz + get3z(id);
            n = n + 1;
        }
        i = i + 1;
    }
    if (n == 0) { return; }
    _gz_gcx3 = sx / n;
    _gz_gcz3 = sz / n;
}

// Seçimi `d*` kadar BÜYÜT/KÜÇÜLT. Taşımanın kardeşi: orada da aynı MUTLAK
// öteleme herkese uygulanıyor. Oran değil mutlak, çünkü tutamağın verdiği
// şey dünya birimi cinsinden bir uzunluk ("2 birim genişlet"); oran
// isteyen bir jest başka bir tutamak isterdi.
//
// Konumlar KIPIRDAMIYOR. Ölçeklerken cisimleri de merkezden uzaklaştırmak
// (Unity'nin pivot ölçeklemesi) bir seviye editöründe istenmeyen şey:
// kullanıcı "şu beş kasayı genişlet" diyor, "beşini birbirinden ayır"
// demiyor. Döndürmede yörünge VAR çünkü orada dizilişin dönmesi jestin
// kendisi; ölçekte öyle bir karşılık yok.
func _ed_resize_group3(dx, dy, dz) {
    int i = 0;
    while (i < length(_gz_g0id3)) {
        ed_resize3d(_gz_g0id3[i], _gz_g0sx3[i] + dx, _gz_g0sy3[i] + dy,
                    _gz_g0sz3[i] + dz);
        i = i + 1;
    }
}

func _ed_move_group3(nx, ny, nz) {
    int s = _slot_of3(_ed_sel3e);
    if (s < 0) { return; }
    Ent3 pe = _e3[s];
    float dx = nx - pe.x;
    float dy = ny - pe.y;
    float dz = nz - pe.z;
    ed_move3d(_ed_sel3e, nx, ny, nz);
    if (length(_ed_msel3) < 2) { return; }
    int i = 0;
    while (i < length(_ed_msel3)) {
        int oid = _ed_msel3[i];
        if (oid != _ed_sel3e) {
            int os = _slot_of3(oid);
            if (os >= 0) {
                Ent3 oe = _e3[os];
                ed_move3d(oid, oe.x + dx, oe.y + dy, oe.z + dz);
            }
        }
        i = i + 1;
    }
}

// Toplu sil / çoğalt. Tekil komutlar duruyor; bunlar kümeyi geziyor.
func ed_delete_selected3d() {
    int i = 0;
    array kop = [];
    while (i < length(_ed_msel3)) { push(kop, _ed_msel3[i]); i = i + 1; }
    i = 0;
    while (i < length(kop)) { ed_delete3d(kop[i]); i = i + 1; }
    _ed_msel3 = [];
    _ed_sel3e = 0 - 1;
}

func ed_duplicate_selected3d() {
    array kop = [];
    int i = 0;
    while (i < length(_ed_msel3)) { push(kop, _ed_msel3[i]); i = i + 1; }
    array yeni = [];
    i = 0;
    while (i < length(kop)) {
        int n = ed_duplicate3d(kop[i]);
        if (n >= 0) { push(yeni, n); }
        i = i + 1;
    }
    // Kopyalar seçili kalsın: hemen taşımak isteyen kullanıcı için doğal olan
    // bu (ve Unity/Blender de böyle yapıyor).
    _ed_msel3 = yeni;
    _ed_sel3e = 0 - 1;
    if (length(yeni) > 0) { _ed_sel3e = yeni[0]; }
}

// ---- Pano: kopyala / yapıştır ----------------------------------------------
// Çoğaltma (CTRL+D) vardı ama TEK BÖLÜMÜN İÇİNDE: bir düşmanı 1. bölümde
// kurup 2. bölümde de kullanmanın yolu yoktu, elle yeniden kurmak gerekiyordu.
// Pano bu boşluğu kapatıyor ve bölüm sınırını geçiyor.
//
// Panoda handle DEĞİL, METİN duruyor. Handle bölüm değişince anlamsız
// (entity deposu tamamen siliniyor); serileştirilmiş varlık ise taşınabilir
// ve zaten TAM: davranışlar, doku, model yolu, can, katılık, ad — hepsi
// `_sc_ent_js3`'in yazdığı şey. Ayrı bir "kopyalanacak alanlar" listesi
// tutmak, her yeni alanda unutulacak bir borç olurdu (çoğaltmada tam olarak
// bu oldu: model alanları elle taşınıyor).
str _ed_clip3 = "";

// Panodaki varlık sayısı — durum çubuğu ve testler için.
func ed_clip_count3d(): int {
    if (_ed_clip3 == "") { return 0; }
    json c = fromJson(_ed_clip3);
    if (_sc_has3(c, "e") == false) { return 0; }
    return length(c["e"]);
}

// Yapıştırılan ADIN çakışmaması gerekiyor: aynı sahnede iki "kahraman"
// olursa `find3d` ilkini döndürür ve hangisinin kastedildiği belirsizleşir.
// AMA ad ATILMAMALI — başka bir bölüme yapıştırırken adın korunması tam da
// istenen şey (her bölümün kendi "kahraman"ı var, adlar bölümle birlikte
// siliniyor). Kural: ad SERBESTSE olduğu gibi kalır, DOLUYSA sayı eklenir.
// (Çoğaltma adı büsbütün atıyor; orada hedef aynı sahne olduğu için
// belirsizlik kaçınılmazdı, burada değil.)
func _ed_uniq_name3(nm): str {
    if (nm == "") { return ""; }
    if (find3d(nm) < 0) { return nm; }
    // Deneme sayısı KAYITLI AD SAYISINDAN türüyor: her deneme en fazla bir
    // kayıtlı adı tüketiyor, yani kayıt sayısı + 2 deneme her zaman yetiyor.
    // Sabit bir üst sınır (1000 gibi) sınanamayan bir dal bırakırdı.
    int n = length(_sc_nm) + 2;
    int k = 2;
    while (k <= n) {
        str aday = nm + " " + toString(k);
        if (find3d(aday) < 0) { return aday; }
        k = k + 1;
    }
    // Buraya güvercin yuvası ilkesince ULAŞILAMIYOR (n deneme, en fazla n-2
    // dolu ad). Dil her yolda bir dönüş istediği için duruyor.
    return nm;
}

// Seçili varlıkları panoya al. Seçim boşsa pano DEĞİŞMİYOR: boş bir seçimle
// CTRL+C'ye basmak, az önce kopyalanan şeyi silmemeli.
func ed_copy3d(): int {
    str o = "";
    int n = 0;
    int i = 0;
    while (i < length(_ed_msel3)) {
        int sl = _slot_of3(_ed_msel3[i]);
        if (sl >= 0) {
            if (n > 0) { o = o + ",\n"; }
            o = o + _sc_ent_js3(sl);
            n = n + 1;
        }
        i = i + 1;
    }
    if (n == 0) { return 0; }
    _ed_clip3 = "{\"e\": [\n" + o + "\n]}";
    return n;
}
func ed_kopyala3d(): int { return ed_copy3d(); }

// Panoyu yapıştır. Kopyalar KAYDIRILIYOR (çoğaltmayla aynı ofset): tam
// üstüne düşen bir kopya görünmez olurdu ve kullanıcı hiçbir şey olmadığını
// sanırdı. Yapıştırılanlar seçili kalıyor — hemen taşımak isteyen için doğal
// olan bu, ve çoğaltma da öyle yapıyor.
func ed_paste3d(): int {
    if (_ed_clip3 == "") { return 0; }
    json c = fromJson(_ed_clip3);
    if (_sc_has3(c, "e") == false) { return 0; }
    json es = c["e"];
    float off = 1.0;
    if (_ed_grid3 > 0.0) { off = _ed_grid3 * 2.0; }
    array yeni = [];
    int i = 0;
    while (i < length(es)) {
        // Ad ÖNCE benzersizleştiriliyor: `_sc_load_ent3` adı kendisi
        // kaydediyor, yani sonradan düzeltmek iki kayıt bırakırdı.
        int id = _sc_load_ent3(es[i]);
        if (id >= 0) {
            str nm = _sc_nm_of3(id);
            if (nm != "") { rename3d(id, _ed_uniq_name3_for3(id, nm)); }
            ed_nudge3d(id, off, 0.0, off);
            push(yeni, id);
        }
        i = i + 1;
    }
    _ed_msel3 = yeni;
    _ed_sel3e = 0 - 1;
    if (length(yeni) > 0) { _ed_sel3e = yeni[0]; }
    _ed_tab3 = 0;
    return length(yeni);
}
func ed_yapistir3d(): int { return ed_paste3d(); }

// Benzersizleştirmenin YAPIŞTIRMA hâli: varlık kendi adıyla ZATEN kayıtlı
// olduğu için `find3d(nm)` onun kendisini bulur. Kendini çakışma saymak,
// başka bir bölüme yapıştırılan tek bir varlığı bile "kahraman 2" yapardı.
func _ed_uniq_name3_for3(id, nm): str {
    int sahip = find3d(nm);
    if (sahip < 0 || sahip == id) { return nm; }
    return _ed_uniq_name3(nm);
}

// TÜMÜNÜ SEÇ. "Hepsini bir arada taşı / sil" için gereken tek adım; elle
// CTRL+tıklamak 40 varlıkta yapılabilir bir şey değil.
func ed_select_all3d(): int {
    _ed_msel3 = [];
    int i = 0;
    while (i < length(_e3)) {
        if (_e3[i].alive == 1) { push(_ed_msel3, _mk_handle3(i)); }
        i = i + 1;
    }
    _ed_sel3e = 0 - 1;
    if (length(_ed_msel3) > 0) { _ed_sel3e = _ed_msel3[0]; }
    _ed_tab3 = 0;
    return length(_ed_msel3);
}
func ed_tumunu_sec3d(): int { return ed_select_all3d(); }

// Tek seçim: kümeyi sıfırlar.
func ed_select3d(id) {
    _ed_sel3e = id;
    _ed_msel3 = [];
    if (id >= 0) { push(_ed_msel3, id); }
}

// CTRL+tık: kümeye ekle/çıkar. Birincil daima kümenin İÇİNDE kalıyor.
func ed_select_toggle3d(id) {
    if (id < 0) { return; }
    if (_ed_msel_has3(id)) {
        _ed_msel_remove3(id);
        if (_ed_sel3e == id) {
            _ed_sel3e = 0 - 1;
            if (length(_ed_msel3) > 0) { _ed_sel3e = _ed_msel3[0]; }
        }
        return;
    }
    _ed_msel_add3(id);
    _ed_sel3e = id;
}
func ed_secim_ekle3d(id) { ed_select_toggle3d(id); }
func ed_selected3d(): int { return _ed_sel3e; }
func ed_deselect3d() { _ed_sel3e = 0 - 1; _ed_msel3 = []; }

// ---- KUTU SEÇİMİ -----------------------------------------------------------
// Üç dönüşüm de artık seçimin TAMAMINI işliyor, yani darboğaz seçimi
// KURMAK: tek tek tıklamak ile "tümünü seç" arasında hiçbir şey yoktu.
//
// Kutu BOŞLUKTAN başlıyor. Bir cismin üstünde başlayan sürükleme onu taşımak
// demek ve o jest kutu seçiminden çok daha sık; boşluğa basmak ise ZATEN
// seçimi bırakıyordu, yani kutu o jestin devamı.
int _ed_mq3     = 0;      // 1 = kutu çiziliyor
int _ed_mq_x03  = 0;      // basma noktası (PENCERE koordinatı)
int _ed_mq_y03  = 0;
int _ed_mq_add3 = 0;      // CTRL: kümeyi koru, üstüne ekle

// Bu eşiğin ALTI tıklama sayılıyor. Eşik olmasaydı her tıklama sıfır alanlı
// bir kutu çalıştırırdı ve "boşluğa tıkla, seçim gitsin" davranışı sessizce
// kutu seçimine dönüşürdü.
func _ed_mq_min3(): int { return _us3(4); }
func _ed_mq_big3(x1, y1): bool {
    int dw = x1 - _ed_mq_x03; if (dw < 0) { dw = 0 - dw; }
    int dh = y1 - _ed_mq_y03; if (dh < 0) { dh = 0 - dh; }
    return dw >= _ed_mq_min3() || dh >= _ed_mq_min3();
}

// Kutunun ekran dikdörtgeni, GÖRÜNÜME kelepçeli. Kelepçesiz bir kutu
// panellerin üstüne taşardı ve sürüklemeyi panele götürmek orada bir seçim
// üretirdi. Sonuç globallerde (çoklu dönüş yok).
int _ed_mq_rx3 = 0; int _ed_mq_ry3 = 0;
int _ed_mq_rw3 = 0; int _ed_mq_rh3 = 0;
//
// `..._at3` biçimi bilerek: görünüm dikdörtgeni ARGÜMAN, çünkü canlı hâli
// `screen_width()`'ten geliyor ve o pencere olmadan sıfır — yerleşimin geri
// kalanında da aynı ayrım var (`_ed_view_w_at3`). Böylece kural penceresiz
// ÖLÇÜLEBİLİYOR; canlı sarmalayıcı yalnız dikdörtgeni okuyor.
func _ed_mq_rect_at3(x1, y1, mqvx, mqvy, mqvw, mqvh) {
    int mqax = _ed_mq_x03; int mqbx = x1;
    if (mqbx < mqax) { int mqsw = mqax; mqax = mqbx; mqbx = mqsw; }
    int mqay = _ed_mq_y03; int mqby = y1;
    if (mqby < mqay) { int mqsh = mqay; mqay = mqby; mqby = mqsh; }
    if (mqax < mqvx) { mqax = mqvx; }
    if (mqay < mqvy) { mqay = mqvy; }
    if (mqbx > mqvx + mqvw) { mqbx = mqvx + mqvw; }
    if (mqby > mqvy + mqvh) { mqby = mqvy + mqvh; }
    _ed_mq_rx3 = mqax; _ed_mq_ry3 = mqay;
    _ed_mq_rw3 = mqbx - mqax; _ed_mq_rh3 = mqby - mqay;
    if (_ed_mq_rw3 < 0) { _ed_mq_rw3 = 0; }
    if (_ed_mq_rh3 < 0) { _ed_mq_rh3 = 0; }
}
func _ed_mq_rect3(x1, y1) {
    _ed_mq_rect_at3(x1, y1, _ed_view_x3(), _ed_view_y3(),
                    _ed_view_w3(), _ed_view_h3());
}

// Kutunun İÇİNDE kalan varlıklar. MERKEZ testi: kutuya DEĞEN her şeyi almak
// (sınır kutusu kesişimi) kocaman bir zemini ya da duvarı her seçime
// katardı — "merkezi kutuda olan" hem öngörülebilir hem anlatılabilir.
// Kameranın arkasındakiler zaten yansıtılamıyor (bkz. `_ed_w2s_ok3`).
func _ed_mq_inside_at3(mqvx, mqvy, mqvw, mqvh): array {
    array o = [];
    int mqi = 0;
    while (mqi < length(_e3)) {
        if (_e3[mqi].alive == 1) {
            Ent3 mqe = _e3[mqi];
            _ed_world_to_screen3(mqe.x, mqe.y, mqe.z, mqvw, mqvh, _cam_fov);
            if (_ed_w2s_ok3 == 1) {
                float mqsx = _ed_w2sx3 + mqvx;
                float mqsy = _ed_w2sy3 + mqvy;
                if (mqsx >= _ed_mq_rx3 && mqsx <= _ed_mq_rx3 + _ed_mq_rw3 &&
                    mqsy >= _ed_mq_ry3 && mqsy <= _ed_mq_ry3 + _ed_mq_rh3) {
                    push(o, _mk_handle3(mqi));
                }
            }
        }
        mqi = mqi + 1;
    }
    return o;
}
func _ed_mq_inside3(): array {
    return _ed_mq_inside_at3(_ed_view_x3(), _ed_view_y3(),
                             _ed_view_w3(), _ed_view_h3());
}

// Kutuyu BİTİR. CTRL basılıyken küme korunup üstüne ekleniyor — CTRL+tıkın
// kuralının aynısı; iki jest aynı tuşla farklı davranmamalı.
func _ed_mq_apply_at3(x1, y1, mqvx, mqvy, mqvw, mqvh): int {
    _ed_mq3 = 0;
    if (_ed_mq_big3(x1, y1) == false) { return 0; }
    _ed_mq_rect_at3(x1, y1, mqvx, mqvy, mqvw, mqvh);
    array mqy = _ed_mq_inside_at3(mqvx, mqvy, mqvw, mqvh);
    if (_ed_mq_add3 == 0) { _ed_msel3 = []; }
    int mqk = 0;
    while (mqk < length(mqy)) {
        if (_ed_msel_has3(mqy[mqk]) == false) { push(_ed_msel3, mqy[mqk]); }
        mqk = mqk + 1;
    }
    _ed_sel3e = 0 - 1;
    if (length(_ed_msel3) > 0) { _ed_sel3e = _ed_msel3[0]; }
    if (length(mqy) > 0) { _ed_tab3 = 0; }
    return length(mqy);
}
func _ed_mq_apply3(x1, y1): int {
    return _ed_mq_apply_at3(x1, y1, _ed_view_x3(), _ed_view_y3(),
                            _ed_view_w3(), _ed_view_h3());
}

// Kutunun kendisi. Dolgu ÇOK şeffaf: altındaki sahne görünmeye devam etmeli,
// yoksa tam da seçtiğin şeyi göremezsin.
func _ed_mq_draw3() {
    if (_ed_mq3 == 0) { return; }
    // Basış kaybolduysa (araya bağlam menüsü girdi, girdi yolu atlandı) kutu
    // ekranda ASILI kalmasın: fare kalkmışsa jest bitmiştir.
    if (mouse_down(0) == false) { _ed_mq3 = 0; return; }
    if (_ed_mq_big3(mouse_x(), mouse_y()) == false) { return; }
    _ed_mq_rect3(mouse_x(), mouse_y());
    if (_ed_mq_rw3 <= 0 || _ed_mq_rh3 <= 0) { return; }
    rect(_ed_mq_rx3 * 1.0, _ed_mq_ry3 * 1.0,
         _ed_mq_rw3 * 1.0, _ed_mq_rh3 * 1.0, rgba(90, 150, 230, 46));
    rect_lines(_ed_mq_rx3, _ed_mq_ry3, _ed_mq_rw3, _ed_mq_rh3, _G_ACC3());
}
func ed_mode3d(m) { _ed_mode3 = m; }
func ed_mode_now3d(): int { return _ed_mode3; }
func ed_grid3d(step) { _ed_grid3 = step * 1.0; }
func ed_grid_now3d(): float { return _ed_grid3; }

// Mutlak taşıma — ızgaraya oturtarak.
func ed_move3d(id, x, y, z) {
    if (_slot_of3(id) < 0) { return; }
    set3pos(id, _ed_snap3(x, _ed_grid3), _ed_snap3(y, _ed_grid3), _ed_snap3(z, _ed_grid3));
}
// Göreli itme — ızgara adımı kadar ok tuşlarıyla ittirmek için.
func ed_nudge3d(id, dx, dy, dz) {
    int s = _slot_of3(id);
    if (s < 0) { return; }
    Ent3 e = _e3[s];
    ed_move3d(id, e.x + dx, e.y + dy, e.z + dz);
}

// Ölçek: TAM boyut, en az bir ızgara adımı (0 boyutlu varlık seçilemez hâle
// gelirdi — ışın onu hiç kesmez).
func ed_resize3d(id, sx, sy, sz) {
    int s = _slot_of3(id);
    if (s < 0) { return; }
    float lo = 0.1;
    if (_ed_grid3 > 0.0) { lo = _ed_grid3; }
    Ent3 e = _e3[s];
    e.sx = sx; if (e.sx < lo) { e.sx = lo; }
    e.sy = sy; if (e.sy < lo) { e.sy = lo; }
    e.sz = sz; if (e.sz < lo) { e.sz = lo; }
    _e3[s] = e;
    _bp_sync3(s);
}
func ed_rotate3d(id, yaw) { set3yaw(id, yaw); }

// ---- BÖLGE DÖNÜŞÜMÜ --------------------------------------------------------
// Bölgeler artık tutamakla da taşınıyor/boyutlanıyor, yani konumu yazan iki
// yol var: sayı alanı ve ok. İkisi de BURADAN geçiyor — ayrı yazılmış bir
// kelepçe kayınca tutamakla küçültülen bölge sessizce ters yüz olurdu ve
// ters yüz bir kutu HİÇ tetiklenmez (hata yok, olay da yok).
// Kurallar varlığınkiyle aynı: konum ızgaraya oturuyor, ölçü bir ızgara
// adımının (ızgara kapalıyken 0.1) altına inemiyor.
//
// TR ikizi YOK ve olmamalı: `ed_move3d`/`ed_resize3d`'in de yok, bunlar
// editörün iç komutları. Üstelik oyun tarafında ZATEN bir `bolge_tasi3d`
// var (`trigger_move3d`) ve o HAM yazıyor — aynı ada iki sözleşme koymak,
// derleyicinin sessizce birini öldürdüğü tuzağın davetiyesi.
func _ed_zone_lo3(): float {
    if (_ed_grid3 > 0.0) { return _ed_grid3; }
    return 0.1;
}
func _ed_zone_ok3(i): bool { return i >= 0 && i < length(_trg_x); }

func ed_zone_move3d(i, x, y, z) {
    if (_ed_zone_ok3(i) == false) { return; }
    _trg_x[i] = _ed_snap3(x, _ed_grid3);
    _trg_y[i] = _ed_snap3(y, _ed_grid3);
    _trg_z[i] = _ed_snap3(z, _ed_grid3);
}

func ed_zone_resize3d(i, sx, sy, sz) {
    if (_ed_zone_ok3(i) == false) { return; }
    float lo = _ed_zone_lo3();
    float ax = sx; if (ax < lo) { ax = lo; }
    float ay = sy; if (ay < lo) { ay = lo; }
    float az = sz; if (az < lo) { az = lo; }
    _trg_sx[i] = ax; _trg_sy[i] = ay; _trg_sz[i] = az;
}

func ed_zone_radius3d(i, r) {
    if (_ed_zone_ok3(i) == false) { return; }
    float lo = _ed_zone_lo3();
    float ar = r; if (ar < lo) { ar = lo; }
    _trg_r[i] = ar;
}

// KÜRE bölgenin tek ölçüsü var: hangi oka basılırsa basılsın yarıçap
// değişiyor (Unity'nin SphereCollider tutamağı da böyle). Eksene göre
// sx/sy/sz yazmak, kürenin ne çizimini ne içerik testini etkilemeyen üç
// sayıyı oynatırdı — tutamak çalışıyor görünür, bölge kıpırdamazdı.
func _ed_zone_resize_axis3(i, ax, ay, az, delta) {
    if (_ed_zone_ok3(i) == false) { return; }
    if (_trg_shape[i] == 1) {
        ed_zone_radius3d(i, _gz_z0r3 + delta);
        return;
    }
    ed_zone_resize3d(i, _gz_z0sx3 + ax * delta, _gz_z0sy3 + ay * delta,
                     _gz_z0sz3 + az * delta);
}

func ed_delete3d(id) {
    if (_ed_sel3e == id) { _ed_sel3e = 0 - 1; }
    // KAMERA HEDEFİ de düşmeli. Düşmüyordu: oyuncuyu silmek kamerayı var
    // olmayan bir handle'a bağlı bırakıyor, yerine yeni bir oyuncu eklemek
    // de onu onarmıyordu — kamera kalıcı olarak ölü bir cismi izliyordu ve
    // ne editörde düzeltilebiliyor ne denetimde söyleniyordu.
    //
    // Yalnız EDİTÖR silmesinde: `kill3d` oyun sırasında da çağrılıyor ve
    // oyuncunun ölmesi kamerayı sıfırlamamalı (oyun-bitti ekranı hâlâ
    // sahneyi göstermeli).
    if (_cam_target == id) { _cam_target = 0 - 1; }
    clear_behaviors3d(id);
    kill3d(id);
}

// Çoğalt: davranışlarıyla birlikte. Kopyayı bir ızgara adımı yana koyuyor ki
// üst üste binip "hiçbir şey olmadı" gibi görünmesin.
func ed_duplicate3d(id): int {
    int s = _slot_of3(id);
    if (s < 0) { return 0 - 1; }
    Ent3 e = _e3[s];
    float off = 1.0;
    if (_ed_grid3 > 0.0) { off = _ed_grid3 * 2.0; }
    int n = spawn3(e.x + off, e.y, e.z + off, e.sx, e.sy, e.sz, e.color, e.shape, e.tag);
    // Model ve animasyon alanları `spawn3` tarafından -1'e kuruluyor; taşınmazsa
    // modelli bir varlığın kopyası "şekli MODEL ama modeli yok" oluyordu.
    int ns = _slot_of3(n);
    Ent3 ne = _e3[ns];
    ne.model = e.model; ne.msrc = e.msrc;
    ne.tsrc = e.tsrc; ne.ttile = e.ttile;
    ne.anim_idle = e.anim_idle; ne.anim_run = e.anim_run;
    ne.anim_fps = e.anim_fps; ne.avoid = e.avoid;
    _e3[ns] = ne;
    set3yaw(n, e.yaw);
    solid3d(n, e.solid);
    if (e.hpmax > 0) { health3d(n, e.hpmax); }
    // AD da taşınıyor, benzersizleştirilerek. Eskiden büsbütün atılıyordu:
    // adlı bir varlığı çoğaltmak ADSIZ bir kopya veriyordu. Ad taşınabilir
    // biçimin tek referans yolu — kamera hedefi ve kurallar varlıklara adla
    // atıfta bulunuyor — yani adsız kopya, kaydedilince o bağların hiçbirine
    // giremeyen bir şey oluyordu. Benzersizleştirme ŞART: aynı sahnede iki
    // "kahraman" olsa `find3d` ilkini döndürür.
    str dnm = _sc_nm_of3(id);
    if (dnm != "") { rename3d(n, _ed_uniq_name3(dnm)); }
    // Davranışları da kopyala — çoğaltılan düşmanın kovalamaması sürpriz olurdu.
    int cnt = length(_bh3);
    int k = 0;
    while (k < cnt) {
        Bh3 b = _bh3[k];
        if (b.id == id) { _bh_add3(n, b.kind, b.tag, b.hnd, b.a, b.b, b.c, b.d, b.e); }
        k = k + 1;
    }
    return n;
}

func ed_add3d(tag, shape, x, y, z): int {
    int id = spawn3(_ed_snap3(x, _ed_grid3), _ed_snap3(y, _ed_grid3),
                    _ed_snap3(z, _ed_grid3), 1.0, 1.0, 1.0,
                    rgb(180, 184, 192), shape, tag);
    _ed_sel3e = id;
    return id;
}

// Zemine/araziye oturt: havada asılı ya da yere gömülü varlıkları elle
// hizalamak sahne kurmanın en can sıkıcı kısmıydı.
func ed_drop3d(id) {
    int s = _slot_of3(id);
    if (s < 0) { return; }
    Ent3 e = _e3[s];
    set3pos(id, e.x, _floor_at3(e.x, e.z) + e.sy * 0.5, e.z);
}

// ---- 3) GİRDİ KABUĞU (masaüstü) --------------------------------------------
// İnce bir katman: hepsi yukarıdaki komutlara iniyor. Asıl arayüz tarayıcıda
// olacak (Faz 5) ve o da AYNI komutları çağıracak — bu yüzden buraya oynanış
// mantığı sızmamalı.
int K_TAB = 258; int K_DEL = 261; int K_G = 71; int K_F5 = 294;
int K_1 = 49; int K_2 = 50; int K_3 = 51; int K_4 = 52;
int K_LSHIFT = 340; int K_LCTRL = 341;

// Kaydetme hedefi. Editörün asıl kapanışı bu: düzenle → F5 → aynı JSON
// dosyası güncellenir, oyunu yeniden derlemeye gerek yok.
str   _ed_path3 = "";
float _ed_msg_t3 = 0.0;
str   _ed_msg3   = "";

// ---- YAZARLIK DURUMU / Oynat-Dur ------------------------------------------
// Unity/Unreal modeli: editör sahnenin SAHİBİ. "Oynat" bir KOPYAYI çalıştırır,
// "Dur" kopyayı atar. Oynarken olanlar hiçbir zaman kaydedilmez.
//
// Bu ayrım olmadan editör sinsi bir veri kaybı üretiyor: oyunu bir süre oyna,
// TAB'a bas, F5 ile kaydet → dosyaya düşmanların KOVALADIĞI, süslerin DÖNDÜĞÜ
// hâl yazılır. Yazarın kurduğu sahne sessizce gider. (Bu gerçekten oldu:
// gönderilen sahne dosyası bir kez simüle edilmiş durumla üzerine yazıldı.)
//
// Kancalar geri yüklemede KORUNUYOR: elle yazılmış bir oyunun `setup()` içinde
// kaydettiği çarpışma/ölüm kancaları ve bölüm tablosu sahne biçiminde yer
// almıyor — `scene3d_reset` onları silseydi Dur'dan sonra oyun sessizce
// tepkisiz kalırdı.
str _sc_authored3 = "";

// YAZARLIK durumunu sakla. Çok bölümlü sahnede yaşayan bölüm önce diziye
// geri yazılıyor, yoksa "Oynat"a basmak o bölümde yapılanı yutardı.
func _ed_capture3() {
    _ed_level_store3();
    _sc_authored3 = scene_json_levels3d();
}

// `yapisal` = 1 → anlık görüntü BÖLÜM YAPISININ da sahibi (tam belge).
// 0 → yalnız yaşayan bölümün içeriği; bölüm dizisine dokunulmamalı.
//
// Bu, JSON'a bakıp tahmin etmekten (belgede "levels" var mı?) daha doğru:
// tek bölümlü bir tam belgede "levels" anahtarı YOK ama o belge yine de
// yapının sahibi — "+ BOLUM EKLE"yi geri almak tam olarak o duruma dönmek
// demek ve tahmin eden sürüm orada bölümleri koruyup işi yarım bırakıyordu.
func _ed_apply_json3(js, yapisal) {
    if (js == "") { return; }
    // Geçmiş KORUNUR: geri-al/yinele sahnede gezinmektir, yeni sahne açmak
    // değil. Geri kalan her şey (kancalar, bölgeler, kayıt, nişan modu) zaten
    // korunuyor — `scene_load3d` artık tam teardown yapmıyor, yalnız sahne
    // biçiminin sahip olduğunu temizliyor.
    array un = _ed_undo3; array rd = _ed_redo3;
    int sc = _score3;
    // Bölge KANCALARI biçimde taşınmıyor (onlar kod), ama geometrileri
    // taşınıyor ve aynı sırada yeniden kuruluyor — yani kancaları indeksle
    // geri koymak doğru. Korumazsak TAB'a basmak "buraya girince şu olsun"
    // bağlarını sessizce koparırdı.
    array fi = _trg_fin;  array hi = _trg_hasin;
    array fo = _trg_fout; array ho = _trg_hasout;
    array fs = _trg_fstay; array hs = _trg_hasstay;
    // BÖLÜMLER de korunuyor ve bu liste bir REGRESYONLA öğrenildi. `scene_load3d`
    // artık bölümleri temizliyor (yoksa "Yeni" sahne, terk edilen sahnenin
    // bölümlerini yeni dosyaya yazıyordu) — ama geri alma da o yoldan geçiyor.
    // Sonuç ölçüldü: iki bölümlü bir sahnede TEK bir CTRL+Z bölüm sayısını
    // 2'den 0'a düşürüyordu ve kaydetmek öteki bölümü dosyadan siliyordu.
    //
    // Ayrım şu: YENİ sahne açmak bölümleri götürür, geri almak GÖTÜRMEZ —
    // aynı ayrım geçmiş, kancalar ve skor için de geçerli, onlar da burada
    // korunuyor. Anlık görüntü zaten tek bölümün içeriği (`scene_json3d`),
    // yani bölüm dizisine hiç dokunmaması gerekiyor.
    array lj = _lvl_js3; array ln = _lvlN; array lf = _lvlF;
    int el = _ed_lvl3; int cl = _cur_lvl3;
    // KORUMA KOŞULLU: çağıran ne yaptığını SÖYLÜYOR (`yapisal`).
    //
    // İki çağıran var ve ikisi farklı şey istiyor:
    //   • GERİ ALMA — anlık görüntü tek bölümün içeriği (`scene_json3d`),
    //     bölüm dizisine hiç dokunmamalı.
    //   • DUR — TAM belgeyi (`scene_json_levels3d`) geri yüklüyor; bölümler
    //     belgenin kendisinden geliyor ve 1. bölümde duruluyor.
    // Koşulsuz korumak ölçüldü ve İŞ KAYBETTİRİYORDU: 2. bölümü düzenleyip
    // Oynat-Dur yapınca editör "BOLUM 2" diyor ama ekranda 1. bölümün içeriği
    // duruyordu; sonraki bölüm değişiminde `_ed_level_store3` o içeriği
    // 2. bölümün ÜSTÜNE yazıp yapılan düzenlemeyi siliyordu. Hiç korumamak
    // da olmuyor: o zaman tek bir CTRL+Z bütün bölümleri götürüyor.
    scene_load3d(js);
    if (yapisal == 0) {
        _lvl_js3 = lj; _lvlN = ln; _lvlF = lf;
        _ed_lvl3 = el; _cur_lvl3 = cl;
    }
    int n = length(_trg_x);
    int i = 0;
    while (i < n && i < length(fi)) {
        _trg_fin[i] = fi[i];   _trg_hasin[i] = hi[i];
        _trg_fout[i] = fo[i];  _trg_hasout[i] = ho[i];
        _trg_fstay[i] = fs[i]; _trg_hasstay[i] = hs[i];
        i = i + 1;
    }
    _ed_undo3 = un; _ed_redo3 = rd;
    _score3 = sc;
}

// ---- Geri al / yinele ------------------------------------------------------
// Anlık görüntü tabanlı: her düzenlemeden ÖNCE sahnenin JSON'u yığına atılıyor.
// Komut-tabanlı bir geri alma her komut için ayrı bir "tersi" yazmayı
// gerektirirdi (ve her yeni komut o borcu büyütürdü); serileştirme zaten
// tam olduğu için anlık görüntü hem daha kısa hem daha güvenilir.
array _ed_undo3 = [];
array _ed_redo3 = [];
// Anlık görüntü BİR BÖLÜMÜN içeriği. Hangi bölümün olduğunu da saklamak
// gerekiyor: 1. bölümde işaret bırakıp 2. bölüme geçmek ve CTRL+Z'ye basmak,
// 1. bölümün içeriğini 2. bölümün ÜSTÜNE yazardı — iki bölüm birden bozulur,
// ve geri almanın kendisi veri kaybı olurdu.
array _ed_undo_lvl3 = [];
array _ed_redo_lvl3 = [];
int   _ED_UNDO_MAX3 = 40;

func _ed_trim3(a): array {
    array o = [];
    int i = 1;
    while (i < length(a)) { push(o, a[i]); i = i + 1; }
    return o;
}

func ed_mark3d() {
    _ed_dirty3 = 1;
    _ed_dirty_seq3 = _ed_dirty_seq3 + 1;
    push(_ed_undo3, scene_json3d());
    push(_ed_undo_lvl3, _ed_lvl3);
    if (length(_ed_undo3) > _ED_UNDO_MAX3) {
        _ed_undo3 = _ed_trim3(_ed_undo3);
        _ed_undo_lvl3 = _ed_trim3(_ed_undo_lvl3);
    }
    _ed_redo3 = [];   // yeni bir dal açıldı
    _ed_redo_lvl3 = [];
}

// Anlık görüntüyü AİT OLDUĞU bölüme uygula. Başka bir bölümdeysek önce oraya
// dönülüyor; dönmeden uygulamak iki bölümü birden bozardı.
//
// ETİKET İKİ ŞEY SÖYLÜYOR: İŞARETİ anlık görüntünün BİÇİMİNİ (negatif = tam
// belge), BÜYÜKLÜĞÜ de o görüntünün ait olduğu bölümü. Yapısal görüntüyü de
// bir bölüme bağlamak gerekiyor: "bölüm ekle"yi yinelemek kullanıcıyı
// yarattığı bölüme geri koymalı, bir öncekine değil.
func _ed_snap_tag3(lvl): int { return 0 - 1 - lvl; }
func _ed_snap_lvl3(tag): int { return 0 - 1 - tag; }
func _ed_is_yapisal3(tag): bool { return tag < 0; }

func _ed_apply_at_level3(js, lvl) {
    // Negatif = YAPISAL anlık görüntü (tam belge). Bölüm eklemek/silmek bölüm
    // dizisinin KENDİSİNİ değiştiriyor; tek bölümün içeriğini geri koymak
    // o değişikliği geri almaz. Bu yüzden yapısal işlemler tam belgeyi
    // saklıyor ve geri alma onu bütünüyle uyguluyor.
    if (_ed_is_yapisal3(lvl)) {
        _ed_apply_json3(js, 1);
        int hedef = _ed_snap_lvl3(lvl);
        if (hedef > 0 && hedef < length(_lvl_js3)) { ed_level_go3d(hedef + 1); }
        return;
    }
    if (lvl != _ed_lvl3 && lvl < length(_lvl_js3)) {
        ed_level_go3d(lvl + 1);
    }
    _ed_apply_json3(js, 0);
}

// Bulunulan durumu, uygulanacak görüntüyle AYNI BİÇİMDE yakala. Geri alma ile
// yineleme durum TAKAS eder; biri tam belgeyse öteki de tam belge olmalı.
// Karşı durumu tek bölüm olarak saklamak ölçüldü ve VERİ KAYBIYDI:
// "bölüm ekle → CTRL+Z → CTRL+Y" yineleme yığınına o an açık olan BOŞ bölümün
// içeriğini koyuyordu; yineleme o boşluğu geri gelen sahnenin ÜSTÜNE yazıyor,
// bölüm de geri gelmiyordu — yani yineleme sahneyi siliyordu.
func _ed_snap_take3(yapisal): str {
    if (yapisal == 0) { return scene_json3d(); }
    // Yaşayan bölüm önce diziye yazılıyor; yoksa tam belge, o an ekranda olan
    // düzenlemeleri kaçırır.
    _ed_level_store3();
    return scene_json_levels3d();
}
func _ed_snap_take_tag3(yapisal): int {
    if (yapisal == 0) { return _ed_lvl3; }
    return _ed_snap_tag3(_ed_lvl3);
}
// Yığının tepesindeki etiket: hangi biçimde yakalayacağımızı O söylüyor.
func _ed_top_tag3(etiketler): int {
    if (length(etiketler) == 0) { return 0; }
    return etiketler[length(etiketler) - 1];
}
func _ed_karsi_bicim3(etiketler): int {
    if (_ed_is_yapisal3(_ed_top_tag3(etiketler))) { return 1; }
    return 0;
}

// YAPISAL işaret: bölüm eklemek/silmek için. Tam belgeyi saklıyor ve -1 ile
// etiketliyor.
func ed_mark_all3d() {
    _ed_dirty3 = 1;
    _ed_dirty_seq3 = _ed_dirty_seq3 + 1;
    push(_ed_undo3, _ed_snap_take3(1));
    push(_ed_undo_lvl3, _ed_snap_take_tag3(1));
    if (length(_ed_undo3) > _ED_UNDO_MAX3) {
        _ed_undo3 = _ed_trim3(_ed_undo3);
        _ed_undo_lvl3 = _ed_trim3(_ed_undo_lvl3);
    }
    _ed_redo3 = [];
    _ed_redo_lvl3 = [];
}

func ed_undo3d(): bool {
    if (length(_ed_undo3) == 0) { return false; }
    int yap = _ed_karsi_bicim3(_ed_undo_lvl3);
    push(_ed_redo3, _ed_snap_take3(yap));
    push(_ed_redo_lvl3, _ed_snap_take_tag3(yap));
    str js = pop(_ed_undo3);
    int lv = pop(_ed_undo_lvl3);
    _ed_apply_at_level3(js, lv);
    return true;
}
func ed_redo3d(): bool {
    if (length(_ed_redo3) == 0) { return false; }
    int yap = _ed_karsi_bicim3(_ed_redo_lvl3);
    push(_ed_undo3, _ed_snap_take3(yap));
    push(_ed_undo_lvl3, _ed_snap_take_tag3(yap));
    str js = pop(_ed_redo3);
    int lv = pop(_ed_redo_lvl3);
    _ed_apply_at_level3(js, lv);
    return true;
}
func ed_undo_count3d(): int { return length(_ed_undo3); }
func ed_redo_count3d(): int { return length(_ed_redo3); }

int _ed_hover3 = 0 - 1;   // imlecin altındaki varlık (vurgulama)

// ---- Sağ tık bağlam menüsü -------------------------------------------------
// Sağ tuş ZATEN kamera bakışı. Unity/Unreal/Godot'ta ayrım şudur: sağ tuşla
// SÜRÜKLEMEK bakış, sürüklemeden BIRAKMAK bağlam menüsü. Eşik olmadan
// menü her bakış hareketinin sonunda açılırdı.
int _ed_ctx_on3 = 0;      // menü açık mı
int _ed_ctx_x3  = 0;
int _ed_ctx_y3  = 0;
int _ed_ctx_id3 = 0 - 1;  // menünün açıldığı varlık (-1 = boşluk)
int _ed_rpx3    = 0;      // sağ tuşun basıldığı yer
int _ed_rpy3    = 0;
int _ed_rdrag3  = 0;      // sağ tuş sürüklendi mi
int _ed_rdown3  = 0;      // sağ tuşun önceki kare durumu (bırakma kenarı)
int _ED_CTX_SLOP3 = 4;    // bu kadar pikselden az hareket "tık" sayılır

func _ed_ctx_open3(x, y, id) {
    _ed_ctx_on3 = 1;
    _ed_ctx_x3 = x;
    _ed_ctx_y3 = y;
    _ed_ctx_id3 = id;
}
func _ed_ctx_close3() { _ed_ctx_on3 = 0; }

// Menüdeki satır sayısı bağlama göre değişiyor. Yapıştır satırı YALNIZ pano
// doluysa: her zaman görünen ama çoğu zaman iş görmeyen bir satır, menüyü
// uzatmaktan başka bir şey yapmazdı.
func _ed_ctx_rows3(): int {
    int yp = 0;
    if (_ed_clip3 != "") { yp = 1; }
    // cercevele/kopyala/cogalt/zemine/sil  (+ yapistir)
    if (_ed_ctx_id3 >= 0) { return 5 + yp; }
    // kutu/kure/boru/duvar/bolge  (+ yapistir)
    return 5 + yp;
}
func _ed_ctx_w3(): int { return _us3(96); }
func _ed_ctx_h3(): int { return _ed_ctx_rows3() * _ED_FLD3 + _us3(4); }
// Kaydedilmemiş değişiklik. Editörde en sinsi UX hatası "kaydettim sanmak";
// her editör bunu başlıkta bir yıldızla söyler.
int _ed_dirty3 = 0;
float _ed_confirm3 = 0.0; // yıkıcı eylemde onay penceresi (sn)

int _ed_drag3 = 0;        // seçili varlık sürükleniyor mu
float _ed_dgy3 = 0.0;     // sürükleme düzleminin yüksekliği (yakalandığı an)
float _ed_ox3 = 0.0;      // kavrama ofseti: merkez - tıklanan nokta
float _ed_oz3 = 0.0;

func editor3d(on) {
    // Odak ve sürükleme jestleri kip geçişinde SIFIRLANIR. Odaklı bir alan
    // ekrandan kalkarsa (seçim gider, panel çizilmez) odağı temizleyecek kimse
    // kalmıyordu ve editörün tüm klavyesi ölüyordu.
    _g_focus3 = 0; _g_buf3 = ""; _g_act3 = 0;
    _gz_axis3 = 0 - 1;
    if (on) {
        // Editöre girmek = Unity'deki "Dur": oyunun ürettiği durum ATILIR ve
        // yazarlık durumuna dönülür. Bunu yapmazsak 30 saniye oynadıktan sonra
        // TAB'a basmak, kovalamış düşmanları ve dönmüş süsleri "yazılmış hâl"
        // sanmaya yol açıyor — ve F5 onu dosyaya kalıcı yazıyor.
        if (_ed_on3 == 0) { _ed_apply_json3(_sc_authored3, 1); }
        _ed_on3 = 1;
        // Bölgeler oyunda GÖRÜNMEZ ama editörde görünmeliler: düzenlenecek
        // bir şeyin görünmemesi onu düzenlenemez yapıyor.
        trigger_show3d(true);
        // Editöre girerken kamerayı oyunun baktığı yere yakın kur ki
        // "neredeyim?" anı yaşanmasın.
        int t = _slot_of3(_cam_target);
        if (t >= 0) {
            Ent3 e = _e3[t];
            _ed_cx3 = e.x; _ed_cy3 = e.y + 14.0; _ed_cz3 = e.z + 26.0;
            _ed_yaw3 = 0.0; _ed_pitch3 = 0.0 - 25.0;
        }
    } else {
        // Editörden çıkmak = "Oynat": ekrandaki düzenlenmiş sahne artık
        // yazarlık durumu; oyun ONUN kopyası üzerinde koşacak.
        if (_ed_on3 == 1) { _ed_capture3(); }
        _ed_on3 = 0; _ed_drag3 = 0;
        trigger_show3d(false);   // oyunda bölgeler yine görünmez
    }
    // İmleç editörde serbest olmalı (bakış SAĞ tuşla) — kilitli imleçle
    // varlığa tıklanamaz.
    cursor_lock(false);
}
func editor_ac3d(ac) { editor3d(ac); }
func editor_on3d(): bool { return _ed_on3 == 1; }

func _s3_editor_look(dt) {
    // Sağ tuşun basıldığı yeri ve hareket edip etmediğini izle: bırakışta
    // "sürükledi mi yoksa tıkladı mı" ayrımı buna dayanıyor.
    // Bırakma KENARINI kendimiz türetiyoruz: tame `mouse_released` sunmuyor,
    // sol tuş için de aynı desen (`_g_rel3`) kullanılıyor.
    int rd = 0;
    if (mouse_down(1)) { rd = 1; }
    int rrel = 0;
    if (_ed_rdown3 == 1 && rd == 0) { rrel = 1; }
    _ed_rdown3 = rd;

    if (mouse_pressed(1)) {
        _ed_rpx3 = mouse_x(); _ed_rpy3 = mouse_y(); _ed_rdrag3 = 0;
    }
    if (rd == 1) {
        int ddx = mouse_x() - _ed_rpx3;
        int ddy = mouse_y() - _ed_rpy3;
        if (ddx > _ED_CTX_SLOP3 || ddx < 0 - _ED_CTX_SLOP3 ||
            ddy > _ED_CTX_SLOP3 || ddy < 0 - _ED_CTX_SLOP3) { _ed_rdrag3 = 1; }
    }
    if (mouse_down(1)) {
        _ed_yaw3 = _ed_yaw3 + mouse_dx() * _cam_sens3;
        _ed_pitch3 = _ed_pitch3 - mouse_dy() * _cam_sens3;
        if (_ed_pitch3 > 88.0) { _ed_pitch3 = 88.0; }
        if (_ed_pitch3 < 0.0 - 88.0) { _ed_pitch3 = 0.0 - 88.0; }
    }
    // Sürüklemeden bırakma = bağlam menüsü. Yalnız sahne görünümünün içinde;
    // paneller üzerinde sağ tık bir şey ifade etmiyor.
    if (rrel == 1 && _ed_rdrag3 == 0 && _ed_in_view3()) {
        int hit = ed_pick_at3d(mouse_x(), mouse_y());
        if (hit >= 0) { _ed_sel3e = hit; _ed_tab3 = 0; }
        _ed_ctx_open3(mouse_x(), mouse_y(), hit);
    }
}

// ---- Bağlam menüsünün çizimi ve tıklamaları --------------------------------
// Menü EN SON çiziliyor ve fareyi yutuyor: altındaki panele/sahneye tıklama
// geçerse menü seçimi aynı anda bir de arka plan eylemi tetiklerdi.
func _ed_ctx_draw3() {
    if (_ed_ctx_on3 == 0) { return; }
    int w = _ed_ctx_w3();
    int h = _ed_ctx_h3();
    int x = _ed_ctx_x3;
    int y = _ed_ctx_y3;
    // Ekran kenarına sığdır.
    if (x + w > screen_width()) { x = screen_width() - w - _us3(2); }
    if (y + h > screen_height()) { y = screen_height() - h - _us3(2); }
    rect(x, y, w, h, rgba(24, 26, 32, 246));
    rect_lines(x, y, w, h, _G_ACC3());
    int iy = y + _us3(2);
    if (_ed_ctx_id3 >= 0) {
        int id = _ed_ctx_id3;
        if (_g_button(22001, x + _us3(2), iy, w - _us3(4), _ED_FLD3, "Cercevele")) {
            ed_frame3d(id); _ed_ctx_close3();
        }
        iy = iy + _ED_FLD3;
        // Kopyala menüde de duruyor: CTRL+C'yi bilmeyen biri panonun VAR
        // olduğunu ancak burada görüyor. Kopyalanan şey SEÇİM — menü tek bir
        // varlığın üstünde açılsa da çoklu seçim korunuyor, yoksa "beşini
        // seçtim, sağ tıkladım, biri kopyalandı" olurdu.
        if (_g_button(22005, x + _us3(2), iy, w - _us3(4), _ED_FLD3, "Kopyala")) {
            if (_ed_msel_has3(id) == false) { ed_select3d(id); }
            ed_copy3d();
            _ed_ctx_close3();
        }
        iy = iy + _ED_FLD3;
        if (_g_button(22002, x + _us3(2), iy, w - _us3(4), _ED_FLD3, "Cogalt")) {
            ed_mark3d(); ed_duplicate3d(id); _ed_ctx_close3();
        }
        iy = iy + _ED_FLD3;
        if (_g_button(22003, x + _us3(2), iy, w - _us3(4), _ED_FLD3, "Zemine otur")) {
            ed_mark3d(); ed_drop3d(id); _ed_ctx_close3();
        }
        iy = iy + _ED_FLD3;
        if (_g_button(22004, x + _us3(2), iy, w - _us3(4), _ED_FLD3, "Sil")) {
            ed_mark3d(); ed_delete3d(id); _ed_ctx_close3();
        }
        if (_ed_clip3 != "") {
            iy = iy + _ED_FLD3;
            if (_g_button(22006, x + _us3(2), iy, w - _us3(4), _ED_FLD3,
                          "Yapistir")) {
                ed_mark3d(); ed_paste3d(); _ed_ctx_close3();
            }
        }
    } else {
        // Boşluğa sağ tık: varlık ekle. Eklenen şey İMLECİN altındaki zemine
        // konuyor, kameranın konumuna değil — "burada bir kutu olsun"
        // demenin doğal karşılığı bu.
        if (_g_button(22011, x + _us3(2), iy, w - _us3(4), _ED_FLD3, "+ kutu")) {
            _ed_ctx_add3(TAG_PROP, SHAPE_CUBE, 1.0);
        }
        iy = iy + _ED_FLD3;
        if (_g_button(22012, x + _us3(2), iy, w - _us3(4), _ED_FLD3, "+ kure")) {
            _ed_ctx_add3(TAG_ITEM, SHAPE_SPHERE, 1.0);
        }
        iy = iy + _ED_FLD3;
        if (_g_button(22013, x + _us3(2), iy, w - _us3(4), _ED_FLD3, "+ boru")) {
            _ed_ctx_add3(TAG_PROP, SHAPE_CYL, 1.0);
        }
        iy = iy + _ED_FLD3;
        if (_g_button(22014, x + _us3(2), iy, w - _us3(4), _ED_FLD3, "+ duvar")) {
            _ed_ctx_add3(TAG_WALL, SHAPE_CUBE, 3.0);
        }
        iy = iy + _ED_FLD3;
        if (_g_button(22015, x + _us3(2), iy, w - _us3(4), _ED_FLD3, "+ bolge")) {
            _ed_ctx_zone3();
        }
        if (_ed_clip3 != "") {
            iy = iy + _ED_FLD3;
            if (_g_button(22016, x + _us3(2), iy, w - _us3(4), _ED_FLD3,
                          "Yapistir")) {
                ed_mark3d(); ed_paste3d(); _ed_ctx_close3();
            }
        }
    }
    // Dışarıya tıklamak kapatır (menünün kendi düğmeleri zaten kapatıyor).
    if (_g_press3 == 1 && _g_in(x, y, w, h) == false) { _ed_ctx_close3(); }
}

// Menüden BÖLGE ekle — imlecin altındaki zemine, seçili hâlde.
func _ed_ctx_zone3() {
    ed_mark3d();
    _ed_ray3(_ed_ctx_x3 - _ed_view_x3(), _ed_ctx_y3 - _ed_view_y3(),
             _ed_view_w3(), _ed_view_h3(), _cam_fov);
    float t = _ray_planey3(_ed_cy3, _ed_ry3, _ground_y);
    float px = _ed_cx3;
    float pz = _ed_cz3;
    if (t > 0.0) {
        px = _ed_cx3 + _ed_rx3 * t;
        pz = _ed_cz3 + _ed_rz3 * t;
    }
    trigger3d(px, _ground_y + 2.0, pz, 4.0, 4.0, 4.0, TAG_PLAYER);
    _ed_tab3 = 2;
    _ed_zsel3 = length(_trg_x) - 1;
    _ed_sel3e = 0 - 1;
    // Bölgeler normalde GÖRÜNMEZ; editörde yeni eklenen bir bölgeyi
    // göremeden düzenlemek imkânsız olurdu.
    trigger_show3d(true);
    _ed_ctx_close3();
}

// Menüden varlık ekle: imleç ışınının zemini kestiği noktaya.
func _ed_ctx_add3(tag, shape, boy) {
    ed_mark3d();
    _ed_ray3(_ed_ctx_x3 - _ed_view_x3(), _ed_ctx_y3 - _ed_view_y3(),
             _ed_view_w3(), _ed_view_h3(), _cam_fov);
    float t = _ray_planey3(_ed_cy3, _ed_ry3, _ground_y);
    float px = _ed_cx3;
    float pz = _ed_cz3;
    if (t > 0.0) {
        px = _ed_cx3 + _ed_rx3 * t;
        pz = _ed_cz3 + _ed_rz3 * t;
    }
    int nid = ed_add3d(tag, shape, px, _ground_y + boy * 0.5, pz);
    if (boy > 1.5) { ed_resize3d(nid, 6.0, boy, 1.0); }
    ed_select3d(nid);
    _ed_tab3 = 0;
    _ed_ctx_close3();
}

func _s3_editor_fly(dt) {
    // Fare panelin üstündeyken kamera SÜRÜLMEZ. `mouse_wheel()` kare boyunca
    // sabit bir değer döndürüyor, yani hem burası hem hiyerarşi listesi aynı
    // karede okuyordu: listeyi kaydırmak aynı anda kamerayı da ileri sürüyordu.
    if (_ed_over_ui3()) { return; }
    // WASD/QE yalnız SAĞ TUŞ BASILIYKEN uçuruyor — Unity, Unreal ve Godot'ta
    // da böyle. Sürekli uçuş harf tuşlarını rehin alıyordu: W/E/R gibi standart
    // araç kısayolları imkânsızdı, çünkü W aynı anda "ileri uç" demekti.
    // Tekerlek serbest kalıyor (yakınlaş/uzaklaş her editörde sağ tuşsuz çalışır).
    if (mouse_down(1) == false) {
        float wh0 = mouse_wheel();
        if (abs_f3(wh0) > 0.01) { _ed_zoom3(wh0); }
        return;
    }
    float yr = _ed_yaw3 * DEG2RAD3;
    float fx = sin(yr);
    float fz = 0.0 - cos(yr);
    float rx = cos(yr);
    float rz = sin(yr);
    float sp = _ed_fly3;
    if (key_down(K_LSHIFT)) { sp = sp * 3.0; }
    float mx = 0.0; float mz = 0.0; float my = 0.0;
    if (key_down(K_W)) { mx = mx + fx; mz = mz + fz; }
    if (key_down(K_S)) { mx = mx - fx; mz = mz - fz; }
    if (key_down(K_D)) { mx = mx + rx; mz = mz + rz; }
    if (key_down(K_A)) { mx = mx - rx; mz = mz - rz; }
    if (key_down(K_E)) { my = my + 1.0; }
    if (key_down(K_Q)) { my = my - 1.0; }
    float L = sqrt(mx * mx + mz * mz);
    if (L > 0.001) { mx = mx / L; mz = mz / L; }
    _ed_cx3 = _ed_cx3 + mx * sp * dt;
    _ed_cy3 = _ed_cy3 + my * sp * dt;
    _ed_cz3 = _ed_cz3 + mz * sp * dt;
    float wh = mouse_wheel();
    if (abs_f3(wh) > 0.01) { _ed_zoom3(wh); }
}

// Bakış yönünde yaklaş/uzaklaş.
func _ed_zoom3(amount) {
    float yr = _ed_yaw3 * DEG2RAD3;
    float pr = _ed_pitch3 * DEG2RAD3;
    float cp = cos(pr);
    _ed_cx3 = _ed_cx3 + sin(yr) * cp * amount * 2.0;
    _ed_cy3 = _ed_cy3 + sin(pr) * amount * 2.0;
    _ed_cz3 = _ed_cz3 - cos(yr) * cp * amount * 2.0;
}

// Seçili varlığı çerçevele (F). Her editörde en çok kullanılan tuşlardan biri
// ve yoktu: uzaktaki bir varlığı seçtikten sonra oraya elle uçmak gerekiyordu.
// Mesafe cismin BOYUTUNDAN türüyor — sabit mesafe, küçük cismi görünmez,
// büyüğünü kadraj dışı bırakırdı.
func ed_frame3d(id) {
    int s = _slot_of3(id);
    if (s < 0) { return; }
    Ent3 e = _e3[s];
    float big = e.sx;
    if (e.sy > big) { big = e.sy; }
    if (e.sz > big) { big = e.sz; }
    float d = big * 2.6 + 4.0;
    float yr = _ed_yaw3 * DEG2RAD3;
    float pr = _ed_pitch3 * DEG2RAD3;
    float cp = cos(pr);
    // Kamerayı mevcut BAKIŞ AÇISINI koruyarak cismin önüne koy: açıyı da
    // sıfırlamak kullanıcının kurduğu görüşü mantıksız yere bozardı.
    _ed_cx3 = e.x - sin(yr) * cp * d;
    _ed_cy3 = e.y - sin(pr) * d;
    _ed_cz3 = e.z + cos(yr) * cp * d;
}
func cerceveleye3d(id) { ed_frame3d(id); }

// Ekran noktasından seç.
// Seçim ışını GÖRÜNÜM dikdörtgenine göre kuruluyor: sahne artık pencerenin
// tamamı değil, panellerin arasındaki alan. Pencere koordinatı kullanmak
// imleçle seçimi kaydırırdı.
func ed_pick_at3d(px, py): int {
    _ed_ray3(px - _ed_view_x3(), py - _ed_view_y3(),
             _ed_view_w3(), _ed_view_h3(), _cam_fov);
    return _ed_pick3(_ed_cx3, _ed_cy3, _ed_cz3, _ed_rx3, _ed_ry3, _ed_rz3, _ed_reach3);
}

// Ekran noktasından BÖLGE seç. `_ed_ray3` çağrısı `ed_pick_at3d` ile aynı;
// ayrı fonksiyon olmasının sebebi ÖNCELİK: bölge genellikle içinde
// entity'ler barındıran büyük bir kutu, yani bölgeyi önce sınamak kutunun
// içindeki hiçbir cismin tıklanamaması demek olurdu. Bölge ancak entity
// bulunamadığında sınanıyor.
func ed_pick_zone_at3d(px, py): int {
    _ed_ray3(px - _ed_view_x3(), py - _ed_view_y3(),
             _ed_view_w3(), _ed_view_h3(), _cam_fov);
    return _ed_pick_zone3(_ed_cx3, _ed_cy3, _ed_cz3,
                          _ed_rx3, _ed_ry3, _ed_rz3, _ed_reach3);
}

// KAVRAMA OFSETİ ve SÜRÜKLEME NOKTASI — varlık da bölge de buradan geçiyor.
//
// Ofset, tıkladığın nokta ile cismin merkezi arasındaki fark. Saklanmasaydı
// cismin MERKEZİ imlecin altına atlardı: 24 birimlik bir duvarın ucuna
// tıklamak onu 12 birim kaydırırdı. İki ayrı kopya tutmak, birinde
// düzeltilen bir hatanın ötekinde yaşamaya devam etmesi demekti.
//
// Sürükleme düzlemi cismin KENDİ yüksekliğinde (`_ed_dgy3`); zemin düzlemini
// kullanmak, havadaki bir platformu tutunca onu yere düşürürdü.
float _ed_dpx3 = 0.0;
float _ed_dpz3 = 0.0;

func _ed_grab_offset3(cx, cz, dy) {
    _ed_dgy3 = dy;
    _ed_ox3 = 0.0; _ed_oz3 = 0.0;
    float gt = _ray_planey3(_ed_cy3, _ed_ry3, dy);
    if (gt > 0.0) {
        _ed_ox3 = cx - (_ed_cx3 + _ed_rx3 * gt);
        _ed_oz3 = cz - (_ed_cz3 + _ed_rz3 * gt);
    }
}

// Işının sürükleme düzlemini kestiği nokta + ofset. Işın düzleme paralelse
// (ya da arkasındaysa) false döner ve ÇAĞIRAN hiçbir şey taşımıyor: yoksa
// cisim bir anda sonsuza kaçardı.
func _ed_drag_point3(): bool {
    float dt2 = _ray_planey3(_ed_cy3, _ed_ry3, _ed_dgy3);
    if (dt2 <= 0.0) { return false; }
    _ed_dpx3 = _ed_cx3 + _ed_rx3 * dt2 + _ed_ox3;
    _ed_dpz3 = _ed_cz3 + _ed_rz3 * dt2 + _ed_oz3;
    return true;
}

func _s3_editor_mouse(dt) {
    int s = _slot_of3(_ed_sel3e);
    // Bağlam menüsü açıkken görüntü penceresi tıklama ALMIYOR: menüdeki bir
    // seçim aynı anda arkadaki sahnede de bir şey seçerdi. Dosya penceresi
    // için de aynısı — hatta daha kritiği: liste ekranın ORTASINDA duruyor,
    // yani tam sahnenin üstünde.
    if (_ed_ctx_on3 == 1) { return; }
    if (_ed_fd_on3 != _ED_FD_OFF3) { return; }
    if (_ed_help3 == 1) { return; }
    if (_ed_dock_on3 == 1) { return; }
    // Panel sürüklenirken de görünüm tıklama almamalı: sürükleme sahnenin
    // üstünden geçiyor ve bırakma anı orada bir seçim olurdu.
    if (_dk_drag3 >= 0) { return; }
    // Ayraç sürüklenirken görünüm tıklama almamalı: sol ayraç tam görünümün
    // kenarında duruyor, yani sürüklemenin ilk karesi aynı zamanda sahnede
    // bir seçim olurdu.
    if (_ed_split3 > 0) { return; }
    // Sürükleme SÜRÜYORSA panel denetimi atlanıyor: imleç panelin üstünden
    // geçerken sürüklemenin kopması, Unity'de de olmayan bir davranış olurdu.
    if (_gz_axis3 < 0 && _ed_drag3 == 0 && _ed_mq3 == 0 && _ed_over_ui3()) { return; }

    if (mouse_pressed(0)) {
        // 1) ÖNCE tutamaklar: okun üstündeki tıklama arkadaki varlığı
        // seçmemeli, yoksa oka basmak seçimi değiştirirdi.
        // DÖNDÜRME kipinde tutamak bir HALKA, ok değil. Ayrı dal, çünkü
        // yakalanan şey de ayrı: eksen sürüklemesi bir UZAKLIK, halka bir
        // AÇI taşıyor.
        if (s >= 0 && _ed_mode3 == ED_ROTATE) {
            _ed_ray3(mouse_x() - _ed_view_x3(), mouse_y() - _ed_view_y3(),
                     _ed_view_w3(), _ed_view_h3(), _cam_fov);
            Ent3 re = _e3[s];
            float rr = _gz_ring_r3(re.x, re.y, re.z, re.sx, re.sz);
            if (_gz_ring_pick3(_ed_cx3, _ed_cy3, _ed_cz3, _ed_rx3, _ed_ry3,
                               _ed_rz3, re.x, re.y, re.z, rr)) {
                _gz_py3 = re.y;
                _gz_grab_group3();
                // TUTUNMA tıklanan varlığın halkasında sınanıyor ama
                // REFERANS AÇI grup merkezinden okunuyor: ikisi çoklu
                // seçimde farklı noktalar ve karıştırılsaydı sürüklemenin
                // ilk karesi grubu bir anda sıçratırdı.
                float a0 = _gz_ring_ang3(_ed_cx3, _ed_cy3, _ed_cz3, _ed_rx3,
                                         _ed_ry3, _ed_rz3, _gz_gcx3, _gz_py3,
                                         _gz_gcz3);
                if (_gz_ang_ok3(a0)) {
                    ed_mark3d();
                    _gz_axis3 = _GZ_RING3;
                    _gz_a0_3 = a0;
                    _ed_drag3 = 0;
                    return;
                }
            }
        }
        if (s >= 0 && (_ed_mode3 == ED_MOVE || _ed_mode3 == ED_SCALE)) {
            _ed_ray3(mouse_x() - _ed_view_x3(), mouse_y() - _ed_view_y3(),
                     _ed_view_w3(), _ed_view_h3(), _cam_fov);
            Ent3 ge = _e3[s];
            int ax = _gz_pick3(_ed_cx3, _ed_cy3, _ed_cz3,
                               _ed_rx3, _ed_ry3, _ed_rz3, ge.x, ge.y, ge.z);
            if (ax >= 0) {
                ed_mark3d();
                _gz_axis3 = ax;
                _gz_t0_3 = _gz_t3;
                _gz_px3 = ge.x; _gz_py3 = ge.y; _gz_pz3 = ge.z;
                // Seçimin TAMAMI yakalanıyor: ölçek tutamağı yalnız birincil
                // varlığı büyütüyordu, oysa taşıma ve döndürme grubu işliyor.
                // Beş kutuyu seçip ölçeklemek dördünü değiştirmiyordu ve
                // hiçbir yerde bunu söyleyen bir şey yoktu.
                _gz_grab_group3();
                _ed_drag3 = 0;
                return;
            }
        }
        // BÖLGENİN tutamakları. Varlık seçili değilken çalışıyor: ikisi
        // birden seçili olamıyor (bölge seçmek varlık seçimini bırakıyor),
        // yani hangi tutamağın kime ait olduğu belirsiz kalmıyor.
        // DÖNDÜRME kipi burada YOK — bölgenin yaw'ı yok (bkz. _gz_zone_draw3).
        if (s < 0 && _ed_tab3 == 2 && _ed_zone_ok3(_ed_zsel3) &&
            (_ed_mode3 == ED_MOVE || _ed_mode3 == ED_SCALE)) {
            _ed_ray3(mouse_x() - _ed_view_x3(), mouse_y() - _ed_view_y3(),
                     _ed_view_w3(), _ed_view_h3(), _cam_fov);
            int zi = _ed_zsel3;
            int zax = _gz_pick3(_ed_cx3, _ed_cy3, _ed_cz3,
                                _ed_rx3, _ed_ry3, _ed_rz3,
                                _trg_x[zi], _trg_y[zi], _trg_z[zi]);
            if (zax >= 0) {
                ed_mark3d();
                _gz_axis3 = zax;
                _gz_t0_3 = _gz_t3;
                _gz_grab_zone3(zi);
                _ed_drag3 = 0;
                return;
            }
        }
        // 2) Sonra seçim.
        int hit = ed_pick_at3d(mouse_x(), mouse_y());
        if (hit >= 0) {
            // CTRL basılıysa kümeye ekle/çıkar (her editörde standart).
            if (key_down(K_LCTRL)) { ed_select_toggle3d(hit); }
            else {
                // Zaten kümedeyse seçimi BOZMA: çoklu seçimi sürüklemek için
                // içindekilerden birine basmak gerekiyor ve bu basış kümeyi
                // tek varlığa indirseydi çoklu taşıma imkânsız olurdu.
                if (_ed_msel_has3(hit)) { _ed_sel3e = hit; }
                else { ed_select3d(hit); }
            }
            _ed_drag_z3 = 0 - 1;   // bu jest bir VARLIĞI sürüklüyor
            _ed_tab3 = 0;   // görünümden seçim DÜNYA'dan çıkarır
            // Sürükleme düzlemi ve kavrama ofseti — ikisi de
            // `_ed_grab_offset3` içinde, bölgeninkiyle aynı yerde.
            _ed_grab_offset3(get3x(hit), get3z(hit), get3y(hit));
            // Geri-al işareti yalnız GERÇEKTEN bir jest başlarken: boşluğa
            // tıklamak da işaret koysaydı, 40'lık geçmiş boş tıklamalarla
            // sessizce boşalırdı (ölçüldü).
            if (_ed_mode3 == ED_MOVE) { ed_mark3d(); }
            _ed_drag3 = 1;
        } else {
            // Entity yoksa BÖLGE dene. Bölgeler artık editörde çiziliyor;
            // görünen ama tıklanamayan bir şey, olmayan bir şeyden daha
            // kafa karıştırıcı olurdu.
            int zh = ed_pick_zone_at3d(mouse_x(), mouse_y());
            if (zh >= 0) {
                ed_deselect3d();
                _ed_tab3 = 2;
                _ed_zsel3 = zh;
                // Bölge de TUTULUP SÜRÜKLENİYOR — varlıkla aynı jest. Seçilip
                // sürüklenemeyen bir cisim, seçimin ne işe yaradığını
                // sorduruyordu: bölgeyi haritada gezdirmenin tek yolu ok
                // tuşlarıydı.
                _ed_drag_z3 = zh;
                // Ofset varlıktakiyle AYNI fonksiyondan: bölgeler genellikle
                // kocaman kutular, kenarına tıklayınca merkezinin imlecin
                // altına atlaması onları kullanılamaz yapardı.
                _ed_grab_offset3(_trg_x[zh], _trg_z[zh], _trg_y[zh]);
                if (_ed_mode3 == ED_MOVE) { ed_mark3d(); }
                _ed_drag3 = 1;
            } else {
                // Boşluğa tıklamak HER İKİ seçimi de bırakıyor. Bölgeninki
                // kalsaydı tutamakları boşlukta durmaya devam eder ve
                // "şu an neyi taşıyorum?" sorusu cevapsız kalırdı.
                if (key_down(K_LCTRL) == false) {
                    ed_deselect3d();
                    _ed_zsel3 = 0 - 1;
                }
                _ed_drag3 = 0;
                // ...ve KUTU SEÇİMİ burada başlıyor. Aynı basış hem seçimi
                // bırakıyor hem kutuyu açıyor: eşiği geçmeyen bir sürükleme
                // sade bir tıklama olarak kalıyor (bkz. _ed_mq_big3).
                _ed_mq3 = 1;
                _ed_mq_x03 = mouse_x();
                _ed_mq_y03 = mouse_y();
                _ed_mq_add3 = 0;
                if (key_down(K_LCTRL)) { _ed_mq_add3 = 1; }
            }
        }
    }

    if (mouse_down(0) == false) {
        // Kutu BIRAKMA anında uygulanıyor. Sürüklerken uygulamak, kutuyu
        // büyütüp küçültürken seçimi durmadan değiştirir — çizim önizleme,
        // KARAR bırakma anıdır.
        if (_ed_mq3 == 1) { _ed_mq_apply3(mouse_x(), mouse_y()); }
        _ed_drag3 = 0; _gz_axis3 = 0 - 1; _gz_zid3 = 0 - 1; _ed_drag_z3 = 0 - 1;
    }

    // Üzerine gelince vurgulama: tıklamadan ÖNCE neyi seçeceğini göstermek
    // her editörde var ve yokluğu "tıkladım ama yanlış şey seçildi" hissi
    // veriyor. Kare başına bir ışın taraması — seçim taramasının aynısı.
    _ed_msel_prune3();
    if (_ed_drag3 == 0 && _gz_axis3 < 0 && _ed_mq3 == 0) {
        _ed_hover3 = ed_pick_at3d(mouse_x(), mouse_y());
    } else { _ed_hover3 = 0 - 1; }

    // Eksen sürüklemesi. Referans doğru YAKALANDIĞI andaki konumda sabit —
    // varlıkla birlikte kaysaydı hareket kendini besleyip kaçardı.
    if (_gz_axis3 == _GZ_RING3 && s >= 0) {
        _ed_ray3(mouse_x() - _ed_view_x3(), mouse_y() - _ed_view_y3(),
                 _ed_view_w3(), _ed_view_h3(), _cam_fov);
        // Sürüklerken TUTUNMA sınanmıyor, yalnız açı okunuyor: imleç
        // halkanın dışına çıkınca dönüşün kopması, hiçbir editörde
        // olmayan bir davranış olurdu.
        float a = _gz_ring_ang3(_ed_cx3, _ed_cy3, _ed_cz3, _ed_rx3, _ed_ry3,
                                _ed_rz3, _gz_gcx3, _gz_py3, _gz_gcz3);
        if (_gz_ang_ok3(a)) {
            float d = _gz_angdiff3(a, _gz_a0_3);
            _ed_rotate_group3(_gz_snap_deg3(d, _ed_grid3));
        }
        return;
    }
    if (_gz_axis3 >= 0 && _gz_zid3 >= 0) {
        _ed_ray3(mouse_x() - _ed_view_x3(), mouse_y() - _ed_view_y3(),
                 _ed_view_w3(), _ed_view_h3(), _cam_fov);
        float zx = _gz_ax_x3(_gz_axis3);
        float zy = _gz_ax_y3(_gz_axis3);
        float zz = _gz_ax_z3(_gz_axis3);
        float zd = _ray_axis3(_ed_cx3, _ed_cy3, _ed_cz3, _ed_rx3, _ed_ry3,
                              _ed_rz3, _gz_px3, _gz_py3, _gz_pz3, zx, zy, zz);
        if (zd >= 0.0) {
            float zdelta = _gz_t3 - _gz_t0_3;
            if (_ed_mode3 == ED_MOVE) {
                ed_zone_move3d(_gz_zid3, _gz_px3 + zx * zdelta,
                               _gz_py3 + zy * zdelta, _gz_pz3 + zz * zdelta);
            } else {
                _ed_zone_resize_axis3(_gz_zid3, zx, zy, zz, zdelta);
            }
        }
        return;
    }
    if (_gz_axis3 >= 0 && s >= 0) {
        _ed_ray3(mouse_x() - _ed_view_x3(), mouse_y() - _ed_view_y3(),
                 _ed_view_w3(), _ed_view_h3(), _cam_fov);
        float ax = _gz_ax_x3(_gz_axis3);
        float ay = _gz_ax_y3(_gz_axis3);
        float az = _gz_ax_z3(_gz_axis3);
        float d = _ray_axis3(_ed_cx3, _ed_cy3, _ed_cz3, _ed_rx3, _ed_ry3, _ed_rz3,
                             _gz_px3, _gz_py3, _gz_pz3, ax, ay, az);
        if (d >= 0.0) {
            float delta = _gz_t3 - _gz_t0_3;
            if (_ed_mode3 == ED_MOVE) {
                _ed_move_group3(_gz_px3 + ax * delta, _gz_py3 + ay * delta,
                                _gz_pz3 + az * delta);
            } else {
                _ed_resize_group3(ax * delta, ay * delta, az * delta);
            }
        }
        return;
    }

    // Düz sürükleme ZEMİN DÜZLEMİNDE. Sürüklenen şeyin ne olduğunu jestin
    // BAŞINDA saklıyoruz (`_ed_drag_z3`): sürükleme ortasında seçim
    // değişebilir ve o an başka bir şey kaymaya başlardı.
    if (_ed_drag3 == 1 && _ed_mode3 == ED_MOVE && _ed_drag_z3 >= 0) {
        _ed_ray3(mouse_x() - _ed_view_x3(), mouse_y() - _ed_view_y3(),
                 _ed_view_w3(), _ed_view_h3(), _cam_fov);
        if (_ed_drag_point3()) {
            ed_zone_move3d(_ed_drag_z3, _ed_dpx3, _ed_dgy3, _ed_dpz3);
        }
        return;
    }
    if (_ed_drag3 == 1 && _ed_mode3 == ED_MOVE && _slot_of3(_ed_sel3e) >= 0) {
        _ed_ray3(mouse_x() - _ed_view_x3(), mouse_y() - _ed_view_y3(),
                 _ed_view_w3(), _ed_view_h3(), _cam_fov);
        if (_ed_drag_point3()) {
            _ed_move_group3(_ed_dpx3, _ed_dgy3, _ed_dpz3);
        }
    }
}

// Editörün yazacağı dosya. `sahne_dosya3d` ile yüklenen oyun bunu kendi
// yoluna kurarsa düzenleme tam bir döngü olur: düzenle → F5 → aynı JSON
// güncellenir, yeniden derleme yok.
func editor_file3d(path) {
    _ed_path3 = path;
    // Hedef değişti: kurtarma dosyası da yola bağlı, yeniden bakılmalı.
    ed_recovery_scan3d();
}
func editor_dosya3d(yol) { editor_file3d(yol); }

// KAYDEDİLEN, ekrandaki YAZARLIK durumudur. F5 yalnız editör kipinde işliyor
// (bu fonksiyon `_s3_editor_keys` içinden çağrılıyor), editöre girmek de
// simülasyonu attığı için oynanmış hâlin diske sızması mümkün değil.
// ---- KURTARMA DOSYASI -------------------------------------------------------
// Pencereyi çarpıyla kapatmak kaydedilmemiş işi götürüyordu ve raylib'de
// kapanışı İPTAL edecek bir bağlama yok: `WindowShouldClose()` bir kez true
// dönünce geri alınamıyor, yani "emin misin?" diye SORULAMIYOR.
//
// Sorulamayanı kaybetmemek yine de mümkün: çıkarken yaşayan sahne
// `<dosya>.kurtarma.json`'a yazılıyor ve editör bir dahaki açılışta onu
// görüp menüde bir KURTAR düğmesi gösteriyor. Sessizce geri yüklemek YANLIŞ
// olurdu — kullanıcı kaydetmemeyi bilerek seçmiş olabilir; karar onun.
func _ed_recover_path3(yol): str {
    if (yol == "") { return "sahne.kurtarma.json"; }
    return yol + ".kurtarma.json";
}

// Silme builtin'i YOK, o yüzden "boş içerik = kurtarma yok" sözleşmesi.
func _ed_recovery_read3(): str {
    str yol = _ed_recover_path3(_ed_path3);
    if (web_mi()) { return kayit_oku(_s3_key3(yol)); }
    if (file_exists(yol) == false) { return ""; }
    return read_file(yol);
}
func ed_recovery3d(): str { return _ed_recovery_read3(); }
func ed_kurtarma3d(): str { return _ed_recovery_read3(); }
func ed_has_recovery3d(): bool { return length(_ed_recovery_read3()) > 0; }

func _ed_recovery_write3(js): bool {
    str yol = _ed_recover_path3(_ed_path3);
    if (web_mi()) { return kayit_yaz(_s3_key3(yol), js); }
    return write_file(yol, js);
}

// Çıkışta çağrılıyor. YALNIZ kaydedilmemiş iş varken yazıyor: her çıkışta
// dosya bırakmak, çalışma dizinini çöplüğe çevirir ve uyarıyı anlamsız yapar.
func ed_recovery_save3d(): bool {
    if (_ed_app3 == 0) { return false; }
    if (_ed_dirty3 == 0) { return false; }
    _ed_level_store3();
    return _ed_recovery_write3(scene_json_levels3d());
}

// Kaydetmek kurtarma dosyasını GEÇERSİZ kılıyor. Kılmasaydı editör her
// açılışta "kurtarılacak iş var" derdi ve uyarı anlamını yitirirdi.
func ed_recovery_clear3d() {
    _ed_recover_has3 = 0;
    if (_ed_app3 == 0) { return; }
    _ed_recovery_write3("");
}

// Kurtarma dosyasının VARLIĞI önbellekli. Menü şeridi her kare çiziliyor ve
// düğmenin görünürlüğü için kare başına bir DİSK OKUMASI yapmak, editörü
// dosya sisteminin hızına bağlardı. Yol değiştiğinde ve kaydettiğinde
// yeniden taranıyor — durumun değişebileceği tek iki an.
int _ed_recover_has3 = 0;

func ed_recovery_scan3d() {
    _ed_recover_has3 = 0;
    if (length(_ed_recovery_read3()) > 0) { _ed_recover_has3 = 1; }
}
func ed_recovery_pending3d(): bool { return _ed_recover_has3 == 1; }

// Kurtarılan işi sahneye al. GERİ ALINABİLİR (önce işaret bırakılıyor):
// kurtarma da bir düzenleme ve yanlış düğmeye basmak geri alınabilmeli.
//
// Sessizce yüklemek YANLIŞ olurdu — kullanıcı kaydetmemeyi bilerek seçmiş
// olabilir. Karar onun, düğme de o yüzden var.
func ed_recover3d(): int {
    str js = _ed_recovery_read3();
    if (js == "") { _ed_recover_has3 = 0; return 0; }
    ed_mark3d();
    _ed_apply_json3(js, 1);
    ed_recovery_clear3d();
    // Kurtarılan iş HÂLÂ diskte değil: yıldız yanmalı, yoksa kullanıcı
    // kaydedilmiş sanır ve ikinci kez kaybeder.
    _ed_dirty3 = 1;
    _ed_dirty_seq3 = _ed_dirty_seq3 + 1;
    return yasayan_sayi3d();
}
func ed_kurtar3d(): int { return ed_recover3d(); }

func editor_save3d(): bool {
    if (_ed_path3 == "") {
        _ed_msg3 = "kayit yolu yok (editor_dosya3d cagir)";
        _ed_msg_t3 = 3.0;
        return false;
    }
    // Bölüm farkındalığı: yaşayan bölüm önce diziye yazılıyor, sonra ÇOK
    // BÖLÜMLÜ biçim kaydediliyor. Tek bölümde eski biçim yazılıyor.
    _ed_level_store3();
    bool ok = false;
    if (web_mi()) { ok = kayit_yaz(_s3_key3(_ed_path3), scene_json_levels3d()); }
    else { ok = write_file(_ed_path3, scene_json_levels3d()); }
    if (ok) {
        _ed_msg3 = "kaydedildi: " + _ed_path3;
        _ed_dirty3 = 0;
        ed_recovery_clear3d();
    }
    else { _ed_msg3 = "KAYDEDILEMEDI: " + _ed_path3; }
    _ed_msg_t3 = 3.0;
    return ok;
}
func editor_kaydet3d(): bool { return editor_save3d(); }

int K_Z = 90; int K_Y = 89; int K_F = 70;
int K_C = 67; int K_V = 86; int K_H = 72;

func _s3_editor_keys() {
    // SAĞ TUŞ basılıyken harfler UÇUŞ tuşu (WASD/QE); araç kısayolları o
    // sırada çalışmamalı. Unity, Unreal ve Godot'ta da ayrım tam budur.
    if (mouse_down(1)) { return; }
    // Dosya penceresi açıkken KLAVYE ONUN: ESC kapatır, geri kalan tuşlar
    // arkadaki sahneye gitmez. Gitseydi dosya adı yazarken "d" varlığı
    // çoğaltır, DEL seçili varlığı silerdi.
    if (_ed_fd_on3 != _ED_FD_OFF3) {
        if (key_pressed(K_ESC)) { _ed_fd_close3(); }
        return;
    }
    // Kısayol listesi açıkken de klavye ONUN: H kapatır, ESC kapatır.
    // Listeyi okurken basılan bir harfin arkadaki sahneyi değiştirmesi,
    // "ne yaptığımı öğreniyordum" ile "yanlışlıkla sildim" arasındaki fark.
    if (_ed_help3 == 1) {
        if (key_pressed(K_H) || key_pressed(K_ESC)) { _ed_help_close3(); }
        return;
    }
    if (_ed_dock_on3 == 1) {
        if (key_pressed(K_ESC)) { _ed_dock_close3(); }
        return;
    }
    if (key_pressed(K_H)) { _ed_help3 = 1; _ed_help_scroll3 = 0; return; }

    // Araç kısayolları Unity düzeninde: Q seç, W taşı, E döndür, R ölçekle.
    // 1-4 de duruyor (eski alışkanlık ve rakam tuşları her editörde çalışır).
    if (key_pressed(K_Q) || key_pressed(K_1)) { _ed_mode3 = ED_SELECT; }
    if (key_pressed(K_W) || key_pressed(K_2)) { _ed_mode3 = ED_MOVE; }
    if (key_pressed(K_E) || key_pressed(K_4)) { _ed_mode3 = ED_ROTATE; }
    if (key_pressed(K_R) || key_pressed(K_3)) { _ed_mode3 = ED_SCALE; }
    if (key_pressed(K_G)) {
        if (_ed_grid3 > 0.0) { _ed_grid3 = 0.0; } else { _ed_grid3 = 0.5; }
    }
    // ESC açık menüyü kapatıyor — bağlam menüsünden ÖNCE sınanıyor: ikisi
    // birden açıkken üstte duran açılır menü, kapanması gereken de o.
    if (key_pressed(K_ESC) && _ed_mn_open3 >= 0) { _ed_mn_close3(); return; }
    if (key_pressed(K_ESC) && _ed_ctx_on3 == 1) { _ed_ctx_close3(); return; }
    if (key_down(K_LCTRL) && key_pressed(K_S)) {
        // CTRL+SHIFT+S = farklı kaydet. Sektör standardı ve buradaki asıl
        // değeri şu: kaydetmenin refleks tuşuna basan biri, dallandırmak
        // istediğinde eli klavyeden kalkmadan pencereyi açabiliyor.
        if (key_down(K_LSHIFT)) { _ed_fd_open3(_ED_FD_SAVE3); return; }
        editor_save3d();
        return;
    }
    if (key_pressed(K_F5)) { editor_save3d(); return; }
    if (key_down(K_LCTRL) && key_pressed(K_Z)) {
        if (ed_undo3d()) { _ed_msg3 = "geri alindi"; _ed_msg_t3 = 1.2; }
        return;
    }
    if (key_down(K_LCTRL) && key_pressed(K_Y)) {
        if (ed_redo3d()) { _ed_msg3 = "yinelendi"; _ed_msg_t3 = 1.2; }
        return;
    }

    // PANO ve TÜMÜNÜ SEÇ, seçim denetiminden ÖNCE: yapıştırmak ve tümünü
    // seçmek seçili bir varlık gerektirmiyor, ve aşağıdaki erken dönüş
    // ikisini de boş sahnede erişilemez yapardı.
    if (key_down(K_LCTRL) && key_pressed(K_A)) {
        int sn = ed_select_all3d();
        _ed_msg3 = toString(sn) + " varlik secildi";
        _ed_msg_t3 = 1.5;
        return;
    }
    if (key_down(K_LCTRL) && key_pressed(K_C)) {
        int cn = ed_copy3d();
        if (cn > 0) { _ed_msg3 = toString(cn) + " varlik kopyalandi"; }
        else { _ed_msg3 = "kopyalanacak secim yok"; }
        _ed_msg_t3 = 1.5;
        return;
    }
    if (key_down(K_LCTRL) && key_pressed(K_V)) {
        if (ed_clip_count3d() == 0) {
            _ed_msg3 = "pano bos";
            _ed_msg_t3 = 1.5;
            return;
        }
        ed_mark3d();
        int pn = ed_paste3d();
        _ed_msg3 = toString(pn) + " varlik yapistirildi";
        _ed_msg_t3 = 1.5;
        return;
    }

    // BÖLGE seçiliyken tuşlar bölgeye ait.
    //
    // Yön eşlemesi artık VARLIKLA AYNI: oklar Y'yi ittiriyor, zemin düzlemi
    // sürüklemenin işi. Eskiden bölgede oklar XZ'yi veriyordu ve gerekçesi
    // "bölgede tutamak yok"tu — o gerekçe düştü (tutamak da var, sürükleme
    // de). İki seçilebilir tür arasında farklı bir klavye haritası tutmak,
    // artık hiçbir şeyin karşılığı olmayan bir istisna olurdu.
    //
    // Yazma, ölçek ve yarıçap TEK KAPIDAN geçiyor (`ed_zone_*3d`): ızgara
    // ve taban kelepçesi orada. Buradaki eski kopya kendi `0.1`'ini taşıyor
    // ve ızgaraya hiç oturmuyordu — yani aynı bölgeyi klavyeyle ittirmek ile
    // tutamakla çekmek FARKLI yerlere koyuyordu.
    if (_ed_tab3 == 2 && _ed_zone_ok3(_ed_zsel3)) {
        int zi = _ed_zsel3;
        float zg = 0.5;
        if (_ed_grid3 > 0.0) { zg = _ed_grid3; }
        if (key_pressed(K_DEL)) {
            ed_mark3d();
            _ed_zone_delete3(zi);
            _ed_tab3 = 0;
            _ed_zsel3 = 0 - 1;
            return;
        }
        // CTRL+D varlıkla aynı tuş: kopya SEÇİLİ kalıyor ki hemen
        // taşınabilsin (varlık çoğaltması da öyle yapıyor).
        if (key_pressed(K_D) && key_down(K_LCTRL)) {
            ed_mark3d();
            int yz = ed_zone_duplicate3d(zi);
            if (yz >= 0) { _ed_zsel3 = yz; }
            return;
        }
        bool ok_basildi = key_pressed(K_UP) || key_pressed(K_DOWN) ||
                          key_pressed(K_LEFT) || key_pressed(K_RIGHT);
        if (ok_basildi == false) { return; }
        ed_mark3d();
        if (_ed_mode3 == ED_SCALE) {
            if (_trg_shape[zi] == 1) {
                if (key_pressed(K_RIGHT) || key_pressed(K_UP)) {
                    ed_zone_radius3d(zi, _trg_r[zi] + zg);
                }
                if (key_pressed(K_LEFT) || key_pressed(K_DOWN)) {
                    ed_zone_radius3d(zi, _trg_r[zi] - zg);
                }
            } else {
                if (key_pressed(K_RIGHT)) {
                    ed_zone_resize3d(zi, _trg_sx[zi] + zg, _trg_sy[zi], _trg_sz[zi] + zg);
                }
                if (key_pressed(K_LEFT)) {
                    ed_zone_resize3d(zi, _trg_sx[zi] - zg, _trg_sy[zi], _trg_sz[zi] - zg);
                }
                if (key_pressed(K_UP)) {
                    ed_zone_resize3d(zi, _trg_sx[zi], _trg_sy[zi] + zg, _trg_sz[zi]);
                }
                if (key_pressed(K_DOWN)) {
                    ed_zone_resize3d(zi, _trg_sx[zi], _trg_sy[zi] - zg, _trg_sz[zi]);
                }
            }
            return;
        }
        if (key_pressed(K_UP))   { ed_zone_move3d(zi, _trg_x[zi], _trg_y[zi] + zg, _trg_z[zi]); }
        if (key_pressed(K_DOWN)) { ed_zone_move3d(zi, _trg_x[zi], _trg_y[zi] - zg, _trg_z[zi]); }
        return;
    }

    int sel = _ed_sel3e;
    if (_slot_of3(sel) < 0) { return; }
    // F: seçiliyi çerçevele. Editörlerde en çok kullanılan tuşlardan biri.
    if (key_pressed(K_F)) { ed_frame3d(sel); return; }
    float g = 0.5;
    if (_ed_grid3 > 0.0) { g = _ed_grid3; }
    if (key_pressed(K_DEL)) { ed_mark3d(); ed_delete_selected3d(); return; }
    if (key_pressed(K_D) && key_down(K_LCTRL)) { ed_mark3d(); ed_duplicate_selected3d(); return; }
    if (_ed_mode3 == ED_SCALE) {
        Ent3 e = _e3[_slot_of3(sel)];
        if (key_pressed(K_UP) || key_pressed(K_DOWN) || key_pressed(K_LEFT) ||
            key_pressed(K_RIGHT)) { ed_mark3d(); }
        if (key_pressed(K_UP))    { ed_resize3d(sel, e.sx, e.sy + g, e.sz); }
        if (key_pressed(K_DOWN))  { ed_resize3d(sel, e.sx, e.sy - g, e.sz); }
        if (key_pressed(K_RIGHT)) { ed_resize3d(sel, e.sx + g, e.sy, e.sz + g); }
        if (key_pressed(K_LEFT))  { ed_resize3d(sel, e.sx - g, e.sy, e.sz - g); }
    }
    if (_ed_mode3 == ED_ROTATE) {
        if (key_pressed(K_LEFT))  { ed_mark3d(); ed_rotate3d(sel, get3yaw(sel) - 15.0); }
        if (key_pressed(K_RIGHT)) { ed_mark3d(); ed_rotate3d(sel, get3yaw(sel) + 15.0); }
    }
    if (_ed_mode3 == ED_MOVE) {
        if (key_pressed(K_UP))    { ed_mark3d(); ed_nudge3d(sel, 0.0, g, 0.0); }
        if (key_pressed(K_DOWN))  { ed_mark3d(); ed_nudge3d(sel, 0.0, 0.0 - g, 0.0); }
    }
    if (key_pressed(K_SPACE)) { ed_mark3d(); ed_drop3d(sel); }
}

func _s3_editor(dt) {
    if (_ed_msg_t3 > 0.0) { _ed_msg_t3 = _ed_msg_t3 - dt; }
    if (_ed_confirm3 > 0.0) { _ed_confirm3 = _ed_confirm3 - dt; }
    _s3_editor_look(dt);
    // Bir sayı alanına YAZILIYORSA klavye oraya ait: "duvar genişliği 3" yazmak
    // kamerayı uçurmamalı, "d" harfi de varlığı çoğaltmamalı.
    if (_g_focus3 == 0) {
        _s3_editor_fly(dt);
        _s3_editor_keys();
    }
    _s3_editor_mouse(dt);
}

// ---- 4) ÇİZİM --------------------------------------------------------------
// Izgara ve seçim çerçevesi. Seçim TEL KAFES: dolu bir kutu varlığı örterdi.
func _s3_editor_draw() {
    if (_ed_grid3 > 0.0) { grid(60, _ed_grid3 * 4.0); }
    else { grid(60, 2.0); }
    // Üzerine gelinen varlık soluk bir çerçeveyle: tıklamadan önce neyi
    // seçeceğini göstermek. Seçili olanla aynıysa çizilmiyor (seçim zaten
    // parlak çerçeveli).
    int hs = _slot_of3(_ed_hover3);
    if (hs >= 0 && _ed_hover3 != _ed_sel3e) {
        Ent3 he = _e3[hs];
        cube_wires(he.x, he.y, he.z, he.sx + 0.04, he.sy + 0.04, he.sz + 0.04,
                   rgb(150, 170, 200));
    }
    // Kümedeki diğer seçimler daha soluk bir çerçeveyle: birincil ile
    // ötekileri ayırmak "hangisi tutamakların sahibi?" sorusunu cevaplıyor.
    int mi = 0;
    while (mi < length(_ed_msel3)) {
        int ms = _slot_of3(_ed_msel3[mi]);
        if (ms >= 0 && _ed_msel3[mi] != _ed_sel3e) {
            Ent3 me = _e3[ms];
            cube_wires(me.x, me.y, me.z, me.sx + 0.05, me.sy + 0.05, me.sz + 0.05,
                       rgb(200, 170, 60));
        }
        mi = mi + 1;
    }
    int s = _slot_of3(_ed_sel3e);
    if (s < 0) {
        // Varlık yoksa BÖLGE seçili olabilir: onun da tutamakları var.
        if (_ed_tab3 == 2) { _gz_zone_draw3(_ed_zsel3); }
        return;
    }
    Ent3 e = _e3[s];
    // Kenarı bir tık şişir ki cismin yüzeyiyle z-savaşı yapmasın.
    cube_wires(e.x, e.y, e.z, e.sx + 0.06, e.sy + 0.06, e.sz + 0.06, rgb(255, 220, 60));
    // Yere iz düşümü: yüksekliği okumak 3B'de gözle zor.
    float fy = _floor_at3(e.x, e.z) + 0.02;
    cube_wires(e.x, fy, e.z, e.sx, 0.02, e.sz, rgb(255, 160, 40));
    line3d(e.x, fy, e.z, e.x, e.y, e.z, rgb(255, 160, 40));
    _gz_draw3(s);
}

func _s3_editor_hud() {
    if (_ed_chrome3_on() == false) { return; }
    _ed_chrome3();
}


// ===========================================================================
// ARAYÜZ — anlık kip parçacıklar (Faz 13)
// ===========================================================================
// Editörün panelleri için küçük bir "immediate mode" araç seti. Kalıcı widget
// nesnesi yok: her kare yeniden çiziliyor ve tıklama aynı çağrıda dönüyor.
// Saklanan tek şey odak/sürükleme gibi JESTLER — onlar zaten kareler arası.
//
// Widget kimliği çağıran tarafından verilen bir tamsayı. Otomatik sayaç
// kullanmak, liste uzunluğu değişince kimlikleri kaydırırdı (yanlış alan
// odakta kalırdı).
int   _g_hot3   = 0;
int   _g_act3   = 0;
int   _g_focus3 = 0;      // yazılmakta olan sayı alanı
str   _g_buf3   = "";
float _g_dv3    = 0.0;    // sürüklemenin başladığı andaki değer
int   _g_dx3    = 0;
int   _g_moved3 = 0;
int   _g_mx3 = 0; int _g_my3 = 0;
int   _g_down3 = 0; int _g_press3 = 0; int _g_rel3 = 0;

// ---- Yazı tipi: NEDEN yalnız 10 ve 20 ------------------------------------
// raylib'in varsayılan yazı tipi 10 piksel tabanlı bir bitmap. `DrawText`
// içinde harf aralığı `fontSize/10` ile TAMSAYI bölmesinden, glif ölçeği ise
// `fontSize/10.0` ile KESİRLİ bölmeden geliyor. Yani 13 punto istersen
// glifler 1.3 kat büyür ama aralık 1 pikselde kalır — harfler birbirine
// girer. İlk sürümde 12/13/14/15 kullanılmıştı ve ekranda tam olarak bu
// görülüyordu ("yazılar üst üste gelmiş gibi").
//
// Yalnız 10 ve 20 ikisini de tam sayı yapıyor (1.0 ölçek / 1 aralık ve
// 2.0 / 2). Arayüz baştan sona 10 punto; başlıklar puntoyla değil RENK ve
// zemin şeridiyle ayrılıyor — Godot ve Unity'nin panel başlıkları da
// gövdeden belirgin biçimde büyük değil.
// Arayüz ÖLÇEĞİ. Yazı tipi yalnız 10/20/30'da net olduğu için ara boy yok;
// bunun yerine BÜTÜN arayüz aynı katsayıyla ölçekleniyor. 1x küçük ekran,
// 2x varsayılan (10 punto modern bir ekranda okunamayacak kadar küçük
// kalıyordu), 3x yüksek DPI.
//
// Ölçek değişince paneller de genişliyor: yalnız puntoyu büyütmek metni
// panelden taşırırdı, çünkü sütun genişlikleri panel genişliğinden türüyor.
int _ed_ui3 = 2;
int _F3 = 20;

// ---- Okunabilir yazı tipi --------------------------------------------------
// raylib'in varsayılan fontu 10 piksel tabanlı bir BITMAP: ölçeklenince
// pikselleşiyor ve uzun süre bakılan bir editör arayüzünde yorucu. Gerçek bir
// TTF hem her boyda net, hem de Türkçe harfleri doğru veriyor.
//
// Font DOSYADAN yükleniyor ve depoya gömülmüyor: iyi bir UI fontu ~600 KB ve
// ikiliye gömmek onu her oyuna taşırdı (editör kullanmayan oyunlara da).
// Bulunamazsa varsayılan fonta düşülüyor — editör her hâlükârda açılmalı.
int _ed_font3 = 0 - 1;
str _ed_font_path3 = "";

// Aday yollar: dağıtımlar fontları farklı yerlere koyuyor.
func _ed_font_load3() {
    // İLK SIRADA varlık-göreli adlar. Web'de sistem font dizini YOK; oradaki
    // tek yol fontu `TULPAR_WEB_ASSETS` ile pakete koymaktır ve bu üç ad da
    // o paketin içindeki bir dosyaya denk gelir. Masaüstünde bu adlar normalde
    // yok — `file_exists` koruyor, yani davranış değişmiyor; bir oyun kendi
    // fontunu yanına koymuşsa da o kazanıyor ki istenen de bu.
    array yollar = ["assets/ui.ttf",
                    "fonts/ui.ttf",
                    "ui.ttf",
                    "/usr/share/fonts/noto/NotoSans-Regular.ttf",
                    "/usr/share/fonts/TTF/DejaVuSans.ttf",
                    "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
                    "/usr/share/fonts/liberation/LiberationSans-Regular.ttf",
                    "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf",
                    "/usr/share/fonts/Adwaita/AdwaitaSans-Regular.ttf",
                    "/Library/Fonts/Arial.ttf"];
    if (_ed_font_path3 != "") {
        _ed_font3 = load_font(_ed_font_path3, _F3);
        if (_ed_font3 >= 0) { return; }
    }
    int i = 0;
    while (i < length(yollar)) {
        if (file_exists(yollar[i])) {
            int f = load_font(yollar[i], _F3);
            if (f >= 0) {
                _ed_font3 = f;
                _ed_font_path3 = yollar[i];
                kayit3d("yazi tipi: " + yollar[i] + " (" + toString(_F3) + " punto)");
                return;
            }
        }
        i = i + 1;
    }
    _ed_font3 = 0 - 1;
    // Sessizce bitmap fonta düşmek "editör neden çirkin?" sorusunu cevapsız
    // bırakırdı; konsolda söyleniyor. Web'de sebep FARKLI (sistem fontu diye
    // bir şey yok) ve çaresi de farklı, o yüzden mesaj da farklı.
    uyari3d("okunabilir yazi tipi bulunamadi — varsayilan bitmap font");
    if (web_mi()) {
        uyari3d("web: fontu pakete koy — TULPAR_WEB_ASSETS=<dizin>, ad: ui.ttf");
    }
}

// Kendi fontunu ver (editörden önce çağrılır).
func editor_font3d(path) { _ed_font_path3 = path; }
func editor_yazitipi3d(yol) { editor_font3d(yol); }

// Çizim ve ölçüm TEK kapıdan: font yüklüyse TTF, değilse varsayılan bitmap.
// İkisinin ayrı yollardan gitmesi, ölçümün çizimden sapmasına ve yerleşimin
// sessizce kaymasına yol açardı.

// Satır yüksekliği ve dikey merkez ÖLÇEKTEN türüyor. Elle yazılmış sabitler
// (y + 3, r * 12) 1x tasarımının değerleriydi: 2x'te font 20 piksel ama satır
// aralığı 12 kalıyordu, yani ARDIŞIK SATIRLAR 8 piksel ÜST ÜSTE BİNİYORDU.
// Kullanıcının gördüğü "iç içe geçmiş yazı" tam olarak buydu — widget
// dikdörtgenleri çakışmadığı için çakışma dedektörü de sessiz kalıyordu.
func _g_lh3(): int { return _F3 + _us3(4); }          // satır yüksekliği
func _g_cy3(h): int { return toInt((h - _F3) / 2); }  // kutuda dikey merkez
// Alan yüksekliğindeki bir satırda etiketin dikey merkezi.
func _g_ly3(y): int { return y + _g_cy3(_ED_FLD3); }

func _g_draw3(t, x, y, size, col) {
    if (_ed_font3 >= 0) { text_font(_ed_font3, t, x, y, size, col); }
    else { text(t, x, y, size, col); }
}
func _g_w3(t, size): int {
    if (_ed_font3 >= 0) { return font_width(_ed_font3, t, size); }
    return text_width(t, size);
}

// Metin genişliğinin KARAKTER TABANLI tahmini. `_g_w3` pencere yokken 0
// döner (Tuzaklar 3) ve 0'a göre kurulan bir yerleşim testte "her şey
// sığıyor" der. Katsayı ölçülmüş: `_F3 = 20`'de karakter başına ~11.5 px,
// yani `_F3 * 23 / 40`.
func _g_estw3(s): int { return toInt(length(s) * _F3 * 23 / 40); }

// Yerleşim ölçüsü ikisinin BÜYÜĞÜ: pencereyle gerçek genişlik, penceresiz
// tahmin. Gerçek yazı tipi tahminden dar çıkarsa menü bir tutam geniş olur —
// hesabı penceresiz sınanamaz yapmaktan iyidir.
func _g_wmax3(s): int {
    int a = _g_w3(s, _F3);
    int b = _g_estw3(s);
    if (a > b) { return a; }
    return b;
}

// Ölçeğe göre büyütülmüş piksel değeri. Panel içindeki bütün sabitler 1x
// tasarımının değerleri; buradan geçince ölçek uyumlu oluyorlar.
func _us3(v): int { return v * _ed_ui3; }

// Ölçüler tek bir yerden türüyor; panellerin içindeki hiçbir konum elle
// yazılmış mutlak sayı değil (ilk sürümde öyleydi ve üç yerde taşıyordu:
// alt yardım satırı 434 piksel, araç çubuğu durum metni KAYDET düğmesinin
// üstüne, davranış satırı inspector panelinin dışına).
int _ED_TOOL_H3 = 48;
int _ED_L_W3 = 228;
int _ED_R_W3 = 304;
int _ED_ROW3    = 28;    // liste satırı
int _ED_FLD3    = 32;    // alan/düğme yüksekliği
int _ED_PAD3    = 12;
int _ed_hscroll3 = 0;

// Ölçeği uygula — bütün şerit/panel ölçüleri buradan türüyor. Tek tek elle
// ayarlamak, birini unutunca sessizce taşan bir yerleşim demekti.
func editor_ui_scale3d(k) {
    int n = k;
    if (n < 1) { n = 1; }
    if (n > 3) { n = 3; }
    int eski = _ed_ui3;
    _ed_ui3 = n;
    _F3         = 10 * n;
    _ED_PAD3    =  6 * n;
    _ED_FLD3    = 16 * n;
    _ED_ROW3    = 14 * n;
    _ED_MENU_H3 = 20 * n;
    _ED_TOOL_H3 = 24 * n;
    _ED_STAT_H3 = 18 * n;
    // Konsol ve paneller ölçekle DOĞRU ORANTILI büyümüyor: 3x'te ekranın
    // yarısını yerlerdi. Sabit bir taban + ölçek payı.
    // Konsol yüksekliği SATIR SAYISINDAN türüyor: sabit bir taban 3x ölçekte
    // tek satır gösterebiliyordu ve tek satırlık konsol işe yaramıyor.
    // (satır yüksekliği = 10n + 4n = 14n) * 3 satır + başlık/pay.
    // Paneller ölçekle büyüyor ama DOĞRU ORANTILI değil: 3x'te ikisi birden
    // editör penceresinin yarısını yerdi. Sabit taban + ölçek payı, ve toplam
    // 720'nin (1440'ın yarısı) altında kalıyor — bir test bunu koruyor.
    //
    // ÖZELLEŞTİRME KORUNUYOR: kullanıcı sınırı sürüklediyse ölçek değişimi
    // onun oranını taşıyor, varsayılana geri atmıyor. Atmak "kendi
    // yerleşimini kullanabilsin" isteğinin tam tersi olurdu.
    _ED_B_H3 = _ed_lay_rescale3(_ED_B_H3, _ed_lay_def_bh3(eski),
                                   _ed_lay_def_bh3(n));
    _ED_L_W3 = _ed_lay_rescale3(_ED_L_W3, _ed_lay_def_lw3(eski),
                                   _ed_lay_def_lw3(n));
    _ED_R_W3 = _ed_lay_rescale3(_ED_R_W3, _ed_lay_def_rw3(eski),
                                   _ed_lay_def_rw3(n));
    // Kaydırmalar bayatlamasın.
    _ed_hscroll3 = 0;
    _ed_iscroll3 = 0;
    // TTF hedef boyda rasterize ediliyor; eski boyda yüklenmiş fontu
    // ölçeklemek bulanıklaştırırdı.
    _ed_font_load3();
}
func editor_ui_olcek3d(k) { editor_ui_scale3d(k); }
func editor_ui_scale_now3d(): int { return _ed_ui3; }

func _G_BG3(): int    { return rgba(24, 26, 32, 242); }
func _G_HEAD3(): int  { return rgb(38, 42, 52); }
func _G_LINE3(): int  { return rgb(54, 60, 72); }
func _G_BTN3(): int   { return rgb(52, 58, 70); }
func _G_BTNH3(): int  { return rgb(70, 78, 94); }
func _G_BTNA3(): int  { return rgb(74, 118, 176); }
func _G_TXT3(): int   { return rgb(206, 214, 226); }
func _G_DIM3(): int   { return rgb(132, 142, 158); }
func _G_ACC3(): int   { return rgb(255, 198, 78); }
func _G_SEL3(): int   { return rgb(48, 84, 128); }
func _G_FLD3(): int   { return rgb(32, 36, 44); }
// Uyarı: hata değil ama "buna bak". Sahne denetimi ve yüklenemeyen varlık
// aynı rengi kullanıyor — ikisi de aynı şeyi söylüyor.
func _G_WARN3(): int  { return rgb(240, 190, 110); }

// ---- Metin: her şey ÖLÇÜLEREK yerleştiriliyor -----------------------------
// Sabit karakter genişliği varsaymak bu yazı tipinde yanlış (değişken
// genişlikli) ve taşmanın kaynağıydı.
func _g_fit3(s, maxw): str {
    if (_g_w3(s, _F3) <= maxw) { return s; }
    int n = length(s);
    while (n > 1) {
        str t = substring(s, 0, n) + ".";
        if (_g_w3(t, _F3) <= maxw) { return t; }
        n = n - 1;
    }
    return "";
}
// Sığmayan metin kesiliyor — panelden taşmak yerine kısalıyor.
// Düz METİN de çakışma denetimine giriyor. Dedektör önce yalnız widget
// kutularını kaydediyordu ve tam bu yüzden SESSİZ kalmıştı: kutular
// çakışmıyordu ama içlerindeki ve yanlarındaki yazılar birbirine giriyordu.
// Kimlikler 30000+ aralığında, yani konsolda "metin mi widget mı" ayırt
// edilebiliyor.
int _g_tid3 = 30000;

func _g_txt3(s, x, y, maxw, c) {
    str t = _g_fit3(s, maxw);
    if (t != "") {
        _g_rect3(_g_tid3, x, y, _g_w3(t, _F3), _F3);
        _g_tid3 = _g_tid3 + 1;
    }
    _g_draw3(t, x, y, _F3, c);
}
// Sağ kenara hizalı (rx = sağ kenar). Ölçmeden hizalamak imkânsız.
func _g_txtr3(s, rx, y, c) { _g_draw3(s, rx - _g_w3(s, _F3), y, _F3, c); }
// Bir kutunun içinde ortalanmış.
func _g_txtc3(s, x, y, w, h, c) {
    str t = _g_fit3(s, w - 6);
    _g_draw3(t, x + toInt((w - _g_w3(t, _F3)) / 2), y + _g_cy3(h), _F3, c);
}
// Etiketi olan bir düğmenin doğal genişliği.
func _g_btnw3(label): int { return _g_w3(label, _F3) + _us3(14); }

// Araç ipucu. Kısaltılmış etiketler ("kure", "toh", "arlk") tek başına
// anlaşılmıyor; her editörde üzerine gelince ne olduğunu söyleyen bir kutu var.
// Widget imzalarını değiştirmek yerine çağrıdan SONRA soruluyor: `_g_hot3`
// zaten imlecin altındaki widget'ı tutuyor.
str _g_tip3 = "";

func _g_tip_for3(id, txt) {
    if (_g_hot3 == id) { _g_tip3 = txt; }
}

func _g_tip_draw3() {
    if (_g_tip3 == "") { return; }
    int w = _g_w3(_g_tip3, _F3) + _us3(10);
    int h = _F3 + _us3(8);
    int x = _g_mx3 + _us3(12);
    int y = _g_my3 + _us3(16);
    // Ekran kenarına sığdır — ipucunun kendisi ekrandan taşarsa okunmaz.
    if (x + w > screen_width()) { x = screen_width() - w - 2; }
    if (y + h > screen_height()) { y = _g_my3 - h - _us3(6); }
    rect(x, y, w, h, rgba(12, 14, 20, 240));
    rect_lines(x, y, w, h, _G_ACC3());
    _g_draw3(_g_tip3, x + _us3(5), y + _us3(4), _F3, _G_TXT3());
}

// ---- Çakışma dedektörü -----------------------------------------------------
// "Arayüz elemanları üst üste gelmesin" tek tek yerleşim formülü sınayarak
// GARANTİ EDİLEMEZ: her yeni widget yeni bir formül, ve içerik (metin
// genişliği, ölçek, pencere boyutu) değiştikçe eski formüller kayabiliyor.
//
// Bunun yerine arayüzün KENDİSİ denetliyor: her widget dikdörtgenini
// kaydediyor, kare sonunda ikili kesişim aranıyor. Çakışma varsa hem konsola
// yazılıyor hem de suçlu dikdörtgenler KIRMIZI çerçeveyle ekranda
// gösteriliyor — sessiz kalması, sorunun yeniden gözle bulunmasını
// gerektirirdi.
array _g_qx3 = [];
array _g_qy3 = [];
array _g_qw3 = [];
array _g_qh3 = [];
array _g_qi3 = [];
int _g_ovl_n3 = 0;      // son karede bulunan çakışma sayısı
int _g_ovl_on3 = 1;     // denetim açık mı (kapatmak için: editor_cakisma3d(false))

func editor_overlap_check3d(on) { if (on) { _g_ovl_on3 = 1; } else { _g_ovl_on3 = 0; } }
func editor_cakisma3d(ac) { editor_overlap_check3d(ac); }
func editor_overlap_count3d(): int { return _g_ovl_n3; }

// Yürürlükteki KIRPMA dikdörtgeni. `kirp`/`kirp_bitir` yalnız ÇİZİMİ
// kırpıyordu; widget kuyruğu ve fare denetimi bundan habersizdi. İki sessiz
// hata birden çıkıyordu (kullanıcı ekran görüntüsüyle bildirdi):
//   • Kaydırılıp başlığın altına giren widget'lar hâlâ kuyruğa giriyor ve
//     çakışma dedektörü onları KIRMIZI kutularla çiziyordu — üstelik o
//     kutular kırpmanın dışında çizildiği için panelin dışına taşıyordu.
//   • Görünmeyen widget hâlâ TIKLANABİLİYORDU: başlığın altına kaymış bir
//     düğme, başlığa yapılan tıklamayı yiyordu.
int _g_clip_on3 = 0;
int _g_clip_x3 = 0;
int _g_clip_y3 = 0;
int _g_clip_w3 = 0;
int _g_clip_h3 = 0;

func _g_clip3(x, y, w, h) {
    _g_clip_on3 = 1;
    _g_clip_x3 = x; _g_clip_y3 = y; _g_clip_w3 = w; _g_clip_h3 = h;
    kirp(x, y, w, h);
}
func _g_clip_end3() {
    _g_clip_on3 = 0;
    kirp_bitir();
}

// Dikdörtgen kırpma alanına DEĞİYOR mu (kısmen de olsa). Çakışma denetimi
// için doğru ölçü bu: yarısı görünen bir widget gerçekten çakışabilir.
func _g_clip_touches3(x, y, w, h): bool {
    if (_g_clip_on3 == 0) { return true; }
    return _g_overlap_rect3(x, y, w, h,
                            _g_clip_x3, _g_clip_y3, _g_clip_w3, _g_clip_h3);
}

func _g_rect3(id, x, y, w, h) {
    if (_g_ovl_on3 == 0) { return; }
    // Kırpma alanının TÜMÜYLE dışındaki widget çizilmiyor; çakışma
    // denetimine girmesi de anlamsız — göze görünmeyen bir çakışma yok.
    if (_g_clip_touches3(x, y, w, h) == false) { return; }
    push(_g_qx3, x); push(_g_qy3, y);
    push(_g_qw3, w); push(_g_qh3, h);
    push(_g_qi3, id);
}

// İki dikdörtgen kesişiyor mu? Kenar teması çakışma DEĞİL — yan yana dizilmiş
// düğmeler tam bitişik olabiliyor.
func _g_overlap_rect3(ax, ay, aw, ah, bx, by, bw, bh): bool {
    if (ax + aw <= bx) { return false; }
    if (bx + bw <= ax) { return false; }
    if (ay + ah <= by) { return false; }
    if (by + bh <= ay) { return false; }
    return true;
}

// Bir dikdörtgen diğerini TAMAMEN içeriyor mu? Widget'ın kendi etiketi
// kutusunun içinde duruyor ve bu bir çakışma değil — onu saymak dedektörü
// her karede yüzlerce sahte uyarıyla kullanılamaz yapardı.
func _g_contains_rect3(ax, ay, aw, ah, bx, by, bw, bh): bool {
    return bx >= ax && by >= ay && bx + bw <= ax + aw && by + bh <= ay + ah;
}

// TESPİT ile RAPORLAMA ayrı: tespit saf (yalnız sayar), raporlama çizer ve
// kaydeder. Birleşik olduklarında tespit penceresiz sınanamıyordu — bu
// oturumda "sınanamayan yerdeki hata" defalarca tekrarlandı.
//
// `report` 0 ise hiçbir şey çizilmiyor/kaydedilmiyor; testler bu yolu
// kullanıyor.
func _g_count_overlaps3(report): int {
    int cnt = 0;
    int n = length(_g_qi3);
    int i = 0;
    while (i < n) {
        int j = i + 1;
        while (j < n) {
            int kapsiyor = 0;
            if (_g_contains_rect3(_g_qx3[i], _g_qy3[i], _g_qw3[i], _g_qh3[i],
                                  _g_qx3[j], _g_qy3[j], _g_qw3[j], _g_qh3[j])) { kapsiyor = 1; }
            if (_g_contains_rect3(_g_qx3[j], _g_qy3[j], _g_qw3[j], _g_qh3[j],
                                  _g_qx3[i], _g_qy3[i], _g_qw3[i], _g_qh3[i])) { kapsiyor = 1; }
            if (kapsiyor == 0 &&
                _g_overlap_rect3(_g_qx3[i], _g_qy3[i], _g_qw3[i], _g_qh3[i],
                                 _g_qx3[j], _g_qy3[j], _g_qw3[j], _g_qh3[j])) {
                cnt = cnt + 1;
                if (report == 1) {
                    // Kırmızı çerçeve: konsolu okumadan da görülsün.
                    rect_lines(_g_qx3[i], _g_qy3[i], _g_qw3[i], _g_qh3[i], rgb(255, 60, 60));
                    rect_lines(_g_qx3[j], _g_qy3[j], _g_qw3[j], _g_qh3[j], rgb(255, 60, 60));
                    _lg_once(LOG_WARN,
                             "ovl" + toString(_g_qi3[i]) + "_" + toString(_g_qi3[j]),
                             "ARAYUZ CAKISMASI: " + toString(_g_qi3[i]) + " ile " +
                             toString(_g_qi3[j]), 3.0);
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return cnt;
}

func _g_check_overlaps3() {
    _g_ovl_n3 = 0;
    if (_g_ovl_on3 == 0) { return; }
    _g_ovl_n3 = _g_count_overlaps3(1);
}

func _g_begin() {
    _g_tip3 = "";
    _g_qx3 = []; _g_qy3 = []; _g_qw3 = []; _g_qh3 = []; _g_qi3 = [];
    _g_tid3 = 30000;
    _g_mx3 = mouse_x(); _g_my3 = mouse_y();
    int d = 0;
    if (mouse_down(0)) { d = 1; }
    _g_press3 = 0;
    if (mouse_pressed(0)) { _g_press3 = 1; }
    _g_rel3 = 0;
    if (_g_down3 == 1 && d == 0) { _g_rel3 = 1; }
    _g_down3 = d;
    _g_hot3 = 0;
}

func _g_in(x, y, w, h): bool {
    // FARE kırpma alanının dışındaysa hiçbir kırpılmış widget'a değemez.
    // Ölçü İMLECİN yeri, widget'ın kısmen görünür olması değil: başlığın
    // altına kaymış bir düğmenin görünmeyen yarısına tıklanamamalı.
    if (_g_clip_on3 == 1) {
        if (_g_mx3 < _g_clip_x3 || _g_mx3 >= _g_clip_x3 + _g_clip_w3) { return false; }
        if (_g_my3 < _g_clip_y3 || _g_my3 >= _g_clip_y3 + _g_clip_h3) { return false; }
    }
    return _g_mx3 >= x && _g_mx3 < x + w && _g_my3 >= y && _g_my3 < y + h;
}

// Panel: ince başlık şeridi, punto DEĞİŞMİYOR — ayrım renkte.
func _g_panel(x, y, w, h, title) {
    rect(x, y, w, h, _G_BG3());
    rect(x, y, w, _us3(16), _G_HEAD3());
    rect_lines(x, y, w, h, _G_LINE3());
    _g_txt3(title, x + _ED_PAD3, y + _g_cy3(_us3(16)), w - _ED_PAD3 * 2, _G_ACC3());
}

// Panel içinde bir bölüm başlığı.
func _g_section(x, y, w, title) {
    line(x, y, x + w, y, _G_LINE3());
    _g_txt3(title, x + _us3(2), y + _us3(4), w - _us3(4), _G_ACC3());
}

func _g_button(id, x, y, w, h, label): bool {
    _g_rect3(id, x, y, w, h);
    bool over = _g_in(x, y, w, h);
    if (over) { _g_hot3 = id; }
    if (over && _g_press3 == 1) { _g_act3 = id; }
    bool clicked = false;
    if (_g_act3 == id && _g_rel3 == 1) {
        if (over) { clicked = true; }
        _g_act3 = 0;
    }
    int c = _G_BTN3();
    if (over) { c = _G_BTNH3(); }
    if (_g_act3 == id) { c = _G_BTNA3(); }
    rect(x, y, w, h, c);
    rect_lines(x, y, w, h, _G_LINE3());
    _g_txtc3(label, x, y, w, h, _G_TXT3());
    return clicked;
}

func _g_tog(id, x, y, w, h, label, on): bool {
    _g_rect3(id, x, y, w, h);
    bool over = _g_in(x, y, w, h);
    if (over) { _g_hot3 = id; }
    bool clicked = false;
    if (over && _g_press3 == 1) { _g_act3 = id; }
    if (_g_act3 == id && _g_rel3 == 1) {
        if (over) { clicked = true; }
        _g_act3 = 0;
    }
    int c = _G_BTN3();
    if (on) { c = _G_BTNA3(); }
    if (over && on == false) { c = _G_BTNH3(); }
    rect(x, y, w, h, c);
    rect_lines(x, y, w, h, _G_LINE3());
    _g_txtc3(label, x, y, w, h, _G_TXT3());
    return clicked;
}

// Sayı alanı: SÜRÜKLE tarar, TIKLA yazmaya geçer.
// Alanı YAZARAK düzenlemek de geri alınabilir olmalı. Sürükleme yolu jestin
// başında zaten işaret bırakıyordu (`_g_moved3` 0→1); yazma yolu HİÇ
// bırakmıyordu, yani aynı alanın iki düzenleme yolundan biri geri
// alınamıyordu ve bunu söyleyen hiçbir şey yoktu. Belirti sinsi: CTRL+Z
// çalışıyor gibi görünür ama BİR ÖNCEKİ işi geri alır, yazdığın değer
// geçmişte hiç yer almadan kaybolur.
//
// İşaret yalnız değer GERÇEKTEN değiştiyse bırakılıyor: alana girip aynı
// sayıyı yazmak (ya da tıklayıp çıkmak) 40'lık geçmişi boş adımlarla
// doldurur ve geri alma tuşunu işe yaramaz hâle getirirdi.
func _g_num_commit3(val, buf): float {
    float yeni = toFloat(buf);
    if (yeni != val) { ed_mark3d(); }
    return yeni;
}

func _g_num(id, x, y, w, h, val, step): float {
    float out = val * 1.0;
    _g_rect3(id, x, y, w, h);
    bool over = _g_in(x, y, w, h);
    if (over) { _g_hot3 = id; }

    if (_g_focus3 == id) {
        int ch = char_pressed();
        while (ch > 0) {
            if (ch >= 32 && ch < 127) { _g_buf3 = _g_buf3 + _g_chr3(ch); }
            ch = char_pressed();
        }
        if (key_pressed(K_BACKSPACE) && length(_g_buf3) > 0) {
            _g_buf3 = substring(_g_buf3, 0, length(_g_buf3) - 1);
        }
        if (key_pressed(K_ENTER)) { out = _g_num_commit3(val, _g_buf3); _g_focus3 = 0; }
        // ESC İPTAL: değer yazılmıyor, yani işaret de bırakılmıyor.
        if (key_pressed(K_ESC)) { _g_focus3 = 0; }
        if (_g_press3 == 1 && over == false) {
            out = _g_num_commit3(val, _g_buf3); _g_focus3 = 0;
        }
        rect(x, y, w, h, rgb(28, 38, 54));
        rect_lines(x, y, w, h, _G_ACC3());
        _g_txt3(_g_buf3 + "_", x + _us3(3), y + _g_cy3(h), w - _us3(6), _G_TXT3());
        return out;
    }

    if (over && _g_press3 == 1) {
        _g_act3 = id; _g_dv3 = val * 1.0; _g_dx3 = _g_mx3; _g_moved3 = 0;
    }
    if (_g_act3 == id && _g_down3 == 1) {
        int dd = _g_mx3 - _g_dx3;
        if (dd > 3 || dd < 0 - 3) {
            if (_g_moved3 == 0) { ed_mark3d(); }
            _g_moved3 = 1;
        }
        if (_g_moved3 == 1) { out = _g_dv3 + dd * step; }
    }
    if (_g_act3 == id && _g_rel3 == 1) {
        if (_g_moved3 == 0 && over) { _g_focus3 = id; _g_buf3 = _sc_num3(val); }
        _g_act3 = 0;
    }
    int c = _G_FLD3();
    if (over) { c = rgb(42, 48, 60); }
    rect(x, y, w, h, c);
    rect_lines(x, y, w, h, _G_LINE3());
    _g_txt3(_sc_num3(out), x + _us3(3), y + _g_cy3(h), w - _us3(6), _G_TXT3());
    return out;
}

// Metin alanı. Sayı alanının aksine sürükleme yok — tıkla, yaz, Enter.
// Odak yönetimi `_g_num` ile AYNI değişkenleri kullanıyor (`_g_focus3`,
// `_g_buf3`): iki ayrı odak durumu tutmak, ikisinin aynı anda odaklı kalmasına
// izin verirdi.
func _g_text(id, x, y, w, h, val): str {
    str out = val;
    _g_rect3(id, x, y, w, h);
    bool over = _g_in(x, y, w, h);
    if (over) { _g_hot3 = id; }
    if (_g_focus3 == id) {
        int ch = char_pressed();
        while (ch > 0) {
            if (ch >= 32 && ch < 127) { _g_buf3 = _g_buf3 + _g_chr3(ch); }
            ch = char_pressed();
        }
        if (key_pressed(K_BACKSPACE) && length(_g_buf3) > 0) {
            _g_buf3 = substring(_g_buf3, 0, length(_g_buf3) - 1);
        }
        if (key_pressed(K_ENTER)) { out = _g_buf3; _g_focus3 = 0; }
        if (key_pressed(K_ESC)) { _g_focus3 = 0; }
        if (_g_press3 == 1 && over == false) { out = _g_buf3; _g_focus3 = 0; }
        rect(x, y, w, h, rgb(28, 38, 54));
        rect_lines(x, y, w, h, _G_ACC3());
        _g_txt3(_g_buf3 + "_", x + _us3(3), y + _g_cy3(h), w - _us3(6), _G_TXT3());
        return out;
    }
    if (over && _g_press3 == 1) { _g_focus3 = id; _g_buf3 = val; }
    int c = _G_FLD3();
    if (over) { c = rgb(42, 48, 60); }
    rect(x, y, w, h, c);
    rect_lines(x, y, w, h, _G_LINE3());
    str show = val;
    if (show == "") { show = "(adsiz)"; }
    _g_txt3(show, x + _us3(3), y + _g_cy3(h), w - _us3(6), _G_TXT3());
    return out;
}

func _g_item(id, x, y, w, h, label, sel): bool {
    _g_rect3(id, x, y, w, h);
    bool over = _g_in(x, y, w, h);
    if (over) { _g_hot3 = id; }
    bool clicked = false;
    if (over && _g_press3 == 1) { _g_act3 = id; }
    if (_g_act3 == id && _g_rel3 == 1) {
        if (over) { clicked = true; }
        _g_act3 = 0;
    }
    if (sel) { rect(x, y, w, h, _G_SEL3()); }
    else {
        if (over) { rect(x, y, w, h, rgb(40, 46, 58)); }
    }
    _g_txt3(label, x + _us3(4), y + _g_cy3(h), w - _us3(8), _G_TXT3());
    return clicked;
}

// ===========================================================================
// EDİTÖR PANELLERİ — araç çubuğu, hiyerarşi, inspector
// ===========================================================================
// Görüntü penceresi panellerin ARASINDA kalan dikdörtgen. Bütün yerleşim
// bundan türüyor; hiçbir panel içeriği mutlak sayıyla konumlanmıyor.
// ===========================================================================
// EDİTÖR UYGULAMASI — sektör standardı yerleşim (Faz 13)
// ===========================================================================
// İlk sürümde editör, çalışan oyunun ÜSTÜNE TAB ile açılan bir kaplamaydı ve
// bu yanlıştı: Unity/Unreal/Godot'ta editör UYGULAMADIR, oyun onun içindeki
// bir panelde koşar. "Oynat" bir kip değişimi değil, sahnenin bir kopyasını
// aynı pencerede çalıştırmak.
//
// Yerleşim:
//   menü şeridi
//   araç çubuğu           (Oynat/Dur ORTADA — Unity'nin imzası)
//   hiyerarşi | SAHNE GÖRÜNÜMÜ | özellikler
//   konsol
//   durum çubuğu
//
// Sahne görünümü bir RENDER TEXTURE. Doğrudan çizip kırpmak yetmezdi: kamera
// izdüşümü pencerenin en-boy oranını kullanır, görüntü ezik ve merkezi kaymış
// çıkardı. Dokuya çizince raylib izdüşümü hedefin boyutundan türetiyor.
int _ed_app3     = 0;    // editör uygulaması yerleşimi açık mı
int _ed_playing3 = 0;    // sahne görünümünde oyun koşuyor mu
int _ed_rt3      = 0 - 1;
int _ed_rtw3     = 0;
int _ed_rth3     = 0;

int _ED_MENU_H3 = 40;
// 2x ölçeğin varsayılanı — `_ed_lay_def_bh3(2)` ile AYNI olmak zorunda.
// 96 yazıyordu ve formül 132 veriyordu; fark görünmüyordu çünkü ilk
// `editor_ui_scale3d` çağrısı değeri eziyordu. Ölçek değişimi kullanıcının
// özelleştirmesini ORANLAYARAK taşımaya başlayınca fark yük taşır oldu:
// motor açılıştaki 96'yı "özelleştirilmiş" sanıp her ölçekte küçültüyordu
// (1x'te konsol üç satır yerine iki satır gösteriyordu — test yakaladı).
int _ED_B_H3 = 148;
int _ED_STAT_H3 = 36;

// İmleç kilidi kararı TEK yerde ve saf: döngünün içine gömülü olduğu sürece
// penceresiz sınanamıyordu ve bir hata tam buradan çıktı — editör sahneyi
// yörünge kamerasıyla açıyor, o da fare bakışını (yani imleç kilidini) istiyor,
// kilit de imleci GİZLİYOR. Editörde imleç kaybolunca panellere tıklanamıyordu.
//
// Editör kabuğu açıkken ASLA kilitlenmiyor — oynarken bile. Oyun içi fare
// bakışı o hâlde sağ tuş sürüklemesine düşüyor; alternatifi "DUR düğmesine
// ulaşamamak" olurdu ki daha kötü.
func _s3_want_lock3(): int {
    if (_s3_ui != UI_NONE || _game_over3 == 1) { return 0; }
    // DÜZENLERKEN imleç daima serbest: panellere tıklanacak.
    if (_ed_on3 == 1) { return 0; }
    // Editörde OYNARKEN oyun normal davranır — fare yakalanır, imleç gizlenir.
    // Kaçış kapısı ESC ve o DURDURUYOR; düzenlemeye dönünce yukarıdaki satır
    // imleci zaten serbest bırakıyor. Ayrı bir "oynarken imleç serbest"
    // durumu tutmak fazladan bir kip demekti ve simülasyon sürerken fareyi
    // bırakmak yarım bir davranıştı.
    return _cam_lock3;
}

func editor_app3d(on) {
    if (on) { _ed_app3 = 1; _ed_on3 = 1; } else { _ed_app3 = 0; }
}
func editor_uygulamasi3d(ac) { editor_app3d(ac); }
func editor_app_on3d(): bool { return _ed_app3 == 1; }
func ed_playing3d(): bool { return _ed_playing3 == 1; }

// ---- Yerleşim dikdörtgenleri ----------------------------------------------
// Hepsi pencere boyutundan türüyor; parametreli ikizleri penceresiz sınanıyor.
// ---- DOCK: panellerin yeri ---------------------------------------------------
// Paneller ekranın SABİT yerlerindeydi: hiyerarşi hep solda, özellikler hep
// sağda, konsol hep altta. Unity/Unreal'da her panel bir YUVAYA takılı ve
// yuvası değiştirilebilir; kapatılıp açılabilir.
//
// Model üç panel × dört yuva (kapalı dâhil). Bir yuvadaki paneller ORANI
// eşit paylaşıyor.
//
// YAPILMAYAN, açıkça: yuva içinde SIRALAMA (iki panel aynı yuvadaysa sıra
// panel kimliğinden geliyor), SEKME (üst üste değil, yan yana/alt alta) ve
// YÜZEN pencere. Üçü de ayrı bir pencere yöneticisi demek; buradaki model
// "alanları istediğim yere taşıyayım ve kapatayım" isteğinin karşılığı.
int PANEL_HIER3 = 0;    // hiyerarşi
int PANEL_INSP3 = 1;    // özellikler
int PANEL_CONS3 = 2;    // konsol
func _dk_n3(): int { return 3; }

int DOCK_OFF3    = 0;   // kapalı — hiç çizilmiyor, yer kaplamıyor
int DOCK_LEFT3   = 1;
int DOCK_RIGHT3  = 2;
int DOCK_BOTTOM3 = 3;

// Panel → yuva. Varsayılan, eski sabit yerleşimin aynısı.
array _dk_slot3 = [DOCK_LEFT3, DOCK_RIGHT3, DOCK_BOTTOM3];

func _dk_slot_of3(p): int {
    if (p < 0 || p >= length(_dk_slot3)) { return DOCK_OFF3; }
    return _dk_slot3[p];
}
// Paneli yuvaya tak. Yuva GERÇEKTEN değiştiyse panelin payı hedef yuvanın
// ortalamasına çekiliyor — bu tek çoktan geçilen nokta (bırakma, kapatma,
// varsayılana dönüş, kayıttan okuma hepsi buradan geçiyor), yani kuralı
// çağıranlara dağıtmak onu birinde unutmak demekti.
func _dk_set_slot3(p, slot) {
    if (p < 0 || p >= length(_dk_slot3)) { return; }
    if (_dk_slot3[p] != slot && slot != DOCK_OFF3) {
        _dk_set_wt3(p, _dk_wt_fair3(slot));
    }
    _dk_slot3[p] = slot;
}
func panel_slot3d(p): int { return _dk_slot_of3(p); }
func panel_yuva3d(p): int { return _dk_slot_of3(p); }

// Yuva döngüsü KAPALI HALKA ve KAPALI durumu İÇERMİYOR: gizlemek ayrı bir
// düğme. Yer değiştirirken yanlışlıkla paneli kaybetmek, geri getirmenin
// yolunu aramak demek olurdu.
func _dk_next_slot3(slot): int {
    if (slot == DOCK_LEFT3)   { return DOCK_RIGHT3; }
    if (slot == DOCK_RIGHT3)  { return DOCK_BOTTOM3; }
    if (slot == DOCK_BOTTOM3) { return DOCK_LEFT3; }
    return DOCK_LEFT3;          // kapalıyken "taşı" onu geri açıyor
}

func _dk_slot_nm3(slot): str {
    if (slot == DOCK_LEFT3)   { return "sol"; }
    if (slot == DOCK_RIGHT3)  { return "sag"; }
    if (slot == DOCK_BOTTOM3) { return "alt"; }
    return "kapali";
}

func _dk_panel_nm3(p): str {
    if (p == PANEL_HIER3) { return "HIYERARSI"; }
    if (p == PANEL_INSP3) { return "OZELLIKLER"; }
    return "KONSOL";
}

// Bir yuvadaki AÇIK panel sayısı.
func _dk_count_in3(slot): int {
    if (slot == DOCK_OFF3) { return 0; }
    int n = 0;
    int i = 0;
    while (i < _dk_n3()) {
        if (_dk_slot_of3(i) == slot) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

// Panelin kendi yuvasındaki SIRASI (0 tabanlı). Sıra panel kimliğinden
// geliyor: ayrı bir sıra alanı tutmak, onu da sürükleyecek bir arayüz
// gerektirirdi ve iki panel için kazancı yok.
func _dk_index_in3(p): int {
    int slot = _dk_slot_of3(p);
    if (slot == DOCK_OFF3) { return 0 - 1; }
    int n = 0;
    int i = 0;
    while (i < p) {
        if (_dk_slot_of3(i) == slot) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

// ---- Yuva içi PAY ------------------------------------------------------------
// İki panel aynı yuvaya girince yuvayı yarı yarıya paylaşıyorlardı ve arasındaki
// sınır ÇEKİLEMİYORDU: konsolu hiyerarşinin altına koyan biri konsolu küçültemiyordu.
// Artık her panelin bir PAYI var; yuvadaki yer paylara göre bölünüyor.
//
// Pay ORANDIR, piksel değil — pencere büyüyünce paneller birlikte büyüyor ve
// oran korunuyor. Tam sayı tutuluyor (varsayılan 1000): kayıt biçimi zaten
// metin ve `toString(1.0)` bu dilde "1e+00" yazıyor, yani ondalık pay her
// kaydet/aç turunda okunamaz hâle gelirdi.
int _DK_WT_DEF3 = 1000;

array _dk_wt3 = [1000, 1000, 1000];

// Bozuk/sıfır pay bir paneli görünmez yapardı; okurken taban uygulanıyor.
func _dk_wt_of3(p): int {
    if (p < 0 || p >= length(_dk_wt3)) { return _DK_WT_DEF3; }
    int w = _dk_wt3[p];
    if (w < 1) { return 1; }
    return w;
}
func _dk_set_wt3(p, w) {
    if (p < 0 || p >= length(_dk_wt3)) { return; }
    if (w < 1) { w = 1; }
    _dk_wt3[p] = w;
}

func _dk_wsum_slot3(slot): int {
    int t = 0;
    int i = 0;
    while (i < _dk_n3()) {
        if (_dk_slot_of3(i) == slot) { t = t + _dk_wt_of3(i); }
        i = i + 1;
    }
    if (t < 1) { t = 1; }
    return t;
}
func _dk_wsum_before3(p): int {
    int slot = _dk_slot_of3(p);
    int t = 0;
    int i = 0;
    while (i < p) {
        if (_dk_slot_of3(i) == slot) { t = t + _dk_wt_of3(i); }
        i = i + 1;
    }
    return t;
}

// Yuvaya YENİ gelen panelin payı. Eşit bölüşen bir yuvaya gelen panel tam
// 1/k alsın diye ORTALAMA veriliyor: kendi eski payını taşısaydı, bir
// yuvada kenara sıkıştırılmış panel yeni yuvasına da kıymık olarak düşerdi
// (kullanıcı onu oraya GÖRMEK için taşıdı).
func _dk_wt_fair3(slot): int {
    int k = _dk_count_in3(slot);
    if (k < 1) { return _DK_WT_DEF3; }
    return toInt(_dk_wsum_slot3(slot) / k);
}

// Yuvanın kapladığı yer — BOŞ yuva sıfır yer kaplıyor, yani bütün panelleri
// kapatmak sahne görünümünü tam ekran yapıyor.
func _dk_lw3(): int {
    if (_dk_count_in3(DOCK_LEFT3) == 0) { return 0; }
    return _ED_L_W3;
}
func _dk_rw3(): int {
    if (_dk_count_in3(DOCK_RIGHT3) == 0) { return 0; }
    return _ED_R_W3;
}
func _dk_bh3(): int {
    if (_dk_count_in3(DOCK_BOTTOM3) == 0) { return 0; }
    return _ED_B_H3;
}

// Panelin dikdörtgeni. Tulpar'da çoklu dönüş yok; dörtlü global ile geliyor
// (motorun başka yerlerinde de aynı desen — bkz. `_ed_ray3`).
//
// Alt yuva TAM GENİŞLİK, yan yuvalar araç çubuğundan alt yuvaya kadar:
// konsolun bugüne kadarki davranışının genelleştirilmiş hâli.
int _dk_x3 = 0;
int _dk_y3 = 0;
int _dk_w3 = 0;
int _dk_h3 = 0;

// Yuvanın toplam uzunluğu (yan yuvalarda yükseklik, alt yuvada genişlik).
// Tek yerde: dikdörtgen hesabı da sınır sürüklemesi de buradan okuyor,
// ikisi ayrı yazılsaydı payın piksele çevrimi iki yerde ayrışabilirdi.
func _dk_slot_span3(slot, W, H): int {
    if (slot == DOCK_BOTTOM3) { return W; }
    int v = H - _ED_MENU_H3 - _ED_TOOL_H3 - _ED_STAT_H3 - _dk_bh3();
    if (v < 1) { v = 1; }
    return v;
}

func _dk_rect3(p, W, H): bool {
    int slot = _dk_slot_of3(p);
    if (slot == DOCK_OFF3) { return false; }
    int top = _ED_MENU_H3 + _ED_TOOL_H3;
    int bh = _dk_bh3();
    int yanh = _dk_slot_span3(slot, W, H);
    // Sınırlar PAYLARIN yığmalı toplamından: her panel kendi başlangıcını da
    // bitişini de aynı toplamdan okuyor — biri "genişlik", öteki "başlangıç"
    // hesaplasa yuvarlama farkı iki panelin arasında bir piksellik boşluk
    // bırakırdı.
    //
    // İLK ve SON panel için ÖZEL DURUM YOK ve gerekmiyor: `bef` sıfırdan
    // başlıyor, son panelde `bef + pay` tam olarak `tot` oluyor, yani
    // `toInt(T * tot / tot)` tam T veriyor. Eski (eşit bölen) hesap "son
    // panel artanı alır" satırına muhtaçtı; burada o satır ÖLÜ (bozma
    // denendi, hiçbir test kızarmadı — çünkü kızaracak bir davranış yok).
    int tot = _dk_wsum_slot3(slot);
    int bef = _dk_wsum_before3(p);
    if (slot == DOCK_BOTTOM3) {
        int x0 = toInt(W * bef / tot);
        int x1 = toInt(W * (bef + _dk_wt_of3(p)) / tot);
        _dk_x3 = x0;
        _dk_w3 = x1 - x0;
        _dk_y3 = H - _ED_STAT_H3 - bh;
        _dk_h3 = bh;
        return true;
    }
    int y0 = top + toInt(yanh * bef / tot);
    int y1 = top + toInt(yanh * (bef + _dk_wt_of3(p)) / tot);
    _dk_y3 = y0;
    _dk_h3 = y1 - y0;
    if (slot == DOCK_LEFT3) { _dk_x3 = 0; _dk_w3 = _dk_lw3(); }
    else { _dk_x3 = W - _dk_rw3(); _dk_w3 = _dk_rw3(); }
    return true;
}

// ---- Yuva içi sınır ----------------------------------------------------------
// Aynı yuvadaki iki panelin ARASINDAKİ sınır. Yuvanın DIŞ sınırı
// (`_ed_split_at3`) yuvanın ölçüsünü değiştiriyor; bu ise yuvanın içindeki
// paylaşımı. İkisi ayrı jest, ayrı hedef.
func _dk_next_in_slot3(p): int {
    int slot = _dk_slot_of3(p);
    if (slot == DOCK_OFF3) { return 0 - 1; }
    int i = p + 1;
    while (i < _dk_n3()) {
        if (_dk_slot_of3(i) == slot) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// Bir panelin en küçük ölçüsü. Başlık + bir satır: başlığı görünmeyen panel
// ne sürüklenebilir ne kapatılabilir, yani geri getirilemez olurdu.
func _dk_min_h3(): int { return _dk_head_h3() + _g_lh3(); }
func _dk_min_w3(): int { return _us3(90); }

// İmlecin altındaki yuva-içi sınır: ÜSTTEKİ (yan yuvada) ya da SOLDAKİ (alt
// yuvada) panelin kimliği. -1 = yok. SAF — pencere gerekmiyor.
func _dk_div_at3(mx, my, W, H): int {
    int t = _ed_lay_grip3();
    int p = 0;
    while (p < _dk_n3()) {
        if (_dk_next_in_slot3(p) >= 0 && _dk_rect3(p, W, H)) {
            int slot = _dk_slot_of3(p);
            if (slot == DOCK_BOTTOM3) {
                int bx = _dk_x3 + _dk_w3;
                if (mx >= bx - t && mx <= bx + t &&
                    my >= _dk_y3 && my < _dk_y3 + _dk_h3) { return p; }
            } else {
                int by = _dk_y3 + _dk_h3;
                if (my >= by - t && my <= by + t &&
                    mx >= _dk_x3 && mx < _dk_x3 + _dk_w3) { return p; }
            }
        }
        p = p + 1;
    }
    return 0 - 1;
}

// Sınırı `pos` pikseline taşı. Yalnız ÇİFTİN payları değişiyor, toplamları
// sabit kalıyor: üç panelin olduğu bir yuvada ortadaki sınırı çekmek
// üçüncüsünü de oynatsaydı, kullanıcı düzelttiğini sandığı yerleşimi
// bozmuş olurdu.
//
// SAF anlamda değil ama pencere GEREKTİRMİYOR (W/H parametre) — kare
// döngüsünden ayrı sürülebilsin diye. Kararın kendisi burada; girdi
// fonksiyonu yalnız fareyi okuyor.
func _dk_div_apply3(p, pos, W, H): bool {
    int q = _dk_next_in_slot3(p);
    if (q < 0) { return false; }
    if (_dk_rect3(p, W, H) == false) { return false; }
    bool dikey = _dk_slot_of3(p) != DOCK_BOTTOM3;
    int s = _dk_x3;
    if (dikey) { s = _dk_y3; }
    if (_dk_rect3(q, W, H) == false) { return false; }
    int e = _dk_x3 + _dk_w3;
    int mn = _dk_min_w3();
    if (dikey) { e = _dk_y3 + _dk_h3; mn = _dk_min_h3(); }
    int span = e - s;
    // İki panelin ikisine birden yetmeyen bir yuvada sınırı oynatmak,
    // birini görünmez yapmaktan başka bir şey yapmaz.
    if (span < mn * 2) { return false; }
    // Fareyi piksel olarak kelepçelemek de denendi ve ÖLÜ çıktı: aşağıdaki
    // pay tabanı en küçük ölçüyü zaten sağlıyor, bozma denemesi hiçbir testi
    // kırmadı. İki yerde tutulan koruma hangisinin yük taşıdığını sınanamaz
    // yapıyor — bu depoda aynı gerekçeyle silinen üçüncü koruma.
    int comb = _dk_wt_of3(p) + _dk_wt_of3(q);
    int np = toInt(comb * (pos - s) / span);
    // Pikseli kelepçelemek YETMİYOR: pay → piksel çevrimi aşağı kırpıyor,
    // yani tam en küçük ölçüye çekilen panel bir piksel EKSİK çıkıyordu
    // (ölçüldü: 60 istenirken 59). Payın kendisinin de bir tabanı olmalı ve
    // o taban en küçük ölçüden türemeli — yuvanın TAMAMI üzerinden, çünkü
    // pay yuvanın toplamına göre piksele çevriliyor.
    int tot = _dk_wsum_slot3(_dk_slot_of3(p));
    int T = _dk_slot_span3(_dk_slot_of3(p), W, H);
    int taban = toInt(((mn + 1) * tot + T - 1) / T);
    if (taban < 1) { taban = 1; }
    if (comb < taban * 2) { return false; }
    if (np < taban) { np = taban; }
    if (np > comb - taban) { np = comb - taban; }
    _dk_set_wt3(p, np);
    _dk_set_wt3(q, comb - np);
    return true;
}

// Hangi sınır SEÇİLİYOR — yuvanın DIŞ sınırı varsa o kazanıyor. Ayrı ve saf
// bir fonksiyon, çünkü öncelik kuralı girdi fonksiyonunun içinde kalsaydı
// pencere olmadan sürülemezdi ve oradan silinmesi hiçbir testi kırmazdı
// (bu depoda aynı ders dörtten fazla kez çıktı: kararı ayrı bir SAF
// fonksiyona çıkar, testi ONU sürsün).
func _dk_div_pick3(mx, my, W, H): int {
    if (_ed_split_at3(mx, my, W, H) > 0) { return 0 - 1; }
    return _dk_div_at3(mx, my, W, H);
}

int _dk_div3 = 0 - 1;      // sürüklenen yuva-içi sınır (-1 = yok)
int _dk_div_hot3 = 0 - 1;  // imlecin altındaki sınır (vurgulama)

// ---- Paneli BAŞLIĞINDAN sürükle ---------------------------------------------
// Yuvayı bir listeden seçmek işi görüyordu ama jest yanlıştı: Unity'de,
// Unreal'da, Blender'da panel BAŞLIĞINDAN tutulup bırakılır. Kullanıcı da
// bunu istedi — "hiyerarşi yazısının üstünden sürükleyip yerini
// değiştireyim".
//
// Bırakma bölgeleri EKRAN GEOMETRİSİNDEN: içerik alanının (araç çubuğu ile
// durum çubuğu arası) alt çeyreği ALT yuva, sol üçte biri SOL, sağ üçte biri
// SAĞ. Ortası geçerli bir bırakma yeri DEĞİL — kazayla başlayan bir
// sürüklemenin paneli rastgele bir yere atmaması için.
func _dk_close_w3(): int { return _us3(16); }
func _dk_head_h3(): int { return _us3(16); }

// İmlecin altındaki panelin BAŞLIK ŞERİDİ. Kapatma düğmesinin yeri hariç:
// aynı piksel hem "kapat" hem "sürükle" olsaydı, kapatmak için basmak
// sürüklemeyi de başlatırdı.
func _dk_header_at3(mx, my, W, H): int {
    int p = 0;
    while (p < _dk_n3()) {
        if (_dk_rect3(p, W, H)) {
            int sag = _dk_x3 + _dk_w3 - _dk_close_w3();
            if (mx >= _dk_x3 && mx < sag &&
                my >= _dk_y3 && my < _dk_y3 + _dk_head_h3()) { return p; }
        }
        p = p + 1;
    }
    return 0 - 1;
}

// İmlecin altındaki panelin KAPATMA düğmesi. -1 = yok.
func _dk_close_at3(mx, my, W, H): int {
    int p = 0;
    while (p < _dk_n3()) {
        if (_dk_rect3(p, W, H)) {
            int sag = _dk_x3 + _dk_w3 - _dk_close_w3();
            if (mx >= sag && mx < _dk_x3 + _dk_w3 &&
                my >= _dk_y3 && my < _dk_y3 + _dk_head_h3()) { return p; }
        }
        p = p + 1;
    }
    return 0 - 1;
}

// Bırakılınca hangi yuvaya düşer. -1 = geçersiz (bırakma iptal).
func _dk_drop_at3(mx, my, W, H): int {
    int top = _ED_MENU_H3 + _ED_TOOL_H3;
    int bot = H - _ED_STAT_H3;
    if (my < top || my >= bot) { return 0 - 1; }
    if (mx < 0 || mx >= W) { return 0 - 1; }
    int ih = bot - top;
    // ALT bant ÖNCE sınanıyor: alt yuva tam genişlik, yani sol ve sağ
    // üçte birlerin de altından geçiyor. Sonra sınansaydı sol alt köşe
    // "sol" olurdu ve alta bırakmak isteyen kullanıcı sola düşürürdü.
    if (my >= bot - toInt(ih / 4)) { return DOCK_BOTTOM3; }
    if (mx < toInt(W / 3)) { return DOCK_LEFT3; }
    if (mx >= toInt(W * 2 / 3)) { return DOCK_RIGHT3; }
    return 0 - 1;
}

// Bırakma KARARI: sürüklenen panel hangi yuvaya gitsin. -1 = değişiklik yok.
// Ayrı fonksiyon çünkü karar fare durumuna gömülüydü ve "geçersiz bölgeye
// bırakmak İPTALDİR" kuralını çağrı yerinden silmek hiçbir testi
// kırmıyordu (bozma denendi, kaçtı). Aynı ders üçüncü kez: yardımcıyı
// sınamak yetmiyor, kararın KENDİSİ sınanabilir olmalı.
func _dk_drop_result3(p, drop): int {
    if (p < 0) { return 0 - 1; }
    if (drop < DOCK_LEFT3 || drop > DOCK_BOTTOM3) { return 0 - 1; }
    if (drop == _dk_slot_of3(p)) { return 0 - 1; }
    return drop;
}

int _dk_drag3 = 0 - 1;      // sürüklenen panel (-1 = yok)
int _dk_drop3 = 0 - 1;      // sürükleme sırasında hedef yuva (vurgulama)

func panel_dragging3d(): int { return _dk_drag3; }

// ---- YERLEŞİM: sürüklenebilir ayraçlar + kalıcılık --------------------------
// Paneller sabit genişlikteydi: hiyerarşi dar gelse de, inceleyici geniş
// gelse de yapılabilecek bir şey yoktu. Unity/Godot/Unreal'da panel sınırı
// sürüklenir; herkes kendi ekranına ve kendi işine göre yerleştirir.
//
// TAM DOCKING (paneli söküp başka bir yere bırakmak, sekmeler, yüzen
// pencereler) DEĞİL ve bilerek: onun bedeli ayrı bir pencere yöneticisi ve
// onu sürükleyecek bir kip makinesi. Buradaki üç sınır, "kendi
// özelleştirmesini kullanabilsin" isteğinin karşılığının neredeyse tamamı.
//
// Ölçüler UI ÖLÇEĞİYLE ilişkili: 3x'te 70 piksellik bir panel okunmuyor.
func _ed_lay_grip3(): int { return _us3(4); }      // yakalama yarıçapı
func _ed_lay_min_lw3(): int { return _us3(70); }
func _ed_lay_min_rw3(): int { return _us3(90); }
func _ed_lay_min_view3(): int { return _us3(120); }
// En küçük konsol: SÜZGEÇ ÇUBUĞU + bir kayıt satırı. Çubuğu hesaba
// katmayan eski ölçü (tek satır) süzgeci çizecek yeri bırakıyor, kayda
// hiç yer bırakmıyordu.
func _ed_lay_min_bh3(): int { return _g_lh3() * 2 + _us3(18); }

// Konsol pencerenin YARISINDAN fazlasını yiyemez: konsol bir tanılama
// paneli, sahne görünümü ise asıl iş — oranı tersine çevirmek editörü
// kullanılamaz yapardı ve geri getirmenin yolu (sınır yine ekranda) zor
// bulunurdu.
func _ed_lay_max_bh3(H): int {
    int mx = toInt(H / 2);
    int mn = _ed_lay_min_bh3();
    if (mx < mn) { mx = mn; }
    return mx;
}

// SAF kelepçeler. Her biri ÖTEKİ paneli hesaba katıyor: ikisi bağımsız
// sürükleniyor ve toplamları sahne görünümünü yok edebilir.
func _ed_lay_lw_at3(w, W): int {
    int mn = _ed_lay_min_lw3();
    int mx = W - _dk_rw3() - _ed_lay_min_view3();
    if (mx < mn) { mx = mn; }
    if (w < mn) { w = mn; }
    if (w > mx) { w = mx; }
    return w;
}
func _ed_lay_rw_at3(w, W): int {
    int mn = _ed_lay_min_rw3();
    int mx = W - _dk_lw3() - _ed_lay_min_view3();
    if (mx < mn) { mx = mn; }
    if (w < mn) { w = mn; }
    if (w > mx) { w = mx; }
    return w;
}
func _ed_lay_bh_at3(h, H): int {
    int mn = _ed_lay_min_bh3();
    int mx = _ed_lay_max_bh3(H);
    if (h < mn) { h = mn; }
    if (h > mx) { h = mx; }
    return h;
}

// Pencere küçülünce kelepçeler YENİDEN uygulanmalı: kullanıcının 400
// piksellik inceleyicisi 600 piksellik bir pencerede sahne görünümünü
// tümden yerdi.
// Pencere ölçüsünü tazele ve DEĞİŞTİYSE yerleşimi yeniden kelepçele.
// Ayrı fonksiyon çünkü döngünün göbeğinde pencere olmadan sürülemiyordu ve
// kelepçe çağrısını oradan silmek hiçbir testi kırmıyordu (bozma denendi,
// kaçtı). Menü dağıtımında da aynı ders çıkmıştı: yardımcıyı sınamak
// yetmiyor, onu ÇAĞIRDIĞINI da sınamak gerekiyor.
func _ed_sync_window3(W, H) {
    if (W <= 0 || H <= 0) { return; }
    if (W != _win_w || H != _win_h) { _ed_lay_reclamp3(W, H); }
    _win_w = W;
    _win_h = H;
}

func _ed_lay_reclamp3(W, H) {
    // Ölçü BİLİNMİYORSA kelepçeleme. `screen_width()` pencere açılmadan 0
    // dönüyor ve sıfıra göre kelepçelemek her paneli en küçük ölçüsüne
    // indirir — yani kayıtlı yerleşimi sessizce SİLER. (Test yakaladı:
    // yeniden açılışta 300 piksellik hiyerarşi 140'a düşüyordu.) Gerçek
    // ölçü öğrenilince kare döngüsü zaten yeniden kelepçeliyor.
    if (W <= 0 || H <= 0) { return; }
    _ED_L_W3 = _ed_lay_lw_at3(_ED_L_W3, W);
    _ED_R_W3 = _ed_lay_rw_at3(_ED_R_W3, W);
    _ED_B_H3 = _ed_lay_bh_at3(_ED_B_H3, H);
}

// Ölçek değişiminde ÖZELLEŞTİRME korunuyor. Kullanıcı sınırı hiç
// sürüklemediyse yeni ölçeğin varsayılanı geliyor; sürüklediyse oranı
// korunarak büyüyor. Özelleştirmeyi sessizce atmak, "kendi yerleşimini
// kullanabilsin" isteğinin tam tersi olurdu.
func _ed_lay_rescale3(cur, eski_var, yeni_var): int {
    if (eski_var <= 0) { return yeni_var; }
    if (cur == eski_var) { return yeni_var; }
    return toInt(cur * yeni_var / eski_var);
}

// Ölçeğin VARSAYILAN ölçüleri — hem `editor_ui_scale3d` hem yeniden
// ölçekleme buradan okuyor, iki yerde tutmak ikisini ayırırdı.
func _ed_lay_def_lw3(n): int { return 84 + 72 * n; }
func _ed_lay_def_rw3(n): int { return 96 + 104 * n; }
// Konsolun varsayılan yüksekliği ÜÇ KAYIT SATIRI + süzgeç çubuğu + başlık.
// Satır yüksekliği 14n; çubuk da bir satır, yani dört satırlık gövde + pay.
// (Süzgeç çubuğu eklenince üç satır ikiye düşmüştü — ölçü satır sayısından
// türediği için düzeltmesi tek sayı.)
func _ed_lay_def_bh3(n): int { return 14 * n * 4 + 18 * n; }

// Hangi ayracın üstündeyiz: 0 yok, 1 sol (hiyerarşi), 2 sağ (inceleyici),
// 3 konsolun üstü. SAF — fare konumu parametre, pencere gerekmiyor.
//
// KÖŞEYİ SIRA çözüyor, ikinci bir sınır değil: konsol şeridi ÖNCE
// sınanıyor, yani dikey ayraçlarla kesiştiği yerde her zaman konsol
// kazanıyor. Dikey bandı ayrıca "konsolun bir tutam yukarısında bitir"
// diye kısmak da denendi ve ÖLÜ çıktı (bozma denemesi hiçbir testi
// kırmadı) — iki yerde tutulan koruma, hangisinin yük taşıdığını
// sınanamaz yapıyor.
func _ed_split_at3(mx, my, W, H): int {
    int t = _ed_lay_grip3();
    int vy = _ed_view_y_at3(H);
    int lw = _dk_lw3();
    int rw = _dk_rw3();
    int bh = _dk_bh3();
    int cb = H - _ED_STAT_H3 - bh;          // alt yuvanın ÜST kenarı
    // BOŞ yuvanın ayracı YOK: boyutlandırılacak bir şey olmadığı hâlde
    // ekranın ortasında görünmez bir tutamak bırakmak, tıklamaları
    // yutan bir şerit demek olurdu.
    if (bh > 0 && my >= cb - t && my <= cb + t) { return 3; }
    if (my >= vy && my < cb) {
        if (lw > 0 && mx >= lw - t && mx <= lw + t) { return 1; }
        int rx = W - rw;
        if (rw > 0 && mx >= rx - t && mx <= rx + t) { return 2; }
    }
    return 0;
}

// ---- Yerleşimin kalıcılığı ---------------------------------------------------
// "Motor yeniden açıldığında da hatırlansın": ölçek ve üç panel ölçüsü
// kalıcı depoya yazılıyor (masaüstünde çalışma dizini, Android'de uygulama
// verisi, web'de tarayıcı deposu — `save_data` üçünü de kapsıyor).
//
// Biçim düz metin ve BORU ile ayrılmış: dört sayı için JSON kurmak, okumak
// için ayrıştırıcı çağırmak ve bozuk dosyaya karşı ayrıca korunmak gerekirdi.
// Kayıt ADI değiştirilebilir ve bu gerekli: testler yerleşim kaydını
// tazeliyor ve sabit bir ad, `./build.sh suites` çalıştıran kullanıcının
// KENDİ editör yerleşimini eziyordu. Ayrıca projeye özel yerleşim tutmak
// isteyen bir kurulum da bunu kullanabilir.
str _ed_lay_key_s3 = "tameengine_layout.txt";
func _ed_lay_key3(): str { return _ed_lay_key_s3; }
func editor_layout_key3d(name) { if (name != "") { _ed_lay_key_s3 = name; } }
func editor_yerlesim_anahtari3d(ad) { editor_layout_key3d(ad); }

func _ed_lay_encode3(): str {
    return toString(_ed_ui3) + "|" + toString(_ED_L_W3) + "|" +
           toString(_ED_R_W3) + "|" + toString(_ED_B_H3) + "|" +
           toString(_dk_slot_of3(PANEL_HIER3)) + "|" +
           toString(_dk_slot_of3(PANEL_INSP3)) + "|" +
           toString(_dk_slot_of3(PANEL_CONS3)) + "|" +
           toString(_dk_wt_of3(PANEL_HIER3)) + "|" +
           toString(_dk_wt_of3(PANEL_INSP3)) + "|" +
           toString(_dk_wt_of3(PANEL_CONS3));
}

func _dk_slot_valid3(v): bool { return v >= DOCK_OFF3 && v <= DOCK_BOTTOM3; }

// Pay ORAN olduğu için üst sınır da gerekiyor: 10 000 000'luk bir pay
// yanındaki paneli sıfır piksele indirirdi ve o panel bir daha görünmezdi.
func _dk_wt_valid3(v): bool { return v >= 1 && v <= 100000; }

// Bozuk / eski / boş kayıt SESSİZCE yok sayılıyor ve false dönüyor: kayıt
// dosyası kullanıcının elinde ve editörün açılmaması onu düzeltmenin yolunu
// da kapatırdı.
func _ed_lay_decode3(s, W, H): bool {
    if (s == "") { return false; }
    array p = split(s, "|");
    if (length(p) < 4) { return false; }
    int sc = toInt(p[0]);
    int hw = toInt(p[1]);
    int iw = toInt(p[2]);
    int ch = toInt(p[3]);
    if (sc < 1 || sc > 3) { return false; }
    if (hw <= 0 || iw <= 0 || ch <= 0) { return false; }
    // YUVALAR isteğe bağlı: dock'tan ÖNCE yazılmış dört alanlı kayıtlar
    // (ve elle kısaltılmış bir dosya) hâlâ okunuyor, yuvalar varsayılanda
    // kalıyor. Sürüm numarası eklemek yerine alan sayısına bakmak, eski
    // kaydı da geçerli kılıyor.
    int s0 = _dk_slot_of3(PANEL_HIER3);
    int s1 = _dk_slot_of3(PANEL_INSP3);
    int s2 = _dk_slot_of3(PANEL_CONS3);
    if (length(p) >= 7) {
        int a0 = toInt(p[4]);
        int a1 = toInt(p[5]);
        int a2 = toInt(p[6]);
        if (_dk_slot_valid3(a0) && _dk_slot_valid3(a1) && _dk_slot_valid3(a2)) {
            s0 = a0; s1 = a1; s2 = a2;
        }
    }
    if (sc != _ed_ui3) { editor_ui_scale3d(sc); }
    _ED_L_W3 = hw;
    _ED_R_W3 = iw;
    _ED_B_H3 = ch;
    _dk_set_slot3(PANEL_HIER3, s0);
    _dk_set_slot3(PANEL_INSP3, s1);
    _dk_set_slot3(PANEL_CONS3, s2);
    // PAYLAR yuvalardan SONRA: `_dk_set_slot3` yuva değişince payı hedefin
    // ortalamasına çekiyor (yeni gelen panel kıymık olmasın diye), yani
    // önce yazılan pay o kuralla silinirdi.
    if (length(p) >= 10) {
        int w0 = toInt(p[7]);
        int w1 = toInt(p[8]);
        int w2 = toInt(p[9]);
        // Üçü birden geçerliyse uygulanıyor: bir payı düşürüp ikisini almak
        // kullanıcının hiç görmediği bir oran üretirdi.
        if (_dk_wt_valid3(w0) && _dk_wt_valid3(w1) && _dk_wt_valid3(w2)) {
            _dk_set_wt3(PANEL_HIER3, w0);
            _dk_set_wt3(PANEL_INSP3, w1);
            _dk_set_wt3(PANEL_CONS3, w2);
        }
    }
    _ed_lay_reclamp3(W, H);
    return true;
}

func editor_layout_save3d(): bool {
    return save_data(_ed_lay_key3(), _ed_lay_encode3());
}
func editor_yerlesim_kaydet3d(): bool { return editor_layout_save3d(); }

func editor_layout_load3d(): bool {
    return _ed_lay_decode3(load_data(_ed_lay_key3()),
                           screen_width(), screen_height());
}
func editor_yerlesim_yukle3d(): bool { return editor_layout_load3d(); }

// Varsayılana dön — özelleştirmeyi geri almanın yolu olmalı, yoksa sınırı
// ekranın dışına itmiş biri sıkışıp kalır.
func editor_layout_reset3d() {
    _ED_L_W3 = _ed_lay_def_lw3(_ed_ui3);
    _ED_R_W3 = _ed_lay_def_rw3(_ed_ui3);
    _ED_B_H3 = _ed_lay_def_bh3(_ed_ui3);
    // Yuvalar da varsayılana: kapalı bir paneli geri getirmenin en kaba ama
    // en kesin yolu bu düğme olmalı.
    _dk_set_slot3(PANEL_HIER3, DOCK_LEFT3);
    _dk_set_slot3(PANEL_INSP3, DOCK_RIGHT3);
    _dk_set_slot3(PANEL_CONS3, DOCK_BOTTOM3);
    // Paylar da: yuvaları varsayılana alıp paylaşımı bozuk bırakmak,
    // "varsayılana dön"ü yarım bir söz yapardı.
    _dk_set_wt3(PANEL_HIER3, _DK_WT_DEF3);
    _dk_set_wt3(PANEL_INSP3, _DK_WT_DEF3);
    _dk_set_wt3(PANEL_CONS3, _DK_WT_DEF3);
    editor_layout_save3d();
}
func editor_yerlesim_sifirla3d() { editor_layout_reset3d(); }

// Sürükleme durumu.
int _ed_split3 = 0;      // 0 = sürüklenmiyor, 1/2/3 = hangi ayraç
int _ed_split_hot3 = 0;  // imlecin altındaki ayraç (vurgulama)

func _ed_view_x_at3(W): int { return _dk_lw3(); }
func _ed_view_y_at3(H): int { return _ED_MENU_H3 + _ED_TOOL_H3; }
func _ed_view_w_at3(W): int {
    int w = W - _dk_lw3() - _dk_rw3();
    if (w < 80) { w = 80; }
    return w;
}
func _ed_view_h_at3(H): int {
    int h = H - _ED_MENU_H3 - _ED_TOOL_H3 - _dk_bh3() - _ED_STAT_H3;
    if (h < 80) { h = 80; }
    return h;
}
// Editör kabuğu açık mı? Açıksa sahne görünümü panellerin arasındaki
// dikdörtgen; kapalıysa oyun tüm pencereyi kaplıyor. Tek bir yerde
// kararlaştırılıyor ki çizim, seçim ışını ve fare denetimi ayrışmasın.
func _ed_chrome3_on(): bool { return _ed_on3 == 1 || _ed_app3 == 1; }

func _ed_view_x3(): int {
    if (_ed_chrome3_on() == false) { return 0; }
    return _ed_view_x_at3(screen_width());
}
func _ed_view_y3(): int {
    if (_ed_chrome3_on() == false) { return 0; }
    return _ed_view_y_at3(screen_height());
}
func _ed_view_w3(): int {
    if (_ed_chrome3_on() == false) { return screen_width(); }
    return _ed_view_w_at3(screen_width());
}
func _ed_view_h3(): int {
    if (_ed_chrome3_on() == false) { return screen_height(); }
    return _ed_view_h_at3(screen_height());
}

// Fare sahne görünümünün İÇİNDE mi? Panel denetimi artık "hangi panelin
// üstünde" değil, "görünümün dışında mı" — pencere büyüdükçe panel sayısı
// artabilir, tersini saymak daha az kırılgan.
func _ed_in_view3(): bool {
    int mx = mouse_x();
    int my = mouse_y();
    int vx = _ed_view_x3();
    int vy = _ed_view_y3();
    return mx >= vx && mx < vx + _ed_view_w3() && my >= vy && my < vy + _ed_view_h3();
}
func _ed_over_ui3(): bool { return _ed_in_view3() == false; }

// Render texture görünüm boyutunu takip ediyor; pencere yeniden boyutlanırsa
// yeniden kuruluyor (bayat boyutla çizmek görüntüyü esnetirdi).
func _ed_rt_sync3() {
    int w = _ed_view_w3();
    int h = _ed_view_h3();
    if (_ed_rt3 >= 0 && _ed_rtw3 == w && _ed_rth3 == h) { return; }
    if (_ed_rt3 >= 0) { render_hedef_sil(_ed_rt3); }
    _ed_rt3 = render_hedef(w, h);
    _ed_rtw3 = w;
    _ed_rth3 = h;
}

// ---- Menü şeridi -----------------------------------------------------------
// Açılır menü YOK: tek kullanımlık bir menü makinesi yazmak, aynı işi yapan
// düğmelerden çok daha fazla kod ve durum demekti. Şerit doğrudan eylem.
// ---- Menü şeridi: AÇILIR MENÜLER --------------------------------------------
// Şerit düz bir düğme sırasıydı: "Yeni / Ac / Kaydet / F. Kaydet / Geri /
// Ileri / PANELLER / ?". İşi görüyordu ama iki somut bedeli vardı:
//
//   • ŞERİT DOLUYORDU. Her yeni komut bir düğme demek ve sığmayan düğme
//     hiç çizilmiyordu — yani komut dar pencerede ERİŞİLEMEZ oluyordu.
//     Menü başlığı sayısı sabit; komut eklemek şeridi büyütmüyor.
//   • KISAYOL hiçbir yerde YAZMIYORDU. CTRL+D'yi öğrenmenin tek yolu H
//     listesini açmaktı. Kısayolu komutun YANINDA göstermek, kullanıcının
//     fareden klavyeye geçmesinin sektörde standart olan yolu.
//
// Öğeler KONUMLA değil KODLA anılıyor (`MNA_*`). Bir öğe duruma göre
// gizlenebiliyor (web'de "Indir", yalnız kurtarılacak iş varken "Kurtar");
// dağıtıcı indekse baksaydı gizlenen bir öğe ötekilerin ne yaptığını
// kaydırırdı — bu depodaki en sevmediğimiz hata türü, sessiz olanı.
int MNA_NEW3      =  1;
int MNA_OPEN3     =  2;
int MNA_SAVE3     =  3;
int MNA_SAVEAS3   =  4;
int MNA_EXPORT3   =  5;
int MNA_UNDO3     = 10;
int MNA_REDO3     = 11;
int MNA_COPY3     = 12;
int MNA_PASTE3    = 13;
int MNA_DUP3      = 14;
int MNA_DELETE3   = 15;
int MNA_SELALL3   = 16;
int MNA_PANEL_H3  = 20;
int MNA_PANEL_I3  = 21;
int MNA_PANEL_C3  = 22;
int MNA_PANELS3   = 23;
int MNA_LAYOUT3   = 24;
int MNA_GRID3     = 25;
int MNA_FULL3     = 26;
int MNA_HELP3     = 30;

int _ed_mn_open3 = 0 - 1;      // açık menü (-1 = yok)
func _ed_mn_close3() { _ed_mn_open3 = 0 - 1; }
func _ed_mn_n3(): int { return 4; }
func _ed_mn_idbase3(): int { return 73000; }

func _ed_mn_title3(m): str {
    if (m == 0) { return "Dosya"; }
    if (m == 1) { return "Duzen"; }
    if (m == 2) { return "Gorunum"; }
    return "Yardim";
}

// Menünün öğeleri. 0 = AYIRICI. Duruma göre değişiyor: görünmeyecek öğeyi
// soluk çizmektense hiç koymamak, listeyi kısa ve okunur tutuyor —
// ama bu yalnız VAR OLUŞU duruma bağlı olanlar için (web, kurtarma).
// Geçici olarak iş görmeyenler (boş pano, seçimsiz sil) DURUYOR ve SOLUK
// çiziliyor: kaybolan öğe, kullanıcıya komutun var olduğunu da unutturur.
func _ed_mn_codes3(m): array {
    array a = [];
    if (m == 0) {
        push(a, MNA_NEW3);
        push(a, MNA_OPEN3);
        push(a, 0);
        push(a, MNA_SAVE3);
        push(a, MNA_SAVEAS3);
        if (web_mi()) { push(a, MNA_EXPORT3); }
        return a;
    }
    if (m == 1) {
        push(a, MNA_UNDO3);
        push(a, MNA_REDO3);
        push(a, 0);
        push(a, MNA_COPY3);
        push(a, MNA_PASTE3);
        push(a, MNA_DUP3);
        push(a, MNA_DELETE3);
        push(a, 0);
        push(a, MNA_SELALL3);
        return a;
    }
    if (m == 2) {
        push(a, MNA_PANEL_H3);
        push(a, MNA_PANEL_I3);
        push(a, MNA_PANEL_C3);
        push(a, 0);
        push(a, MNA_PANELS3);
        push(a, MNA_LAYOUT3);
        push(a, 0);
        push(a, MNA_GRID3);
        push(a, MNA_FULL3);
        return a;
    }
    push(a, MNA_HELP3);
    return a;
}

// Üç nokta = "bir pencere açar, işi hemen yapmaz". Sektör standardı ve
// burada gerçek bir bilgi: "Kaydet" yazar, "Farkli Kaydet..." sorar.
func _ed_mn_label3(code): str {
    if (code == MNA_NEW3) {
        // YIKICI komut: kaydedilmemiş sahneyi siler. Kipsiz onay — öğe
        // kendisi soruya dönüşüyor ve menü açık kalıyor.
        if (_ed_confirm3 > 0.0) { return "Yeni  —  EMIN MISIN?"; }
        return "Yeni";
    }
    if (code == MNA_OPEN3)    { return "Ac..."; }
    if (code == MNA_SAVE3)    { return "Kaydet"; }
    if (code == MNA_SAVEAS3)  { return "Farkli Kaydet..."; }
    if (code == MNA_EXPORT3)  { return "Indir..."; }
    if (code == MNA_UNDO3)    { return "Geri Al"; }
    if (code == MNA_REDO3)    { return "Yinele"; }
    if (code == MNA_COPY3)    { return "Kopyala"; }
    if (code == MNA_PASTE3)   { return "Yapistir"; }
    if (code == MNA_DUP3)     { return "Cogalt"; }
    if (code == MNA_DELETE3)  { return "Sil"; }
    if (code == MNA_SELALL3)  { return "Tumunu Sec"; }
    if (code == MNA_PANEL_H3) { return "Hiyerarsi"; }
    if (code == MNA_PANEL_I3) { return "Ozellikler"; }
    if (code == MNA_PANEL_C3) { return "Konsol"; }
    if (code == MNA_PANELS3)  { return "Panel Yerlesimi..."; }
    if (code == MNA_LAYOUT3)  { return "Varsayilan Yerlesim"; }
    if (code == MNA_GRID3)    { return "Izgara"; }
    if (code == MNA_FULL3)    { return "Tam Ekran"; }
    return "Kisayollar...";
}

// Kısayol ipucu. Boş dize = kısayolu YOK. Var olmayan bir kısayolu yazmak
// yanlış bilgi vermek olurdu: "Yeni" ve "Ac"ın kısayolu gerçekten yok
// (CTRL+N / CTRL+O bu editörde bağlı değil).
func _ed_mn_key3(code): str {
    if (code == MNA_SAVE3)    { return "CTRL + S"; }
    if (code == MNA_SAVEAS3)  { return "CTRL+SHIFT+S"; }
    if (code == MNA_UNDO3)    { return "CTRL + Z"; }
    if (code == MNA_REDO3)    { return "CTRL + Y"; }
    if (code == MNA_COPY3)    { return "CTRL + C"; }
    if (code == MNA_PASTE3)   { return "CTRL + V"; }
    if (code == MNA_DUP3)     { return "CTRL + D"; }
    if (code == MNA_DELETE3)  { return "DEL"; }
    if (code == MNA_SELALL3)  { return "CTRL + A"; }
    if (code == MNA_GRID3)    { return "G"; }
    if (code == MNA_FULL3)    { return "F11"; }
    if (code == MNA_HELP3)    { return "H"; }
    return "";
}

// İŞARET sütunu: -1 = işaretlenebilir değil, 0/1 = kapalı/açık.
func _ed_mn_check3(code): int {
    if (code == MNA_PANEL_H3) {
        if (_dk_slot_of3(PANEL_HIER3) != DOCK_OFF3) { return 1; }
        return 0;
    }
    if (code == MNA_PANEL_I3) {
        if (_dk_slot_of3(PANEL_INSP3) != DOCK_OFF3) { return 1; }
        return 0;
    }
    if (code == MNA_PANEL_C3) {
        if (_dk_slot_of3(PANEL_CONS3) != DOCK_OFF3) { return 1; }
        return 0;
    }
    if (code == MNA_GRID3) {
        if (_ed_grid3 > 0.0) { return 1; }
        return 0;
    }
    if (code == MNA_FULL3) {
        if (is_fullscreen()) { return 1; }
        return 0;
    }
    return 0 - 1;
}

// İş görüp görmeyeceği. Soluk bir öğe "bu komut VAR ama şu an yapacak bir
// şey yok" diyor; kaybolan öğe komutun varlığını da unutturur.
func _ed_mn_on3(code): bool {
    if (code == MNA_UNDO3)   { return length(_ed_undo3) > 0; }
    if (code == MNA_REDO3)   { return length(_ed_redo3) > 0; }
    if (code == MNA_COPY3)   { return ed_select_count3d() > 0; }
    if (code == MNA_PASTE3)  { return ed_clip_count3d() > 0; }
    if (code == MNA_DUP3)    { return ed_select_count3d() > 0; }
    if (code == MNA_DELETE3) { return ed_select_count3d() > 0; }
    return true;
}

// Panelin VARSAYILAN yuvası. Kapalı bir paneli geri açarken kullanılıyor:
// hepsini sola atmak, konsolu geri açan kullanıcıya onu bir daha taşıtırdı.
func _dk_def_slot3(p): int {
    if (p == PANEL_HIER3) { return DOCK_LEFT3; }
    if (p == PANEL_INSP3) { return DOCK_RIGHT3; }
    return DOCK_BOTTOM3;
}

func _ed_mn_panel_toggle3(p) {
    if (_dk_slot_of3(p) == DOCK_OFF3) { _dk_set_slot3(p, _dk_def_slot3(p)); }
    else { _dk_set_slot3(p, DOCK_OFF3); }
    editor_layout_save3d();
}

// Öğenin İŞİ. Dönüş: menü AÇIK KALSIN mı. Ayrı ve çağrılabilir bir
// fonksiyon, çünkü tıklama çizim göbeğinde yaşıyor ve orada penceresiz
// sürülemiyor — bu depodaki en sık kaçan bozma sınıfı (bkz. Tuzaklar 1a).
func _ed_mn_do3(code): bool {
    if (_ed_mn_on3(code) == false) { return true; }
    if (code == MNA_NEW3) {
        if (_ed_confirm3 > 0.0 || _ed_dirty3 == 0) {
            ed_mark3d();
            scene_load3d("{\"v\":1,\"world\":{\"ground\":0},\"entities\":[]}");
            _ed_confirm3 = 0.0;
            return false;
        }
        // Silmeye HENÜZ karar verilmedi: menü açık kalıyor ki ikinci
        // tıklama aynı yerde olsun ve öğe "EMIN MISIN?" yazsın.
        _ed_confirm3 = 4.0;
        return true;
    }
    if (code == MNA_OPEN3)   { _ed_fd_open3(_ED_FD_OPEN3); return false; }
    if (code == MNA_SAVE3)   { editor_save3d(); return false; }
    if (code == MNA_SAVEAS3) { _ed_fd_open3(_ED_FD_SAVE3); return false; }
    if (code == MNA_EXPORT3) {
        str ad = _ed_path3;
        if (ad == "") { ad = "sahne.json"; }
        scene_export3d(ad);
        _ed_msg3 = "indiriliyor: " + ad;
        _ed_msg_t3 = 3.0;
        return false;
    }
    if (code == MNA_UNDO3) {
        if (ed_undo3d()) { _ed_msg3 = "geri alindi"; _ed_msg_t3 = 1.2; }
        return false;
    }
    if (code == MNA_REDO3) {
        if (ed_redo3d()) { _ed_msg3 = "yinelendi"; _ed_msg_t3 = 1.2; }
        return false;
    }
    if (code == MNA_COPY3) {
        int cn = ed_copy3d();
        _ed_msg3 = toString(cn) + " varlik kopyalandi";
        _ed_msg_t3 = 1.5;
        return false;
    }
    if (code == MNA_PASTE3) {
        ed_mark3d();
        int pn = ed_paste3d();
        _ed_msg3 = toString(pn) + " varlik yapistirildi";
        _ed_msg_t3 = 1.5;
        return false;
    }
    if (code == MNA_DUP3)    { ed_mark3d(); ed_duplicate_selected3d(); return false; }
    if (code == MNA_DELETE3) { ed_mark3d(); ed_delete_selected3d(); return false; }
    if (code == MNA_SELALL3) {
        int sn = ed_select_all3d();
        _ed_msg3 = toString(sn) + " varlik secildi";
        _ed_msg_t3 = 1.5;
        return false;
    }
    if (code == MNA_PANEL_H3) { _ed_mn_panel_toggle3(PANEL_HIER3); return true; }
    if (code == MNA_PANEL_I3) { _ed_mn_panel_toggle3(PANEL_INSP3); return true; }
    if (code == MNA_PANEL_C3) { _ed_mn_panel_toggle3(PANEL_CONS3); return true; }
    if (code == MNA_PANELS3)  { _ed_dock_on3 = 1; return false; }
    if (code == MNA_LAYOUT3)  { editor_layout_reset3d(); return false; }
    if (code == MNA_GRID3) {
        if (_ed_grid3 > 0.0) { _ed_grid3 = 0.0; } else { _ed_grid3 = 0.5; }
        return true;
    }
    if (code == MNA_FULL3) { tam_ekran(is_fullscreen() == false); return false; }
    _ed_help3 = 1;
    _ed_help_scroll3 = 0;
    return false;
}

// ---- Menünün ölçüleri (SAF — pencere gerekmiyor) ----------------------------
// Genişlik gerçek metin genişliğinden DE, karakter tahmininden DE geliyor:
// `_g_w3` pencere yokken 0 döner ve yalnız ona bakan bir yerleşim testte
// "her şey sığıyor" der (bkz. Tuzaklar 3).
func _ed_mn_titlew3(m): int { return _g_wmax3(_ed_mn_title3(m)) + _us3(16); }
func _ed_mn_titlex3(m): int {
    int x = _ED_PAD3;
    int i = 0;
    while (i < m) { x = x + _ed_mn_titlew3(i); i = i + 1; }
    return x;
}
func _ed_mn_sepy3(): int { return _us3(5); }
func _ed_mn_checkw3(): int { return _us3(12); }

func _ed_mn_w3(m): int {
    array cd = _ed_mn_codes3(m);
    int lw = 0;
    int kw = 0;
    int i = 0;
    while (i < length(cd)) {
        int c = cd[i];
        if (c != 0) {
            int a = _g_wmax3(_ed_mn_label3(c));
            if (a > lw) { lw = a; }
            int b = _g_wmax3(_ed_mn_key3(c));
            if (b > kw) { kw = b; }
        }
        i = i + 1;
    }
    // İki sütunun ARASINDA nefes payı: bitişik yazılan etiket ve kısayol
    // tek bir kelime gibi okunuyor.
    return _ed_mn_checkw3() + lw + _us3(18) + kw + _us3(12);
}

func _ed_mn_h3(m): int {
    array cd = _ed_mn_codes3(m);
    int h = _us3(6);
    int i = 0;
    while (i < length(cd)) {
        if (cd[i] == 0) { h = h + _ed_mn_sepy3(); }
        else { h = h + _ED_FLD3; }
        i = i + 1;
    }
    return h;
}

// Menü ekranın SAĞINDAN taşmasın. Saf: başlığın x'inden başlıyor, sığmazsa
// sola kayıyor (sıfırın altına değil).
func _ed_mn_x3(m, W): int {
    int x = _ed_mn_titlex3(m);
    int w = _ed_mn_w3(m);
    if (x + w > W) { x = W - w; }
    if (x < 0) { x = 0; }
    return x;
}

// ---- Çizim -------------------------------------------------------------------
func _ed_mn_item3(id, x, y, w, h, code): bool {
    bool acik = _ed_mn_on3(code);
    _g_rect3(id, x, y, w, h);
    bool over = _g_in(x, y, w, h);
    bool clicked = false;
    if (acik) {
        if (over) { _g_hot3 = id; }
        if (over && _g_press3 == 1) { _g_act3 = id; }
        if (_g_act3 == id && _g_rel3 == 1) {
            if (over) { clicked = true; }
            _g_act3 = 0;
        }
        if (over) { rect(x, y, w, h, _G_BTNH3()); }
    }
    int tc = _G_TXT3();
    if (acik == false) { tc = _G_DIM3(); }
    // İŞARET sütunu HER ZAMAN ayrılıyor: yalnız işaretli satırda yer
    // açsaydık iki satırın metni birbirine göre kayardı.
    int cw = _ed_mn_checkw3();
    int chk = _ed_mn_check3(code);
    if (chk >= 0) {
        int bx = x + toInt((cw - _us3(6)) / 2);
        int by = y + toInt((h - _us3(6)) / 2);
        rect_lines(bx, by, _us3(6), _us3(6), _G_LINE3());
        if (chk == 1) { rect(bx + 1, by + 1, _us3(6) - 2, _us3(6) - 2, _G_ACC3()); }
    }
    _g_txt3(_ed_mn_label3(code), x + cw, y + _g_cy3(h), w - cw - _us3(6), tc);
    str k = _ed_mn_key3(code);
    if (k != "") { _g_txtr3(k, x + w - _us3(6), y + _g_cy3(h), _G_DIM3()); }
    return clicked;
}

// Açılır liste EN ÜSTTE çiziliyor (kabuk sırasına bak): menü şeridinin
// hemen altındaki her şeyi kasıtlı olarak örtüyor.
func _ed_mn_draw3() {
    if (_ed_mn_open3 < 0) { return; }
    int m = _ed_mn_open3;
    int W = screen_width();
    int x = _ed_mn_x3(m, W);
    int y = _ED_MENU_H3;
    int w = _ed_mn_w3(m);
    int h = _ed_mn_h3(m);
    rect(x, y, w, h, rgba(24, 26, 32, 246));
    rect_lines(x, y, w, h, _G_ACC3());
    array cd = _ed_mn_codes3(m);
    int iy = y + _us3(3);
    int i = 0;
    while (i < length(cd)) {
        int c = cd[i];
        if (c == 0) {
            int ly = iy + toInt(_ed_mn_sepy3() / 2);
            line(x + _us3(6), ly, x + w - _us3(6), ly, _G_LINE3());
            iy = iy + _ed_mn_sepy3();
        } else {
            if (_ed_mn_item3(_ed_mn_idbase3() + i, x + _us3(3), iy,
                             w - _us3(6), _ED_FLD3, c)) {
                if (_ed_mn_do3(c) == false) { _ed_mn_close3(); }
                return;
            }
            iy = iy + _ED_FLD3;
        }
        i = i + 1;
    }
    // Dışarıya tıklamak kapatır — ama ŞERİDİN kendisi hariç: başlığa
    // tıklamak zaten menüyü açıp kapatıyor ve ikisi birden çalışsaydı
    // açık menünün başlığına basmak onu kapatıp aynı karede yeniden açardı.
    if (_g_press3 == 1 && _g_in(x, y, w, h) == false &&
        _g_in(0, 0, W, _ED_MENU_H3) == false) { _ed_mn_close3(); }
}

func _ed_menubar3() {
    int W = screen_width();
    rect(0, 0, W, _ED_MENU_H3, rgb(30, 33, 40));
    line(0, _ED_MENU_H3, W, _ED_MENU_H3, _G_LINE3());
    int bh = _ED_MENU_H3 - _us3(4);
    int m = 0;
    while (m < _ed_mn_n3()) {
        int x = _ed_mn_titlex3(m);
        int w = _ed_mn_titlew3(m);
        bool acik = _ed_mn_open3 == m;
        if (_g_tog(9600 + m, x, _us3(2), w, bh, _ed_mn_title3(m), acik)) {
            if (acik) { _ed_mn_close3(); } else { _ed_mn_open3 = m; }
        }
        // Bir menü AÇIKKEN başka bir başlığın ÜSTÜNE gelmek ona geçiyor.
        // Sektör standardı ve gerçek bir kolaylık: menüler arasında
        // gezinmek için her seferinde kapat-aç yapmak gerekmiyor.
        if (_ed_mn_open3 >= 0 && acik == false && _g_in(x, _us3(2), w, bh)) {
            _ed_mn_open3 = m;
        }
        m = m + 1;
    }

    // KURTAR menüde DEĞİL, şeritte ve VURGULU. Menüye koymak yanlış olurdu:
    // bu duran bir komut değil, geçici bir TEKLİF ("önceki oturumdan
    // kaydedilmemiş iş var"). Menüde saklanan bir teklif görülmez ve
    // kurtarma tam olarak görülmesi gereken şey.
    int rx = W - _ED_PAD3;
    if (_ed_recover_has3 == 1) {
        str kl = "KURTAR";
        int wk = _g_btnw3(kl) + _us3(8);
        int kx = rx - wk;
        if (kx > _ed_mn_titlex3(_ed_mn_n3())) {
            if (_g_button(9608, kx, _us3(2), wk, bh, kl)) {
                int kn = ed_recover3d();
                _ed_msg3 = "kurtarildi: " + toString(kn) + " varlik";
                _ed_msg_t3 = 4.0;
            }
            _g_tip_for3(9608, "Onceki oturumda kaydedilmemis is bulundu — geri getir");
            rx = kx - _us3(8);
        }
    }

    // Sağda dosya adı — başlıklardan sonra yer kalırsa.
    str f = _ed_path3;
    if (f == "") { f = "(kaydedilmemis sahne)"; }
    // Yıldız = kaydedilmemiş değişiklik. Her editörde standart.
    if (_ed_dirty3 == 1) { f = "* " + f; }
    int fw = _g_w3(f, _F3);
    if (rx - fw > _ed_mn_titlex3(_ed_mn_n3()) + _us3(12)) {
        _g_txtr3(f, rx, _g_cy3(_ED_MENU_H3), _G_DIM3());
    }
}

// Ortalanmış bir grubun x'i: ortalanır, ama SOL GRUBUN bittiği yerin gerisine
// düşemez ve sağdan taşamaz. Sol sınır her zaman kazanıyor — çakışmaktansa
// merkezden kaymak yeğdir. Saf, yani penceresiz sınanabiliyor.
func _ed_center_x3(W, cw, floorX, pad): int {
    int cx = toInt(W / 2) - toInt(cw / 2);
    // SIRA önemli: önce sağ kenara sığdır, SONRA sol sınırı uygula. Sol sınır
    // en son geldiği için her zaman kazanıyor — çakışmaktansa sağdan taşmak
    // yeğ (taşan kısım kırpılır, çakışan iki düğme ise tıklanamaz olur).
    //
    // Burada bir de sağ kırpmadan ÖNCE ikinci bir sol denetimi vardı; ölüydü.
    // İki yerde tutulan koruma, hangisinin yük taşıdığını sınanamaz yapıyor
    // (bozma denemesi öndekini silmeye izin veriyordu).
    if (cx + cw > W - pad) { cx = W - pad - cw; }
    if (cx < floorX) { cx = floorX; }
    return cx;
}

func _ed_toolbar3() {
    int W = screen_width();
    int ty = _ED_MENU_H3;
    rect(0, ty, W, _ED_TOOL_H3, _G_HEAD3());
    line(0, ty + _ED_TOOL_H3, W, ty + _ED_TOOL_H3, _G_LINE3());
    int by = ty + toInt((_ED_TOOL_H3 - _ED_FLD3) / 2);
    int gap = _us3(2);
    int sep = _us3(10);

    // Yerleşim ÖNCE ÖLÇÜLÜYOR, sonra çiziliyor. Eski hâli orta grubu doğrudan
    // W/2'ye koyuyordu ve solun nerede bittiğine BAKMIYORDU — gerçek yazı
    // tipiyle 2x ölçekte sol grup ortaya taşıyor ve düğmeler üst üste
    // biniyordu. Ölçüp yerleştirmek bu sınıfı tümden kapatıyor.
    str gl = "IZGARA " + _sc_num3(_ed_grid3);
    if (_ed_grid3 <= 0.0) { gl = "IZGARA yok"; }
    str us = "UI " + toString(_ed_ui3) + "x";
    str pl = "OYNAT";
    if (_ed_playing3 == 1) { pl = "OYNUYOR"; }

    int w1 = _g_btnw3("SEC");
    int w2 = _g_btnw3("TASI");
    int w3 = _g_btnw3("OLCEK");
    int w4 = _g_btnw3("DONDUR");
    int w5 = _g_btnw3(gl);
    int w9 = _g_btnw3(us);
    int pw = _g_btnw3(pl) + _us3(16);
    int sw = _g_btnw3("DUR") + _us3(16);

    // Zorunlu sol grup: dört araç. Bunlar her zaman çizilir.
    int coreEnd = _ED_PAD3 + w1 + gap + w2 + gap + w3 + gap + w4;
    // Orta grup: ortalanır ama SOLUN BİTTİĞİ YERİN gerisine düşemez.
    int cw = pw + gap + sw;
    int floorX = coreEnd + sep;
    int cx = _ed_center_x3(W, cw, floorX, _ED_PAD3);

    // İsteğe bağlı düğmeler yalnız orta gruba ÇARPMADAN sığıyorsa çizilir.
    // Bir editörde ızgara/ölçek düğmesinin kaybolması, üst üste binmiş iki
    // düğmeden iyidir (ve ikisinin de kısayolu var: G ve yok).
    int optX = coreEnd + sep;
    int showGrid = 0;
    int showUi = 0;
    if (optX + w5 + sep <= cx) { showGrid = 1; }
    if (showGrid == 1 && optX + w5 + gap + w9 + sep <= cx) { showUi = 1; }

    int x = _ED_PAD3;
    if (_g_tog(9002, x, by, w1, _ED_FLD3, "SEC", _ed_mode3 == ED_SELECT)) { _ed_mode3 = ED_SELECT; }
    _g_tip_for3(9002, "Sec  (Q)");
    x = x + w1 + gap;
    if (_g_tog(9003, x, by, w2, _ED_FLD3, "TASI", _ed_mode3 == ED_MOVE)) { _ed_mode3 = ED_MOVE; }
    _g_tip_for3(9003, "Tasi  (W)  —  oklardan surukle");
    x = x + w2 + gap;
    if (_g_tog(9004, x, by, w3, _ED_FLD3, "OLCEK", _ed_mode3 == ED_SCALE)) { _ed_mode3 = ED_SCALE; }
    _g_tip_for3(9004, "Olcekle  (R)  —  oklardan surukle");
    x = x + w3 + gap;
    if (_g_tog(9005, x, by, w4, _ED_FLD3, "DONDUR", _ed_mode3 == ED_ROTATE)) { _ed_mode3 = ED_ROTATE; }
    _g_tip_for3(9005, "Dondur  (E)  —  halkadan surukle, oklar 15 derece");

    if (showGrid == 1) {
        if (_g_tog(9006, optX, by, w5, _ED_FLD3, gl, _ed_grid3 > 0.0)) {
            if (_ed_grid3 > 0.0) { _ed_grid3 = 0.0; } else { _ed_grid3 = 0.5; }
        }
        _g_tip_for3(9006, "Izgaraya oturt  (G)");
    }
    if (showUi == 1) {
        if (_g_button(9012, optX + w5 + gap, by, w9, _ED_FLD3, us)) {
            int nk = _ed_ui3 + 1;
            if (nk > 3) { nk = 1; }
            editor_ui_scale3d(nk);
            return;   // ölçüler değişti; bu karenin kalanını çizme
        }
        _g_tip_for3(9012, "Arayuz boyutu: 1x / 2x / 3x");
    }

    // ORTA: oynatma denetimleri. Unity'nin imzası bu — kullanıcı gözünü
    // ekranın ortasına atınca "oynat"ı bulur.
    if (_g_tog(9610, cx, by, pw, _ED_FLD3, pl, _ed_playing3 == 1)) {
        if (_ed_playing3 == 0) { ed_play3d(); }
    }
    if (_g_button(9611, cx + pw + gap, by, sw, _ED_FLD3, "DUR")) { ed_stop3d(); }
    _g_tip_for3(9610, "Oyunu sahnenin KOPYASI uzerinde calistir");
    _g_tip_for3(9611, "Durdur  (ESC)  —  oynarken olanlar atilir");

    // SAĞ: durum. Yalnız orta grubun bitişinden SONRA yer kalırsa.
    str st = toString(yasayan_sayi3d()) + " varlik  " +
             toString(davranis_sayisi3d()) + " davranis  " +
             toString(kural_sayisi3d()) + " kural";
    int stw = _g_w3(st, _F3);
    if (W - _ED_PAD3 - stw > cx + cw + sep) {
        _g_txtr3(st, W - _ED_PAD3, by + _g_cy3(_ED_FLD3), _G_DIM3());
    }
}

// ---- Oynat / Dur -----------------------------------------------------------
// Unity modeli: Oynat, ekrandaki düzenlenmiş sahneyi yazarlık durumu olarak
// sabitler ve KOPYASINI koşturur. Dur kopyayı atar. Oynarken yapılan hiçbir
// değişiklik kaydedilmez.
int _ed_lvl_before_play3 = 0;   // Oynat'a basıldığında düzenlenen bölüm

func ed_play3d() {
    if (_ed_playing3 == 1) { return; }
    _ed_capture3();
    // Dur'dan sonra KULLANICININ bıraktığı bölüme dönmek için. Oyun her
    // zaman 1. bölümden başlıyor (oyuncunun göreceği şey o) ama düzenlemeye
    // dönünce 3. bölümdeki işinin başında olmak gerekiyor.
    _ed_lvl_before_play3 = _ed_lvl3;
    // Oyun BİRİNCİ bölümden başlar — oyuncunun göreceği şey bu. Editörde
    // 3. bölümdeyken "Oynat" 3. bölümü test etmek gibi görünebilir ama o
    // zaman oyunun başlangıcı hiç denenmemiş olurdu.
    if (length(_lvl_js3) > 1) {
        _cur_lvl3 = 1;
        _sc_load_level3(_lvl_js3[0]);
    }
    _ed_playing3 = 1;
    _ed_on3 = 0;
    _g_focus3 = 0;
}
func ed_stop3d() {
    if (_ed_playing3 == 0) { return; }
    _ed_apply_json3(_sc_authored3, 1);
    // Yazarlık belgesi bölümleri taşıyor, yani yükleme 1. bölümde duruyor.
    // Kullanıcı hangi bölümü düzenliyorduysa oraya dön.
    if (_ed_lvl_before_play3 > 0 && _ed_lvl_before_play3 < length(_lvl_js3)) {
        ed_level_go3d(_ed_lvl_before_play3 + 1);
    }
    _ed_playing3 = 0;
    _ed_on3 = 1;
    _g_focus3 = 0;
}
func oynat3d() { ed_play3d(); }
func dur3d() { ed_stop3d(); }

// ---- Konsol ----------------------------------------------------------------
// Motorun tanılama halka tamponunu gösteriyor. Ayrı bir kayıt sistemi
// yazılmadı — `log3d`/`uyari3d`/`hata3d` zaten oraya yazıyor.
//
// Panel uzun süre "son N satır" demekten ibaretti ve bir konsolun yapması
// gereken üç şeyi yapmıyordu:
//   • GERİYE BAKMAK. Bir şeyin neden bozulduğunu konsolda ararsın; kaydırma
//     olmayınca hata ekrandan akıp gidiyordu ve geri getirmenin yolu yoktu.
//   • SÜZMEK. Kırk bilgi satırının arasındaki tek hatayı gözle aramak,
//     konsolu olmamasıyla neredeyse aynı şey.
//   • TEMİZLEMEK. "Şimdi ne olacağını görmek istiyorum" demenin yolu.
int _ed_cons_f_err3 = 1;      // HATA satırları görünsün mü
int _ed_cons_f_wrn3 = 1;      // UYARI
int _ed_cons_f_inf3 = 1;      // BİLGİ + İZ (ikisi tek süzgeç: "gürültü")
int _ed_cons_scroll3 = 0;     // DİPTEN kaç satır yukarıdayız (0 = takip)

func _ed_cons_idbase3(): int { return 74000; }

// İZ, BİLGİ ile aynı süzgeçte: ikisi de "gürültü" kefesinde ve ayrı bir
// düğme, hiç kimsenin ayrı ayrı istemediği bir ayrım için yer harcardı.
func _ed_cons_pass3(sev): bool {
    if (sev == LOG_ERR)  { return _ed_cons_f_err3 == 1; }
    if (sev == LOG_WARN) { return _ed_cons_f_wrn3 == 1; }
    return _ed_cons_f_inf3 == 1;
}

// Tampondaki o seviyeden kaç satır var. Süzgeç düğmesinin üstündeki sayı
// bu — "üç hata var ama süzgeç kapalı" görünür olmalı, yoksa kullanıcı
// gizlediği şeyi aramaya devam eder.
func _ed_cons_count3(sev): int {
    int n = 0;
    int i = 0;
    while (i < _lg_count3()) {
        int idx = _lg_idx3(i);
        if (idx >= 0) {
            int sv = _lg_sev[idx];
            if (sv == sev) { n = n + 1; }
            // İZ, BİLGİ sayacına giriyor — süzgeçle aynı gruplama.
            if (sev == LOG_INFO && sv == LOG_TRACE) { n = n + 1; }
        }
        i = i + 1;
    }
    return n;
}

// Süzgeçten GEÇEN satır sayısı.
func _ed_cons_shown3(): int {
    int n = 0;
    int i = 0;
    while (i < _lg_count3()) {
        int idx = _lg_idx3(i);
        if (idx >= 0) {
            if (_ed_cons_pass3(_lg_sev[idx])) { n = n + 1; }
        }
        i = i + 1;
    }
    return n;
}

// Süzgeçten geçenlerin k'ıncısının DİZİ indeksi. -1 = yok.
func _ed_cons_nth3(k): int {
    if (k < 0) { return 0 - 1; }
    int n = 0;
    int i = 0;
    while (i < _lg_count3()) {
        int idx = _lg_idx3(i);
        if (idx >= 0) {
            if (_ed_cons_pass3(_lg_sev[idx])) {
                if (n == k) { return idx; }
                n = n + 1;
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

// Kaydırma kelepçesi. SAF: pencere gerekmiyor.
// `scroll` DİPTEN yukarı sayılıyor, yani 0 her zaman "en yeni satır
// görünür" demek. Tepeden saysaydık yeni satır geldikçe aynı sayı başka bir
// yeri gösterirdi ve takip eden konsol kendi kendine kayardı.
func _ed_cons_clamp3(scroll, toplam, satir): int {
    int maxs = toplam - satir;
    if (maxs < 0) { maxs = 0; }
    int v = scroll;
    if (v > maxs) { v = maxs; }
    if (v < 0) { v = 0; }
    return v;
}

// İlk görünen satırın süzülmüş listedeki sırası.
func _ed_cons_first3(scroll, toplam, satir): int {
    int f = toplam - satir - scroll;
    if (f < 0) { f = 0; }
    return f;
}

// Konsolun kaç SATIR gösterdiği. Başlık şeridi ve süzgeç çubuğu düşülüyor.
func _ed_cons_rows3(ph): int {
    int lav = ph - _us3(16) - _g_lh3() - _us3(2);
    int r = toInt(lav / _g_lh3());
    if (r < 1) { r = 1; }
    return r;
}

// Kaydı temizle. Tampon SAHNENİN değil OTURUMUN durumu, bu yüzden ayrı bir
// düğme: sahneyi sıfırlamadan kaydı sıfırlamak isteniyor ("şimdi ne
// olacağını görmek istiyorum").
func ed_console_clear3d() {
    _lg_txt = [];
    _lg_sev = [];
    _lg_n = 0;
    _ed_cons_scroll3 = 0;
}
func ed_konsol_temizle3d() { ed_console_clear3d(); }

// Süzgeç çubuğu. Etiketler KISA ve işaretli ("x 3" / "! 12" / "i 40")
// çünkü konsol yan yuvaya taşınabiliyor ve orada 300 piksel genişliğinde
// oluyor: "UYARI 12" o genişlikte üç sütuna sığmıyor. İşaret + sayı hem
// sığıyor hem renkle birlikte iki kanaldan anlatıyor.
// Süzgeç çubuğunun SÜTUN ÖLÇÜLERİ. Ayrı ve saf, çünkü yerleşim kararı
// çizimin içinde kalsaydı testin onu yeniden hesaplaması gerekirdi — ve
// testin kopyaladığı formül, sınadığı formülün kendisi olurdu (bkz.
// Tuzaklar 1b; bozma denendi ve tam bu yüzden kaçtı).
//
// TEMIZLE ölçüsünü METNİNDEN alıyor (`_g_wmax3`, yani penceresiz de doğru);
// kalanı üç sayaç paylaşıyor. Sabit bir yüzde, üç haneli sayaçta ("! 240")
// taşıyordu. Panelin yarısını da geçemiyor: konsol dar bir yan yuvaya
// taşınabiliyor ve orada asıl iş sayaçlar.
func _ed_cons_bar_tw3(w): int {
    int ic = w - _ED_PAD3 * 2;
    int tw = _g_wmax3("TEMIZLE") + _us3(10);
    int yari = toInt(ic / 2);
    if (tw > yari) { tw = yari; }
    return tw;
}
func _ed_cons_bar_sw3(w): int {
    int ic = w - _ED_PAD3 * 2;
    return toInt((ic - _ed_cons_bar_tw3(w)) / 3);
}

func _ed_cons_bar3(x, y, w, h) {
    int base = _ed_cons_idbase3();
    int tw = _ed_cons_bar_tw3(w);
    int sw = _ed_cons_bar_sw3(w);
    int bx = x + _ED_PAD3;
    if (_g_button(base, bx, y, tw, h, "TEMIZLE")) { ed_console_clear3d(); }
    _g_tip_for3(base, "Kaydi temizle  —  sahneye dokunmaz");
    bx = bx + tw;
    if (_g_tog(base + 1, bx, y, sw, h,
               "x " + toString(_ed_cons_count3(LOG_ERR)), _ed_cons_f_err3 == 1)) {
        if (_ed_cons_f_err3 == 1) { _ed_cons_f_err3 = 0; } else { _ed_cons_f_err3 = 1; }
    }
    _g_tip_for3(base + 1, "HATA satirlarini goster / gizle");
    bx = bx + sw;
    if (_g_tog(base + 2, bx, y, sw, h,
               "! " + toString(_ed_cons_count3(LOG_WARN)), _ed_cons_f_wrn3 == 1)) {
        if (_ed_cons_f_wrn3 == 1) { _ed_cons_f_wrn3 = 0; } else { _ed_cons_f_wrn3 = 1; }
    }
    _g_tip_for3(base + 2, "UYARI satirlarini goster / gizle");
    bx = bx + sw;
    if (_g_tog(base + 3, bx, y, sw, h,
               "i " + toString(_ed_cons_count3(LOG_INFO)), _ed_cons_f_inf3 == 1)) {
        if (_ed_cons_f_inf3 == 1) { _ed_cons_f_inf3 = 0; } else { _ed_cons_f_inf3 = 1; }
    }
    _g_tip_for3(base + 3, "BILGI ve IZ satirlarini goster / gizle");
}

func _ed_console3(px, py, pw, ph) {
    _g_panel(px, py, pw, ph, "KONSOL");
    int fy = py + _us3(16);
    int fh = _g_lh3();
    _ed_cons_bar3(px, fy, pw, fh);
    int ly = fy + fh;
    int rows = _ed_cons_rows3(ph);
    int toplam = _ed_cons_shown3();

    // Tekerlek: YUKARI eski satırlara gider. Panelin ÜSTÜNDEYKEN, yoksa
    // sahne görünümünde yakınlaştırmak konsolu da kaydırırdı.
    if (_g_in(px, py, pw, ph)) {
        float wh = mouse_wheel();
        if (wh > 0.5)       { _ed_cons_scroll3 = _ed_cons_scroll3 + 1; }
        if (wh < 0.0 - 0.5) { _ed_cons_scroll3 = _ed_cons_scroll3 - 1; }
    }
    _ed_cons_scroll3 = _ed_cons_clamp3(_ed_cons_scroll3, toplam, rows);
    int ilk = _ed_cons_first3(_ed_cons_scroll3, toplam, rows);

    int r = 0;
    while (r < rows && ilk + r < toplam) {
        int idx = _ed_cons_nth3(ilk + r);
        if (idx >= 0) {
            int c = _G_TXT3();
            if (_lg_sev[idx] == LOG_WARN) { c = rgb(255, 200, 90); }
            if (_lg_sev[idx] == LOG_ERR)  { c = rgb(255, 120, 110); }
            _g_txt3(_lg_txt[idx], px + _ED_PAD3, ly + r * _g_lh3(),
                    pw - _ED_PAD3 * 2, c);
        }
        r = r + 1;
    }

    // DİPTE DEĞİLSEN bunu söyle. Kaydırılmış bir konsol yeni satırları
    // göstermiyor ve bunu bilmeyen kullanıcı "kayıt durdu" sanıyor.
    if (_ed_cons_scroll3 > 0) {
        _g_txtr3(toString(_ed_cons_scroll3) + " satir asagida",
                 px + pw - _ED_PAD3, fy + _g_cy3(fh), _G_ACC3());
    }
}

// ---- Durum çubuğu ----------------------------------------------------------
func _ed_statusbar3() {
    int W = screen_width();
    int H = screen_height();
    int sy = H - _ED_STAT_H3;
    rect(0, sy, W, _ED_STAT_H3, rgb(30, 33, 40));
    line(0, sy, W, sy, _G_LINE3());
    str md = "SEC";
    if (_ed_mode3 == ED_MOVE)   { md = "TASI"; }
    if (_ed_mode3 == ED_SCALE)  { md = "OLCEK"; }
    if (_ed_mode3 == ED_ROTATE) { md = "DONDUR"; }
    str left = md + "   " + toString(yasayan_sayi3d()) + " varlik   " +
               toString(davranis_sayisi3d()) + " davranis   " +
               toString(kural_sayisi3d()) + " kural";
    // Sahne denetimi HER KARE değil, sahne değiştiğinde koşuyor: tarama
    // varlık × kural × davranış geziyor ve kare başına yapmanın karşılığı yok.
    if (_ed_playing3 == 0 && _chk_stamp3 != _ed_dirty_seq3) {
        _chk_stamp3 = _ed_dirty_seq3;
        scene_check3d();
    }
    if (_ed_playing3 == 0 && scene_check_count3d() > 0) {
        left = left + "   ! " + toString(scene_check_count3d()) + " uyari";
    }
    if (_ed_playing3 == 1) { left = "OYNUYOR   " + left; }
    else {
        int ss = _slot_of3(_ed_sel3e);
        if (ss >= 0) {
            Ent3 se = _e3[ss];
            str sn = _sc_nm_of3(_ed_sel3e);
            if (sn == "") { sn = _sc_tag_nm3(se.tag); }
            str cok = "";
            if (ed_select_count3d() > 1) {
                cok = " +" + toString(ed_select_count3d() - 1);
            }
            left = sn + cok + "  (" + _sc_num3(se.x) + ", " + _sc_num3(se.y) +
                   ", " + _sc_num3(se.z) + ")   " + left;
        }
    }
    _g_txt3(left, _ED_PAD3, sy + _g_cy3(_ED_STAT_H3), toInt(W / 2), _G_DIM3());
    // Kısayolları BURADA saymak işe yaramıyordu: satır kırpılıyor, dar
    // pencerede hiç çizilmiyor ve her mesajda (kaydedildi, geri alındı)
    // yerini kaybediyor. Tam liste artık H ile açılan örtüde; burada yalnız
    // ona işaret var — kısa olduğu için her zaman görünüyor.
    str right = "gorunum " + toString(_ed_view_w3()) + "x" + toString(_ed_view_h3()) +
                " | rt " + toString(_ed_rt3) + " | H = kisayollar";
    if (_ed_playing3 == 1) { right = "OYNUYOR — ESC durdurur"; }
    if (_ed_msg_t3 > 0.0) { right = _ed_msg3; }
    int rw = _g_w3(right, _F3);
    if (W - _ED_PAD3 - rw > toInt(W / 2) + 8) {
        int c = _G_DIM3();
        if (_ed_msg_t3 > 0.0) { c = rgb(140, 240, 160); }
        _g_txtr3(right, W - _ED_PAD3, sy + _g_cy3(_ED_STAT_H3), c);
    }
}

// ---- Yön göstergesi --------------------------------------------------------
// Sahne görünümünün köşesinde X/Y/Z okları. Serbest uçan bir kamerada "hangi
// yöne bakıyorum?" sorusu sürekli soruluyor; üç editörde de bu gösterge var.
//
// İzdüşüm ORTOGRAFİK: dünya vektörünün kamera sağ/yukarı vektörlerine
// izdüşümü. Perspektif kullanmak gerekmiyor — gösterge yönü anlatıyor, konumu
// değil — ve perspektif kameranın arkasındaki eksenleri ters çevirirdi.
float _ed_axsx3 = 0.0;
float _ed_axsy3 = 0.0;

func _ed_axis_screen3(vx, vy, vz) {
    float yr = _ed_yaw3 * DEG2RAD3;
    float pr = _ed_pitch3 * DEG2RAD3;
    float sp = sin(pr);
    // Taban `_ed_ray3` ile AYNI: sağ = (cos y, 0, sin y),
    // yukarı = (-sin y·sin p, cos p, cos y·sin p).
    float rx = cos(yr);
    float rz = sin(yr);
    float ux = 0.0 - sin(yr) * sp;
    float uy = cos(pr);
    float uz = cos(yr) * sp;
    _ed_axsx3 = vx * rx + vz * rz;
    // Ekran Y'si aşağı büyüyor.
    _ed_axsy3 = 0.0 - (vx * ux + vy * uy + vz * uz);
}

func _ed_axis_widget3() {
    int r = _us3(26);
    int cx = _ed_view_x3() + _ed_view_w3() - r - _us3(12);
    int cy = _ed_view_y3() + r + _us3(12);
    circle(cx, cy, r * 1.0 + _us3(3), rgba(18, 21, 28, 170));
    _ed_axis_one3(cx, cy, r, 1.0, 0.0, 0.0, rgb(232, 84, 74), "X");
    _ed_axis_one3(cx, cy, r, 0.0, 1.0, 0.0, rgb(112, 214, 112), "Y");
    _ed_axis_one3(cx, cy, r, 0.0, 0.0, 1.0, rgb(96, 150, 246), "Z");
}

func _ed_axis_one3(cx, cy, r, vx, vy, vz, col, lbl) {
    _ed_axis_screen3(vx, vy, vz);
    int ex = cx + toInt(_ed_axsx3 * r);
    int ey = cy + toInt(_ed_axsy3 * r);
    line(cx, cy, ex, ey, col);
    // Etiket yalnız eksen ekrana yeterince yansıyorsa — kameraya doğru bakan
    // bir eksen bir noktaya çöker ve harf merkeze yığılırdı.
    float m = sqrt(_ed_axsx3 * _ed_axsx3 + _ed_axsy3 * _ed_axsy3);
    if (m > 0.35) {
        _g_draw3(lbl, ex - toInt(_F3 / 4), ey - toInt(_F3 / 2), _F3, col);
    }
}

// ---- DOSYA PENCERESİ -------------------------------------------------------
// Editörün en büyük eksiği buydu: BAŞKA BİR SAHNE AÇAMIYORDU. Menüdeki "Aç"
// yalnız yürürlükteki dosyayı yeniden okuyordu (geri yükleme), yani editör
// açıldığı dosyaya ömür boyu bağlıydı — başka bir sahneye geçmenin tek yolu
// programı kapatıp komut satırında yol vermekti. "Farklı Kaydet" de yoktu,
// yani bir sahneyi DALLANDIRMAK (şablonu al, üstüne kendi oyununu yap)
// imkânsızdı; şablona basmak var olan dosyanın üstüne yazmaya mahkûmdu.
//
// Pencere BAĞLAM MENÜSÜYLE aynı desende: panellerin üstünde çizilen bir örtü,
// dışına tıklamak kapatır, çakışma denetiminden muaf (kasıtlı olarak örtüyor).
// Ayrı bir kipsel pencere makinesi kurmuyor — o makine tek bir kullanım için
// editörün bütün girdi yolunu ikiye bölerdi.
int _ED_FD_OFF3  = 0;
int _ED_FD_OPEN3 = 1;
int _ED_FD_SAVE3 = 2;

int   _ed_fd_on3     = 0;
str   _ed_fd_glob3   = "*.json";
array _ed_fd_files3  = [];
int   _ed_fd_done3   = 0;
int   _ed_fd_scroll3 = 0;
str   _ed_fd_name3   = "";
int   _ed_fd_warn3   = 0;    // 1 = kaydedilmemiş iş uyarısı gösteriliyor

func _ed_fd_idbase3(): int { return 70000; }
func _ed_fd_idstep3(): int { return 2; }

// En çok kaç dosya satırı. Üst sınır: daha uzun bir liste pencereyi ekran
// yüksekliğine bağımlı kılmadan da okunmaz yapardı; kaydırma zaten var.
func _ed_fd_maxrows3(): int { return 8; }

// Dikey ölçüler TEK YERDE. Çizim de bu üçünü kullanıyor, yükseklik hesabı da:
// ikisini ayrı ayrı yazmak, birini değiştirince ötekinin sessizce yalan
// söylemesi demek. (İlk hâlde tam olarak bu oldu — yükseklik üç sabit satır
// sayıyordu, çizim dördünü koyuyordu ve VAZGEÇ düğmesinin alt kenarı 2x
// ölçekte pencerenin 2 piksel dışında kalıyordu.)
func _ed_fd_top3(): int { return _us3(20); }   // başlık şeridinin altı
func _ed_fd_gap3(): int { return _us3(3); }    // satır arası
func _ed_fd_pad3(): int { return _us3(8); }    // alt pay

// Yüksekliğin SABİT parçası — liste dışındaki her şey.
// Dört sabit satır: desen, kaydırma, ad/uyarı, vazgeç.
// Üç satır arası + listeden sonraki ekstra pay (_us3(4)).
func _ed_fd_fixed_h3(): int {
    return _ed_fd_top3() + _ED_FLD3 * 4 + _ed_fd_gap3() * 3 + _us3(4) +
           _ed_fd_pad3();
}

// Kaç satır SIĞAR. Sabit 8 satır 3x ölçekte 820 piksellik editör penceresini
// aşıyordu ve taşan kısım alttaki düğmelerdi — yani pencere KAPATILAMAZ
// oluyordu (VAZGEÇ ekranın dışında). Satır sayısını ekrandan türetmek bu
// sınıfı tümden kapatıyor. SAF: pencere gerekmiyor, sınanabiliyor.
func _ed_fd_rows_for3(H): int {
    int bos = H - _ED_MENU_H3 - _ED_STAT_H3 - _ed_fd_fixed_h3();
    int r = toInt(bos / _ED_FLD3);
    if (r > _ed_fd_maxrows3()) { r = _ed_fd_maxrows3(); }
    // En az iki satır: tek satırlık bir dosya listesi liste sayılmaz, ve
    // sıfır satır listeyi görünmez yapıp pencereyi anlamsız kılardı.
    if (r < 2) { r = 2; }
    return r;
}
func _ed_fd_rows3(): int { return _ed_fd_rows_for3(screen_height()); }

// Genişlik de ekrandan kelepçeli — aynı sebeple.
func _ed_fd_w_for3(W): int {
    int w = _us3(360);
    int enb = W - _us3(24);
    if (w > enb) { w = enb; }
    return w;
}

// Yolun DİZİN parçası (son ayıracın öncesi). Ayıracsız yol için boş.
// `_ed_basename3`'in kardeşi; ikisi birlikte bir yolu ikiye bölüyor.
func _ed_dirname3(yol): str {
    int i = length(yol) - 1;
    while (i >= 0) {
        int c = ord(yol, i);
        if (c == 47 || c == 92) { return substring(yol, 0, i); }
        i = i - 1;
    }
    return "";
}

// Pencerenin açılışta tarayacağı desen: yürürlükteki dosyanın DİZİNİ.
// Sabit bir desen ("examples/scenes/*.json") kendi klasöründe çalışan bir
// kullanıcıya hiçbir zaman kendi dosyalarını göstermezdi; dizinsiz bir ad
// (./editor sahne.json) çalışma dizinini veriyor.
func _ed_fd_glob_for3(yol): str {
    str d = _ed_dirname3(yol);
    if (d == "") { return "*.json"; }
    return d + "/*.json";
}

func _ed_ws3(c): bool { return c == 32 || c == 9 || c == 13 || c == 10; }

func _ed_trimws3(s): str {
    int a = 0;
    int b = length(s);
    while (a < b && _ed_ws3(ord(s, a))) { a = a + 1; }
    while (b > a && _ed_ws3(ord(s, b - 1))) { b = b - 1; }
    return substring(s, a, b);
}

// Yolun SON parçasında nokta var mı. Tam yolda nokta aramak yanlış olurdu:
// "v1.2/sahne" uzantılı görünür ve dosya uzantısız yazılırdı.
func _ed_has_ext3(yol): bool {
    str b = _ed_basename3(yol);
    int i = 0;
    while (i < length(b)) {
        if (ord(b, i) == 46) { return true; }
        i = i + 1;
    }
    return false;
}

// Yazılan adı dosya adına çevir. SAF: pencere gerektirmiyor, o yüzden
// sınanabiliyor — dosya yazan yol sınanamaz.
//   • baş/son boşluklar gider (yapıştırılan yol boşluk getiriyor)
//   • uzantı yoksa ".json" eklenir ("bolum2" yazıp kaydedilebilsin)
//   • boş ad varsayılana düşer; adsız bir dosya yazmaktansa bilinen bir ad
func _ed_fd_norm3(ad): str {
    str t = _ed_trimws3(ad);
    if (t == "") { return "sahne.json"; }
    if (_ed_has_ext3(t)) { return t; }
    return t + ".json";
}

// GEÇMİŞ, dosya DEĞİŞİRSE sıfırlanmalı. Sıfırlanmasa yeni açılan sahnede
// CTRL+Z ÖNCEKİ dosyanın hâlini getirir, CTRL+S de onu yeni dosyaya YAZARDI:
// bir sahneyi öbürünün içeriğiyle ezmenin en sessiz yolu. (`_ed_apply_json3`
// geçmişi bilerek koruyor — geri alma sahne İÇİNDE gezinmektir — ama o kural
// dosya değişince geçerli değil.)
//
// AYNI dosyayı yeniden açmak (geri yükleme) geçmişi KORUYOR: orada geçmiş bir
// güvenlik ağı ve kaydedilmemiş işi geri getirmenin tek yolu.
func _ed_fd_resets_history3(eski, yeni): bool { return eski != yeni; }

func _ed_fd_scan3() {
    _ed_fd_files3 = file_glob(_ed_fd_glob3);
    _ed_fd_done3 = 1;
    _ed_fd_scroll3 = 0;
}

func _ed_fd_open3(kip) {
    _ed_fd_on3 = kip;
    _ed_fd_glob3 = _ed_fd_glob_for3(_ed_path3);
    _ed_fd_name3 = _ed_path3;
    _ed_fd_warn3 = 0;
    _ed_fd_scan3();
}
func _ed_fd_close3() { _ed_fd_on3 = 0; _ed_fd_warn3 = 0; }

// Sahneyi AÇ. Yükleme etkisi burada, KARARI (geçmiş sıfırlanacak mı) yukarıda:
// karar saf olduğu için pencere olmadan sınanıyor.
func _ed_fd_load3(path): int {
    bool sifirla = _ed_fd_resets_history3(_ed_path3, path);
    editor_file3d(path);
    int n = scene_file3d(path);
    if (sifirla) {
        _ed_undo3 = []; _ed_redo3 = [];
        _ed_undo_lvl3 = []; _ed_redo_lvl3 = [];
    }
    _ed_capture3();
    _ed_dirty3 = 0;
    _ed_dirty_seq3 = _ed_dirty_seq3 + 1;
    _ed_tab3 = 0;
    _ed_msg3 = "acildi: " + path + "  (" + toString(n) + " varlik)";
    _ed_msg_t3 = 3.0;
    _ed_fd_close3();
    return n;
}

// FARKLI KAYDET. Geçmiş KORUNUYOR: sahne aynı sahne, değişen yalnız hedef
// dosya. Sıfırlamak, dallandırdıktan sonra geri almayı imkânsız kılardı.
func _ed_fd_saveas3(ad): bool {
    str yol = _ed_fd_norm3(ad);
    editor_file3d(yol);
    bool ok = editor_save3d();     // mesajı kendisi yazıyor
    _ed_fd_close3();
    return ok;
}

func _ed_fd_w3(): int { return _ed_fd_w_for3(screen_width()); }
func _ed_fd_h_for3(H): int {
    return _ed_fd_fixed_h3() + _ED_FLD3 * _ed_fd_rows_for3(H);
}
func _ed_fd_h3(): int { return _ed_fd_h_for3(screen_height()); }

func _ed_fd_draw3() {
    if (_ed_fd_on3 == _ED_FD_OFF3) { return; }
    int w = _ed_fd_w3();
    int h = _ed_fd_h3();
    int x = toInt(screen_width() / 2) - toInt(w / 2);
    int y = toInt(screen_height() / 2) - toInt(h / 2);
    // SIRA önemli, `_ed_center_x3` ile aynı kural: önce alt kenara sığdır,
    // SONRA üst sınırı uygula. Üst sınır en son geldiği için kazanıyor —
    // menü şeridinin altına inmek, alttan taşıp VAZGEÇ düğmesini ekranın
    // dışında bırakmaktan yeğ.
    if (y + h > screen_height()) { y = screen_height() - h; }
    if (y < _ED_MENU_H3) { y = _ED_MENU_H3; }
    str baslik = "SAHNE AC";
    if (_ed_fd_on3 == _ED_FD_SAVE3) { baslik = "FARKLI KAYDET"; }
    // `_g_panel` zaten OPAK bir zemin çiziyor; altına ayrıca bir dikdörtgen
    // koymak görünmez bir katman olurdu. Vurgu çerçevesi panelden SONRA:
    // pencerenin panellerin üstünde durduğunu anlatan tek işaret o.
    _g_panel(x, y, w, h, baslik);
    rect_lines(x, y, w, h, _G_ACC3());

    int base = _ed_fd_idbase3();
    int lx = x + _ED_PAD3;
    int inner = w - _ED_PAD3 * 2;
    int iy = y + _ed_fd_top3();

    // Desen satırı — öteki tarayıcılarla aynı: yazılabilir desen + TARA.
    int tbw = _us3(38);
    str g0 = _ed_fd_glob3;
    str g1 = _g_text(base, lx, iy, inner - tbw - 4, _ED_FLD3, g0);
    if (g1 != g0) { _ed_fd_glob3 = g1; _ed_fd_done3 = 0; }
    _g_tip_for3(base, _ed_fd_glob3);
    if (_g_button(base + 1, lx + inner - tbw, iy, tbw, _ED_FLD3, "TARA")) {
        _ed_fd_scan3();
    }
    _g_tip_for3(base + 1, "Deseni diskte ara (* ve ? calisir)");
    iy = iy + _ED_FLD3 + _ed_fd_gap3();

    int an = length(_ed_fd_files3);
    int rows = _ed_fd_rows_for3(screen_height());
    _ed_fd_scroll3 = _ed_as_clamp3(_ed_fd_scroll3, an, rows);
    if (an == 0) {
        str emsg = "eslesme yok";
        if (_ed_fd_done3 == 0) { emsg = "TARA'ya bas"; }
        _g_txt3(emsg, lx, _g_ly3(iy), inner, _G_DIM3());
    }
    int ai = _ed_fd_scroll3;
    int shown = 0;
    while (ai < an && shown < rows) {
        str apath = _ed_fd_files3[ai];
        int rw = base + 20 + shown * _ed_fd_idstep3();
        if (_g_item(rw, lx, iy, inner, _ED_FLD3 - _us3(2),
                    _ed_basename3(apath), apath == _ed_path3)) {
            if (_ed_fd_on3 == _ED_FD_SAVE3) { _ed_fd_name3 = apath; }
            else {
                // Kaydedilmemiş iş varsa TEK TIKLA açma. Uyarı satırı
                // beliriyor ve ikinci tık açıyor — "Yeni" düğmesindeki
                // kipsiz onayın aynısı, modal pencere kurmadan.
                if (_ed_dirty3 == 1 && _ed_fd_warn3 == 0) { _ed_fd_warn3 = 1; }
                else { _ed_fd_load3(apath); return; }
            }
        }
        _g_tip_for3(rw, apath);
        iy = iy + _ED_FLD3 - _us3(2) + _us3(2);
        ai = ai + 1;
        shown = shown + 1;
    }
    // Liste sabit yükseklikte: gösterilmeyen satırların yeri boş kalıyor ki
    // alttaki düğmeler dosya sayısıyla zıplamasın.
    iy = y + _ed_fd_top3() + _ED_FLD3 + _ed_fd_gap3() + _ED_FLD3 * rows +
         _us3(4);

    if (an > rows) {
        int pbw = _us3(30);
        if (_g_button(base + 60, lx, iy, pbw, _ED_FLD3, "^")) {
            _ed_fd_scroll3 = _ed_fd_scroll3 - rows;
        }
        if (_g_button(base + 61, lx + pbw + 4, iy, pbw, _ED_FLD3, "v")) {
            _ed_fd_scroll3 = _ed_fd_scroll3 + rows;
        }
        _g_txt3(toString(_ed_fd_scroll3 + 1) + "-" + toString(_ed_fd_scroll3 + shown) +
                " / " + toString(an), lx + (pbw + 4) * 2, _g_ly3(iy),
                inner - (pbw + 4) * 2, _G_DIM3());
    }
    iy = iy + _ED_FLD3 + _ed_fd_gap3();

    if (_ed_fd_on3 == _ED_FD_SAVE3) {
        int kbw = _us3(64);
        _ed_fd_name3 = _g_text(base + 70, lx, iy, inner - kbw - 4, _ED_FLD3,
                               _ed_fd_name3);
        _g_tip_for3(base + 70, "Dosya adi  —  uzantisiz yazarsan .json eklenir");
        if (_g_button(base + 71, lx + inner - kbw, iy, kbw, _ED_FLD3, "KAYDET")) {
            _ed_fd_saveas3(_ed_fd_name3);
            return;
        }
        _g_tip_for3(base + 71, _ed_fd_norm3(_ed_fd_name3));
    } else {
        if (_ed_fd_warn3 == 1) {
            _g_txt3("kaydedilmemis is var — tekrar tikla", lx, _g_ly3(iy),
                    inner, rgb(250, 190, 90));
        } else {
            _g_txt3("bir dosyaya tikla", lx, _g_ly3(iy), inner, _G_DIM3());
        }
    }
    iy = iy + _ED_FLD3 + _ed_fd_gap3();
    int vbw = _us3(56);
    if (_g_button(base + 80, lx + inner - vbw, iy, vbw, _ED_FLD3, "VAZGEC")) {
        _ed_fd_close3();
        return;
    }

    // Dışarıya tıklamak kapatır — bağlam menüsüyle aynı kural.
    if (_g_press3 == 1 && _g_in(x, y, w, h) == false) { _ed_fd_close3(); }
}

// ---- KISAYOL YARDIMI -------------------------------------------------------
// Editörün kısayolları yalnız durum çubuğunun SAĞ ucundaki tek satırda
// yazıyordu — ve o satır hem kırpılıyor (pencere darsa hiç çizilmiyor) hem de
// her mesajda (kaydedildi, geri alındı) yerini kaybediyordu. Yani Q/W/E/R'yi,
// BOŞLUK'u, CTRL+D'yi bilmeyen biri onları hiç öğrenemiyordu; bir editörde
// bu, özelliğin var olmamasıyla aynı şey.
//
// Liste TEK KAYNAK: durum çubuğu artık kısayol saymıyor, "H = kısayollar"
// diyor. İki yerde elle yazılmış iki liste, biri değişince ötekinin sessizce
// yalan söylemesi demekti.
int _ed_help3 = 0;
int _ed_help_scroll3 = 0;

func _ed_help_idbase3(): int { return 71000; }
func _ed_help_n3(): int { return 27; }

func _ed_help_key3(i): str {
    if (i ==  0) { return "SAG TUS + WASD"; }
    if (i ==  1) { return "SAG TUS + Q/E"; }
    if (i ==  2) { return "Q W E R"; }
    if (i ==  3) { return "1 2 3 4"; }
    if (i ==  4) { return "SOL TIK"; }
    if (i ==  5) { return "CTRL + TIK"; }
    if (i ==  6) { return "CTRL + A"; }
    if (i ==  7) { return "F"; }
    if (i ==  8) { return "G"; }
    if (i ==  9) { return "BOSLUK"; }
    if (i == 10) { return "OK TUSLARI"; }
    if (i == 11) { return "DEL"; }
    if (i == 12) { return "CTRL + D"; }
    if (i == 13) { return "CTRL + C / V"; }
    if (i == 14) { return "CTRL + Z / Y"; }
    if (i == 15) { return "CTRL + S"; }
    if (i == 16) { return "CTRL+SHIFT+S"; }
    if (i == 17) { return "SAG TIK"; }
    if (i == 18) { return "ESC"; }
    if (i == 19) { return "F1"; }
    if (i == 20) { return "F2"; }
    if (i == 21) { return "F11"; }
    if (i == 22) { return "PANEL SINIRI"; }
    if (i == 23) { return "PANEL BASLIGI"; }
    // Yuva içi sınır listede AYRI satır: dıştaki sınır yuvanın ölçüsünü,
    // içteki aynı yuvadaki panellerin paylaşımını değiştiriyor. Tek satırda
    // anlatmak ikisini de anlatmamak olurdu ve iç sınır hiçbir yerde
    // yazmıyorsa görünmez bir jest demektir.
    if (i == 24) { return "PANEL ARASI"; }
    // Kutu seçimi listede AYRI satır: boş alandan sürüklemek eskiden
    // hiçbir şey yapmıyordu, yani kimsenin denemeyi düşünmeyeceği bir jest.
    // Yazmayan bir jest, olmayan bir jesttir.
    if (i == 25) { return "BOS ALANDA"; }
    return "H";
}

func _ed_help_act3(i): str {
    if (i ==  0) { return "serbest ucus, fareyle bakis"; }
    if (i ==  1) { return "yukari / asagi ucus"; }
    if (i ==  2) { return "sec / tasi / dondur / olcek"; }
    // SIRA QWER ile AYNI DEĞİL ve öyle yazmak yanlış olurdu: tuş
    // dinleyicisinde E=döndür, R=ölçek ama 3=ölçek, 4=döndür. Listenin
    // değeri doğru olmasında; "aynı dört araç" demek kullanıcıyı üçüncü
    // tuşta yanıltırdı.
    if (i ==  3) { return "sec / tasi / olcek / dondur"; }
    // Tutamak KİPE göre değişiyor: taşı/ölçek okları, döndürme halkası.
    // "oklardan sürükle" demek, döndürme kipinde yalan olurdu.
    if (i ==  4) { return "sec / tutamak surukle"; }
    if (i ==  5) { return "secime ekle / cikar"; }
    if (i ==  6) { return "tumunu sec"; }
    if (i ==  7) { return "secileni cercevele"; }
    if (i ==  8) { return "izgarayi ac / kapat"; }
    if (i ==  9) { return "secileni zemine oturt"; }
    if (i == 10) { return "ittir (aracin isine gore)"; }
    if (i == 11) { return "secilenleri sil"; }
    if (i == 12) { return "cogalt (kaydirarak)"; }
    if (i == 13) { return "kopyala / yapistir"; }
    if (i == 14) { return "geri al / yinele"; }
    if (i == 15) { return "kaydet  (F5 de olur)"; }
    if (i == 16) { return "farkli kaydet"; }
    if (i == 17) { return "baglam menusu (ekle / sil)"; }
    if (i == 18) { return "pencereyi kapat, oyunu durdur"; }
    // F1 ve F2 AYRI satır: tek satıra sığdırmak açıklama sütununu aşıyordu
    // (34 karakter, bütçe 31 — yerleşim testi yakaladı) ve iki ayrı işi tek
    // satırda anlatmak zaten okunmuyordu.
    if (i == 19) { return "tanilama ortusu"; }
    if (i == 20) { return "kaydi dosyaya dok"; }
    if (i == 21) { return "tam ekran ac / kapat"; }
    if (i == 22) { return "surukle: panel boyutu"; }
    if (i == 23) { return "surukle: paneli tasi"; }
    if (i == 24) { return "surukle: paylasim"; }
    if (i == 25) { return "surukle: kutuyla sec"; }
    return "bu listeyi ac / kapat";
}

func _ed_help_close3() { _ed_help3 = 0; _ed_help_scroll3 = 0; }

// Ölçüler ekrandan TÜRÜYOR — dosya penceresiyle aynı sebeple: 3x ölçekte on
// sekiz satır 820 piksele sığmıyor ve sığmayan kısım sessizce kayboluyordu
// (yani öğrenilmesi gereken kısayollar yine görünmez kalıyordu). Sığmıyorsa
// liste KAYIYOR; kırpmak yerine kaydırmak, hiçbir satırı kaybetmiyor.
func _ed_help_fixed_h3(): int {
    // başlık payı + alt satır (kapat düğmesi + kaydırma ipucu) + alt pay
    return _us3(20) + _ED_FLD3 + _us3(8);
}
// Dikey olarak kaç satır sığar (SÜTUN BAŞINA).
func _ed_help_rowcap_for3(H): int {
    int bos = H - _ED_MENU_H3 - _ED_STAT_H3 - _ed_help_fixed_h3();
    int r = toInt(bos / _g_lh3());
    if (r > _ed_help_n3()) { r = _ed_help_n3(); }
    if (r < 3) { r = 3; }
    return r;
}

// Kaç SÜTUN. Liste 24 satıra çıkınca 2x ölçekte tek sütun 820 piksele
// sığmaz oldu ve kaydırmaya düştü — bir BAŞVURU listesini kaydırtmak onu
// okumaktan çıkarıyor. İki sütun 2x'te tümünü görünür kılıyor; 3x'te iki
// sütun 1440 piksele sığmadığı için tek sütuna düşüp kayıyor. Karar
// GENİŞLİKTEN türüyor, elle seçilmiyor.
func _ed_help_cols_for3(W): int {
    int bir = _ed_help_keyw3() + _us3(180);
    int enb = W - _us3(24) - _ED_PAD3 * 2;
    if (enb >= bir * 2 + _us3(16)) { return 2; }
    return 1;
}

// Sütun başına GERÇEKTEN çizilecek satır: hepsi sığıyorsa daha fazlasına
// yer ayırmak pencereyi boşuna uzatırdı.
func _ed_help_rows_used3(W, H): int {
    int cols = _ed_help_cols_for3(W);
    int cap = _ed_help_rowcap_for3(H);
    int need = toInt((_ed_help_n3() + cols - 1) / cols);
    if (need < cap) { return need; }
    return cap;
}

// Aynı anda GÖRÜNEN satır sayısı — testin "hepsi okunabiliyor mu"
// sorusunun cevabı.
func _ed_help_visible3(W, H): int {
    int v = _ed_help_rows_used3(W, H) * _ed_help_cols_for3(W);
    if (v > _ed_help_n3()) { v = _ed_help_n3(); }
    return v;
}

func _ed_help_h_for3(H): int {
    return _ed_help_fixed_h3() + _g_lh3() * _ed_help_rows_used3(screen_width(), H);
}

// Anahtar sütunu: en uzun kısayol adı + pay. Sabit bir sayı, yeni bir uzun
// kısayol eklenince sessizce çakışırdı; sütun İÇERİKTEN türüyor.
func _ed_help_keyw3(): int {
    int en = 0;
    int i = 0;
    while (i < _ed_help_n3()) {
        int w = length(_ed_help_key3(i));
        if (w > en) { en = w; }
        i = i + 1;
    }
    // 11.5 px/karakter (ölçüldü — testlerdeki bütçe notuna bak), yarım
    // karakter pay. Tam sayı aritmetiği: (en*23 + 23) / 2.
    return toInt((en * 23 + 23) / 2);
}

func _ed_help_w_for3(W): int {
    int cols = _ed_help_cols_for3(W);
    int w = (_ed_help_keyw3() + _us3(180)) * cols + _ED_PAD3 * 2;
    if (cols > 1) { w = w + _us3(16); }
    int enb = W - _us3(24);
    if (w > enb) { w = enb; }
    return w;
}

func _ed_help_draw3() {
    if (_ed_help3 == 0) { return; }
    int w = _ed_help_w_for3(screen_width());
    int h = _ed_help_h_for3(screen_height());
    int x = toInt(screen_width() / 2) - toInt(w / 2);
    int y = toInt(screen_height() / 2) - toInt(h / 2);
    if (y + h > screen_height()) { y = screen_height() - h; }
    if (y < _ED_MENU_H3) { y = _ED_MENU_H3; }
    _g_panel(x, y, w, h, "KISAYOLLAR");
    rect_lines(x, y, w, h, _G_ACC3());

    int base = _ed_help_idbase3();
    int lx = x + _ED_PAD3;
    int inner = w - _ED_PAD3 * 2;
    int kw = _ed_help_keyw3();
    int cols = _ed_help_cols_for3(screen_width());
    int rows = _ed_help_rows_used3(screen_width(), screen_height());
    int gorunen = _ed_help_visible3(screen_width(), screen_height());
    int n = _ed_help_n3();
    _ed_help_scroll3 = _ed_as_clamp3(_ed_help_scroll3, n, gorunen);
    // Tekerlek de kaydırıyor: uzun bir listede düğme aramak gereksiz.
    if (_g_in(x, y, w, h)) {
        float wh = mouse_wheel();
        if (wh > 0.5) { _ed_help_scroll3 = _ed_help_scroll3 - 3; }
        if (wh < 0.0 - 0.5) { _ed_help_scroll3 = _ed_help_scroll3 + 3; }
        _ed_help_scroll3 = _ed_as_clamp3(_ed_help_scroll3, n, gorunen);
    }

    // Satırlar SÜTUN SÜTUN doluyor: ilk sütun baştan sona, sonra ikinci.
    // Satır satır (soldan sağa) doldurmak listeyi okunmaz yapardı — göz
    // kısayolları alt alta arıyor.
    int sw = toInt((inner - _us3(16)) / cols);
    if (cols == 1) { sw = inner; }
    int i = _ed_help_scroll3;
    int shown = 0;
    while (i < n && shown < gorunen) {
        int c = toInt(shown / rows);
        int r = shown - c * rows;
        int cx = lx + c * (sw + _us3(16));
        int iy = y + _us3(20) + r * _g_lh3();
        _g_txt3(_ed_help_key3(i), cx, iy, kw - _us3(4), _G_ACC3());
        _g_txt3(_ed_help_act3(i), cx + kw, iy, sw - kw, _G_TXT3());
        i = i + 1;
        shown = shown + 1;
    }

    int by = y + h - _ED_FLD3 - _us3(6);
    int kbw = _us3(56);
    if (n > gorunen) {
        int pbw = _us3(30);
        if (_g_button(base + 1, lx, by, pbw, _ED_FLD3, "^")) {
            _ed_help_scroll3 = _ed_help_scroll3 - gorunen;
        }
        if (_g_button(base + 2, lx + pbw + 4, by, pbw, _ED_FLD3, "v")) {
            _ed_help_scroll3 = _ed_help_scroll3 + gorunen;
        }
        _g_txt3(toString(_ed_help_scroll3 + 1) + "-" +
                toString(_ed_help_scroll3 + shown) + " / " + toString(n),
                lx + (pbw + 4) * 2, _g_ly3(by), inner - (pbw + 4) * 2 - kbw,
                _G_DIM3());
    }
    if (_g_button(base, lx + inner - kbw, by, kbw, _ED_FLD3, "KAPAT")) {
        _ed_help_close3();
        return;
    }
    if (_g_press3 == 1 && _g_in(x, y, w, h) == false) { _ed_help_close3(); }
}

// ---- Ayraç sürükleme -------------------------------------------------------
// GİRDİ panellerden ÖNCE işleniyor, ÇİZİM panellerden sonra. Girdi sonra
// gelseydi ayraca yapılan tıklama aynı karede altındaki panel widget'ına da
// giderdi (sınır, hiyerarşi satırlarının sağ kenarıyla birkaç piksel
// örtüşüyor); çizim önce gelseydi paneller ayracın üstünü boyardı.
func _ed_split_input3() {
    int W = screen_width();
    int H = screen_height();
    _ed_split_hot3 = 0;
    if (_ed_split3 == 0) {
        _ed_split_hot3 = _ed_split_at3(mouse_x(), mouse_y(), W, H);
        if (_ed_split_hot3 > 0 && mouse_pressed(0)) { _ed_split3 = _ed_split_hot3; }
    }
    if (_ed_split3 == 0) { return; }
    // Sürükleme başladıktan sonra imleç ayracın DIŞINA çıksa da bırakılmıyor:
    // hızlı bir sürüklemede fare her karede sınırın önünde oluyor ve
    // "üstündeyse sürükle" kuralı jesti sürekli koparırdı.
    if (_ed_split3 == 1) { _ED_L_W3 = _ed_lay_lw_at3(mouse_x(), W); }
    if (_ed_split3 == 2) { _ED_R_W3 = _ed_lay_rw_at3(W - mouse_x(), W); }
    if (_ed_split3 == 3) {
        _ED_B_H3 = _ed_lay_bh_at3(H - _ED_STAT_H3 - mouse_y(), H);
    }
    // Panel widget'ları bu karede tıklama ALMASIN.
    _g_press3 = 0;
    _g_act3 = 0;
    if (mouse_down(0) == false) {
        _ed_split3 = 0;
        // Bırakınca KALICI. Her karede yazmak diske kare başına dokunurdu;
        // yalnız çıkışta yazmak ise çökme hâlinde işi kaybettirirdi.
        editor_layout_save3d();
    }
}

// Yuva içi sınır — GİRDİ. Yuvanın DIŞ sınırından SONRA, başlık
// sürüklemesinden ÖNCE sınanıyor:
//   • Dış sınır önce, çünkü ikisi yuvanın KÖŞESİNDE çakışıyor ve dış sınır
//     kullanıcının önceden öğrendiği jest — sırayı tersine çevirmek çalışan
//     bir jesti bozardı. Kesişme tek köşe; ikisi de başka her yerinden
//     yakalanabiliyor.
//   • Başlıktan önce, çünkü sınır (±4 px) başlık şeridinin üst kenarıyla
//     çakışıyor ve daha DAR hedef önce kazanmalı.
func _dk_div_input3() {
    int W = screen_width();
    int H = screen_height();
    _dk_div_hot3 = 0 - 1;
    if (_ed_split3 > 0) { return; }
    if (_dk_drag3 >= 0) { return; }
    if (_dk_div3 < 0) {
        _dk_div_hot3 = _dk_div_pick3(mouse_x(), mouse_y(), W, H);
        if (_dk_div_hot3 >= 0 && mouse_pressed(0)) { _dk_div3 = _dk_div_hot3; }
    }
    if (_dk_div3 < 0) { return; }
    // Yan yuvada sınır YATAY (fareyi dikey izler), alt yuvada DİKEY.
    int pos = mouse_y();
    if (_dk_slot_of3(_dk_div3) == DOCK_BOTTOM3) { pos = mouse_x(); }
    _dk_div_apply3(_dk_div3, pos, W, H);
    // Panel widget'ları bu karede tıklama ALMASIN.
    _g_press3 = 0;
    _g_act3 = 0;
    if (mouse_down(0) == false) {
        _dk_div3 = 0 - 1;
        editor_layout_save3d();
    }
}

// Yuva içi sınır — ÇİZİM. Vurgu olmadan "burası çekilebilir" bilgisi hiçbir
// yerde yazmıyor; panellerin arasındaki çizgi sıradan bir kenarlık sanılırdı.
func _dk_div_draw3() {
    int W = screen_width();
    int H = screen_height();
    int hot = _dk_div3;
    if (hot < 0) { hot = _dk_div_hot3; }
    int p = 0;
    while (p < _dk_n3()) {
        if (_dk_next_in_slot3(p) >= 0 && _dk_rect3(p, W, H)) {
            if (_dk_slot_of3(p) == DOCK_BOTTOM3) {
                int bx = _dk_x3 + _dk_w3;
                if (p == hot) { rect(bx - 1, _dk_y3, 2, _dk_h3, _G_ACC3()); }
                else { line(bx, _dk_y3, bx, _dk_y3 + _dk_h3, _G_LINE3()); }
            } else {
                int by = _dk_y3 + _dk_h3;
                if (p == hot) { rect(_dk_x3, by - 1, _dk_w3, 2, _G_ACC3()); }
                else { line(_dk_x3, by, _dk_x3 + _dk_w3, by, _G_LINE3()); }
            }
        }
        p = p + 1;
    }
}

// Başlıktan sürükleme — GİRDİ. Ayraçlardan SONRA sınanıyor: ayraç ince bir
// şerit (±4 px) ve panelin kenarıyla çakışıyor; daha DAR olan hedef önce
// kazanmalı, yoksa sınırı yakalamak imkânsız olurdu.
func _dk_drag_input3() {
    int W = screen_width();
    int H = screen_height();
    if (_ed_split3 > 0) { return; }     // ayraç sürükleniyor, karışmasın
    if (_dk_div3 >= 0) { return; }      // yuva içi sınır sürükleniyor
    if (_dk_drag3 < 0) {
        if (mouse_pressed(0) == false) { return; }
        // KAPATMA düğmesi başlığın içinde ama sürükleme başlatmıyor.
        int kp = _dk_close_at3(mouse_x(), mouse_y(), W, H);
        if (kp >= 0) {
            _dk_set_slot3(kp, DOCK_OFF3);
            editor_layout_save3d();
            _g_press3 = 0;
            _g_act3 = 0;
            return;
        }
        int hp = _dk_header_at3(mouse_x(), mouse_y(), W, H);
        if (hp < 0) { return; }
        _dk_drag3 = hp;
    }
    _dk_drop3 = _dk_drop_at3(mouse_x(), mouse_y(), W, H);
    // Sürükleme sırasında panellerin widget'ları tıklama ALMASIN.
    _g_press3 = 0;
    _g_act3 = 0;
    if (mouse_down(0) == false) {
        // Geçersiz bölgeye bırakmak İPTAL: kazayla başlayan bir sürükleme
        // paneli rastgele bir yere atmamalı.
        int hedef = _dk_drop_result3(_dk_drag3, _dk_drop3);
        if (hedef >= 0) {
            _dk_set_slot3(_dk_drag3, hedef);
            editor_layout_save3d();
        }
        _dk_drag3 = 0 - 1;
        _dk_drop3 = 0 - 1;
    }
}

// Bırakma ÖNİZLEMESİ: panelin gideceği GERÇEK dikdörtgen.
//
// Eskiden ekranın kabaca üçte biri boyanıyordu ve bu bir YALANDI: sol
// yuvada zaten iki panel varsa gelen panel üçte biri değil, payına düşeni
// alır — yani vurgulanan alan bırakınca oluşacak alan değildi. Üstelik
// yuvanın genişliği kullanıcının çektiği sınıra bağlı, "üçte bir" ise
// hiçbir şeye.
//
// Önizleme artık sonucun KENDİSİYLE aynı fonksiyondan çıkıyor: model
// geçici olarak hedefe kuruluyor, `_dk_rect3` okunuyor, model geri
// alınıyor. Ayrı bir tahmin formülü yazmak, önizlemenin zamanla sonuçtan
// sapması demekti — üçte bir kuralı tam olarak öyle sapmıştı.
int _dk_pv_ok3 = 0;
int _dk_pvx3 = 0; int _dk_pvy3 = 0; int _dk_pvw3 = 0; int _dk_pvh3 = 0;

func _dk_preview_rect3(p, hedef, W, H) {
    _dk_pv_ok3 = 0;
    if (p < 0 || p >= length(_dk_slot3)) { return; }
    if (hedef < 0) { return; }
    int pvSlot = _dk_slot3[p];
    int pvWt   = _dk_wt3[p];
    _dk_set_slot3(p, hedef);
    bool var_mi = _dk_rect3(p, W, H);
    _dk_pvx3 = _dk_x3; _dk_pvy3 = _dk_y3;
    _dk_pvw3 = _dk_w3; _dk_pvh3 = _dk_h3;
    // Model AYNEN geri konuyor. Sürükleme sırasında her kare çağrılıyor;
    // bir tek kare bile geri koymayı atlasa panel bırakılmadan taşınmış
    // olurdu ve iptal (geçersiz bölgeye bırakma) hiçbir şeyi geri almazdı.
    _dk_slot3[p] = pvSlot;
    _dk_wt3[p] = pvWt;
    if (var_mi == false) { return; }
    if (_dk_pvw3 <= 0 || _dk_pvh3 <= 0) { return; }
    _dk_pv_ok3 = 1;
}

// Sürükleme — ÇİZİM. Hedef yuva vurgulanıyor, imlecin altında panelin
// HAYALETİ duruyor: bırakınca nereye gideceğini GÖRMEDEN sürüklemek tahmin
// oyunu.
func _dk_drag_draw3() {
    if (_dk_drag3 < 0) { return; }
    int W = screen_width();
    int H = screen_height();
    _dk_preview_rect3(_dk_drag3, _dk_drop3, W, H);
    if (_dk_pv_ok3 == 1) {
        rect(_dk_pvx3, _dk_pvy3, _dk_pvw3, _dk_pvh3, rgba(90, 170, 255, 60));
        rect_lines(_dk_pvx3, _dk_pvy3, _dk_pvw3, _dk_pvh3, _G_ACC3());
    }
    _dk_ghost_draw3(_dk_drag3, _dk_drop3, W, H);
}

// HAYALET: taşınan panelin imleci izleyen küçük bir kopyası. Yalnız ad
// yazmak "bir şey sürüklüyorum" demiyordu; başlık şeridi + gövdesi olan bir
// kart, taşınan şeyin bir PANEL olduğunu gösteriyor.
//
// Hayalet imlecin ALTINDA-SAĞINDA duruyor ve pencereye kelepçeli: ekranın
// kenarında yarısı dışarı taşan bir hayalet, tam da adını okumak
// istediğinde okunamaz hâle gelirdi.
func _dk_ghost_w3(): int { return _us3(108); }
func _dk_ghost_h3(): int { return _us3(64); }

// Hayaletin kendi çıkış değişkenleri var; önizlemenin (`_dk_pv*3`) üstüne
// yazmıyor. İkisi aynı karede çiziliyor ve tek bir çift değişkeni
// paylaşsalardı, çizim sırasını değiştiren ilk düzenleme önizlemeyi
// hayaletin yerine kaydırırdı — hiçbir şeyin söylemeyeceği bir hata.
int _dk_ghx3 = 0; int _dk_ghy3 = 0; int _dk_ghw3 = 0; int _dk_ghh3 = 0;

func _dk_ghost_at3(mx, my, W, H) {
    int gw = _dk_ghost_w3();
    int gh = _dk_ghost_h3();
    int gx = mx + _us3(8);
    int gy = my + _us3(8);
    if (gx + gw > W) { gx = W - gw; }
    if (gy + gh > H) { gy = H - gh; }
    if (gx < 0) { gx = 0; }
    if (gy < 0) { gy = 0; }
    _dk_ghx3 = gx; _dk_ghy3 = gy; _dk_ghw3 = gw; _dk_ghh3 = gh;
}

func _dk_ghost_draw3(p, hedef, W, H) {
    _dk_ghost_at3(mouse_x(), mouse_y(), W, H);
    int gx = _dk_ghx3; int gy = _dk_ghy3;
    int gw = _dk_ghw3; int gh = _dk_ghh3;
    int hh = _us3(16);
    // Gövde YARI SAYDAM: hayaletin altındaki sahne görünmeye devam etmeli,
    // yoksa "bırakırsam neyin üstüne gelecek?" sorusu cevapsız kalır.
    rect(gx, gy, gw, gh, rgba(24, 26, 32, 170));
    rect(gx, gy, gw, hh, rgba(90, 170, 255, 150));
    rect_lines(gx, gy, gw, gh, _G_ACC3());
    str ad = _dk_panel_nm3(p);
    _g_txt3(ad, gx + _us3(4), gy + _g_cy3(hh), gw - _us3(8), _G_TXT3());
    // Geçersiz bölge SÖYLENİYOR. Söylenmezse bırakma sessizce hiçbir şey
    // yapmaz ve kullanıcı sürüklemenin çalışmadığını sanır.
    if (hedef < 0) {
        _g_txt3("birakma yeri degil", gx + _us3(4), gy + hh + _us3(3),
                gw - _us3(8), _G_DIM3());
    }
}

func _ed_split_draw3() {
    int W = screen_width();
    int H = screen_height();
    int vy = _ed_view_y_at3(H);
    int lw = _dk_lw3();
    int rw = _dk_rw3();
    int bh = _dk_bh3();
    int cb = H - _ED_STAT_H3 - bh;
    int c = _G_LINE3();
    int hot = _ed_split3;
    if (hot == 0) { hot = _ed_split_hot3; }
    // Sınır normalde ince bir çizgi; imleç üstündeyken VURGULU. Vurgu
    // olmadan "burası sürüklenebilir" bilgisi hiçbir yerde yazmıyor.
    // Boş yuvanın çizgisi de yok — orada sınır diye bir şey yok.
    if (lw > 0) {
        if (hot == 1) { rect(lw - 1, vy, 2, cb - vy, _G_ACC3()); }
        else { line(lw, vy, lw, cb, c); }
    }
    if (rw > 0) {
        int rx = W - rw;
        if (hot == 2) { rect(rx - 1, vy, 2, cb - vy, _G_ACC3()); }
        else { line(rx, vy, rx, cb, c); }
    }
    if (bh > 0 && hot == 3) { rect(0, cb - 1, W, 2, _G_ACC3()); }
}

// Panelleri yuvalarına göre çiz. Ayrı fonksiyon: dikdörtgen hesabı dock
// modelinden geliyor ve kabuğun geri kalanı onu bilmek zorunda değil.
func _ed_panels_draw3() {
    int W = screen_width();
    int H = screen_height();
    int p = 0;
    while (p < _dk_n3()) {
        if (_dk_rect3(p, W, H)) {
            int hx = _dk_x3;
            int hy = _dk_y3;
            int hw = _dk_w3;
            if (p == PANEL_HIER3) { _ed_hierarchy3(_dk_x3, _dk_y3, _dk_w3, _dk_h3); }
            if (p == PANEL_INSP3) { _ed_inspector3(_dk_x3, _dk_y3, _dk_w3, _dk_h3); }
            if (p == PANEL_CONS3) { _ed_console3(_dk_x3, _dk_y3, _dk_w3, _dk_h3); }
            // Kapatma "x"i başlığın sağ ucunda. Başlık şeridi 2x ölçekte 32
            // piksel — bir düğme için fazlasıyla yeter (önce "çok küçük"
            // diye elenmişti, ölçüldü ve yanlıştı). Tıklamayı `_dk_drag_input3`
            // yakalıyor; burada yalnız İŞARET çiziliyor, yoksa aynı piksel
            // hem düğme hem sürükleme tutamağı olurdu.
            int cw = _dk_close_w3();
            _g_txtc3("x", hx + hw - cw, hy, cw, _dk_head_h3(), _G_DIM3());
        }
        p = p + 1;
    }
}

// ---- PANELLER örtüsü ---------------------------------------------------------
// Panelin yerini değiştirmenin ve kapatıp açmanın TEK yeri. Denemeler:
//   • Panel başlığına küçük düğmeler — başlık şeridi `_us3(16)` ve oraya
//     iki düğme sığdırmak onları tıklanamayacak kadar küçültüyordu.
//   • Sürükle-bırak (gerçek Unity jesti) — bırakma bölgesi göstergesi,
//     sürükleme hayaleti ve kip makinesi demek; üç panel için o bedel ağır.
// Liste ise hem KAPALI paneli geri getirebiliyor (başlıktaki düğme kapalı
// panelde çizilmiyor, yani kendini geri açamıyor) hem tek bakışta bütün
// yerleşimi gösteriyor.
int _ed_dock_on3 = 0;

func _ed_dock_idbase3(): int { return 72000; }
func _ed_dock_close3() { _ed_dock_on3 = 0; }

func _ed_dock_w3(): int { return _us3(300); }
func _ed_dock_h3(): int {
    return _us3(20) + _ED_FLD3 * (_dk_n3() + 1) + _us3(6) * _dk_n3() + _us3(14);
}

func _ed_dock_draw3() {
    if (_ed_dock_on3 == 0) { return; }
    int W = screen_width();
    int H = screen_height();
    int w = _ed_dock_w3();
    int enb = W - _us3(24);
    if (w > enb) { w = enb; }
    int h = _ed_dock_h3();
    int x = toInt(W / 2) - toInt(w / 2);
    int y = toInt(H / 2) - toInt(h / 2);
    if (y + h > H) { y = H - h; }
    if (y < _ED_MENU_H3) { y = _ED_MENU_H3; }
    _g_panel(x, y, w, h, "PANELLER");
    rect_lines(x, y, w, h, _G_ACC3());

    int base = _ed_dock_idbase3();
    int lx = x + _ED_PAD3;
    int inner = w - _ED_PAD3 * 2;
    int adw = toInt(inner * 40 / 100);
    int ybw = toInt(inner * 30 / 100);
    int gbw = inner - adw - ybw - _us3(8);
    int iy = y + _us3(20);

    int p = 0;
    while (p < _dk_n3()) {
        int slot = _dk_slot_of3(p);
        _g_txt3(_dk_panel_nm3(p), lx, _g_ly3(iy), adw - _us3(4), _G_TXT3());
        // TAŞI: yuvayı sırayla geziyor. Kapalı panelde bu düğme onu geri
        // açıyor — kapalı bir paneli geri getirmenin yolu olmak zorunda.
        if (_g_button(base + p * 4, lx + adw, iy, ybw, _ED_FLD3,
                      _dk_slot_nm3(slot))) {
            _dk_set_slot3(p, _dk_next_slot3(slot));
            editor_layout_save3d();
        }
        _g_tip_for3(base + p * 4, "Paneli sol / sag / alt yuvaya tasi");
        str gl = "gizle";
        if (slot == DOCK_OFF3) { gl = "goster"; }
        if (_g_button(base + p * 4 + 1, lx + adw + ybw + _us3(8), iy, gbw,
                      _ED_FLD3, gl)) {
            // Geri açarken panelin KENDİ varsayılan yuvasına: hepsini
            // sola atmak, konsolu geri açan kullanıcıya onu bir daha
            // taşıtırdı. Kural `_ed_mn_panel_toggle3` ile ORTAK.
            _ed_mn_panel_toggle3(p);
        }
        _g_tip_for3(base + p * 4 + 1, "Paneli kapat / geri ac");
        iy = iy + _ED_FLD3 + _us3(6);
        p = p + 1;
    }

    int kbw = _us3(56);
    if (_g_button(base + 90, lx, iy, inner - kbw - _us3(6), _ED_FLD3,
                  "VARSAYILAN YERLESIM")) {
        editor_layout_reset3d();
    }
    _g_tip_for3(base + 90, "Yuvalari ve olculeri varsayilana dondur");
    if (_g_button(base + 91, lx + inner - kbw, iy, kbw, _ED_FLD3, "KAPAT")) {
        _ed_dock_close3();
        return;
    }
    if (_g_press3 == 1 && _g_in(x, y, w, h) == false) { _ed_dock_close3(); }
}

// ---- Kabuk -----------------------------------------------------------------
func _ed_chrome3() {
    _g_begin();
    _ed_split_input3();
    _dk_div_input3();
    _dk_drag_input3();
    _ed_menubar3();
    _ed_toolbar3();
    // Paneller YUVALARINA göre çiziliyor. Sıra sabit (kimlik sırası) ama
    // yerleri değil: her biri dikdörtgenini dock modelinden alıyor ve
    // KAPALI olan hiç çizilmiyor.
    _ed_panels_draw3();
    _ed_statusbar3();
    // Sahne görünümünün çerçevesi — panel gibi görünsün.
    int vx = _ed_view_x3();
    int vy = _ed_view_y3();
    int vw = _ed_view_w3();
    int vh = _ed_view_h3();
    rect_lines(vx - 1, vy - 1, vw + 2, vh + 2, _G_LINE3());
    // Kutu seçimi görünümün ÜSTÜNDE ama panellerden SONRA çiziliyor: kendisi
    // görünüme kelepçeli olduğu için paneli örtemiyor, sahnenin üstünde ise
    // görünmesi şart.
    _ed_mq_draw3();
    _ed_split_draw3();
    _dk_div_draw3();
    _dk_drag_draw3();
    if (_ed_playing3 == 0) { _ed_axis_widget3(); }
    // Bağlam menüsü panellerin ÜSTÜNDE ama çakışma denetiminden ÖNCE:
    // menü kasıtlı olarak altındakileri örtüyor, onu çakışma saymak yanlış
    // olurdu. Denetim menü kapalıyken zaten her şeyi görüyor.
    if (_ed_ctx_on3 == 1) {
        _ed_ctx_draw3();
        _g_qx3 = []; _g_qy3 = []; _g_qw3 = []; _g_qh3 = []; _g_qi3 = [];
    }
    // Dosya penceresi bağlam menüsünden SONRA: ikisi birden açıksa üstte
    // duran pencere olmalı ve tıklama ona gitmeli.
    //
    // Kuyruk çizimden ÖNCE boşaltılıyor — bağlam menüsünün tersine. Menü
    // çizdikten SONRA boşaltıyor, yani KENDİ satırlarını da denetim dışı
    // bırakıyor; beş sabit satır için bunun bedeli yok. Dosya penceresinin
    // on beş widget'ı var ve yerleşimi satır sayısına göre değişiyor, yani
    // denetlenmeye ihtiyacı olan asıl yer orası. Altındaki panelleri
    // çakışma saymak yanlış olurdu (pencere onları kasıtlı örtüyor), bu
    // yüzden kuyruk önce boşalıyor, pencere sonra doluyor.
    if (_ed_fd_on3 != _ED_FD_OFF3) {
        _g_qx3 = []; _g_qy3 = []; _g_qw3 = []; _g_qh3 = []; _g_qi3 = [];
        _ed_fd_draw3();
    }
    // Kısayol listesi EN ÜSTTE: bir şeyin nasıl yapıldığını okurken onu
    // örten bir pencere olmamalı.
    if (_ed_dock_on3 == 1) {
        _g_qx3 = []; _g_qy3 = []; _g_qw3 = []; _g_qh3 = []; _g_qi3 = [];
        _ed_dock_draw3();
    }
    if (_ed_help3 == 1) {
        _g_qx3 = []; _g_qy3 = []; _g_qw3 = []; _g_qh3 = []; _g_qi3 = [];
        _ed_help_draw3();
    }
    // Açılır menü EN SON: şeridin altındaki her şeyi kasıtlı olarak örtüyor
    // ve tıklamayı önce O almalı. Kuyruk çizimden ÖNCE boşalıyor — altındaki
    // panelleri çakışma saymak yanlış olurdu (menü onları bilerek örtüyor).
    if (_ed_mn_open3 >= 0) {
        _g_qx3 = []; _g_qy3 = []; _g_qw3 = []; _g_qh3 = []; _g_qi3 = [];
        _ed_mn_draw3();
    }
    _g_check_overlaps3();
    _g_tip_draw3();   // EN SON: ipucu her şeyin üstünde (denetime girmiyor)
    // Görünüm neden boşsa ONU SÖYLE. Sessiz boş bir panel, kullanıcıyı
    // "editör bozuk" sanmaya götürüyor; sebebi ekranda yazmak gerekiyor.
    if (_ed_rt3 < 0) {
        _g_txt3("SAHNE GORUNUMU KURULAMADI (render texture)", vx + _us3(12),
                vy + _us3(12), vw - _us3(24), rgb(255, 120, 110));
        _g_txt3("grafik surucusu render texture desteklemiyor olabilir",
                vx + _us3(12), vy + _us3(12) + _g_lh3(), vw - _us3(24), _G_DIM3());
        return;
    }
    if (yasayan_sayi3d() == 0) {
        _g_txt3("SAHNE BOS", vx + _us3(12), vy + _us3(12), vw - _us3(24), _G_ACC3());
        _g_txt3("soldaki kutu/kure/boru/duvar dugmeleriyle varlik ekle",
                vx + _us3(12), vy + _us3(12) + _g_lh3(), vw - _us3(24), _G_DIM3());
        _g_txt3("sahne dosyasi acilamadiysa konsola bak (altta)",
                vx + _us3(12), vy + _us3(12) + _g_lh3() * 2, vw - _us3(24), _G_DIM3());
    }
}

// Inspector davranış satırının alan genişliği (panel genişliğinden türüyor).
// Davranış bloğunun sütun genişlikleri. SAF: yerleşim penceresiz
// sınanabilsin diye çizimden ayrı. (Önceki `_ed_bhw3` tek satırlık
// "ad|alan|alan|x" yerleşimini hesaplıyordu; o yerleşim etiketli bloklara
// dönüşünce fonksiyon ölü kaldı ve testi VAR OLMAYAN bir şeyi doğruluyordu.)
// PARAMETRE BAŞINA TEK SATIR: etiket solda, alan sağda.
//
// İki sütun denendi ve ÖLÇÜMLE elendi: okunur bir etiket ("yukseklik",
// "mermi hizi") genişlik istiyor ve iki etiket + iki alan 280 piksellik
// inceleyiciye sığmıyordu (340 gerekiyordu). Etiketleri kısaltmak da
// çözüm değil — panelin var olma sebebi "bu sayı ne?" sorusunu bitirmek.
//
// Etiket sütunu oransal: panel genişliği değişince ikisi birlikte büyüyor.
func _ed_bh_labelw3(): int { return _us3(52); }

// Davranış bloğunun kimlik TABANI ve ADIMI. Kod ve test ikisini de BURADAN
// okuyor. Test sabitleri tekrar etseydi adımı küçültmek bloğu kendi üstüne
// bindirir ve test bunu göremezdi (denendi: adım 3 yapıldı, test yeşil
// kaldı) — çakışan iki widget'tan ikincisi ÖLÜ kalır ve bu ancak liste
// büyüyünce ortaya çıkar.
func _ed_bh_idbase3(): int { return 30000; }
func _ed_bh_idstep3(): int { return 12; }
// Blok başına kullanılan en fazla widget: +0 sil, +1..+5 alanlar.
func _ed_bh_idused3(): int { return 6; }

func _ed_bh_lblw3(inner): int {
    int lw = toInt(inner * 45 / 100);
    if (lw > _ed_bh_labelw3()) { lw = _ed_bh_labelw3(); }
    return lw;
}

func _ed_bh_fieldw3(inner): int { return inner - _ed_bh_lblw3(inner) - _us3(4); }
// Hiyerarşi ekleme düğmelerinin genişliği.
func _ed_addw3(pw, gap): int {
    return toInt((pw - _ED_PAD3 * 2 - gap * 3) / 4);
}

// Alt sayaç için ayrılan yükseklik ve METNİN Y'si. Sabit 14 idi ve 2x'te metin
// 20 piksel olduğu için sayaç panelin altından taşıp KONSOLUN İÇİNE yazıyordu.
// Saf, yani "metnin altı paneli aşmıyor" değişmezi penceresiz sınanabiliyor.
func _ed_foot_h3(): int { return _g_lh3(); }
func _ed_foot_y3(py, ph): int { return py + ph - _ed_foot_h3() + _us3(2); }

// ---- Hiyerarşi araması -----------------------------------------------------
// Sahne büyüdükçe listede gezinmek imkânsızlaşıyor; her editörde arama kutusu
// var. Eşleşme BÜYÜK/KÜÇÜK HARF duyarsız: "Duvar" ararken "duvar"ı bulamamak
// sessiz bir hayal kırıklığı olurdu.
str _ed_filter3 = "";

func _ed_lower3(c): int {
    if (c >= 65 && c <= 90) { return c + 32; }
    return c;
}

// hay içinde needle geçiyor mu? (ASCII, harf duyarsız)
func _ed_match3(hay, needle): bool {
    if (needle == "") { return true; }
    int hn = length(hay);
    int nn = length(needle);
    if (nn > hn) { return false; }
    int i = 0;
    while (i <= hn - nn) {
        int j = 0;
        int ok = 1;
        while (j < nn) {
            if (_ed_lower3(ord(hay, i + j)) != _ed_lower3(ord(needle, j))) {
                ok = 0;
                j = nn;
            } else { j = j + 1; }
        }
        if (ok == 1) { return true; }
        i = i + 1;
    }
    return false;
}

// Bölüm şeridi: ◀ BOLUM k/N ▶ + x. Dönen değer bir SONRAKİ satırın y'si —
// şerit yüksekliği değişince altındaki her şey birlikte kayıyor (sabit bir
// offset yazmak, bu panelde daha önce başlığın üstüne binmeye yol açmıştı).
//
// Tek bölümlü sahnede yalnız "+bolum" görünüyor: sayaç ve gezinme okları
// anlamsız olurdu ve panelin üstünde yer kaplardı.
// Şerit sütun genişlikleri SAF: yerleşim penceresiz sınanabilsin diye
// çizimden ayrı. Etiket satırın KALANI; dar panelde eksiye düşerse yazı
// düğmelerin altına kayar ve şerit okunmaz olur.
func _ed_lvlbar_navw3(): int { return _us3(22); }

// İKİ SATIR: gezinme üstte, ekle/sil altta.
//
// Tek satır denendi ve ÖLÇÜMLE elendi: hiyerarşi paneli dar, üç düğme + ekle
// + sil yan yana konunca etikete 2x ölçekte 4 PİKSEL kalıyordu — yani
// "BOLUM 2/3" yazısı okunmaz oluyordu. İki satır her ölçekte sığıyor.
func _ed_lvlbar_lblw3(inner): int {
    return inner - _ed_lvlbar_navw3() * 2 - _us3(4);
}

func _ed_level_bar3(px, y, pw): int {
    int n = ed_level_count3d();
    int bx = px + _ED_PAD3;
    int inner = pw - _ED_PAD3 * 2;
    int h = _ED_FLD3;
    if (n < 2) {
        if (_g_button(9760, bx, y, inner, h, "+ BOLUM EKLE")) { ed_level_add3d(); }
        return y + h + _us3(4);
    }
    int nav = _ed_lvlbar_navw3();
    int lblw = _ed_lvlbar_lblw3(inner);
    // 1. satır: gezinme
    if (_g_button(9761, bx, y, nav, h, "<")) { ed_level_go3d(ed_level_now3d() - 1); }
    bx = bx + nav + _us3(2);
    _g_txtc3("BOLUM " + toString(ed_level_now3d()) + "/" + toString(n),
             bx, _g_ly3(y), lblw, _G_ACC3());
    bx = bx + lblw + _us3(2);
    if (_g_button(9762, bx, y, nav, h, ">")) { ed_level_go3d(ed_level_now3d() + 1); }
    y = y + h + _us3(2);
    // 2. satır: ekle / sil
    int halfw = toInt((inner - _us3(4)) / 2);
    if (_g_button(9763, px + _ED_PAD3, y, halfw, h, "+ bolum")) { ed_level_add3d(); }
    if (_g_button(9764, px + _ED_PAD3 + halfw + _us3(4), y, halfw, h, "sil")) {
        ed_level_del3d();
    }
    _g_tip_for3(9761, "Onceki bolum");
    _g_tip_for3(9762, "Sonraki bolum");
    _g_tip_for3(9763, "Yeni bos bolum ekle");
    _g_tip_for3(9764, "Bu bolumu sil (son bolum silinmez)");
    return y + h + _us3(4);
}

// Panel artık KENDİ yerini hesaplamıyor: dikdörtgeni dışarıdan alıyor.
// Hesaplasaydı yalnız solda durabilirdi — yuvası değiştirilebilen bir panel
// nerede olduğunu bilmemeli.
func _ed_hierarchy3(px, py, pw, ph) {
    _g_panel(px, py, pw, ph, "HIYERARSI");

    // BÖLÜM ŞERİDİ — hiyerarşinin en üstünde, ekleme düğmelerinin üstünde.
    // Buraya konuyor çünkü hiyerarşi "bu bölümde ne var" panelidir; hangi
    // bölüme baktığın da o sorunun parçası.
    int ly = py + _us3(16) + _us3(4);
    ly = _ed_level_bar3(px, ly, pw);

    // Ekleme düğmeleri: dört eşit sütun, panel genişliğinden türetiliyor.
    // İçerik başlık şeridinin ALTINDAN başlıyor. Sabit 20 idi ve 2x ölçekte
    // şerit 32 piksel olduğu için düğmeler başlığın üstüne biniyordu.
    int by = ly;
    int gap = 3;
    int bw = _ed_addw3(pw, gap);
    int bx = px + _ED_PAD3;
    if (_g_button(9100, bx, by, bw, _ED_FLD3, "kutu")) {
        ed_mark3d(); ed_select3d(ed_add3d(TAG_PROP, SHAPE_CUBE, _ed_cx3, 1.0, _ed_cz3));
    }
    bx = bx + bw + gap;
    if (_g_button(9101, bx, by, bw, _ED_FLD3, "kure")) {
        ed_mark3d(); ed_select3d(ed_add3d(TAG_ITEM, SHAPE_SPHERE, _ed_cx3, 1.0, _ed_cz3));
    }
    bx = bx + bw + gap;
    if (_g_button(9102, bx, by, bw, _ED_FLD3, "boru")) {
        ed_mark3d(); ed_select3d(ed_add3d(TAG_PROP, SHAPE_CYL, _ed_cx3, 1.0, _ed_cz3));
    }
    bx = bx + bw + gap;
    if (_g_button(9103, bx, by, bw, _ED_FLD3, "duvar")) {
        ed_mark3d();
        int nw = ed_add3d(TAG_WALL, SHAPE_CUBE, _ed_cx3, 1.5, _ed_cz3);
        ed_resize3d(nw, 6.0, 3.0, 1.0);
        ed_select3d(nw);
    }

    // Arama kutusu ekleme düğmelerinin ALTINDA: en çok kullanılan iki şey
    // (ekle, ara) listeye en yakın yerde.
    int sy2 = by + _ED_FLD3 + _us3(4);
    _ed_filter3 = _g_text(11990, px + _ED_PAD3, sy2, pw - _ED_PAD3 * 2, _ED_FLD3, _ed_filter3);
    _g_tip_for3(11990, "Ada ya da etikete gore suz");

    int listy = sy2 + _ED_FLD3 + _us3(4);
    int foot = _ed_foot_h3();
    int rows = toInt((ph - (listy - py) - foot) / _ED_ROW3);
    if (rows < 1) { rows = 1; }

    if (_g_in(px, py, pw, ph)) {
        float wh = mouse_wheel();
        if (wh > 0.5) { _ed_hscroll3 = _ed_hscroll3 - 3; }
        if (wh < 0.0 - 0.5) { _ed_hscroll3 = _ed_hscroll3 + 3; }
    }
    array slots = [];
    int i = 0;
    while (i < length(_e3)) {
        if (_e3[i].alive == 1) {
            str rn = _sc_nm_of3(_mk_handle3(i));
            if (_ed_match3(rn, _ed_filter3) ||
                _ed_match3(_sc_tag_nm3(_e3[i].tag), _ed_filter3)) {
                push(slots, i);
            }
        }
        i = i + 1;
    }
    int n = length(slots);
    int maxs = n - rows;
    if (maxs < 0) { maxs = 0; }
    if (_ed_hscroll3 > maxs) { _ed_hscroll3 = maxs; }
    if (_ed_hscroll3 < 0) { _ed_hscroll3 = 0; }

    // DÜNYA hiyerarşinin ilk satırı ve bir NESNE gibi seçiliyor. Godot'nun
    // WorldEnvironment'ı ile aynı fikir: yerçekimi, gökyüzü, su, arazi da
    // sahnenin parçası; onları ayrı bir sekmede saklamak "sahnede ne var?"
    // sorusunun cevabını eksik bırakıyordu.
    if (_g_item(11999, px + _us3(2), listy, pw - _us3(4), _ED_ROW3 - _us3(1),
                "DUNYA", _ed_tab3 == 1)) {
        _ed_tab3 = 1;
        _ed_sel3e = 0 - 1;
    }
    listy = listy + _ED_ROW3;
    rows = rows - 1;

    int r = 0;
    while (r < rows && r + _ed_hscroll3 < n) {
        int sl = slots[r + _ed_hscroll3];
        Ent3 e = _e3[sl];
        int hnd = _mk_handle3(sl);
        str nm = _sc_nm_of3(hnd);
        if (nm == "") { nm = _sc_tag_nm3(e.tag) + "." + toString(sl); }
        if (_g_item(12000 + r, px + _us3(2), listy + r * _ED_ROW3, pw - _us3(4),
                    _ED_ROW3 - _us3(1),
                    nm, _ed_msel_has3(hnd) && _ed_tab3 == 0)) {
            if (key_down(K_LCTRL)) { ed_select_toggle3d(hnd); }
            else { ed_select3d(hnd); }
            _ed_tab3 = 0;
        }
        r = r + 1;
    }
    // Bölgeler varlıkların ALTINDA, ayrı bir grup: entity değiller (motor
    // onları ayrı tutuyor) ama sahnenin parçalarılar ve seçilebilmeleri
    // gerekiyor.
    int zn = length(_trg_x);
    int zr = 0;
    while (zr < zn && r + zr < rows) {
        str zl = "bolge." + toString(zr) + " (" + _sc_tag_nm3(_trg_tag[zr]) + ")";
        if (_ed_match3(zl, _ed_filter3)) {
            if (_g_item(13000 + zr, px + _us3(2), listy + (r + zr) * _ED_ROW3,
                        pw - _us3(4), _ED_ROW3 - _us3(1), zl,
                        _ed_tab3 == 2 && _ed_zsel3 == zr)) {
                _ed_tab3 = 2;
                _ed_zsel3 = zr;
                _ed_sel3e = 0 - 1;
            }
        }
        zr = zr + 1;
    }

    if (n == 0 && _ed_filter3 != "") {
        _g_txt3("eslesme yok: " + _ed_filter3, px + _ED_PAD3, listy + _us3(4),
                pw - _ED_PAD3 * 2, _G_DIM3());
    }
    if (n > rows) {
        _g_txt3(toString(_ed_hscroll3 + 1) + "-" + toString(_ed_hscroll3 + rows) +
                " / " + toString(n), px + _ED_PAD3, _ed_foot_y3(py, ph),
                pw - _ED_PAD3 * 2,
                _G_DIM3());
    }
}

func _ed_next_tag3(t): int {
    if (t == TAG_PLAYER) { return TAG_ITEM; }
    if (t == TAG_ITEM)   { return TAG_WALL; }
    if (t == TAG_WALL)   { return TAG_ENEMY; }
    if (t == TAG_ENEMY)  { return TAG_PROP; }
    return TAG_PLAYER;
}
func _ed_next_shape3(sh): int {
    // SHAPE_MODEL döngüde YOK: düğmeyle "model" yapmak modelsiz bir MODEL
    // varlık üretirdi. Modelli varlığın şekli zaten düğmeye bağlanmıyor.
    if (sh == SHAPE_CUBE)   { return SHAPE_SPHERE; }
    if (sh == SHAPE_SPHERE) { return SHAPE_CYL; }
    if (sh == SHAPE_CYL)    { return SHAPE_RAMP; }
    return SHAPE_CUBE;
}
// ---- Varlık tarayıcısı (editör) --------------------------------------------
// Modeli sahneye bağlamanın tek yolu KOD YAZMAKTI (`load_model` + elle handle).
// Yani editörle kurulabilen her şey ya küp ya küre kalıyordu; "kendi karakterin"
// editörün dışındaydı. Tarayıcı diski `file_glob` ile tarayıp bulduğu dosyaları
// tıklanır satırlara çeviriyor.
//
// Tarama HER KARE yapılmıyor — desen değişince ya da TARA'ya basılınca. Disk
// taraması karede bir yapılırsa editör panelin altında takılır.
str   _ed_asglob3   = "varliklar/*.glb";
array _ed_asfiles3  = [];
int   _ed_asdone3   = 0;    // bu desen tarandı mı
int   _ed_asopen3   = 0;    // tarayıcı açık mı
int   _ed_asscroll3 = 0;    // liste kaydırması (satır)

// Tarayıcının bir seferde gösterdiği satır sayısı. Panel zaten kaydırılabilir
// ama liste ONUN İÇİNDE de kaydırılıyor: 300 dosyalık bir klasör paneli
// kilometrelerce uzatır ve altındaki DAVRANIŞLAR bölümü erişilemez olurdu.
func _ed_as_rows3(): int { return 6; }

// Ses tarayıcısı — model tarayıcısının kardeşi. Ayrı desen ve ayrı liste
// tutuyor (sesler .wav/.ogg, modeller .glb), ama AÇIK OLAN kural indeksi
// tek: iki kuralın tarayıcısı aynı anda açık olsaydı ikisi de aynı widget
// kimliklerini kullanırdı.
str   _ed_texglob3   = "examples/assets/dokular/*.png";
array _ed_texfiles3  = [];
int   _ed_texdone3   = 0;
int   _ed_texopen3   = 0;
int   _ed_texscroll3 = 0;

func _ed_tex_scan3() {
    _ed_texfiles3 = file_glob(_ed_texglob3);
    _ed_texdone3 = 1;
    _ed_texscroll3 = 0;
}

str   _ed_sndglob3   = "examples/assets/sesler/*.wav";
array _ed_sndfiles3  = [];
int   _ed_snddone3   = 0;
int   _ed_sndopen3   = 0 - 1;   // açık kuralın indeksi (-1 = kapalı)
// Bölge panelinin kendi bayrağı. Kuralınki bir İNDEKS (hangi kural), bölgede
// aynı anda tek bölge seçili olduğu için 0/1 yetiyor. İkisi aynı widget
// bloğunu paylaşıyor ama farklı sekmelerde çizildikleri için çakışmıyorlar.
int   _ed_zsndopen3  = 0;
int   _ed_sndscroll3 = 0;

func _ed_snd_scan3() {
    _ed_sndfiles3 = file_glob(_ed_sndglob3);
    _ed_snddone3 = 1;
    _ed_sndscroll3 = 0;
}

// Liste kaydırmasını sınırlara kelepçele. Ayrı fonksiyon: dosya sayısı
// azalınca (yeni tarama, daha dar desen) eski kaydırma listenin dışında
// kalıyor ve panel boş görünüyordu — sınanabilir olması bunun için.
func _ed_as_clamp3(sc, n, rows): int {
    if (sc > n - rows) { sc = n - rows; }
    if (sc < 0) { sc = 0; }
    return sc;
}

// Klip indeksini modelin gerçek klip sayısına kelepçele. -1 = klip yok.
// Kelepçesiz bir indeks çizimde var olmayan animasyona uzanıyor; motor onu
// yok sayıyor, yani karakter sessizce T-poz kalıyordu.
// n = 0 (klipsiz model) için ayrı bir dal YOK ve gerekmiyor: üst sınır
// `n - 1` = -1 olduğu için 0 ve üstü zaten -1'e iniyor, -1'in altı da öyle.
// Dal yazılmıştı; enjeksiyon onu silince hiçbir test kırılmadı — ölü koddu.
func _ed_anim_clamp3(v, n): int {
    if (v < 0 - 1) { return 0 - 1; }
    if (v > n - 1) { return n - 1; }
    return v;
}

func _ed_asset_scan3() {
    _ed_asfiles3 = file_glob(_ed_asglob3);
    _ed_asdone3 = 1;
    _ed_asscroll3 = 0;
}

// Yolun son parçası. Liste dar; tam yol yazmak her satırı "varliklar/…" ile
// başlatıp ayırt edici kısmı kırpardı.
func _ed_basename3(path): str {
    int i = length(path) - 1;
    while (i >= 0) {
        int c = ord(path, i);
        if (c == 47 || c == 92) { return substring(path, i + 1, length(path)); }
        i = i - 1;
    }
    return path;
}

// Bir modelin gerçekten yüklenip yüklenmediği. Pencere yokken ya da dosya
// bozukken handle -1 kalıyor; kullanıcıya "atadım" deyip hiçbir şey
// göstermemek en kötü geri bildirim olurdu.
func _ed_as_loaded3(path): int {
    int k = _as_find3(path, AS_MODEL3);
    if (k < 0) { return 0 - 1; }      // hiç denenmedi
    if (_as_h3[k] >= 0) { return 1; }
    return 0;                          // denendi, olmadı
}

// Etiketli sayı alanı: etiket solda, alan sağda. Panelin her yerinde aynı
// hizayı verdiği için davranış blokları sütun sütun okunuyor.
func _ed_bhf3(wid, x, y, lw, fw, label, val, step): float {
    _g_txt3(label, x, _g_ly3(y), lw - 2, _G_DIM3());
    return _g_num(wid, x + lw, y, fw, _ED_FLD3, val, step);
}

func _ed_bh_name3(k): str {
    if (k == BH_MOVE)   { return "hareket"; }
    if (k == BH_CHASE)  { return "kovala"; }
    if (k == BH_PATROL) { return "devriye"; }
    if (k == BH_SPIN)   { return "don"; }
    if (k == BH_BOB)    { return "salin"; }
    if (k == BH_FLOAT)  { return "yuz"; }
    return "ates";
}

// Üç eşit sayı alanı için sütun genişliği — panel genişliğinden türüyor.
func _ed_f3w3(pw, labw): int {
    return toInt((pw - _ED_PAD3 * 2 - labw - 8) / 3);
}

// Inspector sekmesi: 0 = seçili varlık, 1 = dünya ayarları.
// 0 = seçili varlık, 1 = dünya ayarları, 2 = seçili BÖLGE.
int _ed_tab3 = 0;
int _ed_zsel3 = 0 - 1;   // seçili bölge indeksi
// Düz sürüklemenin HEDEFİ: -1 = varlık(lar), >=0 = bölge indeksi. Jestin
// başında yazılıyor, bırakınca sıfırlanıyor.
int _ed_drag_z3 = 0 - 1;
// Inspector kaydırması. Panel içeriği (çok davranışlı bir varlık, dünya
// ayarları + kurallar) panelden uzun olabiliyor; kırpma olmadan alttaki
// konsolun üstüne taşardı.
int _ed_iscroll3 = 0;
int _ed_icontent3 = 0;    // içeriğin bittiği y — MUTLAK (kaydırmadan bağımsız)

// İçeriğin kaydırmadan BAĞIMSIZ bitiş noktası. `_ed_icontent3` ekran
// koordinatında ve içinde kaydırma payı VAR (`y` zaten `- _ed_iscroll3` ile
// başlıyor). Kelepçe onu olduğu gibi kullanınca sınır kaydırdıkça küçülüyor
// ve kaydırma gerçek sona varmadan KİLİTLENİYORDU — hesapla: izin verilen
// en büyük kaydırma A-t-a iken, oraya varınca sınır A-s-t-a oluyor, yani
// yolun ancak YARISI gidilebiliyor. (Kullanıcı bildirdi: sağ panel bir yere
// kadar kayıyor, sonra duruyor.)
//
// Kaydırma çubuğu bu toplamayı zaten yapıyordu; kelepçe yapmıyordu. Tek
// fonksiyona alındı ki bir daha ayrılmasınlar.
// İçeriğin bitişini KAYDIRMADAN BAĞIMSIZ sakla. Çizim `y`yi ekran
// koordinatında biriktiriyor (`y` zaten `- _ed_iscroll3` ile başlıyor);
// kaydırmayı burada geri eklemek saklanan değeri MUTLAK yapıyor.
//
// Toplamayı OKUYAN tarafta yapmak yetmiyordu: kelepçe bir önceki karenin
// içeriğiyle bu karenin kaydırmasını eşleştiriyor ve ikisi bir tekerlek
// adımı kadar kayıyordu — kullanıcı içeriğin bir adım ötesine kayabiliyordu.
// Yazan tarafta yapınca eşleştirilecek bir şey kalmıyor.
func _ed_iset_content3(y) { _ed_icontent3 = y + _ed_iscroll3; }

// İnceleyicinin KAYDIRMA ADIMI. Ayrı fonksiyon çünkü çağrı çizim
// fonksiyonunun göbeğindeydi ve orada içerik hesabını bozmak hiçbir testi
// kırmıyordu (bozma denendi, kaçtı). Aynı ders dördüncü kez: kararı
// sınamak yetmiyor, ÇAĞRIYI da sürmek gerekiyor.
func _ed_iscroll_step3(ctop, cavail) {
    _ed_iscroll3 = _ed_clamp_scroll3(_ed_iscroll3, _ed_icontent3,
                                     ctop, cavail);
}

// Kaydırma sınırı. Döngünün içine gömülü kalsaydı penceresiz sınanamazdı; bu
// oturumda "sınanamayan yerdeki hata" birkaç kez tekrarlandı.
func _ed_clamp_scroll3(scroll, content, top, avail): int {
    int maxs = content - (top + avail);
    if (maxs < 0) { maxs = 0; }
    int v = scroll;
    if (v > maxs) { v = maxs; }
    if (v < 0) { v = 0; }
    return v;
}

func _ed_next_act3(a): int {
    if (a == ACT_COLLECT) { return ACT_DAMAGE; }
    if (a == ACT_DAMAGE)  { return ACT_KILL; }
    if (a == ACT_KILL)    { return ACT_HURT; }
    if (a == ACT_HURT)    { return ACT_WIN; }
    if (a == ACT_WIN)     { return ACT_LOSE; }
    if (a == ACT_LOSE)    { return ACT_NEXT; }
    return ACT_COLLECT;
}

// ---- Kurallar --------------------------------------------------------------
// Kurallar sahneyi OYUN yapan şey (topla / hasar ver / kazan / kaybet) ve
// şimdiye kadar yalnız JSON'a elle yazılabiliyordu — yani editörde kurulan bir
// sahne oynanabilir bir oyun olamıyordu.
// ---- Kural panelinin sözlüğü ------------------------------------------------
// Panel "player | item | collect | 50" gösteriyordu: dört kutu, hiçbir etiket.
// Hangi kutunun kim, hangisinin ne olduğu yalnız kaynağa bakınca anlaşılıyordu
// ve fark ÖNEMLİ — `hit_rule3d(oyuncu, dusman, ACT_DAMAGE)` OYUNCUYU yaralar,
// tarafları değiştirmek düşmanı yaralar. Üstelik adlar İngilizceydi.
// Adlar KISA tutuluyor ama yön korunuyor: "bana" ile "otekine" farkı bu
// panelin bütün amacı. (Uzun sürümler ölçüldü — 2x ölçekte 166 ve 174
// piksel, alan 160: ikisi de taşıyordu.)
func _ed_act_nm3(v): str {
    if (v == ACT_COLLECT) { return "topla +skor"; }
    if (v == ACT_DAMAGE)  { return "bana hasar"; }
    if (v == ACT_KILL)    { return "otekini oldur"; }
    if (v == ACT_HURT)    { return "otekine hasar"; }
    if (v == ACT_WIN)     { return "kazan"; }
    if (v == ACT_LOSE)    { return "kaybet"; }
    return "sonraki bolum";
}

// Eylem skor/hasar miktarını KULLANIYOR mu? Kullanmayanda sayı alanı
// gösterilmemeli: `oldur`/`kazan`/`kaybet` seçiliyken kullanıcı 50 yazıyor
// ve hiçbir şey olmuyordu (dağıtıcı o dallarda `n`e hiç bakmıyor).
func _ed_act_uses_n3(v): bool {
    if (v == ACT_COLLECT) { return true; }
    if (v == ACT_DAMAGE)  { return true; }
    if (v == ACT_HURT)    { return true; }
    return false;
}
func _ed_act_n_lbl3(v): str {
    if (v == ACT_COLLECT) { return "skor"; }
    return "hasar";
}

// "bitince" kuralında ne yapılabilir? Dağıtıcıya `me`/`other` olarak -1
// geçiliyor (ortada çarpışan bir çift yok), dolayısıyla topla / öldür /
// hasar SESSİZ birer boş işlem: kullanıcı seçiyor, oyun hiç tepki vermiyor.
// İş gören yalnız kazan ve kaybet — düğme de yalnız onları dolaşıyor.
func _ed_act_works_cleared3(v): bool {
    if (v == ACT_WIN)  { return true; }
    if (v == ACT_LOSE) { return true; }
    // "Sonraki bölüm" de çift istemiyor: bölüm sistemine konuşuyor, çarpışan
    // gövdelere değil. Çok bölümlü bir sahnede EN ÇOK kullanılacak bitiş bu
    // ("altınlar bitti → sonraki bölüm").
    if (v == ACT_NEXT) { return true; }
    return false;
}
func _ed_next_act_for3(kind, a): int {
    if (kind == RULE_CLEARED) {
        if (a == ACT_WIN)  { return ACT_LOSE; }
        if (a == ACT_LOSE) { return ACT_NEXT; }
        return ACT_WIN;
    }
    return _ed_next_act3(a);
}

// Kuralın düz Türkçe özeti — panelin en önemli satırı. Etiket düğmeleri
// "kim kime" sorusunu yanıtlayamıyor; bu cümle yanıtlıyor.
// Cümle yalnız SONUCU söylüyor, tarafları tekrar etmiyor: "kim"/"neye"
// alanları hemen üstte duruyor. İlk sürüm tam cümle kuruyordu ve 2x ölçekte
// 462 piksele çıkıyordu (panel 280) — yani panelin en öğretici satırı
// kırpılarak gösterilecekti. Yön, hasar alan tarafın ADIYLA korunuyor.
func _ed_rule_ozet3(kind, a, b, act, n): str {
    str na = _sc_tag_nm3(a);
    str nb = _sc_tag_nm3(b);
    if (kind == RULE_CLEARED) {
        if (act == ACT_WIN)  { return "-> oyun KAZANILIR"; }
        if (act == ACT_LOSE) { return "-> oyun KAYBEDILIR"; }
        if (act == ACT_NEXT) { return "-> SONRAKI BOLUM"; }
        return "-> BIR SEY YAPMAZ";
    }
    if (act == ACT_COLLECT) { return "-> " + nb + " toplanir +skor"; }
    if (act == ACT_DAMAGE)  { return "-> " + na + " hasar alir"; }
    if (act == ACT_KILL)    { return "-> " + nb + " olur"; }
    if (act == ACT_HURT)    { return "-> " + nb + " hasar alir"; }
    if (act == ACT_WIN)     { return "-> oyun KAZANILIR"; }
    if (act == ACT_LOSE)    { return "-> oyun KAYBEDILIR"; }
    return "-> SONRAKI BOLUM";
}

// Kimlik bloğu — davranışlardaki gibi kaynaktan okunabilir olsun diye
// fonksiyon; sabitleri teste kopyalamak bir kimlik çakışmasını gizlemişti.
// Kural bloğu 21000'den 60000'e taşındı: ses satırı gelince blok başına
// widget 5'ten 7'ye çıktı ve adım 10 oldu; eski tabanda 100 kural
// "+carpisma"/"+bitince" düğmelerine (21900/21901) ulaşıyordu. 60000
// varlık tarayıcısının (50000-51050) da üstünde kalıyor.
func _ed_rl_idbase3(): int { return 60000; }
func _ed_rl_idstep3(): int { return 10; }
func _ed_rl_idused3(): int { return 7; }
// Ses tarayıcısı SABİT blok: bir anda yalnız TEK kuralın tarayıcısı açık.
func _ed_snd_idbase3(): int { return 51000; }

// Ses tarayıcısı. Model tarayıcısıyla aynı iskelet.
//
// KİME yazacağını BİLMİYOR: yürürlükteki yolu parametre olarak alıyor,
// seçilen yolu `_ed_snd_pick3` ile bildiriyor ve yazma işini çağırana
// bırakıyor. Böylece aynı tarayıcı hem KURALA hem BÖLGEYE hizmet ediyor;
// ikinci bir kopya çıkarmak, ses listesini iki yerde bakımı gereken bir şey
// yapardı. (Dönüş değeri yeni y — Tulpar'da çoklu dönüş yok, o yüzden seçim
// global ile geliyor; motorun başka yerlerinde de aynı desen var.)
//
// Widget kimlikleri SABİT bir blok (51000..51051) ve bu, "bir anda yalnız
// TEK tarayıcı açık" kuralına dayanıyor. Kural paneli DÜNYA sekmesinde
// (_ed_tab3 == 1), bölge paneli BÖLGE sekmesinde (== 2) çiziliyor: ikisi
// aynı karede asla çizilmiyor, yani blok paylaşımı güvenli.
str _ed_snd_pick3 = "";

func _ed_snd_browser3(lx, y, inner, cur): int {
    _ed_snd_pick3 = "";
    int base = _ed_snd_idbase3();
    int tbw = _us3(38);
    str g0 = _ed_sndglob3;
    str g1 = _g_text(base, lx, y, inner - tbw - 4, _ED_FLD3, g0);
    if (g1 != g0) { _ed_sndglob3 = g1; _ed_snddone3 = 0; }
    _g_tip_for3(base, _ed_sndglob3);
    if (_g_button(base + 1, lx + inner - tbw, y, tbw, _ED_FLD3, "TARA")) {
        _ed_snd_scan3();
    }
    _g_tip_for3(base + 1, "Deseni diskte ara (* ve ? calisir)");
    y = y + _ED_FLD3 + _us3(3);

    int an = length(_ed_sndfiles3);
    if (an == 0) {
        str emsg = "eslesme yok";
        if (_ed_snddone3 == 0) { emsg = "TARA'ya bas"; }
        _g_txt3(emsg, lx, _g_ly3(y), inner, _G_DIM3());
        y = y + _g_lh3();
    }
    int rows = _ed_as_rows3();
    _ed_sndscroll3 = _ed_as_clamp3(_ed_sndscroll3, an, rows);
    int ai = _ed_sndscroll3;
    int shown = 0;
    while (ai < an && shown < rows) {
        str apath = _ed_sndfiles3[ai];
        int rw = base + 10 + shown * 2;
        if (_g_tog(rw, lx, y, inner, _ED_FLD3, _ed_basename3(apath), apath == cur)) {
            _ed_snd_pick3 = apath;
        }
        _g_tip_for3(rw, apath);
        y = y + _ED_FLD3 + _us3(2);
        ai = ai + 1;
        shown = shown + 1;
    }
    if (an > rows) {
        int pbw = _us3(30);
        if (_g_button(base + 40, lx, y, pbw, _ED_FLD3, "^")) {
            _ed_sndscroll3 = _ed_sndscroll3 - rows;
        }
        if (_g_button(base + 41, lx + pbw + 4, y, pbw, _ED_FLD3, "v")) {
            _ed_sndscroll3 = _ed_sndscroll3 + rows;
        }
        _g_txt3(toString(_ed_sndscroll3 + 1) + "-" + toString(_ed_sndscroll3 + shown) +
                " / " + toString(an), lx + (pbw + 4) * 2, _g_ly3(y),
                inner - (pbw + 4) * 2, _G_DIM3());
        y = y + _ED_FLD3 + _us3(2);
    }
    return y + _us3(2);
}

// ---- Işık paneli -------------------------------------------------------------
// Nokta ışık motorda vardı ve scene3d onu HİÇ çağırmıyordu: sahnede meşale,
// lamba, ateş yoktu. Panel ışıkları YERLEŞTİRİLMİŞ içerik olarak gösteriyor
// (bölgeler gibi), tek bir dünya ayarı olarak değil.
func _ed_lt_idbase3(): int { return 53000; }
func _ed_lt_idstep3(): int { return 10; }
func _ed_lt_idused3(): int { return 7; }

// Işık için hazır renkler. Tam RGB düzenleyici bu dar panelde üç satır
// yerdi; ışık rengi zaten birkaç kullanışlı değerden seçiliyor.
func _ed_lt_next_col3(c): int {
    if (c == WHITE)                 { return rgb(255, 214, 150); }  // sicak
    if (c == rgb(255, 214, 150))    { return GOLD; }
    if (c == GOLD)                  { return rgb(255, 120, 70); }   // ates
    if (c == rgb(255, 120, 70))     { return rgb(120, 180, 255); }  // soguk
    if (c == rgb(120, 180, 255))    { return rgb(140, 255, 170); }  // yesil
    return WHITE;
}
func _ed_lt_col_nm3(c): str {
    if (c == WHITE)              { return "beyaz"; }
    if (c == rgb(255, 214, 150)) { return "sicak"; }
    if (c == GOLD)               { return "altin"; }
    if (c == rgb(255, 120, 70))  { return "ates"; }
    if (c == rgb(120, 180, 255)) { return "soguk"; }
    if (c == rgb(140, 255, 170)) { return "yesil"; }
    return "ozel";
}

func _ed_lights_panel3(px, y, pw): int {
    int lx = px + _ED_PAD3;
    int inner = pw - _ED_PAD3 * 2;
    int labw = _us3(26);
    int fw = _ed_f3w3(pw, labw);
    int fx = lx + labw;
    int xw = _us3(16);
    int n = light_count3d();

    // MOTOR SINIRI görünür: aynı anda en çok 3 ışık yanıyor, motor kameraya
    // en yakınları seçiyor. Bunu söylemezsek 6 lamba koyan biri "üçü neden
    // yanmıyor" diye kaynağa bakmak zorunda kalır.
    if (n > light_slots3d()) {
        // Kısa tutuluyor: uzun sürüm ölçüldü, 414 piksel (panel 280).
        _g_txt3(toString(n) + " lamba, " + toString(light_slots3d()) + " yanar",
                lx, _g_ly3(y), inner, _G_WARN3());
        y = y + _g_lh3();
        _g_txt3("(kameraya en yakinlar)", lx, _g_ly3(y), inner, _G_DIM3());
        y = y + _g_lh3();
    }

    int i = 0;
    while (i < n) {
        int wid = _ed_lt_idbase3() + i * _ed_lt_idstep3();
        // Yanan ışıklar işaretli: seçimin ne yaptığı görünsün.
        str bas = "isik " + toString(i + 1);
        int bc = _G_DIM3();
        int k = 0;
        while (k < length(_lt_pick3)) {
            if (_lt_pick3[k] == i) { bas = bas + "  (yaniyor)"; bc = _G_ACC3(); }
            k = k + 1;
        }
        _g_txt3(bas, lx, _g_ly3(y), inner - xw - 4, bc);
        if (_g_button(wid, px + pw - _ED_PAD3 - xw, y, xw, _ED_FLD3, "x")) {
            ed_mark3d();
            light_del3d(i);
            return y;   // dizi degisti; bu kareyi burada bitir
        }
        y = y + _ED_FLD3 + _us3(2);

        _g_txt3("kon", lx, _g_ly3(y), labw - 2, _G_DIM3());
        float nx = _g_num(wid + 1, fx, y, fw, _ED_FLD3, light_x3d(i), 0.1);
        float ny = _g_num(wid + 2, fx + fw + 4, y, fw, _ED_FLD3, light_y3d(i), 0.1);
        float nz = _g_num(wid + 3, fx + (fw + 4) * 2, y, fw, _ED_FLD3, light_z3d(i), 0.1);
        if (nx != light_x3d(i) || ny != light_y3d(i) || nz != light_z3d(i)) {
            ed_mark3d();
            light_move3d(i, nx, ny, nz);
        }
        y = y + _ED_FLD3 + _us3(2);

        // Menzil ve renk AYRI satırlarda ve GENİŞ etiket sütunuyla. Aynı
        // satıra sıkıştırılmışlardı ve ölçüm gösterdi: "menzil" 56 piksel,
        // dar sütun 50 — etiketin kendisi taşıyordu.
        int wlw = _ed_bh_lblw3(inner);
        _g_txt3("menzil", lx, _g_ly3(y), wlw - 2, _G_DIM3());
        float nr = _g_num(wid + 4, lx + wlw, y, _ed_bh_fieldw3(inner), _ED_FLD3,
                          light_range3d(i), 0.5);
        if (nr != light_range3d(i)) { ed_mark3d(); light_set_range3d(i, nr); }
        _g_tip_for3(wid + 4, "Isigin ne kadar uzaga vurdugu");
        y = y + _ED_FLD3 + _us3(2);

        _g_txt3("renk", lx, _g_ly3(y), wlw - 2, _G_DIM3());
        int cw = inner - wlw - xw - 4;
        if (_g_button(wid + 5, lx + wlw, y, cw, _ED_FLD3,
                      _ed_lt_col_nm3(light_color3d(i)))) {
            ed_mark3d();
            light_set_color3d(i, _ed_lt_next_col3(light_color3d(i)));
        }
        rect(px + pw - _ED_PAD3 - xw, y, xw, _ED_FLD3, light_color3d(i));
        rect_lines(px + pw - _ED_PAD3 - xw, y, xw, _ED_FLD3, _G_LINE3());
        y = y + _ED_FLD3 + _us3(5);
        i = i + 1;
    }

    // Ekleme düğmesi ışık bloğunun ALTINDA (52900), üstünde değil: 53000
    // tabanında adım 10 ile 90. ışık 53900'e ulaşıyordu ve düğmeyle
    // çakışıyordu. Doku tarayıcısı 52051'de bitiyor, arada boşluk var.
    if (_g_button(52900, lx, y, inner, _ED_FLD3, "+ ISIK EKLE")) {
        ed_mark3d();
        // Kameranın baktığı yere değil, ORTAYA koyuyoruz ve yukarı: yeni
        // ışığın nerede olduğu belli olsun, sonra konumdan taşınsın.
        light3d(0.0, 4.0, 0.0, rgb(255, 214, 150), 12.0);
    }
    _g_tip_for3(52900, "Sahneye nokta isik ekle (mesale, lamba)");
    y = y + _ED_FLD3 + _us3(6);
    return y;
}

// Doku tarayıcısı — ses/model tarayıcılarının kardeşi.
func _ed_tex_browser3(lx, y, inner, id): int {
    int base = 52010;
    int tbw = _us3(38);
    str g0 = _ed_texglob3;
    str g1 = _g_text(base, lx, y, inner - tbw - 4, _ED_FLD3, g0);
    if (g1 != g0) { _ed_texglob3 = g1; _ed_texdone3 = 0; }
    // Alan deseni KIRPIYOR (ölçüldü: varsayılan desen 336 piksel, alan 194)
    // ve düzenlerken de kırpık görünüyor — tam hâli ipucunda.
    _g_tip_for3(base, _ed_texglob3);
    if (_g_button(base + 1, lx + inner - tbw, y, tbw, _ED_FLD3, "TARA")) {
        _ed_tex_scan3();
    }
    _g_tip_for3(base + 1, "Deseni diskte ara (* ve ? calisir)");
    y = y + _ED_FLD3 + _us3(3);

    int an = length(_ed_texfiles3);
    if (an == 0) {
        str emsg = "eslesme yok";
        if (_ed_texdone3 == 0) { emsg = "TARA'ya bas"; }
        _g_txt3(emsg, lx, _g_ly3(y), inner, _G_DIM3());
        y = y + _g_lh3();
    }
    int rows = _ed_as_rows3();
    _ed_texscroll3 = _ed_as_clamp3(_ed_texscroll3, an, rows);
    int ai = _ed_texscroll3;
    int shown = 0;
    str cur = texture_src3d(id);
    while (ai < an && shown < rows) {
        str apath = _ed_texfiles3[ai];
        int rw = base + 10 + shown * 2;
        if (_g_tog(rw, lx, y, inner, _ED_FLD3, _ed_basename3(apath), apath == cur)) {
            ed_mark3d();
            set_texture3d(id, apath, texture_tile3d(id));
            _ed_texopen3 = 0;   // seçince kapan
        }
        _g_tip_for3(rw, apath);
        y = y + _ED_FLD3 + _us3(2);
        ai = ai + 1;
        shown = shown + 1;
    }
    if (an > rows) {
        int pbw = _us3(30);
        if (_g_button(base + 40, lx, y, pbw, _ED_FLD3, "^")) {
            _ed_texscroll3 = _ed_texscroll3 - rows;
        }
        if (_g_button(base + 41, lx + pbw + 4, y, pbw, _ED_FLD3, "v")) {
            _ed_texscroll3 = _ed_texscroll3 + rows;
        }
        _g_txt3(toString(_ed_texscroll3 + 1) + "-" + toString(_ed_texscroll3 + shown) +
                " / " + toString(an), lx + (pbw + 4) * 2, _g_ly3(y),
                inner - (pbw + 4) * 2, _G_DIM3());
        y = y + _ED_FLD3 + _us3(2);
    }
    return y + _us3(2);
}

func _ed_rules_panel3(px, y, pw): int {
    int lx = px + _ED_PAD3;
    int inner = pw - _ED_PAD3 * 2;
    int lw = _ed_bh_lblw3(inner);      // davranış bloklarıyla AYNI hiza
    int fw = _ed_bh_fieldw3(inner);
    int xw = _us3(16);
    int i = 0;
    while (i < length(_rl3)) {
        Rule3 r = _rl3[i];
        int wid = _ed_rl_idbase3() + i * _ed_rl_idstep3();

        // Başlık satırı: kuralın TÜRÜ solda, sil sağda.
        str kn = "CARPISMA";
        if (r.kind == RULE_CLEARED) { kn = "BITINCE"; }
        _g_txt3(kn, lx, _g_ly3(y), inner - xw - 4, _G_ACC3());
        if (_g_button(wid, px + pw - _ED_PAD3 - xw, y, xw, _ED_FLD3, "x")) {
            ed_mark3d();
            int last = length(_rl3) - 1;
            if (i != last) { _rl3[i] = _rl3[last]; }
            pop(_rl3);
            return y;   // dizi değişti; bu kareyi burada bitir
        }
        y = y + _ED_FLD3 + _us3(2);

        if (r.kind == RULE_HIT) {
            _g_txt3("kim", lx, _g_ly3(y), lw - 2, _G_DIM3());
            if (_g_button(wid + 1, lx + lw, y, fw, _ED_FLD3, _sc_tag_nm3(r.a))) {
                ed_mark3d();
                Rule3 nr = _rl3[i]; nr.a = _ed_next_tag3(nr.a); _rl3[i] = nr;
            }
            y = y + _ED_FLD3 + _us3(2);
            _g_txt3("neye", lx, _g_ly3(y), lw - 2, _G_DIM3());
            if (_g_button(wid + 2, lx + lw, y, fw, _ED_FLD3, _sc_tag_nm3(r.b))) {
                ed_mark3d();
                Rule3 nr2 = _rl3[i]; nr2.b = _ed_next_tag3(nr2.b); _rl3[i] = nr2;
            }
            y = y + _ED_FLD3 + _us3(2);
        } else {
            _g_txt3("hangisi", lx, _g_ly3(y), lw - 2, _G_DIM3());
            if (_g_button(wid + 1, lx + lw, y, fw, _ED_FLD3, _sc_tag_nm3(r.a))) {
                ed_mark3d();
                Rule3 nr3 = _rl3[i]; nr3.a = _ed_next_tag3(nr3.a); _rl3[i] = nr3;
            }
            y = y + _ED_FLD3 + _us3(2);
        }

        _g_txt3("olunca", lx, _g_ly3(y), lw - 2, _G_DIM3());
        if (_g_button(wid + 3, lx + lw, y, fw, _ED_FLD3, _ed_act_nm3(r.act))) {
            ed_mark3d();
            Rule3 nr4 = _rl3[i];
            nr4.act = _ed_next_act_for3(nr4.kind, nr4.act);
            _rl3[i] = nr4;
        }
        y = y + _ED_FLD3 + _us3(2);

        // Sayı alanı YALNIZ eylem onu kullanıyorsa. Kullanmayan eylemde
        // gösterilmesi "50 yaz, hiçbir şey olmasın" demekti.
        if (r.kind == RULE_HIT && _ed_act_uses_n3(r.act)) {
            _g_txt3(_ed_act_n_lbl3(r.act), lx, _g_ly3(y), lw - 2, _G_DIM3());
            float nn = _g_num(wid + 4, lx + lw, y, fw, _ED_FLD3, r.n, 1.0);
            if (nn != r.n) { Rule3 nr5 = _rl3[i]; nr5.n = nn; _rl3[i] = nr5; }
            y = y + _ED_FLD3 + _us3(2);
        }

        // -- SES --
        // Motorun konumsal sesi vardı ve hiçbir şey onu çağırmıyordu: her
        // oyun sessizdi. Kural motoru zaten "X, Y'ye değince" biliyor;
        // sesin bağlanacağı doğal yer burası.
        // Bu satır sütun hizasını BİLEREK kırıyor: içeriği bir dosya adı,
        // hizalanacak bir sayı değil. Etiket sütununda kalsaydı düğmeye 126
        // piksel düşüyordu (ölçüldü) ve sıradan bir ses adı bile kırpılıyordu;
        // tam genişlikte 244 piksel var.
        int sxw = _us3(16);
        str scur = "ses: yok";
        if (r.snd != "") { scur = "ses: " + _ed_basename3(r.snd); }
        if (_g_button(wid + 5, lx, y, inner - sxw - 4, _ED_FLD3, scur)) {
            if (_ed_sndopen3 == i) { _ed_sndopen3 = 0 - 1; }
            else {
                _ed_sndopen3 = i;
                if (_ed_snddone3 == 0) { _ed_snd_scan3(); }
            }
        }
        // İpucu YOLU gösteriyor: uzun bir ad düğmede kırpılıyor, tam hâlini
        // görecek bir yer kalmalı.
        str stip = "Kural islerken calacak ses";
        if (r.snd != "") { stip = r.snd; }
        _g_tip_for3(wid + 5, stip);
        if (r.snd != "") {
            if (_g_button(wid + 6, lx + inner - sxw, y, sxw, _ED_FLD3, "x")) {
                ed_mark3d();
                _rl_set_snd3(i, "");
            }
        }
        y = y + _ED_FLD3 + _us3(2);

        if (_ed_sndopen3 == i) {
            y = _ed_snd_browser3(lx, y, inner, rule_sound_path3d(i));
            if (_ed_snd_pick3 != "") {
                ed_mark3d();
                _rl_set_snd3(i, _ed_snd_pick3);
                _ed_sndopen3 = 0 - 1;   // seçince kapan: liste bloğu şişirmesin
            }
        }

        // Düz Türkçe özet — kuralın ne yaptığını okumak için kaynağa
        // bakmak gerekmesin diye. Yanlış kurulmuş kural burada kendini
        // ele veriyor ("bu eylem BIR SEY YAPMAZ").
        int oc = _G_DIM3();
        if (r.kind == RULE_CLEARED && !_ed_act_works_cleared3(r.act)) {
            oc = _G_WARN3();
        }
        _g_txt3(_ed_rule_ozet3(r.kind, r.a, r.b, r.act, r.n), lx, _g_ly3(y),
                inner, oc);
        y = y + _ED_FLD3 + _us3(5);
        i = i + 1;
    }
    int half = toInt((inner - 4) / 2);
    if (_g_button(21900, lx, y, half, _ED_FLD3, "+carpisma")) {
        ed_mark3d(); hit_rule3d(TAG_PLAYER, TAG_ITEM, ACT_COLLECT, 50.0);
    }
    _g_tip_for3(21900, "Iki etiket degince ne olsun");
    if (_g_button(21901, lx + half + 4, y, half, _ED_FLD3, "+bitince")) {
        ed_mark3d(); cleared_rule3d(TAG_ITEM, ACT_WIN);
    }
    _g_tip_for3(21901, "Bir etiketten hic kalmayinca ne olsun");
    return y + _ED_FLD3;
}

// ---- Dünya ayarları --------------------------------------------------------
// Sahne biçimi bunların hepsini zaten taşıyor; editörden düzenlenememeleri tek
// eksikti. Gökyüzü/sis/su/arazi elle JSON yazmadan ayarlanamıyordu.
func _ed_world_panel3(px, py, pw) {
    int lx = px + _ED_PAD3;
    int inner = pw - _ED_PAD3 * 2;
    int half = toInt((inner - 4) / 2);
    int labw = _us3(30);
    int fw = _ed_f3w3(pw, labw);
    int fx = lx + labw;
    int y = py;

    // SAHNE DENETİMİ en üstte: yarım kalmış bir oyunun neyi eksik olduğu
    // ilk görülecek şey olmalı. Sorun yoksa tek satır yer kaplıyor.
    _g_section(px + 2, y, pw - 4, "SAHNE DENETIMI");
    y = y + _us3(16);
    int sorun = scene_check_count3d();
    if (sorun == 0) {
        _g_txt3("sorun yok — oynanabilir", lx, y, inner, rgb(140, 220, 150));
        y = y + _g_lh3() + _us3(4);
    } else {
        int ci = 0;
        while (ci < sorun && ci < 8) {
            _g_txt3("! " + scene_check_msg3d(ci), lx, y, inner, _G_WARN3());
            y = y + _g_lh3();
            ci = ci + 1;
        }
        if (sorun > 8) {
            _g_txt3("(+" + toString(sorun - 8) + " daha)", lx, y, inner, _G_DIM3());
            y = y + _g_lh3();
        }
        y = y + _us3(4);
    }

    _g_section(px + 2, y, pw - 4, "GOKYUZU");
    y = y + _us3(16);
    str sk = "gokyuzu: yok";
    if (_sky3 == 1) { sk = "gokyuzu: var"; }
    if (_g_tog(9700, lx, y, inner, _ED_FLD3, sk, _sky3 == 1)) {
        ed_mark3d();
        if (_sky3 == 1) { sky3d_off(); }
        else { sky3d(rgb(58, 116, 200), rgb(196, 220, 240)); }
    }
    y = y + _ED_FLD3 + _us3(3);
    if (_sky3 == 1) {
        _g_txt3("ust", lx, _g_ly3(y), labw - 2, _G_DIM3());
        float tr = _g_num(9701, fx, y, fw, _ED_FLD3, _col_r3(_sky_top3) * 1.0, 1.0);
        float tg = _g_num(9702, fx + fw + 4, y, fw, _ED_FLD3, _col_g3(_sky_top3) * 1.0, 1.0);
        float tb = _g_num(9703, fx + (fw + 4) * 2, y, fw, _ED_FLD3, _col_b3(_sky_top3) * 1.0, 1.0);
        _sky_top3 = rgb(_ed_c255(tr), _ed_c255(tg), _ed_c255(tb));
        y = y + _ED_FLD3 + _us3(3);
        _g_txt3("alt", lx, _g_ly3(y), labw - 2, _G_DIM3());
        float br = _g_num(9704, fx, y, fw, _ED_FLD3, _col_r3(_sky_bot3) * 1.0, 1.0);
        float bg = _g_num(9705, fx + fw + 4, y, fw, _ED_FLD3, _col_g3(_sky_bot3) * 1.0, 1.0);
        float bb = _g_num(9706, fx + (fw + 4) * 2, y, fw, _ED_FLD3, _col_b3(_sky_bot3) * 1.0, 1.0);
        _sky_bot3 = rgb(_ed_c255(br), _ed_c255(bg), _ed_c255(bb));
        y = y + _ED_FLD3 + _us3(3);
    }
    _g_txt3("sis", lx, _g_ly3(y), labw - 2, _G_DIM3());
    _fog3 = _g_num(9707, fx, y, fw, _ED_FLD3, _fog3, 0.001);
    if (_fog3 < 0.0) { _fog3 = 0.0; }
    _g_txt3("bulut", fx + fw + _us3(6), _g_ly3(y), _us3(30), _G_DIM3());
    float bl = _g_num(9708, fx + fw + _us3(38), y, fw, _ED_FLD3, _cloud3, 0.02);
    if (bl != _cloud3) { clouds3d(bl); }
    y = y + _ED_FLD3 + _us3(6);

    _g_section(px + 2, y, pw - 4, "DUNYA");
    y = y + _us3(16);
    str gr = "zemin: yok";
    if (_ground_on == 1) { gr = "zemin: var"; }
    if (_g_tog(9710, lx, y, half, _ED_FLD3, gr, _ground_on == 1)) {
        ed_mark3d();
        if (_ground_on == 1) { no_ground3d(); } else { ground3d(_ground_y); }
    }
    _ground_y = _g_num(9711, lx + half + 4, y, half, _ED_FLD3, _ground_y, 0.1);
    y = y + _ED_FLD3 + _us3(3);
    _g_txt3("yer", lx, _g_ly3(y), labw - 2, _G_DIM3());
    _grav = _g_num(9712, fx, y, fw, _ED_FLD3, _grav, 0.2);
    str lt = "isik";
    if (_g_tog(9713, fx + fw + 4, y, fw, _ED_FLD3, lt, _lights3 == 1)) {
        ed_mark3d();
        if (_lights3 == 1) { _lights3 = 0; } else { _lights3 = 1; }
    }
    if (_g_tog(9714, fx + (fw + 4) * 2, y, fw, _ED_FLD3, "golge", _shadows3 == 1)) {
        ed_mark3d();
        if (_shadows3 == 1) { _shadows3 = 0; } else { _shadows3 = 1; }
    }
    y = y + _ED_FLD3 + _us3(6);

    // ---- KAMERA ----
    // Oyuncudan sonra bir oyunu en çok tanımlayan şey ve buraya kadar hiç
    // arayüzü yoktu: mod da hedef de mesafe de yalnız JSON elle açılarak
    // değiştirilebiliyordu.
    _g_section(px + 2, y, pw - 4, "KAMERA");
    y = y + _us3(16);
    int cb = _ed_cam_idbase3();
    if (_g_button(cb, lx, y, half, _ED_FLD3, _cam_mode_nm3(_cam_mode3))) {
        ed_mark3d();
        int ym = _cam_next_mode3(_cam_mode3);
        _ed_cam_apply3(ym, _cam_target, _cam_dist_logical3(), _cam_height);
    }
    _g_tip_for3(cb, "takip / yorunge / birinci sahis");
    if (_g_button(cb + 1, lx + half + 4, y, half, _ED_FLD3,
                  _ed_cam_target_nm3())) {
        ed_mark3d();
        int yt = _ed_cam_next_target3(_cam_target);
        _ed_cam_apply3(_cam_mode3, yt, _cam_dist_logical3(), _cam_height);
    }
    _g_tip_for3(cb + 1, "Kameranin izledigi varlik — sirayla gezer");
    y = y + _ED_FLD3 + _us3(3);
    // Hedefi SİLİNMİŞ kamera sessiz kalmasın: düğmeye basılınca düzeliyor
    // ama önce bir şeyin bozuk olduğunu bilmek gerekiyor.
    if (_cam_target >= 0 && camera_target_ok3d() == false) {
        _g_txt3("hedefi yeniden sec", lx, _g_ly3(y), inner,
                rgb(250, 190, 90));
        y = y + _g_lh3();
    }
    if (_cam_mode3 == CAM_FPS) {
        _g_txt3("goz", lx, _g_ly3(y), labw - 2, _G_DIM3());
        float ye = _g_num(cb + 2, fx, y, fw, _ED_FLD3, _cam_eye3, 0.1);
        if (ye != _cam_eye3) { ed_mark3d(); _cam_eye3 = ye; }
        _g_txt3("fov", fx + fw + 4, _g_ly3(y), labw - 2, _G_DIM3());
        _cam_fov = _g_num(cb + 3, fx + (fw + 4) * 2, y, fw, _ED_FLD3, _cam_fov, 1.0);
    } else {
        _g_txt3("uzak", lx, _g_ly3(y), labw - 2, _G_DIM3());
        float yd = _g_num(cb + 4, fx, y, fw, _ED_FLD3, _cam_dist_logical3(), 0.25);
        float yh = _g_num(cb + 5, fx + fw + 4, y, fw, _ED_FLD3, _cam_height, 0.25);
        // Mesafe/yükseklik AYNI kurucudan geçiyor: yörüngede `_cam_dist`
        // yarıçap olduğu için doğrudan yazmak modu bozardı.
        if (yd != _cam_dist_logical3() || yh != _cam_height) {
            ed_mark3d();
            _ed_cam_apply3(_cam_mode3, _cam_target, yd, yh);
        }
        _cam_fov = _g_num(cb + 6, fx + (fw + 4) * 2, y, fw, _ED_FLD3, _cam_fov, 1.0);
    }
    y = y + _ED_FLD3 + _us3(3);
    str cc = "engel: yok";
    if (_cam_collide3 == 1) { cc = "engel: var"; }
    if (_g_tog(cb + 7, lx, y, half, _ED_FLD3, cc, _cam_collide3 == 1)) {
        ed_mark3d();
        if (_cam_collide3 == 1) { _cam_collide3 = 0; } else { _cam_collide3 = 1; }
    }
    _g_tip_for3(cb + 7, "Kamera duvarin icinden gecmesin");
    y = y + _ED_FLD3 + _us3(6);

    _g_section(px + 2, y, pw - 4, "ISIKLAR");
    y = y + _us3(16);
    y = _ed_lights_panel3(px, y, pw);

    _g_section(px + 2, y, pw - 4, "SU");
    y = y + _us3(16);
    str wt = "su: yok";
    if (_water_on3 == 1) { wt = "su: var"; }
    if (_g_tog(9720, lx, y, half, _ED_FLD3, wt, _water_on3 == 1)) {
        ed_mark3d();
        if (_water_on3 == 1) { water_off3d(); } else { water3d(_water_y3); }
    }
    if (_water_on3 == 1) {
        _water_y3 = _g_num(9721, lx + half + 4, y, half, _ED_FLD3, _water_y3, 0.1);
        y = y + _ED_FLD3 + _us3(3);
        _g_txt3("renk", lx, _g_ly3(y), labw - 2, _G_DIM3());
        float wr = _g_num(9722, fx, y, fw, _ED_FLD3, _col_r3(_water_col3) * 1.0, 1.0);
        float wg = _g_num(9723, fx + fw + 4, y, fw, _ED_FLD3, _col_g3(_water_col3) * 1.0, 1.0);
        float wb = _g_num(9724, fx + (fw + 4) * 2, y, fw, _ED_FLD3, _col_b3(_water_col3) * 1.0, 1.0);
        _water_col3 = rgb(_ed_c255(wr), _ed_c255(wg), _ed_c255(wb));
        y = y + _ED_FLD3 + _us3(3);
        _g_txt3("alfa", lx, _g_ly3(y), labw - 2, _G_DIM3());
        _water_a3 = _ed_c255(_g_num(9725, fx, y, fw, _ED_FLD3, _water_a3 * 1.0, 2.0));
    }
    y = y + _ED_FLD3 + _us3(6);

    _g_section(px + 2, y, pw - 4, "ARAZI");
    y = y + _us3(16);
    str tr2 = "arazi: yok";
    if (_terr_on == 1) { tr2 = "arazi: var"; }
    if (_g_tog(9730, lx, y, inner, _ED_FLD3, tr2, _terr_on == 1)) {
        ed_mark3d();
        if (_terr_on == 1) { terrain_off3d_scene(); }
        else { terrain3d(65, 120.0, 14.0, 120.0, 4.5, 7); }
    }
    y = y + _ED_FLD3 + _us3(3);
    if (_terr_on == 1) {
        _g_txt3("tepe", lx, _g_ly3(y), labw - 2, _G_DIM3());
        float tp = _g_num(9731, fx, y, fw, _ED_FLD3, _terr_sy3, 0.2);
        _g_txt3("toh", fx + fw + _us3(6), _g_ly3(y), _us3(22), _G_DIM3());
        float sd = _g_num(9732, fx + fw + _us3(30), y, fw, _ED_FLD3, _terr_seed3 * 1.0, 1.0);
        y = y + _ED_FLD3 + _us3(3);
        if (_g_button(9733, lx, y, half, _ED_FLD3, "yeniden uret")) {
            ed_mark3d();
            terrain3d(_terr_res3, _terr_sx, tp, _terr_sz, _terr_scale3, toInt(sd));
        }
        if (_g_button(9734, lx + half + 4, y, half, _ED_FLD3, "dogal boya")) {
            ed_mark3d(); terrain_natural3d(_terr_sy3);
        }
        y = y + _ED_FLD3 + _us3(3);
    }
    y = y + 3;

    _g_section(px + 2, y, pw - 4, "GUNDUZ-GECE");
    y = y + _us3(16);
    str dn = "dongu: yok";
    if (_dn_on3 == 1) { dn = "dongu: var"; }
    if (_g_tog(9740, lx, y, half, _ED_FLD3, dn, _dn_on3 == 1)) {
        ed_mark3d();
        if (_dn_on3 == 1) { _dn_on3 = 0; } else { daynight3d(_dn_len3); }
    }
    if (_dn_on3 == 1) {
        _dn_h3 = _g_num(9741, lx + half + 4, y, half, _ED_FLD3, _dn_h3, 0.1);
        if (_dn_h3 < 0.0) { _dn_h3 = 0.0; }
        if (_dn_h3 >= 24.0) { _dn_h3 = 23.99; }
        y = y + _ED_FLD3 + _us3(3);
        _g_txt3("gun s", lx, _g_ly3(y), labw + _us3(6), _G_DIM3());
        _dn_len3 = _g_num(9742, fx + _us3(8), y, fw, _ED_FLD3, _dn_len3, 1.0);
        if (_dn_len3 < 1.0) { _dn_len3 = 1.0; }
    }
    y = y + _ED_FLD3 + _us3(6);

    _g_section(px + 2, y, pw - 4, "EGIM");
    y = y + _us3(16);
    _g_txt3("sinir", lx, _g_ly3(y), labw + _us3(4), _G_DIM3());
    float sl = _g_num(9750, fx + _us3(6), y, fw, _ED_FLD3, _slope_lim3, 0.5);
    if (sl != _slope_lim3) { slope_limit3d(sl); }
    y = y + _ED_FLD3 + _us3(6);

    _g_section(px + 2, y, pw - 4, "KURALLAR");
    y = y + _us3(16);
    y = _ed_rules_panel3(px, y, pw);
    _ed_iset_content3(y);
}

func _ed_c255(v): int {
    int i = toInt(v);
    if (i < 0) { return 0; }
    if (i > 255) { return 255; }
    return i;
}

// ---- Bölge özellikleri -----------------------------------------------------
// Bölgeler entity DEĞİL (motor onları ayrı tutuyor), o yüzden ayrı bir panel.
// Kancaları burada düzenlenmiyor: onlar kod ve sahne biçiminde taşınmıyorlar.
func _ed_zone_panel3(px, y, pw) {
    int lx = px + _ED_PAD3;
    int inner = pw - _ED_PAD3 * 2;
    int half = toInt((inner - _us3(4)) / 2);
    int labw = _us3(30);
    int fw = _ed_f3w3(pw, labw);
    int fx = lx + labw;
    int i = _ed_zsel3;
    if (i < 0 || i >= length(_trg_x)) {
        _g_txt3("bolge secili degil", lx, y, inner, _G_DIM3());
        _ed_iset_content3(y + _g_lh3());
        return;
    }
    _g_txt3("BOLGE " + toString(i), lx, y, inner, _G_ACC3());
    y = y + _g_lh3() + _us3(4);

    if (_g_button(23001, lx, y, half, _ED_FLD3, _sc_tag_nm3(_trg_tag[i]))) {
        ed_mark3d();
        _trg_tag[i] = _ed_next_tag3(_trg_tag[i]);
    }
    str shp = "kutu";
    if (_trg_shape[i] == 1) { shp = "kure"; }
    if (_g_button(23002, lx + half + _us3(4), y, half, _ED_FLD3, shp)) {
        ed_mark3d();
        if (_trg_shape[i] == 1) { _trg_shape[i] = 0; } else { _trg_shape[i] = 1; }
    }
    y = y + _ED_FLD3 + _us3(6);

    _g_section(px + _us3(2), y, pw - _us3(4), "KONUM");
    y = y + _us3(16);
    _g_txt3("kon", lx, _g_ly3(y), labw - _us3(2), _G_DIM3());
    // YAZILAN sayı ızgaraya OTURTULMUYOR (varlık panelinde de öyle):
    // "1.35 yaz" demek tam olarak 1.35 demektir. Izgara SÜRÜKLEMENİN
    // kuralı — elle girilen değeri de yuvarlamak, sayı alanını yalancı yapar.
    _trg_x[i] = _g_num(23010, fx, y, fw, _ED_FLD3, _trg_x[i], 0.05);
    _trg_y[i] = _g_num(23011, fx + fw + _us3(4), y, fw, _ED_FLD3, _trg_y[i], 0.05);
    _trg_z[i] = _g_num(23012, fx + (fw + _us3(4)) * 2, y, fw, _ED_FLD3, _trg_z[i], 0.05);
    y = y + _ED_FLD3 + _us3(3);

    if (_trg_shape[i] == 1) {
        _g_txt3("r", lx, _g_ly3(y), labw - _us3(2), _G_DIM3());
        ed_zone_radius3d(i, _g_num(23013, fx, y, fw, _ED_FLD3, _trg_r[i], 0.05));
    } else {
        _g_txt3("boy", lx, _g_ly3(y), labw - _us3(2), _G_DIM3());
        float zsx = _g_num(23014, fx, y, fw, _ED_FLD3, _trg_sx[i], 0.05);
        float zsy = _g_num(23015, fx + fw + _us3(4), y, fw, _ED_FLD3, _trg_sy[i], 0.05);
        float zsz = _g_num(23016, fx + (fw + _us3(4)) * 2, y, fw, _ED_FLD3, _trg_sz[i], 0.05);
        ed_zone_resize3d(i, zsx, zsy, zsz);
    }
    y = y + _ED_FLD3 + _us3(6);

    _g_section(px + _us3(2), y, pw - _us3(4), "DAVRANIS");
    y = y + _us3(16);
    // Etiketler DURUMUN ADI, "alan: değer" değil. "tek atim: yok" 13 karakter
    // ve yarım sütun (2x ölçekte 136 px) ~11 karakter alıyor — yani kırpılarak
    // gösteriliyordu ve düğmenin ne dediği okunmuyordu (metin bütçesi testi
    // yakaladı). Durumu adlandırmak hem sığıyor hem daha açık: "sürekli"
    // sözcüğü "tek atım değil"den daha çok şey anlatıyor.
    str ov = "surekli";
    if (_trg_once[i] == 1) { ov = "tek atim"; }
    if (_g_tog(23020, lx, y, half, _ED_FLD3, ov, _trg_once[i] == 1)) {
        ed_mark3d();
        if (_trg_once[i] == 1) { _trg_once[i] = 0; } else { _trg_once[i] = 1; }
    }
    _g_tip_for3(23020, "Tek atim: ilk giristen sonra kendini kapatir");
    str en = "kapali";
    if (_trg_on[i] == 1) { en = "etkin"; }
    if (_g_tog(23021, lx + half + _us3(4), y, half, _ED_FLD3, en, _trg_on[i] == 1)) {
        ed_mark3d();
        if (_trg_on[i] == 1) { _trg_on[i] = 0; } else { _trg_on[i] = 1; }
    }
    _g_tip_for3(23021, "Kapali bolge hic olay uretmez");
    y = y + _ED_FLD3 + _us3(6);

    // ---- EYLEM ----
    // Bu bölüm olmadan bölge paneli tam bir yalandı: konum, boy, etiket,
    // "tek atım" — hepsi ayarlanıyor ve HİÇBİRİ bir şey yapmıyordu, çünkü
    // bölgenin tek çıkışı KOD kancasıydı. Veriyle kurulan bir oyunda "buraya
    // gelince kazandın" demenin yolu yoktu.
    _g_section(px + _us3(2), y, pw - _us3(4), "GIRINCE");
    y = y + _us3(16);
    int za = _trg_act[i];
    if (_g_button(23040, lx, y, inner, _ED_FLD3, _zact_nm3(za))) {
        ed_mark3d();
        _trg_act[i] = _zact_next3(za);
        za = _trg_act[i];
    }
    _g_tip_for3(23040, "Bu bolgeye girince ne olsun");
    y = y + _ED_FLD3 + _us3(3);
    // Miktar YALNIZ kullanıldığı eylemde: kullanılmayan bir alan "buraya ne
    // yazsam?" diye düşündürüp hiçbir şey yapmıyor (kural panelinde de böyle).
    if (_zact_uses_amount3(za)) {
        _g_txt3(_zact_amount_lbl3(za), lx, _g_ly3(y), labw + _us3(20), _G_DIM3());
        _trg_amt[i] = _g_num(23041, lx + labw + _us3(22), y,
                             inner - labw - _us3(22), _ED_FLD3, _trg_amt[i], 1.0);
        if (_trg_amt[i] < 0.0) { _trg_amt[i] = 0.0; }
        y = y + _ED_FLD3 + _us3(3);
    }
    // SES satırı — kuralların sesi vardı, bölgelerinki yoktu. "Çıkış kapısına
    // vardın" ve "çukura düştün" sessizdi; oysa geri bildirimin en çok
    // gerektiği an tam olarak o.
    str zs = _trg_snd[i];
    str zsl = "ses: yok";
    if (zs != "") { zsl = _ed_basename3(zs); }
    int zsxw = _us3(22);
    if (_g_button(23042, lx, y, inner - zsxw - _us3(4), _ED_FLD3, zsl)) {
        if (_ed_zsndopen3 == 1) { _ed_zsndopen3 = 0; }
        else { _ed_zsndopen3 = 1; if (_ed_snddone3 == 0) { _ed_snd_scan3(); } }
    }
    _g_tip_for3(23042, "Bolgeye girince calacak ses");
    if (zs != "") {
        if (_g_button(23043, lx + inner - zsxw, y, zsxw, _ED_FLD3, "x")) {
            ed_mark3d();
            trigger_sound3d(i, "");
        }
    }
    y = y + _ED_FLD3 + _us3(2);
    if (_ed_zsndopen3 == 1) {
        y = _ed_snd_browser3(lx, y, inner, zs);
        if (_ed_snd_pick3 != "") {
            ed_mark3d();
            trigger_sound3d(i, _ed_snd_pick3);
            _ed_zsndopen3 = 0;
        }
    }

    _g_txt3("ok: tasi  R+ok: boyut", lx, _g_ly3(y), inner, _G_DIM3());
    y = y + _g_lh3();
    // Kanca varsa SÖYLE: kod da bir şey yapıyor ve ikisi birlikte koşuyor.
    // Söylenmezse "eylem yok" yazan bir bölgenin neden iş gördüğü anlaşılmaz.
    if (_trg_hasin[i] == 1) {
        _g_txt3("kodda kancasi da var", lx, _g_ly3(y), inner, _G_DIM3());
        y = y + _g_lh3();
    }
    y = y + _us3(5);

    if (_g_button(23031, lx, y, inner, _ED_FLD3, "BOLGEYI COGALT")) {
        ed_mark3d();
        int yz = ed_zone_duplicate3d(i);
        if (yz >= 0) { _ed_zsel3 = yz; }
    }
    _g_tip_for3(23031, "Ayarlariyla birlikte kopyalar  (CTRL+D)");
    y = y + _ED_FLD3 + _us3(3);

    if (_g_button(23030, lx, y, inner, _ED_FLD3, "BOLGEYI SIL")) {
        ed_mark3d();
        _ed_zone_delete3(i);
        _ed_tab3 = 0;
        _ed_zsel3 = 0 - 1;
    }
    _ed_iset_content3(y + _ED_FLD3 + _us3(6));
}

// Bölgeyi ÇOĞALT. Varlıkta CTRL+D vardı, bölgede yoktu: ayarlanmış bir
// bölgeyi (eylem + miktar + ses + tek-atım + etiket) ikinci kez kurmanın tek
// yolu her alanı elle yeniden doldurmaktı.
//
// ⚠️ `trigger3d` yalnız geometriyi ve etiketi kuruyor; geri kalan her alan
// VARSAYILANA düşüyor. Kopyalamayı unutulan alan sessizce kaybolur ve
// kopya "aynı görünen ama hiçbir şey yapmayan" bir bölge olur — varlık
// çoğaltmasında tam olarak bu yaşandı (model alanı taşınmıyordu, kopya
// "şekli MODEL ama modeli yok" çıkıyordu). Alan listesi
// `_ed_zone_delete3`'inkiyle AYNI olmalı: biri alan eklenip öteki
// unutulursa silme kaydırır, çoğaltma düşürür.
//
// ÜYELİK kayıtları (`_trg_in_*`) KOPYALANMIYOR ve bu doğru: onlar "şu an
// içeride kim var" durumu, bölgenin tanımı değil. Kopyalasaydık yeni bölge
// hiç girilmeden "içeride biri var" sanır ve çıkış olayı atardı.
func ed_zone_duplicate3d(i): int {
    if (_ed_zone_ok3(i) == false) { return 0 - 1; }
    float off = 1.0;
    if (_ed_grid3 > 0.0) { off = _ed_grid3 * 2.0; }
    int n = trigger3d(_trg_x[i] + off, _trg_y[i], _trg_z[i] + off,
                      _trg_sx[i], _trg_sy[i], _trg_sz[i], _trg_tag[i]);
    if (_ed_zone_ok3(n) == false) { return 0 - 1; }
    _trg_r[n] = _trg_r[i];
    _trg_shape[n] = _trg_shape[i];
    _trg_on[n] = _trg_on[i];
    _trg_once[n] = _trg_once[i];
    _trg_fin[n] = _trg_fin[i];     _trg_hasin[n] = _trg_hasin[i];
    _trg_fout[n] = _trg_fout[i];   _trg_hasout[n] = _trg_hasout[i];
    _trg_fstay[n] = _trg_fstay[i]; _trg_hasstay[n] = _trg_hasstay[i];
    _trg_act[n] = _trg_act[i];
    _trg_amt[n] = _trg_amt[i];
    _trg_snd[n] = _trg_snd[i];
    return n;
}
func bolge_cogalt3d(i): int { return ed_zone_duplicate3d(i); }

// Bölgeyi sil: bütün paralel diziler AYNI indeksten düşmeli, yoksa bölge
// verileri birbirine kayar.
func _ed_zone_delete3(i) {
    int n = length(_trg_x);
    if (i < 0 || i >= n) { return; }
    int k = i;
    while (k < n - 1) {
        _trg_x[k] = _trg_x[k+1]; _trg_y[k] = _trg_y[k+1]; _trg_z[k] = _trg_z[k+1];
        _trg_sx[k] = _trg_sx[k+1]; _trg_sy[k] = _trg_sy[k+1]; _trg_sz[k] = _trg_sz[k+1];
        _trg_r[k] = _trg_r[k+1]; _trg_shape[k] = _trg_shape[k+1];
        _trg_tag[k] = _trg_tag[k+1]; _trg_on[k] = _trg_on[k+1];
        _trg_once[k] = _trg_once[k+1];
        _trg_fin[k] = _trg_fin[k+1]; _trg_hasin[k] = _trg_hasin[k+1];
        _trg_fout[k] = _trg_fout[k+1]; _trg_hasout[k] = _trg_hasout[k+1];
        _trg_fstay[k] = _trg_fstay[k+1]; _trg_hasstay[k] = _trg_hasstay[k+1];
        // Eylem ve miktarı da KAYDIRILMALI. Kaydırılmazsa silinen bölgeden
        // sonraki her bölge, bir öncekinin eylemini devralır: "çıkış kapısı"
        // sildiğin kutunun hasarını uygulamaya başlar. Paralel dizilerde en
        // sık yapılan hata bu ve tümüyle sessiz.
        _trg_act[k] = _trg_act[k+1]; _trg_amt[k] = _trg_amt[k+1];
        _trg_snd[k] = _trg_snd[k+1];
        k = k + 1;
    }
    pop(_trg_x); pop(_trg_y); pop(_trg_z);
    pop(_trg_sx); pop(_trg_sy); pop(_trg_sz);
    pop(_trg_r); pop(_trg_shape); pop(_trg_tag); pop(_trg_on); pop(_trg_once);
    pop(_trg_fin); pop(_trg_hasin);
    pop(_trg_fout); pop(_trg_hasout);
    pop(_trg_fstay); pop(_trg_hasstay);
    pop(_trg_act); pop(_trg_amt); pop(_trg_snd);
    // Üyelik kayıtları bölge indeksine göre; silinen bölgeninkiler gitmeli,
    // sonrakiler kaymalı — yoksa "içeride" sayılan yanlış bölge olur.
    array nt = [];
    array ne = [];
    int m = 0;
    while (m < length(_trg_in_t)) {
        int ti = _trg_in_t[m];
        if (ti != i) {
            if (ti > i) { ti = ti - 1; }
            push(nt, ti); push(ne, _trg_in_e[m]);
        }
        m = m + 1;
    }
    _trg_in_t = nt;
    _trg_in_e = ne;
}

// İçeride zaten `px` üzerinden konumlanıyordu — yuvası değişebilen bir panel
// olmak için tek gereken, o dikdörtgeni DIŞARIDAN almak.
func _ed_inspector3(px, py, pw, ph) {
    _g_panel(px, py, pw, ph, "OZELLIKLER");

    int s = _slot_of3(_ed_sel3e);
    int lx = px + _ED_PAD3;
    int inner = pw - _ED_PAD3 * 2;
    int half = toInt((inner - 4) / 2);

    // Sekme DÜĞMESİ yok: seçim hiyerarşiden geliyor ve DÜNYA orada bir satır.
    // İki ayrı seçim yolu (liste + sekme) tutmak, hangisinin geçerli olduğu
    // konusunda sürekli bir tutarsızlık kaynağı olurdu.
    //
    // İçerik panelden UZUN olabiliyor (çok davranışlı varlık, dünya ayarları +
    // kurallar). Tekerlekle kaydırılıyor ve panele KIRPILIYOR; kırpma olmadan
    // taşan satırlar alttaki konsolun üstüne çizilirdi.
    int ctop = py + _us3(16);
    int cavail = ph - _us3(20);
    if (_g_in(px, py, pw, ph)) {
        float wh = mouse_wheel();
        if (wh > 0.5)        { _ed_iscroll3 = _ed_iscroll3 - 24; }
        if (wh < 0.0 - 0.5)  { _ed_iscroll3 = _ed_iscroll3 + 24; }
    }
    _ed_iscroll_step3(ctop, cavail);
    _g_clip3(px, ctop, pw, cavail);
    // İçerik başlık şeridinin ALTINDAN başlıyor. Sabit 20 idi ve 2x ölçekte
    // şerit 32 piksel olduğu için ilk satır başlığın üstüne biniyordu.
    int y = py + _us3(16) + _us3(4) - _ed_iscroll3;
    if (_ed_tab3 == 2) {
        _ed_zone_panel3(px, y, pw);
        _g_clip_end3();
        _ed_scrollbar3(px, ctop, pw, cavail);
        return;
    }
    if (_ed_tab3 == 1) {
        _g_txt3("DUNYA", lx, y, inner, _G_ACC3());
        _ed_world_panel3(px, y + 14, pw);
        _g_clip_end3();
        _ed_scrollbar3(px, ctop, pw, cavail);
        return;
    }
    if (s < 0) {
        // Seçim yokken bu panel yalnız "secili varlik yok" yazıyordu — yani
        // editörün EN ÇOK görülen ilk ekranı boştu. Onun yerine ŞABLONLAR
        // duruyor: tek tıkla tam oynanabilir bir oyun. Öğrenme yolu da bu,
        // çalışan bir şeyi kurcalamak boş sayfayı doldurmaktan kolay.
        _g_txt3("secili varlik yok", lx, y, inner, _G_DIM3());
        y = y + _g_lh3();
        _g_txt3("sahnede bir cisme tikla ya da", lx, y, inner, _G_DIM3());
        y = y + _g_lh3();
        _g_txt3("soldaki DUNYA satirini sec.", lx, y, inner, _G_DIM3());
        y = y + _g_lh3() + _us3(8);

        _g_section(px + 2, y, pw - 4, "OYUN SABLONLARI");
        y = y + _us3(16);
        _g_txt3("Tek tikla OYNANABILIR bir oyun.", lx, y, inner, _G_DIM3());
        y = y + _g_lh3();
        _g_txt3("CTRL+Z eski sahneyi geri getirir.", lx, y, inner, _G_DIM3());
        y = y + _g_lh3() + _us3(4);
        if (_g_button(9770, lx, y, inner, _ED_FLD3, "TOPLAYICI")) {
            ed_template3d(TPL_TOPLAYICI);
        }
        _g_tip_for3(9770, "Altinlari topla, kirmizi dusmandan kac");
        y = y + _ED_FLD3 + _us3(3);
        if (_g_button(9771, lx, y, inner, _ED_FLD3, "ARENA (nisanci)")) {
            ed_template3d(TPL_ARENA);
        }
        _g_tip_for3(9771, "Otomatik ates, dort dusmani temizle");
        y = y + _ED_FLD3 + _us3(3);
        if (_g_button(9772, lx, y, inner, _ED_FLD3, "PLATFORM")) {
            ed_template3d(TPL_PLATFORM);
        }
        _g_tip_for3(9772, "Platformlara zipla, altinlari topla");
        y = y + _ED_FLD3 + _us3(6);

        _ed_iset_content3(y);
        _g_clip_end3();
        _ed_scrollbar3(px, ctop, pw, cavail);
        return;
    }
    Ent3 e = _e3[s];
    int id = _ed_sel3e;

    // Ad: kamera hedefi ve kurallar varlıklara ADLA atıfta bulunuyor, yani
    // adsız bir varlık sahne dosyasında hedeflenemiyor.
    _g_txt3("ad", lx, _g_ly3(y), _us3(18), _G_DIM3());
    str nm0 = _sc_nm_of3(id);
    str nm1 = _g_text(9690, lx + _us3(20), y, inner - _us3(20), _ED_FLD3, nm0);
    if (nm1 != nm0) { ed_mark3d(); rename3d(id, nm1); }
    y = y + _ED_FLD3 + _us3(6);
    int labw = _us3(26);
    int fw = _ed_f3w3(pw, labw);
    int fx = lx + labw;

    // Etiket / şekil — iki eşit sütun.
    if (_g_button(9300, lx, y, half, _ED_FLD3, _sc_tag_nm3(e.tag))) {
        ed_mark3d();
        e = _e3[s];
        int elle = 0;
        if (e.solid != _default_solid3(e.tag)) { elle = 1; }
        e.tag = _ed_next_tag3(e.tag);
        if (elle == 0) { e.solid = _default_solid3(e.tag); }
        _e3[s] = e;
    }
    if (e.shape == SHAPE_MODEL) {
        _g_txtc3("model", lx + half + 4, y, half, _ED_FLD3, _G_DIM3());
    } else {
        if (_g_button(9301, lx + half + 4, y, half, _ED_FLD3, _sc_shape_nm3(e.shape))) {
            ed_mark3d();
            e = _e3[s]; e.shape = _ed_next_shape3(e.shape); _e3[s] = e;
        }
    }
    y = y + _ED_FLD3 + _us3(6);

    _g_section(px + 2, y, pw - 4, "DONUSUM");
    y = y + _us3(16);

    e = _e3[s];
    _g_txt3("kon", lx, _g_ly3(y), labw - 2, _G_DIM3());
    float nx = _g_num(9310, fx, y, fw, _ED_FLD3, e.x, 0.05);
    float ny = _g_num(9311, fx + fw + 4, y, fw, _ED_FLD3, e.y, 0.05);
    float nz = _g_num(9312, fx + (fw + 4) * 2, y, fw, _ED_FLD3, e.z, 0.05);
    if (nx != e.x || ny != e.y || nz != e.z) { set3pos(id, nx, ny, nz); }
    y = y + _ED_FLD3 + _us3(3);

    e = _e3[s];
    _g_txt3("boy", lx, _g_ly3(y), labw - 2, _G_DIM3());
    float sx = _g_num(9320, fx, y, fw, _ED_FLD3, e.sx, 0.05);
    float sy = _g_num(9321, fx + fw + 4, y, fw, _ED_FLD3, e.sy, 0.05);
    float sz = _g_num(9322, fx + (fw + 4) * 2, y, fw, _ED_FLD3, e.sz, 0.05);
    if (sx != e.sx || sy != e.sy || sz != e.sz) { ed_resize3d(id, sx, sy, sz); }
    y = y + _ED_FLD3 + _us3(3);

    e = _e3[s];
    _g_txt3("yaw", lx, _g_ly3(y), labw - 2, _G_DIM3());
    float yw = _g_num(9330, fx, y, fw, _ED_FLD3, e.yaw, 0.5);
    if (yw != e.yaw) { ed_rotate3d(id, yw); }
    int dw = inner - labw - fw - 4;
    if (_g_button(9331, fx + fw + 4, y, dw, _ED_FLD3, "zemine otur")) {
        ed_mark3d(); ed_drop3d(id);
    }
    _g_tip_for3(9331, "Zemine/araziye otur  (BOSLUK)");
    y = y + _ED_FLD3 + _us3(6);

    _g_section(px + 2, y, pw - 4, "GORUNUM");
    y = y + _us3(16);

    e = _e3[s];
    _g_txt3("rgb", lx, _g_ly3(y), labw - 2, _G_DIM3());
    int sww = _us3(18);
    int cfw = toInt((inner - labw - sww - 12) / 3);
