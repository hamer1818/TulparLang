    _g_clip_end3();
    _ed_scrollbar3(px, ctop, pw, cavail);
}

// İnce kaydırma çubuğu — içerik panelden uzunsa nerede olduğunu gösteriyor.
// Çubuğun GEOMETRİSİ saf: çubuk yalnız çiziliyordu ve hesabındaki bir hata
// (içerik ÜSTÜNÜ çıkarmayı unutmak gibi) hiçbir testi kırmıyordu — tutamak
// sessizce yanlış boyda ve yanlış yerde duruyordu.
func _ed_sbar_total3(ctop): int { return _ed_icontent3 - ctop; }

func _ed_sbar_h3(total, cavail): int {
    if (total <= 0) { return cavail; }
    int bh = toInt(cavail * cavail / total);
    // En az 12 piksel: oransal yükseklik çok uzun içerikte tutamağı
    // görünmez inceliğe indiriyor.
    if (bh < 12) { bh = 12; }
    if (bh > cavail) { bh = cavail; }
    return bh;
}

func _ed_sbar_y3(total, cavail, ctop, scroll): int {
    int bh = _ed_sbar_h3(total, cavail);
    int room = cavail - bh;
    int span = total - cavail;
    if (span <= 0) { return ctop; }
    int y = ctop + toInt(room * scroll / span);
    // Uçlarda taşmasın: kelepçe bir kare geriden gelen içerikle birlikte
    // tutamağı yolun dışına itebiliyor.
    if (y < ctop) { y = ctop; }
    if (y > ctop + room) { y = ctop + room; }
    return y;
}

func _ed_scrollbar3(px, ctop, pw, cavail) {
    int total = _ed_sbar_total3(ctop);
    if (total <= cavail) { return; }
    int bh = _ed_sbar_h3(total, cavail);
    int by = _ed_sbar_y3(total, cavail, ctop, _ed_iscroll3);
    rect(px + pw - _us3(4), ctop, _us3(3), cavail, rgb(34, 38, 46));
    rect(px + pw - _us3(4), by, _us3(3), bh, rgb(90, 100, 118));
}

// Kod → karakter. Dilde `chr` YOKTU (yalnız `ord` vardı) ve metin alanı bu
// yüzden Tulpar tarafında bir ASCII tablosu taşıyordu; artık builtin.
// Yazdırılamayan kodlar boş dize döner, yani metne çöp bayt sızmıyor.
func _g_chr3(c): str {
    if (c < 32 || c > 126) { return ""; }
    return chr(c);
}


// ===========================================================================
// EKSEN TUTAMAKLARI (gizmo) — Faz 13
// ===========================================================================
// Sürükleme şimdiye kadar YATAY düzlemdeydi: yüksekliği fareyle değiştirmenin
// yolu yoktu ve hareket tek bir eksene kilitlenemiyordu. Unity/Unreal'ın
// çözümü üç ok: X kırmızı, Y yeşil, Z mavi. Bir oka tutununca hareket O
// EKSENDE kalıyor — "bir şeyi X'te 2 birim kaydır" tam olarak bu.
//
// Matematiği saf: ışın ile eksen DOĞRUSU arasındaki en yakın yaklaşım. İki
// doğru arasındaki en kısa mesafe kapalı formda çözülüyor; ekran uzayında
// çizip piksel mesafesine bakmak, kamera açısına göre bozulurdu (tepeden
// bakınca dikey ok bir noktaya çöker ve tıklanamaz olurdu).
int   _gz_axis3 = 0 - 1;   // sürüklenen eksen: -1 yok, 0=X, 1=Y, 2=Z
float _gz_t0_3  = 0.0;     // yakalandığı andaki eksen parametresi
float _gz_px3   = 0.0;     // ...ve varlığın konumu
float _gz_py3   = 0.0;
float _gz_pz3   = 0.0;
float _GZ_PICK3 = 0.32;    // oka tutunma yarıçapı (dünya birimi, ok boyuna oranlı)

// Tutamağın tuttuğu BÖLGE (-1 = varlık tutuyor). Bölgenin kendi seçimi var
// (`_ed_zsel3`) ve tutamak sürüklenirken seçim değişebilir; sürüklemenin
// hedefi YAKALANDIĞI anda saklanıyor, yoksa jest ortasında başka bir bölge
// büyümeye başlardı.
int   _gz_zid3  = 0 - 1;
// Ölçek MUTLAK bir uzunluk ekliyor ve eklenen şey YAKALANAN ölçüye biniyor,
// bir öncekine değil: üstüne eklemek yuvarlamayı biriktirir ve sürükleme
// uzadıkça bölge kaçardı (halkada da aynı kural).
float _gz_z0sx3 = 0.0;
float _gz_z0sy3 = 0.0;
float _gz_z0sz3 = 0.0;
float _gz_z0r3  = 0.0;

func _gz_grab_zone3(i) {
    _gz_zid3 = i;
    _gz_px3 = _trg_x[i];  _gz_py3 = _trg_y[i];  _gz_pz3 = _trg_z[i];
    _gz_z0sx3 = _trg_sx[i]; _gz_z0sy3 = _trg_sy[i]; _gz_z0sz3 = _trg_sz[i];
    _gz_z0r3 = _trg_r[i];
}

// DÖNDÜRME HALKASI. Döndürme klavyeye mahkûmdu: sol/sağ oklar, 15°'lik
// adımlar. Yani 37°'ye dönmenin yolu YOKTU ve fareyle çalışan bir editörde
// dönüşün de fareyle olması gerekiyor (Unity/Unreal/Blender'da halka).
//
// Motorun tek dönme ekseni Y (`set3yaw`), yani halka da cismin
// yüksekliğindeki YATAY düzlemde. Tek eksen olması işi kolaylaştırmıyor,
// DOĞRU yapıyor: üç halka çizmek, ikisi hiçbir şey yapmayan bir tutamak
// demek olurdu.
int   _GZ_RING3 = 3;       // `_gz_axis3` için halka "ekseni"
float _gz_a0_3  = 0.0;     // yakalandığı andaki açı (derece)
float _gz_ang3  = 0.0;     // son hesaplanan açı (derece)
float _gz_rd3   = 0.0;     // ...ve kesişimin merkeze uzaklığı
float _gz_gcx3  = 0.0;     // grup merkezi (çoklu seçimde dönme ekseni)
float _gz_gcz3  = 0.0;
array _gz_g0id3 = [];      // yakalanan seçim ve o andaki hâli
array _gz_g0x3  = [];
array _gz_g0z3  = [];
array _gz_g0yaw3 = [];
array _gz_g0sx3 = [];      // ...ve boyutları (ölçek tutamağı için)
array _gz_g0sy3 = [];
array _gz_g0sz3 = [];

// Son çağrının çıktıları.
float _gz_t3   = 0.0;      // eksen üzerindeki parametre
float _gz_d3   = 0.0;      // ışına en yakın mesafe

// Işın (o,d) ile eksen doğrusu (p, birim A) arasındaki en yakın yaklaşım.
// Işının ARKASINDA kalan çözümleri elemek için sc >= 0 aranıyor.
// Paralel durumda -1 döner.
func _ray_axis3(ox, oy, oz, dx, dy, dz, px, py, pz, ax, ay, az): float {
    float wx = ox - px;
    float wy = oy - py;
    float wz = oz - pz;
    float b = dx * ax + dy * ay + dz * az;
    float dd = dx * wx + dy * wy + dz * wz;
    float ee = ax * wx + ay * wy + az * wz;
    float den = 1.0 - b * b;       // a=1, c=1 (ikisi de birim)
    if (abs_f3(den) < 0.000001) { return 0.0 - 1.0; }
    float sc = (b * ee - dd) / den;
    float tc = (ee - b * dd) / den;
    if (sc < 0.0) { return 0.0 - 1.0; }
    float cx = (ox + dx * sc) - (px + ax * tc);
    float cy = (oy + dy * sc) - (py + ay * tc);
    float cz = (oz + dz * sc) - (pz + az * tc);
    _gz_t3 = tc;
    _gz_d3 = sqrt(cx * cx + cy * cy + cz * cz);
    return _gz_d3;
}

// Tutamak boyu: EKRANDA sabit görünmeli. Dünya birimi sabit olsaydı uzaktaki
// bir varlığın okları görünmez, yakındaki ekranı kaplardı.
func _gz_len3(px, py, pz): float {
    float dx = px - _ed_cx3;
    float dy = py - _ed_cy3;
    float dz = pz - _ed_cz3;
    float d = sqrt(dx * dx + dy * dy + dz * dz);
    float l = d * 0.16;
    if (l < 0.8) { l = 0.8; }
    if (l > 14.0) { l = 14.0; }
    return l;
}

// Halkanın YARIÇAPI. Eksen okuyla aynı ölçüden türüyor (kamera uzaklaşınca
// ekranda aynı boyda kalıyor) ama cismin KENDİNDEN küçük olamıyor: kocaman
// bir duvarın içinde kalan halka tutulamaz, çünkü tıklama önce duvarı seçer.
func _gz_ring_r3(px, py, pz, sx, sz): float {
    float r = _gz_len3(px, py, pz);
    float yari = sx * 0.5;
    if (sz * 0.5 > yari) { yari = sz * 0.5; }
    float mn = yari + r * 0.35;
    if (r < mn) { r = mn; }
    return r;
}

// Yatay düzlemdeki bir yönün YAW'ı. GÖVDE sözleşmesi: (sin yaw, cos yaw),
// yani `move3d`'nin `atan2(wx, wz)`'si. Kamera sözleşmesiyle (−cos)
// karıştırmak dönüşü ayna görüntüsü yapardı — bu depoda bir kez yaşandı ve
// mermiler tam ters gitmişti.
func _gz_yaw_from3(ax, az): float { return atan2(ax, az) * RAD2DEG3; }

// Işının, `py` yüksekliğindeki yatay düzlemle kesişiminin merkeze göre
// AÇISI. Işın düzleme paralelse ya da düzlem ışının ARKASINDAysa geçersiz
// (−1000) dönüyor; 0 döndürmek dönüşü bir karede sıfıra sıçratırdı.
// Merkeze uzaklık `_gz_rd3`'e yazılıyor (tutunma sınaması onu kullanıyor).
func _gz_ring_ang3(ox, oy, oz, dx, dy, dz, px, py, pz): float {
    float t = _ray_planey3(oy, dy, py);
    if (t <= 0.0) { return 0.0 - 1000.0; }
    float ax = (ox + dx * t) - px;
    float az = (oz + dz * t) - pz;
    _gz_rd3 = sqrt(ax * ax + az * az);
    return _gz_yaw_from3(ax, az);
}
func _gz_ang_ok3(a): bool { return a > 0.0 - 999.0; }

// Halkaya TUTUNMA: kesişim merkeze `r` uzaklıktaysa yakalandı.
func _gz_ring_pick3(ox, oy, oz, dx, dy, dz, px, py, pz, r): bool {
    float a = _gz_ring_ang3(ox, oy, oz, dx, dy, dz, px, py, pz);
    if (_gz_ang_ok3(a) == false) { return false; }
    _gz_ang3 = a;
    return abs_f3(_gz_rd3 - r) <= r * _GZ_PICK3;
}

// İki açı arasındaki EN KISA fark (−180..180). Ham çıkarma, halkanın
// ±180 dikişinden geçerken 359°'lik bir sıçrama üretirdi: cisim bir karede
// tam tur atardı.
func _gz_angdiff3(a, b): float {
    float d = a - b;
    while (d > 180.0)  { d = d - 360.0; }
    while (d < 0.0 - 180.0) { d = d + 360.0; }
    return d;
}

// IZGARA AÇIKKEN dönüş de 15°'ye oturuyor. Izgara düğmesi "hizala"
// demek ve konumu hizalayıp açıyı serbest bırakmak, hizalanmış bir
// duvarı 3° eğik bırakırdı. 15°, klavyedeki ok adımıyla AYNI: iki yol
// aynı açı kümesini üretmeli.
func _gz_snap_deg3(a, izgara): float {
    if (izgara <= 0.0) { return a; }
    float k = 15.0;
    float h = a / k;
    // `toInt` sıfıra doğru kırpıyor, yani yarımı SIFIRDAN UZAĞA yuvarlamak
    // için işaret elle veriliyor: −7.5° tek bir `toInt` ile 0'a düşerdi.
    if (h >= 0.0) { return toInt(h + 0.5) * k; }
    return toInt(h - 0.5) * k;
}

// Fare ışını hangi eksene tutunuyor? -1 = hiçbiri.
// Eksenlerin hepsi denenip EN YAKIN olan seçiliyor: üç ok merkezde kesiştiği
// için ilk eşleşeni almak, kamera açısına göre yanlış ekseni verirdi.
func _gz_pick3(ox, oy, oz, dx, dy, dz, px, py, pz): int {
    float axlen = _gz_len3(px, py, pz);
    float lim = axlen * _GZ_PICK3;
    int best = 0 - 1;
    float bd = lim;
    float t_at = 0.0;

    float d0 = _ray_axis3(ox, oy, oz, dx, dy, dz, px, py, pz, 1.0, 0.0, 0.0);
    if (d0 >= 0.0 && d0 < bd && _gz_t3 > 0.0 && _gz_t3 < axlen) {
        bd = d0; best = 0; t_at = _gz_t3;
    }
    float d1 = _ray_axis3(ox, oy, oz, dx, dy, dz, px, py, pz, 0.0, 1.0, 0.0);
    if (d1 >= 0.0 && d1 < bd && _gz_t3 > 0.0 && _gz_t3 < axlen) {
        bd = d1; best = 1; t_at = _gz_t3;
    }
    float d2 = _ray_axis3(ox, oy, oz, dx, dy, dz, px, py, pz, 0.0, 0.0, 1.0);
    if (d2 >= 0.0 && d2 < bd && _gz_t3 > 0.0 && _gz_t3 < axlen) {
        bd = d2; best = 2; t_at = _gz_t3;
    }
    _gz_t3 = t_at;
    _gz_d3 = bd;
    return best;
}

func _gz_ax_x3(a): float { if (a == 0) { return 1.0; } return 0.0; }
func _gz_ax_y3(a): float { if (a == 1) { return 1.0; } return 0.0; }
func _gz_ax_z3(a): float { if (a == 2) { return 1.0; } return 0.0; }

// Tutamakların çizimi. Ok gövdesi çizgi, ucu küçük bir küp.
// Döndürme halkası: yatay düzlemde bir çember, kısa doğru parçalarından.
// `circle3d` diye bir bağlama yok ve eklemenin bedeli 5 noktalı bir builtin
// wiring'i; 24 parça gözle çemberden ayırt edilemiyor (ölçüldü: 15°'lik
// kiriş, yarıçapın %13'ü kadar sapıyor ve tutamak zaten kalın çiziliyor).
func _gz_ring_draw3(px, py, pz, r, col) {
    int n = 24;
    int i = 0;
    while (i < n) {
        float a0 = i * 360.0 / n * DEG2RAD3;
        float a1 = (i + 1) * 360.0 / n * DEG2RAD3;
        line3d(px + sin(a0) * r, py, pz + cos(a0) * r,
               px + sin(a1) * r, py, pz + cos(a1) * r, col);
        i = i + 1;
    }
}

// Üç eksen oku. Hem varlık hem bölge buradan çiziliyor.
func _gz_arrows_draw3(px, py, pz) {
    float axlen = _gz_len3(px, py, pz);
    float ucb = axlen * 0.12;
    int cx = rgb(232, 84, 74);
    int cy = rgb(112, 214, 112);
    int cz = rgb(96, 150, 246);
    // Sürüklenen eksen vurgulanıyor — hangisine tutunduğun belli olsun.
    if (_gz_axis3 == 0) { cx = _G_ACC3(); }
    if (_gz_axis3 == 1) { cy = _G_ACC3(); }
    if (_gz_axis3 == 2) { cz = _G_ACC3(); }
    line3d(px, py, pz, px + axlen, py, pz, cx);
    line3d(px, py, pz, px, py + axlen, pz, cy);
    line3d(px, py, pz, px, py, pz + axlen, cz);
    cube_wires(px + axlen, py, pz, ucb, ucb, ucb, cx);
    cube_wires(px, py + axlen, pz, ucb, ucb, ucb, cy);
    cube_wires(px, py, pz + axlen, ucb, ucb, ucb, cz);
}

func _gz_draw3(s) {
    // DÖNDÜRME kipinde tutamak halka. Ayrı dal, ayrı geometri.
    if (_ed_mode3 == ED_ROTATE) {
        Ent3 re = _e3[s];
        float rr = _gz_ring_r3(re.x, re.y, re.z, re.sx, re.sz);
        int rc = rgb(112, 214, 112);        // Y ekseninin rengi: dönüş Y'de
        if (_gz_axis3 == _GZ_RING3) { rc = _G_ACC3(); }
        _gz_ring_draw3(re.x, re.y, re.z, rr, rc);
        // Cismin BAKTIĞI yön: halkada nerede olduğunu gösteren tek işaret.
        // Onsuz halka simetrik bir daire ve kaç derece döndüğü görünmüyor.
        float yr = re.yaw * DEG2RAD3;
        line3d(re.x, re.y, re.z,
               re.x + sin(yr) * rr, re.y, re.z + cos(yr) * rr, rc);
        return;
    }
    if (_ed_mode3 != ED_MOVE && _ed_mode3 != ED_SCALE) { return; }
    Ent3 e = _e3[s];
    _gz_arrows_draw3(e.x, e.y, e.z);
}

// Bölgenin tutamakları. Aynı oklar, aynı ölçü, aynı vurgu — VARLIKLA AYNI
// FONKSİYON çiziyor; ayrı yazılmış bir kopya zamanla sapar ve "bölgede
// tutamak başka yerde duruyor" olurdu.
//
// DÖNDÜRME kipinde bölgede tutamak YOK: bölgenin yaw'ı yok (biçimde de,
// içerik testinde de eksen hizalı bir kutu) — döndüren bir halka çizmek
// hiçbir şey yapmayan bir tutamak olurdu. Aynı gerekçeyle motorun tek
// dönme ekseni için tek halka çiziliyor.
func _gz_zone_draw3(i) {
    if (_ed_mode3 != ED_MOVE && _ed_mode3 != ED_SCALE) { return; }
    if (i < 0 || i >= length(_trg_x)) { return; }
    _gz_arrows_draw3(_trg_x[i], _trg_y[i], _trg_z[i]);
}
