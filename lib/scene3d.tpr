            if (_ed_texdone3 == 0) { _ed_tex_scan3(); }
        }
    }
    str ttip = "Yuzey dokusu sec (kutu/kure/silindir/rampa)";
    if (e.tsrc != "") { ttip = e.tsrc; }
    _g_tip_for3(52000, ttip);
    if (e.tsrc != "") {
        if (_g_button(52001, lx + inner - txw, y, txw, _ED_FLD3, "x")) {
