        if (pn == "") { pn = _sc_tag_nm3(e.tag) + toString(prefab_count3d()); }
        prefab_save3d(pn, id);
        _ed_msg3 = "sablon: " + pn;
        _ed_msg_t3 = 2.0;
    }
    _g_tip_for3(9480, "Bu varligi adli sablon olarak sakla");
    y = y + _ED_FLD3 + _us3(3);
    int pi = 0;
    int pn2 = prefab_count3d();
    while (pi < pn2 && pi < 8) {
        str pnm = prefab_name3d(pi);
        if (_g_button(9490 + pi * 2, lx, y, inner - _ED_FLD3 - _us3(3), _ED_FLD3, pnm)) {
