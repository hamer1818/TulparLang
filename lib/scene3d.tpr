    float cb = _g_num(9342, fx + (cfw + 4) * 2, y, cfw, _ED_FLD3, _col_b3(e.color) * 1.0, 1.0);
    int ir = toInt(cr); int ig = toInt(cg); int ib = toInt(cb);
    if (ir < 0) { ir = 0; }
    if (ir > 255) { ir = 255; }
    if (ig < 0) { ig = 0; }
    if (ig > 255) { ig = 255; }
    if (ib < 0) { ib = 0; }
    if (ib > 255) { ib = 255; }
    if (ir != _col_r3(e.color) || ig != _col_g3(e.color) || ib != _col_b3(e.color)) {
