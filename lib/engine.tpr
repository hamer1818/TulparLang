func collision_b(i): int { return eng_collision_b(i); }
func carpisma_sahne_a(i): int { return eng_collision_scene_a(i); }
func collision_scene_a(i): int { return eng_collision_scene_a(i); }
func carpisma_sahne_b(i): int { return eng_collision_scene_b(i); }
func collision_scene_b(i): int { return eng_collision_scene_b(i); }
func carpisma_x(i): float { return eng_collision_x(i); }
func collision_x(i): float { return eng_collision_x(i); }
func carpisma_y(i): float { return eng_collision_y(i); }
