// ---- Çarpışma olayları ------------------------------------------------------
// Motor geri çağrım (callback) veremiyor — bugünkü FFI onu taşımıyor. Onun
// yerine KUYRUK: fizik adımında oluşan temaslar halkaya yazılır, oyun karede
// okur. Tipik kullanım:
//
//     int n = carpisma_sayisi();
//     for (int i = 0; i < n; i = i + 1) {
//         if (carpisma_siddeti(i) > 5.0) { hasar_ver(carpisma_a(i)); }
//     }
//
// `carpisma_dusen()` 0 değilse halka dolmuş ve olay KAYBEDİLMİŞ demektir;
// sessizce kırpılmıyor, motor da her karede bir kez hata logluyor.
