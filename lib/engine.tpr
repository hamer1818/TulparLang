// ---- Dünya / kamera ---------------------------------------------------------
func yercekimi(gx, gy, gz) { eng_gravity(gx, gy, gz); }
func gunes(dx, dy, dz, siddet) { eng_sun(dx, dy, dz, siddet); }
func ortam(renk_) { eng_ambient(renk_); }
func golge_hacmi(cx, cy, cz, r, d) { eng_shadow_volume(cx, cy, cz, r, d); }
// Parlama (bloom): motor_ac'tan ONCE cagir. Esik dogrusal parlaklik (1.0 =
// yalniz cok parlak yerler yayilir), yogunluk 0 = kapali.
func parlama(ac, esik, yogunluk) { eng_bloom(ac, esik, yogunluk); }
func bloom(on, threshold, intensity) { eng_bloom(on, threshold, intensity); }
func parlama_acik(): bool { return eng_bloom_on(); }
func kamera(ex, ey, ez, tx, ty, tz) { eng_camera(ex, ey, ez, tx, ty, tz); }
func kamera_yorunge(tx, ty, tz, yaw, pitch, uzaklik) { eng_camera_orbit(tx, ty, tz, yaw, pitch, uzaklik); }
func camera(ex, ey, ez, tx, ty, tz) { eng_camera(ex, ey, ez, tx, ty, tz); }
// Kamera hedefi takip etsin: hedefin arkasında/üstünde (yaw radyan).
func kamera_takip(tx, ty, tz, uzaklik, yukseklik_, yaw) {
    eng_camera(tx + sin(yaw) * uzaklik, ty + yukseklik_, tz + cos(yaw) * uzaklik, tx, ty, tz);
}

