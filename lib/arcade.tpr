// ============================================
// Tulpar Arcade — "Preset" oyun katmanı  🎮🧩
//
// tame'in üstünde, Unreal-blueprint / blok mantığıyla ÇOK KISA kod yazarak
// oyun yapmayı sağlayan üst-seviye motor. Kullanıcı döngü/çarpışma/fizik/çizim
// yazmaz; hazır "blokları" birleştirir:
//
//   import "arcade";
//   func kur() {
//       temizle();
//       oyuncu(320, 240, 24, 24, BLUE);      // ok/WASD ile hareket hazır
//       dusman(100, 100, 24, 24, RED);
//   }
//   sahne(640, 480, "Kac");
//   baslangicta(kur);
//   carpisinca(TAG_PLAYER, TAG_ENEMY, oyun_bitti);
//   oyna();                                   // döngü + çizim + çarpışma otomatik
//
// Her fonksiyonun hem Türkçe hem İngilizce adı var (alias). İngilizce eşleri:
//   scene / on_start / on_hit / play, player / enemy / item / wall / bullet ...
//
// TASARIM NOTLARI (Tulpar kısıtları — deneyle sabitlendi):
//  * Entity'ler PARALEL DİZİLERde tutulur (dizi elemanına struct geri-yazma
//    çalışmıyor; int/float eleman yazımı çalışıyor). Bir entity = bir index.
//  * TÜM callback'ler 0-ARG'dır (call() ile parametre geçmek segfault ediyor).
//    Callback içinde çarpışan taraflar me()/other() ile, context globallerinden
//    okunur; oyun durumu index'li setter'larla (kill, hiz_ver...) değiştirilir.
//  * Döngülerde while yerine for kullanılır (2+ değişkenli while + builtin çağrı
//    bir codegen bug'ını tetikliyor).  Modülo için mod() (`%` operatörü yok).
// ============================================

import "tame";

// ---- Sabitler ---------------------------------------------------------------

// Hareket presetleri (entity başına _emove)
int MV_NONE     = 0;   // hareketsiz — kullanıcı on_frame içinde sürer
int MV_TOPDOWN  = 1;   // ok tuşları / WASD → 8 yön, hız px/sn
int MV_PLATFORM = 2;   // yatay giriş + yerçekimi + zıplama
int MV_VELOCITY = 3;   // sadece kendi hızıyla entegre (mermi/sabit hızlı)

// Hazır tag'ler — kendi int tag'lerini de verebilirsin.
int TAG_PLAYER = 1;
int TAG_ENEMY  = 2;
int TAG_ITEM   = 3;
int TAG_WALL   = 4;
int TAG_BULLET = 5;

// Oyun durumu
int _ar_state = 0;    // 0 = oynanıyor, 1 = oyun bitti, 2 = kazandın (R ile yeniden)
bool _ar_standalone = false;  // play() = true (tek oyun) / launcher = false; oyun-bitti "Ana Menu" vs "Cikis" etiketi

// ---- Bölümler (level) -------------------------------------------------------
//
// Hiç `bolum()` kaydedilmemişse motor bugünkü tek-sahne davranışını korur
// (_has_levels false → HUD göstergesi yok, KAZANDIN state'i hiç oluşmaz).
array _levels = [];        // bölüm kurulum fonksiyonları (0-arg), index = bölüm-1
int _level_n = 0;          // kayıtlı en yüksek bölüm numarası
int _cur_level = 1;        // şu anki bölüm (1-tabanlı)
bool _has_levels = false;
float _banner_t = 0.0;     // "Bölüm N" afişi için kalan süre (sn)
int _lvl_pending = 0;      // 1 = bölüm geçişi bekliyor (bkz. bolum_gec notu)

// ---- Entity paralel dizileri ------------------------------------------------
array _ex = [];      // konum x (float)
array _ey = [];      // konum y (float)
array _ew = [];      // genişlik
array _eh = [];      // yükseklik
array _evx = [];     // hız x (px/sn)
array _evy = [];     // hız y (px/sn)
array _etag = [];    // tag (int)
array _ecolor = [];  // renk (paketli int) — sprite yoksa dikdörtgen bu renkte
array _esprite = []; // texture handle (-1 = yok)
array _emove = [];   // hareket preseti
array _espeed = [];  // topdown/platform taban hız (px/sn)
array _ealive = [];  // 1 = canlı
array _eground = []; // 1 = platformer'da zeminde
array _egen = [];    // slot üretim sayacı (bayat handle tespiti — aşağıya bak)
int _n = 0;          // AYRILMIŞ slot sayısı (ölüler dahil; canlı sayısı değil)

// ---- Slot geri kazanımı (boş-slot yığını) ----------------------------------
//
// Ölen entity'nin slot'u geri kullanılır; aksi halde sürekli mermi/düşman üreten
// bir oyunda paralel diziler sınırsız büyürdü.
//
// Tuzak: slot'u çıplak index olarak geri vermek, ölmüş bir entity'nin id'sini
// elinde tutan kodun slot yeniden kullanılınca SESSİZCE başka bir entity'yi
// oynatmasına yol açar. Bu yüzden dışarıya verilen id bir **handle**'dır:
//
//     handle = _egen[slot] * _ID_STRIDE + slot
//
// Öldürmede `_egen[slot]` artar → o slot'a ait tüm eski handle'lar anında
// bayatlar. Bayat handle ile yapılan her çağrı sessizce yok sayılır ve
// `yasiyor(h)` dürüstçe false döner (aliasing yerine dürüst "öldü" cevabı).
array _efree = [];   // boş slot yığını
int _free_n = 0;     // yığın tepesi (_efree kırpılmaz; bu sayaç sınırlar)
int _ID_STRIDE = 1048576;   // 2^20 slot/oyun — pratikte tavan yok

// Slot -> dışarıya verilen handle.
func _mk_handle(slot): int { return _egen[slot] * _ID_STRIDE + slot; }

// Handle -> slot; bayat/geçersizse -1. Tüm public id API'si bundan geçer.
func _slot_of(h): int {
    if (h < 0) { return -1; }
    int slot = mod(h, _ID_STRIDE);
    if (slot >= _n) { return -1; }
    int gen = toInt((h - slot) / _ID_STRIDE);
    if (gen != _egen[slot]) { return -1; }   // slot geri kullanılmış → bayat
    return slot;
}
int _ar_i = 0;       // fizik döngüsünün GÜNCEL entity index'i (GLOBAL — bkz.
                     // _ar_apply_movement'taki codegen notu; poison workaround)

// ---- Dünya / fizik ayarları -------------------------------------------------
float _world_w = 640.0;
float _world_h = 480.0;
float _gravity = 0.0;     // px/sn^2 (0 = kapalı); platformer bunu kullanır
float _jump_v  = 520.0;   // zıplama başlangıç hızı (px/sn, yukarı)
bool  _clamp_world = true; // topdown'da entity'yi dünya sınırında tut

// ---- Dokunmatik kontrol (mobil) ---------------------------------------------
// Sol tarafta yüzen DİNAMİK analog joystick (yuvarlak içinde yuvarlak) + —yalnızca
// oyun ateş/aksiyon okuyorsa— sağ altta aksiyon butonu çizilir/okunur. İlk
// dokunuşta OTOMATİK açılır; masaüstünde klavye çalışmaya devam eder (girdi =
// klavye VEYA dokunma). raylib touch koordinatlarını oyun-dünyası
// uzayına ölçekler (Android'de doğrulandı), bu yüzden zone'lar _world_w/_world_h
// ile tanımlı. touch_controls(false) ile kapatılabilir / (true) ile zorlanabilir.
bool _ar_touch_ui   = false;  // overlay çiz + oku (ilk dokunuşta açılır)
bool _ar_touch_force = false; // touch_controls(true): dokunma olmadan da aç
bool _ar_act_now    = false;  // aksiyon butonu bu kare basılı mı
bool _ar_act_prev   = false;
bool _ar_act_edge   = false;  // aksiyon butonu bu kare YENİ basıldı (jump/fire)
bool _ar_td_left    = false;  // yön durumları (bu kare; joystick eşiğinden türetilir)
bool _ar_td_right   = false;
bool _ar_td_up      = false;
bool _ar_td_down    = false;
bool _ar_tap_edge   = false;  // herhangi bir parmak 0→>0 (oyun-bitti'de restart)
int  _ar_touch_prevn = 0;
// Aksiyon/ateş butonu SADECE oyun onu okuyorsa (action_*/fire_*/zıplama preset'i)
// çizilir/okunur — böylece ateşi olmayan oyunlarda boş buton görünmez.
bool _ar_wants_action = false;
// Joystick SADECE oyun yön okuyorsa (left/right/up/down VEYA topdown/platform
// preset'i) çizilir — sadece-dokunma oyunlarında (ör. flappy) joystick çıkmaz.
bool _ar_wants_move = false;
// KONTROL ŞEMASI — oyun türüne göre hazır dokunmatik yerleşimler.
// 0=auto (oyunun OKUDUĞU yönlerden çıkar: yalnız sağ/sol → yatay butonlar,
// yalnız yukarı/aşağı → dikey butonlar, iki eksen → joystick, hiç → yok),
// 1=joystick, 2=dpad (4 ok butonu), 3=yatay (◀▶), 4=dikey (▲▼), 5=yok,
// 6=egim (telefonu eğerek — ivmeölçer; sensör yoksa/masaüstünde klavyeye düşer).
// kontrol_semasi("dpad") / control_scheme("horizontal") ile oyun elle seçer.
int  _ar_scheme = 0;
// Eğim (tilt) eşiği (m/s^2) — nötrden bu kadar sapınca yön tetiklenir (~13°).
float _ar_tilt_thr = 2.2;
// Taban çizgisi kalibrasyonu: moda ilk girişte "nötr tutuş" yakalanır; yön
// bu NÖTRDEN SAPMAYLA ölçülür → cihaz yönelimi/tutuş açısından bağımsız
// (yerçekimi hangi eksene düşerse düşsün sıfırlanır). _lx_clear/_ar_reset sıfırlar.
bool  _ar_tilt_cal = false;
float _ar_tilt_ax0 = 0.0;
float _ar_tilt_ay0 = 0.0;
bool _ar_rd_l = false;   // bu oyun hangi yönleri okudu (auto şema çıkarımı)
bool _ar_rd_r = false;
bool _ar_rd_u = false;
bool _ar_rd_d = false;
// Modern DİNAMİK analog joystick (yuvarlak içinde yuvarlak, yüzen taban):
// parmak sol bölgeye basınca taban orada belirir, parmağı sürükledikçe topuz
// (knob) onu takip eder; parmak çekilene kadar yön girdisi sürer. Taban parmağı
// halka kadar takip eder ("trailing" his). Yön analogtur ([-1..1]); preset'ler
// için eşikle 8-yönlü boolean'a çevrilir.
// Swipe (kaydırma) jesti: parmak inişinden kalkışına vektör; eşik üstü ve
// baskın eksende ise parmak kalktığı KARE yön bildirir. Joystick/butondan
// bağımsız izlenir — jest tabanlı oyunlar (yılan tarzı) kontrol çizdirmeden
// kaydirildi("sol") ile oynanır.
int   _ar_swipe = 0;           // bu kare: 0 yok, 1 sol, 2 sağ, 3 yukarı, 4 aşağı
float _ar_sw_x0 = 0.0;         // parmak iniş noktası
float _ar_sw_y0 = 0.0;
float _ar_sw_x1 = 0.0;         // son bilinen konum
float _ar_sw_y1 = 0.0;
bool  _ar_joy_on = false;      // bu kare joystick etkin (bir parmak sürüyor)
float _ar_joy_bx = 0.0;        // taban merkezi (SABİT — sol-alt köşede demirli)
float _ar_joy_by = 0.0;
float _ar_joy_kx = 0.0;        // topuz (parmak) konumu, halkaya kırpılı
float _ar_joy_ky = 0.0;
float _ar_joy_dx = 0.0;        // analog yön x [-1..1]
float _ar_joy_dy = 0.0;        // analog yön y [-1..1]

// ---- Çarpışma kuralları (registry) ------------------------------------------
array _ca  = [];   // tag A
array _cb  = [];   // tag B
array _cfn = [];   // 0-arg callback fonksiyonu

// ---- Callback context'i (me()/other() bunları okur) -------------------------
int _hit_self  = -1;
int _hit_other = -1;

// ---- Sahne callback'leri ----------------------------------------------------
var _start_fn = 0;   // baslangicta(fn): kurulum + R sonrası yeniden
var _frame_fn = 0;   // her_kare(fn): kare başı kullanıcı mantığı (opsiyonel)
var _draw_fn  = 0;   // ciz_ustune(fn): otomatik çizim üstüne ek çizim
bool _has_start = false;
bool _has_frame = false;
bool _has_draw  = false;

// ---- Dil / language ---------------------------------------------------------
// Motorun ürettiği HUD metinleri (skor öneki, "Bölüm n/N", OYUN BITTI/KAZANDIN,
// yeniden-başla ipucu) bu koda göre TR ya da EN çizilir. Varsayılan: sistem dili
// (`sys_lang()` "en" ise İngilizce, aksi halde Türkçe). `dil("en")`/`language("tr")`
// ile açıkça ezilir. `bilgi()/controls()` şeridi oyun tarafından verilir — onun
// dili çağıran oyuna aittir, motor karışmaz.
str _lang = "";           // "" = henüz çözülmedi (ilk _lang_now'da sys_lang'dan gelir)

// Etkin dili döndür; ilk çağrıda sistem dilinden çözer (ve önbelleğe alır).
func _lang_now(): str {
    if (_lang == "") {
        if (sys_lang() == "en") { _lang = "en"; }
        else { _lang = "tr"; }
    }
    return _lang;
}
func language(code) { if (code == "en") { _lang = "en"; } else { _lang = "tr"; } }
func dil(code)      { language(code); }

// ---- Ses / haptik ayarları (kalıcı, in-app Ayarlar ekranından değişir) ------
// Motorun ürettiği tüm ses (tm_beep) ve titreşim (tm_vibrate) bu bayraklardan
// geçer; oyuncu Ayarlar'dan kapatırsa sessiz/titremesiz oynar. Ayarlar üç
// küçük dosyada kalıcıdır (en iyi-skor deseniyle aynı: save_data/load_data).
bool _snd_on = true;
bool _hap_on = true;
bool _mus_on = true;       // arka plan müziği (Ayarlar'dan aç-kapa; SFX'ten bağımsız)
bool _fps_on = false;      // FPS sayacı (Ayarlar'dan aç-kapa; varsayılan kapalı)
bool _cfg_loaded = false;
bool  _cfg_reset_armed = false;  // "Rekorları Sıfırla" iki-dokunuş onayı bekliyor mu
float _cfg_reset_msg   = 0.0;    // >0 → "Silindi" geri bildirimi (frame_time ile azalır)

func _ar_load_settings() {
    if (_cfg_loaded) { return; }
    _cfg_loaded = true;
    str s = load_data("arcade_snd.txt");  if (s == "0") { _snd_on = false; }
    str h = load_data("arcade_hap.txt");  if (h == "0") { _hap_on = false; }
    str m = load_data("arcade_mus.txt");  if (m == "0") { _mus_on = false; }
    str f = load_data("arcade_fps.txt");  if (f == "1") { _fps_on = true; }
    str l = load_data("arcade_lang.txt"); if (l == "en") { _lang = "en"; } else if (l == "tr") { _lang = "tr"; }
}
func _ar_save_settings() {
    if (_snd_on) { save_data("arcade_snd.txt", "1"); } else { save_data("arcade_snd.txt", "0"); }
    if (_hap_on) { save_data("arcade_hap.txt", "1"); } else { save_data("arcade_hap.txt", "0"); }
    if (_mus_on) { save_data("arcade_mus.txt", "1"); } else { save_data("arcade_mus.txt", "0"); }
    if (_fps_on) { save_data("arcade_fps.txt", "1"); } else { save_data("arcade_fps.txt", "0"); }
    save_data("arcade_lang.txt", _lang_now());
}

// Motor-içi ses/haptik kapıları — merkezî çağrılar bunları kullanır (doğrudan
// tm_beep/tm_vibrate DEĞİL) ki Ayarlar aç-kapa'sı her yere işlesin.
func _snd(freq, ms) { if (_snd_on) { tm_beep(freq, ms); } }
func _hap(ms)       { if (_hap_on) { tm_vibrate(ms); } }

// Public aç-kapa (oyun kodu da isterse kullanabilir).
func sound_on(on)  { _snd_on = on; }
func ses_ac(on)    { _snd_on = on; }
func haptics_on(on){ _hap_on = on; }
func titresim_ac(on){ _hap_on = on; }
func music_on(on)  { _mus_on = on; if (!on) { _mus_track = -1; } }
func muzik_ac(on)  { music_on(on); }
func show_fps(on)  { _fps_on = on; }
func fps_goster(on){ _fps_on = on; }

// ---- Prosedürel arka plan müziği (dosyasız chiptune sekanslayıcı) -----------
// tm_tone ile notaları KISIK (SFX'i bastırmadan) çalar; iki parça: 0=menü
// (sakin A-minör arpej), 1=oyun (hareketli C-majör pentatonik). elapsed()
// mutlak saatine göre sıradaki notayı tetikler → kare hızından bağımsız tempo.
// Frekans 0.0 = es (sessiz nota). Parça döngüsel; sona gelince başa sarar.
float _mus_vol   = 0.26;   // nota ses seviyesi (0..1); SFX=1.0'in altında kalır
int   _mus_idx   = 0;      // aktif parçadaki sıradaki nota
float _mus_next  = 0.0;    // elapsed() zamanı: bu nota ne zaman çalınacak
int   _mus_track = -1;     // -1=yüklü değil, 0=menü, 1=oyun
array _mus_f = [];         // aktif parça: nota frekansları (Hz; 0=es)
array _mus_d = [];         // aktif parça: nota süreleri (sn)

func _mus_select(track) {
    if (track == _mus_track) { return; }
    _mus_track = track;
    _mus_idx = 0;
    _mus_next = elapsed();   // sıradaki karede hemen başla
    if (track == 0) {
        // Menü — sakin, geniş arpej (A2 kökü); es'lerle nefes alır.
        _mus_f = [220.0, 261.63, 329.63, 440.0, 329.63, 261.63, 0.0, 196.0, 246.94, 329.63, 392.0, 329.63, 246.94, 0.0];
        _mus_d = [0.32, 0.32, 0.32, 0.32, 0.32, 0.32, 0.32, 0.32, 0.32, 0.32, 0.32, 0.32, 0.32, 0.32];
    } else {
        // Oyun — hareketli pentatonik döngü.
        _mus_f = [523.25, 659.25, 783.99, 659.25, 523.25, 392.0, 523.25, 659.25, 587.33, 440.0, 523.25, 659.25, 783.99, 1046.5, 783.99, 659.25];
        _mus_d = [0.17, 0.17, 0.17, 0.17, 0.17, 0.17, 0.17, 0.17, 0.17, 0.17, 0.17, 0.17, 0.17, 0.17, 0.17, 0.17];
    }
}

// Her karede çağrılır: seçili parçayı kur, sıradaki notanın vakti geldiyse çal.
func _mus_step(track) {
    if (!_mus_on) { return; }
    _mus_select(track);
    float now = elapsed();
    if (now >= _mus_next) {
        int n = len(_mus_f);
        if (n <= 0) { return; }
        float f = _mus_f[_mus_idx];
        float d = _mus_d[_mus_idx];
        if (f > 0.0) { tm_tone(f, toInt(d * 850.0), _mus_vol); }
        _mus_next = now + d;
        _mus_idx = _mus_idx + 1;
        if (_mus_idx >= n) { _mus_idx = 0; }
    }
}

// HUD
str _hud_prefix = "";     // "" = dile göre varsayılan ("Skor: " / "Score: ")
bool _hud_set = false;    // hud()/hud_prefix() ile açıkça ayarlandı mı?
int _score = 0;
bool _show_score = true;
bool _ar_paused = false;   // oyun-içi duraklatma (play/launcher döngüsü okur; erken tanım)

// Juice durumu — score_add / _pt_spawn (yukarıda) bunları kullandığı için erken.
array _pop_x = []; array _pop_y = []; array _pop_t = []; array _pop_txt = []; array _pop_kind = [];
int _pop_n = 0;
float _fx_last_x = 0.0;    // son patlama konumu (popup çıpası)
float _fx_last_y = 0.0;
float _fx_last_t = 0.0;    // > 0 ise son patlama bu kareye yakın
int   _combo = 0;          // ardışık seri sayacı (görsel; skoru bozmaz)
float _combo_t = 0.0;      // seri penceresi (sn); 0'a inince sıfırlanır
float _trans_t = 0.0;      // menü↔oyun geçiş fade'i (sn)

// Global skor tablosu (opsiyonel; skor_tablosu_url ile açılır). Oyun-bitişinde
// skoru bir Tulpar Wings sunucusuna GÖNDERİR ve top-10'u ÇEKİP gösterir.
// _lb_url == "" ise tamamen kapalı (varsayılan) → hiçbir ağ çağrısı yapılmaz.
str  _lb_url  = "";
str  _lb_name = "Oyuncu";
array _lb_data = [];       // son çekilen tablo (isim/skor kayıtları)
bool _lb_has = false;      // bu oyun-bitişinde tablo çekilebildi mi?
str _hint = "";           // üst bilgilendirme şeridi (kontroller vb.)
bool _has_hint = false;

// ============================================================================
//  KURULUM / DÖNGÜ
// ============================================================================

// Pencereyi açar, 60 FPS ayarlar, dünyayı entity'nin sığacağı boyuta kurar.
func scene(w, h, title): bool {
    _world_w = w * 1.0;
    _world_h = h * 1.0;
    _ar_title = title;          // kalıcı en-iyi-skor kayıt anahtarı
    set_fps(60);
    return window(w, h, title);
}
func sahne(w, h, title): bool { return scene(w, h, title); }

// Kurulum callback'i: oyun başında ve her R (yeniden başlat) çağrılır.
func on_start(fn)     { _start_fn = fn; _has_start = true; }
func baslangicta(fn)  { on_start(fn); }

// Kare başı kullanıcı mantığı (opsiyonel, 0-arg).
func on_frame(fn)  { _frame_fn = fn; _has_frame = true; }
func her_kare(fn)  { on_frame(fn); }

// Otomatik çizimin üstüne ek çizim (opsiyonel, 0-arg).
func on_draw(fn)    { _draw_fn = fn; _has_draw = true; }
func ciz_ustune(fn) { on_draw(fn); }

// Yönetilen ana döngü: giriş + fizik + çarpışma + otomatik çizim + HUD +
// oyun-bitti/R-yeniden hepsi burada. Bundan sonra kod yazmana gerek yok.
func play() {
    _ar_load_settings();               // kalıcı ses/haptik/dil ayarları
    _ar_standalone = true;             // oyun-bitti ekranında ikinci buton = "Cikis"
    _ar_start_level = 1;               // tek oyun: bölüm seçimi yok, 1'den başla
    _lx_load_lvl_done(_ar_title, _level_n);   // bölüm yıldızlarını işaretleyebilmek için
    _ar_reset();
    _trans_start();                    // açılışta kısa fade-in
    var wm = arena_save();
    while (running()) {
        // Tek oyun (launcher yok): GERİ / ESC → duraklat. Menü olmadığı için
        // duraklat menüsünün 3. seçeneği "Çıkış"tır (pencereyi kapatır).
        // Yalnız aktif oynanırken duraklanır (biten oyun duraklatılamaz).
        if (!_ar_paused && _ar_state == 0) {
            if (key_pressed("ESCAPE") || key_pressed("BACKSPACE") || key_pressed("BACK")) {
                _pause_enter();
            }
        }
        if (_ar_paused) {
            str ql = "Cikis"; if (_lang_now() == "en") { ql = "Quit"; }
            _mus_step(0);                  // duraklatınca sakin parça
            frame_begin();
            _ar_draw_all();
            _pause_draw(ql);
            frame_end();
            int act = _pause_step();
            if (act == 1) { _ar_paused = false; }
            else if (act == 2) { _ar_reset(); _ar_paused = false; }
            else if (act == 3) { break; }
        } else {
            _ar_update();
            if (_ar_state == 0) { _mus_step(1); } else { _mus_step(0); }
            frame_begin();
            _ar_draw_all();
            _trans_draw();
            frame_end();
            // Oyun-bitti ekranı: yalnız butonlar iş yapar (ekrana dokunma başlatmaz).
            if (_ar_state != 0) {
                int oa = _ar_over_step();
                if (oa == 1) { _ar_reset(); _trans_start(); }
                else if (oa == 2) { break; }   // tek oyunda "Cikis" → pencere kapanır
            }
        }
        arena_restore(wm);
    }
    arena_drop(wm);
    close_window();
}
func oyna() { play(); }

// Baştan kur: entity'leri temizler, skoru sıfırlar, 1. bölüme döner.
// R (yeniden başla) hem "oyun bitti" hem "kazandın" durumundan buraya gelir:
// skor 0 + bölüm 1. (Sadece bulunduğun bölümü tekrarlamak kasten YOK — oyuncu
// "yeniden" deyince baştan başlamayı bekler; en tahmin edilebilir olan bu.)
int _ar_start_level = 1;   // "Tekrar Oyna"/reset bu bölüme döner (bölüm-seçimi ayarlar)

func _ar_reset() {
    _score = 0;
    _ar_state = 0;
    _cur_level = _ar_start_level;
    _banner_t = 0.0;
    _lvl_pending = 0;
    _ar_paused = false;
    _fx_reset();
    _new_record = false;
    _ar_load_best();
    _ar_load_level();
}

// Güncel bölümü kur: entity'leri sil → global kurulum (_start_fn) → bölüm fn'i.
// Bölüm kaydı yoksa bu tam olarak eski _ar_reset gövdesidir (geriye uyum).
func _ar_load_level() {
    clear_entities();
    if (_has_start) { call(_start_fn); }
    if (_has_levels) {
        if (_cur_level >= 1 && _cur_level <= _level_n) {
            var lfn = _levels[_cur_level - 1];
            if (lfn != 0) { call(lfn); }
        }
    }
}

// ============================================================================
//  BÖLÜMLER (level)
// ============================================================================

// Bölüm kurulum fonksiyonu kaydet (n 1-tabanlı, fn 0-arg).
// Aynı n iki kez kaydedilirse sonuncusu kazanır. Kayıtlar `temizle()` ile
// SİLİNMEZ — bölümler entity değil, oyun tanımının parçasıdır.
func level(n, fn) {
    if (n < 1) { return; }
    // Diziyi n'e kadar 0 ile büyüt (araya boş bölüm kaydı bırakılabilir).
    for (int i = length(_levels); i < n; i = i + 1) { push(_levels, 0); }
    _levels[n - 1] = fn;
    if (n > _level_n) { _level_n = n; }
    _has_levels = true;
}
func bolum(n, fn) { level(n, fn); }

// Sıradaki bölüme geç. Son bölümdeyse → KAZANDIN (_ar_state = 2).
//
// DİKKAT: geçişi burada YAPMAZ, sadece işaretler. Bu fonksiyon tipik olarak bir
// çarpışma callback'inden çağrılır ve o sırada `_ar_collisions()` paralel
// dizilerin üstünde dönüyordur; hemen `clear_entities()` çağırmak o döngünün
// altındaki diziyi değiştirirdi. Geçiş güvenli noktada (kare sonunda,
// _ar_update/step içinde) uygulanır.
func next_level() { _lvl_pending = 1; }
func bolum_gec()  { next_level(); }

// Bekleyen bölüm geçişini uygula (motor içi, kare sonunda çağrılır).
func _ar_advance_level() {
    // Bu bölüm geçildi → o bölümün yıldızını kazan (bölüm-başına ilerleme).
    _ar_mark_level(_cur_level);
    if (_cur_level + 1 > _level_n) {            // son bölüm → kazandın
        _ar_state = 2;
        _ar_badge_set(0);     // "İlk Zafer" rozeti
        _snd(1046.0, 220);    // KAZANDIN — zafer tonu (C6)
        _ar_check_record();
        _lb_submit_fetch();   // global tablo açıksa: skoru gönder + top-10 çek
        return;
    }
    _cur_level = _cur_level + 1;
    _banner_t = 1.2;              // "Bölüm N" afişi ~1.2 sn
    _snd(680.0, 90);          // bölüm-geçiş "yükselen" tonu
    _ar_load_level();             // skor KORUNUR (oyuncunun toplam skoru)
}

func level_no(): int    { return _cur_level; }
func bolum_no(): int    { return _cur_level; }
func level_count(): int { return _level_n; }
func bolum_sayisi(): int { return _level_n; }

// ============================================================================
//  ENTITY OLUŞTURMA ("bloklar")
// ============================================================================

// Genel oluşturucu — entity handle'ı döner (çıplak index DEĞİL; bkz _mk_handle).
// Önce ölmüş bir slot varsa onu geri kullanır, yoksa dizileri büyütür.
func spawn(x, y, w, h, color, tag, mv): int {
    if (_free_n > 0) {
        _free_n = _free_n - 1;
        int s = _efree[_free_n];
        _ex[s] = x * 1.0;
        _ey[s] = y * 1.0;
        _ew[s] = w * 1.0;
        _eh[s] = h * 1.0;
        _evx[s] = 0.0;
        _evy[s] = 0.0;
        _etag[s] = tag;
        _ecolor[s] = color;
        _esprite[s] = -1;
        _emove[s] = mv;
        _espeed[s] = 200.0;
        _ealive[s] = 1;
        _eground[s] = 0;
        return _mk_handle(s);       // _egen[s] öldürmede artmıştı → yeni kimlik
    }
    push(_ex, x * 1.0);
    push(_ey, y * 1.0);
    push(_ew, w * 1.0);
    push(_eh, h * 1.0);
    push(_evx, 0.0);
    push(_evy, 0.0);
    push(_etag, tag);
    push(_ecolor, color);
    push(_esprite, -1);
    push(_emove, mv);
    push(_espeed, 200.0);
    push(_ealive, 1);
    push(_eground, 0);
    push(_egen, 1);
    int slot = _n;
    _n = _n + 1;
    return _mk_handle(slot);
}

// Slot'u öldür + boş yığına geri koy (MOTOR İÇİ — slot alır, handle değil).
// Üretim sayacını artırır: o slot'a ait eski handle'lar burada bayatlar.
func _kill_slot(slot) {
    if (slot < 0) { return; }
    if (_ealive[slot] == 0) { return; }        // çift-free koruması
    _ealive[slot] = 0;
    _egen[slot] = _egen[slot] + 1;
    if (_free_n < len(_efree)) { _efree[_free_n] = slot; }
    else { push(_efree, slot); }
    _free_n = _free_n + 1;
}
func uret(x, y, w, h, color, tag, mv): int { return spawn(x, y, w, h, color, tag, mv); }

// Oyuncu: ok tuşları / WASD ile hareket hazır gelir (topdown).
func player(x, y, w, h, color): int { return spawn(x, y, w, h, color, TAG_PLAYER, MV_TOPDOWN); }
func oyuncu(x, y, w, h, color): int { return player(x, y, w, h, color); }

// Platformer oyuncusu: yatay giriş + yerçekimi + zıplama (yercekimi() ile aç).
func platformer(x, y, w, h, color): int { return spawn(x, y, w, h, color, TAG_PLAYER, MV_PLATFORM); }
func oyuncu_p(x, y, w, h, color): int { return platformer(x, y, w, h, color); }

// Düşman: hareketsiz başlar (hiz_ver ile ya da on_frame ile sürersin).
func enemy(x, y, w, h, color): int { return spawn(x, y, w, h, color, TAG_ENEMY, MV_NONE); }
func dusman(x, y, w, h, color): int { return enemy(x, y, w, h, color); }

// Toplanabilir eşya (hareketsiz).
func item(x, y, w, h, color): int { return spawn(x, y, w, h, color, TAG_ITEM, MV_NONE); }
func esya(x, y, w, h, color): int { return item(x, y, w, h, color); }

// Katı duvar/platform (hareketsiz; platformer entity'leri buna basar/çarpar).
func wall(x, y, w, h, color): int { return spawn(x, y, w, h, color, TAG_WALL, MV_NONE); }
func duvar(x, y, w, h, color): int { return wall(x, y, w, h, color); }

// Mermi: verilen hızla kendi başına uçar (velocity preset).
func bullet(x, y, w, h, color, vx, vy): int {
    int id = spawn(x, y, w, h, color, TAG_BULLET, MV_VELOCITY);
    int s = _slot_of(id);          // spawn handle döner — diziler slot'la indekslenir
    _evx[s] = vx * 1.0;
    _evy[s] = vy * 1.0;
    return id;
}
func mermi(x, y, w, h, color, vx, vy): int { return bullet(x, y, w, h, color, vx, vy); }

// Tüm entity'leri sil (yeniden başlatmada _ar_reset çağırır).
func clear_entities() {
    _ex = [];  _ey = [];  _ew = [];  _eh = [];
    _evx = []; _evy = []; _etag = []; _ecolor = [];
    _esprite = []; _emove = []; _espeed = []; _ealive = []; _eground = [];
    _egen = []; _efree = [];
    _n = 0;
    _free_n = 0;
}
func temizle() { clear_entities(); }

// ============================================================================
//  ENTITY KONTROL (index ile — callback'lerin "kasları")
// ============================================================================

// NOT: buradaki `id` bir handle'dır (çıplak index değil) — hepsi önce
// `_slot_of` ile slot'a çevirir. Bayat handle (slot geri kullanılmış) sessizce
// yok sayılır: setter'lar hiçbir şey yapmaz, getter'lar nötr değer döner.
func set_vel(id, vx, vy) { int s = _slot_of(id); if (s < 0) { return; } _evx[s] = vx * 1.0; _evy[s] = vy * 1.0; }
func hiz_ver(id, vx, vy) { set_vel(id, vx, vy); }

func set_pos(id, x, y) { int s = _slot_of(id); if (s < 0) { return; } _ex[s] = x * 1.0; _ey[s] = y * 1.0; }
func konumla(id, x, y) { set_pos(id, x, y); }

func get_x(id): float { int s = _slot_of(id); if (s < 0) { return 0.0; } return _ex[s]; }
func get_y(id): float { int s = _slot_of(id); if (s < 0) { return 0.0; } return _ey[s]; }
func x_of(id): float { int s = _slot_of(id); if (s < 0) { return 0.0; } return _ex[s]; }
func y_of(id): float { int s = _slot_of(id); if (s < 0) { return 0.0; } return _ey[s]; }

// Hız okuma. `_evx[id]` ile DOĞRUDAN okumak yanlıştır: id bir handle'dır,
// diziler slot ile indekslenir (handle = gen*1048576 + slot → dizi dışı).
func get_vx(id): float { int s = _slot_of(id); if (s < 0) { return 0.0; } return _evx[s]; }
func get_vy(id): float { int s = _slot_of(id); if (s < 0) { return 0.0; } return _evy[s]; }
func vx_of(id): float { return get_vx(id); }
func vy_of(id): float { return get_vy(id); }

// Topdown/platform taban hızını ayarla (px/sn).
// (slot değişkeni `sl` — `s` zaten hız parametresi)
func move_speed(id, s) { int sl = _slot_of(id); if (sl < 0) { return; } _espeed[sl] = s * 1.0; }
func hiz_ayarla(id, s) { move_speed(id, s); }

func set_color(id, c) { int s = _slot_of(id); if (s < 0) { return; } _ecolor[s] = c; }
func renk_ata(id, c)  { set_color(id, c); }

func set_sprite(id, tex) { int s = _slot_of(id); if (s < 0) { return; } _esprite[s] = tex; }
func resim_ata(id, tex)  { set_sprite(id, tex); }

func kill(id)   { _kill_slot(_slot_of(id)); }
func oldur(id)  { kill(id); }

func alive(id): bool  { int s = _slot_of(id); if (s < 0) { return false; } return _ealive[s] == 1; }
func yasiyor(id): bool { int s = _slot_of(id); if (s < 0) { return false; } return _ealive[s] == 1; }

func tag_of(id): int { int s = _slot_of(id); if (s < 0) { return -1; } return _etag[s]; }
func tag_al(id): int { int s = _slot_of(id); if (s < 0) { return -1; } return _etag[s]; }

// AYRILMIŞ slot sayısı — canlı entity sayısı DEĞİL. Ölen slot'lar geri
// kullanıldığı için bu sayı eşzamanlı en yüksek entity sayısına oturur
// (sürekli mermi üreten bir oyunda sonsuza dek büyümez).
func entity_count(): int { return _n; }
func entity_sayisi(): int { return _n; }

// Şu an canlı olan entity sayısı.
func live_count(): int {
    int c = 0;
    for (int i = 0; i < _n; i = i + 1) {
        if (_ealive[i] == 1) { c = c + 1; }
    }
    return c;
}
func canli_sayisi(): int { return live_count(); }

// Belirli tag'e sahip canlı entity sayısı — "tüm eşyalar toplandı mı?" gibi
// bölüm bitiş koşulları için (live_count() oyuncuyu/duvarları da sayar).
func tag_count(t): int {
    int c = 0;
    for (int i = 0; i < _n; i = i + 1) {
        if (_ealive[i] == 1 && _etag[i] == t) { c = c + 1; }
    }
    return c;
}
func tag_sayisi(t): int { return tag_count(t); }

// ============================================================================
//  ÇARPIŞMA
// ============================================================================

// tagA'lı bir entity tagB'li bir entity'ye değince fn (0-arg) çağrılır.
// fn içinde ben()=tagA tarafı, oteki()=tagB tarafı. Kural yönlüdür ama motor
// simetriği de dener (B→A eşleşmesi de tetikler, me/other buna göre ayarlanır).
func on_hit(tagA, tagB, fn) {
    push(_ca, tagA);
    push(_cb, tagB);
    push(_cfn, fn);
}
func carpisinca(tagA, tagB, fn) { on_hit(tagA, tagB, fn); }

// Callback context'i.
// Çarpışan taraflar — handle döner (_hit_* içeride slot tutar).
func me(): int    { if (_hit_self < 0)  { return -1; } return _mk_handle(_hit_self); }
func ben(): int   { return me(); }
func other(): int { if (_hit_other < 0) { return -1; } return _mk_handle(_hit_other); }
func oteki(): int { return other(); }

// İki entity çakışıyor mu? (manuel test)
// a/b handle'dır → slot'a çözülür (diziye doğrudan handle ile girmek dizi dışını
// okur; bkz. get_vx notu). Bayat/ölü handle → false.
func overlaps(a, b): bool {
    int sa = _slot_of(a);
    int sb = _slot_of(b);
    if (sa < 0 || sb < 0) { return false; }
    return rect_overlap(_ex[sa], _ey[sa], _ew[sa], _eh[sa], _ex[sb], _ey[sb], _ew[sb], _eh[sb]);
}
func degiyor(a, b): bool { return overlaps(a, b); }

// ============================================================================
//  FİZİK / SAHNE AYARLARI
// ============================================================================

// Platformer yerçekimini aç (px/sn^2). 0 = kapalı (topdown/arcade).
func gravity(g)    { _gravity = g * 1.0; }
func yercekimi(g)  { gravity(g); }

// Zıplama hızını ayarla (yukarı, px/sn).
func jump_power(v) { _jump_v = v * 1.0; }
func ziplama(v)    { jump_power(v); }

// Dünya sınırında tutmayı aç/kapat (topdown).
func clamp_to_world(on) { _clamp_world = on; }

// ---- Skor / oyun-bitti ------------------------------------------------------
// Skor artışı yumuşak bir "blip" çalar (tüm oyunlara bedava işitsel geri
// bildirim). tm_beep ses cihazı yoksa güvenle no-op'tur (headless test/CI).
func score_add(n) {
    _score = _score + n;
    _snd(720.0, 40);
    // Seri (combo) — yalnız görsel; skoru değiştirmez → rekorlar adil kalır.
    if (_combo_t > 0.0) { _combo = _combo + 1; } else { _combo = 1; }
    _combo_t = 1.1;
    // "+N" baloncuğu: son patlama konumunda (çarpışma yeri), yoksa üst-orta.
    float px = _world_w * 0.5; float py = _world_h * 0.30;
    if (_fx_last_t > 0.0) { px = _fx_last_x; py = _fx_last_y; }
    _pop_spawn(px, py, "+" + toString(n), 0);
    if (_combo >= 3) {
        str cw = "SERI x"; if (_lang_now() == "en") { cw = "STREAK x"; }
        _pop_spawn(px, py - 24.0, cw + toString(_combo), 1);
    }
}
func skor_ekle(n) { score_add(n); }
func score(): int { return _score; }
func skor(): int  { return _score; }
func set_score(n) { _score = n; }
func skor_ata(n)  { _score = n; }

// Oyun bitişi otomatik "juice" alır: sarsıntı + flash (tüm oyunlara bedava).
// İlk çağrıda rekor kontrolü de yapılır; tekrar çağrılar durumu bozmaz.
func game_over() {
    if (_ar_state == 0) {
        sars();
        parla();
        _snd(150.0, 240);      // düşük "kayıp" tonu (tüm oyunlara bedava)
        _hap(220);             // ölüm titreşimi (Android; masaüstü/web no-op)
        _ar_check_record();
        _lb_submit_fetch();    // global tablo açıksa: skoru gönder + top-10 çek
    }
    _ar_state = 1;
}
func oyun_bitti() { game_over(); }

// "Oyun artık oynanmıyor mu?" — kaybetmek (1) de kazanmak (2) da bitiştir.
// Bölüm kaydı olmayan oyunlarda state 2 hiç oluşmaz → eski davranışla aynı.
func is_over(): bool  { return _ar_state != 0; }
func bitti_mi(): bool { return _ar_state != 0; }

// Sadece "son bölüm de bitti" (kazandın) durumu.
func is_won(): bool    { return _ar_state == 2; }
func kazandin_mi(): bool { return _ar_state == 2; }

// HUD skor metnini özelleştir / gizle.
func hud(prefix)  { _hud_prefix = prefix; _hud_set = true; }
func hud_gizle()  { _show_score = false; }
func hide_hud()   { _show_score = false; }

// Ekranın üstünde kontrol/etkileşim bilgilendirme şeridi (ör.
//   bilgi("Ok/WASD: hareket   SPACE: ates")). Skorun altında çizilir.
func bilgi(s)    { _hint = s; _has_hint = true; }
func controls(s) { _hint = s; _has_hint = true; }
func help_text(s){ _hint = s; _has_hint = true; }

// ============================================================================
//  EFEKTLER — parçacık + sarsıntı + flash ("juice", saf Tulpar)
// ============================================================================
// patlama(x,y,renk) bir çarpışma callback'inden çağrılır; sars()/parla() da
// öyle. Motor bunları kare sonunda kendisi günceller/çizer. Parçacıklar da
// entity'ler gibi PARALEL DİZİ + slot geri kazanımı kullanır (ölü slot = life<=0).
// Solma alpha ile değil KÜÇÜLME ile yapılır (paketli renk int'inden alpha
// bileşenini çıkarmak için helper yok — küçülme aynı hissi bedavaya verir).

array _pt_x = [];    // konum
array _pt_y = [];
array _pt_vx = [];   // hız (px/sn)
array _pt_vy = [];
array _pt_life = []; // kalan ömür (sn); <= 0 → slot ölü, yeniden kullanılabilir
array _pt_max = [];  // başlangıç ömrü (küçülme oranı için)
array _pt_col = [];  // renk (paketli int)
array _pt_size = []; // yarıçap (px)
int _pt_n = 0;

// n adet parçacık saç: rastgele yön, hafif yukarı eğilim, yerçekimiyle düşer.
func _pt_spawn(x, y, col, n) {
    _fx_last_x = x * 1.0; _fx_last_y = y * 1.0; _fx_last_t = 0.12;  // popup çıpası
    for (int j = 0; j < n; j = j + 1) {
        float ang = random() * 6.2831853;
        float spd = 60.0 + random() * 180.0;
        float pvx = cos(ang) * spd;
        float pvy = sin(ang) * spd - 40.0;
        float plife = 0.35 + random() * 0.4;
        float psize = 2.0 + random() * 3.0;
        // Önce ölü slot ara (parçacık sayısı küçük — lineer tarama yeterli).
        int slot = 0 - 1;
        for (int i = 0; i < _pt_n; i = i + 1) {
            if (slot < 0 && _pt_life[i] <= 0.0) { slot = i; }
        }
        if (slot >= 0) {
            _pt_x[slot] = x * 1.0;  _pt_y[slot] = y * 1.0;
            _pt_vx[slot] = pvx;     _pt_vy[slot] = pvy;
            _pt_life[slot] = plife; _pt_max[slot] = plife;
            _pt_col[slot] = col;    _pt_size[slot] = psize;
        } else {
            push(_pt_x, x * 1.0);  push(_pt_y, y * 1.0);
            push(_pt_vx, pvx);     push(_pt_vy, pvy);
            push(_pt_life, plife); push(_pt_max, plife);
            push(_pt_col, col);    push(_pt_size, psize);
            _pt_n = _pt_n + 1;
        }
    }
}

func _pt_update(dt) {
    for (int i = 0; i < _pt_n; i = i + 1) {
        if (_pt_life[i] <= 0.0) { continue; }
        _pt_life[i] = _pt_life[i] - dt;
        _pt_x[i] = _pt_x[i] + _pt_vx[i] * dt;
        _pt_y[i] = _pt_y[i] + _pt_vy[i] * dt;
        _pt_vy[i] = _pt_vy[i] + 420.0 * dt;   // yerçekimi — kıvılcım hissi
    }
}

// Parçacıkları çiz (ox/oy = sarsıntı ofseti). Ömür bitene doğru küçülür.
func _pt_draw(ox, oy) {
    for (int i = 0; i < _pt_n; i = i + 1) {
        if (_pt_life[i] <= 0.0) { continue; }
        float k = _pt_life[i] / _pt_max[i];
        if (k > 1.0) { k = 1.0; }
        float r = _pt_size[i] * k;
        if (r >= 1.0) {
            circle(toInt(_pt_x[i] + ox), toInt(_pt_y[i] + oy), toInt(r), _pt_col[i]);
        }
    }
}

func _pt_clear() {
    _pt_x = []; _pt_y = []; _pt_vx = []; _pt_vy = [];
    _pt_life = []; _pt_max = []; _pt_col = []; _pt_size = [];
    _pt_n = 0;
}

// ---- Uçan "+N" skor baloncukları + combo/seri (saf görsel, skoru DEĞİŞTİRMEZ)
// Combo yalnız görseldir: seri sayacı skor matematiğini bozmaz → rekorlar adil
// kalır. "+N" baloncuğu son patlama konumunda (çarpışma yeri) belirir.
// (Global durum yukarıda erken tanımlı — score_add/_pt_spawn onlardan önce gelir.)

func _pop_spawn(x, y, txt, kind) {
    int slot = 0 - 1;
    for (int i = 0; i < _pop_n; i = i + 1) { if (slot < 0 && _pop_t[i] <= 0.0) { slot = i; } }
    if (slot >= 0) {
        _pop_x[slot] = x * 1.0; _pop_y[slot] = y * 1.0;
        _pop_t[slot] = 0.9; _pop_txt[slot] = txt; _pop_kind[slot] = kind;
    } else {
        push(_pop_x, x * 1.0); push(_pop_y, y * 1.0);
        push(_pop_t, 0.9); push(_pop_txt, txt); push(_pop_kind, kind);
        _pop_n = _pop_n + 1;
    }
}

func _pop_update(dt) {
    for (int i = 0; i < _pop_n; i = i + 1) {
        if (_pop_t[i] <= 0.0) { continue; }
        _pop_t[i] = _pop_t[i] - dt;
        _pop_y[i] = _pop_y[i] - 46.0 * dt;    // yukarı süzül
    }
}

func _pop_draw(ox, oy) {
    for (int i = 0; i < _pop_n; i = i + 1) {
        if (_pop_t[i] <= 0.0) { continue; }
        float k = _pop_t[i] / 0.9; if (k > 1.0) { k = 1.0; }
        int a = toInt(k * 255.0); if (a < 0) { a = 0; } if (a > 255) { a = 255; }
        int col = rgba(255, 215, 0, a);        // altın "+N"
        int sz = 20;
        if (_pop_kind[i] == 1) { col = rgba(255, 170, 60, a); sz = 24; }   // combo
        str t = _pop_txt[i];
        text(t, toInt(_pop_x[i] + ox - measure_text(t, sz) / 2.0),
             toInt(_pop_y[i] + oy), sz, col);
    }
}

func _pop_clear() {
    _pop_x = []; _pop_y = []; _pop_t = []; _pop_txt = []; _pop_kind = [];
    _pop_n = 0;
    _combo = 0; _combo_t = 0.0;
    _fx_last_t = 0.0;
}

// ---- Menü ↔ oyun geçiş fade'i (kısa siyah örtü) -----------------------------
// (_trans_t yukarıda erken tanımlı.)
func _trans_start() { _trans_t = 0.30; }
func _trans_draw() {
    if (_trans_t <= 0.0) { return; }
    float dt = frame_time();
    if (dt <= 0.0) { dt = 0.0166667; }
    if (dt > 0.05) { dt = 0.05; }
    _trans_t = _trans_t - dt;
    float k = _trans_t / 0.30; if (k < 0.0) { k = 0.0; } if (k > 1.0) { k = 1.0; }
    int a = toInt(k * 255.0);
    float vl = tm_view_left(); float vt = tm_view_top();
    float vr = tm_view_right(); float vb = tm_view_bottom();
    rect(vl, vt, vr - vl, vb - vt, rgba(10, 12, 18, a));
}

// ---- Herkese açık parçacık API'si -------------------------------------------
func explode(x, y, col)       { _pt_spawn(x, y, col, 16); }
func patlama(x, y, col)       { explode(x, y, col); }
func explode_n(x, y, col, n)  { _pt_spawn(x, y, col, n); }
func patlama_n(x, y, col, n)  { _pt_spawn(x, y, col, n); }

// ---- Ekran sarsıntısı + flash ----------------------------------------------
float _fx_sh_t = 0.0;     // kalan sarsıntı süresi (sn)
float _fx_sh_dur = 0.0;
float _fx_sh_mag = 7.0;   // azami ofset (px) — süre bittikçe söner
float _fx_ox = 0.0;       // BU karenin çizim ofseti (entity + parçacık kayar)
float _fx_oy = 0.0;
float _fx_fl_t = 0.0;     // kalan flash süresi (sn)
float _fx_fl_dur = 0.0;

// Kısa ekran sarsıntısı (~0.28 sn). Çarpışma/patlama anında çağır.
func shake() { _fx_sh_t = 0.28; _fx_sh_dur = 0.28; _fx_sh_mag = 7.0; }
func sars()  { shake(); }

// Beyaz tam-ekran flash (~0.16 sn) — hasar/ölüm vurgusu.
func flash() { _fx_fl_t = 0.16; _fx_fl_dur = 0.16; }
func parla() { flash(); }

// ciz_ustune ile kendi sahnesini çizen oyunlar (ör. yılan) sarsıntıyı
// paylaşabilsin diye bu karenin ofseti dışa açık.
func shake_x(): float { return _fx_ox; }
func shake_y(): float { return _fx_oy; }
func sars_x(): float  { return _fx_ox; }
func sars_y(): float  { return _fx_oy; }

// Kare başı efekt güncellemesi (motor içi) — oyun bittiğinde de çalışır ki
// son patlama/sarsıntı ekranda donmasın.
func _fx_update(dt) {
    _pt_update(dt);
    _pop_update(dt);
    // Seri penceresi + son-patlama çıpası zamanlayıcıları.
    if (_combo_t > 0.0) { _combo_t = _combo_t - dt; if (_combo_t <= 0.0) { _combo_t = 0.0; _combo = 0; } }
    if (_fx_last_t > 0.0) { _fx_last_t = _fx_last_t - dt; if (_fx_last_t < 0.0) { _fx_last_t = 0.0; } }
    _fx_ox = 0.0; _fx_oy = 0.0;
    if (_fx_sh_t > 0.0) {
        _fx_sh_t = _fx_sh_t - dt;
        if (_fx_sh_t < 0.0) { _fx_sh_t = 0.0; }
        float k = 0.0;
        if (_fx_sh_dur > 0.0) { k = _fx_sh_t / _fx_sh_dur; }
        float m = _fx_sh_mag * k;
        _fx_ox = (random() * 2.0 - 1.0) * m;
        _fx_oy = (random() * 2.0 - 1.0) * m;
    }
    if (_fx_fl_t > 0.0) {
        _fx_fl_t = _fx_fl_t - dt;
        if (_fx_fl_t < 0.0) { _fx_fl_t = 0.0; }
    }
    if (_badge_toast_t > 0.0) {           // rozet "toast"ı (oyun-bitti'de bile azalır)
        _badge_toast_t = _badge_toast_t - dt;
        if (_badge_toast_t < 0.0) { _badge_toast_t = 0.0; }
    }
}

func _fx_reset() {
    _pt_clear();
    _pop_clear();
    _fx_sh_t = 0.0; _fx_fl_t = 0.0;
    _fx_ox = 0.0; _fx_oy = 0.0;
}

// ============================================================================
//  EN İYİ SKOR — kalıcı rekor (save_data/load_data → masaüstünde CWD,
//  Android'de internalDataPath; oyun kodu hiçbir şey yapmaz, motor halleder)
// ============================================================================
str  _ar_title = "";      // kayıt anahtarı: sahne başlığı / launcher'da oyun adı
int  _best = 0;           // bu oyunun kalıcı en iyi skoru
bool _new_record = false; // bu elde rekor kırıldı (bitiş ekranında rozet)

// ---- Yıldız (ilerleme) — BÖLÜM BAŞINA ---------------------------------------
// Bölümlü oyun: HER BÖLÜM kendi yıldızını kazanır (bölümü geçince). Kalıcı,
// bölüm başına: arcade_lvl_<ad>_<k>.txt = "1". Menü kartında tamamlanan/tüm
// bölüm; bölüm-seçim ekranında her bölümün yıldızı. Sonsuz oyun (bölüm yok):
// yildiz_hedef(a,b,c) skor eşiklerinden 0..3 yıldız (_stars, arcade_star_<ad>).
int  _stars   = 0;        // sonsuz oyun: kalıcı yıldız derecesi (0..3)
int  _star_g1 = 0;        // sonsuz oyun skor eşikleri (0 = tanımsız)
int  _star_g2 = 0;
int  _star_g3 = 0;
array _lvl_done = [];     // yüklü oyunun bölüm-tamamlama durumu (1-tabanlı → [k-1])

func _ar_best_key(): str { return "arcade_best_" + _ar_title + ".txt"; }
func _ar_star_key(): str { return "arcade_star_" + _ar_title + ".txt"; }
func _ar_lvl_key(name, k): str { return "arcade_lvl_" + name + "_" + toString(k) + ".txt"; }

func _ar_load_best() {
    _best = 0;
    _stars = 0;
    if (_ar_title == "") { return; }
    str s = load_data(_ar_best_key());
    if (s != "") { _best = toInt(s); }
    str ss = load_data(_ar_star_key());
    if (ss != "") { _stars = toInt(ss); }
}

// Bir oyunun tamamlanan bölüm sayısı (kalıcı dosyalardan).
func _count_done_levels(name, n): int {
    int c = 0; int k = 1;
    while (k <= n) {
        str s = load_data(_ar_lvl_key(name, k));
        if (s == "1") { c = c + 1; }
        k = k + 1;
    }
    return c;
}

// Yüklü oyunun bölüm-tamamlama dizisini diskten doldur (bölüm-seçim ekranı için).
func _lx_load_lvl_done(name, n) {
    _lvl_done = [];
    int k = 1;
    while (k <= n) {
        str s = load_data(_ar_lvl_key(name, k));
        if (s == "1") { push(_lvl_done, 1); } else { push(_lvl_done, 0); }
        k = k + 1;
    }
}

// Bir bölümü TAMAMLANDI işaretle (kalıcı). Yeni ise kartı + rozetleri tazeler.
func _ar_mark_level(k) {
    if (_ar_title == "" || k < 1) { return; }
    if (k <= length(_lvl_done)) { if (_lvl_done[k - 1] == 1) { return; } }   // zaten
    save_data(_ar_lvl_key(_ar_title, k), "1");
    if (k <= length(_lvl_done)) { _lvl_done[k - 1] = 1; }
    if (_ar_mode == 1 && _menu_sel >= 0 && _menu_sel < _apps_n) {
        _apps_done[_menu_sel] = _count_done_levels(_ar_title, _level_n);
    }
    _ar_badge_check();
}

// Toplam yıldız = bölümlü oyunların tamamlanan bölümleri + sonsuz oyun yıldızları.
func _total_stars(): int {
    int t = 0; int i = 0;
    while (i < _apps_n) {
        if (_apps_levn[i] > 0) { t = t + _apps_done[i]; }
        else { t = t + _apps_star[i]; }
        i = i + 1;
    }
    return t;
}

// Sonsuz oyun: yıldızı k'ya YÜKSELT (asla düşürme), kalıcı yaz + rozet tazele.
func _ar_grant_stars(k) {
    if (_ar_title == "") { return; }
    if (k <= _stars) { return; }
    _stars = k;
    save_data(_ar_star_key(), toString(_stars));
    if (_ar_mode == 1 && _menu_sel >= 0 && _menu_sel < _apps_n) {
        _apps_star[_menu_sel] = _stars;
    }
    _ar_badge_check();
}

// Sonsuz oyunlar için skor eşikleri (kazanılan yıldız = geçilen eşik sayısı).
func star_goals(a, b, c) { _star_g1 = a; _star_g2 = b; _star_g3 = c; }
func yildiz_hedef(a, b, c) { star_goals(a, b, c); }
func stars(): int  { return _stars; }
func yildiz(): int { return _stars; }

// ---- Rozetler (başarımlar) --------------------------------------------------
// 5 kalıcı rozet (her biri arcade_badge_<i>.txt = "1"). Oyun-içi olaylar açar;
// yeni açılınca kısa "toast" + ses. Menüdeki kupa düğmesinden liste görünür.
array _badge_on = [];      // 0/1 durum (lazy yüklenir)
bool  _badges_loaded = false;
str   _badge_toast_txt = "";
float _badge_toast_t = 0.0;

func _ar_badges_load() {
    if (_badges_loaded) { return; }
    _badges_loaded = true;
    _badge_on = [0, 0, 0, 0, 0];
    int i = 0;
    while (i < 5) {
        str s = load_data("arcade_badge_" + toString(i) + ".txt");
        if (s == "1") { _badge_on[i] = 1; }
        i = i + 1;
    }
}
func _badge_has(idx): bool {
    _ar_badges_load();
    return _badge_on[idx] == 1;
}
// Bir rozeti kazanılmış işaretle (idempotent). Yeni ise toast + ses tetikler.
func _ar_badge_set(idx) {
    _ar_badges_load();
    if (_badge_on[idx] == 1) { return; }
    _badge_on[idx] = 1;
    save_data("arcade_badge_" + toString(idx) + ".txt", "1");
    _badge_toast_txt = _badge_name(idx);
    _badge_toast_t = 2.2;
    _snd(880.0, 70);
    _snd(1174.0, 90);
}
// Türetilmiş rozetleri (mevcut duruma göre) değerlendir — yıldız kazanınca çağrılır.
func _ar_badge_check() {
    int total = _total_stars();
    if (total >= 3)  { _ar_badge_set(2); }
    if (total >= 15) { _ar_badge_set(3); }
    if (total >= 30) { _ar_badge_set(4); }
}
func _badge_name(idx): str {
    str L = _lang_now();
    if (idx == 0) { if (L == "en") { return "First Win"; } return "Ilk Zafer"; }
    if (idx == 1) { if (L == "en") { return "Record Breaker"; } return "Rekortmen"; }
    if (idx == 2) { if (L == "en") { return "Three Stars"; } return "Uc Yildiz"; }
    if (idx == 3) { if (L == "en") { return "Collector"; } return "Koleksiyoncu"; }
    if (L == "en") { return "Master"; }
    return "Usta";
}
func _badge_desc(idx): str {
    str L = _lang_now();
    if (idx == 0) { if (L == "en") { return "Win any game"; } return "Bir oyunu kazan"; }
    if (idx == 1) { if (L == "en") { return "Break a record"; } return "Bir rekor kir"; }
    if (idx == 2) { if (L == "en") { return "3 total stars"; } return "Toplam 3 yildiz"; }
    if (idx == 3) { if (L == "en") { return "15 total stars"; } return "Toplam 15 yildiz"; }
    if (L == "en") { return "30 total stars"; }
    return "Toplam 30 yildiz";
}

// Oyun bittiğinde/kazanıldığında çağrılır: rekorsa kaydet + rozeti işaretle.
func _ar_check_record() {
    if (_ar_title == "") { return; }
    if (_score > _best) {
        _best = _score;
        _new_record = true;
        save_data(_ar_best_key(), toString(_best));
        _snd(1318.0, 130);    // yeni rekor "ping" (E6)
        _hap(120);
        _ar_badge_set(1);     // "Rekortmen" rozeti
    }
    // Sonsuz oyunlarda (bölüm yok) yıldız = en iyi skorun geçtiği eşik sayısı.
    if (_star_g1 > 0) {
        int k = 0;
        if (_best >= _star_g1) { k = 1; }
        if (_star_g2 > 0 && _best >= _star_g2) { k = 2; }
        if (_star_g3 > 0 && _best >= _star_g3) { k = 3; }
        if (k > 0) { _ar_grant_stars(k); }
    }
}

func best_score(): int { return _best; }
func en_iyi_skor(): int { return _best; }

// ---- Global skor tablosu (opsiyonel) ---------------------------------------
// Bir Tulpar Wings sunucusunun kök URL'sini ver (ör. "http://10.0.2.2:3000").
// "" (varsayılan) → tamamen kapalı, hiçbir ağ çağrısı yapılmaz.
func leaderboard_url(u)   { _lb_url = u; }
func skor_tablosu_url(u)  { _lb_url = u; }
func player_name(n)       { _lb_name = n; }
func oyuncu_adi(n)        { _lb_name = n; }

// Oyun bitişinde: skoru GÖNDER + o oyunun top-10'unu ÇEK. Senkron HTTP —
// oyun-bitti ekranında (fizik durmuşken) tek sefer, bir kareyi bloklar.
// Sunucu yoksa/erişilemezse sessizce atlar (tablo çizilmez).
func _lb_submit_fetch() {
    _lb_has = false;
    _lb_data = [];
    if (_lb_url == "") { return; }
    if (_ar_title == "") { return; }
    json body = {"oyun": _ar_title, "isim": _lb_name, "skor": _score};
    http_request("POST", _lb_url + "/skor", toJson(body));
    json r = http_request("POST", _lb_url + "/tablo", toJson({"oyun": _ar_title}));
    if (toInt(r["ok"]) == 1) {
        json parsed = fromJson(r["body"]);
        _lb_data = parsed["tablo"];
        _lb_has = true;
    }
}

// ============================================================================
//  MOTOR İÇİ — kare güncelleme
// ============================================================================

// ---- Dokunmatik: kontrol yerleşimi ------------------------------------------
// Konumlar GERÇEK ekran kenarlarına demirlenir (tm_view_* — Android'de sahne
// ortalanır, kenarlar dünyadan taşar; masaüstü/web'de view = dünya, eski
// davranışla birebir aynı). Boyutlar _world_h'ye göre (sahne ölçeğiyle uyumlu).
func _ar_dpad_cx(): float { return tm_view_left() + _world_h * 0.28; }
func _ar_dpad_cy(): float { return tm_view_bottom() - _world_h * 0.30; }
func _ar_dpad_r(): float  { return _world_h * 0.17; }
func _ar_act_cx(): float  { return tm_view_right() - _world_h * 0.24; }
func _ar_act_cy(): float  { return tm_view_bottom() - _world_h * 0.28; }
func _ar_act_r(): float   { return _world_h * 0.15; }

// Her kare bir kez: parmakları oku → analog joystick + aksiyon-edge + tap-edge.
func _ar_read_touch() {
    _ar_td_left = false; _ar_td_right = false;
    _ar_td_up = false; _ar_td_down = false;
    _ar_joy_dx = 0.0; _ar_joy_dy = 0.0;
    _ar_act_now = false;
    int n = touch_count();
    if (n > 0) { _ar_touch_ui = true; } // ilk dokunuşta overlay'i kalıcı aç
    float acx = _ar_act_cx(); float acy = _ar_act_cy(); float ar = _ar_act_r();
    float baseR = _ar_dpad_r();          // topuzun taban içindeki azami yürüyüşü
    // Gerçek ekran kenarları (dünya koordinatında) — butonlar buraya demirli.
    float vl = tm_view_left();
    float vb = tm_view_bottom();
    // Joystick AKTİVASYON ALANI: SABİT tabanın (_ar_dpad_cx/cy, sol-alt) etrafında
    // KÜÇÜK bir daire. Yalnız joystick'in üstüne/yakınına dokununca devreye girer —
    // ekranın ortasına ya da doğal konumu dışında bir yere basmak joystick OLUŞTURMAZ.
    // (Eskiden tüm sol-alt çeyrekti; merkeze yakın basınca da açılıyordu → düzeltildi.)
    float jcx = _ar_dpad_cx();
    float jcy = _ar_dpad_cy();
    float jgr = baseR * 1.6;             // dokunması kolay olsun diye ring + biraz pay
    float jgr2 = jgr * jgr;

    // Etkin şema + hareket kontrolü açık mı (elle seçim reads'i beklemez).
    int sc = _ar_scheme_now();
    bool mv_on = sc != 5 && (_ar_wants_move || _ar_scheme > 0);

    // Eğim (tilt) şeması: ivmeölçerden yön türet (dokunma parmağı gerekmez).
    // Yön NÖTR tutuştan SAPMAYLA ölçülür (yukarıdaki kalibrasyon notu) → cihaz
    // yönelimi fark etmez. Sağ/sol = accel_y sapması, yukarı/aşağı = accel_x
    // sapması. Sensör yoksa (masaüstü) sessiz geçilir → klavye zaten çalışır.
    if (sc == 6 && tm_accel_available()) {
        float axv = tm_accel_x();
        float ayv = tm_accel_y();
        if (!_ar_tilt_cal) {
            _ar_tilt_ax0 = axv; _ar_tilt_ay0 = ayv; _ar_tilt_cal = true;
        }
        float dx = axv - _ar_tilt_ax0;
        float dy = ayv - _ar_tilt_ay0;
        if (dy < 0.0 - _ar_tilt_thr) { _ar_td_left = true; }
        if (dy > _ar_tilt_thr)       { _ar_td_right = true; }
        if (dx > _ar_tilt_thr)       { _ar_td_up = true; }
        if (dx < 0.0 - _ar_tilt_thr) { _ar_td_down = true; }
    }

    // Yön BUTONU merkezleri (dpad/yatay/dikey şemaları) — sol-alt köşe.
    float bR  = _ar_btn_r();
    float bgr = bR * 1.35;               // buton yakalama payı
    float blx = 0.0; float bly = 0.0;    // sol ◀
    float brx = 0.0; float bry = 0.0;    // sağ ▶
    float bux = 0.0; float buy = 0.0;    // yukarı ▲
    float bdx = 0.0; float bdy = 0.0;    // aşağı ▼
    bool has_lr = false;
    bool has_ud = false;
    if (sc == 3) {                       // yatay: ◀ ▶ yan yana
        blx = vl + bR * 1.5;  bly = vb - bR * 1.5;
        brx = blx + bR * 2.6;  bry = bly;
        has_lr = true;
    } else if (sc == 4) {                // dikey: ▲ üstte, ▼ altta
        bdx = vl + bR * 1.5;  bdy = vb - bR * 1.5;
        bux = bdx;  buy = bdy - bR * 2.6;
        has_ud = true;
    } else if (sc == 2) {                // dpad: 4 buton artı-düzeni
        float dpcx = vl + bR * 2.8;  float dpcy = vb - bR * 2.8;
        float dpoff = bR * 1.75;
        blx = dpcx - dpoff;  bly = dpcy;
        brx = dpcx + dpoff;  bry = dpcy;
        bux = dpcx;  buy = dpcy - dpoff;
        bdx = dpcx;  bdy = dpcy + dpoff;
        has_lr = true;  has_ud = true;
    }

    // Parmakları sınıflandır: aksiyon butonu / joystick adayı / yön butonları.
    int joy_i = 0 - 1;
    float best = 0.0;
    bool have_best = false;
    int i = 0;
    while (i < n) {
        float tx = touch_x(i) * 1.0;
        float ty = touch_y(i) * 1.0;
        float adx = tx - acx; float ady = ty - acy;
        if (_ar_wants_action && adx * adx + ady * ady <= ar * ar) {
            _ar_act_now = true;
        } else if (mv_on && sc == 1
                   && (tx - jcx) * (tx - jcx) + (ty - jcy) * (ty - jcy) <= jgr2) {
            float d2 = 0.0;
            if (_ar_joy_on) {
                float bx = tx - _ar_joy_bx; float by = ty - _ar_joy_by;
                d2 = bx * bx + by * by;
            }
            if (!have_best || d2 < best) { best = d2; joy_i = i; have_best = true; }
        } else if (mv_on) {
            // Yön butonları: dokunulan butonun yönünü bu kare işaretle.
            if (has_lr) {
                float lx = tx - blx; float ly = ty - bly;
                if (lx * lx + ly * ly <= bgr * bgr) { _ar_td_left = true; }
                float rx2 = tx - brx; float ry2 = ty - bry;
                if (rx2 * rx2 + ry2 * ry2 <= bgr * bgr) { _ar_td_right = true; }
            }
            if (has_ud) {
                float ux = tx - bux; float uy = ty - buy;
                if (ux * ux + uy * uy <= bgr * bgr) { _ar_td_up = true; }
                float dx2 = tx - bdx; float dy2 = ty - bdy;
                if (dx2 * dx2 + dy2 * dy2 <= bgr * bgr) { _ar_td_down = true; }
            }
        }
        i = i + 1;
    }

    if (joy_i >= 0) {
        float tx = touch_x(joy_i) * 1.0;
        float ty = touch_y(joy_i) * 1.0;
        // Taban tamamen SABİT: sol-alt köşede demirli (parmakla GEZMEZ, parmağın
        // altında DOĞMAZ). Böylece oyuncu karakteri sürerken eli ekranın ortasına
        // kaymaz → görüşü kapanmaz. Yön, sabit merkezden parmağın sapmasıyla okunur.
        _ar_joy_bx = _ar_dpad_cx();
        _ar_joy_by = _ar_dpad_cy();
        _ar_joy_on = true;
        float ox = tx - _ar_joy_bx; float oy = ty - _ar_joy_by;
        float mag = sqrt(ox * ox + oy * oy);
        if (mag > baseR) {               // topuz halkanın dışına çıkamaz
            float k = baseR / mag;
            ox = ox * k; oy = oy * k;
            mag = baseR;
        }
        _ar_joy_kx = _ar_joy_bx + ox;
        _ar_joy_ky = _ar_joy_by + oy;
        _ar_joy_dx = ox / baseR;         // analog yön [-1..1]
        _ar_joy_dy = oy / baseR;
        float dz = 0.16;                 // ölü bölge — küçük; parmak eşiğini erken aşsın (daha tepkisel)
        if (_ar_joy_dx < 0.0 - dz) { _ar_td_left = true; }
        if (_ar_joy_dx > dz)       { _ar_td_right = true; }
        if (_ar_joy_dy < 0.0 - dz) { _ar_td_up = true; }
        if (_ar_joy_dy > dz)       { _ar_td_down = true; }
    } else {
        _ar_joy_on = false;              // parmak çekildi → nötr
    }

    _ar_act_edge = _ar_act_now && !_ar_act_prev;
    _ar_act_prev = _ar_act_now;

    // Swipe izleme (parmak 0): inişte başlangıç, sürerken son konum, kalkışta
    // vektör sınıflandırması. Eşik: dünya yüksekliğinin %10'u.
    _ar_swipe = 0;
    if (n > 0) {
        if (_ar_touch_prevn == 0) {
            _ar_sw_x0 = touch_x(0) * 1.0; _ar_sw_y0 = touch_y(0) * 1.0;
        }
        _ar_sw_x1 = touch_x(0) * 1.0; _ar_sw_y1 = touch_y(0) * 1.0;
    } else if (_ar_touch_prevn > 0) {
        float swdx = _ar_sw_x1 - _ar_sw_x0;
        float swdy = _ar_sw_y1 - _ar_sw_y0;
        float swax = swdx; if (swax < 0.0) { swax = 0.0 - swax; }
        float sway = swdy; if (sway < 0.0) { sway = 0.0 - sway; }
        float swthr = _world_h * 0.10;
        if (swax > sway && swax >= swthr) {
            if (swdx < 0.0) { _ar_swipe = 1; } else { _ar_swipe = 2; }
        } else if (sway > swax && sway >= swthr) {
            if (swdy < 0.0) { _ar_swipe = 3; } else { _ar_swipe = 4; }
        }
    }

    _ar_tap_edge = (n > 0) && (_ar_touch_prevn == 0);
    _ar_touch_prevn = n;
}

// Klavye + dokunma birleşik girdi — movement presetleri bunları kullanır.
// İlk çağrı `_ar_wants_move`'u işaretler → joystick yalnız yön okuyan oyunlarda çizilir.
func _ar_in_left(): bool  { _ar_wants_move = true; _ar_rd_l = true; return key_down("LEFT")  || key_down("A") || _ar_td_left; }
func _ar_in_right(): bool { _ar_wants_move = true; _ar_rd_r = true; return key_down("RIGHT") || key_down("D") || _ar_td_right; }
func _ar_in_up(): bool    { _ar_wants_move = true; _ar_rd_u = true; return key_down("UP")    || key_down("W") || _ar_td_up; }
func _ar_in_down(): bool  { _ar_wants_move = true; _ar_rd_d = true; return key_down("DOWN")  || key_down("S") || _ar_td_down; }

// Etkin şema çözümü: elle seçildiyse o; auto ise oyunun okuduğu yönlerden.
func _ar_scheme_now(): int {
    if (_ar_scheme != 0) { return _ar_scheme; }
    bool lr = _ar_rd_l || _ar_rd_r;
    bool ud = _ar_rd_u || _ar_rd_d;
    if (lr && ud)  { return 1; }   // iki eksen → joystick
    if (lr)        { return 3; }   // yalnız sağ/sol → yatay butonlar
    if (ud)        { return 4; }   // yalnız yukarı/aşağı → dikey butonlar
    return 5;                      // yön okunmuyor → hareket kontrolü yok
}

// Dokunmatik kontrol şemasını elle seç (TR+EN dize):
//   "auto"/"oto" (varsayılan) | "joystick" | "dpad"/"yon4" | "yatay"/"horizontal"
//   | "dikey"/"vertical" | "yok"/"none"
func kontrol_semasi(s) {
    if (s == "joystick")                        { _ar_scheme = 1; }
    else if (s == "dpad" || s == "yon4")        { _ar_scheme = 2; }
    else if (s == "yatay" || s == "horizontal") { _ar_scheme = 3; }
    else if (s == "dikey" || s == "vertical")   { _ar_scheme = 4; }
    else if (s == "yok" || s == "none")         { _ar_scheme = 5; }
    else if (s == "egim" || s == "tilt")        { _ar_scheme = 6; }
    else                                        { _ar_scheme = 0; }
}
func control_scheme(s) { kontrol_semasi(s); }

// Yön butonu yarıçapı (dpad/yatay/dikey şemaları)
func _ar_btn_r(): float { return _world_h * 0.105; }

// ---- Herkese açık yön okuma (klavye VEYA joystick) --------------------------
// Elle hareket süren oyunlar (raket/gemi/kuş...) `key_down("LEFT")` yerine
// bunları kullanırsa dokunmatik joystick de çalışır — ve joystick yalnız bu
// okumaları yapan oyunlarda görünür. TR + EN alias.
func left(): bool   { return _ar_in_left(); }
func sol(): bool    { return _ar_in_left(); }
func right(): bool  { return _ar_in_right(); }
func sag(): bool    { return _ar_in_right(); }
func up(): bool     { return _ar_in_up(); }
func yukari(): bool { return _ar_in_up(); }
func down(): bool   { return _ar_in_down(); }
func asagi(): bool  { return _ar_in_down(); }
// Zıplama: klavye edge VEYA aksiyon butonu edge.
func _ar_in_jump(): bool  { _ar_wants_action = true; return key_pressed("SPACE") || key_pressed("UP") || key_pressed("W") || _ar_act_edge; }

// ---- Herkese açık: aksiyon butonu (ateş/etkileşim; nişancı oyunları için) ----
// Oyun kodunda `key_pressed("SPACE")` yerine `action_pressed()` kullanılırsa
// hem klavye hem dokunma çalışır. action_held(): basılı tutuluyor mu.
func action_pressed(): bool { _ar_wants_action = true; return _ar_act_edge; }
func aksiyon_basildi(): bool { _ar_wants_action = true; return _ar_act_edge; }
func action_held(): bool    { _ar_wants_action = true; return _ar_act_now; }
func aksiyon_basili(): bool  { _ar_wants_action = true; return _ar_act_now; }

// Ateş/zıpla için birleşik edge: SPACE/UP klavye VEYA aksiyon butonu. Nişancı
// oyunları `key_pressed("SPACE")` yerine bunu kullanırsa dokunmatikte de ateş eder.
func fire_pressed(): bool  { _ar_wants_action = true; return key_pressed("SPACE") || key_pressed("UP") || _ar_act_edge; }
func ates_basildi(): bool  { return fire_pressed(); }

// Ekranın HERHANGİ bir yerine bu kare yeni dokunuldu mu (parmak 0 → >0 kenarı).
// Sadece-dokunma oyunları (flappy tarzı) bunu okur: buton/joystick GEREKMEZ,
// hiçbir kontrol çizilmez — "ekrana tıkla" oyunun kendisidir.
func dokunuldu(): bool { return _ar_tap_edge; }
func tapped(): bool    { return _ar_tap_edge; }

// Kaydırma jesti: parmak KALKTIĞI kare yönü bildirir. Yön adı TR ya da EN:
// "sol"/"left", "sag"/"right", "yukari"/"up", "asagi"/"down". Yılan tarzı
// oyunlar buton/joystick çizdirmeden jestle oynanır.
func kaydirildi(yon): bool {
    if (_ar_swipe == 1) { return yon == "sol" || yon == "left"; }
    if (_ar_swipe == 2) { return yon == "sag" || yon == "right"; }
    if (_ar_swipe == 3) { return yon == "yukari" || yon == "up"; }
    if (_ar_swipe == 4) { return yon == "asagi" || yon == "down"; }
    return false;
}
func swiped(dir): bool { return kaydirildi(dir); }

// Dokunmatik overlay'i zorla aç/kapat (varsayılan: ilk dokunuşta otomatik).
func touch_controls(on)   { _ar_touch_force = on; _ar_touch_ui = on; }
func dokunma_kontrol(on)  { touch_controls(on); }

// Dokunmatik overlay: DİNAMİK analog joystick (yuvarlak içinde yuvarlak) + —
// sadece oyun kullanıyorsa— sağ alt aksiyon butonu. Boşta joystick hayalet gibi
// varsayılan konumda soluk durur; parmak basınca tabanı orada belirir ve topuz
// parmağı takip eder. Yarı-saydam (rgba) — oyunu kapatmaz.
func _ar_draw_touch_ui() {
    float baseR = _ar_dpad_r();
    float knobR = baseR * 0.5;
    int hot = rgba(255, 255, 255, 225);
    int dim = rgba(255, 255, 255, 90);

    // Hareket kontrolü — etkin şemaya göre joystick YA DA yön butonları.
    int sc = _ar_scheme_now();
    bool mv_on = sc != 5 && (_ar_wants_move || _ar_scheme > 0);
    if (mv_on && sc == 1) {
        float bx = _ar_dpad_cx(); float by = _ar_dpad_cy();  // boşta hayalet konumu
        float kx = bx; float ky = by;
        if (_ar_joy_on) { bx = _ar_joy_bx; by = _ar_joy_by; kx = _ar_joy_kx; ky = _ar_joy_ky; }

        // dış halka (taban) + iç topuz
        circle(toInt(bx), toInt(by), toInt(baseR),
               _ar_joy_on ? rgba(210, 220, 255, 70) : rgba(210, 214, 230, 40));
        circle(toInt(kx), toInt(ky), toInt(knobR), _ar_joy_on ? hot : dim);
    } else if (mv_on && sc != 1) {
        // Yön butonları — merkezler _ar_read_touch ile AYNI formüller
        // (gerçek ekran kenarına demirli).
        float bR = _ar_btn_r();
        float vl = tm_view_left();
        float vb = tm_view_bottom();
        float ta = bR * 0.5;    // ok ucu uzaklığı
        float tb = bR * 0.3;    // ok tabanı yarısı
        int cOff = rgba(210, 214, 230, 45);
        int cOn  = rgba(210, 220, 255, 120);
        if (sc == 3 || sc == 2) {
            float blx = 0.0; float bly = 0.0; float brx = 0.0; float bry = 0.0;
            if (sc == 3) {
                blx = vl + bR * 1.5;  bly = vb - bR * 1.5;
                brx = blx + bR * 2.6;  bry = bly;
            } else {
                blx = vl + bR * 2.8 - bR * 1.75;  bly = vb - bR * 2.8;
                brx = vl + bR * 2.8 + bR * 1.75;  bry = bly;
            }
            circle(toInt(blx), toInt(bly), toInt(bR), _ar_td_left ? cOn : cOff);
            triangle(blx - ta, bly, blx + tb, bly - tb, blx + tb, bly + tb,
                     _ar_td_left ? hot : dim);
            circle(toInt(brx), toInt(bry), toInt(bR), _ar_td_right ? cOn : cOff);
            triangle(brx + ta, bry, brx - tb, bry - tb, brx - tb, bry + tb,
                     _ar_td_right ? hot : dim);
        }
        if (sc == 4 || sc == 2) {
            float bux = 0.0; float buy = 0.0; float bdx = 0.0; float bdy = 0.0;
            if (sc == 4) {
                bdx = vl + bR * 1.5;  bdy = vb - bR * 1.5;
                bux = bdx;  buy = bdy - bR * 2.6;
            } else {
                bux = vl + bR * 2.8;  buy = vb - bR * 2.8 - bR * 1.75;
                bdx = vl + bR * 2.8;  bdy = vb - bR * 2.8 + bR * 1.75;
            }
            circle(toInt(bux), toInt(buy), toInt(bR), _ar_td_up ? cOn : cOff);
            triangle(bux, buy - ta, bux - tb, buy + tb, bux + tb, buy + tb,
                     _ar_td_up ? hot : dim);
            circle(toInt(bdx), toInt(bdy), toInt(bR), _ar_td_down ? cOn : cOff);
            triangle(bdx, bdy + ta, bdx - tb, bdy - tb, bdx + tb, bdy - tb,
                     _ar_td_down ? hot : dim);
        }
    }

    // aksiyon butonu — yalnızca oyun onu okuyorsa
    if (_ar_wants_action) {
        float acx = _ar_act_cx(); float acy = _ar_act_cy(); float ar = _ar_act_r();
        circle(toInt(acx), toInt(acy), toInt(ar),
               _ar_act_now ? rgba(255, 130, 120, 200) : rgba(230, 120, 110, 70));
        circle(toInt(acx), toInt(acy), toInt(ar * 0.5),
               _ar_act_now ? hot : dim);
    }
}

func _ar_update() {
    _ar_read_touch();
    float dt = frame_time();
    // Headless/ilk kare 0 gelirse sabit adım kullan.
    if (dt <= 0.0) { dt = 0.0166667; }
    // İlk kare / takılma sonrası büyük dt platform arasından tünelleme yapabilir
    // (cisim tek karede platformu atlar) — sınırla.
    if (dt > 0.05) { dt = 0.05; }

    // Efektler oyun-bitti ekranında da akmaya devam eder (son patlama donmasın).
    _fx_update(dt);

    // Oyun bitti (1) ya da kazandın (2): fizik durur. Yeniden başlatma/menü
    // ARTIK ekrana gelişigüzel dokunmayla DEĞİL, oyun-bitti ekranındaki
    // "Tekrar Oyna" / "Ana Menu" butonlarıyla (_ar_over_step, döngüde ele alınır).
    if (_ar_state != 0) {
        return;
    }

    if (_banner_t > 0.0) { _banner_t = _banner_t - dt; }

    _ar_apply_movement(dt);
    _ar_collisions();

    if (_has_frame) { call(_frame_fn); }

    // Bekleyen bölüm geçişini burada uygula — çarpışma/kare callback'leri bitti,
    // artık paralel dizileri değiştirmek güvenli.
    if (_lvl_pending == 1) { _lvl_pending = 0; _ar_advance_level(); }
}

// Hareket presetlerini uygula + konumu entegre et.
//
// Entity index'i GLOBAL `_ar_i`'de tutulur; duvar çözümü (`_ar_resolve_walls`)
// da bu global index üzerinden okur/yazar. (Tasarım tercihi — çarpışma
// callback'lerinin me()/other() global context deseniyle tutarlı.) Konum
// entegre edilip sonra katı duvarlardan MTV ile çözülür.
func _ar_apply_movement(dt) {
    for (_ar_i = 0; _ar_i < _n; _ar_i = _ar_i + 1) {
        if (_ealive[_ar_i] == 0) { continue; }
        int mv = _emove[_ar_i];

        if (mv == MV_TOPDOWN) {
            float s = _espeed[_ar_i];
            float vx = 0.0;
            float vy = 0.0;
            if (_ar_in_left())  { vx = vx - s; }
            if (_ar_in_right()) { vx = vx + s; }
            if (_ar_in_up())    { vy = vy - s; }
            if (_ar_in_down())  { vy = vy + s; }
            // Çapraz normalizasyonu: iki eksen de aktifken (vx,vy) büyüklüğü s·√2
            // olur → çapraz %41 daha hızlı. Her ikisini 1/√2 ile ölçekle ki
            // çapraz hız da tam s olsun (düz/çapraz aynı hız).
            if (vx != 0.0 && vy != 0.0) {
                vx = vx * 0.70710678;
                vy = vy * 0.70710678;
            }
            _evx[_ar_i] = vx;
            _evy[_ar_i] = vy;
            _ex[_ar_i] = _ex[_ar_i] + vx * dt;
            _ey[_ar_i] = _ey[_ar_i] + vy * dt;
            _ar_resolve_walls();            // katı duvarlardan MTV ile it
            // Dünya sınırına kıstır
            if (_clamp_world) {
                if (_ex[_ar_i] < 0.0) { _ex[_ar_i] = 0.0; }
                if (_ey[_ar_i] < 0.0) { _ey[_ar_i] = 0.0; }
                float mxt = _world_w - _ew[_ar_i];
                float myt = _world_h - _eh[_ar_i];
                if (_ex[_ar_i] > mxt) { _ex[_ar_i] = mxt; }
                if (_ey[_ar_i] > myt) { _ey[_ar_i] = myt; }
            }
        } else if (mv == MV_PLATFORM) {
            float s = _espeed[_ar_i];
            float vx = 0.0;
            if (_ar_in_left())  { vx = vx - s; }
            if (_ar_in_right()) { vx = vx + s; }
            _evx[_ar_i] = vx;
            // Yerçekimi
            _evy[_ar_i] = _evy[_ar_i] + _gravity * dt;
            // Zıplama (zemindeyken)
            if (_eground[_ar_i] == 1) {
                if (_ar_in_jump()) {
                    _evy[_ar_i] = 0.0 - _jump_v;
                    _eground[_ar_i] = 0;
                }
            }
            _eground[_ar_i] = 0;
            // X ve Y ilerle, sonra katı duvarlardan MTV ile çöz (iniş/tavan/yan).
            _ex[_ar_i] = _ex[_ar_i] + _evx[_ar_i] * dt;
            _ey[_ar_i] = _ey[_ar_i] + _evy[_ar_i] * dt;
            _ar_resolve_walls();
            // Dünya sınırları: zemin (grounded), yanlar, tavan
            float floor_y = _world_h - _eh[_ar_i];
            if (_ey[_ar_i] >= floor_y) {
                _ey[_ar_i] = floor_y;
                _evy[_ar_i] = 0.0;
                _eground[_ar_i] = 1;
            }
            if (_ey[_ar_i] < 0.0) { _ey[_ar_i] = 0.0; _evy[_ar_i] = 0.0; }
            if (_ex[_ar_i] < 0.0) { _ex[_ar_i] = 0.0; }
            float mxp = _world_w - _ew[_ar_i];
            if (_ex[_ar_i] > mxp) { _ex[_ar_i] = mxp; }
        } else if (mv == MV_VELOCITY) {
            _ex[_ar_i] = _ex[_ar_i] + _evx[_ar_i] * dt;
            _ey[_ar_i] = _ey[_ar_i] + _evy[_ar_i] * dt;
            // Dünyanın dışına 64px taşan velocity entity'lerini (mermi/engel)
            // otomatik öldür — slot boş yığına döner ve yeniden kullanılır.
            if (_ex[_ar_i] < 0.0 - 64.0 || _ex[_ar_i] > _world_w + 64.0 ||
                _ey[_ar_i] < 0.0 - 64.0 || _ey[_ar_i] > _world_h + 64.0) {
                _kill_slot(_ar_i);
            }
        }
        // MV_NONE: kullanıcı sürer.
    }
}

// Güncel entity'yi (global _ar_i) tüm katı TAG_WALL entity'lerinden iterek çöz.
// MTV (minimum translation vector): her çakışan duvar için X ve Y penetrasyon
// derinliklerini ölç, DAHA SIĞ eksende it. Bu, üstünde durulan platforma minik
// dikey batmanın yanlışlıkla YATAY itmeye (cismi platform kenarına ışınlama)
// dönüşmesini önler — eksen-ayrık yaklaşımın klasik "zemin platformunda sağa
// gidememe" bug'ının doğru çözümü. Yukarı iten (üste oturan) durum grounded.
func _ar_resolve_walls() {
    for (int w = 0; w < _n; w = w + 1) {
        if (_ealive[w] == 0) { continue; }
        if (_etag[w] != TAG_WALL) { continue; }

        float px = _ex[_ar_i];  float py = _ey[_ar_i];
        float pw = _ew[_ar_i];  float ph = _eh[_ar_i];
        float wx = _ex[w];      float wy = _ey[w];
        float ww = _ew[w];      float wh = _eh[w];

        // Çakışma yoksa geç.
        if (px + pw <= wx) { continue; }
        if (wx + ww <= px) { continue; }
        if (py + ph <= wy) { continue; }
        if (wy + wh <= py) { continue; }

        // X penetrasyonu = kesişimin genişliği.
        float rx = px + pw;  if (wx + ww < rx) { rx = wx + ww; }
        float lx = px;       if (wx > lx)      { lx = wx; }
        float ox = rx - lx;
        // Y penetrasyonu = kesişimin yüksekliği.
        float ry = py + ph;  if (wy + wh < ry) { ry = wy + wh; }
        float ly = py;       if (wy > ly)      { ly = wy; }
        float oy = ry - ly;

        if (ox < oy) {
            // Yatay it — hangi tarafa yakınsa oraya.
            float pcx = px + pw * 0.5;
            float wcx = wx + ww * 0.5;
            if (pcx < wcx) { _ex[_ar_i] = wx - pw; }   // duvarın soluna
            else { _ex[_ar_i] = wx + ww; }             // duvarın sağına
        } else {
            // Dikey it.
            float pcy = py + ph * 0.5;
            float wcy = wy + wh * 0.5;
            if (pcy < wcy) {
                _ey[_ar_i] = wy - ph;                  // üstüne otur
                _evy[_ar_i] = 0.0;
                _eground[_ar_i] = 1;
            } else {
                _ey[_ar_i] = wy + wh;                  // altına (tavan)
                _evy[_ar_i] = 0.0;
            }
        }
    }
}

// Tüm canlı çiftler için çarpışma kurallarını değerlendir + callback tetikle.
func _ar_collisions() {
    int rules = length(_ca);
    if (rules == 0) { return; }

    for (int a = 0; a < _n; a = a + 1) {
        if (_ealive[a] == 0) { continue; }
        for (int b = a + 1; b < _n; b = b + 1) {
            if (_ealive[b] == 0) { continue; }
            if (!rect_overlap(_ex[a], _ey[a], _ew[a], _eh[a], _ex[b], _ey[b], _ew[b], _eh[b])) { continue; }

            int ta = _etag[a];
            int tb = _etag[b];
            for (int r = 0; r < rules; r = r + 1) {
                // İleri yön: kural (ca,cb) == (ta,tb)
                if (_ca[r] == ta && _cb[r] == tb) {
                    _hit_self = a; _hit_other = b;
                    call(_cfn[r]);
                }
                // Simetrik: kural (ca,cb) == (tb,ta)
                else if (_ca[r] == tb && _cb[r] == ta) {
                    _hit_self = b; _hit_other = a;
                    call(_cfn[r]);
                }
            }
        }
    }
}

// Tek kare mantığı — HEADLESS TEST için (pencere/çizim olmadan advance).
// dt saniye. Testler bunu doğrudan çağırır.
func step(dt) {
    if (_ar_state != 0) { return; }
    _fx_update(dt * 1.0);
    if (_banner_t > 0.0) { _banner_t = _banner_t - dt * 1.0; }
    _ar_apply_movement(dt * 1.0);
    _ar_collisions();
    if (_has_frame) { call(_frame_fn); }
    if (_lvl_pending == 1) { _lvl_pending = 0; _ar_advance_level(); }
}
func adim(dt) { step(dt); }

// ============================================================================
//  MOTOR İÇİ — çizim
// ============================================================================

// Global tablo (oyun-bitti/kazandın ekranında, çekilebildiyse) — top-4.
func _lb_draw() {
    if (!_lb_has) { return; }
    str L = _lang_now();
    str t = "Global Tablo";
    if (L == "en") { t = "Global Top"; }
    int y0 = toInt(screen_height() * 0.50);
    text(t, toInt((screen_width() - measure_text(t, 20)) / 2.0), y0, 20, SKYBLUE);
    int n = length(_lb_data);
    if (n > 4) { n = 4; }
    for (int i = 0; i < n; i = i + 1) {
        json e = _lb_data[i];
        str line = toString(i + 1) + ". " + toString(e["isim"]) + "   " + toString(e["skor"]);
        text(line, toInt((screen_width() - measure_text(line, 18)) / 2.0),
             y0 + 24 + i * 20, 18, WHITE);
    }
}

// ---- Oyun-bitti / Kazandın ekranı: skor + "Tekrar Oyna" / "Ana Menu" ----------
// Ekrana gelişigüzel dokunmak oyunu BAŞLATMAZ; yalnız bu butonlar iş yapar.
func _ar_over_btn_w(): float { return _world_w * 0.30; }
func _ar_over_btn_h(): float { return _world_h * 0.12; }
func _ar_over_btn_gap(): float { return _world_w * 0.04; }
func _ar_over_btn_y(): float {
    if (_lb_has) { return _world_h * 0.82; }   // tablo varsa altına
    return _world_h * 0.62;
}
func _ar_over_btn_x(i): float {
    float bw = _ar_over_btn_w(); float gap = _ar_over_btn_gap();
    float sx = (_world_w - (bw * 2.0 + gap)) / 2.0;
    if (i == 0) { return sx; }
    return sx + bw + gap;
}
func _ar_over_menu_label(): str {
    str L = _lang_now();
    if (_ar_standalone) { if (L == "en") { return "Quit"; } return "Cikis"; }
    if (L == "en") { return "Menu"; }
    return "Ana Menu";
}
func _ar_over_draw_btn(i, label, fill) {
    float bx = _ar_over_btn_x(i); float by = _ar_over_btn_y();
    float bw = _ar_over_btn_w();  float bh = _ar_over_btn_h();
    rect(bx, by, bw, bh, fill);
    rect_lines(bx, by, bw, bh, GOLD);
    int bsz = toInt(bh * 0.32);
    text(label, toInt(bx + (bw - measure_text(label, bsz)) / 2.0),
         toInt(by + (bh - bsz * 1.0) / 2.0), bsz, WHITE);
}

func _ar_draw_over() {
    str L = _lang_now();
    // Tam-ekran karartma (letterbox bantları dahil — pause örtüsüyle aynı desen)
    float vl = tm_view_left(); float vt = tm_view_top();
    float vr = tm_view_right(); float vb = tm_view_bottom();
    rect(vl, vt, vr - vl, vb - vt, rgba(8, 10, 16, 210));

    bool won = (_ar_state == 2);
    str titl = "OYUN BITTI"; int tcol = RED;
    if (won) { titl = "KAZANDIN"; tcol = LIME; }
    if (L == "en") { if (won) { titl = "YOU WIN"; } else { titl = "GAME OVER"; } }
    int tsz = toInt(_world_h * 0.10);
    text(titl, toInt((_world_w - measure_text(titl, tsz)) / 2.0),
         toInt(_world_h * 0.15), tsz, tcol);

    // Skor — büyük ve ortada
    str spre = "Skor: "; if (L == "en") { spre = "Score: "; }
    str sline = spre + toString(_score);
    int ssz = toInt(_world_h * 0.075);
    text(sline, toInt((_world_w - measure_text(sline, ssz)) / 2.0),
         toInt(_world_h * 0.32), ssz, WHITE);

    // Rekor / en iyi
    if (_ar_title != "") {
        str bl = "";
        if (_new_record) { bl = "YENI REKOR!"; if (L == "en") { bl = "NEW RECORD!"; } }
        else if (_best > 0) {
            bl = "En iyi: " + toString(_best);
            if (L == "en") { bl = "Best: " + toString(_best); }
        }
        if (bl != "") {
            int rsz = toInt(_world_h * 0.05);
            text(bl, toInt((_world_w - measure_text(bl, rsz)) / 2.0),
                 toInt(_world_h * 0.43), rsz, GOLD);
        }
    }

    _lb_draw();

    // Butonlar
    str rl = "Tekrar Oyna"; if (L == "en") { rl = "Play Again"; }
    _ar_over_draw_btn(0, rl, rgb(40, 110, 70));
    _ar_over_draw_btn(1, _ar_over_menu_label(), rgb(70, 60, 90));
}

// Oyun-bitti bir karesi: 0 = bekle, 1 = tekrar oyna, 2 = menü/çıkış.
func _ar_over_step(): int {
    if (key_pressed("R") || key_pressed("ENTER") || key_pressed("SPACE")) { return 1; }
    if (key_pressed("ESCAPE") || key_pressed("BACKSPACE") || key_pressed("BACK")) { return 2; }
    int act = 0;
    if (_ar_tap_edge) {
        float tx = touch_x(0) * 1.0; float ty = touch_y(0) * 1.0;
        float by = _ar_over_btn_y(); float bh = _ar_over_btn_h(); float bw = _ar_over_btn_w();
        int i = 0;
        while (i < 2) {
            float bx = _ar_over_btn_x(i);
            if (tx >= bx && tx <= bx + bw && ty >= by && ty <= by + bh) { act = i + 1; }
            i = i + 1;
        }
    }
    return act;
}

func _ar_draw_all() {
    clear(rgb(18, 20, 28));

    // Entity'ler (sarsıntı ofsetiyle — sars() aktifken tüm sahne titrer)
    for (int i = 0; i < _n; i = i + 1) {
        if (_ealive[i] == 0) { continue; }
        if (_esprite[i] >= 0) {
            draw_texture(_esprite[i], _ex[i] + _fx_ox, _ey[i] + _fx_oy);
        } else {
            rect(_ex[i] + _fx_ox, _ey[i] + _fx_oy, _ew[i], _eh[i], _ecolor[i]);
        }
    }

    // Kullanıcı ek çizimi
    if (_has_draw) { call(_draw_fn); }

    // Parçacıklar — kullanıcı çiziminin de ÜSTÜNDE (ızgara çizen oyunlarda
    // [yılan] parçacıklar tahtanın altında kaybolmasın)
    _pt_draw(_fx_ox, _fx_oy);
    // Uçan "+N" / seri baloncukları (parçacıkların üstünde)
    _pop_draw(_fx_ox, _fx_oy);

    // Flash (hasar/ölüm vurgusu) — GERÇEK ekranın tamamını kaplar (bantlar
    // dahil); HUD'un altında ki skor okunur kalsın
    if (_fx_fl_t > 0.0) {
        float flk = 0.0;
        if (_fx_fl_dur > 0.0) { flk = _fx_fl_t / _fx_fl_dur; }
        float fvl = tm_view_left(); float fvt = tm_view_top();
        rect(fvl, fvt, tm_view_right() - fvl, tm_view_bottom() - fvt,
             rgba(255, 255, 255, toInt(150.0 * flk)));
    }

    // Dokunmatik kontrol overlay'i (oynanırken, dokunma modu açıksa)
    if (_ar_touch_ui) {
        if (_ar_state == 0) { _ar_draw_touch_ui(); }
    }

    // HUD skor
    str L = _lang_now();
    if (_show_score) {
        str pre = _hud_prefix;
        if (!_hud_set) { if (L == "en") { pre = "Score: "; } else { pre = "Skor: "; } }
        text(pre + toString(_score), 12, 10, 24, WHITE);
        // Bölüm göstergesi sağ üstte — skor (12,10) ve hint (12,38) ile çakışmaz.
        if (_has_levels) {
            str lw = "Bolum ";
            if (L == "en") { lw = "Level "; }
            str lv = lw + toString(_cur_level) + "/" + toString(_level_n);
            text(lv, screen_width() - measure_text(lv, 20) - 12, 10, 20, GOLD);
        }
    }
    // Üst bilgilendirme şeridi (kontroller) — skorun altında, ekranı geçmesin
    // diye küçük punto ile.
    if (_has_hint) {
        text(_hint, 12, 38, 16, SKYBLUE);
    }

    // FPS sayacı (Ayarlar'dan açılınca) — üst-orta, skor/bölüm/EV ile çakışmaz.
    if (_fps_on) {
        str fps = "FPS " + toString(tm_fps());
        text(fps, (screen_width() - measure_text(fps, 18)) / 2, 10, 18, rgb(120, 230, 120));
    }

    // "Bölüm N" afişi (geçişten sonra ~1.2 sn)
    if (_banner_t > 0.0) {
        str bw = "Bolum ";
        if (L == "en") { bw = "Level "; }
        str bn = bw + toString(_cur_level);
        text(bn, (screen_width() - measure_text(bn, 40)) / 2, screen_height() / 2 - 20, 40, GOLD);
    }

    // Oyun bitti / Kazandın: profesyonel örtü (skor + Tekrar Oyna / Ana Menu).
    if (_ar_state != 0) {
        _ar_draw_over();
    }

    // Rozet "toast"ı — her şeyin üstünde (oyun-bitti örtüsü dahil).
    _badge_draw_toast();
}

// Yeni kazanılan rozetin kısa üst-orta bildirimi (~2.2 sn). tm_view_* ile gerçek
// ekranın üstüne demirlenir (Android kamera modelinde bantlar dahil).
func _badge_draw_toast() {
    if (_badge_toast_t <= 0.0) { return; }
    str L = _lang_now();
    str head = "Rozet! "; if (L == "en") { head = "Badge! "; }
    str msg = head + _badge_toast_txt;
    int fs = toInt(_world_h * 0.045);
    if (fs < 14) { fs = 14; }
    int tw = measure_text(msg, fs);
    float bw = tw * 1.0 + _world_h * 0.09;
    float bh = fs * 1.0 + _world_h * 0.05;
    float bx = tm_view_left() + (tm_view_right() - tm_view_left() - bw) / 2.0;
    float by = tm_view_top() + _world_h * 0.06;
    rect(bx, by, bw, bh, rgba(20, 22, 34, 235));
    rect_lines(bx, by, bw, bh, GOLD);
    text(msg, toInt(bx + (bw - tw * 1.0) / 2.0), toInt(by + (bh - fs * 1.0) / 2.0), fs, GOLD);
}

// ============================================================================
//  LAUNCHER — tek pencerede / tek APK'da çok oyun (mobil vitrin)
// ============================================================================
// Birden çok arcade oyununu tek pencerede toplar: açılışta bir menü ızgarası
// çizer, bir kart seçilince (dokunma ya da klavye) o oyunun setup fn'ini çağırıp
// motoru o oyuna hazırlar; oyun içinde sağ-üst EV butonu (ya da ESC) menüye
// döndürür. Paketleme boru hattı değişmez — hâlâ tek `.tpr`, tek NativeActivity.
//
// Kullanım:
//   sahne(640, 480, "Tulpar Arcade");
//   oyun_ekle("Topla", topla_kur);   // her oyun = 0-arg bir setup fonksiyonu
//   oyun_ekle("Kac",   kac_kur);
//   launcher();                      // menü + oyun geçişi döngüsü burada
//
// Bir oyun setup fn'i, normalde top-level yazacağın kayıtları yapar AMA
// sahne()/oyna() ÇAĞIRMAZ (pencere + döngü launcher'ın): baslangicta(...),
// bolum(...), her_kare(...), carpisinca(...), bilgi(...), yercekimi(...) vb.

array _apps_name  = [];    // menüde görünen oyun adları
array _apps_setup = [];    // 0-arg setup fonksiyonları (index eşleşir)
array _apps_best  = [];    // kalıcı en iyi skorlar (launcher açılışında yüklenir)
array _apps_star  = [];    // SONSUZ oyun: kalıcı yıldız 0..3 (kart pip'leri)
array _apps_levn  = [];    // oyunun toplam bölüm sayısı (0 = sonsuz; init'te keşfedilir)
array _apps_done  = [];    // tamamlanan bölüm sayısı (bölümlü oyun kart göstergesi)
int   _apps_n     = 0;
int   _ar_mode    = 0;     // 0 = menü, 1 = oyun oynanıyor
int   _menu_sel   = 0;     // menüde seçili kart index'i
str   _menu_title = "";    // "" = varsayılan ("TULPAR ARCADE")
bool  _lx_home_prev = false;

// Oyun kaydet: ad + 0-arg setup fonksiyonu.
func add_game(name, setup) {
    push(_apps_name, name);
    push(_apps_setup, setup);
    push(_apps_best, 0);
    push(_apps_star, 0);
    push(_apps_levn, 0);
    push(_apps_done, 0);
    _apps_n = _apps_n + 1;
}
func oyun_ekle(name, setup) { add_game(name, setup); }

// Menü başlığını değiştir (varsayılan "TULPAR ARCADE").
func launcher_title(s) { _menu_title = s; }
func menu_basligi(s)   { launcher_title(s); }

// Motoru sıradaki oyuna hazırla: TÜM kayıt durumunu sıfırlar. `_ar_reset()`
// yalnız skor/entity/bölüm sıfırlar; oyun DEĞİŞTİRİRKEN sahne callback'leri,
// bölüm kayıtları, çarpışma kuralları, hint/HUD ve fizik de temizlenmeli —
// yoksa yeni oyun eskisinin handler'larını miras alır.
func _lx_clear() {
    _start_fn = 0; _has_start = false;
    _frame_fn = 0; _has_frame = false;
    _draw_fn  = 0; _has_draw  = false;
    _levels = []; _level_n = 0; _cur_level = 1; _has_levels = false;
    _ca = []; _cb = []; _cfn = [];
    _hint = ""; _has_hint = false;
    _hud_prefix = ""; _hud_set = false; _show_score = true;
    _gravity = 0.0; _jump_v = 520.0; _clamp_world = true;
    _banner_t = 0.0; _lvl_pending = 0;
    _ar_wants_action = false;          // buton görünürlüğü oyuna göre sıfırlanır
    _ar_wants_move = false;            // joystick görünürlüğü de oyuna göre
    _ar_scheme = 0;                    // kontrol şeması oyuna göre (auto'ya dön)
    _ar_rd_l = false; _ar_rd_r = false; _ar_rd_u = false; _ar_rd_d = false;
    _ar_joy_on = false; _ar_joy_dx = 0.0; _ar_joy_dy = 0.0;
    _ar_swipe = 0;                     // önceki oyunun jesti sızmasın
    _ar_tilt_cal = false;              // yeni oyun kendi nötr tutuşunu yakalar
    _star_g1 = 0; _star_g2 = 0; _star_g3 = 0;   // yıldız eşikleri oyuna göre
    clear_entities();
}

// i. oyunu başlat: kayıtları temizle → oyunun setup'ı → yükle → oyun moduna geç.
int _lx_sel_game = -1;   // bölüm-seçim ekranında olduğumuz oyun index'i

// Oyunu HAZIRLA (kayıtları temizle + setup'ı çağır) — pencere/oynatma YOK.
// Sonrası: _level_n bilinir, _lvl_done doldurulur.
func _lx_prepare(i) {
    _lx_clear();
    _ar_title = _apps_name[i];         // rekor anahtarı = menüdeki oyun adı
    call(_apps_setup[i]);
    _lx_load_lvl_done(_ar_title, _level_n);
}

// Hazırlanmış oyunu OYNAT (skor/durum reset + oyun moduna geç).
func _lx_begin_play(i) {
    _ar_reset();                       // _ar_start_level'e göre + _ar_load_level
    _menu_sel = i;
    _ar_mode = 1;
    _trans_start();                    // oyuna girişte kısa fade-in
    // Seçme dokunuşu (parmak hâlâ basılı) oyunun ilk karesinde restart/aksiyon
    // olarak sayılmasın diye edge sayaçlarını "basılı"ya çek.
    _ar_touch_prevn = touch_count();
    _ar_act_prev = true;
    _lx_home_prev = true;
}

// Karta dokununca: bölümlü oyun → önce BÖLÜM SEÇİM ekranı; sonsuz oyun → doğrudan.
func _lx_launch(i) {
    if (i < 0 || i >= _apps_n) { return; }
    _lx_prepare(i);
    if (_level_n > 0) {
        _lx_sel_game = i;
        _menu_sel = i;
        _ar_mode = _ar_mode_levelsel;
        _ar_touch_prevn = touch_count();
    } else {
        _ar_start_level = 1;           // sonsuz oyun: bölüm yok
        _lx_begin_play(i);
    }
}

// ---- Oyun içi EV (menüye geri) butonu — GERÇEK ekranın sağ üst köşesi ------
func _lx_home_x(): float { return tm_view_right() - _world_h * 0.11; }
func _lx_home_y(): float { return tm_view_top() + _world_h * 0.08; }
func _lx_home_r(): float { return _world_h * 0.05; }

// Herhangi bir parmak EV butonuna yeni bastı mı (edge).
func _lx_home_pressed(): bool {
    float hx = _lx_home_x(); float hy = _lx_home_y();
    float grab = _lx_home_r() * 1.8;
    bool now = false;
    int n = touch_count();
    int i = 0;
    while (i < n) {
        float dx = touch_x(i) * 1.0 - hx;
        float dy = touch_y(i) * 1.0 - hy;
        if (dx * dx + dy * dy <= grab * grab) { now = true; }
        i = i + 1;
    }
    bool edge = now && !_lx_home_prev;
    _lx_home_prev = now;
    return edge;
}

func _lx_draw_home() {
    float hx = _lx_home_x(); float hy = _lx_home_y(); float hr = _lx_home_r();
    circle(toInt(hx), toInt(hy), toInt(hr), rgba(230, 120, 110, 130));
    // basit "geri/ev" işareti: içte küçük beyaz kare
    float s = hr * 0.7;
    rect(hx - s * 0.5, hy - s * 0.5, s, s, rgba(255, 255, 255, 225));
}

// Oyundan menüye dön (EV butonu, oyun-bitti "Ana Menu" ve duraklat-Menü ortak yolu):
// menüye geç + fade + seçme dokunuşunu tüket (dişli-kaskad koruması) + rozet tazele.
func _lx_goto_menu() {
    _ar_mode = 0;
    _trans_start();
    _ar_touch_prevn = touch_count();
    _apps_best[_menu_sel] = _best;
    if (_apps_levn[_menu_sel] > 0) {
        _apps_done[_menu_sel] = _count_done_levels(_ar_title, _apps_levn[_menu_sel]);
    } else {
        _apps_star[_menu_sel] = _stars;
    }
}

// ---- Menü ızgara geometrisi ------------------------------------------------
func _menu_cols(): int {
    if (_apps_n <= 1) { return 1; }
    if (_apps_n <= 4) { return 2; }
    if (_apps_n <= 9) { return 3; }
    return 4;
}
func _menu_rows(): int {
    int cols = _menu_cols();
    int rows = toInt((_apps_n + cols - 1) / cols);   // ceil(n/cols)
    if (rows < 1) { rows = 1; }
    return rows;
}
func _menu_top(): float  { return _world_h * 0.28; }   // başlık için üst boşluk
func _menu_padh(): float { return _world_w * 0.045; }
func _menu_padv(): float { return _world_h * 0.05; }

func _menu_card_w(): float {
    int cols = _menu_cols();
    float pad = _menu_padh();
    return (_world_w - pad * (cols + 1)) / (cols * 1.0);
}
func _menu_card_h(): float {
    int rows = _menu_rows();
    float pad = _menu_padv();
    return (_world_h - _menu_top() - pad * (rows + 1)) / (rows * 1.0);
}
func _menu_card_x(i): float {
    int cols = _menu_cols();
    int col = mod(i, cols);
    float pad = _menu_padh();
    return pad + col * (_menu_card_w() + pad);
}
func _menu_card_y(i): float {
    int cols = _menu_cols();
    int row = toInt(i / cols);
    float pad = _menu_padv();
    return _menu_top() + pad + row * (_menu_card_h() + pad);
}

// Klavye ile seçimi ızgarada gezdir.
func _menu_move(dcol, drow) {
    int cols = _menu_cols();
    int col = mod(_menu_sel, cols) + dcol;
    int row = toInt(_menu_sel / cols) + drow;
    if (col < 0) { col = 0; }
    if (col > cols - 1) { col = cols - 1; }
    if (row < 0) { row = 0; }
    int ni = row * cols + col;
    if (ni >= 0 && ni < _apps_n) { _menu_sel = ni; }
}

// Menü bir karesi: klavye navigasyonu + dokunma ile kart seçme.
func _menu_step() {
    if (key_pressed("LEFT")  || key_pressed("A")) { _menu_move(0 - 1, 0); }
    if (key_pressed("RIGHT") || key_pressed("D")) { _menu_move(1, 0); }
    if (key_pressed("UP")    || key_pressed("W")) { _menu_move(0, 0 - 1); }
    if (key_pressed("DOWN")  || key_pressed("S")) { _menu_move(0, 1); }
    if (key_pressed("ENTER") || key_pressed("SPACE")) { _lx_launch(_menu_sel); return; }

    int n = touch_count();
    bool tap = (n > 0) && (_ar_touch_prevn == 0);
    if (tap) {
        float tx = touch_x(0) * 1.0;
        float ty = touch_y(0) * 1.0;
        int i = 0;
        while (i < _apps_n) {
            float cx = _menu_card_x(i); float cy = _menu_card_y(i);
            float cw = _menu_card_w();  float ch = _menu_card_h();
            if (tx >= cx && tx <= cx + cw && ty >= cy && ty <= cy + ch) {
                _lx_launch(i);
                return;
            }
            i = i + 1;
        }
    }
    _ar_touch_prevn = n;
}

// Menü ekranını çiz: başlık + kart ızgarası (seçili kart altın çerçeveli).
// Kartta 3 yıldız pip'i çiz (kazanılan altın, kalan koyu).
func _menu_draw_pips(cx, cy, cw, ch, st) {
    float pr = ch * 0.055;
    if (pr < 3.0) { pr = 3.0; }
    float gap = pr * 2.8;
    float sx = cx + cw / 2.0 - gap;      // 3 pip → 2 aralık, ortala
    float py = cy + ch * 0.58;
    int j = 0;
    while (j < 3) {
        int col = rgb(58, 64, 84);
        if (j < st) { col = GOLD; }
        circle(toInt(sx + j * gap), toInt(py), toInt(pr), col);
        j = j + 1;
    }
}

// ---- Bölüm seçim ekranı (mode 4) — kart→bölümler→oyna -----------------------
func _lsel_cols(): int {
    if (_level_n <= 3) { return _level_n; }
    if (_level_n <= 4) { return 2; }
    return 3;
}
func _lsel_bw(): float  { return _world_w * 0.22; }
func _lsel_bh(): float  { return _world_h * 0.17; }
func _lsel_gap(): float { return _world_w * 0.045; }
func _lsel_x0(): float {
    int c = _lsel_cols(); if (c < 1) { c = 1; }
    float total = c * _lsel_bw() + (c - 1) * _lsel_gap();
    return (_world_w - total) / 2.0;
}
func _lsel_y0(): float { return _world_h * 0.30; }
func _lsel_bx(k): float {          // k 0-tabanlı
    int c = _lsel_cols(); if (c < 1) { c = 1; }
    int col = mod(k, c);
    return _lsel_x0() + col * (_lsel_bw() + _lsel_gap());
}
func _lsel_by(k): float {
    int c = _lsel_cols(); if (c < 1) { c = 1; }
    int row = toInt(k / c);
    return _lsel_y0() + row * (_lsel_bh() + _lsel_gap());
}

func _levelsel_draw() {
    clear(rgb(16, 18, 26));
    str L = _lang_now();
    str nm = _apps_name[_lx_sel_game];
    int tsz = toInt(_world_h * 0.075);
    text(nm, toInt((_world_w - measure_text(nm, tsz)) / 2.0), toInt(_world_h * 0.075), tsz, GOLD);
    str sub = "Bolum sec"; if (L == "en") { sub = "Pick a level"; }
    int ssz = toInt(_world_h * 0.042);
    text(sub, toInt((_world_w - measure_text(sub, ssz)) / 2.0), toInt(_world_h * 0.185), ssz, SKYBLUE);
    int k = 0;
    while (k < _level_n) {
        float bx = _lsel_bx(k); float by = _lsel_by(k);
        float bw = _lsel_bw();  float bh = _lsel_bh();
        bool done = false;
        if (k < length(_lvl_done)) { if (_lvl_done[k] == 1) { done = true; } }
        rect(bx, by, bw, bh, done ? rgb(46, 54, 82) : rgb(30, 34, 48));
        rect_lines(bx, by, bw, bh, done ? GOLD : rgb(60, 66, 86));
        str num = toString(k + 1);
        int nsz = toInt(bh * 0.36);
        text(num, toInt(bx + (bw - measure_text(num, nsz)) / 2.0), toInt(by + bh * 0.16), nsz, WHITE);
        int pcol = rgb(60, 66, 86); if (done) { pcol = GOLD; }
        circle(toInt(bx + bw / 2.0), toInt(by + bh * 0.72), toInt(bh * 0.11), pcol);
        k = k + 1;
    }
    float qx = _cfg_back_x(); float qy = _cfg_back_y();
    float qw = _cfg_back_w(); float qh = _cfg_back_h();
    rect(qx, qy, qw, qh, rgb(46, 54, 82));
    rect_lines(qx, qy, qw, qh, GOLD);
    str back = "Geri"; if (L == "en") { back = "Back"; }
    int bsz = toInt(qh * 0.40);
    text(back, toInt(qx + (qw - measure_text(back, bsz)) / 2.0),
         toInt(qy + (qh - bsz * 1.0) / 2.0), bsz, WHITE);
}

// Bölüm seçim bir karesi: 0 = yok, -1 = geri, k(1..N) = o bölümü başlat.
func _levelsel_step(): int {
    if (key_pressed("BACK") || key_pressed("ESCAPE") || key_pressed("BACKSPACE")) {
        return 0 - 1;
    }
    int n = touch_count();
    bool tap = (n > 0) && (_ar_touch_prevn == 0);
    int act = 0;
    if (tap) {
        float tx = touch_x(0) * 1.0; float ty = touch_y(0) * 1.0;
        int k = 0;
        while (k < _level_n) {
            float bx = _lsel_bx(k); float by = _lsel_by(k);
            float bw = _lsel_bw();  float bh = _lsel_bh();
            if (tx >= bx && tx <= bx + bw && ty >= by && ty <= by + bh) { act = k + 1; }
            k = k + 1;
        }
        float qx = _cfg_back_x(); float qy = _cfg_back_y();
        float qw = _cfg_back_w(); float qh = _cfg_back_h();
        if (tx >= qx && tx <= qx + qw && ty >= qy && ty <= qy + qh) { act = 0 - 1; }
    }
    _ar_touch_prevn = n;
    return act;
}

func _menu_draw() {
    clear(rgb(16, 18, 26));
    str L = _lang_now();
    str title = _menu_title;
    if (title == "") { title = "TULPAR ARCADE"; }
    int tsz = toInt(_world_h * 0.095);
    text(title, toInt((_world_w - measure_text(title, tsz)) / 2.0),
         toInt(_world_h * 0.07), tsz, GOLD);
    str sub = "Bir oyun sec";
    if (L == "en") { sub = "Pick a game"; }
    int ssz = toInt(_world_h * 0.042);
    text(sub, toInt((_world_w - measure_text(sub, ssz)) / 2.0),
         toInt(_world_h * 0.185), ssz, SKYBLUE);

    int i = 0;
    while (i < _apps_n) {
        float cx = _menu_card_x(i); float cy = _menu_card_y(i);
        float cw = _menu_card_w();  float ch = _menu_card_h();
        bool selp = (i == _menu_sel);
        rect(cx, cy, cw, ch, selp ? rgb(46, 54, 82) : rgb(30, 34, 48));
        if (selp) {
            rect_lines(cx, cy, cw, ch, GOLD);
            rect_lines(cx + 1.0, cy + 1.0, cw - 2.0, ch - 2.0, GOLD);
        }
        str nm = _apps_name[i];
        int nsz = toInt(ch * 0.24);
        if (nsz < 13) { nsz = 13; }
        text(nm, toInt(cx + (cw - measure_text(nm, nsz)) / 2.0),
             toInt(cy + ch * 0.26), nsz, WHITE);
        // İlerleme: bölümlü oyun → tamamlanan/tüm bölüm (altın yıldız + N/M),
        // sonsuz oyun → 0..3 yıldız pip'i.
        if (_apps_levn[i] > 0) {
            str pt = toString(_apps_done[i]) + "/" + toString(_apps_levn[i]);
            int psz = toInt(ch * 0.17); if (psz < 11) { psz = 11; }
            int ptw = measure_text(pt, psz);
            float pr = ch * 0.06;
            float py = cy + ch * 0.56;
            float gw = pr * 2.0 + ch * 0.05 + ptw * 1.0;   // pip + boşluk + metin
            float gx = cx + cw / 2.0 - gw / 2.0;
            circle(toInt(gx + pr), toInt(py + psz * 0.45), toInt(pr), GOLD);
            text(pt, toInt(gx + pr * 2.0 + ch * 0.05), toInt(py), psz, GOLD);
        } else {
            _menu_draw_pips(cx, cy, cw, ch, _apps_star[i]);
        }
        // En iyi skor rozeti — kartın altına, altın renkli.
        if (_apps_best[i] > 0) {
            str bh = "En iyi: ";
            if (L == "en") { bh = "Best: "; }
            str bt = bh + toString(_apps_best[i]);
            int bsz = toInt(ch * 0.13);
            if (bsz < 10) { bsz = 10; }
            text(bt, toInt(cx + (cw - measure_text(bt, bsz)) / 2.0),
                 toInt(cy + ch - bsz * 1.5), bsz, GOLD);
        }
        i = i + 1;
    }
}

// Ana launcher döngüsü — menü ↔ oyun durum makinesi. `oyna()`nın çok-oyunlu
// karşılığı: pencereyi (zaten `sahne()` ile açık) ve döngüyü sahiplenir.
// Bir oyunun kayıtlı en iyi skorunu oku (launcher rozetleri için).
func _lx_load_best(name): int {
    str s = load_data("arcade_best_" + name + ".txt");
    if (s == "") { return 0; }
    return toInt(s);
}
func _lx_load_star(name): int {
    str s = load_data("arcade_star_" + name + ".txt");
    if (s == "") { return 0; }
    return toInt(s);
}

// ============================================================================
//  APP KABUĞU — Ayarlar ekranı + Duraklat örtüsü + geri tuşu
// ============================================================================

int  _ar_mode_settings = 2;   // launcher modu: 2 = Ayarlar ekranı
bool _pause_prev = false;     // duraklat düğmesi edge durumu (_ar_paused yukarıda)

// ---- Menüdeki dişli (Ayarlar) düğmesi — sağ üst köşe -----------------------
func _cfg_btn_x(): float { return tm_view_right() - _world_h * 0.11; }
func _cfg_btn_y(): float { return tm_view_top()   + _world_h * 0.08; }
func _cfg_btn_r(): float { return _world_h * 0.055; }

func _cfg_btn_draw() {
    float bx = _cfg_btn_x(); float by = _cfg_btn_y(); float br = _cfg_btn_r();
    circle(toInt(bx), toInt(by), toInt(br),        rgba(70, 80, 110, 220));
    circle(toInt(bx), toInt(by), toInt(br * 0.52), rgb(16, 18, 26));
    circle(toInt(bx), toInt(by), toInt(br * 0.20), rgba(215, 215, 235, 240));
}

func _cfg_btn_tapped(): bool {
    int n = touch_count();
    if (n == 0 || _ar_touch_prevn != 0) { return false; }   // menü ile aynı edge kaynağı
    float dx = touch_x(0) * 1.0 - _cfg_btn_x();
    float dy = touch_y(0) * 1.0 - _cfg_btn_y();
    float grab = _cfg_btn_r() * 1.6;
    return dx * dx + dy * dy <= grab * grab;
}

// ---- Menüdeki kupa (Rozetler) düğmesi — dişlinin solunda -------------------
int  _ar_mode_badges = 3;     // launcher modu: 3 = Rozetler ekranı
int  _ar_mode_levelsel = 4;   // launcher modu: 4 = Bölüm seçim ekranı
func _bdg_btn_x(): float { return _cfg_btn_x() - _world_h * 0.15; }
func _bdg_btn_y(): float { return _cfg_btn_y(); }
func _bdg_btn_r(): float { return _cfg_btn_r(); }

func _bdg_btn_draw() {
    float bx = _bdg_btn_x(); float by = _bdg_btn_y(); float br = _bdg_btn_r();
    circle(toInt(bx), toInt(by), toInt(br), rgba(70, 80, 110, 220));
    // basit altın kupa: kâse + gövde + taban
    rect(bx - br * 0.35, by - br * 0.45, br * 0.70, br * 0.45, GOLD);   // kâse
    rect(bx - br * 0.10, by,             br * 0.20, br * 0.28, GOLD);   // gövde
    rect(bx - br * 0.35, by + br * 0.28, br * 0.70, br * 0.16, GOLD);   // taban
}

func _bdg_btn_tapped(): bool {
    int n = touch_count();
    if (n == 0 || _ar_touch_prevn != 0) { return false; }
    float dx = touch_x(0) * 1.0 - _bdg_btn_x();
    float dy = touch_y(0) * 1.0 - _bdg_btn_y();
    float grab = _bdg_btn_r() * 1.6;
    return dx * dx + dy * dy <= grab * grab;
}

// ---- Rozetler ekranı (mode 3) ----------------------------------------------
func _badges_draw() {
    clear(rgb(16, 18, 26));
    str L = _lang_now();
    str title = "Rozetler"; if (L == "en") { title = "Badges"; }
    int tsz = toInt(_world_h * 0.082);
    text(title, toInt((_world_w - measure_text(title, tsz)) / 2.0),
         toInt(_world_h * 0.055), tsz, GOLD);
    // Toplam yıldız satırı.
    int total = 0; int k = 0;
    while (k < _apps_n) { total = total + _apps_star[k]; k = k + 1; }
    str stx = "Toplam yildiz: "; if (L == "en") { stx = "Total stars: "; }
    str sline = stx + toString(total);
    int ssz = toInt(_world_h * 0.042);
    text(sline, toInt((_world_w - measure_text(sline, ssz)) / 2.0),
         toInt(_world_h * 0.150), ssz, SKYBLUE);
    int i = 0;
    while (i < 5) {
        float rx = _world_w * 0.13; float rw = _world_w * 0.74;
        float rh = _world_h * 0.10;  float ry = _world_h * (0.21 + i * 0.115);
        bool has = _badge_has(i);
        rect(rx, ry, rw, rh, has ? rgb(40, 46, 66) : rgb(24, 26, 36));
        float mr = rh * 0.28;
        int mcol = rgb(60, 66, 86); if (has) { mcol = GOLD; }
        circle(toInt(rx + rh * 0.55), toInt(ry + rh * 0.5), toInt(mr), mcol);
        int ncol = WHITE; if (!has) { ncol = rgb(120, 126, 140); }
        text(_badge_name(i), toInt(rx + rh * 1.1), toInt(ry + rh * 0.16),
             toInt(rh * 0.34), ncol);
        text(_badge_desc(i), toInt(rx + rh * 1.1), toInt(ry + rh * 0.55),
             toInt(rh * 0.24), rgb(150, 156, 170));
        i = i + 1;
    }
    // Geri düğmesi (Ayarlar geometrisini paylaşır).
    float bx = _cfg_back_x(); float by = _cfg_back_y();
    float bw = _cfg_back_w(); float bh = _cfg_back_h();
    rect(bx, by, bw, bh, rgb(46, 54, 82));
    rect_lines(bx, by, bw, bh, GOLD);
    str back = "Geri"; if (L == "en") { back = "Back"; }
    int bsz = toInt(bh * 0.40);
    text(back, toInt(bx + (bw - measure_text(back, bsz)) / 2.0),
         toInt(by + (bh - bsz * 1.0) / 2.0), bsz, WHITE);
}

// Rozetler ekranı bir karesi. true → menüye dön.
func _badges_step(): bool {
    if (key_pressed("BACK") || key_pressed("ESCAPE") || key_pressed("BACKSPACE")) {
        return true;
    }
    int n = touch_count();
    bool tap = (n > 0) && (_ar_touch_prevn == 0);
    bool leave = false;
    if (tap) {
        float tx = touch_x(0) * 1.0; float ty = touch_y(0) * 1.0;
        float bx = _cfg_back_x(); float by = _cfg_back_y();
        float bw = _cfg_back_w(); float bh = _cfg_back_h();
        if (tx >= bx && tx <= bx + bw && ty >= by && ty <= by + bh) { leave = true; }
    }
    _ar_touch_prevn = n;
    return leave;
}

// ---- Ayarlar ekranı: 3 satır (Ses / Titreşim / Dil) + Geri -----------------
func _cfg_row_x(): float  { return _world_w * 0.14; }
func _cfg_row_w(): float  { return _world_w * 0.72; }
func _cfg_row_h(): float  { return _world_h * 0.086; }
func _cfg_row_y(i): float { return _world_h * (0.185 + i * 0.099); }
func _cfg_back_x(): float { return _world_w * 0.35; }
func _cfg_back_y(): float { return _world_h * 0.83; }
func _cfg_back_w(): float { return _world_w * 0.30; }
func _cfg_back_h(): float { return _world_h * 0.10; }

func _cfg_val_onoff(on): str {
    str L = _lang_now();
    if (on) { if (L == "en") { return "On"; } return "Acik"; }
    if (L == "en") { return "Off"; }
    return "Kapali";
}

func _cfg_draw_row(i, label, value) {
    float rx = _cfg_row_x(); float ry = _cfg_row_y(i);
    float rw = _cfg_row_w(); float rh = _cfg_row_h();
    rect(rx, ry, rw, rh, rgb(30, 34, 48));
    int lsz = toInt(rh * 0.38);
    text(label, toInt(rx + rw * 0.06), toInt(ry + (rh - lsz * 1.0) / 2.0), lsz, WHITE);
    int vsz = lsz;
    int vw = measure_text(value, vsz);
    float pw = vw * 1.0 + rw * 0.10;
    float px = rx + rw - pw - rw * 0.05;
    rect(px, ry + rh * 0.18, pw, rh * 0.64, rgb(46, 54, 82));
    text(value, toInt(px + (pw - vw * 1.0) / 2.0), toInt(ry + (rh - vsz * 1.0) / 2.0), vsz, GOLD);
}

func _cfg_draw() {
    clear(rgb(16, 18, 26));
    str L = _lang_now();
    str title = "Ayarlar"; if (L == "en") { title = "Settings"; }
    int tsz = toInt(_world_h * 0.085);
    text(title, toInt((_world_w - measure_text(title, tsz)) / 2.0),
         toInt(_world_h * 0.075), tsz, GOLD);

    str l0 = "Ses";      if (L == "en") { l0 = "Sound"; }
    str lm = "Muzik";    if (L == "en") { lm = "Music"; }
    str l1 = "Titresim"; if (L == "en") { l1 = "Haptics"; }
    str l2 = "Dil";      if (L == "en") { l2 = "Language"; }
    str l3 = "FPS";
    str l4 = "Rekorlar"; if (L == "en") { l4 = "Records"; }
    str lv = "Turkce";   if (L == "en") { lv = "English"; }
    str rv = "Sil";      if (L == "en") { rv = "Clear"; }
    if (_cfg_reset_msg > 0.0) { rv = "Silindi"; if (L == "en") { rv = "Cleared"; } }
    else if (_cfg_reset_armed) { rv = "Emin?"; if (L == "en") { rv = "Sure?"; } }
    _cfg_draw_row(0, l0, _cfg_val_onoff(_snd_on));
    _cfg_draw_row(1, lm, _cfg_val_onoff(_mus_on));
    _cfg_draw_row(2, l1, _cfg_val_onoff(_hap_on));
    _cfg_draw_row(3, l2, lv);
    _cfg_draw_row(4, l3, _cfg_val_onoff(_fps_on));
    _cfg_draw_row(5, l4, rv);

    float bx = _cfg_back_x(); float by = _cfg_back_y();
    float bw = _cfg_back_w(); float bh = _cfg_back_h();
    rect(bx, by, bw, bh, rgb(46, 54, 82));
    rect_lines(bx, by, bw, bh, GOLD);
    str back = "Geri"; if (L == "en") { back = "Back"; }
    int bsz = toInt(bh * 0.40);
    text(back, toInt(bx + (bw - measure_text(back, bsz)) / 2.0),
         toInt(by + (bh - bsz * 1.0) / 2.0), bsz, WHITE);
}

// Tüm oyunların kalıcı en iyi skorlarını sıfırla (dosyaya "0" yaz + rozetleri düş).
func _ar_reset_records() {
    int i = 0;
    while (i < _apps_n) {
        save_data("arcade_best_" + _apps_name[i] + ".txt", "0");
        _apps_best[i] = 0;
        i = i + 1;
    }
    _best = 0;
    _new_record = false;
}

func _cfg_toggle(i) {
    if (i != 5) { _cfg_reset_armed = false; }   // başka satıra dokunmak onayı düşürür
    if (i == 0) { _snd_on = !_snd_on; if (_snd_on) { _snd(880.0, 60); } }
    else if (i == 1) { _mus_on = !_mus_on; if (!_mus_on) { _mus_track = -1; } }
    else if (i == 2) { _hap_on = !_hap_on; if (_hap_on) { _hap(80); } }
    else if (i == 3) { if (_lang_now() == "en") { _lang = "tr"; } else { _lang = "en"; } }
    else if (i == 4) { _fps_on = !_fps_on; }
    else if (i == 5) {
        // İki-dokunuş onayı: 1. dokunuş silahlandırır ("Emin?"), 2. dokunuş siler.
        if (_cfg_reset_armed) {
            _ar_reset_records();
            _cfg_reset_armed = false;
            _cfg_reset_msg = 1.2;
            _snd(400.0, 80);
        } else {
            _cfg_reset_armed = true;
        }
    }
}

// Ayarlar ekranı bir karesi. true dönerse menüye dönülür (kaydedilir).
func _cfg_step(): bool {
    if (_cfg_reset_msg > 0.0) { _cfg_reset_msg = _cfg_reset_msg - frame_time(); }
    if (key_pressed("BACK") || key_pressed("ESCAPE") || key_pressed("BACKSPACE")) {
        return true;
    }
    int n = touch_count();
    bool tap = (n > 0) && (_ar_touch_prevn == 0);
    bool leave = false;
    if (tap) {
        float tx = touch_x(0) * 1.0; float ty = touch_y(0) * 1.0;
        int i = 0;
        while (i < 6) {
            float ry = _cfg_row_y(i); float rh = _cfg_row_h();
            float rx = _cfg_row_x(); float rw = _cfg_row_w();
            // Yalnız SAĞDAKİ değer kutusu toggle eder; sol etikete/ortaya basmak
            // ayarı değiştirmez (değer kutusu sağa yaslı, sol ~%23 etiket bölgesi).
            float valL = rx + rw * 0.58;
            if (tx >= valL && tx <= rx + rw && ty >= ry && ty <= ry + rh) { _cfg_toggle(i); }
            i = i + 1;
        }
        float bx = _cfg_back_x(); float by = _cfg_back_y();
        float bw = _cfg_back_w(); float bh = _cfg_back_h();
        if (tx >= bx && tx <= bx + bw && ty >= by && ty <= by + bh) { leave = true; }
    }
    _ar_touch_prevn = n;
    return leave;
}

// ---- Oyun-içi Duraklat düğmesi (EV butonunun solunda) ----------------------
func _pause_btn_x(): float { return tm_view_right() - _world_h * 0.24; }
func _pause_btn_y(): float { return tm_view_top()   + _world_h * 0.08; }
func _pause_btn_r(): float { return _world_h * 0.05; }

func _pause_btn_draw() {
    float bx = _pause_btn_x(); float by = _pause_btn_y(); float br = _pause_btn_r();
    circle(toInt(bx), toInt(by), toInt(br), rgba(90, 100, 130, 130));
    float bw = br * 0.24; float bh = br * 0.9;
    rect(bx - br * 0.42, by - bh * 0.5, bw, bh, rgba(255, 255, 255, 225));
    rect(bx + br * 0.18, by - bh * 0.5, bw, bh, rgba(255, 255, 255, 225));
}

// Duraklat düğmesine yeni basıldı mı (edge, kendi durumuyla).
func _pause_btn_pressed(): bool {
    float hx = _pause_btn_x(); float hy = _pause_btn_y();
    float grab = _pause_btn_r() * 1.8;
    bool now = false;
    int n = touch_count(); int i = 0;
    while (i < n) {
        float dx = touch_x(i) * 1.0 - hx;
        float dy = touch_y(i) * 1.0 - hy;
        if (dx * dx + dy * dy <= grab * grab) { now = true; }
        i = i + 1;
    }
    bool edge = now && !_pause_prev;
    _pause_prev = now;
    return edge;
}

// ---- Duraklat örtüsü (3 düğme: Devam / Yeniden / Menü) ----------------------
func _pause_rect_x(): float { return _world_w * 0.30; }
func _pause_rect_w(): float { return _world_w * 0.40; }
func _pause_rect_h(): float { return _world_h * 0.12; }
func _pause_rect_y(i): float { return _world_h * (0.36 + i * 0.16); }

func _pause_draw(menu_label) {
    float vl = tm_view_left(); float vt = tm_view_top();
    float vr = tm_view_right(); float vb = tm_view_bottom();
    rect(vl, vt, vr - vl, vb - vt, rgba(8, 10, 16, 185));
    str L = _lang_now();
    str t = "Duraklatildi"; if (L == "en") { t = "Paused"; }
    int tsz = toInt(_world_h * 0.09);
    text(t, toInt((_world_w - measure_text(t, tsz)) / 2.0), toInt(_world_h * 0.18), tsz, GOLD);

    str l0 = "Devam";   if (L == "en") { l0 = "Resume"; }
    str l1 = "Yeniden"; if (L == "en") { l1 = "Restart"; }
    _pause_draw_btn(0, l0);
    _pause_draw_btn(1, l1);
    _pause_draw_btn(2, menu_label);
}

func _pause_draw_btn(i, label) {
    float bx = _pause_rect_x(); float by = _pause_rect_y(i);
    float bw = _pause_rect_w(); float bh = _pause_rect_h();
    rect(bx, by, bw, bh, rgb(46, 54, 82));
    rect_lines(bx, by, bw, bh, GOLD);
    int bsz = toInt(bh * 0.38);
    text(label, toInt(bx + (bw - measure_text(label, bsz)) / 2.0),
         toInt(by + (bh - bsz * 1.0) / 2.0), bsz, WHITE);
}

// Duraklat bir karesi: 0=yok, 1=devam, 2=yeniden, 3=menü/çıkış.
func _pause_step(): int {
    int act = 0;
    int n = touch_count();
    bool tap = (n > 0) && (_ar_touch_prevn == 0);
    if (tap) {
        float tx = touch_x(0) * 1.0; float ty = touch_y(0) * 1.0;
        int i = 0;
        while (i < 3) {
            float bx = _pause_rect_x(); float bw = _pause_rect_w();
            float by = _pause_rect_y(i); float bh = _pause_rect_h();
            if (tx >= bx && tx <= bx + bw && ty >= by && ty <= by + bh) { act = i + 1; }
            i = i + 1;
        }
    }
    _ar_touch_prevn = n;
    if (key_pressed("ENTER") || key_pressed("SPACE")) { act = 1; }
    if (key_pressed("R")) { act = 2; }
    return act;
}

func _pause_enter() {
    _ar_paused = true;
    _ar_touch_prevn = touch_count();   // örtü girişteki dokunuşu "yeni tap" saymasın
}

func launcher() {
    if (_apps_n == 0) { return; }
    _ar_mode = 0;
    _menu_sel = 0;
    _ar_standalone = false;            // oyun-bitti ekranında ikinci buton = "Ana Menu"
    // Kalıcı rekorları bir kez yükle (kare başına dosya IO'su OLMAZ).
    for (int bi = 0; bi < _apps_n; bi = bi + 1) {
        _apps_best[bi] = _lx_load_best(_apps_name[bi]);
        _apps_star[bi] = _lx_load_star(_apps_name[bi]);
    }
    // Bölüm sayılarını + tamamlanan bölümleri keşfet: her setup'ı bir kez çağır
    // (saf kayıt — pencere/entity YOK), _level_n'i oku, sonra temizle. Kartlar +
    // bölüm-seçim ekranı bunu kullanır (setup'ı tekrar çalıştırmadan).
    for (int pj = 0; pj < _apps_n; pj = pj + 1) {
        _lx_clear();
        _ar_title = _apps_name[pj];
        call(_apps_setup[pj]);
        _apps_levn[pj] = _level_n;
        _apps_done[pj] = _count_done_levels(_apps_name[pj], _level_n);
    }
    _lx_clear();
    _ar_load_settings();               // kalıcı ses/haptik/dil ayarlarını uygula
    var wm = arena_save();
    while (running()) {
        if (_ar_mode == 0) {
            // Menü: kupa → Rozetler; dişli → Ayarlar; Android GERİ → çık.
            if (_bdg_btn_tapped()) {
                _ar_mode = _ar_mode_badges;
                _ar_touch_prevn = touch_count();
            } else if (_cfg_btn_tapped()) {
                _ar_mode = _ar_mode_settings;
                _cfg_reset_armed = false;   // ayara her girişte "Rekorları Sıfırla" onayı sıfır
                _cfg_reset_msg = 0.0;
                _ar_touch_prevn = touch_count();
            } else if (key_pressed("BACK")) {
                break;
            } else {
                _menu_step();
            }
            _mus_step(0);                  // menü müziği (sakin parça)
            frame_begin();
            _menu_draw();
            _bdg_btn_draw();
            _cfg_btn_draw();
            _trans_draw();
            frame_end();
        } else if (_ar_mode == _ar_mode_settings) {
            // Ayarlar ekranı — çıkışta kaydeder.
            bool leave = _cfg_step();
            _mus_step(0);                  // ayarlarda da menü müziği sürer
            frame_begin();
            _cfg_draw();
            _trans_draw();
            frame_end();
            if (leave) { _ar_save_settings(); _ar_mode = 0; }
        } else if (_ar_mode == _ar_mode_badges) {
            // Rozetler ekranı — sadece görüntüler, Geri ile menüye döner.
            bool bleave = _badges_step();
            _mus_step(0);
            frame_begin();
            _badges_draw();
            _trans_draw();
            frame_end();
            if (bleave) { _ar_mode = 0; _ar_touch_prevn = touch_count(); }
        } else if (_ar_mode == _ar_mode_levelsel) {
            // Bölüm seçim ekranı — bir bölüm seç ya da Geri ile menüye dön.
            int la = _levelsel_step();
            _mus_step(0);
            frame_begin();
            _levelsel_draw();
            _trans_draw();
            frame_end();
            if (la == 0 - 1) { _lx_clear(); _ar_mode = 0; _ar_touch_prevn = touch_count(); }
            else if (la > 0) { _ar_start_level = la; _lx_begin_play(_lx_sel_game); }
        } else {
            // Oyun. GERİ / ESC → duraklat (ilerleme kaybolmasın); EV → anında menü.
            // Yalnız aktif oynanırken duraklanır (biten oyun duraklatılamaz).
            if (!_ar_paused && _ar_state == 0) {
                if (key_pressed("ESCAPE") || key_pressed("BACKSPACE") || key_pressed("BACK")) {
                    _pause_enter();
                }
            }
            if (_ar_paused) {
                str ml = "Menu";
                _mus_step(0);              // duraklatınca sakin parçaya geç
                frame_begin();
                _ar_draw_all();
                _lx_draw_home();
                _pause_draw(ml);
                frame_end();
                int act = _pause_step();
                if (act == 1) { _ar_paused = false; }
                else if (act == 2) { _ar_reset(); _ar_paused = false; }
                else if (act == 3) { _ar_paused = false; _lx_goto_menu(); }
            } else {
                _ar_update();
                if (_ar_state == 0) { _mus_step(1); } else { _mus_step(0); }
                frame_begin();
                _ar_draw_all();
                _lx_draw_home();
                _trans_draw();
                frame_end();
                // Oyun-bitti ekranı: "Tekrar Oyna" / "Ana Menu" butonları (ekrana
                // gelişigüzel dokunma oyunu BAŞLATMAZ). EV butonu da menüye döndürür.
                if (_ar_state != 0) {
                    int oa = _ar_over_step();
                    if (oa == 1) { _ar_reset(); _trans_start(); }
                    else if (oa == 2) { _lx_goto_menu(); }
                }
                if (_lx_home_pressed()) { _lx_goto_menu(); }
            }
        }
        arena_restore(wm);
    }
    arena_drop(wm);
    close_window();
}
func oyun_menusu() { launcher(); }
