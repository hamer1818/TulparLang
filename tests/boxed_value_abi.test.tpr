import "test";

// KUTULU FONKSIYONLARIN DEGER ABI'si (2026-09-08).
//
// Kutulu kullanici fonksiyonlari `void t_f(VMValue* ret, VMValue* a0, ...)`
// imzasiyla cagriliyordu: argumanlar ve donus BELLEKTEN geciyordu. Artik
// govde `t_f.f` adinda, VMValue'yu DEGER olarak alip donduren bir fonksiyonda
// (SysV'de {i64,i64} = iki yazmac); `t_f` ince bir SARMALAYICI olarak kaldi,
// boylece call() kayit defteri, async motoru ve wasm sret yolu DEGISMEDI.
//
// Olculdu: tipsiz `fib(32)` 11,86 -> 7,69 ms (1,54 kat).
//
// ⚠ ILK YAZIMDA LAMBDALAR KIRILDI: `fn_value_abi` bayragi cevreleyen
// fonksiyondan MIRAS aliniyordu, oysa lambdalar isaretci ABI'si kullaniyor.
// Modul dogrulamasi "Found return instr that returns non-void in Function of
// void return type" ile dusuyordu ve program OPTIMIZE EDILMEDEN derleniyordu
// (sessiz degil ama kolay atlanir). Bayrak artik govde sinirinda temizleniyor.

// --- arite: 0..4 arguman ------------------------------------------------
func a0() { return 7; }
func a1(x) { return x + 1; }
func a2(x, y) { return x * 10 + y; }
func a3(x, y, z) { return x + y * 2 + z * 3; }
func a4(x, y, z, w) { return x - y + z - w; }
func run_arite() {
    assert_eq_int(a0(), 7);
    assert_eq_int(a1(41), 42);
    assert_eq_int(a2(3, 4), 34);
    assert_eq_int(a3(1, 2, 3), 14);
    assert_eq_int(a4(10, 1, 5, 2), 12);
}

// --- ozyineleme (asil kazanc buradaydi) --------------------------------
func fib(n) {
    if (n <= 1) { return n; }
    return fib(n - 1) + fib(n - 2);
}
func run_ozyineleme() {
    assert_eq_int(fib(0), 0);
    assert_eq_int(fib(1), 1);
    assert_eq_int(fib(10), 55);
    assert_eq_int(fib(20), 6765);
}

// --- DEGER TURLERI: dizgi, float, bool, dizi, json ----------------------
// Deger ABI'si VMValue'yu ciftle tasiyor; etiket ve yuk birlikte gitmeli.
func kimlik(v) { return v; }
func run_deger_turleri() {
    assert_eq_str(kimlik("merhaba"), "merhaba");
    assert_eq_float(kimlik(2.5), 2.5);
    assert_eq_bool(kimlik(true), true);
    assert_eq_int(kimlik(42), 42);
    var d = kimlik([1, 2, 3]);
    assert_eq_int(len(d), 3);
    assert_eq_int(d[2], 3);
    var o = kimlik({"a": 1});
    assert_eq_int(o["a"], 1);
}

// --- LAMBDA: isaretci ABI'sinde kalmali --------------------------------
// Bu testin ilk hali paketi kirmiziya cevirdi (bkz. baslik).
func run_lambda() {
    int r1 = ((int x) => x * 2)(21);
    assert_eq_int(r1, 42);
    int r2 = ((int x) => { return x * x; })(5);
    assert_eq_int(r2, 25);
}

// --- KAPANIS: kutulu fonksiyon icinden lambda dondurme ------------------
func sayac_uret() {
    int c = 0;
    return () => { c = c + 1; return c; };
}
func run_kapanis() {
    var f = sayac_uret();
    assert_eq_int(f(), 1);
    assert_eq_int(f(), 2);
    assert_eq_int(f(), 3);
}

// --- call() ile ADIYLA cagri: SARMALAYICIDAN gecmeli -------------------
// Deger ABI'si dogrudan cagrilar icin; call() kayit defteri `t_<ad>`i
// kullaniyor ve o imza degismedi.
func toplayici(a, b) { return a + b; }
func run_call_dinamik() {
    assert_eq_int(call("toplayici", 20, 22), 42);
    assert_eq_int(call("a1", 9), 10);
}

// --- VARSAYILAN arguman: hizli yol kapali, sonuc dogru -----------------
func varsayilanli(a, b, c) {
    if (b == 0) { b = 5; }
    if (c == 0) { c = 7; }
    return a + b + c;
}
func run_varsayilan() {
    assert_eq_int(varsayilanli(1, 2, 3), 6);
    assert_eq_int(varsayilanli(1), 13);
}

// --- STRUCT parametre/donus: deger ABI'si DISINDA -----------------------
struct Nokta { int x; int y; }
func kur(int a, int b): Nokta { Nokta p; p.x = a; p.y = b; return p; }
func topla(Nokta p): int { return p.x + p.y; }
func run_struct() {
    Nokta q = kur(3, 4);
    assert_eq_int(q.x, 3);
    assert_eq_int(q.y, 4);
    assert_eq_int(topla(q), 7);
}

// --- IC ICE cagri: sonuc dogrudan baska cagriya arguman ----------------
func run_ic_ice() {
    assert_eq_int(a1(a1(a1(0))), 3);
    assert_eq_int(a2(a1(2), a1(3)), 34);
}

// --- cok sayida cagri: yazmac basincinda bozulma olmamali --------------
func run_cok_cagri() {
    int t = 0;
    int i = 0;
    while (i < 500) { t = t + a2(i % 7, i % 5); i = i + 1; }
    // Beklenen BAGIMSIZ hesaplandi (Python referansi); elle tahmin edilen ilk
    // deger yanlisti ve test kirmiziya dondu, yani bu satir gercekten olcuyor.
    assert_eq_int(t, 15940);
}

test("arite 0..4", "run_arite");
test("ozyineleme", "run_ozyineleme");
test("deger turleri (dizgi/float/bool/dizi/json)", "run_deger_turleri");
test("lambda isaretci ABI'sinde kaldi", "run_lambda");
test("kapanis (closure) calisiyor", "run_kapanis");
test("call() adiyla sarmalayicidan", "run_call_dinamik");
test("varsayilan arguman", "run_varsayilan");
test("struct parametre/donus", "run_struct");
test("ic ice cagri", "run_ic_ice");
test("cok sayida cagri", "run_cok_cagri");
test_summary();
