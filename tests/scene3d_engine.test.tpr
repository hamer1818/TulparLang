// Testlerin ortak kaynağı. Dünya ayarlarının HEPSİNDEN birer örnek içeriyor
// ki "yükleme tam mı?" sorusu tek sahneyle sınanabilsin.
func _sc_fixture(): str {
    return "{\"v\":1,\"world\":{" +
      "\"sky\":{\"top\":[28,38,62],\"bottom\":[132,156,186]}," +
      "\"fog\":0.012,\"ground\":0,\"gravity\":26," +
      "\"daynight\":{\"len\":120,\"time\":5}," +
      "\"water\":{\"y\":3.08,\"color\":[30,95,150],\"alpha\":145}," +
      "\"terrain\":{\"res\":33,\"sx\":120,\"sy\":14,\"sz\":120,\"noise\":4.5,\"seed\":7}," +
      "\"slope\":{\"limit\":38,\"slide\":16}," +
      "\"camera\":{\"mode\":\"orbit\",\"target\":\"kahraman\",\"dist\":16,\"height\":10}}," +
      "\"entities\":[" +
      "{\"name\":\"kahraman\",\"tag\":\"player\",\"shape\":\"cube\",\"x\":0,\"y\":30,\"z\":0," +
        "\"sx\":1.2,\"sy\":2,\"sz\":1.2,\"color\":[135,206,235],\"hp\":100}," +
      "{\"tag\":\"item\",\"shape\":\"sphere\",\"x\":-40,\"y\":2.5,\"z\":-40," +
        "\"sx\":1.2,\"sy\":1.2,\"sz\":1.2,\"color\":[255,203,0]}," +
      "{\"name\":\"duvar\",\"tag\":\"wall\",\"shape\":\"cube\",\"x\":5,\"y\":1.5,\"z\":0," +
        "\"sx\":8,\"sy\":3,\"sz\":1,\"color\":[130,130,130],\"yaw\":45}]}";
}

func t_scene_loads_entities() {
    int n = scene_load3d(_sc_fixture());
    assert_eq_int(n, 3);
    assert_eq_int(alive_count3d(), 3);
    int p = find3d("kahraman");
    assert(p >= 0, "adiyla bulunmali");
    assert(abs_f3(get3y(p) - 30.0) < 0.001, "y yuklenmelii");
    assert_eq_int(hp3d(p), 100);
    // Şekil/etiket METİNDEN sayıya çevrildi mi?
    Ent3 w = _e3[_slot_of3(find3d("duvar"))];
    assert_eq_int(w.shape, SHAPE_CUBE);
    assert_eq_int(w.tag, TAG_WALL);
    assert(abs_f3(w.yaw - 45.0) < 0.001, "yaw yuklenmelii");
    assert(abs_f3(w.sx - 8.0) < 0.001, "sx yuklenmelii");
}

func t_scene_loads_world() {
    scene_load3d(_sc_fixture());
    assert(abs_f3(_fog3 - 0.012) < 0.0001, "sis");
    assert_eq_int(_sky3, 1);
    assert_eq_int(_water_on3, 1);
    assert(abs_f3(su_seviyesi3d() - 3.08) < 0.001, "su seviyesi");
    assert_eq_int(_terr_on, 1);
    assert(abs_f3(_slope_lim3 - 38.0) < 0.001, "egim siniri");
    assert_eq_int(_dn_on3, 1);
    assert(abs_f3(gunun_saati3d() - 5.0) < 0.001, "saat");
    // Kamera hedefi ADLA çözülüyor — entity'lerden SONRA uygulanmalı.
    assert_eq_int(_cam_target, find3d("kahraman"));
    assert_eq_int(_cam_mode3, CAM_ORBIT);
}

// Gidiş-dönüş: serileştir → yükle → yeniden serileştir AYNI metni vermeli.
// (Beklenti bağımsız bir kaynaktan geliyor: motorun kendi durumu, biçimin
// kendi formülü değil.)
func t_scene_roundtrip_is_stable() {
    scene_load3d(_sc_fixture());
    str a = scene_json3d();
    scene_load3d(a);
    str b = scene_json3d();
    assert(a == b, "gidis-donus durağan olmali");
}

// Bu testin kendi bulduğu hata: camera_orbit(d,h) _cam_dist'e sqrt(d*d+h*h)
// yazıyor. Serileştirici ham _cam_dist'i yazınca her tur mesafe büyüyordu
// (16 → 18.87 → 21.35 → ...). Yörüngeyi ayrıca sınıyoruz çünkü tek turda
// fark edilmesi zor, birikimli bir kayma.
func t_scene_orbit_dist_survives_roundtrip() {
    scene3d_reset();
    int p = spawn3(0.0, 1.0, 0.0, 1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    _sc_reg3("p", p);
    camera_orbit(p, 16.0, 10.0);
    float r0 = _cam_dist;
    int turn = 0;
    while (turn < 3) {
        scene_load3d(scene_json3d());
        turn = turn + 1;
    }
    assert(abs_f3(_cam_dist - r0) < 0.01,
           "yorunge yaricapi 3 turda kaymamali: " + toString(_cam_dist));
}

// Yükleme TAM olmalı: ikinci sahne birincinin dünyasını devralmamalı.
// (reset() dünya ayarlarının çoğunu bırakıyor — editör saniyede bir yüklüyor.)
func t_scene_load_is_total() {
    scene_load3d(_sc_fixture());
    assert_eq_int(_water_on3, 1);
    scene_load3d("{\"v\":1,\"entities\":[{\"tag\":\"prop\",\"x\":0,\"y\":1,\"z\":0}]}");
    assert_eq_int(_water_on3, 0);
    assert_eq_int(_terr_on, 0);
    assert_eq_int(_sky3, 0);
    assert_eq_int(_dn_on3, 0);
    assert(_fog3 < 0.0001, "sis sifirlanmali");
    assert(_slope_lim3 < 0.0001, "egim siniri sifirlanmali");
    assert(abs_f3(_grav - 26.0) < 0.001, "yercekimi varsayilana donmeli");
}

// _sc_world_defaults3() KENDİ BAŞINA eksiksiz olmalı: "dünyanın tüm ayarları
// varsayılana döner" sözleşmesi var. Yalnız t_scene_load_is_total'a güvenmek
// yetmiyordu — scene_load3d önce scene3d_reset() çağırdığı için ayarların bir
// kısmını ZATEN o sıfırlıyor, dolayısıyla buradan bir satır silmek hiçbir
// testi kızartmıyordu (bozma denemesiyle ölçüldü). Burada reset ÇAĞRILMIYOR.
func t_scene_world_defaults_are_total() {
    scene3d_reset();
    sky3d(rgb(1, 2, 3), rgb(4, 5, 6));
    fog3d(0.05);
    ground3d(9.0);
    gravity3d(3.0);
    lights3d(false);
    shadows3d(false);
    daynight3d(30.0);
    set_time3d(2.0);
    stars3d(0.9);
    water3d(4.0);
    water_color3d(rgb(1, 1, 1), 20);
    water_physics3d(false);
    slope_limit3d(50.0);
    camera_fov(80.0);
    camera_collide3d(false);
    terrain3d(17, 20.0, 5.0, 20.0, 3.0, 1);
    terrain_natural3d(5.0);

    _sc_world_defaults3();

    assert_eq_int(_sky3, 0);
    assert(_fog3 < 0.0001, "sis");
    assert_eq_int(_ground_on, 1);
    assert(abs_f3(_ground_y) < 0.001, "zemin y");
    assert(abs_f3(_grav - 26.0) < 0.001, "yercekimi");
    assert_eq_int(_lights3, 1);
    assert_eq_int(_shadows3, 1);
    assert_eq_int(_dn_on3, 0);
    assert(abs_f3(_dn_len3 - 120.0) < 0.001, "gun uzunlugu");
    assert(_stars3 < 0.0, "yildiz otomatige donmeli");
    assert_eq_int(_water_on3, 0);
    assert_eq_int(_water_phys3, 1);
    assert_eq_int(_water_a3, 150);
    assert(_slope_lim3 < 0.0001, "egim siniri");
    assert(abs_f3(_cam_fov - 45.0) < 0.001, "fov");
    assert_eq_int(_cam_collide3, 1);
    assert_eq_int(_terr_on, 0);
    assert_eq_int(_terr_lay3, 0);
}

// Bozuk JSON sahneyi YIKMAMALI: 0 döner ve eldeki sahne yerinde kalır.
func t_scene_bad_json_is_safe() {
    scene_load3d(_sc_fixture());
    int before = alive_count3d();
    assert_eq_int(scene_load3d("{bozuk"), 0);
    assert_eq_int(alive_count3d(), before);
    assert_eq_int(scene_load3d(""), 0);
    assert_eq_int(alive_count3d(), before);
}

// "ground" alanının YOKLUĞU anlamlı: zemin düzlemi olmayan sahne.
func t_scene_ground_absence_means_no_ground() {
    scene_load3d("{\"v\":1,\"world\":{\"gravity\":26}}");
    assert_eq_int(_ground_on, 0);
    scene_load3d("{\"v\":1,\"world\":{\"ground\":2.5}}");
    assert_eq_int(_ground_on, 1);
    assert(abs_f3(_ground_y - 2.5) < 0.001, "zemin yuksekligi");
}

// Eksik alanlar varsayılana düşmeli — biçim ileri uyumlu olsun diye.
func t_scene_optional_fields_default() {
    int n = scene_load3d("{\"v\":1,\"entities\":[{\"tag\":\"item\"}]}");
    assert_eq_int(n, 1);
    Ent3 e = _e3[0];
    assert(abs_f3(e.x) < 0.001, "x varsayilan 0");
    assert(abs_f3(e.sx - 1.0) < 0.001, "sx varsayilan 1");
    assert_eq_int(e.shape, SHAPE_CUBE);
    assert_eq_int(e.tag, TAG_ITEM);
}

// Mermi ÇALIŞMA ZAMANI ürünü — sahne dosyasına yazılmamalı.
func t_scene_skips_runtime_entities() {
    scene3d_reset();
    int p = spawn3(0.0, 1.0, 0.0, 1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    _sc_reg3("p", p);
    bullet3d(p, 20.0, 2.0);
    assert_eq_int(alive_count3d(), 2);
    int n = scene_load3d(scene_json3d());
    assert_eq_int(n, 1);
}

// Sayı biçimi: üretilen metin hem JSON hem de TULPAR sayı sözdizimi olmalı.
// toString(120.0) "1.2e+02" veriyor — bu Tulpar kaynağında geçersiz, o yüzden
// biçimin kendi yazıcısı var.
func t_scene_number_format() {
    assert(_sc_num3(120.0) == "120", "us gosterimi olmamali: " + _sc_num3(120.0));
    assert(_sc_num3(0.012) == "0.012", "kucuk ondalik: " + _sc_num3(0.012));
    assert(_sc_num3(1.5) == "1.5", "sondaki sifirlar atilmali: " + _sc_num3(1.5));
    assert(_sc_num3(0.0 - 2.0) == "-2", "negatif tamsayi: " + _sc_num3(0.0 - 2.0));
    assert(_sc_num3(0.0) == "0", "sifir: " + _sc_num3(0.0));
    assert(_sc_num3(1000000.0) == "1000000", "buyuk: " + _sc_num3(1000000.0));
    assert(_sc_num3(0.25) == "0.25", "iki ondalik: " + _sc_num3(0.25));
}

// Renk [r,g,b] gidiş-dönüşü — editörde renk seçici doğrudan buna bağlanacak.
func t_scene_color_roundtrip() {
    scene_load3d("{\"v\":1,\"entities\":[{\"tag\":\"item\",\"color\":[7,199,42]}]}");
    Ent3 e = _e3[0];
    assert_eq_int(_col_r3(e.color), 7);
    assert_eq_int(_col_g3(e.color), 199);
    assert_eq_int(_col_b3(e.color), 42);
}

// Katılık yalnız etiketin BEKLENENİNDEN farklıysa yazılır — ama yazıldığında
// geri okunmalı (hayalet duvar / katı eşya).
func t_scene_solid_override_roundtrip() {
    scene_load3d("{\"v\":1,\"entities\":[" +
        "{\"name\":\"hayalet\",\"tag\":\"wall\",\"solid\":false}," +
        "{\"name\":\"kati\",\"tag\":\"item\",\"solid\":true}]}");
    assert_eq_int(_e3[_slot_of3(find3d("hayalet"))].solid, 0);
    assert_eq_int(_e3[_slot_of3(find3d("kati"))].solid, 1);
    scene_load3d(scene_json3d());
    assert_eq_int(_e3[_slot_of3(find3d("hayalet"))].solid, 0);
    assert_eq_int(_e3[_slot_of3(find3d("kati"))].solid, 1);
}


// ===========================================================================
//  DAVRANIŞLAR — oynanış veri olarak
// ===========================================================================

func _count_tag3(tag): int {
    int c = 0;
    int i = 0;
    while (i < length(_e3)) {
        if (_e3[i].alive == 1 && _e3[i].tag == tag) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

// Kovalama gerçekten MESAFE KAPATMALI. Beklenti davranışın formülünden değil,
// iki konumun arasındaki ölçülen uzaklıktan geliyor.
func t_bh_chase_closes_distance() {
    scene3d_reset();
    no_ground3d();
    int p = spawn3(0.0, 1.0, 0.0, 1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    int en = spawn3(20.0, 1.0, 0.0, 1.0, 2.0, 1.0, RED, SHAPE_CUBE, TAG_ENEMY);
    chase_behavior3d(en, TAG_PLAYER, 6.0, 0.0);
    float d0 = 20.0;
    int i = 0;
    while (i < 60) { _s3_behaviors(0.016667); _s3_physics(0.016667); i = i + 1; }
    Ent3 e = _e3[_slot_of3(en)];
    float d1 = sqrt(e.x * e.x + e.z * e.z);
    assert(d1 < d0 - 3.0, "kovalayan yaklasmali: " + toString(d1));
}

// Menzil dışına çıkan kovalayan DURMALI — son hızıyla süzülmemeli.
//
// İlk hâli BOŞ bir testti: düşmanı menzilin dışında ÜRETİP hızını sınıyordu,
// oysa yeni üretilen varlığın hızı zaten sıfır. "Durdurma" dalını silmek
// testi kızartmıyordu (bozma denemesiyle ölçüldü). Gerçek senaryo şu:
// kovalarken hız kazanmış bir düşmanın hedefi menzilden çıkıyor.
func t_bh_chase_range_stops() {
    scene3d_reset();
    no_ground3d();
    int p = spawn3(0.0, 1.0, 0.0, 1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    int en = spawn3(8.0, 1.0, 0.0, 1.0, 2.0, 1.0, RED, SHAPE_CUBE, TAG_ENEMY);
    chase_behavior3d(en, TAG_PLAYER, 6.0, 12.0);   // menzil 12, mesafe 8 → içeride
    _s3_behaviors(0.016667);
    assert(abs_f3(_e3[_slot_of3(en)].vx) > 1.0, "once kovalamali");
    // Hedef menzilden kaçıyor.
    set3pos(p, 0.0 - 90.0, 1.0, 0.0);
    _s3_behaviors(0.016667);
    Ent3 e = _e3[_slot_of3(en)];
    assert(abs_f3(e.vx) < 0.001 && abs_f3(e.vz) < 0.001,
           "menzil disinda durmali: " + toString(e.vx));
}

// Devriye uçta yön çevirmeli.
func t_bh_patrol_reverses() {
    scene3d_reset();
    no_ground3d();
    int g = spawn3(0.0 - 10.0, 1.0, 0.0, 1.0, 2.0, 1.0, ORANGE, SHAPE_CUBE, TAG_ENEMY);
    patrol_behavior3d(g, 0.0 - 10.0, 0.0, 10.0, 0.0, 8.0);
    int i = 0;
    int saw_pos = 0;
    int saw_neg = 0;
    while (i < 400) {
        _s3_behaviors(0.016667);
        _s3_physics(0.016667);
        Ent3 e = _e3[_slot_of3(g)];
        if (e.vx > 1.0)         { saw_pos = 1; }
        if (e.vx < 0.0 - 1.0)   { saw_neg = 1; }
        i = i + 1;
    }
    assert(saw_pos == 1 && saw_neg == 1, "iki yone de gitmeli");
}

// Dönme: yaw hıza göre artmalı ve 360'ta sarmalı (saatlerce dönen süs
// varlığında yaw büyüyüp float çözünürlüğünü yerdi).
func t_bh_spin_rotates_and_wraps() {
    scene3d_reset();
    no_ground3d();
    int d = spawn3(0.0, 1.0, 0.0, 1.0, 1.0, 1.0, GOLD, SHAPE_CUBE, TAG_PROP);
    spin_behavior3d(d, 90.0);            // 90 derece/sn
    int i = 0;
    while (i < 60) { _s3_behaviors(0.016667); i = i + 1; }   // ~1 sn
    float y1 = get3yaw(d);
    assert(y1 > 88.0 && y1 < 92.0, "1 sn'de ~90 derece: " + toString(y1));
    i = 0;
    while (i < 600) { _s3_behaviors(0.016667); i = i + 1; }  // +10 sn = 900 derece
    float y2 = get3yaw(d);
    assert(y2 >= 0.0 && y2 < 360.0, "sarmali: " + toString(y2));
}

// Salınım: tabanın hem ÜSTÜNE hem ALTINA çıkmalı ve taban kaymamalı.
func t_bh_bob_oscillates() {
    scene3d_reset();
    no_ground3d();
    int it = spawn3(0.0, 5.0, 0.0, 1.0, 1.0, 1.0, GOLD, SHAPE_SPHERE, TAG_ITEM);
    bob_behavior3d(it, 0.5, 1.0);        // 0.5 birim, 1 çevrim/sn
    float hi = 0.0 - 999.0;
    float lo = 999.0;
    int i = 0;
    while (i < 60) {
        _s3_behaviors(0.016667);
        float y = get3y(it);
        if (y > hi) { hi = y; }
        if (y < lo) { lo = y; }
        i = i + 1;
    }
    assert(hi > 5.4 && hi < 5.6, "tepe ~5.5: " + toString(hi));
    assert(lo > 4.4 && lo < 4.6, "dip ~4.5: " + toString(lo));
    // Yerçekimi tabanı aşağı çekmemeli (salınım konum yazıyor, hız değil).
    int k = 0;
    while (k < 300) { _s3_behaviors(0.016667); _s3_physics(0.016667); k = k + 1; }
    float y3 = get3y(it);
    assert(y3 > 4.4 && y3 < 5.6, "taban kaymamali: " + toString(y3));
}

// Ateş aralığı: T saniyede T/aralık kadar mermi.
func t_bh_shoot_fires_on_interval() {
    scene3d_reset();
    no_ground3d();
    int t = spawn3(0.0, 1.0, 0.0, 1.0, 2.0, 1.0, GRAY, SHAPE_CYL, TAG_PROP);
    shoot_behavior3d(t, 0.5, 20.0, 30.0, 0, 0.0);   // 0.5 sn'de bir, uzun ömür
    int i = 0;
    while (i < 120) { _s3_behaviors(0.016667); i = i + 1; }   // ~2 sn → 4 mermi
    int n = _count_tag3(TAG_BULLET);
    assert(n >= 3 && n <= 5, "2 sn'de ~4 mermi, bulunan: " + toString(n));
}

// Hedefli ateş HEDEFE gitmeli. Beklenti bağımsız: nişancıdan hedefe olan
// birim vektör konumlardan hesaplanıyor, merminin hızıyla nokta çarpımı ~1.
func t_bh_shoot_aims_at_target() {
    scene3d_reset();
    no_ground3d();
    int p = spawn3(0.0 - 15.0, 1.0, 8.0, 1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    int t = spawn3(0.0, 1.0, 0.0, 1.0, 2.0, 1.0, GRAY, SHAPE_CYL, TAG_ENEMY);
    shoot_behavior3d(t, 0.1, 20.0, 30.0, TAG_PLAYER, 0.0);
    _s3_behaviors(0.2);
    int b = 0 - 1;
    int i = 0;
    while (i < length(_e3)) {
        if (_e3[i].alive == 1 && _e3[i].tag == TAG_BULLET) { b = i; }
        i = i + 1;
    }
    assert(b >= 0, "mermi uretilmeli");
    Ent3 bl = _e3[b];
    float ux = 0.0 - 15.0;
    float uz = 8.0;
    float ul = sqrt(ux * ux + uz * uz);
    ux = ux / ul; uz = uz / ul;
    float bl2 = sqrt(bl.vx * bl.vx + bl.vz * bl.vz);
    float dot = (bl.vx / bl2) * ux + (bl.vz / bl2) * uz;
    assert(dot > 0.99, "mermi hedefe gitmeli, dot=" + toString(dot));
}

// Hedefli atış nişan modunu GLOBAL olarak değiştiriyor (AIM_BODY) — geri
// koymayı unutmak oyuncunun nişanını sessizce bozardı.
func t_bh_shoot_restores_aim_mode() {
    scene3d_reset();
    no_ground3d();
    spawn3(0.0 - 10.0, 1.0, 0.0, 1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    int t = spawn3(0.0, 1.0, 0.0, 1.0, 2.0, 1.0, GRAY, SHAPE_CYL, TAG_ENEMY);
    aim_mode3d(AIM_LOOK);
    shoot_behavior3d(t, 0.1, 20.0, 5.0, TAG_PLAYER, 0.0);
    _s3_behaviors(0.2);
    assert_eq_int(_aim_mode3, AIM_LOOK);
}

// Sahibi ölen davranış SİLİNMELİ: yalnız bayrak koymak, düşman öldüren bir
// oyunda diziyi sonsuza kadar büyütürdü.
func t_bh_dead_owner_is_culled() {
    scene3d_reset();
    no_ground3d();
    int a = spawn3(0.0, 1.0, 0.0, 1.0, 1.0, 1.0, RED, SHAPE_CUBE, TAG_ENEMY);
    int b = spawn3(3.0, 1.0, 0.0, 1.0, 1.0, 1.0, RED, SHAPE_CUBE, TAG_ENEMY);
    spin_behavior3d(a, 10.0);
    spin_behavior3d(b, 10.0);
    assert_eq_int(behavior_count3d(), 2);
    kill3d(a);
    _s3_behaviors(0.016667);
    assert_eq_int(behavior_count3d(), 1);
    // Kalan davranış DOĞRU sahibinki olmalı (takas-kırp yanlış elemanı
    // düşürebilirdi).
    _s3_behaviors(0.1);
    assert(get3yaw(b) > 0.5, "kalan davranis calismali");
}

// KOD VERİYİ EZER: davranış yalnız HIZ yazıyor, entegre etmiyor — bu yüzden
// sonradan çağrılan move3d üzerine yazabiliyor. (play3d'deki sıralama pencere
// istediği için burada koşulamıyor; sınanan şey ezmenin MEKANİZMASI.)
func t_bh_code_overrides_data() {
    scene3d_reset();
    no_ground3d();
    spawn3(100.0, 1.0, 0.0, 1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    int en = spawn3(0.0, 1.0, 0.0, 1.0, 2.0, 1.0, RED, SHAPE_CUBE, TAG_ENEMY);
    chase_behavior3d(en, TAG_PLAYER, 6.0, 0.0);
    _s3_behaviors(0.016667);
    assert(_e3[_slot_of3(en)].vx > 5.0, "davranis hiz vermeli");
    _cam_yaw3 = 0.0;
    _gp_dx = 0.0 - 1.0; _gp_dz = 0.0;
    move3d(en, 10.0);
    _gp_dx = 0.0;
    assert(_e3[_slot_of3(en)].vx < 0.0 - 5.0, "elle hareket davranisi ezmeli");
}

func t_bh_cleared_by_reset() {
    scene3d_reset();
    int a = spawn3(0.0, 1.0, 0.0, 1.0, 1.0, 1.0, RED, SHAPE_CUBE, TAG_ENEMY);
    spin_behavior3d(a, 10.0);
    assert_eq_int(behavior_count3d(), 1);
    scene3d_reset();
    assert_eq_int(behavior_count3d(), 0);
}

// Davranışlar sahne biçiminde gidip gelmeli — editörün "Oynat"ı buna bağlı.
func t_bh_roundtrip() {
    int n = scene_load3d("{\"v\":1,\"world\":{\"ground\":0},\"entities\":[" +
      "{\"name\":\"p\",\"tag\":\"player\",\"x\":0,\"y\":1,\"z\":0," +
        "\"behaviors\":[{\"type\":\"move\",\"speed\":11,\"jump\":12}]}," +
      "{\"name\":\"d\",\"tag\":\"enemy\",\"x\":10,\"y\":1,\"z\":0," +
        "\"behaviors\":[{\"type\":\"chase\",\"target\":\"player\",\"speed\":6,\"range\":40}," +
                      "{\"type\":\"spin\",\"speed\":45}]}," +
      "{\"name\":\"k\",\"tag\":\"item\",\"x\":4,\"y\":1,\"z\":0," +
        "\"behaviors\":[{\"type\":\"bob\",\"height\":0.4,\"speed\":1.5}]}," +
      "{\"name\":\"t\",\"tag\":\"prop\",\"x\":0,\"y\":1,\"z\":9," +
        "\"behaviors\":[{\"type\":\"shoot\",\"interval\":1.2,\"speed\":24,\"life\":2," +
                       "\"target\":\"player\",\"range\":30}]}]}");
    assert_eq_int(n, 4);
    assert_eq_int(behavior_count3d(), 5);
    str a = scene_json3d();
    scene_load3d(a);
    assert_eq_int(behavior_count3d(), 5);
    str b = scene_json3d();
    assert(a == b, "davranisli gidis-donus duragan olmali");
    // Değerler de korunmalı, yalnız sayı değil.
    int en = find3d("d");
    int i = 0;
    int found = 0;
    while (i < length(_bh3)) {
        Bh3 bh = _bh3[i];
        if (bh.id == en && bh.kind == BH_CHASE) {
            assert(abs_f3(bh.a - 6.0) < 0.001, "hiz");
            assert(abs_f3(bh.b - 40.0) < 0.001, "menzil");
            assert_eq_int(bh.tag, TAG_PLAYER);
            found = 1;
        }
        i = i + 1;
    }
    assert_eq_int(found, 1);
}

test("sahne varliklari yukluyor", "t_scene_loads_entities");
test("sahne dunyayi yukluyor", "t_scene_loads_world");
test("sahne gidis-donusu duragan", "t_scene_roundtrip_is_stable");
test("yorunge mesafesi gidis-donuste kalici", "t_scene_orbit_dist_survives_roundtrip");
test("sahne yuklemesi tam", "t_scene_load_is_total");
test("dunya varsayilanlari eksiksiz", "t_scene_world_defaults_are_total");
test("bozuk JSON sahneyi yikmiyor", "t_scene_bad_json_is_safe");
test("zemin yoklugu anlamli", "t_scene_ground_absence_means_no_ground");
test("eksik alanlar varsayilana dusuyor", "t_scene_optional_fields_default");
test("calisma zamani varliklari yazilmiyor", "t_scene_skips_runtime_entities");
test("sayi bicimi us gosterimi uretmiyor", "t_scene_number_format");
