// -- Geniş faz (broad phase) -------------------------------------------------
// Çarpışma artık her çift için _overlap3/_mtv3 zincirini çağırmıyor: önce
// kapsayan kürelere bakıp uzak çiftleri eliyor (ölçüm: 200 entity'de 15.4 ms →
// 1.12 ms). Bu optimizasyonun BOZULABİLECEĞİ tek yer elemenin fazla hevesli
// olması — o yüzden asıl değişmezi doğrudan test ediyoruz:
//
//     _bp_far3(a, b) == true  ⟹  _overlap3(a, b) == false
//
// Yani eleme yalnız "kesin çakışmıyor" diyebilir. Karışık şekil/boyut/yaw
// üzerinde TÜM çiftler taranıyor; kapsayan küre matematiği (köşegen yarısı)
// kutu, küre, silindir ve DÖNÜK kutu için ayrı ayrı burada sınanmış oluyor.
func t_broadphase_conservative() {
    scene3d_reset();
    // Bilerek yakın aralıklı, iç içe geçen, farklı şekil ve boyutlarda bir yığın
    int i = 0;
    while (i < 24) {
        float x = toFloat(mod(i * 5, 11)) - 5.0;
        float z = toFloat(mod(i * 3, 7)) - 3.0;
        float s = 0.5 + toFloat(mod(i, 4)) * 0.7;
        int shape = SHAPE_CUBE;
        if (mod(i, 3) == 1) { shape = SHAPE_SPHERE; }
        if (mod(i, 3) == 2) { shape = SHAPE_CYL; }
        int id = spawn3(x, 1.0 + toFloat(mod(i, 3)), z, s, s * 1.6, s,
                        RED, shape, TAG_ENEMY);
        // Her üçüncüsünü döndür: OBB/SAT yolu da elemenin altına girsin.
        if (mod(i, 3) == 0) { set3yaw(id, toFloat(i * 17)); }
        i = i + 1;
    }
    _bp_build3();
    int n = length(_e3);
    int violations = 0;
    int pairs = 0;
    int a = 0;
    while (a < n) {
        int b = 0;
        while (b < n) {
            if (a != b) {
                pairs = pairs + 1;
                if (_bp_far3(a, b) && _overlap3(a, b)) { violations = violations + 1; }
            }
            b = b + 1;
        }
        a = a + 1;
    }
    assert(pairs > 500, "anlamli sayida cift taranmali");
    assert_eq_int(violations, 0);   // eleme ASLA gercek cakismayi atmamali
}

// Eleme korumalı olsa da hiçbir şey elemiyorsa optimizasyon yoktur. Dağınık bir
// sahnede çiftlerin ezici çoğunluğu elenmeli — bu testin asıl işi, birinin
// _bp_far3'ü sessizce `false` döndürecek şekilde bozmasını yakalamak.
func t_broadphase_prunes() {
    scene3d_reset();
    int i = 0;
    while (i < 30) {
        spawn3(toFloat(mod(i * 7, 40)) - 20.0, 1.0, toFloat(mod(i * 13, 40)) - 20.0,
               1.0, 2.0, 1.0, GRAY, SHAPE_CUBE, TAG_WALL);
        i = i + 1;
    }
    _bp_build3();
    int n = length(_e3);
    int far = 0;
    int pairs = 0;
    int a = 0;
    while (a < n) {
        int b = a + 1;
        while (b < n) {
            pairs = pairs + 1;
            if (_bp_far3(a, b)) { far = far + 1; }
            b = b + 1;
        }
        a = a + 1;
    }
    assert(far * 10 > pairs * 8, "dagink sahnede ciftlerin %80+'i elenmeli");
}

// Ayırma çözümü entity'yi TARAMA SÜRERKEN oynatıyor. _apply_mtv3 geniş faz
// konumunu tazelemezse, itilmiş bir gövde aynı karedeki sonraki çiftlerde eski
// yerinden değerlendirilir ve gerçek bir çarpışma kaçar. Burada onu sabitliyoruz:
// itmeden sonra düz dizideki konum entity'nin gerçek konumuyla aynı olmalı.
func t_broadphase_sync_after_push() {
    scene3d_reset();
    int p = spawn3(0.0, 1.0, 0.0, 1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    _bp_build3();
    int s = _slot_of3(p);
    _apply_mtv3(s, 3.0, 0.0, 0.0 - 2.0);
    assert(abs_f3(_bx[s] - get3x(p)) < 0.0001, "itmeden sonra _bx tazelenmeli");
    assert(abs_f3(_bz[s] - get3z(p)) < 0.0001, "itmeden sonra _bz tazelenmeli");
    // set3pos (kanca icinden isinlanma) da senkron tutmali
    set3pos(p, 0.0 - 7.0, 1.0, 9.0);
    assert(abs_f3(_bx[s] - (0.0 - 7.0)) < 0.0001, "set3pos _bx'i tazelemeli");
    assert(abs_f3(_bz[s] - 9.0) < 0.0001, "set3pos _bz'yi tazelemeli");
}

// -- Menü / UI katmanı -------------------------------------------------------
// Durum makinesi pencereden bağımsız: menu3d/pause3d/restart3d saf durum
// değiştiriyor, çizim ayrı. O yüzden headless sürülebiliyor — düğmelerin
// GÖRÜNÜŞÜ ekran testinin işi, ama hangi durumun neye geçtiği burada sabitlenir.

func t_ui_default_is_play() {
    scene3d_reset();
    // menu3d() çağrılmayan sahne doğrudan oyuna girer — eski davranış korunuyor.
    assert_eq_bool(paused3d(), false);
    assert_eq_int(_s3_ui, UI_NONE);
}

func t_ui_title_opt_in() {
    scene3d_reset();
    menu3d("Test", "alt");
    assert_eq_int(_s3_ui, UI_TITLE);
    assert_eq_int(_s3_title_step(), 0);      // girdi yokken bekler
}

func t_ui_pause_resume() {
    scene3d_reset();
    pause3d();
    assert_eq_bool(paused3d(), true);
    resume3d();
    assert_eq_bool(paused3d(), false);
}

// Biten oyun duraklatılamaz: duraklat örtüsü oyun-bitti örtüsünü gizlerdi ve
// oyuncu "Tekrar Oyna"ya ulaşamazdı.
func t_ui_no_pause_when_over() {
    scene3d_reset();
    game_over3d();
    pause3d();
    assert_eq_bool(paused3d(), false);
}

// Bölüm kaydedilmiş sahnede yeniden başlamak EN KÜÇÜK bölüme döner ve
// skoru/oyun-bitti durumunu sıfırlar.
int _t_lvl_hits = 0;
func _t_lvl_a() { _t_lvl_hits = _t_lvl_hits + 1;
                  spawn3(0.0, 1.0, 0.0, 1.0, 1.0, 1.0, RED, SHAPE_CUBE, TAG_PLAYER); }
func _t_lvl_b() { spawn3(5.0, 1.0, 0.0, 1.0, 1.0, 1.0, RED, SHAPE_CUBE, TAG_ENEMY); }

func t_ui_restart_with_levels() {
    scene3d_reset();
    _t_lvl_hits = 0;
    level3d(1, _t_lvl_a);
    level3d(2, _t_lvl_b);
    goto_level3d(2);
    _s3_apply_level();
    score3d_add(500);
    game_over3d();

    restart3d();
    assert_eq_int(level_now3d(), 1);          // en kucuk bolume dondu
    assert_eq_int(score3d(), 0);              // skor sifirlandi
    assert_eq_bool(is_over3d(), false);       // oyun-bitti temizlendi
    assert_eq_int(_t_lvl_hits, 1);            // 1. bolum kurulum fn'i kostu
}

// Bölümsüz sahnede motor `setup`u tek başına tekrarlayamaz (setup kancaları da
// kaydediyor, ikinci çalıştırma onları çoğaltırdı) — o boşluğu on_restart3d
// dolduruyor. Kanca çağrılmalı ve entity store temizlenmiş olmalı.
int _t_re_hits = 0;
func _t_re_build() { _t_re_hits = _t_re_hits + 1;
                     spawn3(0.0, 1.0, 0.0, 1.0, 1.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER); }

func t_ui_restart_hook_without_levels() {
    scene3d_reset();
    _t_re_hits = 0;
    on_restart3d(_t_re_build);
    spawn3(0.0, 1.0, 0.0, 1.0, 1.0, 1.0, RED, SHAPE_CUBE, TAG_ENEMY);
    spawn3(2.0, 1.0, 0.0, 1.0, 1.0, 1.0, RED, SHAPE_CUBE, TAG_ENEMY);
    score3d_add(70);
    game_over3d();

    restart3d();
    assert_eq_int(_t_re_hits, 1);
    assert_eq_int(alive_count3d(), 1);        // eski entity'ler gitti, kanca 1 tane kurdu
    assert_eq_int(score3d(), 0);
    assert_eq_bool(is_over3d(), false);
}

// Kanca da bölüm de yoksa restart yalnız skoru/durumu sıfırlar ve sahneye
// dokunmaz. Belgelenmiş sınır; sessizce entity silmemeli.
func t_ui_restart_bare() {
    scene3d_reset();
    spawn3(0.0, 1.0, 0.0, 1.0, 1.0, 1.0, RED, SHAPE_CUBE, TAG_ENEMY);
    score3d_add(30);
    game_over3d();

    restart3d();
    assert_eq_int(score3d(), 0);
    assert_eq_bool(is_over3d(), false);
    assert_eq_int(alive_count3d(), 1);        // sahne yerinde
}

func t_ui_quit_flag() {
    scene3d_reset();
    assert_eq_int(_s3_quit, 0);
    quit3d();
    assert_eq_int(_s3_quit, 1);
    scene3d_reset();
    assert_eq_int(_s3_quit, 0);               // reset cikis istegini de temizler
}

// Düğme isabet testi: merkez içeride, kenarların dışı dışarıda olmalı.
func t_ui_button_hit() {
    scene3d_reset();
    float bx = _s3_btn_x(); float by = _s3_btn_y(0);
    float bw = _s3_btn_w(); float bh = _s3_btn_h();
    assert_eq_bool(_s3_btn_hit(0, bx + bw * 0.5, by + bh * 0.5), true);
    assert_eq_bool(_s3_btn_hit(0, bx - 5.0, by + bh * 0.5), false);
    assert_eq_bool(_s3_btn_hit(0, bx + bw * 0.5, by - 5.0), false);
    // Düğmeler üst üste binmemeli, yoksa tek dokunuş ikisini birden tetikler.
    assert_eq_bool(_s3_btn_hit(1, bx + bw * 0.5, by + bh * 0.5), false);
}

// -- Arazi eğimi: normal, sınır, kayma ---------------------------------------
// Normal MEVCUT örnekleyiciden merkezi farkla türetiliyor (ayrı C binding'i
// yok), o yüzden burada sınanan şey doğrudan o türetmenin doğruluğu.

func t_terrain_normal_flat() {
    scene3d_reset();
    zemin3(0.0);
    // Arazi YOKKEN normal her yerde yukarı olmalı; eğim mantığı düz zemini
    // yanlışlıkla "dik" saymamalı.
    assert(terrain_up3d(0.0, 0.0) > 0.999, "arazi yokken duzluk 1.0");
    slope_limit3d(45.0);
    assert_eq_bool(terrain_steep3d(0.0, 0.0), false);
}

// Gerçek arazide: tepe eteği yamacı, tepe/çukur dibi düz olmalı. Tüm ayak izini
// tarayıp en dik ve en düz noktaları buluyoruz — hangi tohumun nerede tepe
// yaptığına bağlanmadan.
func t_terrain_normal_slope() {
    scene3d_reset();
    zemin3(0.0);
    arazi3d(65, 80.0, 22.0, 80.0, 3.0, 20260806);

    float min_up = 2.0;
    float max_up = 0.0;
    int i = 0;
    while (i < 40) {
        int j = 0;
        while (j < 40) {
            float x = 0.0 - 38.0 + i * 1.9;
            float z = 0.0 - 38.0 + j * 1.9;
            float u = terrain_up3d(x, z);
            if (u < min_up) { min_up = u; }
            if (u > max_up) { max_up = u; }
            j = j + 1;
        }
        i = i + 1;
    }
    // Normal birim vektör: Y bileşeni 0..1 aralığında kalmalı.
    assert(min_up >= 0.0 && max_up <= 1.0001, "normal birim olmali");
    // Tepeli arazide hem yamaç hem duze yakin nokta bulunmali.
    assert(min_up < 0.98, "yamac bulunmali (en dik nokta duz degil)");
    assert(max_up > 0.995, "duze yakin nokta bulunmali");
}

// Sınır KAPALI (varsayılan) iken eski davranış: dik yamaçta bile kayma yok.
func t_slope_limit_off_by_default() {
    scene3d_reset();
    zemin3(0.0);
    arazi3d(65, 80.0, 26.0, 80.0, 2.2, 7);
    int p = spawn3(6.0, 40.0, 6.0, 1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    int s = _slot_of3(p);
    int k = 0;
    while (k < 200) { _s3_physics(0.016667); k = k + 1; }   // zemine in
    Ent3 e0 = _e3[s];
    assert_eq_int(e0.grounded, 1);
    float vx0 = e0.vx; float vz0 = e0.vz;
    k = 0;
    while (k < 60) { _s3_physics(0.016667); k = k + 1; }
    Ent3 e1 = _e3[s];
    assert(abs_f3(e1.vx - vx0) < 0.0001, "sinir kapaliyken yatay hiz degismez");
    assert(abs_f3(e1.vz - vz0) < 0.0001, "sinir kapaliyken yatay hiz degismez");
}

// Sınır AÇIKKEN dik yamaçta duran entity aşağı kaymalı — ve YÖNÜ yamaç aşağı
// olmalı. "Hız oluştu" demek yetmez: ters yöne kaysa da hız oluşurdu.
//
// İlk yazdığım hâli "bitiş zemini başlangıçtan alçak" diye ölçüyordu ve kayma
// yönünü TERSİNE çevirince bile geçiyordu: entity yamaç yukarı kayıp arazinin
// AYAK İZİNDEN çıkıyor, dışarıda yükseklik taban 0'a dönüyor ve "alçaldı"
// sanılıyordu. O yüzden burada yön DOĞRUDAN ölçülüyor — hareket vektörünün
// yamaç-aşağı yönüyle iç çarpımı pozitif olmalı — ve entity'nin ayak izinde
// kaldığı ayrıca sabitleniyor.
func t_slope_slide_downhill() {
    scene3d_reset();
    zemin3(0.0);
    arazi3d(65, 80.0, 30.0, 80.0, 2.0, 99);
    slope_limit3d(25.0);      // bilerek dusuk: arazinin cogu "dik" sayilsin

    // En dik noktayı bul — kenardan UZAK dur ki kayma ayak izinden çıkmasın.
    float bx = 0.0; float bz = 0.0; float worst = 2.0;
    int i = 0;
    while (i < 24) {
        int j = 0;
        while (j < 24) {
            float x = 0.0 - 23.0 + i * 2.0;
            float z = 0.0 - 23.0 + j * 2.0;
            float u = terrain_up3d(x, z);
            if (u < worst) { worst = u; bx = x; bz = z; }
            j = j + 1;
        }
        i = i + 1;
    }
    assert(worst < _slope_cos3, "test icin yeterince dik bir nokta bulunmali");

    int p = spawn3(bx, arazi_yukseklik3d(bx, bz) + 1.0, bz,
                   1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    int s = _slot_of3(p);
    int k = 0;
    while (k < 30) { _s3_physics(0.016667); k = k + 1; }   // otur

    float x0 = get3x(p); float z0 = get3z(p);
    float h0 = arazi_yukseklik3d(x0, z0);
    // Bu noktadaki yamaç-aşağı yönü: normalin yatay bileşeni.
    _terrain_normal3(x0, z0);
    float ndx = _tn_x; float ndz = _tn_z;
    float nl = sqrt(ndx * ndx + ndz * ndz);
    assert(nl > 0.0001, "yamacta yatay normal bileseni olmali");
    ndx = ndx / nl; ndz = ndz / nl;

    k = 0;
    while (k < 45) { _s3_physics(0.016667); k = k + 1; }

    float x1 = get3x(p); float z1 = get3z(p);
    float mvx = x1 - x0; float mvz = z1 - z0;
    Ent3 e = _e3[s];
    assert(abs_f3(e.vx) + abs_f3(e.vz) > 0.5, "dik yamacta kayma hizi olusmali");
    // ASIL SART: hareket yamac-asagi yonuyle ayni tarafta olmali.
    assert(mvx * ndx + mvz * ndz > 0.1, "kayma YAMAC ASAGI yonunde olmali");
    // Ayak izinde kalmali, yoksa yukseklik karsilastirmasi anlamsizlasir.
    assert(abs_f3(x1) < 39.0 && abs_f3(z1) < 39.0, "arazi ayak izinde kalmali");
    assert(arazi_yukseklik3d(x1, z1) < h0, "zemin gercekten alcalmali");
}

// Düz zeminde sınır açık olsa bile kayma olmamalı.
func t_slope_no_slide_on_flat() {
    scene3d_reset();
    zemin3(0.0);
    slope_limit3d(25.0);
    int p = spawn3(0.0, 5.0, 0.0, 1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    int s = _slot_of3(p);
    int k = 0;
    while (k < 200) { _s3_physics(0.016667); k = k + 1; }
    Ent3 e = _e3[s];
    assert(abs_f3(e.vx) < 0.0001 && abs_f3(e.vz) < 0.0001, "duz zeminde kayma yok");
}

// -- Kamera ışını araziyi görüyor --------------------------------------------
// Eskiden yalnız TAG_WALL kutuları taranıyordu; arazi bir kutu olmadığı için
// kamera tepenin içine girebiliyordu.
func t_camera_ray_sees_terrain() {
    scene3d_reset();
    zemin3(0.0);
    arazi3d(65, 80.0, 30.0, 80.0, 2.0, 4242);

    // Tepe noktasını bul; ışını onun İÇİNDEN geçir.
    float hx = 0.0; float hz = 0.0; float hbest = 0.0 - 10000.0;
    int i = 0;
    while (i < 30) {
        int j = 0;
        while (j < 30) {
            float x = 0.0 - 30.0 + i * 2.0;
            float z = 0.0 - 30.0 + j * 2.0;
            float h = arazi_yukseklik3d(x, z);
            if (h > hbest) { hbest = h; hx = x; hz = z; }
            j = j + 1;
        }
        i = i + 1;
    }
    assert(hbest > 2.0, "test icin belirgin bir tepe bulunmali");

    // Tepenin bir yanından öbür yanına, tepe seviyesinin ALTINDAN geçen ışın:
    // araziye çarpmalı, yani t < 1.0 dönmeli.
    float y = hbest * 0.4;
    float ox = hx - 14.0;
    float dx = 28.0;
    float t = _cam_clear_t3(ox, y, hz, dx, 0.0, 0.0);
    assert(t < 1.0, "tepenin icinden gecen isin engellenmeli");

    // Tepenin ÇOK üstünden geçen ışın serbest kalmalı (yanlış pozitif olmasın).
    float t2 = _cam_clear_t3(ox, hbest + 25.0, hz, dx, 0.0, 0.0);
    assert(t2 > 0.999, "tepenin ustunden gecen isin serbest olmali");
}

// -- Düşman yol bulma (engelden kaçınma) -------------------------------------

func t_path_clear_basic() {
    scene3d_reset();
    zemin3(0.0);
    spawn3(0.0, 1.0, 5.0, 8.0, 4.0, 1.0, GRAY, SHAPE_CUBE, TAG_WALL);
    // Duvara dogru: kapali. Duvarin yanindan: acik.
    assert_eq_bool(_path_clear3(0.0, 1.0, 0.0, 0.0, 1.0, 8.0), false);
    assert_eq_bool(_path_clear3(0.0, 1.0, 0.0, 1.0, 0.0, 8.0), true);
    // Duvardan KISA kalan bir bakis mesafesi engeli gormemeli.
    assert_eq_bool(_path_clear3(0.0, 1.0, 0.0, 0.0, 1.0, 2.0), true);
    // Kati olmayan duvar engel sayilmamali.
    scene3d_reset();
    zemin3(0.0);
    int w = spawn3(0.0, 1.0, 5.0, 8.0, 4.0, 1.0, GRAY, SHAPE_CUBE, TAG_WALL);
    solid3d(w, false);
    assert_eq_bool(_path_clear3(0.0, 1.0, 0.0, 0.0, 1.0, 8.0), true);
}

// Önü açıkken kaçınma DEVREYE GİRMEMELİ: hız doğrudan hedefe bakmalı.
func t_chase_direct_when_clear() {
    scene3d_reset();
    zemin3(0.0);
    int p = spawn3(0.0, 1.0, 10.0, 1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    int en = spawn3(0.0, 1.0, 0.0, 1.0, 2.0, 1.0, RED, SHAPE_CUBE, TAG_ENEMY);
    chase3d(en, p, 6.0);
    int s = _slot_of3(en);
    Ent3 e = _e3[s];
    assert(abs_f3(e.vx) < 0.001, "acik yolda yana sapma olmamali");
    assert(e.vz > 5.9, "acik yolda tam hizla hedefe gitmeli");
}

// Arada duvar varken kaçınma yana sapmalı — ve sapma HEDEFE DOĞRU ilerlemeyi
// tamamen bırakmamalı (geri dönmemeli).
func t_chase_avoids_wall() {
    scene3d_reset();
    zemin3(0.0);
    int p = spawn3(0.0, 1.0, 10.0, 1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    int en = spawn3(0.0, 1.0, 0.0, 1.0, 2.0, 1.0, RED, SHAPE_CUBE, TAG_ENEMY);
    spawn3(0.0, 1.0, 4.0, 6.0, 4.0, 1.0, GRAY, SHAPE_CUBE, TAG_WALL);

    chase3d(en, p, 6.0);
    Ent3 e = _e3[_slot_of3(en)];
    assert(abs_f3(e.vx) > 0.5, "duvar varken yana sapmali");
    assert(e.vz > 0.0, "sapma hedeften GERI donmemeli");
}

// chase_direct3d() eski (düz çizgi) davranışı geri vermeli.
func t_chase_direct_opt_out() {
    scene3d_reset();
    zemin3(0.0);
    chase_direct3d();
    int p = spawn3(0.0, 1.0, 10.0, 1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    int en = spawn3(0.0, 1.0, 0.0, 1.0, 2.0, 1.0, RED, SHAPE_CUBE, TAG_ENEMY);
    spawn3(0.0, 1.0, 4.0, 6.0, 4.0, 1.0, GRAY, SHAPE_CUBE, TAG_WALL);
    chase3d(en, p, 6.0);
    Ent3 e = _e3[_slot_of3(en)];
    assert(abs_f3(e.vx) < 0.001, "kacinma kapaliyken duz gitmeli");
}

// ASIL DAVRANIŞ TESTİ: duvarın arkasındaki oyuncuyu kovalayan düşman,
// çarpışma çözümüyle birlikte simüle edildiğinde duvarı GEÇMELİ (etrafından
// dolaşmalı) — düz çizgi sürümünde duvara yaslanıp orada kalıyordu.
func t_chase_gets_around_wall() {
    scene3d_reset();
    zemin3(0.0);
    yercekimi3(26.0);
    int p  = spawn3(0.0, 1.0, 12.0, 1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    int en = spawn3(0.0, 1.0, 0.0,  1.0, 2.0, 1.0, RED, SHAPE_CUBE, TAG_ENEMY);
    // Aradaki duvar: genis ama SONSUZ degil, etrafindan dolasilabilir.
    spawn3(0.0, 1.5, 6.0, 10.0, 3.0, 1.0, GRAY, SHAPE_CUBE, TAG_WALL);

    int k = 0;
    while (k < 400) {
        chase3d(en, p, 7.0);
        _s3_physics(0.016667);
        _s3_collision();
        k = k + 1;
    }
    float ez = get3z(en);
    // Duvar z=6'da (yarim kalinlik 0.5). Dusman onu GECMIS olmali.
    assert(ez > 6.5, "dusman duvarin arkasina gecmeli (dolasarak)");
}

// -- Kalıcılık: rekor + bölüm ilerlemesi -------------------------------------
// Kalıcılık OPT-IN çünkü diske yazıyor. Testler gerçek dosya yazıp okuyor
// (save_data/load_data), o yüzden her test kendi benzersiz başlığını kullanıyor
// — aynı anahtarı paylaşan testler birbirinin kaydını görürdü.

func t_save_off_by_default() {
    scene3d_reset();
    sahne3d(320, 200, "t3d_off");
    score3d_add(500);
    game_over3d();
    // Kapaliyken rekor BELLEKTE tutulur ama diske yazilmaz.
    assert_eq_int(best_score3d(), 500);
    assert_eq_bool(new_record3d(), true);
    assert_eq_str(load_data("scene3d_best_t3d_off.txt"), "");
}

func t_save_record_roundtrip() {
    scene3d_reset();
    sahne3d(320, 200, "t3d_rec");
    save_data("scene3d_best_t3d_rec.txt", "");   // temiz baslangic
    save_progress3d();
    assert_eq_int(best_score3d(), 0);

    score3d_add(120);
    game_over3d();
    assert_eq_int(best_score3d(), 120);
    assert_eq_bool(new_record3d(), true);

    // Yeni oturum: ayni baslikla acilinca rekor GERI YUKLENMELI.
    scene3d_reset();
    sahne3d(320, 200, "t3d_rec");
    save_progress3d();
    assert_eq_int(best_score3d(), 120);
    assert_eq_bool(new_record3d(), false);   // rozet yeni ele ait, sifirlanmali

    // Daha DUSUK skor rekoru ezmemeli.
    score3d_add(50);
    game_over3d();
    assert_eq_int(best_score3d(), 120);
    assert_eq_bool(new_record3d(), false);

    // Daha yuksek skor gecmeli.
    restart3d();
    score3d_add(300);
    game_over3d();
    assert_eq_int(best_score3d(), 300);
    assert_eq_bool(new_record3d(), true);
    assert_eq_str(load_data("scene3d_best_t3d_rec.txt"), "300");
}

// İki farklı sahne birbirinin rekorunu ezmemeli (anahtar başlıktan türüyor).
func t_save_key_per_title() {
    scene3d_reset();
    sahne3d(320, 200, "t3d_a");
    save_data("scene3d_best_t3d_a.txt", "");
    save_data("scene3d_best_t3d_b.txt", "");
    save_progress3d();
    score3d_add(70); game_over3d();

    scene3d_reset();
    sahne3d(320, 200, "t3d_b");
    save_progress3d();
    assert_eq_int(best_score3d(), 0);        // b, a'nin rekorunu GORMEMELI
    score3d_add(11); game_over3d();

    scene3d_reset();
    sahne3d(320, 200, "t3d_a");
    save_progress3d();
    assert_eq_int(best_score3d(), 70);       // a kendi rekorunu korumus
}

int _t_p1_hits = 0;
func _t_p1() { _t_p1_hits = _t_p1_hits + 1; }
func _t_p2() { }
func _t_p3() { }

func t_save_level_progress() {
    scene3d_reset();
    sahne3d(320, 200, "t3d_lvl");
    int k = 1;
    while (k <= 3) { save_data("scene3d_lvl_t3d_lvl_" + toString(k) + ".txt", ""); k = k + 1; }
    level3d(1, _t_p1); level3d(2, _t_p2); level3d(3, _t_p3);
    save_progress3d();

    assert_eq_int(unlocked_level3d(), 1);     // hicbiri bitmemis
    assert_eq_bool(level_done3d(1), false);

    goto_level3d(1); _s3_apply_level();
    next_level3d();                            // 1. bolum TEMIZLENDI
    assert_eq_bool(level_done3d(1), true);
    assert_eq_int(unlocked_level3d(), 2);
    _s3_apply_level();
    next_level3d();                            // 2. bolum TEMIZLENDI
    assert_eq_int(unlocked_level3d(), 3);

    // Yeni oturum: ilerleme diskten geri gelmeli.
    scene3d_reset();
    sahne3d(320, 200, "t3d_lvl");
    level3d(1, _t_p1); level3d(2, _t_p2); level3d(3, _t_p3);
    save_progress3d();
    assert_eq_bool(level_done3d(1), true);
    assert_eq_bool(level_done3d(2), true);
    assert_eq_bool(level_done3d(3), false);
    assert_eq_int(unlocked_level3d(), 3);
}

// goto_level3d SERBEST ATLAMA: atlanan bölümü "bitti" saymamalı, yoksa
// oyuncu hiç görmediği bölümü geçmiş olurdu.
func t_save_goto_does_not_mark() {
    scene3d_reset();
    sahne3d(320, 200, "t3d_skip");
    int k = 1;
    while (k <= 3) { save_data("scene3d_lvl_t3d_skip_" + toString(k) + ".txt", ""); k = k + 1; }
    level3d(1, _t_p2); level3d(2, _t_p2); level3d(3, _t_p2);
    save_progress3d();
    // ÖNCE gerçekten 1. bölümde ol — yoksa _cur_lvl3 = 0 kalır ve işaretleme
    // zaten erken döner, yani test hiçbir şey sınamamış olur. (İlk hâli tam
    // bu yüzden zayıftı: goto'yu "bitti" saydıran bir bozma testi geçiyordu.)
    goto_level3d(1); _s3_apply_level();
    assert_eq_int(level_now3d(), 1);

    goto_level3d(3); _s3_apply_level();       // SERBEST ATLAMA
    assert_eq_int(level_now3d(), 3);
    assert_eq_bool(level_done3d(1), false);   // atlanan bolum bitmis SAYILMAZ
    assert_eq_bool(level_done3d(2), false);
    assert_eq_int(unlocked_level3d(), 1);
}

// unlocked_level3d KESİNTİSİZ olmalı: 3 bitmiş ama 2 bitmemişse cevap 2.
func t_save_unlock_is_contiguous() {
    scene3d_reset();
    sahne3d(320, 200, "t3d_gap");
    level3d(1, _t_p2); level3d(2, _t_p2); level3d(3, _t_p2);
    save_progress3d();
    _s3_mark_level_done(1);
    _s3_mark_level_done(3);
    assert_eq_bool(level_done3d(3), true);
    assert_eq_int(unlocked_level3d(), 2);    // bosluk atlanmaz
}

// reset BELLEĞİ sıfırlar, DİSKİ değil: "sahneyi baştan kur" ≠ "rekoru sil".
func t_save_reset_keeps_disk() {
    scene3d_reset();
    sahne3d(320, 200, "t3d_keep");
    save_data("scene3d_best_t3d_keep.txt", "");
    save_progress3d();
    score3d_add(250); game_over3d();

    scene3d_reset();
    assert_eq_int(best_score3d(), 0);         // bellek temiz
    assert_eq_str(load_data("scene3d_best_t3d_keep.txt"), "250");   // disk duruyor
}

// Tek atım TARAMA ORTASINDA kapanıyor: A zaten içerideyken B'nin girişi bölgeyi
// kapatır. A bu karede yeni kümeye çoktan yazılmıştır; kapalı bölge için çıkış
// bastırılmazsa sonraki kare A'ya SAHTE bir çıkış atar. (Bu senaryo tek gövdeyle
// hiç görünmüyor — `t_trigger_once` bunu yakalayamıyordu.)
func t_trigger_once_no_phantom_exit() {
    scene3d_reset(); _tz_zero();
    spawn3(0.0, 1.0, 0.0,  1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    int b = spawn3(40.0, 1.0, 0.0,  1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    int z = trigger3d(0.0, 1.0, 0.0,  6.0, 6.0, 6.0, TAG_PLAYER);
    on_enter3d(z, _tz_cb_in);
    on_exit3d(z, _tz_cb_out);
    _s3_triggers();                 // A girdi; uyelik {A}
    trigger_once3d(z, true);        // bundan sonrasi tek atim
    set3pos(b, 1.5, 1.0, 0.0);
    _s3_triggers();                 // B'nin girisi bolgeyi KAPATIR
    _s3_triggers(); _s3_triggers();
    assert_eq_int(_tz_out, 0);
}

// Şifa: hpmax'ı aşmaz ve dokunulmazlık penceresine YAZMAZ. İkincisi asıl
// mesele — `damage3d(id, -n)` ile şifa vermek oyuncuyu bir de hasara bağışık
// yapardı, o yüzden ayrı bir yol var.
func t_heal_caps_and_keeps_vulnerable() {
    scene3d_reset();
    int p = spawn3(0.0, 1.0, 0.0,  1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    health3d(p, 100);
    damage3d(p, 60);
    assert_eq_int(hp3d(p), 40);
    Ent3 e0 = _e3[_slot_of3(p)];
    e0.invuln = 0.0; _e3[_slot_of3(p)] = e0;    // hasarın açtığı pencereyi kapat
    heal3d(p, 25);
    assert_eq_int(hp3d(p), 65);
    heal3d(p, 500);
    assert_eq_int(hp3d(p), 100);                // hpmax asilmaz
    Ent3 e1 = _e3[_slot_of3(p)];
    assert(e1.invuln <= 0.0, "sifa dokunulmazlik penceresi ACMAMALI");
    damage3d(p, 10);
    assert_eq_int(hp3d(p), 90);                 // sifadan hemen sonra vurulabilir
}

// ===========================================================================
// Tetikleyici bölge
// ===========================================================================
int _tz_in = 0;
int _tz_out = 0;
int _tz_stay = 0;
int _tz_who = 0 - 1;
int _tz_id = 0 - 1;

func _tz_zero() { _tz_in = 0; _tz_out = 0; _tz_stay = 0; _tz_who = 0 - 1; _tz_id = 0 - 1; }
func _tz_cb_in()   { _tz_in = _tz_in + 1; _tz_who = me3d(); _tz_id = trigger_id3d(); }
func _tz_cb_out()  { _tz_out = _tz_out + 1; }
func _tz_cb_stay() { _tz_stay = _tz_stay + 1; }

// Bu katmanın VAR OLMA SEBEBİ: giriş BİR KEZ atmalı. `carpisinca3` ile taklit
// edildiğinde kanca her karede çağrılıyordu — testin ölçtüğü tam bu fark.
func t_trigger_enter_fires_once() {
    scene3d_reset(); _tz_zero();
    int p = spawn3(0.0, 1.0, 0.0,  1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    int z = trigger3d(0.0, 1.0, 0.0,  4.0, 4.0, 4.0, TAG_PLAYER);
    on_enter3d(z, _tz_cb_in);
    _s3_triggers(); _s3_triggers(); _s3_triggers();
    assert_eq_int(_tz_in, 1);
    assert_eq_int(inside3d(z), 1);
    assert_eq_int(_tz_who, p);      // kanca içinde ben3() giren entity
    assert_eq_int(_tz_id, z);       // ...bolge_no3d() de bölgeyi söyler
}

// Sürekli davranış isteyen `icindeyken` kullanır: eski taklidin davranışı,
// artık ayrı bir kanca olarak.
func t_trigger_stay_every_frame() {
    scene3d_reset(); _tz_zero();
    spawn3(0.0, 1.0, 0.0,  1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    int z = trigger3d(0.0, 1.0, 0.0,  4.0, 4.0, 4.0, TAG_PLAYER);
    on_enter3d(z, _tz_cb_in);
    on_stay3d(z, _tz_cb_stay);
    _s3_triggers(); _s3_triggers(); _s3_triggers();
    assert_eq_int(_tz_in, 1);       // giriş yine tek
    assert_eq_int(_tz_stay, 2);     // ilk kare giriş, kalan iki kare "içinde"
}

func t_trigger_exit_and_reenter() {
    scene3d_reset(); _tz_zero();
    int p = spawn3(0.0, 1.0, 0.0,  1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    int z = trigger3d(0.0, 1.0, 0.0,  4.0, 4.0, 4.0, TAG_PLAYER);
    on_enter3d(z, _tz_cb_in);
    on_exit3d(z, _tz_cb_out);
    _s3_triggers();
    assert_eq_int(_tz_in, 1); assert_eq_int(_tz_out, 0);
    set3pos(p, 30.0, 1.0, 0.0); _s3_triggers();
    assert_eq_int(_tz_out, 1);
    assert_eq_int(inside3d(z), 0);
    set3pos(p, 0.0, 1.0, 0.0); _s3_triggers();
    assert_eq_int(_tz_in, 2);       // yeniden girmek yeniden tetikler
    assert_eq_int(_tz_out, 1);
}

// Tek atım: kontrol noktası / bir kere anlatılan mesaj.
func t_trigger_once() {
    scene3d_reset(); _tz_zero();
    int p = spawn3(0.0, 1.0, 0.0,  1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    int z = trigger3d(0.0, 1.0, 0.0,  4.0, 4.0, 4.0, TAG_PLAYER);
    on_enter3d(z, _tz_cb_in);
    on_exit3d(z, _tz_cb_out);
    trigger_once3d(z, true);
    _s3_triggers();
    assert_eq_int(_tz_in, 1);
    set3pos(p, 30.0, 1.0, 0.0); _s3_triggers();
    set3pos(p, 0.0, 1.0, 0.0);  _s3_triggers(); _s3_triggers();
    assert_eq_int(_tz_in, 1);       // ikinci giriş YOK
    assert_eq_int(_tz_out, 0);      // kapandığı için çıkış da atmaz
}

// "Tek atım" TEK demek: bölgede aynı anda iki entity varsa bile giriş bir kez
// atar. Kapanan bölge geride üyelik de bırakmaz, yoksa ikinci entity için
// sahte bir ÇIKIŞ üretirdi.
func t_trigger_once_with_two_bodies() {
    scene3d_reset(); _tz_zero();
    spawn3(0.0, 1.0, 0.0,       1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    spawn3(1.0, 1.0, 1.0,       1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    int z = trigger3d(0.0, 1.0, 0.0,  6.0, 6.0, 6.0, TAG_PLAYER);
    on_enter3d(z, _tz_cb_in);
    on_exit3d(z, _tz_cb_out);
    trigger_once3d(z, true);
    _s3_triggers(); _s3_triggers();
    assert_eq_int(_tz_in, 1);
    assert_eq_int(_tz_out, 0);
    assert_eq_int(inside3d(z), 0);
}

// Etiket süzgeci: bölge yalnız izlediği etiketi görür.
func t_trigger_tag_filter() {
    scene3d_reset(); _tz_zero();
    spawn3(0.0, 1.0, 0.0,  1.0, 2.0, 1.0, rgb(230, 80, 80), SHAPE_CUBE, TAG_ENEMY);
    int z = trigger3d(0.0, 1.0, 0.0,  4.0, 4.0, 4.0, TAG_PLAYER);
    on_enter3d(z, _tz_cb_in);
    _s3_triggers(); _s3_triggers();
    assert_eq_int(_tz_in, 0);
    assert_eq_int(inside3d(z), 0);
}

// Küre bölge mesafeyle çalışır ve GÖVDE değdiğinde girer (merkez değil):
// yarıçap 3.0, entity yarı-genişliği 0.5 → sınır x = 3.5 civarı.
func t_trigger_sphere_zone() {
    scene3d_reset(); _tz_zero();
    int p = spawn3(0.0, 1.0, 0.0,  1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    int z = trigger_sphere3d(0.0, 1.0, 0.0,  3.0, TAG_PLAYER);
    on_enter3d(z, _tz_cb_in);
    on_exit3d(z, _tz_cb_out);
    _s3_triggers();
    assert_eq_int(_tz_in, 1);
    set3pos(p, 3.4, 1.0, 0.0); _s3_triggers();     // gövde hâlâ değiyor (2.9 < 3.0)
    assert_eq_int(_tz_out, 0);
    set3pos(p, 3.6, 1.0, 0.0); _s3_triggers();     // 3.1 > 3.0 → çıktı
    assert_eq_int(_tz_out, 1);
}

func t_trigger_inside_counts() {
    scene3d_reset(); _tz_zero();
    spawn3(0.0, 1.0, 0.0,  1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_ENEMY);
    spawn3(1.0, 1.0, 1.0,  1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_ENEMY);
    spawn3(30.0, 1.0, 0.0, 1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_ENEMY);
    int z = trigger3d(0.0, 1.0, 0.0,  6.0, 6.0, 6.0, TAG_ENEMY);
    on_enter3d(z, _tz_cb_in);
    _s3_triggers();
    assert_eq_int(inside3d(z), 2);
    assert_eq_int(_tz_in, 2);       // iki ayrı entity → iki giriş
}

// Kapatmak üyeliği de düşürür ve ÇIKIŞ ATMAZ: kapalı bölge olay üretmez.
func t_trigger_disable_is_silent() {
    scene3d_reset(); _tz_zero();
    spawn3(0.0, 1.0, 0.0,  1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    int z = trigger3d(0.0, 1.0, 0.0,  4.0, 4.0, 4.0, TAG_PLAYER);
    on_enter3d(z, _tz_cb_in);
    on_exit3d(z, _tz_cb_out);
    _s3_triggers();
    assert_eq_int(_tz_in, 1);
    trigger_on3d(z, false);
    _s3_triggers(); _s3_triggers();
    assert_eq_int(_tz_out, 0);
    assert_eq_int(inside3d(z), 0);
    trigger_on3d(z, true);          // yeniden açılınca yeniden girer
    _s3_triggers();
    assert_eq_int(_tz_in, 2);
}

// İçeride ÖLEN entity için çıkış atılmaz: handle zaten geçersiz, kanca onunla
// hiçbir şey yapamazdı. Üyelik yine de temizlenmeli (yoksa inside3d şişerdi).
func t_trigger_death_inside_no_exit() {
    scene3d_reset(); _tz_zero();
    int p = spawn3(0.0, 1.0, 0.0,  1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    int z = trigger3d(0.0, 1.0, 0.0,  4.0, 4.0, 4.0, TAG_PLAYER);
    on_enter3d(z, _tz_cb_in);
    on_exit3d(z, _tz_cb_out);
    _s3_triggers();
    assert_eq_int(inside3d(z), 1);
    kill3d(p);
    _s3_triggers();
    assert_eq_int(_tz_out, 0);
    assert_eq_int(inside3d(z), 0);
}

// Bölge taşınabilir (asansör güvertesi / hareketli tuzak): duran entity'ye
// bölgeyi getirmek de giriştir.
func t_trigger_move_zone() {
    scene3d_reset(); _tz_zero();
    spawn3(0.0, 1.0, 0.0,  1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    int z = trigger3d(20.0, 1.0, 0.0,  4.0, 4.0, 4.0, TAG_PLAYER);
    on_enter3d(z, _tz_cb_in);
    _s3_triggers();
    assert_eq_int(_tz_in, 0);
    trigger_move3d(z, 0.0, 1.0, 0.0);
    _s3_triggers();
    assert_eq_int(_tz_in, 1);
}

// Bölge ENTITY DEĞİL: entity sayısına girmez ve katı gövde çözümünde yok —
// içinden geçilir. (Taklit edilen hâlinde bunların ikisi de doğru değildi.)
func t_trigger_is_not_an_entity() {
    scene3d_reset();
    int p = spawn3(0.0, 1.0, 0.0 - 6.0,  1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    trigger3d(0.0, 1.0, 0.0,  4.0, 4.0, 4.0, TAG_PLAYER);
    assert_eq_int(alive_count3d(), 1);
    set3vel(p, 0.0, 0.0, 12.0);
    int steps = 0;
    while (steps < 60) { _s3_physics(0.016667); _s3_collision(); steps = steps + 1; }
    assert(get3z(p) > 2.0, "bolge kati degil, icinden gecilmeli");
}

// Bölge YERLEŞTİRİLMİŞ geometridir: bölüm değişince entity'lerle birlikte
// gider. Kancalar (kural) ise bölümü aşar — ayrım bilerek.
func t_trigger_cleared_by_level_and_reset() {
    scene3d_reset(); _tz_zero();
    sahne3d(320, 200, "t3d_trg");
    level3d(1, _t_p2); level3d(2, _t_p2);
    trigger3d(0.0, 1.0, 0.0,  4.0, 4.0, 4.0, TAG_PLAYER);
    assert_eq_int(trigger_count3d(), 1);
    goto_level3d(2); _s3_apply_level();
    assert_eq_int(trigger_count3d(), 0);

    trigger3d(0.0, 1.0, 0.0,  4.0, 4.0, 4.0, TAG_PLAYER);
    scene3d_reset();
    assert_eq_int(trigger_count3d(), 0);
}

