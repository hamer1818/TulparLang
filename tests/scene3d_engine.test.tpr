// Editörün ASIL döngüsü: yükle → düzenle → kaydet → yeniden yükle. Parçaların
// tek tek çalışması yetmez; bu testin sınadığı şey düzenlemenin diske gidip
// geri gelmesi. Editörün varlık sebebi bu.
func t_ed_edit_save_reload_roundtrip() {
    int n0 = scene_file3d("examples/scenes/toplayici.scene.json");
    assert(n0 > 0, "kaynak sahne yuklenmeli");
    ed_grid3d(0.5);

    // 1) Yeni bir duvar ekle, taşı, ölçekle, döndür.
    int w = ed_add3d(TAG_WALL, SHAPE_CUBE, 7.3, 2.2, 0.0 - 4.4);
    ed_resize3d(w, 6.0, 3.0, 1.0);
    ed_rotate3d(w, 25.0);
    // 2) Var olan bir varlığı sil.
    int kule = bul3d("kule");
    assert(kule >= 0, "kule bulunmali");
    ed_delete3d(kule);

    editor_dosya3d("/tmp/tulpar_scene_edit_test.json");
    assert(editor_kaydet3d(), "kaydedilmeli");

    int n1 = scene_file3d("/tmp/tulpar_scene_edit_test.json");
    // Bir eklendi, bir silindi → sayı aynı.
    assert_eq_int(n1, n0);
    assert_eq_int(bul3d("kule"), 0 - 1);

    // Eklenen duvar ızgaraya oturmuş ve ölçüleriyle geri gelmiş olmalı.
    int found = 0;
    int i = 0;
    while (i < length(_e3)) {
        Ent3 e = _e3[i];
        if (e.alive == 1 && e.tag == TAG_WALL && abs_f3(e.yaw - 25.0) < 0.001) {
            assert(abs_f3(e.x - 7.5) < 0.001, "x izgaraya oturmali: " + toString(e.x));
            assert(abs_f3(e.z + 4.5) < 0.001, "z izgaraya oturmali: " + toString(e.z));
            assert(abs_f3(e.sx - 6.0) < 0.001, "sx");
            assert(abs_f3(e.sy - 3.0) < 0.001, "sy");
            found = 1;
        }
        i = i + 1;
    }
    assert_eq_int(found, 1);
    // Kurallar ve davranışlar da gidip gelmeli — editör oyunu bozmamalı.
    assert_eq_int(rule_count3d(), 5);
    assert(behavior_count3d() > 0, "davranislar korunmali");
}

// Kayıt yolu kurulmadan kaydetmek SESSİZCE başarılı görünmemeli.
func t_ed_save_without_path_fails() {
    scene3d_reset();
    editor_dosya3d("");
    assert(editor_kaydet3d() == false, "yolsuz kayit basarisiz olmali");
}

// ===========================================================================
//  OYNAT / DUR ve GERİ AL — editörün yazarlık durumu
// ===========================================================================
// Bu testlerin sebebi gerçek bir veri kaybı: gönderilen sahne dosyası bir kez
// SİMÜLE EDİLMİŞ durumla üzerine yazıldı (kovalamış düşmanlar, dönmüş süsler,
// çoğaltılmış bir varlık). Editöre girmek oyunun ürettiği durumu atmıyordu,
// F5 de onu kalıcı yazıyordu. Unity/Unreal modeli: editör sahnenin sahibi,
// "Oynat" bir KOPYAYI koşturur, "Dur" kopyayı atar.

func t_ed_entering_editor_discards_simulation() {
    scene_file3d("examples/scenes/toplayici.scene.json");
    _ed_capture3();                       // yazarlık durumu (play3d bunu yapar)
    int en = 0 - 1;
    int i = 0;
    while (i < length(_e3)) {
        if (_e3[i].alive == 1 && _e3[i].tag == TAG_ENEMY && _e3[i].x < 0.0) { en = i; }
        i = i + 1;
    }
    assert(en >= 0, "kovalayan dusman olmali");
    float x0 = _e3[en].x;
    // Oyun koşuyor: düşmanlar kovalıyor, süsler dönüyor.
    int f = 0;
    while (f < 180) { _dg_step(0.016667); f = f + 1; }
    assert(abs_f3(_e3[en].x - x0) > 1.0, "simulasyon durumu degistirmeli");
    // Editöre gir = DUR.
    editor3d(true);
    int en2 = 0 - 1;
    i = 0;
    while (i < length(_e3)) {
        if (_e3[i].alive == 1 && _e3[i].tag == TAG_ENEMY && _e3[i].x < 0.0) { en2 = i; }
        i = i + 1;
    }
    assert(en2 >= 0, "dusman geri gelmeli");
    assert(abs_f3(_e3[en2].x - x0) < 0.001,
           "yazarlik konumuna donmeli: " + toString(_e3[en2].x) + " != " + toString(x0));
    editor3d(false);
}

// ASIL HATA: editörde kaydetmek YAZILMIŞ hâli yazmalı, oynanmış hâli değil.
func t_ed_save_writes_authored_not_simulated() {
    scene_file3d("examples/scenes/toplayici.scene.json");
    _ed_capture3();
    str authored = scene_json3d();
    int f = 0;
    while (f < 180) { _dg_step(0.016667); f = f + 1; }
    assert(scene_json3d() != authored, "simulasyon JSON'u degistirmeli");
    editor3d(true);
    editor_dosya3d("/tmp/tulpar_authored_test.json");
    assert(editor_kaydet3d(), "kaydedilmeli");
    editor3d(false);
    str yazilan = read_file("/tmp/tulpar_authored_test.json");
    assert(yazilan == authored, "diske YAZILMIS hal gitmeli, oynanmis hal degil");
}

// Elle yazılmış oyunun kancaları Dur'dan sonra da çalışmalı — sahne biçiminde
// yer almadıkları için `scene3d_reset` onları siler; geri yükleme korumalı.
int _ps_n = 0;
func _ps_cb() { _ps_n = _ps_n + 1; }

func t_ed_stop_preserves_hand_written_hooks() {
    scene3d_reset();
    no_ground3d();
    _ps_n = 0;
    spawn3(0.0, 1.0, 0.0, 1.2, 2.0, 1.2, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    spawn3(0.5, 1.0, 0.0, 1.0, 1.0, 1.0, GOLD, SHAPE_SPHERE, TAG_ITEM);
    on_hit3d(TAG_PLAYER, TAG_ITEM, _ps_cb);
    _ed_capture3();
    _s3_collision();
    assert(_ps_n > 0, "kanca once calismali");
    int before = _ps_n;
    editor3d(true);      // DUR → sahne yeniden yuklenir
    editor3d(false);
    _s3_collision();
    assert(_ps_n > before, "kanca Dur'dan sonra da calismali");
}

// Kurallar sahne biçiminde YER ALIYOR, yani geri yüklemede yeniden gelmeli —
// ama İKİ KAT olmamalı (kanca tablosunda otursalardı tam bu olurdu).
func t_ed_stop_does_not_duplicate_rules() {
    scene_file3d("examples/scenes/toplayici.scene.json");
    _ed_capture3();
    assert_eq_int(rule_count3d(), 5);
    editor3d(true);
    assert_eq_int(rule_count3d(), 5);
    editor3d(false);
    assert_eq_int(rule_count3d(), 5);
}

// ---- Geri al / yinele ------------------------------------------------------

func t_ed_undo_restores_previous_state() {
    scene3d_reset();
    no_ground3d();
    int a = spawn3(0.0, 1.0, 0.0, 1.0, 1.0, 1.0, GOLD, SHAPE_CUBE, TAG_PROP);
    _sc_reg3("kutu", a);
    ed_grid3d(0.0);
    ed_mark3d();
    ed_move3d(a, 9.0, 1.0, 0.0);
    assert(abs_f3(get3x(bul3d("kutu")) - 9.0) < 0.001, "tasindi");
    assert(ed_undo3d(), "geri alinabilmeli");
    // ADIN hâlâ çözülüyor olması ayrıca sınanıyor: bul3d(-1) verirse get3x 0
    // döner ve "eski konuma döndü" iddiası ad kaybolduğunda da GEÇERDİ.
    // (Gerçekten geçiyordu: reset ad kaydını temizlemediği için varlık yanlış
    // adla serileşiyordu.)
    assert(bul3d("kutu") >= 0, "ad gidis-donusten sag cikmali");
    assert(abs_f3(get3x(bul3d("kutu"))) < 0.001,
           "eski konuma donmeli: " + toString(get3x(bul3d("kutu"))));
    assert(ed_redo3d(), "yinelenebilmeli");
    assert(bul3d("kutu") >= 0, "ad yinelemeden de sag cikmali");
    assert(abs_f3(get3x(bul3d("kutu")) - 9.0) < 0.001, "yeniden 9 olmali");
}

func t_ed_undo_covers_delete_and_add() {
    scene3d_reset();
    no_ground3d();
    int a = spawn3(0.0, 1.0, 0.0, 1.0, 1.0, 1.0, GOLD, SHAPE_CUBE, TAG_PROP);
    int n0 = alive_count3d();
    ed_mark3d();
    ed_delete3d(a);
    assert_eq_int(alive_count3d(), n0 - 1);
    ed_undo3d();
    assert_eq_int(alive_count3d(), n0);
    ed_mark3d();
    ed_add3d(TAG_WALL, SHAPE_CUBE, 3.0, 1.0, 3.0);
    assert_eq_int(alive_count3d(), n0 + 1);
    ed_undo3d();
    assert_eq_int(alive_count3d(), n0);
}

// Yeni bir düzenleme yinele dalını kesmeli (aksi hâlde "yinele" alakasız bir
// geleceğe atlardı).
func t_ed_new_edit_clears_redo() {
    scene3d_reset();
    no_ground3d();
    int a = spawn3(0.0, 1.0, 0.0, 1.0, 1.0, 1.0, GOLD, SHAPE_CUBE, TAG_PROP);
    ed_grid3d(0.0);
    ed_mark3d(); ed_move3d(a, 5.0, 1.0, 0.0);
    ed_undo3d();
    assert_eq_int(ed_redo_count3d(), 1);
    ed_mark3d(); ed_move3d(a, 0.0, 1.0, 7.0);
    assert_eq_int(ed_redo_count3d(), 0);
}

// Yığın sınırlı olmalı — sınırsız büyüseydi uzun bir oturum belleği yerdi.
func t_ed_undo_stack_is_bounded() {
    scene3d_reset();
    no_ground3d();
    int a = spawn3(0.0, 1.0, 0.0, 1.0, 1.0, 1.0, GOLD, SHAPE_CUBE, TAG_PROP);
    int i = 0;
    while (i < _ED_UNDO_MAX3 + 12) { ed_mark3d(); i = i + 1; }
    assert(ed_undo_count3d() <= _ED_UNDO_MAX3,
           "yigin sinirli olmali: " + toString(ed_undo_count3d()));
    // En eskiyi atmak, en yenisini bozmamalı.
    assert(ed_undo3d(), "hala geri alinabilmeli");
}

// Boş yığında geri al SESSİZCE sahneyi silmemeli.
func t_ed_undo_on_empty_is_safe() {
    scene3d_reset();
    no_ground3d();
    spawn3(0.0, 1.0, 0.0, 1.0, 1.0, 1.0, GOLD, SHAPE_CUBE, TAG_PROP);
    _ed_undo3 = []; _ed_redo3 = [];
    int n = alive_count3d();
    assert(ed_undo3d() == false, "bos yiginda false donmeli");
    assert_eq_int(alive_count3d(), n);
}

// ---- Arayüz katmanının penceresiz sınanabilir parçaları --------------------

// Metin alanı ASCII tablosundan okuyor (`ord` var ama `chr` yok). Tek karakter
// kayması, yazarken yanlış harf üretirdi ve gözle fark edilmesi zor olurdu.
// Beklenti BAĞIMSIZ kaynaktan: `ord` builtin'i ile gidiş-dönüş.
func t_gui_ascii_table_roundtrips() {
    int c = 32;
    while (c <= 126) {
        str ch = _g_chr3(c);
        assert(length(ch) == 1, "tek karakter olmali, kod " + toString(c));
        assert_eq_int(ord(ch, 0), c);
        c = c + 1;
    }
    // Aralık dışı sessizce boş dönmeli (kontrol karakteri metne sızmasın).
    // Artık dilin `chr` builtin'i kullanılıyor; onun kendi sınırı da 0-255.
    assert(chr(65) == "A", "chr builtin");
    assert(chr(300) == "", "chr aralik disi bos");
    assert(chr(0 - 1) == "", "chr negatif bos");
    assert_eq_int(ord(chr(200), 0), 200);
    assert(_g_chr3(31) == "", "31 bos");
    assert(_g_chr3(127) == "", "127 bos");
    assert(_g_chr3(0) == "", "0 bos");
}

// Sayı yazmak için gereken karakterler tabloda DOĞRU yerde olmalı.
func t_gui_ascii_covers_number_input() {
    assert(_g_chr3(48) == "0", "0");
    assert(_g_chr3(57) == "9", "9");
    assert(_g_chr3(45) == "-", "eksi");
    assert(_g_chr3(46) == ".", "nokta");
}

// Etiket/şekil döngüsel düğmeleri BÜTÜN değerleri gezip başa dönmeli —
// eksik bir dal, o etiketi editörden erişilemez yapardı.
func t_gui_tag_cycle_covers_all() {
    int t = TAG_PLAYER;
    int seen_item = 0; int seen_wall = 0; int seen_enemy = 0; int seen_prop = 0;
    int i = 0;
    while (i < 5) {
        t = _ed_next_tag3(t);
        if (t == TAG_ITEM)  { seen_item = 1; }
        if (t == TAG_WALL)  { seen_wall = 1; }
        if (t == TAG_ENEMY) { seen_enemy = 1; }
        if (t == TAG_PROP)  { seen_prop = 1; }
        i = i + 1;
    }
    assert_eq_int(seen_item + seen_wall + seen_enemy + seen_prop, 4);
    assert_eq_int(t, TAG_PLAYER);   // 5 adimda basa donmeli
}

func t_gui_shape_cycle_covers_all() {
    int sh = SHAPE_CUBE;
    sh = _ed_next_shape3(sh); assert_eq_int(sh, SHAPE_SPHERE);
    sh = _ed_next_shape3(sh); assert_eq_int(sh, SHAPE_CYL);
    sh = _ed_next_shape3(sh); assert_eq_int(sh, SHAPE_RAMP);
    sh = _ed_next_shape3(sh); assert_eq_int(sh, SHAPE_CUBE);
    // SHAPE_MODEL döngüde OLMAMALI: düğmeyle "model" yapmak modelsiz bir
    // MODEL varlık üretirdi.
    int k = 0;
    int sh2 = SHAPE_CUBE;
    while (k < 8) {
        sh2 = _ed_next_shape3(sh2);
        assert(sh2 != SHAPE_MODEL, "model donguye girmemeli");
        k = k + 1;
    }
}

// ---- Denetimden çıkan hatalar ----------------------------------------------

// EN CİDDİSİ: editöre girmek (ve her geri-al) sahne biçiminde YER ALMAYAN
// motor durumunu siliyordu. Ölçüldü: bölge 1→0, kayıt 1→0, nişan AIM_LOOK→FLAT.
// Sebep, yüklemenin `scene3d_reset()` (tam teardown) çağırmasıydı; oysa
// yükleme yalnız GERİ YÜKLEYEBİLDİĞİNİ temizlemeli.
func _ap_cb() { }

func t_ed_tab_preserves_unserialized_state() {
    scene3d_reset();
    no_ground3d();
    int p = spawn3(0.0, 1.0, 0.0, 1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    int z = trigger3d(0.0, 1.0, 0.0, 4.0, 4.0, 4.0, TAG_PLAYER);
    on_enter3d(z, _ap_cb);
    aim_mode3d(AIM_LOOK);
    camera_near3d(9.0);
    _ed_capture3();
    assert_eq_int(trigger_count3d(), 1);

    editor3d(true);
    assert_eq_int(trigger_count3d(), 1);
    assert_eq_int(_aim_mode3, AIM_LOOK);
    assert(abs_f3(_cam_near3 - 9.0) < 0.001, "kamera ayari korunmali");
    editor3d(false);
    assert_eq_int(trigger_count3d(), 1);

    // Geri-al da aynı yolu kullanıyor.
    ed_mark3d();
    ed_move3d(p, 4.0, 1.0, 0.0);
    ed_undo3d();
    assert_eq_int(trigger_count3d(), 1);
    assert_eq_int(_aim_mode3, AIM_LOOK);
}

// SHAPE_MODEL varlıklar ilk TAB'da gri kutuya dönüyordu: yazıcı "model"
// üretiyor, okuyucu o dalı tanımayıp SHAPE_CUBE'e düşürüyordu.
func t_scene_model_shape_survives_roundtrip() {
    scene3d_reset();
    no_ground3d();
    // Gerçek model yüklemeden, handle alanını doğrudan kuruyoruz — sınanan
    // şey biçimin bu alanı taşıyıp taşımadığı, modelin kendisi değil.
    int a = spawn3(1.0, 2.0, 3.0, 2.0, 2.0, 2.0, WHITE, SHAPE_CUBE, TAG_PLAYER);
    _sc_reg3("kahraman", a);
    int sl = _slot_of3(a);
    Ent3 e = _e3[sl];
    e.shape = SHAPE_MODEL; e.model = 7; e.anim_idle = 2; e.anim_run = 5;
    _e3[sl] = e;
    assert(_sc_shape3("model") == SHAPE_MODEL, "okuyucu model dalini bilmeli");

    scene_load3d(scene_json3d());
    int b = bul3d("kahraman");
    assert(b >= 0, "ad korunmali");
    Ent3 e2 = _e3[_slot_of3(b)];
    assert_eq_int(e2.shape, SHAPE_MODEL);
    assert_eq_int(e2.model, 7);
    assert_eq_int(e2.anim_idle, 2);
    assert_eq_int(e2.anim_run, 5);
}

// Çoğaltma model/animasyon alanlarını da taşımalı; taşımazsa kopya
// "şekli MODEL ama modeli yok" oluyordu.
func t_ed_duplicate_copies_model_fields() {
    scene3d_reset();
    no_ground3d();
    int a = spawn3(0.0, 1.0, 0.0, 2.0, 2.0, 2.0, WHITE, SHAPE_CUBE, TAG_ENEMY);
    int sl = _slot_of3(a);
    Ent3 e = _e3[sl];
    e.shape = SHAPE_MODEL; e.model = 3; e.anim_idle = 1; e.anim_run = 4;
    _e3[sl] = e;
    int n = ed_duplicate3d(a);
    Ent3 ne = _e3[_slot_of3(n)];
    assert_eq_int(ne.shape, SHAPE_MODEL);
    assert_eq_int(ne.model, 3);
    assert_eq_int(ne.anim_idle, 1);
    assert_eq_int(ne.anim_run, 4);
}

// Devriye ve ateş davranışlarının TÜM parametreleri gidip gelmeli. Inspector
// eskiden her davranışa iki kutu çiziyordu ve bazıları hiç serileştirilmiyordu
// — sürüklenip değişiyor, ilk kayıtta sessizce geri dönüyordu.
func t_bh_all_params_roundtrip() {
    scene3d_reset();
    no_ground3d();
    int a = spawn3(0.0, 1.0, 0.0, 1.0, 1.0, 1.0, RED, SHAPE_CUBE, TAG_ENEMY);
    _sc_reg3("d", a);
    patrol_behavior3d(a, 0.0 - 7.0, 2.0, 9.0, 0.0 - 3.0, 6.5);
    shoot_behavior3d(a, 1.25, 22.0, 3.5, TAG_PLAYER, 18.0);
    // Kovalamanın HEDEF ETİKETİ inceleyiciden düzenlenebilir oldu; gösterilip
    // de kaydedilmeyen bir alan ilk kayıtta sessizce geri dönerdi.
    // Varsayılan olmayan bir etiket seçiliyor ki "hep player yazıyor" durumu
    // testi geçmesin.
    chase_behavior3d(a, TAG_ITEM, 4.25, 33.0);
    scene_load3d(scene_json3d());
    int nid = bul3d("d");
    int i = 0;
    int okp = 0; int oks = 0; int okc = 0;
    while (i < length(_bh3)) {
        Bh3 b = _bh3[i];
        if (b.id == nid && b.kind == BH_PATROL) {
            assert(abs_f3(b.a + 7.0) < 0.001, "x1");
            assert(abs_f3(b.b - 2.0) < 0.001, "z1");
            assert(abs_f3(b.c - 9.0) < 0.001, "x2");
            assert(abs_f3(b.d + 3.0) < 0.001, "z2");
            assert(abs_f3(b.e - 6.5) < 0.001, "hiz");
            okp = 1;
        }
        if (b.id == nid && b.kind == BH_SHOOT) {
            assert(abs_f3(b.a - 1.25) < 0.001, "aralik");
            assert(abs_f3(b.b - 22.0) < 0.001, "hiz");
            assert(abs_f3(b.c - 3.5) < 0.001, "omur");
            assert(abs_f3(b.d - 18.0) < 0.001, "menzil");
            assert_eq_int(b.tag, TAG_PLAYER);
            oks = 1;
        }
        if (b.id == nid && b.kind == BH_CHASE) {
            assert(abs_f3(b.a - 4.25) < 0.001, "kovala hizi");
            assert(abs_f3(b.b - 33.0) < 0.001, "kovala menzili");
            assert_eq_int(b.tag, TAG_ITEM);
            okc = 1;
        }
        i = i + 1;
    }
    assert_eq_int(okp + oks + okc, 3);
}

// Widget kimlik aralıkları AYRIK olmalı. Tek bir "basılı widget" yuvası olduğu
// için çakışan iki widget'tan ikincisi ölü kalır — ve bu ancak listeler
// büyüyünce ortaya çıkar, yani gözle fark edilmesi çok zor bir hata.
func t_gui_widget_id_ranges_are_disjoint() {
    // Hiyerarşi satırları 12000+r, davranış BLOKLARI 30000+shown*12 (+0..+5).
    int hier_max = 12000 + 500;
    int bh_min = _ed_bh_idbase3();
    assert(hier_max < bh_min, "hiyerarsi ile davranis araliklari cakismamali");
    // Sabit kimlikler (9001-9471) her ikisinin de ALTINDA kalmalı.
    assert(9471 < 12000, "sabit kimlikler hiyerarsinin altinda");
    // Menü/oynat (9600-9611), sekme+ad (9680-9690) ve dünya paneli
    // (9700-9750) da hiyerarşinin altında ve birbirinden ayrık kalmalı.
    assert(9750 < 12000, "dunya paneli kimlikleri hiyerarsinin altinda");
    assert(9611 < 9680, "menu/oynat ile sekme araligi ayrik");
    assert(9690 < 9700, "ad alani ile dunya paneli ayrik");
    // Şablon satırları 9490 + i*2 (i < 8) → en fazla 9505; dünya panelinin
    // (9700+) altında kalmalı.
    assert(9490 + 7 * 2 + 1 < 9600, "sablon satirlari menu araliginin altinda");
    // Bağlam menüsü 22000+, bölge paneli 23000+, kural satırları 21000+ —
    // hepsi hiyerarşi (12000+) ve davranış (20000+) aralıklarından ayrık.
    assert(21901 < 22001, "kural ile baglam menusu ayrik");
    assert(22015 < 23001, "baglam menusu ile bolge paneli ayrik");
    // Davranış bloğu içi kimlikler birbirine girmemeli. Blok başına en
    // fazla 6 widget kullanılıyor (+0 sil, +1..+5 alanlar), adım 12.
    // Sabitler KAYNAKTAN okunuyor. Tekrar etseydi adımı küçültmek bloğu
    // kendi üstüne bindirir ve test göremezdi — denendi, adım 3'e
    // düşürüldüğünde test yeşil kalmıştı.
    int step = _ed_bh_idstep3();
    int used = _ed_bh_idused3();
    assert(used <= step,
           "davranis blogu " + toString(used) + " widget kullaniyor ama adim " +
           toString(step) + " — bloklar birbirine biner");
    int s0 = _ed_bh_idbase3() + 0 * step;
    int s1 = _ed_bh_idbase3() + 1 * step;
    assert(s0 + used - 1 < s1, "ardisik davranis bloklari cakismamali");

    // Davranış tabanı, ALTINDAKİ bütün aralıkların üstünde olmalı. Bu bir
    // varsayım değil ölçülmüş sınır: kural satırları 21000+, bağlam menüsü
    // 22000+, bölge paneli 23030'a kadar gidiyor. Taban 20000'de kalsaydı
    // adım 12 ile 84. davranış kural satırlarına çarpardı.
    assert(23030 < _ed_bh_idbase3(),
           "davranis tabani diger araliklarin ustunde olmali");
    // Bölüm şeridi 9760-9764: dünya panelinin (9700-9750) ÜSTÜNDE ve
    // hiyerarşinin (12000+) altında kalmalı.
    assert(9750 < 9760, "bolum seridi dunya panelinin ustunde");
    assert(9764 < 12000, "bolum seridi hiyerarsinin altinda");
}

