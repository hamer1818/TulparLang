// Denetim iletileri arasında arama — hem "var" hem "YOK" yönünü sınamak için.
func _t_chk_has3(needle): bool {
    int i = 0;
    while (i < scene_check_count3d()) {
        if (_ed_match3(scene_check_msg3d(i), needle)) { return true; }
        i = i + 1;
    }
    return false;
}

// ===========================================================================
// VARLIK (ASSET) KAYDI — model yolu, taşınabilir sahne
//
// `load_model` SÜREÇ İÇİ bir handle döner. Sahne dosyasına o sayıyı yazmak
// dosyayı taşınabilir GÖSTERİP taşınabilir yapMIyordu. Aşağıdakiler kaydın
// üç işini de sınıyor: önbellek, yolun yazılması, yolun handle'ı yenmesi.
// ===========================================================================

func t_asset_registry_caches() {
    int n0 = asset_count3d();
    int h1 = asset_model3d("KAYIT_A.glb");
    int n1 = asset_count3d();
    int h2 = asset_model3d("KAYIT_A.glb");
    int n2 = asset_count3d();
    assert_eq_int(n1, n0 + 1);
    // İkinci istek YENİ KAYIT AÇMAMALI — yoksa bir modeli kullanan yirmi
    // varlık yirmi GPU yüklemesi demek.
    assert_eq_int(n2, n1);
    assert_eq_int(h2, h1);
}

func t_asset_registry_separates_kinds() {
    int n0 = asset_count3d();
    asset_model3d("KAYIT_B.png");
    asset_texture3d("KAYIT_B.png");
    // Aynı yol, farklı tür = farklı kayıt. Tür ayrılmazsa bir dosyayı hem
    // model hem doku isteyen sahne yanlış handle alırdı.
    assert_eq_int(asset_count3d(), n0 + 2);
    int im = _as_find3("KAYIT_B.png", AS_MODEL3);
    int it = _as_find3("KAYIT_B.png", AS_TEX3);
    assert(im >= 0 && it >= 0 && im != it, "iki ayri kayit olmali");
    assert_eq_int(asset_kind3d(im), AS_MODEL3);
    assert_eq_int(asset_kind3d(it), AS_TEX3);
    assert_eq_str(asset_path3d(im), "KAYIT_B.png");
}

func t_asset_src_serialized_and_roundtrips() {
    scene3d_reset(); ground3d(0.0);
    int a = spawn3_asset(1.0, 2.0, 3.0, 1.5, "varliklar/kahraman.glb", TAG_PLAYER);
    assert_eq_str(model_src3d(a), "varliklar/kahraman.glb");
    str js = scene_json3d();
    assert(_ed_match3(js, "model_src"), "JSON model_src TASIMALI");
    assert(_ed_match3(js, "varliklar/kahraman.glb"), "JSON YOLU tasimali");

    scene3d_reset();
    scene_load3d(js);
    int b = _mk_handle3(0);
    assert_eq_str(model_src3d(b), "varliklar/kahraman.glb");
    // Şekil de dönmeli; model yolu taşıyıp şekli kaybetmek varlığı küp yapardı.
    assert_eq_int(_e3[0].shape, SHAPE_MODEL);
}

// EN ÖNEMLİSİ. Yazıcının tek koruması `model >= 0` idi: dosya o an
// yüklenemiyorsa (eksik varlık, pencere yok) handle -1 kalıyor ve blok
// TÜMDEN atlanıyordu — yani sahneyi kaydetmek model referansını SESSİZCE
// SİLİYORDU. Test başlıksız çalışıyor, yani burada handle GERÇEKTEN -1.
func t_asset_src_written_even_when_load_failed() {
    scene3d_reset(); ground3d(0.0);
    int a = spawn3_asset(0.0, 0.0, 0.0, 1.0, "OLMAYAN_DOSYA.glb", TAG_PROP);
    // Ön koşul: bu ortamda gerçekten yüklenememiş olmalı, yoksa test
    // sınamak istediği dalı hiç geçmez.
    assert(_e3[0].model < 0, "on kosul: modelin yuklenmemis olmasi gerek");
    str js = scene_json3d();
    assert(_ed_match3(js, "OLMAYAN_DOSYA.glb"),
           "yuklenemeyen model bile YOLUNU kaybetmemeli");
    scene3d_reset();
    scene_load3d(js);
    assert_eq_str(model_src3d(_mk_handle3(0)), "OLMAYAN_DOSYA.glb");
}

// Dosyada hem eski `model` handle'ı hem yeni `model_src` varsa YOL kazanmalı:
// handle başka bir çalıştırmada bambaşka bir modeli gösterir.
func t_asset_path_beats_handle() {
    scene3d_reset(); ground3d(0.0);
    asset_model3d("YOL_KAZANIR.glb");
    int hbeklenen = asset_model3d("YOL_KAZANIR.glb");
    scene_load3d("{\"v\":1,\"world\":{\"ground\":0},\"entities\":[" +
        "{\"tag\":\"prop\",\"shape\":\"model\",\"x\":0,\"y\":0,\"z\":0," +
        "\"model\":424242,\"model_src\":\"YOL_KAZANIR.glb\"}]}");
    assert_eq_str(model_src3d(_mk_handle3(0)), "YOL_KAZANIR.glb");
    assert_eq_int(_e3[0].model, hbeklenen);
    assert(_e3[0].model != 424242, "dosyadaki ham handle KULLANILMAMALI");
}

func t_sc_q3_escapes_json_strings() {
    assert_eq_str(_sc_q3("a/b.glb"), "\"a/b.glb\"");
    // Kaçırılmayan bir tırnak sahne dosyasını ayrıştırılamaz yapardı.
    assert_eq_str(_sc_q3("a\"b"), "\"a\\\"b\"");
    assert_eq_str(_sc_q3("a\\b"), "\"a\\\\b\"");
}

func t_asset_weird_path_survives_roundtrip() {
    scene3d_reset(); ground3d(0.0);
    spawn3_asset(0.0, 0.0, 0.0, 1.0, "tuhaf\"ad.glb", TAG_PROP);
    str js = scene_json3d();
    scene3d_reset();
    scene_load3d(js);
    assert_eq_str(model_src3d(_mk_handle3(0)), "tuhaf\"ad.glb");
}

func t_set_and_clear_model3d() {
    scene3d_reset(); ground3d(0.0);
    int a = uret3(0.0, 0.0, 0.0, 1.0, 1.0, 1.0, WHITE, SHAPE_CUBE, TAG_PROP);
    set_model3d(a, "AT_BUNU.glb");
    // Şekil de MODEL olmalı: modeli olup şekli küp kalan varlık kutu çizilirdi.
    assert_eq_int(_e3[0].shape, SHAPE_MODEL);
    assert_eq_str(model_src3d(a), "AT_BUNU.glb");

    _e3[0].anim_idle = 3;
    clear_model3d(a);
    // Şekil de geri gelmeli: modelsiz bir MODEL varlık HİÇ çizilmez.
    assert_eq_int(_e3[0].shape, SHAPE_CUBE);
    assert_eq_int(_e3[0].model, 0 - 1);
    assert_eq_str(model_src3d(a), "");
    assert_eq_int(_e3[0].anim_idle, 0 - 1);
}

func t_duplicate_copies_model_src() {
    scene3d_reset(); ground3d(0.0);
    int a = spawn3_asset(0.0, 0.0, 0.0, 1.0, "COGALT.glb", TAG_PROP);
    int b = ed_duplicate3d(a);
    assert(b >= 0, "cogaltma bir varlik uretmeli");
    // Yol taşınmazsa kopya "şekli MODEL ama yolu yok" oluyor: kaydedilince
    // model referansı kopyada kayboluyordu.
    assert_eq_str(model_src3d(b), "COGALT.glb");
}

// ---- Zemin dokusu: hiç yazılmıyordu -----------------------------------------
func t_ground_texture_roundtrips() {
    scene3d_reset(); ground3d(0.0);
    ground_texture_src3d("dokular/cimen.png", 24.0);
    str js = scene_json3d();
    // NÖBETÇİ: yükleme gerçekten yazıyor mu, yoksa eski değer mi duruyor?
    // (scene3d_reset dünya ayarlarını bilerek BIRAKIYOR — nöbetçi şart.)
    ground_texture_src3d("CURUK.png", 1.0);
    scene_load3d(js);
    assert_eq_str(ground_texture_path3d(), "dokular/cimen.png");
    assert(abs_f3(_ground_tile3 - 24.0) < 0.001, "tile de donmeli");
}

func t_ground_texture_cleared_when_absent() {
    scene3d_reset();
    ground_texture_src3d("CURUK2.png", 7.0);
    scene_load3d("{\"v\":1,\"world\":{\"ground\":0},\"entities\":[]}");
    // Dokusuz bir sahne öncekinin dokusunu DEVRALMAMALI.
    assert_eq_str(ground_texture_path3d(), "");
    assert_eq_int(_ground_tex3, 0 - 1);
}

// ---- Tarayıcı yerleşimi ------------------------------------------------------
func t_ed_basename_takes_last_component() {
    assert_eq_str(_ed_basename3("varliklar/alt/robot.glb"), "robot.glb");
    assert_eq_str(_ed_basename3("robot.glb"), "robot.glb");
    assert_eq_str(_ed_basename3(""), "");
    // Sondaki ayraç: boş ad, çökme değil.
    assert_eq_str(_ed_basename3("varliklar/"), "");
}

func t_ed_asset_scroll_clamped() {
    int rows = _ed_as_rows3();
    // Liste satır sayısından kısaysa kaydırma HİÇ olmamalı.
    assert_eq_int(_ed_as_clamp3(5, 3, rows), 0);
    assert_eq_int(_ed_as_clamp3(0, 0, rows), 0);
    // Uzun listede son sayfa: son satır görünür kalmalı.
    assert_eq_int(_ed_as_clamp3(999, 20, rows), 20 - rows);
    assert_eq_int(_ed_as_clamp3(0 - 4, 20, rows), 0);
    // Ortadaki geçerli bir konum dokunulmadan geçmeli.
    assert_eq_int(_ed_as_clamp3(6, 20, rows), 6);
}

func t_ed_asset_scan_finds_real_files() {
    _ed_asglob3 = "lib/*.tpr";
    _ed_asset_scan3();
    assert(length(_ed_asfiles3) > 3, "lib/ altinda .tpr dosyalari bulunmali");
    assert_eq_int(_ed_asdone3, 1);
    // Tarama kaydırmayı başa almalı; almazsa yeni listede boş sayfa görünür.
    _ed_asscroll3 = 4;
    _ed_asset_scan3();
    assert_eq_int(_ed_asscroll3, 0);
    // Eşleşmeyen desen boş liste vermeli, eskisini BIRAKMAMALI.
    _ed_asglob3 = "lib/*.HICBIRZAMAN";
    _ed_asset_scan3();
    assert_eq_int(length(_ed_asfiles3), 0);
}

func t_ed_asset_loaded_state() {
    // -1 = hiç denenmedi, 0 = denendi olmadı, 1 = yuklendi.
    assert_eq_int(_ed_as_loaded3("HIC_ISTENMEDI.glb"), 0 - 1);
    asset_model3d("DENENDI.glb");
    assert_eq_int(_ed_as_loaded3("DENENDI.glb"), 0);
}

func t_check_flags_missing_model_files() {
    scene3d_reset(); ground3d(0.0);
    spawn3_asset(0.0, 0.0, 0.0, 1.0, "KAYIP_MODEL.glb", TAG_PROP);
    scene_check3d();
    assert(_t_chk_has3("model dosyasi yuklenemedi"),
           "yuklenemeyen model denetimde gorunmeli");
    // Modeli kaldırınca uyarı da gitmeli — yoksa denetim yalancı olurdu.
    clear_model3d(_mk_handle3(0));
    scene_check3d();
    assert(!_t_chk_has3("model dosyasi yuklenemedi"),
           "model kaldirilinca uyari da gitmeli");
}


// ---- Animasyon klipleri ------------------------------------------------------
// `anim_fps` HİÇ yazılmıyordu: elle kurulan animasyon hızı kaydedip açınca
// sessizce 24'e dönüyordu.
func t_anim_fps_survives_roundtrip() {
    scene3d_reset(); ground3d(0.0);
    int a = spawn3_asset(0.0, 0.0, 0.0, 1.0, "ANIM.glb", TAG_PLAYER);
    _e3[0].anim_idle = 1;
    _e3[0].anim_run = 2;
    _e3[0].anim_fps = 12.0;
    str js = scene_json3d();
    scene3d_reset();
    scene_load3d(js);
    assert_eq_int(_e3[0].anim_idle, 1);
    assert_eq_int(_e3[0].anim_run, 2);
    assert(abs_f3(_e3[0].anim_fps - 12.0) < 0.001, "kare/sn de donmeli");
}

// Varsayılan hız dosyayı şişirmemeli — ama dönüşte de doğru olmalı.
func t_anim_fps_default_not_written() {
    scene3d_reset(); ground3d(0.0);
    spawn3_asset(0.0, 0.0, 0.0, 1.0, "ANIM2.glb", TAG_PLAYER);
    str js = scene_json3d();
    assert(!_ed_match3(js, "anim_fps"), "varsayilan hiz yazilmamali");
    scene3d_reset();
    scene_load3d(js);
    assert(abs_f3(_e3[0].anim_fps - 24.0) < 0.001, "varsayilan 24 olmali");
}

func t_ed_anim_clip_clamped() {
    // Klipsiz model: hangi indeks istenirse istensin -1.
    assert_eq_int(_ed_anim_clamp3(3, 0), 0 - 1);
    assert_eq_int(_ed_anim_clamp3(0, 0), 0 - 1);
    // -1 gecerli (klip yok); daha kucuk degerler -1'e toplanir.
    assert_eq_int(_ed_anim_clamp3(0 - 1, 4), 0 - 1);
    assert_eq_int(_ed_anim_clamp3(0 - 7, 4), 0 - 1);
    // Ust sinir: son klip. Kelepcesiz indeks var olmayan animasyona uzanir
    // ve karakter sessizce T-poz kalirdi.
    assert_eq_int(_ed_anim_clamp3(9, 4), 3);
    assert_eq_int(_ed_anim_clamp3(3, 4), 3);
    // Ortadaki gecerli deger dokunulmadan gecmeli.
    assert_eq_int(_ed_anim_clamp3(2, 4), 2);
}


// ===========================================================================
// KURAL PANELİNİN SÖZLÜĞÜ — "player | item | collect | 50" dört isimsiz kutuydu
// ===========================================================================

// Yön ÖNEMLİ ve panel onu söylemiyordu: aynı eylem, taraflar değişince
// başka birini yaralıyor.
func t_rule_summary_states_direction() {
    str s1 = _ed_rule_ozet3(RULE_HIT, TAG_PLAYER, TAG_ENEMY, ACT_DAMAGE, 10.0);
    str s2 = _ed_rule_ozet3(RULE_HIT, TAG_ENEMY, TAG_PLAYER, ACT_DAMAGE, 10.0);
    assert(s1 != s2, "taraflar degisince ozet de degismeli");
    assert(_ed_match3(s1, "player hasar alir"), "ilk kuralda OYUNCU yaralanir");
    assert(_ed_match3(s2, "enemy hasar alir"), "ikinci kuralda DUSMAN yaralanir");
    // HURT'te hasar alan OTEKI — DAMAGE'in tersi.
    str s3 = _ed_rule_ozet3(RULE_HIT, TAG_PLAYER, TAG_ENEMY, ACT_HURT, 10.0);
    assert(_ed_match3(s3, "enemy hasar alir"), "hurt'te oteki yaralanir");
}

func t_rule_summary_covers_every_action() {
    // Her eylem AYRI bir cumle uretmeli; ikisi ayni cikarsa panel yaniltir.
    // Liste SABİT SAYILARDAN türüyor: elle yazılmış bir dizi, yeni bir eylem
    // eklenince onu sessizce atlar ve test "hepsi" demeyi bırakır (ACT_NEXT
    // eklendiğinde tam olarak bu oldu — dört test altı eylem sayıyordu).
    array acts = [];
    int _ai = 0;
    while (_ai <= ACT_NEXT) { push(acts, _ai); _ai = _ai + 1; }
    array seen = [];
    int i = 0;
    while (i < length(acts)) {
        str o = _ed_rule_ozet3(RULE_HIT, TAG_PLAYER, TAG_ITEM, acts[i], 5.0);
        assert(o != "", "her eylemin ozeti olmali");
        int j = 0;
        while (j < length(seen)) {
            assert(seen[j] != o, "iki eylem ayni ozeti vermemeli");
            j = j + 1;
        }
        push(seen, o);
        i = i + 1;
    }
    assert_eq_int(length(seen), length(acts));
}

// "bitince" kuralinda dagitici `me`/`other` yerine -1 geciyor: topla, oldur
// ve hasar SESSIZ birer bos islem. Dugme artik onlari dolasmiyor.
func t_cleared_rule_action_cycle_only_terminal() {
    int n = ACT_NEXT + 1;
    // 1) Bitince döngüsü İŞ GÖRMEYEN eyleme uğramamalı.
    array gor = [];
    int k = 0;
    while (k < n) { push(gor, 0); k = k + 1; }
    int a = ACT_WIN;
    int i = 0;
    while (i < n * 2) {
        a = _ed_next_act_for3(RULE_CLEARED, a);
        assert(_ed_act_works_cleared3(a), "bitince dongusu is gormeyen eyleme ugramamali");
        gor[a] = 1;
        i = i + 1;
    }
    // 2) ...ama iş gören HER eyleme uğramalı. Yalnız "uğramasın" demek, iki
    // eylem arasında takılıp üçüncüsüne hiç gitmeyen bir döngüden kaçardı —
    // ve ACT_NEXT eklenince kullanıcı ona düğmeyle hiç ulaşamazdı.
    k = 0;
    while (k < n) {
        if (_ed_act_works_cleared3(k)) {
            assert_eq_int(gor[k], 1);
        }
        k = k + 1;
    }
    // 3) Çarpışma döngüsü HEPSİNİ dolaşmalı — orada hepsi iş görüyor.
    array gor2 = [];
    k = 0;
    while (k < n) { push(gor2, 0); k = k + 1; }
    int b = ACT_COLLECT;
    i = 0;
    while (i < n) {
        b = _ed_next_act_for3(RULE_HIT, b);
        gor2[b] = 1;
        i = i + 1;
    }
    k = 0;
    while (k < n) {
        assert_eq_int(gor2[k], 1);
        k = k + 1;
    }
}

// Sayi alani yalnizca eylem onu KULLANIYORSA gosterilmeli. Dagiticinin
// hangi dallarda `n`e baktigi tek dogruluk kaynagi.
func t_amount_shown_only_where_used() {
    assert(_ed_act_uses_n3(ACT_COLLECT), "topla skoru kullanir");
    assert(_ed_act_uses_n3(ACT_DAMAGE), "damage hasari kullanir");
    assert(_ed_act_uses_n3(ACT_HURT), "hurt hasari kullanir");
    assert(!_ed_act_uses_n3(ACT_KILL), "oldur miktara bakmaz");
    assert(!_ed_act_uses_n3(ACT_WIN), "kazan miktara bakmaz");
    assert(!_ed_act_uses_n3(ACT_LOSE), "kaybet miktara bakmaz");
    assert(!_ed_act_uses_n3(ACT_NEXT), "sonraki bolum miktara bakmaz");
    // Etiket de eyleme gore degismeli: skor ile hasar ayni sey degil.
    assert_eq_str(_ed_act_n_lbl3(ACT_COLLECT), "skor");
    assert_eq_str(_ed_act_n_lbl3(ACT_DAMAGE), "hasar");
}

func t_act_names_are_distinct_and_directional() {
    // Liste SABİT SAYILARDAN türüyor: elle yazılmış bir dizi, yeni bir eylem
    // eklenince onu sessizce atlar ve test "hepsi" demeyi bırakır (ACT_NEXT
    // eklendiğinde tam olarak bu oldu — dört test altı eylem sayıyordu).
    array acts = [];
    int _ai = 0;
    while (_ai <= ACT_NEXT) { push(acts, _ai); _ai = _ai + 1; }
    array nms = [];
    int i = 0;
    while (i < length(acts)) {
        str n = _ed_act_nm3(acts[i]);
        int j = 0;
        while (j < length(nms)) {
            assert(nms[j] != n, "iki eylemin adi ayni olmamali");
            j = j + 1;
        }
        push(nms, n);
        i = i + 1;
    }
    // DAMAGE ile HURT arasindaki fark HANGI TARAF — adlarin bunu soylemesi sart.
    assert(_ed_act_nm3(ACT_DAMAGE) != _ed_act_nm3(ACT_HURT), "damage ve hurt ayrilmali");
}

// Kimlik blogu KAYNAKTAN okunuyor. Sabitleri teste kopyalamak daha once bir
// cakismayi gizlemisti: adim kucultuldugunde test yesil kalmisti.
// Anlik-kip arayuzde iki widget ayni kimligi paylasirsa IKINCISI olur:
// tiklama birinciye gider. Sessiz bir hata, o yuzden kimlik bloklari
// KAYNAKTAN okunup ayrikligi siniyor. (Sabitleri teste kopyalamak daha once
// bir cakismayi gizlemisti.)
func t_rule_widget_ids_do_not_collide() {
    int base = _ed_rl_idbase3();
    int step = _ed_rl_idstep3();
    int used = _ed_rl_idused3();
    // Blok basina kullanilan widget sayisi adimdan kucuk olmali, yoksa
    // ARD ARDA iki kural ust uste biner.
    assert(step > used, "adim, blok basina kullanilan widget sayisindan buyuk olmali");
    int son0 = base + used - 1;
    int ilk1 = base + step;
    assert(son0 < ilk1, "kural bloklari ust uste binmemeli");

    // 200 kurallik gercekci bir ust sinir icin kural araligi, oteki
    // SABIT bloklarin hicbirine degmemeli.
    int alt = base;
    int ust = base + 200 * step + used - 1;
    // "+carpisma" / "+bitince" ekleme dugmeleri
    assert(21900 < alt || 21900 > ust, "ekleme dugmesi kural araligina girmemeli");
    assert(21901 < alt || 21901 > ust, "ekleme dugmesi kural araligina girmemeli");
    // Ses tarayicisi sabit blogu (base .. base+51)
    int sb = _ed_snd_idbase3();
    assert(sb + 51 < alt || sb > ust, "ses tarayicisi kural araligina girmemeli");
    // Model tarayicisi 50000-50041
    assert(50041 < alt || 50000 > ust, "model tarayicisi kural araligina girmemeli");
    // Davranis blogu: 30000 tabanli, adim 12 — 200 davranis 32400'e ulasir.
    int bh_alt = _ed_bh_idbase3();
    int bh_ust = bh_alt + 200 * _ed_bh_idstep3() + _ed_bh_idused3() - 1;
    assert(bh_ust < alt || bh_alt > ust, "kural ve davranis araliklari ayrik olmali");
    // Ses ve model tarayicilari da birbirine girmemeli.
    assert(sb > 50041 || sb + 51 < 50000, "iki tarayici blogu ayrik olmali");
}

func t_check_flags_dead_cleared_action() {
    scene3d_reset(); ground3d(0.0);
    uret3(0.0, 1.0, 0.0, 1.0, 1.0, 1.0, GOLD, SHAPE_SPHERE, TAG_ITEM);
    uret3(3.0, 1.0, 0.0, 1.0, 2.0, 1.0, BLUE, SHAPE_CUBE, TAG_PLAYER);
    cleared_rule3d(TAG_ITEM, ACT_KILL);   // sessiz bos islem
    scene_check3d();
    assert(_t_chk_has3("bir sey yapmaz"), "is gormeyen bitince eylemi soylenmeli");
    // Kazan'a cevirince uyari gitmeli.
    _rl3[0].act = ACT_WIN;
    scene_check3d();
    assert(!_t_chk_has3("bir sey yapmaz"), "duzeltilince uyari da gitmeli");
}


// ---- Panel metin bütçesi ------------------------------------------------------
// Metin genişliği yalnız PENCEREYLE ölçülebiliyor (`text_width` penceresiz 0
// döner — ilk yerleşim testim tam bu yüzden boştu, her ölçüm 0 <= sınır diye
// "sığar" diyordu). Gerçek ölçüm başsız Chrome'da web hedefiyle yapıldı;
// varsayılan ölçekte (2x, font 20) raylib'in kendi metriği:
//
//   alan genişliği              160 px
//   "otekine hasar" (13 krk)    140 px   -> ~10.8 px/karakter
//   "-> oyun KAYBEDILIR" (18)   206 px   -> ~11.4 px/karakter (büyük harf)
//
// Ölçüm tekrarlanamadığı için burada KARAKTER bütçesi tutuluyor: en kötü
// 11.5 px/karakterle 160 piksel ~13 karakter demek. Bütçeyi aşan bir ad
// düğmede kırpılır — bu testin yakaladığı şey o. (Ölçülen taşmalar: eski
// "OTEKI hasar alir" 174/160, "BEN hasar alirim" 166/160, eski özet
// cümlesi 462/280, eski uyarı satırı 358/280.)

// Işık renk adları düğmeye sığmalı. Düğme 134 piksel (ölçüldü), yani
// ~11 karakter — en uzun ad "beyaz" 58 piksel.
func t_light_color_names_fit_button() {
    array cols = [WHITE, rgb(255, 214, 150), GOLD, rgb(255, 120, 70),
                  rgb(120, 180, 255), rgb(140, 255, 170)];
    int i = 0;
    while (i < length(cols)) {
        str n = _ed_lt_col_nm3(cols[i]);
        assert(length(n) <= 11, "isik renk adi dugmeye sigmali: " + n);
        i = i + 1;
    }
}

func t_action_names_fit_field_budget() {
    // Liste SABİT SAYILARDAN türüyor: elle yazılmış bir dizi, yeni bir eylem
    // eklenince onu sessizce atlar ve test "hepsi" demeyi bırakır (ACT_NEXT
    // eklendiğinde tam olarak bu oldu — dört test altı eylem sayıyordu).
    array acts = [];
    int _ai = 0;
    while (_ai <= ACT_NEXT) { push(acts, _ai); _ai = _ai + 1; }
    int i = 0;
    while (i < length(acts)) {
        str n = _ed_act_nm3(acts[i]);
        assert(length(n) <= 13, "eylem adi alana sigmali: " + n);
        i = i + 1;
    }
}

// Özet satırı panelin TAM genişliğini kullanıyor (280 px) — bütçe 24 karakter.
// Etiket adı da içine giriyor, en uzunu "player".
func t_rule_summary_fits_panel_budget() {
    // Liste SABİT SAYILARDAN türüyor: elle yazılmış bir dizi, yeni bir eylem
    // eklenince onu sessizce atlar ve test "hepsi" demeyi bırakır (ACT_NEXT
    // eklendiğinde tam olarak bu oldu — dört test altı eylem sayıyordu).
    array acts = [];
    int _ai = 0;
    while (_ai <= ACT_NEXT) { push(acts, _ai); _ai = _ai + 1; }
    int i = 0;
    while (i < length(acts)) {
        str o1 = _ed_rule_ozet3(RULE_HIT, TAG_PLAYER, TAG_PLAYER, acts[i], 100.0);
        assert(length(o1) <= 24, "carpisma ozeti panele sigmali: " + o1);
        str o2 = _ed_rule_ozet3(RULE_CLEARED, TAG_PLAYER, TAG_PLAYER, acts[i], 0.0);
        assert(length(o2) <= 24, "bitince ozeti panele sigmali: " + o2);
        i = i + 1;
    }
}

// Kutu genişliğinden karakter bütçesi. Sabit bir sayı yazmak, kutu daralınca
// sessizce yalan söylerdi; bütçe genişlikten TÜRÜYOR. En kötü 11.5
// px/karakter (yukarıdaki ölçüme bak) — tam sayıyla: 2*w / 23.
func _t_fits3(label, boxw): bool {
    return length(label) <= toInt(boxw * 2 / 23);
}

// Dosya penceresinin sabit genişlikli kutuları. Düğme etiketi kutuya
// sığmazsa kırpılıyor ve "VAZG..." yazan bir düğme ne yaptığını söylemiyor.
func t_ed_fd_labels_fit_their_boxes() {
    editor_ui_scale3d(2);
    assert(_t_fits3("TARA", _us3(38)), "TARA dugmesi");
    assert(_t_fits3("KAYDET", _us3(64)), "KAYDET dugmesi");
    assert(_t_fits3("VAZGEC", _us3(56)), "VAZGEC dugmesi");
    assert(_t_fits3("^", _us3(30)), "yukari dugmesi");
    assert(_t_fits3("v", _us3(30)), "asagi dugmesi");
    int inner = _ed_fd_w_for3(1440) - _ED_PAD3 * 2;
    assert(_t_fits3("kaydedilmemis is var — tekrar tikla", inner),
           "uyari satiri pencereye sigmali");
    assert(_t_fits3("bir dosyaya tikla", inner), "ipucu satiri");
    assert(_t_fits3("FARKLI KAYDET", _ed_fd_w_for3(1440)), "pencere basligi");
    assert(_t_fits3("SAHNE AC", _ed_fd_w_for3(1440)), "pencere basligi");
    // 3x ölçekte de: kutular da yazı da ölçekle büyüyor, oran korunmalı.
    editor_ui_scale3d(3);
    assert(_t_fits3("TARA", _us3(38)), "3x TARA");
    assert(_t_fits3("KAYDET", _us3(64)), "3x KAYDET");
    assert(_t_fits3("VAZGEC", _us3(56)), "3x VAZGEC");
    editor_ui_scale3d(2);
}

// Bölge panelinin metinleri de inceleyiciye (280 px -> ~24 karakter) sığmalı.
// İlk yazdığım iki satır sığmıyordu — "ok tuslari: tasi (X/Z) — R ile boyut"
// 36 karakter, "+ kodda girince kancasi var" 27. İkisi de kırpılarak
// gösterilecekti, yani ipucu olma işlevlerini kaybediyorlardı.
func t_zone_panel_texts_fit() {
    editor_ui_scale3d(2);
    int inner = _ED_INSP_W3 - _ED_PAD3 * 2;
    assert(_t_fits3("ok: tasi  R+ok: boyut", inner), "ok tuslari ipucu");
    assert(_t_fits3("kodda kancasi da var", inner), "kanca satiri");
    assert(_t_fits3("bolge secili degil", inner), "secim yok satiri");
    assert(_t_fits3("BOLGEYI SIL", inner), "sil dugmesi");
    // Eylem düğmesi TAM genişlikte; adlar oraya sığmalı.
    int i = 0;
    while (i <= ZACT_NEXT) {
        assert(_t_fits3(_zact_nm3(i), inner), "eylem adi: " + _zact_nm3(i));
        i = i + 1;
    }
    // Miktar etiketi DAR sütunda (labw + _us3(20)).
    int labw = _us3(30) + _us3(20);
    assert(_t_fits3(_zact_amount_lbl3(ZACT_DAMAGE), labw), "hasar etiketi");
    assert(_t_fits3(_zact_amount_lbl3(ZACT_SCORE), labw), "skor etiketi");
    // Yarım sütundaki iki geçiş düğmesi.
    int half = toInt((inner - _us3(4)) / 2);
    // Bu iki düğme ZATEN taşıyordu ("tek atim: yok" 13 karakter, bütçe 11) —
    // testi yazarken çıktı, benim eklediğim bir şey değil. Etiketler artık
    // DURUMUN ADI: hem sığıyorlar hem daha açıklar.
    assert(_t_fits3("tek atim", half), "tek atim dugmesi");
    assert(_t_fits3("surekli", half), "surekli dugmesi");
    assert(_t_fits3("etkin", half), "etkin dugmesi");
    assert(_t_fits3("kapali", half), "kapali dugmesi");
    // Ses satiri: dugme genisligi inner eksi "x" dugmesi ve payi.
    int sesw = inner - _us3(22) - _us3(4);
    assert(_t_fits3("ses: yok", sesw), "sessiz etiketi");
    assert(_t_fits3("kazandin.wav", sesw), "ses dosya adi");
    assert(_t_fits3("x", _us3(22)), "ses temizleme dugmesi");
}

// Kamera panelinin metinleri. Düğmelerin çoğu YARIM sütunda (2x ölçekte
// 136 px -> ~11 karakter) ve ilk yazdıklarımın dördü taşıyordu.
func t_camera_panel_texts_fit() {
    editor_ui_scale3d(2);
    int inner = _ED_INSP_W3 - _ED_PAD3 * 2;
    int half = toInt((inner - 4) / 2);
    int i = 0;
    while (i <= CAM_FPS) {
        assert(_t_fits3(_cam_mode_nm3(i), half), "mod adi: " + _cam_mode_nm3(i));
        i = i + 1;
    }
    // Hedef düğmesi de yarım sütunda ve İÇERİĞİ değişken: en uzun sabit
    // hâlleri sınanıyor (varlık adı zaten kırpılabilir, o bilinçli).
    scene3d_reset(); no_ground3d();
    assert(_t_fits3(_ed_cam_target_nm3(), half), "hedefsiz etiket");
    int p = spawn3(0.0, 1.0, 0.0, 1.0, 2.0, 1.0, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    kamera_yorunge(p, 12.0, 8.0);
    kill3d(p);
    assert(_t_fits3(_ed_cam_target_nm3(), half), "silinmis hedef etiketi");
    // Uyarı satırı TAM genişlikte.
    assert(_t_fits3("hedefi yeniden sec", inner), "uyari satiri");
    // Kamera-engel düğmesi yarım sütunda.
    assert(_t_fits3("engel: yok", half), "engel yok");
    assert(_t_fits3("engel: var", half), "engel var");
}

// Etiket sütunu 102 px -> ~9 karakter.
func t_panel_labels_fit_label_column() {
    array labs = ["kim", "neye", "hangisi", "olunca", "skor", "hasar", "bosta",
                  "kosu", "kare/sn", "menzil", "renk", "doseme", "kon"];
    int i = 0;
    while (i < length(labs)) {
        assert(length(labs[i]) <= 9, "etiket sutuna sigmali: " + labs[i]);
        i = i + 1;
    }
}


// ===========================================================================
// KURAL SESİ — motorda konumsal ses vardı, HİÇBİR ŞEY onu çağırmıyordu
//
// `sound3d()` tanımlıydı ve `scene3d` içinde sıfır kez çağrılıyordu; sahne
// biçiminde ses anahtarı yoktu; 3B örneklerin hiçbiri ses çalmıyordu. Yani
// editörle yapılan her oyun sessizdi.
// ===========================================================================

func t_rule_sound_roundtrips() {
    scene3d_reset(); ground3d(0.0);
    hit_rule3d(TAG_PLAYER, TAG_ITEM, ACT_COLLECT, 10.0);
    rule_sound3d(0, "sesler/altin.wav");
    cleared_rule3d(TAG_ITEM, ACT_WIN);
    rule_sound3d(1, "sesler/kazandin.wav");
    str js = scene_json3d();
    assert(_ed_match3(js, "sesler/altin.wav"), "carpisma sesi yazilmali");
    assert(_ed_match3(js, "sesler/kazandin.wav"), "bitince sesi yazilmali");

    // NÖBETÇİ: yükleme gerçekten dosyadan mı okuyor?
    scene3d_reset();
    hit_rule3d(TAG_PLAYER, TAG_ITEM, ACT_KILL, 0.0);
    rule_sound3d(0, "CURUK.wav");
    scene_load3d(js);
    assert_eq_int(rule_count3d(), 2);
    assert_eq_str(rule_sound_path3d(0), "sesler/altin.wav");
    assert_eq_str(rule_sound_path3d(1), "sesler/kazandin.wav");
}

// Sessiz kural dosyayı şişirmemeli — ama dönüşte de sessiz kalmalı.
func t_silent_rule_writes_no_key() {
    scene3d_reset(); ground3d(0.0);
    hit_rule3d(TAG_PLAYER, TAG_ITEM, ACT_COLLECT, 10.0);
    str js = scene_json3d();
    assert(!_ed_match3(js, "sound"), "sessiz kural 'sound' yazmamali");
    scene3d_reset();
    hit_rule3d(TAG_PLAYER, TAG_ITEM, ACT_KILL, 0.0);
    rule_sound3d(0, "CURUK.wav");
    scene_load3d(js);
    assert_eq_str(rule_sound_path3d(0), "");
}

// Ses ÖTEKİNİN yerinden gelmeli: altını NEREDE topladığın bilgisi bu.
func t_rule_sound_plays_at_other() {
    scene3d_reset(); ground3d(0.0);
    int p = spawn3(0.0, 1.0, 0.0, 1.2, 2.0, 1.2, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    spawn3(0.5, 1.0, 7.0, 1.0, 1.0, 1.0, GOLD, SHAPE_SPHERE, TAG_ITEM);
    // Uzakta: bu karede degmesin, ses de calmasin.
    hit_rule3d(TAG_PLAYER, TAG_ITEM, ACT_COLLECT, 10.0);
    rule_sound3d(0, "sesler/altin.wav");
    _dg_step(0.016667);
    assert_eq_int(_snd_last_slot3, 0 - 1);
    // Simdi yanina koy.
    _e3[1].z = 0.0;
    _dg_step(0.016667);
    // ESYANIN slotu (1), oyuncunun (0) DEGIL. Ses cagrisi eylemden SONRA
    // olsaydi esya coktan olmus olur ve buraya oyuncunun slotu yazilirdi.
    assert_eq_int(_snd_last_slot3, 1);
    assert(abs_f3(_snd_last_z3 - 0.0) < 0.001, "ses esyanin yerinde");
    assert(abs_f3(_snd_last_x3 - 0.5) < 0.001, "ses esyanin x'inde");
    assert_eq_int(_count_tag3(TAG_ITEM), 0);
}

// "bitince" kuralinda ortada carpisan cift YOK: ses konumsuz calmali,
// varlik dizisine uzanmamali.
func t_cleared_rule_sound_is_positionless() {
    scene3d_reset(); ground3d(0.0);
    spawn3(0.0, 1.0, 0.0, 1.2, 2.0, 1.2, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    spawn3(0.5, 1.0, 0.0, 1.0, 1.0, 1.0, GOLD, SHAPE_SPHERE, TAG_ITEM);
    hit_rule3d(TAG_PLAYER, TAG_ITEM, ACT_COLLECT, 10.0);
    cleared_rule3d(TAG_ITEM, ACT_WIN);
    rule_sound3d(1, "sesler/kazandin.wav");
    // NÖBETÇİ konum: slot -1 iken `_rl_snd3` varlık dizisine UZANMAMALI.
    // (`_e3[-1]` dizi dışı okuma; slot iddiası tek başına bunu görmüyordu —
    // enjeksiyon `sl >= 0`ı `sl >= -1` yapınca test yeşil kalmıştı.)
    _snd_last_x3 = 0.0 - 999.0;
    _snd_last_y3 = 0.0 - 999.0;
    _snd_last_z3 = 0.0 - 999.0;
    _dg_step(0.016667);
    _dg_step(0.016667);
    assert(won3d(), "on kosul: kazanilmis olmali");
    assert_eq_int(_snd_last_slot3, 0 - 1);
    assert(abs_f3(_snd_last_x3 + 999.0) < 0.001, "konumsuz seste konum YAZILMAMALI");
    assert(abs_f3(_snd_last_y3 + 999.0) < 0.001, "konumsuz seste konum YAZILMAMALI");
    assert(abs_f3(_snd_last_z3 + 999.0) < 0.001, "konumsuz seste konum YAZILMAMALI");
}

func t_sound_slot_prefers_other_then_me() {
    scene3d_reset(); ground3d(0.0);
    int a = spawn3(0.0, 1.0, 0.0, 1.0, 1.0, 1.0, RED, SHAPE_CUBE, TAG_ENEMY);
    int b = spawn3(4.0, 1.0, 0.0, 1.0, 1.0, 1.0, GOLD, SHAPE_CUBE, TAG_ITEM);
    // Ikisi de varsa OTEKI kazanir.
    assert_eq_int(_rl_snd_slot3(a, b), _slot_of3(b));
    // Oteki yoksa BEN.
    assert_eq_int(_rl_snd_slot3(a, 0 - 1), _slot_of3(a));
    // Ikisi de yoksa konumsuz.
    assert_eq_int(_rl_snd_slot3(0 - 1, 0 - 1), 0 - 1);
}

// Ses de varlik kaydindan geciyor: ayni yol iki kez yuklenmemeli ve
// model/doku ile AYNI yol farkli kayitlar olmali.
func t_sound_uses_asset_registry() {
    int n0 = asset_count3d();
    asset_sound3d("SES_A.wav");
    asset_sound3d("SES_A.wav");
    assert_eq_int(asset_count3d(), n0 + 1);
    int k = _as_find3("SES_A.wav", AS_SOUND3);
    assert(k >= 0, "ses kaydi acilmali");
    assert_eq_int(asset_kind3d(k), AS_SOUND3);
    // Ayni yol model olarak istenirse AYRI kayit.
    asset_model3d("SES_A.wav");
    assert_eq_int(asset_count3d(), n0 + 2);
    assert(AS_SOUND3 != AS_MODEL3 && AS_SOUND3 != AS_TEX3, "tur sabitleri ayrik olmali");
}


// Şablonlar KUTUDAN ÇIKTIĞI GİBİ duyulmalı: sessiz bir şablon "ses nasıl
// eklenir" sorusunu hiç sordurmuyordu, ve şablon editörün ilk ekranı.
func t_templates_have_sounds() {
    array kk = [TPL_TOPLAYICI, TPL_ARENA, TPL_PLATFORM];
    int i = 0;
    while (i < length(kk)) {
        scene3d_reset();
        ed_template3d(kk[i]);
        assert(rule_count3d() > 0, "sablonun kurali olmali");
        int j = 0;
        while (j < rule_count3d()) {
            str sp = rule_sound_path3d(j);
            assert(sp != "", "sablonun her kuralinin sesi olmali (kural " + toString(j) + ")");
            // Dosya GERÇEKTEN durmalı — yol yazıp dosyayı koymamak sessiz
            // bir kırık bağ olurdu. (Depo kökünden çalıştırılıyor.)
            assert(file_exists(sp), "ses dosyasi depoda olmali: " + sp);
            j = j + 1;
        }
        i = i + 1;
    }
}

// Şablonun sesi gidiş-dönüşten de sağ çıkmalı: editörde OYNAT sahneyi
// JSON'a yazıp geri okuyor, sesler orada kaybolsa şablon yine sessizleşirdi.
func t_template_sounds_survive_roundtrip() {
    scene3d_reset();
    ed_template3d(TPL_TOPLAYICI);
    int once = rule_count3d();
    str js = scene_json3d();
    scene3d_reset();
    scene_load3d(js);
    assert_eq_int(rule_count3d(), once);
    int j = 0;
    while (j < rule_count3d()) {
        assert(rule_sound_path3d(j) != "", "ses gidis-donuste kaybolmamali");
        j = j + 1;
    }
}

// Kopan ses bağı SESSİZ: eksik model boş bir yer bırakır, eksik ses hiçbir
// iz bırakmaz. Denetim onu söylemeli.
func t_check_flags_missing_sound_file() {
    scene3d_reset(); ground3d(0.0);
    uret3(0.0, 1.0, 0.0, 1.0, 2.0, 1.0, BLUE, SHAPE_CUBE, TAG_PLAYER);
    uret3(3.0, 1.0, 0.0, 1.0, 1.0, 1.0, GOLD, SHAPE_SPHERE, TAG_ITEM);
    hit_rule3d(TAG_PLAYER, TAG_ITEM, ACT_COLLECT, 10.0);
    rule_sound3d(0, "OLMAYAN_SES.wav");
    cleared_rule3d(TAG_ITEM, ACT_WIN);
    // Denetim yalnız DENENMIS sesleri sayiyor; once yuklemeyi tetikle.
    asset_sound3d("OLMAYAN_SES.wav");
    scene_check3d();
    assert(_t_chk_has3("ses dosyasi yuklenemedi"), "yuklenemeyen ses soylenmeli");
    // Sesi kaldirinca uyari da gitmeli.
    rule_sound3d(0, "");
    scene_check3d();
    assert(!_t_chk_has3("ses dosyasi yuklenemedi"), "ses kaldirilinca uyari da gitmeli");
}


// ===========================================================================
// PLATFORM DESTEĞİ — kullanıcının OYNAYARAK bulduğu hata
//
// Zemin sorgusu düzlem + arazi + rampa biliyordu, KUTULARI bilmiyordu. Sonuç:
// PLATFORM şablonunda toplanacak altınlar platformların üstünde durmuyor,
// dibe düşüyordu (katı olmadıkları için MTV de onlara dokunmuyor). Salınan
// platform da üstündekini taşımıyordu — oyuncu karelerin %43'ünde havadaydı.
// ===========================================================================

func _pl_step(dt) { _s3_behaviors(dt); _s3_physics(dt); _s3_collision(); _s3_rules(); }

// Katı OLMAYAN bir cisim de platformun üstünde durmalı. MTV yalnız katı
// gövdeleri ayırıyor, yani eşyanın tek desteği zemin sorgusu.
func t_nonsolid_rests_on_platform() {
    scene3d_reset(); ground3d(0.0);
    // Platform: merkez y=2, kalinlik 0.6 -> ust yuzey 2.3
    uret3(0.0, 2.0, 0.0, 4.0, 0.6, 4.0, GRAY, SHAPE_CUBE, TAG_WALL);
    int g = uret3(0.0, 5.0, 0.0, 1.0, 1.0, 1.0, GOLD, SHAPE_SPHERE, TAG_ITEM);
    int gs = _slot_of3(g);
    assert_eq_int(_e3[gs].solid, 0);   // on kosul: KATI DEGIL
    int k = 0;
    while (k < 120) { _pl_step(0.016667); k = k + 1; }
    // Dinlenme: 2.3 + yaricap 0.5 = 2.8. Zemine duserse 0.5 olurdu.
    assert(abs_f3(_e3[gs].y - 2.8) < 0.01,
           "esya platformun ustunde dinlenmeli, y=" + toString(_e3[gs].y));
}

// Yandan gelen cisim platformun ÜSTÜNE IŞINLANMAMALI — destek testinin
// varlık sebebi bu. (Temas payı kadar bir basamak kabul; ondan yükseği hayır.)
func t_side_approach_does_not_teleport_up() {
    scene3d_reset(); ground3d(0.0);
    // Kalin bir duvar: ust yuzey 3.0, temas payindan (0.15) cok yuksek.
    uret3(0.0, 1.5, 0.0, 4.0, 3.0, 4.0, GRAY, SHAPE_CUBE, TAG_WALL);
    int p = uret3(0.0 - 6.0, 1.0, 0.0, 1.2, 2.0, 1.2, BLUE, SHAPE_CUBE, TAG_PLAYER);
    int ps = _slot_of3(p);
    int k = 0;
    while (k < 120) {
        _s3_behaviors(0.016667);
        _e3[ps].vx = 6.0;              // duvara dogru yuru
        _s3_physics(0.016667); _s3_collision(); _s3_rules();
        k = k + 1;
    }
    // Zeminde kalmali (y=1.0), duvarin ustune (3.0+1.0=4.0) cikmamali.
    assert(_e3[ps].y < 1.5, "yandan gelen cisim duvara TIRMANMAMALI, y=" +
           toString(_e3[ps].y));
}

// Hızlı düşen cisim ince platformu DELMEMELİ: karşılaştırma cismin kareye
// başlarkenki alt yüzeyiyle yapılıyor, o yüzden bir karede kalınlığı aşmak
// fark etmez. (Ölçüldü: -160 birim/sn ile eskiden geçip gidiyordu.)
func t_fast_fall_does_not_tunnel_platform() {
    scene3d_reset(); ground3d(0.0);
    uret3(0.0, 2.0, 0.0, 4.0, 0.6, 4.0, GRAY, SHAPE_CUBE, TAG_WALL);
    int p = uret3(0.0, 4.0, 0.0, 1.2, 2.0, 1.2, BLUE, SHAPE_CUBE, TAG_PLAYER);
    int ps = _slot_of3(p);
    _e3[ps].vy = 0.0 - 160.0;
    int k = 0;
    while (k < 60) { _pl_step(0.016667); k = k + 1; }
    // Dinlenme 2.3 + 1.0 = 3.3; delip gecerse 1.0 olurdu.
    assert(abs_f3(_e3[ps].y - 3.3) < 0.01,
           "hizli dusus platformu delmemeli, y=" + toString(_e3[ps].y));
}

// HAREKETLİ platform üstündekini taşımalı. Taşımazsa platform altından kaçar
// ve cisim düşer — "hareketli platform" diye bir şey kalmaz.
func t_moving_platform_carries_rider() {
    scene3d_reset(); ground3d(0.0);
    int pl = uret3(0.0, 5.0, 0.0, 4.0, 0.6, 4.0, GRAY, SHAPE_CUBE, TAG_WALL);
    salin_davranis3d(pl, 1.2, 0.8);
    int pls = _slot_of3(pl);
    int p = uret3(0.0, 6.3, 0.0, 1.2, 2.0, 1.2, BLUE, SHAPE_CUBE, TAG_PLAYER);
    int ps = _slot_of3(p);
    int havada = 0;
    int k = 0;
    float en_dusuk = 999.0;
    while (k < 240) {
        _pl_step(0.016667);
        if (_e3[ps].grounded == 0) { havada = havada + 1; }
        if (_e3[ps].y < en_dusuk) { en_dusuk = _e3[ps].y; }
        // Her karede platformun UZERINDE durmali: ayak = platform ustu.
        float ayak = _e3[ps].y - 1.0;
        float ust = _e3[pls].y + 0.3;
        assert(abs_f3(ayak - ust) < 0.02,
               "binici platformla birlikte gitmeli (kare " + toString(k) + ")");
        k = k + 1;
    }
    assert_eq_int(havada, 0);
    assert(en_dusuk > 3.0, "zemine dusmemeli");
}

// Zıplayan cisim eski platformunun hareketini TAŞIMAYA DEVAM ETMEMELİ.
func t_jumping_off_drops_support() {
    scene3d_reset(); ground3d(0.0);
    int pl = uret3(0.0, 5.0, 0.0, 4.0, 0.6, 4.0, GRAY, SHAPE_CUBE, TAG_WALL);
    salin_davranis3d(pl, 1.2, 0.8);
    int p = uret3(0.0, 6.3, 0.0, 1.2, 2.0, 1.2, BLUE, SHAPE_CUBE, TAG_PLAYER);
    int ps = _slot_of3(p);
    int k = 0;
    while (k < 30) { _pl_step(0.016667); k = k + 1; }
    assert(_e_sup3[ps] >= 0, "on kosul: platformda olmali");
    _e3[ps].vy = 14.0;              // zipla
    _pl_step(0.016667);
    assert_eq_int(_e_sup3[ps], 0 - 1);
    assert_eq_int(_e3[ps].grounded, 0);
}

// Platform ŞABLONUNUN altınları platformlarda durmali — kullanicinin
// bildirdigi hatanin ta kendisi.
func t_platform_template_items_rest_on_platforms() {
    scene3d_reset();
    ed_template3d(TPL_PLATFORM);
    int k = 0;
    while (k < 150) { _pl_step(0.016667); k = k + 1; }
    int i = 0;
    int yerde = 0;
    int say = 0;
    while (i < length(_e3)) {
        if (_e3[i].tag == TAG_ITEM && _e3[i].alive == 1) {
            say = say + 1;
            // Zemin dinlenmesi y=0.5; platformlarin en alcagi 2.8.
            if (_e3[i].y < 1.5) { yerde = yerde + 1; }
        }
        i = i + 1;
    }
    assert(say >= 4, "on kosul: sablonda altin olmali");
    assert_eq_int(yerde, 0);
}


// ---- Platform desteğinin KORUMALARI -----------------------------------------
// Aşağıdakiler mutlu yolu değil, YASAKLARI sınıyor. Hepsi KATI OLMAYAN bir
// cisim kullanıyor ve sebebi ölçüldü: katı gövdeyi MTV platformun dışına
// itiyor, yani merkezi ayak izine hiç girmiyor ve korumalar hiç çalışmıyor.
// Bu yüzden katı gövdeyle yazılmış ilk koruma testlerim BOŞTU — beş ayrı
// bozma testlerden kaçtı.


// Simetrinin KENDİSİ — döngüden değil, sorgudan. Yukarıdaki benzetim testi
// simetri kaldırılınca da yeşil kaldı ve sebebi öğreticiydi: destek bir kez
// kurulduktan sonra TAŞIMA cismi zaten yüzeye kilitliyor, yani simetri hiç
// sorulmuyor. Simetri yalnız DESTEKSİZ bir cisme yükselen platform yetişince
// devreye giriyor. Bu yüzden burada sorgu doğrudan çağrılıyor.
func t_support_test_counts_platform_motion() {
    scene3d_reset(); ground3d(0.0);
    int pl = uret3(0.0, 4.5, 0.0, 6.0, 0.6, 6.0, GRAY, SHAPE_CUBE, TAG_WALL);
    int pls = _slot_of3(pl);
    // 1. dizinleme: gecmis yok, degisim 0 (ust = 4.8).
    _plat_index3();
    // Platformu bir karede 0.5 YUKARI tasi (ust 4.8 -> 5.3).
    _e3[pls].y = 5.0;
    _plat_index3();
    assert(abs_f3(_plat_dy3[pls] - 0.5) < 0.001, "on kosul: degisim 0.5 olmali");
    // Kare BASINDA alt yuzeyi 5.0 olan cisim: ESKI ustun (4.8) uzerindeydi,
    // ama YENI ustun (5.3) 0.3 altinda — pay (0.15) bunu kurtarmaz.
    assert(0.3 > _PLAT_SKIN3, "on kosul: fark paydan buyuk olmali");
    float y = _plat_top3(0.0, 0.0, 5.0, 0.0);
    assert(abs_f3(y - 5.3) < 0.001,
           "yukselen platform, ustunde BASLAYAN cismi tasimali; donen=" + toString(y));
    assert_eq_int(_plat_hit3, pls);
    // Ters yon: ESKI ustun de ALTINDA baslayan cisim tasinmamali.
    float y2 = _plat_top3(0.0, 0.0, 4.0, 0.0);
    assert(abs_f3(y2 - 0.0) < 0.001, "altinda baslayan cisim tasinmamali");
    assert_eq_int(_plat_hit3, 0 - 1);
}

// Bir cisim ÜSTÜNDEKİ platforma ışınlanmamalı. Zemin 1.0'da: cismin alt
// yüzeyi 1.0, yani "kare başında yüzeyin üstünde miydi" testi yanlış
// kurulursa (ya da ilk-kare değişimi korunmazsa) yukarı çekilir.
func t_body_below_platform_not_lifted() {
    scene3d_reset(); ground3d(1.0);
    uret3(0.0, 5.0, 0.0, 6.0, 0.6, 6.0, GRAY, SHAPE_CUBE, TAG_WALL);
    int g = uret3(0.0, 1.5, 0.0, 1.0, 1.0, 1.0, GOLD, SHAPE_SPHERE, TAG_ITEM);
    int gs = _slot_of3(g);
    int k = 0;
    while (k < 90) { _pl_step(0.016667); k = k + 1; }
    // Zeminde kalmali (1.5). Platformun ustune cikarsa 5.8 olurdu.
    assert(_e3[gs].y < 2.0, "altindaki cisim platformun ustune cikmamali, y=" +
           toString(_e3[gs].y));
}

// Platform yalnız KENDİ ayak izindeki cismi taşımalı. Uzaktaki bir cisim,
// dikey testi geçse bile (yukarıdan düşerken alt yüzeyi platform üstünün
// üzerindedir) o platforma oturmamalı.
func t_platform_supports_only_its_footprint() {
    scene3d_reset(); ground3d(0.0);
    uret3(0.0, 2.0, 0.0, 4.0, 0.6, 4.0, GRAY, SHAPE_CUBE, TAG_WALL);
    // Platformdan 30 birim UZAKTA dusuyor.
    int g = uret3(30.0, 10.0, 0.0, 1.0, 1.0, 1.0, GOLD, SHAPE_SPHERE, TAG_ITEM);
    int gs = _slot_of3(g);
    int k = 0;
    while (k < 150) { _pl_step(0.016667); k = k + 1; }
    // Zemine inmeli (0.5). Uzaktaki platforma oturursa 2.8'de havada kalirdi.
    assert(abs_f3(_e3[gs].y - 0.5) < 0.01,
           "ayak izi disindaki cisim platforma oturmamali, y=" + toString(_e3[gs].y));
}

// Temas payı BASAMAK demek ve küçük kalmalı. 0.5 birimlik bir çıkıntıya
// yandan gelen cisim TIRMANMAMALI; pay büyütülürse tırmanır.
func t_contact_skin_does_not_become_a_staircase() {
    scene3d_reset(); ground3d(0.0);
    // ALCAK: x [-2,2], ust 2.3.  YUKSEK: x [2,6], ust 2.8 (0.5 daha yuksek).
    uret3(0.0, 2.0, 0.0, 4.0, 0.6, 4.0, GRAY, SHAPE_CUBE, TAG_WALL);
    uret3(4.0, 2.5, 0.0, 4.0, 0.6, 4.0, GRAY, SHAPE_CUBE, TAG_WALL);
    // Pay (0.15) bu basamaktan (0.5) KUCUK olmali, yoksa test bos olur.
    assert(_PLAT_SKIN3 < 0.5, "on kosul: pay basamaktan kucuk olmali");
    int g = uret3(0.0, 2.8, 0.0, 1.0, 1.0, 1.0, GOLD, SHAPE_SPHERE, TAG_ITEM);
    int gs = _slot_of3(g);
    int k = 0;
    while (k < 120) {
        _s3_behaviors(0.016667);
        _e3[gs].vx = 4.0;
        _s3_physics(0.016667); _s3_collision(); _s3_rules();
        k = k + 1;
    }
    // Yuksek platforma tirmanirsa 3.3'te kalirdi; dogru davranis zemine dusmek.
    assert(_e3[gs].y < 1.0, "0.5 birimlik basamaga tirmanmamali, y=" +
           toString(_e3[gs].y));
}

// Destek testi SİMETRİK olmalı: cismin düşüşü kadar PLATFORMUN yükselişi de
// sayılmalı. Hızlı yükselen bir platform üstündekini yutup geçmemeli.
// (Salınım hızı payı aşacak kadar yüksek seçildi: dy ~ genlik*2pi*hiz*dt.)
func t_fast_rising_platform_does_not_swallow_rider() {
    scene3d_reset(); ground3d(0.0);
    int pl = uret3(0.0, 5.0, 0.0, 6.0, 0.6, 6.0, GRAY, SHAPE_CUBE, TAG_WALL);
    salin_davranis3d(pl, 2.0, 3.0);
    int pls = _slot_of3(pl);
    int g = uret3(0.0, 5.8, 0.0, 1.0, 1.0, 1.0, GOLD, SHAPE_SPHERE, TAG_ITEM);
    int gs = _slot_of3(g);
    // On kosul: kare basina hareket temas payindan BUYUK olmali, yoksa
    // simetri sinanmadan sig-temas kurtarir ve test bos kalir.
    _pl_step(0.016667);
    _pl_step(0.016667);
    float dy = abs_f3(_plat_dy3[pls]);
    assert(dy > _PLAT_SKIN3, "on kosul: platform payi asacak kadar hizli (dy=" +
           toString(dy) + ")");
    int k = 0;
    float en_dusuk = 999.0;
    while (k < 240) {
        _pl_step(0.016667);
        if (_e3[gs].y < en_dusuk) { en_dusuk = _e3[gs].y; }
        k = k + 1;
    }
    // Yutulursa zemine (0.5) duserdi.
    assert(en_dusuk > 2.5, "hizli yukselen platform cismi yutmamali, en dusuk=" +
           toString(en_dusuk));
}

// KÜRE platform değil: bir kürenin "üstü" tek nokta, üzerinde durmak anlamlı
// değil ve MTV zaten yuvarlak gövdeleri kendi çözüyor.
func t_sphere_wall_is_not_a_platform() {
    scene3d_reset(); ground3d(0.0);
    uret3(0.0, 2.0, 0.0, 2.0, 2.0, 2.0, GRAY, SHAPE_SPHERE, TAG_WALL);
    int g = uret3(0.0, 8.0, 0.0, 1.0, 1.0, 1.0, GOLD, SHAPE_SPHERE, TAG_ITEM);
    int gs = _slot_of3(g);
    int k = 0;
    while (k < 150) { _pl_step(0.016667); k = k + 1; }
    // Kurenin sinir kutusu ustu 3.0 olurdu -> 3.5. Dogrusu zemine inmek.
    assert(abs_f3(_e3[gs].y - 0.5) < 0.01,
           "kure platform sayilmamali, y=" + toString(_e3[gs].y));
}


// ===========================================================================
// YÜZEY DOKUSU — `model_texture` motorda vardı, scene3d onu HİÇ çağırmıyordu
// ===========================================================================

func t_texture_roundtrips() {
    scene3d_reset(); ground3d(0.0);
    int d = uret3(0.0, 1.5, 0.0, 8.0, 3.0, 1.0, GRAY, SHAPE_CUBE, TAG_WALL);
    ad_ver3d(d, "duvar");
    set_texture3d(d, "dokular/tugla.png", 6.0);
    assert_eq_str(texture_src3d(d), "dokular/tugla.png");
    assert(abs_f3(texture_tile3d(d) - 6.0) < 0.001, "doseme kurulmali");
    str js = scene_json3d();
    assert(_ed_match3(js, "dokular/tugla.png"), "doku yolu yazilmali");

    // NÖBETÇİ: yükleme gerçekten dosyadan mı okuyor?
    scene3d_reset();
    int c = uret3(0.0, 0.0, 0.0, 1.0, 1.0, 1.0, RED, SHAPE_CUBE, TAG_PROP);
    set_texture3d(c, "CURUK.png", 99.0);
    scene_load3d(js);
    int d2 = bul3d("duvar");
    assert_eq_str(texture_src3d(d2), "dokular/tugla.png");
    assert(abs_f3(texture_tile3d(d2) - 6.0) < 0.001, "doseme de donmeli");
}

// Dokusuz varlık dosyayı şişirmemeli — ve dönüşte de dokusuz kalmalı.
func t_untextured_writes_no_key() {
    scene3d_reset(); ground3d(0.0);
    uret3(0.0, 1.0, 0.0, 1.0, 1.0, 1.0, GOLD, SHAPE_SPHERE, TAG_ITEM);
    str js = scene_json3d();
    assert(!_ed_match3(js, "\"texture\""), "dokusuz varlik anahtar yazmamali");
    scene3d_reset();
    int c = uret3(0.0, 0.0, 0.0, 1.0, 1.0, 1.0, RED, SHAPE_CUBE, TAG_PROP);
    set_texture3d(c, "CURUK.png", 3.0);
    scene_load3d(js);
    assert_eq_str(texture_src3d(_mk_handle3(0)), "");
}

// Varsayılan döşeme (1.0) yazılmamalı ama dönüşte doğru olmalı.
func t_default_tile_not_written() {
    scene3d_reset(); ground3d(0.0);
    int d = uret3(0.0, 1.0, 0.0, 1.0, 1.0, 1.0, WHITE, SHAPE_CUBE, TAG_WALL);
    set_texture3d(d, "a.png", 1.0);
    str js = scene_json3d();
    assert(!_ed_match3(js, "\"tile\""), "varsayilan doseme yazilmamali");
    scene3d_reset();
    scene_load3d(js);
    assert(abs_f3(texture_tile3d(_mk_handle3(0)) - 1.0) < 0.001, "varsayilan 1 olmali");
}

func t_texture_set_clear_and_duplicate() {
    scene3d_reset(); ground3d(0.0);
    int d = uret3(0.0, 1.0, 0.0, 1.0, 1.0, 1.0, WHITE, SHAPE_CUBE, TAG_WALL);
    set_texture3d(d, "a.png", 4.0);
    int kop = ed_duplicate3d(d);
    assert_eq_str(texture_src3d(kop), "a.png");
    assert(abs_f3(texture_tile3d(kop) - 4.0) < 0.001, "kopya dosemeyi de tasimali");
    clear_texture3d(d);
    assert_eq_str(texture_src3d(d), "");
    // Doseme de varsayilana donmeli, yoksa yeni doku eski sikliktan baslar.
    assert(abs_f3(texture_tile3d(d) - 1.0) < 0.001, "kaldirinca doseme sifirlanmali");
}

// Sıfır/negatif döşeme anlamsız (bölme ve gerdirme bozulur) — 1'e düşmeli.
func t_tile_never_zero() {
    scene3d_reset(); ground3d(0.0);
    int d = uret3(0.0, 1.0, 0.0, 1.0, 1.0, 1.0, WHITE, SHAPE_CUBE, TAG_WALL);
    set_texture3d(d, "a.png", 0.0);
    assert(abs_f3(texture_tile3d(d) - 1.0) < 0.001, "sifir doseme 1'e dusmeli");
    set_texture3d(d, "a.png", 0.0 - 3.0);
    assert(abs_f3(texture_tile3d(d) - 1.0) < 0.001, "negatif doseme 1'e dusmeli");
}

// Doku da varlık kaydından geçiyor ve model/ses ile AYNI yol farklı kayıt.
func t_texture_uses_asset_registry() {
    int n0 = asset_count3d();
    asset_texture3d("DOKU_A.png");
    asset_texture3d("DOKU_A.png");
    assert_eq_int(asset_count3d(), n0 + 1);
    int k = _as_find3("DOKU_A.png", AS_TEX3);
    assert(k >= 0 && asset_kind3d(k) == AS_TEX3, "doku kaydi acilmali");
}

// Şablonlar dokulu olmalı ve dosyalar depoda durmalı.
func t_templates_are_textured() {
    array kk = [TPL_TOPLAYICI, TPL_ARENA, TPL_PLATFORM];
    int i = 0;
    while (i < length(kk)) {
        scene3d_reset();
        ed_template3d(kk[i]);
        int dokulu = 0;
        int j = 0;
        while (j < length(_e3)) {
            str t = _e3[j].tsrc;
            if (t != "") {
                dokulu = dokulu + 1;
                assert(file_exists(t), "doku dosyasi depoda olmali: " + t);
            }
            j = j + 1;
        }
        assert(dokulu >= 4, "sablonda dokulu varlik olmali (sablon " + toString(i) + ")");
        // Zemin dokusu da kurulu ve dosyasi var.
        str gt = ground_texture_path3d();
        assert(gt != "", "sablonun zemin dokusu olmali");
        assert(file_exists(gt), "zemin dokusu depoda olmali: " + gt);
        i = i + 1;
    }
}

// ===========================================================================
// SAHNE IŞIKLARI — `point_light` motorda vardı, HİÇ çağrılmıyordu
// ===========================================================================

func t_light_roundtrips() {
    scene3d_reset(); ground3d(0.0);
    light3d(4.0, 3.0, 0.0 - 2.0, GOLD, 14.0);
    str js = scene_json3d();
    assert(_ed_match3(js, "lights_at"), "isiklar yazilmali");
    // NOBETCI
    scene3d_reset();
    light3d(0.0, 0.0, 0.0, RED, 1.0);
    scene_load3d(js);
    assert_eq_int(light_count3d(), 1);
    assert(abs_f3(light_x3d(0) - 4.0) < 0.001, "x donmeli");
    assert(abs_f3(light_z3d(0) + 2.0) < 0.001, "z donmeli");
    assert(abs_f3(light_range3d(0) - 14.0) < 0.001, "menzil donmeli");
    assert_eq_int(light_color3d(0), GOLD);
}

// Işıksız sahne dosyayı şişirmemeli, ve öncekinin lambalarını devralmamalı.
func t_no_lights_writes_no_key() {
    scene3d_reset(); ground3d(0.0);
    str js = scene_json3d();
    assert(!_ed_match3(js, "lights_at"), "isiksiz sahne anahtar yazmamali");
    scene3d_reset();
    light3d(0.0, 0.0, 0.0, RED, 1.0);
    scene_load3d(js);
    assert_eq_int(light_count3d(), 0);
}

// Işıklar YERLEŞTİRİLMİŞ içerik: reset onları silmeli. Silmezse editörün
// OYNAT/DUR döngüsü her turda lambaları ÜST ÜSTE KOYAR (ölçüldü: üç turda
// 5 lamba 8 oldu) ve seçim yanlış üçlüyü yakar.
func t_reset_clears_lights() {
    scene3d_reset();
    light3d(1.0, 0.0, 0.0, RED, 5.0);
    light3d(2.0, 0.0, 0.0, BLUE, 5.0);
    assert_eq_int(light_count3d(), 2);
    scene3d_reset();
    assert_eq_int(light_count3d(), 0);
}

// Motorda dört yuva var, biri güneşin: aynı anda en çok ÜÇ nokta ışık.
// Motor kameraya en yakınları seçiyor.
func t_light_selection_picks_nearest() {
    scene3d_reset();
    light3d(0.0 - 20.0, 0.0, 0.0, RED, 10.0);    // 0: uzak
    light3d(2.0, 0.0, 0.0, GOLD, 10.0);          // 1: yakin
    light3d(0.0 - 4.0, 0.0, 0.0, GREEN, 10.0);   // 2: yakin
    light3d(30.0, 0.0, 0.0, BLUE, 10.0);         // 3: cok uzak
    light3d(8.0, 0.0, 0.0, WHITE, 10.0);         // 4: orta
    _lt_select3(0.0, 0.0, 0.0);
    assert_eq_int(length(_lt_pick3), light_slots3d());
    assert_eq_int(_lt_pick3[0], 1);
    assert_eq_int(_lt_pick3[1], 2);
    assert_eq_int(_lt_pick3[2], 4);
    // Dinleyici tasininca secim de degismeli.
    _lt_select3(30.0, 0.0, 0.0);
    assert_eq_int(_lt_pick3[0], 3);
}

// Yakınlık MENZİLE göre ölçülüyor: geniş menzilli bir projektör uzaktan da
// katkı verir, yanı başındaki bir mum vermez. Ham mesafe yanlış seçerdi.
func t_light_selection_weighs_range() {
    scene3d_reset();
    light3d(1.0, 0.0, 0.0, RED, 0.5);        // cok yakin, cok dar
    light3d(20.0, 0.0, 0.0, BLUE, 200.0);    // uzak, cok genis
    _lt_select3(0.0, 0.0, 0.0);
    assert_eq_int(_lt_pick3[0], 1);
}

// Işık sayısı yuvadan azsa hepsi seçilmeli (ve fazlası uydurulmamalı).
func t_light_selection_fewer_than_slots() {
    scene3d_reset();
    light3d(1.0, 0.0, 0.0, RED, 5.0);
    _lt_select3(0.0, 0.0, 0.0);
    assert_eq_int(length(_lt_pick3), 1);
    scene3d_reset();
    _lt_select3(0.0, 0.0, 0.0);
    assert_eq_int(length(_lt_pick3), 0);
}

// Silme SIRAYI korumali: indeksler sahne dosyasinda ve editor seciminde
// kullaniliyor, son elemani yerine takas etmek yanlis isigi secili birakirdi.
func t_light_delete_preserves_order() {
    scene3d_reset();
    // DÖRT ışık şart: üç ışıkta ortadakini silmek kaydırma ile takas aynı
    // sonucu veriyor ([1,3]) ve test hiçbir şey ayırt etmiyor — enjeksiyon
    // tam bundan kaçtı. Dörtte ayrışıyorlar: kaydırma [1,3,4], takas [1,4,3].
    light3d(1.0, 0.0, 0.0, RED, 5.0);
    light3d(2.0, 0.0, 0.0, GREEN, 5.0);
    light3d(3.0, 0.0, 0.0, BLUE, 5.0);
    light3d(4.0, 0.0, 0.0, WHITE, 5.0);
    light_del3d(1);
    assert_eq_int(light_count3d(), 3);
    assert(abs_f3(light_x3d(0) - 1.0) < 0.001, "ilk isik yerinde kalmali");
    assert(abs_f3(light_x3d(1) - 3.0) < 0.001, "ucuncu isik ikinciye kaymali");
    assert(abs_f3(light_x3d(2) - 4.0) < 0.001, "dorduncu isik ucuncuye kaymali");
    assert_eq_int(light_color3d(1), BLUE);
    assert_eq_int(light_color3d(2), WHITE);
    // Gecersiz indeks cokmemeli.
    assert_eq_int(light_del3d(9), 0);
    assert_eq_int(light_del3d(0 - 1), 0);
    assert_eq_int(light_count3d(), 3);
}

// Menzil SIFIR olamaz: yakınlık ölçüsü menzile BÖLÜYOR, sıfır menzil sıfıra
// bölme demek ve seçim çöker.
func t_light_range_never_zero() {
    scene3d_reset();
    int a = light3d(0.0, 0.0, 0.0, RED, 0.0);
    assert(light_range3d(a) > 0.0, "sifir menzil kabul edilmemeli");
    int b = light3d(1.0, 0.0, 0.0, RED, 0.0 - 4.0);
    assert(light_range3d(b) > 0.0, "negatif menzil kabul edilmemeli");
    // Sonradan da sifirlanamamali.
    light_set_range3d(a, 0.0);
    assert(light_range3d(a) > 0.0, "menzil sonradan da sifirlanamamali");
    // Secim yine calismali (sifira bolme yok).
    _lt_select3(0.0, 0.0, 0.0);
    assert_eq_int(length(_lt_pick3), 2);
}

// Editörün renk döngüsü kendini tekrar etmeli (kapalı halka) ve her rengin
// bir ADI olmalı — isimsiz bir renk düğmesi "ozel" der ve kullanıcı hangi
// rengi seçtiğini bilemez.
func t_light_color_cycle_is_closed() {
    int c = WHITE;
    array gorulen = [];
    int i = 0;
    while (i < 6) {
        push(gorulen, c);
        assert(_ed_lt_col_nm3(c) != "ozel", "dongudeki her rengin adi olmali");
        c = _ed_lt_next_col3(c);
        i = i + 1;
    }
    assert_eq_int(c, WHITE);
    // Alti renk de AYRI olmali.
    int a = 0;
    while (a < length(gorulen)) {
        int b = a + 1;
        while (b < length(gorulen)) {
            assert(gorulen[a] != gorulen[b], "dongude ayni renk iki kez olmamali");
            b = b + 1;
        }
        a = a + 1;
    }
}


// Boş yuva KAPATILMALI. Motor çağrıları (`point_light`/`light_off`)
// penceresiz hiçbir şey yapmıyor, o yüzden sınanan şey KARAR: hangi yuvaya
// hangi ışık, hangisi kapalı.
func t_unused_light_slots_are_turned_off() {
    scene3d_reset();
    light3d(1.0, 0.0, 0.0, RED, 5.0);
    _lt_select3(0.0, 0.0, 0.0);
    assert_eq_int(_lt_slot_light3(0), 0);
    // Tek isik var, gerisi KAPALI olmali.
    assert_eq_int(_lt_slot_light3(1), 0 - 1);
    assert_eq_int(_lt_slot_light3(2), 0 - 1);
    // Yuva sinirinin disi da kapali.
    assert_eq_int(_lt_slot_light3(light_slots3d()), 0 - 1);
    assert_eq_int(_lt_slot_light3(0 - 1), 0 - 1);
    // Isiklar yuvalari doldurunca hicbiri kapali olmamali.
    light3d(2.0, 0.0, 0.0, GREEN, 5.0);
    light3d(3.0, 0.0, 0.0, BLUE, 5.0);
    _lt_select3(0.0, 0.0, 0.0);
    int k = 0;
    while (k < light_slots3d()) {
        assert(_lt_slot_light3(k) >= 0, "dolu yuva kapali olmamali");
        k = k + 1;
    }
    // Isiklar silinince yuvalar yeniden kapanmali.
    scene3d_reset();
    _lt_select3(0.0, 0.0, 0.0);
    assert_eq_int(_lt_slot_light3(0), 0 - 1);
}

func t_light_widget_ids_do_not_collide() {
    int base = _ed_lt_idbase3();
    int step = _ed_lt_idstep3();
    int used = _ed_lt_idused3();
    assert(step > used, "adim kullanilandan buyuk olmali");
    int alt = base;
    int ust = base + 200 * step + used - 1;
    assert(52900 < alt || 52900 > ust, "ekleme dugmesi isik araligina girmemeli");
    // Doku tarayicisi 52000-52051 ve ekleme dugmesi 52900 ile de carpismamali.
    assert(52051 < alt || 52000 > ust, "doku tarayicisi isik araligina girmemeli");
    assert(52900 > 52051, "ekleme dugmesi doku tarayicisinin da disinda olmali");
    // Kural blogu (60000+) ile de.
    int rl_alt = _ed_rl_idbase3();
    assert(ust < rl_alt, "isik ve kural araliklari ayrik olmali");
}

test("varlik kaydi ayni yolu iki kez yuklemiyor", "t_asset_registry_caches");
test("varlik kaydi model ve dokuyu ayiriyor", "t_asset_registry_separates_kinds");
test("model yolu yaziliyor ve gidis-donusten sag cikiyor", "t_asset_src_serialized_and_roundtrips");
test("yuklenemeyen model bile yolunu kaybetmiyor", "t_asset_src_written_even_when_load_failed");
test("yol dosyadaki ham handle'i yeniyor", "t_asset_path_beats_handle");
test("json dizesi kacisliyor", "t_sc_q3_escapes_json_strings");
test("tuhaf karakterli yol gidis-donusten sag cikiyor", "t_asset_weird_path_survives_roundtrip");
test("model atama sekli de kuruyor, kaldirma da geri aliyor", "t_set_and_clear_model3d");
test("cogaltma model yolunu tasiyor", "t_duplicate_copies_model_src");
test("zemin dokusu gidis-donusten sag cikiyor", "t_ground_texture_roundtrips");
test("dokusuz sahne oncekinin dokusunu devralmiyor", "t_ground_texture_cleared_when_absent");
test("yol son parcasina iniyor", "t_ed_basename_takes_last_component");
test("varlik listesi kaydirmasi kelepceli", "t_ed_asset_scroll_clamped");
test("varlik taramasi gercek dosya buluyor", "t_ed_asset_scan_finds_real_files");
test("varlik yukleme durumu ucusa ayriliyor", "t_ed_asset_loaded_state");
test("denetim eksik model dosyasini soyluyor", "t_check_flags_missing_model_files");
test("animasyon hizi gidis-donusten sag cikiyor", "t_anim_fps_survives_roundtrip");
test("varsayilan animasyon hizi dosyayi sismiyor", "t_anim_fps_default_not_written");
