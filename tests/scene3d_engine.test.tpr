// Varlık adı editörden değiştirilebilmeli: kamera hedefi ve kurallar
// varlıklara ADLA atıfta bulunuyor, yani adsız varlık hedeflenemiyor.
func t_ed_rename_replaces_not_appends() {
    scene3d_reset();
    no_ground3d();
    int a = spawn3(0.0, 1.0, 0.0, 1.0, 1.0, 1.0, GOLD, SHAPE_CUBE, TAG_PROP);
    rename3d(a, "eski");
    assert_eq_int(bul3d("eski"), a);
    rename3d(a, "yeni");
    // Eski ad DÜŞMELİ: aynı handle için iki kayıt kalırsa serileştirme
    // hangisini yazacağını bilemez ve `_sc_nm_of3` ilk bulduğunu döndürdüğü
    // için eski ad kazanırdı.
    assert_eq_int(bul3d("eski"), 0 - 1);
    assert_eq_int(bul3d("yeni"), a);
    assert(_sc_nm_of3(a) == "yeni", "geri okuma da yeni ad olmali");
}

func t_ed_rename_survives_roundtrip() {
    scene3d_reset();
    no_ground3d();
    int a = spawn3(2.0, 1.0, 3.0, 1.0, 1.0, 1.0, GOLD, SHAPE_CUBE, TAG_PROP);
    rename3d(a, "kapi");
    scene_load3d(scene_json3d());
    int b = bul3d("kapi");
    assert(b >= 0, "ad gidis-donusten sag cikmali");
    assert(abs_f3(get3x(b) - 2.0) < 0.001, "dogru varliga bagli kalmali");
}

// Adı boşaltmak kaydı düşürmeli — "" adıyla arama yapılamaz.
func t_ed_rename_to_empty_clears() {
    scene3d_reset();
    no_ground3d();
    int a = spawn3(0.0, 1.0, 0.0, 1.0, 1.0, 1.0, GOLD, SHAPE_CUBE, TAG_PROP);
    rename3d(a, "x");
    rename3d(a, "");
    assert(_sc_nm_of3(a) == "", "ad silinmeli");
    assert_eq_int(bul3d("x"), 0 - 1);
}

