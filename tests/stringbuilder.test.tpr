// Regression: StringBuilder builtins (2026-07-21 fix).
//
// sb_append was declared with the raw VMValue aggregate as a by-value
// parameter — the SysV lowering trap documented at
// llvm_make_vmvalue_func_type — so the callee received a corrupted VMValue
// and the very first sb_append segfaulted (the feature was dead on arrival;
// nothing in lib/ or examples/ exercised it). It now goes through the
// aot_*_ptr pointer ABI. The sb_* entry points also gained null-handle
// guards: sb_append(0, ...) is ignored instead of crashing the process.
// Run: ./tulpar tests/stringbuilder.test.tpr
import "test";

func run_basic_append() {
    var sb = StringBuilder(64);
    sb_append(sb, "merhaba");
    sb_append(sb, " ");
    sb_append(sb, "dunya");
    assert_eq_str(sb_tostring(sb), "merhaba dunya");
    sb_free(sb);
}

func run_mixed_types() {
    var sb = StringBuilder(16);
    sb_append(sb, "n=");
    sb_append(sb, 42);
    sb_append(sb, " f=");
    sb_append(sb, 3.5);
    sb_append(sb, " b=");
    sb_append(sb, true);
    assert_eq_str(sb_tostring(sb), "n=42 f=3.5 b=true");
    sb_free(sb);
}

func run_growth() {
    // Force several capacity doublings past the initial 64 bytes.
    var sb = StringBuilder(64);
    for (int i = 0; i < 1000; i = i + 1) {
        sb_append(sb, "x");
    }
    assert_eq_int(length(sb_tostring(sb)), 1000);
    sb_free(sb);
}

func run_null_handle_safe() {
    // A zero/invalid handle must be a no-op, not a segfault.
    sb_append(0, "x");
    assert_eq_str(sb_tostring(0), "");
    sb_free(0);
    assert_eq_bool(true, true);
}

print("=== StringBuilder ===");
test("basic append + tostring", "run_basic_append");
test("mixed-type appends", "run_mixed_types");
test("capacity growth to 1000", "run_growth");
// HESAPLANMIS tamsayi eklemek KUTULAMASIZ hizli yoldan geciyor (2026-09-03).
// Etiket INT ise VMValue yigina yazilmadan dogrudan i64 geciyor; oteki her
// sey eski genel yola dusuyor. Bu testler iki yolun da AYNI metni urettigini
// kilitliyor — hizli yol bir kisayol, ayri bir semantik degil.
func run_int_fast_path() {
    var sb = StringBuilder(64);
    int i = 0;
    while (i < 5) { sb_append(sb, i * 7); sb_append(sb, "-"); i = i + 1; }
    assert_eq_str(sb_tostring(sb), "0-7-14-21-28-");
    sb_free(sb);
}

func run_int_edges() {
    var sb = StringBuilder(64);
    sb_append(sb, 0);
    sb_append(sb, "|");
    sb_append(sb, 0 - 42);
    sb_append(sb, "|");
    sb_append(sb, 9223372036854775807);
    assert_eq_str(sb_tostring(sb), "0|-42|9223372036854775807");
    sb_free(sb);
}

// Karisik turler: hizli yol yalniz INT'te devreye girmeli, otekiler
// bozulmadan genel yoldan gecmeli.
func run_mixed_after_fast_path() {
    var sb = StringBuilder(16);
    int n = 3;
    sb_append(sb, n * 2);
    sb_append(sb, " ");
    sb_append(sb, 1.5);
    sb_append(sb, " ");
    sb_append(sb, false);
    sb_append(sb, " ");
    sb_append(sb, "son");
    assert_eq_str(sb_tostring(sb), "6 1.5 false son");
    sb_free(sb);
}

test("null handle is safe", "run_null_handle_safe");
// int64 rakamlarini DOGRUDAN tampona yazma (2026-09-05).
//
// Eskiden once yigindaki gecici tampona yazilip sonra memcpy'leniyordu.
// Simdi dogrudan; bu yuzden BUYUME hesabi degisti: her cagri sabit 24
// bayt (20 hane + isaret + NUL, ustune pay) garanti ediyor. Risk tam
// burada — az yer ayirmak tasma demek. Bu testler kucuk kapasiteyle
// baslayip buyume yolunu bilerek zorluyor.
//
// Enjeksiyonla dogrulandi: ayrilan yeri 24'ten kucultunce kirmizi doner.
func run_kucuk_kapasiteden_buyume() {
    var sb = StringBuilder(1);            // 1 bayt: her ekleme buyutuyor
    sb_append(sb, 9223372036854775807);   // 19 hane
    sb_append(sb, "|");
    sb_append(sb, -9223372036854775807);  // 19 hane + isaret
    str r = sb_tostring(sb);
    sb_free(sb);
    assert_eq_str(r, "9223372036854775807|-9223372036854775807");
}

func run_cok_ekleme() {
    var t = StringBuilder(1);
    int i = 0;
    while (i < 1000) { sb_append(t, i); i = i + 1; }
    str r = sb_tostring(t);
    sb_free(t);
    // 0-9 (10x1) + 10-99 (90x2) + 100-999 (900x3) = 2890
    assert_eq_int(len(r), 2890);
}

// Hizli yol (int) ile genel yol (dizgi/float/bool) art arda bozulmamali.
func run_karisik_siralama() {
    var sb = StringBuilder(2);
    sb_append(sb, 0);
    sb_append(sb, -1);
    sb_append(sb, "|");
    sb_append(sb, 3.5);
    sb_append(sb, true);
    sb_append(sb, 42);
    str r = sb_tostring(sb);
    sb_free(sb);
    assert_eq_str(r, "0-1|3.5true42");
}

test("kucuk kapasiteden buyume", "run_kucuk_kapasiteden_buyume");
test("cok ekleme", "run_cok_ekleme");
test("karisik siralama", "run_karisik_siralama");
test_summary();
test("hesaplanmis int hizli yol", "run_int_fast_path");
test("int sinir degerleri", "run_int_edges");
test("hizli yoldan sonra karisik turler", "run_mixed_after_fast_path");
