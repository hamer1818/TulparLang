import "test";

// Dongu-degismezi DIZI SEKLI onbellegi — dogruluk paketi.
//
// Optimizasyon: dizinin idata/count'u dongu basinda bir kez okunup yerelde
// tutuluyor (src/aot/llvm_array_shape.cpp + llvm_backend.cpp'deki
// emit_shape_cache_for_loop). Yanlis yapilirsa sonuc SESSIZ bozulma olur,
// o yuzden buradaki her test kasten bir varsayimi zorluyor.
//
// Enjeksiyonla dogrulandi (2026-09-03) — HANGI testin neyi yakaladigi:
//   * tazeleme kaldirilinca  -> "kutuya donus onbellegi tazeler" kirmizi
//   * cagri denetimi kaldirilinca -> "dongu icinde buyume" kirmizi (cop deger)
//   * yeniden baglama denetimi kaldirilinca -> "dizi yeniden baglanirsa" kirmizi
// "push onbellegi engeller" testi cagri denetimini TEK BASINA yakalamiyor
// (indeksleri onbellek sinirinin disinda kaliyor, yavas yola dusuyor);
// paketteki isi kapsam, yakalayan test buyume testi. Bu ayrimi yazmak sart:
// yakalamayan bir teste guvenmek [[Tuzaklar#1]] tuzagi.

// Onbellek, dongu icinde dizi KUTUYA DONERSE tazelenmeli. Tazelenmezse
// sonraki yazma serbest birakilmis eski depoya gider ve dizinin gercek
// icerigine hic islemez. Dongu DISINDA okuyarak yakaliyoruz — dongu icinde
// okumak yetmez, cunku serbest bellek eski degerleri hala tasiyor.
func run_kutuya_donus_tazeler() {
    int[] a = array_fill(6, 3);
    int i = 0;
    while (i < 6) {
        if (i == 2) { a[i] = 1.5; }   // kutuya doner, eski idata serbest
        if (i == 4) { a[i] = 99; }    // donusten SONRAKI int yazimi
        i = i + 1;
    }
    assert_eq_int(a[4], 99);
    assert_eq_int(a[0], 3);
}

// Govdede fonksiyon cagrisi varsa onbellek ALINMAMALI: `push` count'u ve
// idata'yi degistirir, bayat bir sekil sinir denetimini delerdi.
func run_push_onbellegi_engeller() {
    int[] e = array_fill(2, 4);
    int k = 0;
    int w = 0;
    while (k < 6) {
        e.push(k);
        w = w + e[k];
        k = k + 1;
    }
    assert_eq_int(w, 14);          // 4+4+0+1+2+3
    assert_eq_int(len(e), 8);
}

// Dizinin KENDISI dongu icinde yeniden baglanirsa onbellek alinmamali.
func run_yeniden_baglama() {
    int[] c = array_fill(3, 1);
    int[] d = array_fill(3, 9);
    int j = 0;
    int u = 0;
    while (j < 3) {
        if (j == 1) { c = d; }
        u = u + c[j];
        j = j + 1;
    }
    assert_eq_int(u, 19);          // 1 + 9 + 9
}

// Sinir disi erisim onbellekli yolda da yavas yola dusmeli (sessiz yok sayma).
func run_sinir_disi() {
    int[] b = array_fill(4, 7);
    int i = 0;
    while (i < 3) { b[i] = i; i = i + 1; }
    assert_eq_int(b[0] + b[3], 0 + 7);
    assert_eq_int(len(b), 4);
}

// Buyume dongu icinde: taban isaretci DEGISIR, onbellek bunu gormeli.
// (push cagri oldugu icin onbellek zaten alinmiyor — bu testin isi, o
// kuralin gercekten islediginden emin olmak.)
func run_buyume() {
    int[] a = array_fill(4, 1);
    int i = 0;
    int toplam = 0;
    while (i < 200) {
        a.push(i);
        toplam = toplam + a[0] + a[len(a) - 1];
        i = i + 1;
    }
    assert_eq_int(toplam, 20100);  // 200*1 + (0+..+199)
}

// `for` dongusu de onbellege giriyor (2026-09-04). Artim ifadesi kanita
// DAHIL: `i = i + 1` orada duruyor ve sekli degistiren bir sey icerebilirdi.
func run_for_dongusu() {
    int[] a = array_fill(10, 2);
    int t = 0;
    for (int i = 0; i < 10; i = i + 1) { a[i] = i; t = t + a[i]; }
    assert_eq_int(t, 45);
    assert_eq_int(a[9], 9);
}

// `for` govdesinde kutuya donus + sonrasinda int yazimi: while ile ayni
// tazeleme kurali burada da gecerli olmali.
func run_for_kutuya_donus() {
    int[] b = array_fill(6, 3);
    for (int i = 0; i < 6; i = i + 1) {
        if (i == 2) { b[i] = 1.5; }
        if (i == 4) { b[i] = 99; }
    }
    assert_eq_int(b[4], 99);
    assert_eq_int(b[0], 3);
}

// `for` govdesinde cagri varsa onbellek alinmamali.
func run_for_cagri_engeller() {
    int[] c = array_fill(2, 5);
    int w = 0;
    for (int i = 0; i < 6; i = i + 1) {
        c.push(i);
        w = w + c[i];
    }
    assert_eq_int(w, 5 + 5 + 0 + 1 + 2 + 3);
    assert_eq_int(len(c), 8);
}

// `for` ARTIMINDA sekli degistiren bir cagri: kanit artimi da taramazsa
// onbellek aliniyor, push realloc ediyor ve onbellekteki isaretci askida
// kaliyor. Sinir icindeki yazmalar hic yavas yola dusmedigi icin tazeleme
// de devreye girmiyor — bu yuzden etkiyi dongu DISINDA olcuyoruz.
func run_artim_cagrisi() {
    int[] a = array_fill(3, 1);
    for (int i = 0; i < 20; a.push(i)) {
        a[0] = i;
        i = i + 1;
    }
    assert_eq_int(a[0], 19);
    assert_eq_int(len(a), 23);
}

// `len` artik onbellekten karsilaniyor (2026-09-04). Dizi OLMAYAN degerler
// icin len_slot -1 tutuyor ve eski cagriya dusuluyor — bu testler tam
// olarak o ayrimi zorluyor.
func run_len_onbellek() {
    int[] a = array_fill(7, 2);
    int t = 0;
    for (int i = 0; i < len(a); i = i + 1) { t = t + a[i]; }
    assert_eq_int(t, 14);
    assert_eq_int(len(a), 7);
}

// Dizgi INDEKSLENIYOR: onbellege aday olarak giriyor ama dizi degil.
// Sekil doldurma bu durumda len_slot'a -1 yazmali, yoksa len(s) onbellekten
// yanlis deger doner. (Ilk yazilisinda dizgi indekslenmiyordu — aday bile
// olmadigi icin enjeksiyon hicbir sey yakalamiyordu.)
func run_len_dizgi() {
    str s = "merhaba";
    int t = 0;
    str ilk = "";
    for (int i = 0; i < 3; i = i + 1) {
        t = t + len(s);
        ilk = s[0];
    }
    assert_eq_int(t, 21);          // 3 * 7
    assert_eq_str(ilk, "m");
}

// Kutulu dizi (str[]): eleman erisimi eski yola duser AMA len dogru olmali.
func run_len_kutulu_dizi() {
    str[] b = ["bir", "iki", "uc"];
    int t = 0;
    for (int i = 0; i < len(b); i = i + 1) { t = t + len(b[i]); }
    assert_eq_int(t, 8);           // 3 + 3 + 2
    assert_eq_int(len(b), 3);
}

// Dongu icinde dizi buyurse len GUNCEL olmali (push cagri -> onbellek yok).
func run_len_buyume() {
    int[] c = array_fill(2, 1);
    int son = 0;
    for (int i = 0; i < 5; i = i + 1) { c.push(i); son = len(c); }
    assert_eq_int(son, 7);
    assert_eq_int(len(c), 7);
}

test("kutuya donus onbellegi tazeler", "run_kutuya_donus_tazeler");
test("push onbellegi engeller", "run_push_onbellegi_engeller");
test("dizi yeniden baglanirsa onbellek yok", "run_yeniden_baglama");
test("sinir disi yavas yola duser", "run_sinir_disi");
test("dongu icinde buyume", "run_buyume");
test("for dongusu", "run_for_dongusu");
test("for icinde kutuya donus", "run_for_kutuya_donus");
test("for icinde cagri onbellegi engeller", "run_for_cagri_engeller");
test("for artimindaki cagri", "run_artim_cagrisi");
test("len onbellekten", "run_len_onbellek");
test("len dizgide onbellege girmez", "run_len_dizgi");
test("len kutulu dizide dogru", "run_len_kutulu_dizi");
test("len buyume sonrasi guncel", "run_len_buyume");
test_summary();
