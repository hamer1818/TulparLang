// `%` operatörü — kalan.
//
//   ./tulpar tests/modulo.test.tpr
//
// Dilde `mod()` builtin'i vardı ama `%` yoktu; `7 % 3` sözcükleyici hatası
// veriyordu. İkisi AYNI şeyi yapıyor — `%` yalnız daha okunur bir yazım ve
// her dilde beklenen biçim.

import "test";

func t_mod_int() {
    assert_eq_int(7 % 3, 1);
    assert_eq_int(6 % 3, 0);
    assert_eq_int(1 % 3, 1);
    assert_eq_int(0 % 5, 0);
}

// İşaret BÖLÜNENDEN geliyor (C ve çoğu dille aynı). Farklı bir kural seçmek
// `mod()` ile ayrışırdı ve iki yazımın aynı şeyi yapması gerekiyor.
func t_mod_negative() {
    assert_eq_int((0 - 7) % 3, 0 - 1);
    assert_eq_int(7 % (0 - 3), 1);
    assert_eq_int((0 - 7) % (0 - 3), 0 - 1);
}

func t_mod_matches_builtin() {
    int i = 0;
    while (i < 20) {
        assert_eq_int(i % 7, mod(i, 7));
        i = i + 1;
    }
}

func t_mod_float() {
    float a = 7.5 % 2.0;
    assert(a > 1.49 && a < 1.51, "7.5 % 2.0 = 1.5, bulunan " + toString(a));
    float b = 5.0 % 2.5;
    assert(b < 0.001, "5.0 % 2.5 = 0");
}

// Önceliği `*` ve `/` ile AYNI olmalı: `2 + 7 % 3` = 2 + 1 = 3.
func t_mod_precedence() {
    assert_eq_int(2 + 7 % 3, 3);
    assert_eq_int(7 % 3 + 2, 3);
    assert_eq_int(2 * 7 % 3, 2);      // (2*7) % 3 = 14 % 3 = 2
    assert_eq_int(10 % 4 * 2, 4);     // (10%4) * 2 = 2*2
}

// Değişkenlerle (kutulu yol) da çalışmalı — sabitler derleme zamanında
// katlanabilir, o yüzden ayrıca sınanıyor.
func t_mod_variables() {
    int a = 17;
    int b = 5;
    assert_eq_int(a % b, 2);
    float x = 9.0;
    float y = 4.0;
    float r = x % y;
    assert(r > 0.99 && r < 1.01, "9.0 % 4.0 = 1");
}

test("tam sayi kalani", "t_mod_int");
test("negatif kalan", "t_mod_negative");
test("mod() ile ayni", "t_mod_matches_builtin");
test("ondalik kalan", "t_mod_float");
test("oncelik * / ile ayni", "t_mod_precedence");
test("degiskenlerle kalan", "t_mod_variables");
test_summary();
