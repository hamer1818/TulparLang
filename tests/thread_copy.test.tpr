// DERIN KOPYA SOZLESMESI: kopyayla girer, join'le cikar.
//
// Once `thread_create` argumani DOGRUDAN geciriyordu (cagiran ve isci ayni
// heap nesnesini paylasiyordu) ve `thread_join` HEP 0 donuyordu (P20).
// Paylasimi varsayilan yapmak yerine pahali ve gorunur kilan cizgi:
// argumanlar KOPYA girer, paylasmak isteyen `mutex_*` kullanir.
import "test";

func _kare(n) { return n * n; }

// P20: join iscinin donusunu tasir.
func run_join_sonuc_tasir() {
    int t = thread_create(_kare, 12);
    var r = thread_join(t);
    assert_eq_int(r, 144);
}

// P47: arguman DERIN kopyalanir — ana thread kaynagi mutasyona ugratsa bile
// isci kendi kopyasini gorur. "Kopya dediysem kopya."
json _kaynak = {"ad": "ilk"};
int _gordu = 0;
func _gozlemci(k) {
    sleep(400);
    if (k["ad"] == "ilk") { _gordu = 1; }
    return 0;
}
func run_arguman_derin_kopyalanir() {
    _gordu = 0;
    _kaynak["ad"] = "ilk";
    int t = thread_create(_gozlemci, _kaynak);
    _kaynak["ad"] = "DEGISTI";          // ana thread mutasyonu
    thread_join(t);
    assert_eq_int(_gordu, 1);           // isci kopyayi gordu
    assert_eq_str(_kaynak["ad"], "DEGISTI");
}

// Ic ice dizi de kopyalanir.
int _toplam = 0;
func _toplayici(a) {
    sleep(300);
    int i = 0; int t = 0;
    while (i < len(a)) { t = t + a[i]; i = i + 1; }
    _toplam = t;
    return t;
}
func run_ic_ice_dizi_kopyalanir() {
    int[] kaynak = [1, 2, 3];
    int t = thread_create(_toplayici, kaynak);
    push(kaynak, 100);                  // isci bunu GORMEMELI
    var r = thread_join(t);
    assert_eq_int(r, 6);                // 1+2+3, 100 yok
    assert_eq_int(len(kaynak), 4);      // ana thread'in kendi dizisi buyudu
}

// P30: muteks etkilesimi — kopya patikasi mutex semantigini bozmamali.
var _kilit = mutex_create();
int _sayac = 0;
int _biten = 0;
func _artir(id) {
    int i = 0;
    while (i < 20000) {
        mutex_lock(_kilit); _sayac = _sayac + 1; mutex_unlock(_kilit);
        i = i + 1;
    }
    mutex_lock(_kilit); _biten = _biten + 1; mutex_unlock(_kilit);
    return 0;
}
func run_muteks_kopya_sonrasi() {
    _sayac = 0; _biten = 0;
    int t = 0;
    while (t < 8) { thread_create(_artir, t); t = t + 1; }
    sleep(6000);
    assert_eq_int(_biten, 8);
    assert_eq_int(_sayac, 160000);      // 8 * 20000, kayip YOK
}

print("=== thread kopya sozlesmesi ===");
test("join iscinin donusunu tasir",     "run_join_sonuc_tasir");
test("arguman derin kopyalanir",        "run_arguman_derin_kopyalanir");
test("ic ice dizi de kopyalanir",       "run_ic_ice_dizi_kopyalanir");
test("muteks kopya sonrasi bozulmadi",  "run_muteks_kopya_sonrasi");
test_summary();
