// Regression: float-to-string uses shortest float32 round-trip.
//
// Tulpar floats carry 32-bit precision. Before the 2026-07-20 fix, toString
// used "%g" (6 sig-figs): it lost precision (1000000.5 -> "1e+06") — and a
// naive bump to higher fixed precision exposed float32 noise (3.14 ->
// "3.14000010490417"). Now it prints the shortest decimal that round-trips to
// the same float32. Run: ./tulpar tests/float_format.test.tpr
import "test";

func run_clean_small() {
    assert_eq_str(toString(3.14), "3.14");        // no float32 noise
    assert_eq_str(toString(1.0), "1");            // trailing .0 dropped
    assert_eq_str(toString(0.5), "0.5");
    assert_eq_str(toString(0.1 + 0.2), "0.3");    // not 0.30000004
}

func run_large_with_fraction() {
    assert_eq_str(toString(1000000.5), "1000000.5");  // was "1e+06"
}

func run_negative() {
    assert_eq_str(toString(0.0 - 0.5), "-0.5");
}

print("=== float toString (shortest round-trip) ===");
test("clean small floats", "run_clean_small");
test("large float keeps fraction", "run_large_with_fraction");
test("negative float", "run_negative");
test_summary();
