// Regression: float-to-string uses shortest DOUBLE round-trip.
//
// 2026-07-20'de toString "%g" (6 anlamli hane) idi: kesinlik kaybediyordu
// (1000000.5 -> "1e+06"). Duzeltme "ayni degere geri donen en kisa ondalik"
// oldu — dogru fikir, ama YANLIS TURE baglandi: bicimleyici degeri once
// `(float)`e yuvarliyordu ve gerekcesi "the LLVM backend uses a 32-bit float
// type" idi.
//
// O gerekce YANLIS: backend->float_type ilk gunden beri LLVMDoubleType,
// VMValue payload'i 8 bayt. Yani bicimleyici tuttugu sayidan BASKA bir sayi
// yaziyordu ve bu, parser'daki gercek kirpma hatasini da gizliyordu
// (ASTNode_C.value.float_value `float` idi). Ikisi de 2026-09-05'te
// duzeltildi; ayrintili tani + enjeksiyon notu:
// tests/float_precision.test.tpr ve tests/silent_failure_probe.py.
//
// Bu paket bicimin KENDISINI kilitliyor. Run: ./tulpar tests/float_format.test.tpr
import "test";

func run_clean_small() {
    assert_eq_str(toString(3.14), "3.14");        // no float32 noise
    assert_eq_str(toString(1.0), "1");            // trailing .0 dropped
    assert_eq_str(toString(0.5), "0.5");
    // "0.3" BEKLENMIYOR: double'da 0.1+0.2 gercekten 0.30000000000000004.
    // Eski beklenti float32 yuvarlamasini kodluyordu — yani testin kendisi
    // hatayi sabitliyordu. Python/Go/Rust/JS de bu sayiyi boyle basar.
    assert_eq_str(toString(0.1 + 0.2), "0.30000000000000004");
    assert_eq_str(toString(0.3), "0.3");          // literal 0.3 ise sade
}

func run_large_with_fraction() {
    assert_eq_str(toString(1000000.5), "1000000.5");  // was "1e+06"
}

func run_negative() {
    assert_eq_str(toString(0.0 - 0.5), "-0.5");
}


// 2026-08-26: kısa-gidiş-dönüş araması BİLİMSEL gösterimi de kabul ediyordu.
// "%g" üssü [-4, hassasiyet) aralığından çıkınca bilimsele geçiyor; en kısa
// hassasiyette bu SIRADAN sayılarda oluyordu — 30.0 "3e+01", 100.0 "1e+02".
// İkisi de gidiş-dönüş yapıyor, o yüzden döngü onları kabul ediyordu. Ama
// bu `print`in gösterdiği şey: kimse skoru ya da fps'i böyle yazmaz.
func run_whole_numbers_not_scientific() {
    assert_eq_str(toString(30.0), "30");
    assert_eq_str(toString(100.0), "100");
    assert_eq_str(toString(1234567.0), "1234567");
    assert_eq_str(toString(0.0), "0");
    assert_eq_str(toString(0.0 - 30.0), "-30");
}

// Sınırın ALTINDA/ÜSTÜNDE bilimsel gösterim KALMALI — düzeltme "bilimseli
// tümden kaldır" değil, "sıradan büyüklükte kullanma".
func run_extremes_stay_scientific() {
    assert_eq_str(toString(0.0001), "0.0001");     // sınırın içinde: düz
    assert_eq_str(toString(0.00001), "1e-05");     // sınırın altında: bilimsel
    float big = 1.0;
    int i = 0;
    while (i < 20) { big = big * 10.0; i = i + 1; }
    assert_eq_str(toString(big), "1e+20");         // sınırın üstünde: bilimsel
}

print("=== float toString (shortest round-trip) ===");
test("clean small floats", "run_clean_small");
test("large float keeps fraction", "run_large_with_fraction");
test("negative float", "run_negative");
test("tam sayilar bilimsel gosterime kacmiyor", "run_whole_numbers_not_scientific");
test("uc degerlerde bilimsel gosterim duruyor", "run_extremes_stay_scientific");
test_summary();
