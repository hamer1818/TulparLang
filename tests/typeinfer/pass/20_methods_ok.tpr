// Yontemler (K003, 2026-09-28): `r.area()` alicinin tipine gore `Rect.area`
// ya da `Circle.area`ya gider. Ayni adli serbest fonksiyonun (`area(int)`)
// imzasi yontem cagrisina UYGULANMAMALI — yanlis pozitif olurdu.

struct Rect { int w; int h; }
struct Circle { int r; }
func Rect.area(): int { return self.w * self.h; }
func Circle.area(): int { return self.r * self.r * 3; }
func Rect.scaled(int k): Rect { return { w: self.w * k, h: self.h * k }; }
func area(int n): int { return n * 100; }

Rect a = { w: 2, h: 3 };
Circle c = { r: 2 };
int x = a.area() + c.area();
Rect b = a.scaled(2);
int y = Rect.area(b);
int z = area(5);
print(x + y + z);
