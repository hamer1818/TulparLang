// Expected: typeinfer should reject a bad argument to an IMPORTED function.
//
// This is the regression guard for the gap that let the `assert` no-op live:
// the argument checker was already capable of rejecting `bool` against an
// `int` parameter, but typeinfer never opened a module's source, so it had no
// signature for anything in the stdlib. Every call into `test`, `wings`,
// `router`, `orm`, `scene3d`, `arcade` was unchecked.
//
// `assert_eq_int(int, int)` is declared in lib/test.tpr. Passing bools must be
// rejected — at a CALL boundary there is no bool→int coercion (unlike a store;
// see pass/05_bool_store_coerce.tpr), so the value really does stay a bool.

import "test";

func t_bad() {
    assert_eq_int(true, false);
}

test("imported signature is checked", t_bad);
test_summary();
