// Beklenen: struct'in dizgi OLMAYAN bir degerle aritmetigi reddedilmeli
// (2026-10-02).
//
// Dilde struct icin islec yok; ama codegen'in iki yolu iki farkli SESSIZ
// sonuc veriyordu (olculdu, typecheck tek kelime etmiyordu):
//   `p + 5`, `p * 2`, `p - n`  -> 0
//   `p + j` (json), `p + q`    -> "P { x: 1, y: 2 }3" dizgisi (#451'den
//                                 beri; once o da 0)
// Dizgi birlestirmesi (`"p=" + p`) serbest: pass/25_struct_concat_ok.tpr.

// EXPECT: [typecheck]
// EXPECT: struct 'P' and 'int' have no '+' operator
// EXPECT: struct 'P' and 'float' have no '+' operator
// EXPECT: struct 'P' and 'P' have no '+' operator
// EXPECT: struct 'P' and 'int' have no '-' operator
// EXPECT: struct 'P' and 'int' have no '*' operator
// EXPECT: struct 'P' and a dynamically typed ('json') value under '+'
// EXPECT: at line 28
// EXPECT: at line 32
// EXPECT: at line 35

struct P { int x; int y; }
func yap(): P { return { x: 5, y: 6 }; }

P p = { x: 1, y: 2 };
P q = { x: 3, y: 4 };
int n = 5;
print(p + n);
print(p + 1.5);
print(p + q);
print(p - n);
print(n * p);
json j = 3;
print(p + j);
print(yap() + 1);
