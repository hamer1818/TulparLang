test("while: adim > 1", "run_while_adim");
test("while: `<` bicimi", "run_while_kucuktur");
test("while: sinir diziden buyuk", "run_while_sinir_buyuk");
test("while: negatif baslangic", "run_while_negatif_baslangic");
test("while: negatif adim", "run_while_negatif_adim");
test("while: kutulu dizi", "run_while_kutulu");
test("while: float adim", "run_while_float_adim");
test("while: artim son ifade degil", "run_while_artim_ortada");
