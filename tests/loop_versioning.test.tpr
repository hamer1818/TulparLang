import "test";

// DONGU SURUMLEME (2026-09-05).
//
// `for (int i = C; i < len(a); i = i + K)` icinde `a[i]` sinir denetimi
// KANITLA gereksiz: dizi kutusuzken count == len, kosul ustten, C >= 0 ve
// K > 0 alttan sinirliyor. Ama bu yalniz dizi KUTUSUZ ise gecerli —
// kutuluysa idata NULL ve bekcisiz erisim COKERDI.
//
// Kosul dongu-degismezi ama LLVM disari cikaramiyor (yavas yoldaki
// tazeleme sekil yuvalarina yaziyor -> unswitch yapisal olarak imkansiz,
// olculdu). O yuzden dallanma ve IKI GOVDE codegen'de uretiliyor.
//
// Bu paket kanitin HER KOSULUNU ayri ayri kilitliyor. Enjeksiyonla
// dogrulandi: kosullardan biri kaldirilinca ya cikti bozuluyor ya cokuyor.

func run_temel() {
    int[] a = array_fill(10, 3);
    int t = 0;
    for (int i = 0; i < len(a); i = i + 1) { t = t + a[i]; }
    assert_eq_int(t, 30);
}

// KUTULU dizi: hizli surum kosmamali, genel surum dogru sonucu vermeli.
// (Hizli surum kosarsa idata NULL'dur ve program coker.)
func run_kutulu_dizi() {
    array c = [1, "iki", 3];
    int v = 0;
    for (int i = 0; i < len(c); i = i + 1) {
        if (i != 1) { v = v + c[i]; }
    }
    assert_eq_int(v, 4);
}

// Float iceren dizi de kutulu.
func run_float_dizi() {
    array f = [1.5, 2.5, 3.0];
    float s = 0.0;
    for (int i = 0; i < len(f); i = i + 1) { s = s + f[i]; }
    assert_close(s, 7.0, 0.000001);
}

// BOS dizi: count_slot 0 -> genel surum. Govde hic kosmuyor.
func run_bos_dizi() {
    int[] b = array_fill(0, 0);
    int u = 0;
    for (int i = 0; i < len(b); i = i + 1) { u = u + b[i]; }
    assert_eq_int(u, 0);
}

func run_tek_eleman() {
    int[] a = array_fill(1, 7);
    int t = 0;
    for (int i = 0; i < len(a); i = i + 1) { t = t + a[i]; }
    assert_eq_int(t, 7);
}

// break/continue iki surumde de dogru calismali.
func run_break_continue() {
    int[] a = array_fill(10, 3);
    int w = 0;
    for (int i = 0; i < len(a); i = i + 1) {
        if (i == 5) { break; }
        if (i == 2) { continue; }
        w = w + a[i];
    }
    assert_eq_int(w, 12);
}

// Artim 1 olmak zorunda degil.
func run_artim_iki() {
    int[] a = array_fill(10, 3);
    int x = 0;
    for (int i = 0; i < len(a); i = i + 2) { x = x + a[i]; }
    assert_eq_int(x, 15);
}

// Baslangic 0 olmak zorunda degil (ama >= 0 olmali).
func run_bastan_degil() {
    int[] a = [1, 2, 3, 4, 5];
    int t = 0;
    for (int i = 2; i < len(a); i = i + 1) { t = t + a[i]; }
    assert_eq_int(t, 12);
}

// Ic ice: yalniz EN DIS dongu surumleniyor, ic dongu bekcili kaliyor.
func run_ic_ice() {
    int[] d = array_fill(4, 2);
    int y = 0;
    for (int i = 0; i < len(d); i = i + 1) {
        for (int j = 0; j < len(d); j = j + 1) { y = y + d[j]; }
    }
    assert_eq_int(y, 32);
}

// KANIT INDEKSI SADECE `i` — `a[i+1]` bekciyi KORUMAK ZORUNDA.
func run_farkli_indeks() {
    int[] a = [10, 20, 30];
    int t = 0;
    for (int i = 0; i < len(a); i = i + 1) {
        if (i + 1 < len(a)) { t = t + a[i + 1]; }
    }
    assert_eq_int(t, 50);
}

// AYNI SEY ama SINIR DISINA CIKARAK. Kanit yalniz `a[i]` icin gecerli;
// `a[i + 1]` son turda a[len] okuyor ve BEKCIYE takilmali (hata basip 0
// donuyor). Bekci kalkarsa tamponun disi okunur ve toplam bozulur.
//
// Ilk yazilan bu testte `if (i + 1 < len(a))` korumasi vardi, yani hic
// tasmiyordu ve indeks denetimini kaldiran enjeksiyon YESIL kaliyordu —
// test hicbir sey olcmuyordu. Koruma bilerek KALDIRILDI.
// SOZLESME 2026-09-10'da DEGISTI. Once bu test "sinir disi okuma 0 dondurur
// ve dongu devam eder" diye yazilmisti — o, BUGUNKU DAVRANISI belgeliyordu,
// hedef sozlesmeyi degil. Artik sinir disi erisim FIRLATIYOR; testin asil
// amaci (bekcinin VAR oldugunu kanitlamak) firlatmayla daha guclu karsilaniyor:
// eskiden bir eleman tasmak yetmiyordu (malloc yuvarlamasi 0 dondurup
// enjeksiyonu yesil birakiyordu) ve uzagi okumak gerekiyordu; simdi TEK eleman
// tasmasi bile gozlemlenebilir.
//
// Yoklugu bekleyen kod icin mesru yol `at(dizi, i, varsayilan)` — yumusaklik
// ortamda degil, ERISIMCIDE yasar.
func run_sinir_disi_indeks() {
    int[] a = array_fill(64, 7);

    // Bekci var mi? Tek eleman tasmasi firlatmali.
    bool firladi = false;
    try { int x = a[64]; } catch (e) { firladi = true; }
    assert(firladi, "sinir disi OKUMA firlatmali — bekci yok!");

    // Uzak tasma da ayni sekilde.
    int[] b = array_fill(4, 9);
    bool uzak = false;
    try { int y = b[4096]; } catch (e) { uzak = true; }
    assert(uzak, "uzak sinir disi okuma firlatmali");

    // Sinirlar ICINDE hicbir sey degismedi.
    int t = 0;
    for (int i = 0; i < len(a); i = i + 1) { t = t + a[i]; }
    assert_eq_int(t, 64 * 7);
}

// Yoklugu BEKLEYEN kodun mesru yolu.
func run_sinir_disi_erisimci() {
    int[] a = array_fill(64, 7);
    assert_eq_int(at(a, 64, -1), -1);      // tasma -> varsayilan, tani yok
    assert_eq_int(at(a, 4096, -1), -1);
    assert_eq_int(at(a, 0, -1), 7);        // gecerli indeks etkilenmedi
}

// Govdede eleman yazmasi + OKUMASI. Yazilan deger `a[i] + 1`, yani bir
// ARRAY_ACCESS: kutusuz oldugunu kanitlayamiyoruz (baska bir dizi kutulu
// olabilir), o yuzden kanit DUSUYOR ve dongu bekcili kaliyor. Sonuc her
// halukarda dogru olmali.
func run_govdede_yazma() {
    int[] a = array_fill(5, 1);
    int t = 0;
    for (int i = 0; i < len(a); i = i + 1) {
        a[i] = a[i] + 1;
        t = t + a[i];
    }
    assert_eq_int(t, 10);
}

// Dongu ICINDE diziyi KUTULAYAN yazma. Yazma oldugu icin hizli surum
// zaten acilmiyor; sonuc dogru olmali ve program COKMEMELI.
func run_donguda_kutulama() {
    array a = array_fill(6, 1);
    float t = 0.0;
    for (int i = 0; i < len(a); i = i + 1) {
        if (i == 2) { a[i] = 2.5; }
        t = t + a[i];
    }
    // 1+1+2.5+1+1+1 = 7.5  (alti eleman)
    assert_close(t, 7.5, 0.000001);
}

// Takma ad: `b` ile `a` AYNI diziyi gosteriyor; b uzerinden kutulama.
func run_takma_ad() {
    array a = array_fill(6, 1);
    array b = a;
    float t = 0.0;
    for (int i = 0; i < len(a); i = i + 1) {
        if (i == 3) { b[i] = 9.5; }
        t = t + a[i];
    }
    // 1+1+1+9.5+1+1 = 14.5  (alti eleman)
    assert_close(t, 14.5, 0.000001);
}

// Dongu degiskeni govdede DEGISTIRILIRSE kanit dusmeli.
func run_ivar_degisiyor() {
    int[] a = array_fill(8, 2);
    int t = 0;
    for (int i = 0; i < len(a); i = i + 1) {
        t = t + a[i];
        if (i == 1) { i = i + 3; }
    }
    // i: 0,1(sonra 4->5),6,7  -> a[0],a[1],a[5]... artim ile: 0,1,5,6,7
    assert(t > 0, "dongu kosmali");
    assert_eq_int(t % 2, 0);
}

// Fonksiyon icinde de calismali (parametreyle gelen dizi).
func topla(int[] a): int {
    int t = 0;
    for (int i = 0; i < len(a); i = i + 1) { t = t + a[i]; }
    return t;
}
func run_fonksiyonda() {
    int[] x = array_fill(100, 4);
    assert_eq_int(topla(x), 400);
}

// Buyuk dizi: sarkma/tasma varsa burada gorunur.
func run_buyuk() {
    int[] a = array_fill(100000, 1);
    int t = 0;
    for (int i = 0; i < len(a); i = i + 1) { t = t + a[i]; }
    assert_eq_int(t, 100000);
}

// ---------------------------------------------------------------------
// KANITLI ELEMAN YAZMASI (2026-09-06). Once "govdede yazma varsa vazgec"
// deniyordu; simdi yazilan degerin KESIN tamsayi oldugu kanitlanabiliyorsa
// yazma da bekcisiz uretiliyor (doldurma dongulerinin vektorlesmesi buna
// bagli). Kanit dusen her bicim asagida ayri ayri kilitli.
// ---------------------------------------------------------------------

// En yaygin bicim: `a[i] = i`. Dongu degiskeninin int oldugu dongunun
// BICIMINDEN belli, yani yazma kutulayamaz.
func run_yazma_ivar() {
    int[] a = array_fill(64, 0);
    for (int i = 0; i < len(a); i = i + 1) { a[i] = i; }
    int t = 0;
    for (int j = 0; j < len(a); j = j + 1) { t = t + a[j]; }
    assert_eq_int(t, 2016);          // 0..63 toplami
    assert_eq_int(a[0], 0);
    assert_eq_int(a[63], 63);
}

// Aritmetik: int sabitleri ve ivar uzerinde `+ - * / %` int koruyor.
func run_yazma_aritmetik() {
    int[] a = array_fill(10, 0);
    for (int i = 0; i < len(a); i = i + 1) { a[i] = i * 3 + 1; }
    assert_eq_int(a[0], 1);
    assert_eq_int(a[9], 28);
    int[] b = array_fill(10, 0);
    for (int i = 0; i < len(b); i = i + 1) { b[i] = i / 2; }
    assert_eq_int(b[7], 3);          // TAMSAYI bolme
}

// Ayni dongude hem kanitli yazma hem kanitli okuma.
func run_yazma_ve_okuma() {
    int[] a = array_fill(32, 5);
    int t = 0;
    for (int i = 0; i < len(a); i = i + 1) {
        t = t + a[i];
        a[i] = i;
    }
    assert_eq_int(t, 160);           // yazmadan ONCE okundu
    assert_eq_int(a[31], 31);
}

// FLOAT yazmasi kanit dusurmeli: bekcisiz yazma diziyi kutulardi ve
// ayni dongudeki bekcisiz OKUMA serbest birakilmis idata'ya bakardi.
// Kanit dusunce iki islem de eski (bekcili + tazelemeli) yoldan gecer.
func run_yazma_float_kanit_dusurur() {
    array a = array_fill(8, 1);
    float t = 0.0;
    for (int i = 0; i < len(a); i = i + 1) {
        if (i == 4) { a[i] = 0.5; }
        else { a[i] = i; }
        t = t + a[i];
    }
    // 0+1+2+3+0.5+5+6+7
    assert_close(t, 24.5, 0.000001);
}

// Kanitli yazma ile KUTULAYAN yazma AYNI dongude. Ikincisi butun dongunun
// kanitini dusurmeli — yoksa birincisi bekcisiz kalir ve kutulamadan sonra
// sarkan idata'ya yazar.
func run_karisik_yazma() {
    array a = array_fill(8, 0);
    array b = a;                     // takma ad: b uzerinden kutulama
    for (int i = 0; i < len(a); i = i + 1) {
        a[i] = i;
        if (i == 3) { b[i] = 1.5; }
    }
    float t = 0.0;
    for (int j = 0; j < len(a); j = j + 1) { t = t + a[j]; }
    // 0+1+2+1.5+4+5+6+7  (3. eleman float olarak KALDI)
    assert_close(t, 26.5, 0.000001);
}

// SINIR DISI yazma: `a[i+1]` son turda a[len]'e yaziyor. Indeks ivar
// olmadigi icin o yazma bekcili kalir; kanitli OKUMA yine dogru olmali.
//
// ⚠ BU TEST TEK BASINA HICBIR SEY OLCMUYOR. Yazma yerindeki indeks
// kaniti kaldirilinca (enjeksiyon) a[8] yaziliyor — malloc'un yuvarladigi
// blogun ICINE dusuyor, hicbir sey bozulmuyor ve 28 test YESIL kaliyor.
// Okuma tarafinda da ayni tuzak yasanmisti (bkz. run_sinir_disi_indeks).
// Olcen sey asagidaki UZAK yazma.
func run_yazma_sinir_disi() {
    int[] a = array_fill(8, 0);
    // Sinirlar icindeki yazmalar normal.
    for (int i = 0; i < 7; i = i + 1) { a[i + 1] = i; }
    int t = 0;
    for (int j = 0; j < len(a); j = j + 1) { t = t + a[j]; }
    assert_eq_int(t, 21);            // a[0]=0, a[1..7]=0..6
    // Tek eleman tasan YAZMA firlatmali (bekcinin kaniti) ve diziyi
    // BUYUTMEMELI.
    bool firladi = false;
    try { a[8] = 99; } catch (e) { firladi = true; }
    assert(firladi, "sinir disi YAZMA firlatmali — bekci yok!");
    assert_eq_int(len(a), 8);
}

// UZAK sinir disi yazma: 8 GB otesi (8 MB yetmiyor — buyuk bir yiginda
// haritali alana dusebiliyor). Bekci varsa her tur hata basip
// yazmiyor ve dizi bozulmamis kaliyor; bekci kalkarsa yigin cok otesine
// yaziliyor ve program cokuyor.
func run_yazma_sinir_disi_uzak() {
    int[] b = array_fill(4, 9);
    bool firladi = false;
    try { b[1000000000] = 7; } catch (e) { firladi = true; }
    assert(firladi, "UZAK sinir disi yazma firlatmali — bekci kalkarsa yigin bozulur");
    int t = 0;
    for (int j = 0; j < len(b); j = j + 1) { t = t + b[j]; }
    assert_eq_int(t, 36);            // dizi bozulmamis
    assert_eq_int(len(b), 4);
}

// DONGU DEGISKENI DISINDA bir ad yazilirsa kanit dusmeli: turunu bilmenin
// yolu yok. Burada `x` bir float ve bekcisiz yazma onu int gibi saklardi.
func golgeli(int x): float {
    array a = array_fill(6, 0);
    for (int i = 0; i < len(a); i = i + 1) {
        float x = 0.5;               // parametreyi GOLGELIYOR
        a[i] = x;
    }
    float t = 0.0;
    for (int j = 0; j < len(a); j = j + 1) { t = t + a[j]; }
    return t;
}
func run_yazma_golgelenme() {
    assert_close(golgeli(3), 3.0, 0.000001);
}

// Bilesik atama ve artirma: eleman kutusuz dizide zaten int, int koruyan
// operatorle int kaliyor.
func run_yazma_bilesik() {
    int[] a = array_fill(10, 2);
    for (int i = 0; i < len(a); i = i + 1) { a[i] += 3; }
    int t = 0;
    for (int j = 0; j < len(a); j = j + 1) { t = t + a[j]; }
    assert_eq_int(t, 50);

    int[] b = array_fill(10, 1);
    for (int i = 0; i < len(b); i = i + 1) { b[i]++; }
    int u = 0;
    for (int j = 0; j < len(b); j = j + 1) { u = u + b[j]; }
    assert_eq_int(u, 20);
}

// Fonksiyon icinde, PARAMETREYLE gelen dizi.
func doldur_ivar(int[] a): int {
    for (int i = 0; i < len(a); i = i + 1) { a[i] = i; }   // KANITLI
    int t = 0;
    for (int j = 0; j < len(a); j = j + 1) { t = t + a[j]; }
    return t;
}
// `k` dongu degiskeni degil: kutulu bir yuvada duruyor ve cagiran float
// gecebilir, yani kanit DUSUYOR ve bu dongu bekcili kaliyor. Bilincli
// olarak muhafazakar; sonuc yine dogru olmali.
func doldur_k(int[] a, int k): int {
    for (int i = 0; i < len(a); i = i + 1) { a[i] = k; }
    int t = 0;
    for (int j = 0; j < len(a); j = j + 1) { t = t + a[j]; }
    return t;
}
func run_yazma_fonksiyonda() {
    int[] a = array_fill(50, 0);
    assert_eq_int(doldur_ivar(a), 1225);
    assert_eq_int(a[49], 49);
    int[] b = array_fill(50, 0);
    assert_eq_int(doldur_k(b, 4), 200);
    assert_eq_int(b[49], 4);
}

// BUYUK dizi: vektorlesen yol burada calisiyor. Sarkan isaretci ya da
// yanlis adim varsa toplam tutmaz.
func run_yazma_buyuk() {
    int[] a = array_fill(200000, 0);
    for (int i = 0; i < len(a); i = i + 1) { a[i] = 1; }
    int t = 0;
    for (int j = 0; j < len(a); j = j + 1) { t = t + a[j]; }
    assert_eq_int(t, 200000);
    // Tek sayili uzunluk: vektor artigi (epilogue) dogru mu?
    int[] b = array_fill(100003, 0);
    for (int i = 0; i < len(b); i = i + 1) { b[i] = i; }
    assert_eq_int(b[100002], 100002);
    assert_eq_int(b[0], 0);
}

// BOS ve TEK elemanli dizide yazma: hizli surum hic acilmamali /
// dogru calismali.
func run_yazma_kucuk() {
    int[] a = array_fill(0, 0);
    for (int i = 0; i < len(a); i = i + 1) { a[i] = i; }
    assert_eq_int(len(a), 0);
    int[] b = array_fill(1, 0);
    for (int i = 0; i < len(b); i = i + 1) { b[i] = 42; }
    assert_eq_int(b[0], 42);
}

// ---------------------------------------------------------------------
// `while` SURUMLEMESI (2026-09-06).
//
// `while (v <= UB) { ...a[v]...; v = v + STEP; }`. `for` kanitindan farki:
// baslangic/adim/sinir sozdiziminden okunamiyor (ifade olabilirler), o
// yuzden sayisal kosullar DONGU BASINDA BIR KEZ sinaniyor:
//     v >= 0  &&  STEP > 0  &&  UB < count      ->  0 <= v <= UB < count
// Uc buyuklugun de dongu boyunca degismedigi ayrica dogrulaniyor.
//
// Sinav dusen her bicim asagida ayri ayri kilitli; hepsinde beklenen sey
// "genel surume duser, sonuc DOGRU kalir".
// ---------------------------------------------------------------------

func run_while_temel() {
    int[] a = array_fill(64, 0);
    int step = 1;
    int ub = 63;
    int k = 0;
    while (k <= ub) { a[k] = k; k = k + step; }
    int t = 0;
    for (int j = 0; j < len(a); j = j + 1) { t = t + a[j]; }
    assert_eq_int(t, 2016);
    assert_eq_int(a[63], 63);
}

// Adim 1 olmak zorunda degil; `k = k + step` ile atlayarak yaziyor.
func run_while_adim() {
    int[] a = array_fill(20, 0);
    int step = 3;
    int ub = 19;
    int k = 2;
    while (k <= ub) { a[k] = 7; k = k + step; }
    int t = 0;
    for (int j = 0; j < len(a); j = j + 1) { t = t + a[j]; }
    assert_eq_int(t, 42);          // 2,5,8,11,14,17 -> 6 tane
    assert_eq_int(a[2], 7);
    assert_eq_int(a[3], 0);
}

// `<` bicimi: en buyuk indeks UB-1, yani sinav UB <= count.
func run_while_kucuktur() {
    int[] a = array_fill(10, 0);
    int ub = 10;
    int step = 1;
    int k = 0;
    while (k < ub) { a[k] = 2; k = k + step; }
    int t = 0;
    for (int j = 0; j < len(a); j = j + 1) { t = t + a[j]; }
    assert_eq_int(t, 20);
}

// SINIR DIZIDEN BUYUK: sinav dusmeli, genel surum kosmali. Bekci
// sinir disi yazmayi durduruyor, dizi bozulmuyor.
// Sinir diziden BUYUK: kanit dusmeli ve bekci kalmali. Yeni sozlesmede bekcinin
// kaniti, ikinci turun FIRLATMASI (eskiden "hata basip 0 doner"di).
func run_while_sinir_buyuk() {
    int[] a = array_fill(8, 1);
    int ub = 1000000000;
    int step = 200000000;
    int k = 0;
    bool firladi = false;
    try {
        while (k <= ub) { a[k] = 2; k = k + step; }
    } catch (e) { firladi = true; }
    assert(firladi, "sinir diziden buyukken bekci firlatmali");
    int t = 0;
    for (int j = 0; j < len(a); j = j + 1) { t = t + a[j]; }
    assert_eq_int(t, 9);           // yalniz a[0] yazildi: 2 + 7*1
    assert_eq_int(len(a), 8);      // dizi BUYUMEDI
}

// NEGATIF baslangic: `v >= 0` sinavi dusmeli.
//
// ⚠ Ilk yazilisinda govde `if (k >= 0) { a[k] = 2; }` idi — yani negatif
// indeksle HIC erisilmiyordu ve sinavi kaldiran enjeksiyon YESIL
// kaliyordu. Koruma KALDIRILDI ve adim, tasmayi gozlenebilir kilacak
// kadar buyuk secildi (bir eleman tasmak malloc yuvarlamasinda kayboluyor;
// bkz. run_sinir_disi_indeks'teki ayni ders).
func run_while_negatif_baslangic() {
    int[] a = array_fill(8, 1);
    int ub = 7;
    int step = 1000000000;
    int k = 0 - 3000000000;
    // Yeni sozlesme: negatif indeks sinir disidir ve FIRLATIR (bkz.
    // run_sinir_disi_indeks). Bekcinin kaniti ilk turun firlatmasi.
    bool firladi = false;
    try {
        while (k <= ub) { a[k] = 2; k = k + step; }
    } catch (e) { firladi = true; }
    assert(firladi, "negatif baslangicta bekci firlatmali");
    int t = 0;
    for (int j = 0; j < len(a); j = j + 1) { t = t + a[j]; }
    assert_eq_int(t, 8);           // hicbir yazma gecmedi: 8 * 1
}

// NEGATIF ADIM: `step > 0` sinavi dusmeli. Bu bicim yalniz `break` ile
// sonlanabildigi icin sinanabiliyor; adim negatifken v her turda azaliyor
// ve bekcisiz yazma TAMPONUN ONUNE yaziyor. Uzagi seciyoruz ki tasma
// gozlenebilir olsun (bir eleman tasmak malloc yuvarlamasinda kayboluyor).
func run_while_negatif_adim() {
    int[] a = array_fill(8, 1);
    int ub = 7;
    int step = 0 - 1000000000;
    int k = 3;
    int say = 0;
    // Ilk tur a[3]'e yaziyor (gecerli), ikinci tur k negatife dusuyor ve
    // yeni sozlesmede FIRLATIYOR.
    bool firladi = false;
    try {
        while (k <= ub) {
            a[k] = 2;
            say = say + 1;
            if (say > 3) { break; }
            k = k + step;
        }
    } catch (e) { firladi = true; }
    assert(firladi, "negatif adimda bekci firlatmali");
    int t = 0;
    for (int j = 0; j < len(a); j = j + 1) { t = t + a[j]; }
    assert_eq_int(t, 9);           // yalniz a[3] yazildi: 2 + 7*1
}

// KUTULU dizi: count 0, sinav dusuyor, genel surum dogru sonucu veriyor.
func run_while_kutulu() {
    array c = [1, 2.5, 3];
    int ub = 2;
    int step = 1;
    int k = 0;
    float t = 0.0;
    while (k <= ub) { t = t + c[k]; k = k + step; }
    assert_close(t, 6.5, 0.000001);
}

// ADIM float: etiket denetimi dusuyor -> genel surum. (Adim 1'e
// yuvarlanmiyor; `k + 0.5` her turda artiriyor ve dongu bitiyor.)
func run_while_float_adim() {
    int[] a = array_fill(8, 0);
    float step = 1.5;
    int ub = 7;
    int k = 0;
    while (k <= ub) { a[k] = 5; k = k + step; }
    int t = 0;
    for (int j = 0; j < len(a); j = j + 1) { t = t + a[j]; }
    assert(t > 0, "dongu kosmali");
}

// ARTIM SON IFADE DEGIL: kanit dusmeli. Artim ONCE olursa ondan sonraki
// erisim artmis v ile siniri ASIYOR — kanit tam da bunu disliyor.
//
// ⚠ Ilk yazilisinda erisim `if (k <= ub)` ile korunuyordu, yani hic
// tasmiyordu ve "artim son ifade olmali" kuralini kaldiran enjeksiyon
// YESIL kaliyordu. Koruma kaldirildi, adim tasmayi gozlenebilir kilacak
// kadar buyuk.
func run_while_artim_ortada() {
    int[] a = array_fill(8, 0);
    int ub = 7;
    int step = 1000000000;
    int k = 0;
    bool firladi = false;
    try {
        while (k <= ub) {
            k = k + step;              // ONCE artiyor
            a[k] = 3;                  // k artik siniri asmis
        }
    } catch (e) { firladi = true; }
    assert(firladi, "artim son ifade degilken bekci firlatmali");
    int t = 0;
    for (int j = 0; j < len(a); j = j + 1) { t = t + a[j]; }
    assert_eq_int(t, 0);           // hicbir yazma gecmedi
}

// SINIR govdede DEGISIYOR: bir kezlik sinav BAYATLIYOR, kanit dusmeli.
//
// ⚠ Ilk yazilisinda ub 4'ten 15'e cikiyordu ve dizi 16 elemanliydi — yani
// bayat sinavla bile hicbir sey tasmiyordu. Simdi yeni sinir diziden cok
// buyuk ve adim buyuk, yani tasma hem gerceklesiyor hem gozlenebilir.
func run_while_sinir_degisiyor() {
    int[] a = array_fill(8, 0);
    int ub = 7;
    int step = 200000000;
    int k = 0;
    bool firladi = false;
    try {
        while (k <= ub) {
            a[k] = 1;
            if (k == 0) { ub = 1000000000; }   // sinav bayatliyor
            k = k + step;
        }
    } catch (e) { firladi = true; }
    assert(firladi, "sinir govdede degisince bekci firlatmali");
    int t = 0;
    for (int j = 0; j < len(a); j = j + 1) { t = t + a[j]; }
    assert_eq_int(t, 1);           // yalniz a[0]
}

// ADIM govdede DEGISIYOR: `step > 0` sinavi bayatliyor.
func run_while_adim_degisiyor() {
    int[] a = array_fill(8, 0);
    int ub = 7;
    int step = 1;
    int k = 0;
    int say = 0;
    bool firladi = false;
    try {
        while (k <= ub) {
            a[k] = 1;
            say = say + 1;
            if (say == 3) { step = 0 - 1000000000; }
            if (say > 5) { break; }
            k = k + step;
        }
    } catch (e) { firladi = true; }
    assert(firladi, "adim govdede degisince bekci firlatmali");
    int t = 0;
    for (int j = 0; j < len(a); j = j + 1) { t = t + a[j]; }
    assert_eq_int(t, 3);           // a[0], a[1], a[2]
}

// FLOAT eleman yazmasi: kutulama riski -> kanit dusmeli, cokmemeli.
func run_while_float_yazma() {
    array a = array_fill(8, 0);
    int ub = 7;
    int step = 1;
    int k = 0;
    while (k <= ub) {
        if (k == 3) { a[k] = 1.5; } else { a[k] = k; }
        k = k + step;
    }
    float t = 0.0;
    for (int j = 0; j < len(a); j = j + 1) { t = t + a[j]; }
    // 0+1+2+1.5+4+5+6+7
    assert_close(t, 26.5, 0.000001);
}

// break / continue iki surumde de dogru.
func run_while_break() {
    int[] a = array_fill(16, 0);
    int ub = 15;
    int step = 1;
    int k = 0;
    int say = 0;
    while (k <= ub) {
        if (k == 10) { break; }
        a[k] = 1;
        say = say + 1;
        k = k + step;
    }
    assert_eq_int(say, 10);
    assert_eq_int(a[9], 1);
    assert_eq_int(a[10], 0);
}

// Kanitli OKUMA da ayni sinava bagli.
func run_while_okuma() {
    int[] a = array_fill(50, 3);
    int ub = 49;
    int step = 1;
    int k = 0;
    int t = 0;
    while (k <= ub) { t = t + a[k]; k = k + step; }
    assert_eq_int(t, 150);
}

// BUYUK dizi: sarkma ya da yanlis adim varsa burada gorunur.
func run_while_buyuk() {
    int[] a = array_fill(200000, 0);
    int ub = 199999;
    int step = 1;
    int k = 0;
    while (k <= ub) { a[k] = 1; k = k + step; }
    int t = 0;
    for (int j = 0; j < len(a); j = j + 1) { t = t + a[j]; }
    assert_eq_int(t, 200000);
}

test("temel", "run_temel");
test("kutulu dizi genel surume duser", "run_kutulu_dizi");
test("float dizi", "run_float_dizi");
test("bos dizi", "run_bos_dizi");
test("tek eleman", "run_tek_eleman");
test("break/continue", "run_break_continue");
test("artim iki", "run_artim_iki");
test("bastan olmayan baslangic", "run_bastan_degil");
test("ic ice dongu", "run_ic_ice");
test("farkli indeks bekciyi korur", "run_farkli_indeks");
test("sinir disi indeks bekciye takilir", "run_sinir_disi_indeks");
test("sinir disi: erisimci varsayilani", "run_sinir_disi_erisimci");
test("govdede eleman yazmasi", "run_govdede_yazma");
test("donguda kutulama", "run_donguda_kutulama");
test("takma ad uzerinden kutulama", "run_takma_ad");
test("dongu degiskeni degisiyor", "run_ivar_degisiyor");
test("fonksiyon icinde", "run_fonksiyonda");
test("buyuk dizi", "run_buyuk");
test("kanitli yazma: a[i] = i", "run_yazma_ivar");
test("kanitli yazma: aritmetik", "run_yazma_aritmetik");
test("kanitli yazma + okuma", "run_yazma_ve_okuma");
test("float yazmasi kaniti dusurur", "run_yazma_float_kanit_dusurur");
test("karisik yazma (takma adla kutulama)", "run_karisik_yazma");
test("sinir disi yazma", "run_yazma_sinir_disi");
test("uzak sinir disi yazma", "run_yazma_sinir_disi_uzak");
test("golgelenen ad kanit vermez", "run_yazma_golgelenme");
test("bilesik atama / artirma", "run_yazma_bilesik");
test("fonksiyon icinde yazma", "run_yazma_fonksiyonda");
test("buyuk dizide yazma", "run_yazma_buyuk");
test("bos / tek elemanli dizide yazma", "run_yazma_kucuk");
