// ============================================
// Tulpar Wings - Full CRUD API Example
// Run with: tulpar api_wings_crud.tpr
// ============================================
import "wings";

// ============================================
// In-memory Database
// ============================================
array _users = [];
int _next_id = 1;

// Seed initial data
func seed_data() {
    push(_users, {"id": 1, "name": "Hamza", "email": "hamza@tulpar.dev", "role": "admin"});
    push(_users, {"id": 2, "name": "Ali", "email": "ali@tulpar.dev", "role": "user"});
    push(_users, {"id": 3, "name": "Veli", "email": "veli@tulpar.dev", "role": "user"});
    _next_id = 4;
}

seed_data();

// ============================================
// API Handlers — her handler `req` alır, cevap sözlüğü döndürür.
// ============================================

// GET / - API info
func api_info(req) {
    return {
        "name": "Tulpar Wings CRUD API",
        "version": "1.0.0",
        "endpoints": [
            "GET  /           - API info",
            "GET  /health     - Health check",
            "GET  /users      - List all users",
            "GET  /stats      - API statistics",
            "POST /users      - Create user (body: JSON)",
            "POST /echo       - Echo request body"
        ]
    };
}

// GET /health - Health check
func health_check(req) {
    return {
        "status": "healthy",
        "uptime_ms": clock_ms(),
        "users_count": length(_users)
    };
}

// GET /users - List all users
func list_users(req) {
    return {
        "success": true,
        "data": _users,
        "count": length(_users)
    };
}

// GET /stats - API statistics
func get_stats(req) {
    return {
        "total_users": length(_users),
        "next_id": _next_id,
        "api_version": "1.0.0",
        "uptime_ms": clock_ms()
    };
}

// POST /users - Create a new user. Gövde otomatik parse edilir: req.json.
// accepts() şeması sayesinde "name" garantili; email/role opsiyonel.
func create_user(req) {
    json body = req.json;
    json new_user = {
        "id": _next_id,
        "name": body["name"],
        "email": "new@tulpar.dev",
        "role": "user"
    };
    if (_wings_has_key(body, "email")) { new_user["email"] = body["email"]; }
    if (_wings_has_key(body, "role"))  { new_user["role"]  = body["role"]; }

    push(_users, new_user);           // global'e push → otomatik kalıcı
    _next_id = _next_id + 1;

    return created({
        "success": true,
        "message": "User created",
        "data": new_user
    });
}

// POST /echo - Echo back request data
func echo_handler(req) {
    return {
        "method": req["method"],
        "path": req["path"],
        "body": req["body"],
        "echo": true
    };
}

// ============================================
// Route Registration — fonksiyon referansıyla (typo = derleme hatası).
// ============================================
get("/", api_info);
get("/health", health_check);
get("/users", list_users);
get("/stats", get_stats);
post("/users", create_user);
accepts({"name": "str", "email?": "str", "role?": "str"});
post("/echo", echo_handler);

// ============================================
// Start Server
// ============================================
print("Seed data loaded: " + toString(length(_users)) + " users");
serve(3000);
