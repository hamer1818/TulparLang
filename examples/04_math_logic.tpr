print("=== Math & Logic Demo ===");

// 1. Math Functions
// (Checking if built-in math functions exist like sqrt, pow in interpreter.c?)
// Looking at interpreter source (grep earlier), we saw BigInt helpers but not explicit math lib binding.
// But some basic ops might be there.
// If not, we'll stick to basic arithmetic and BigInt.

print("Basic Math: 10 + 5 * 2 = " + toString(10 + 5 * 2));

// 2. Tamsayı sınırı (int = 64 bit işaretli)
print("\n--- Tamsayi siniri ---");
// Tulpar'da BÜYÜK SAYI (bigint) TİPİ YOKTUR: `int` 64 bit işaretlidir ve
// aralığı -9223372036854775808 .. 9223372036854775807'dir. Bu örnek önceden
// olmayan bir `bigint` tipini öğretiyor ve sessizce yanlış sonuç basıyordu
// (aralık dışı bir literal doyuma gidiyor, çarpım da taşıp sarıyordu).
// Doğru olan davranışı GÖSTERMEK, var olmayan bir tip uydurmak değil.
int en_buyuk = 9223372036854775807;
print("int en buyuk deger: " + toString(en_buyuk));
print("Tasma sarar (en_buyuk + 1): " + toString(en_buyuk + 1));

// 64 biti aşan bir aralık gerekiyorsa sayıyı kendin parçalamalısın —
// örneğin iki yarıda tutup basamak basamak toplamak gibi.
int yuksek = 1234567890;
int alcak = 987654321;
print("Iki parcali gosterim: " + toString(yuksek) + toString(alcak));

// 3. Logic & Boolean
print("\n--- Logic ---");
bool t = true;
bool f = false;

print("T && F: " + toString(t && f));
print("T || F: " + toString(t || f));
print("!T: " + toString(!t));
