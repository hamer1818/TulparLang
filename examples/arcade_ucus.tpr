// Ucus (Flappy) — arcade preset motoru, 3 BÖLÜM.
//
//   ./tulpar examples/arcade_ucus.tpr
//
// SPACE / YUKARI ile kanat çırp; boruların arasından geç. Her geçiş +1.
// Bölümdeki hedef sayıda boru geçince sıradaki bölüm; 3 bölümü de bitir →
// KAZANDIN. Boruya, tavana ya da zemine çarparsan oyun biter, R ile baştan.
//
// Bölümler: 1) geniş boşluk / yavaş   2) dar / hızlı   3) en dar / en hızlı
//
// Kuş MV_NONE: yerçekimi + kanat çırpma her_kare içinde ELLE sürülür (motorun
// MV_PLATFORM zıplaması sadece zemindeyken çalışır; flappy havada çırpar).
// Borular TAG_ENEMY + MV_VELOCITY: katı `duvar()` DEĞİL — duvar olsalardı motor
// kuşu MTV ile iterdi; biz çarpınca ölmesini istiyoruz. Motor ekrandan 64px
// çıkan velocity entity'lerini otomatik öldürür → boru temizliği bedava.

import "arcade";

int kus = 0;
float kus_vy = 0.0;       // kuşun dikey hızı (px/sn, + aşağı)
int basladi = 0;          // 0 = ilk çırpışı bekliyor (kuş asılı, fizik/boru yok)

// Fizik (deneyle ayarlandı — flappy hissi): duruştan zemine ~0.9sn (rahat
// tepki payı), bir çırpma ~0.7sn'lik yay çizer → ~1.4 çırpma/sn temposu.
// GRAV çok yüksekse kuş ilk boru gelmeden yere çakılır (ilk sürüm 1500 buydu).
float GRAV = 1050.0;      // yerçekimi (px/sn^2)
float CIRP = 400.0;       // kanat çırpma anlık yukarı hızı (px/sn)
int KUS_X = 120;
int ZEMIN = 452;          // zemin şeridinin y'si (kuş bunu geçerse ölür)

// Boru takibi (paralel diziler — motor içi değil, kendi durumumuz).
array boru_ust = [];      // üst boru handle'ı
array boru_x   = [];      // çift'in x'i (skor için)
array boru_gecti = [];    // 1 = bu çift skorlandı
int t = 0;                // kare sayacı (periyodik boru üretimi)

// Bölüm ayarları
int bosluk = 150;         // boru boşluğu (px)
int boru_hiz = 150;       // boruların sola akış hızı (px/sn)
int spawn_period = 95;    // kaç karede bir boru çifti
int hedef = 5;            // bu bölümü bitiren boru sayısı
int gecen = 0;            // bu bölümde geçilen boru

// Global kurulum — her bölüm yüklemesinde bölüm fn'inden ÖNCE çalışır.
func kur() {
    temizle();
    boru_ust = [];
    boru_x = [];
    boru_gecti = [];
    t = 0;
    gecen = 0;
    kus_vy = 0.0;
    basladi = 0;
    kus = uret(KUS_X, 220, 26, 20, GOLD, TAG_PLAYER, MV_NONE);
    duvar(0, ZEMIN, 640, 28, DARKGRAY);          // zemin (sadece görsel; ölüm elle)
}

// --- Bölümler ---------------------------------------------------------------
func b1() { bosluk = 160; boru_hiz = 150; spawn_period = 100; hedef = 5; }
func b2() { bosluk = 135; boru_hiz = 195; spawn_period = 82;  hedef = 7; }
func b3() { bosluk = 115; boru_hiz = 240; spawn_period = 68;  hedef = 9; }

// Bir boru çifti üret: üstte ve altta iki yeşil sütun, aralarında boşluk.
func boru_uret() {
    int gy = randint(90, ZEMIN - bosluk - 40);   // boşluğun üst kenarı
    int usth = gy;                                // üst borunun yüksekliği
    int altY = gy + bosluk;
    int alth = ZEMIN - altY;
    int u = uret(660, 0, 52, usth, LIME, TAG_ENEMY, MV_VELOCITY);
    hiz_ver(u, 0 - boru_hiz, 0);
    int a = uret(660, altY, 52, alth, LIME, TAG_ENEMY, MV_VELOCITY);
    hiz_ver(a, 0 - boru_hiz, 0);
    push(boru_ust, u);
    push(boru_x, 660);
    push(boru_gecti, 0);
}

func her_kare_is() {
    float dt = frame_time();
    if (dt <= 0.0) { dt = 0.0166667; }
    if (dt > 0.05) { dt = 0.05; }
    // Çırpma: SPACE/UP/W klavye VEYA ekranın HERHANGİ bir yerine dokunma
    // (dokunuldu()). Buton/joystick çizilmez — ekran tamamı kontroldür.
    bool cirp = dokunuldu() || key_pressed("SPACE") || key_pressed("UP") || key_pressed("W");

    // Hazır durumu: ilk çırpışa kadar kuş asılı durur, fizik/boru başlamaz
    // (gerçek Flappy gibi — oyuncuya tepki payı). İlk çırpış oyunu başlatır.
    if (basladi == 0) {
        if (cirp) { basladi = 1; kus_vy = 0.0 - CIRP; }
        return;
    }

    // --- Kuş: yerçekimi + çırpma --------------------------------------------
    if (cirp) { kus_vy = 0.0 - CIRP; }
    kus_vy = kus_vy + GRAV * dt;
    float ny = y_of(kus) + kus_vy * dt;
    if (ny < 0.0) { ny = 0.0; kus_vy = 0.0; }
    konumla(kus, KUS_X, ny);
    if (ny + 20.0 >= ZEMIN * 1.0) { oyun_bitti(); }   // zemine çarptı

    // --- Boru üretimi + skor (sadece oyun başladıysa) -----------------------
    t = t + 1;
    if (mod(t, spawn_period) == 0) { boru_uret(); }

    for (int i = 0; i < len(boru_ust); i = i + 1) {
        int u = boru_ust[i];
        if (!yasiyor(u)) { continue; }
        // Boru kuşu geçti mi? (bir kez skorla)
        if (boru_gecti[i] == 0 && x_of(u) + 52.0 < KUS_X * 1.0) {
            boru_gecti[i] = 1;
            skor_ekle(1);
            gecen = gecen + 1;
            if (gecen >= hedef) { bolum_gec(); }
        }
    }
}

// Hazır durumunda "başla" ipucu (otomatik çizimin üstüne).
func ciz_ek() {
    if (basladi == 0) {
        str h = "Baslamak icin dokun ya da SPACE / YUKARI";
        text(h, (screen_width() - measure_text(h, 22)) / 2, 200, 22, WHITE);
    }
}

// Kuş boruya değince oyun biter.
func kaybet_cb() { oyun_bitti(); }

sahne(640, 480, "Ucus");
bilgi("Dokun / SPACE / YUKARI: kanat cirp   |   Borularin arasindan gec (+1)");
baslangicta(kur);
bolum(1, b1);
bolum(2, b2);
bolum(3, b3);
her_kare(her_kare_is);
ciz_ustune(ciz_ek);
carpisinca(TAG_PLAYER, TAG_ENEMY, kaybet_cb);
oyna();
