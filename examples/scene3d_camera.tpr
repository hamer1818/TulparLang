// scene3d — Faz 6 demo: DÖNEBİLEN kamera (yörünge + birinci şahıs).
//
//   ./tulpar examples/scene3d_camera.tpr
//
// Kamera:  1 = sabit takip (motorun ilk kamerası, hiç dönmez)
//          2 = yörünge / üçüncü şahıs   3 = birinci şahıs
// Bakış:   fare SAĞ tuşu basılı sürükle  |  Q / E ile çevir
//          tekerlek = yakınlaş/uzaklaş (yörüngede)
//          birinci şahısta imleç kilitlenir, fare doğrudan bakış olur
// Yürüme:  WASD / oklar — yön KAMERAYA GÖRE: kamerayı çevir, "ileri" değişir
// Zıplama: BOŞLUK       |  altın küreleri topla (+10)
// Dokunmatik: sol yarı = joystick, sağ yarı = sürükle bak / dokun zıpla
//
// Oyun kodu yalnız setup + update + toplama kancası; kameranın tamamı motorda.

import "scene3d";

int K_1 = 49;   int K_2 = 50;   int K_3 = 51;

int player = 0;
int mode = 2;       // 1 = sabit, 2 = yörünge, 3 = birinci şahıs

func setup() {
    player = spawn3(0.0, 1.0, 0.0,   1.2, 2.0, 1.2, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    camera_orbit(player, 13.0, 9.0);    // yörüngeden başla — döndürülebilir

    // Zemin dokusu: ölçek hissini karolar verir, dönen kamerada mesafe
    // düz renkte okunmuyor.
    int t = checker(128, 128, 8, rgb(150, 158, 168), rgb(120, 128, 140));
    ground_texture3d(t, 24.0);

    // Toplanabilir altın küreler — arenaya dağılmış (kamerayı çevirmeyi
    // gerektirsin diye köşelere de).
    spawn3(6.0, 1.0, 4.0,          1.0, 1.0, 1.0, GOLD, SHAPE_SPHERE, TAG_ITEM);
    spawn3(0.0 - 7.0, 1.0, 5.0,    1.0, 1.0, 1.0, GOLD, SHAPE_SPHERE, TAG_ITEM);
    spawn3(5.0, 1.0, 0.0 - 6.0,    1.0, 1.0, 1.0, GOLD, SHAPE_SPHERE, TAG_ITEM);
    spawn3(0.0 - 4.0, 1.0, 0.0 - 7.0, 1.0, 1.0, 1.0, GOLD, SHAPE_SPHERE, TAG_ITEM);
    spawn3(9.0, 1.0, 0.0 - 9.0,    1.0, 1.0, 1.0, GOLD, SHAPE_SPHERE, TAG_ITEM);

    // Sütunlar: dönerken derinliği okumayı kolaylaştıran sabit işaretler.
    spawn3(8.0, 1.5, 8.0,          1.4, 3.0, 1.4, rgb(120, 220, 140), SHAPE_CYL, TAG_PROP);
    spawn3(0.0 - 8.0, 1.5, 0.0 - 8.0, 1.4, 3.0, 1.4, rgb(120, 220, 140), SHAPE_CYL, TAG_PROP);
    spawn3(0.0 - 9.0, 2.0, 6.0,    1.6, 4.0, 1.6, ORANGE, SHAPE_CYL, TAG_PROP);

    // Duvarlar (çarpışma + itme) — arenayı çevreler
    spawn3(0.0, 1.5, 0.0 - 12.0,   26.0, 3.0, 1.0, GRAY, SHAPE_CUBE, TAG_WALL);
    spawn3(0.0, 1.5, 12.0,         26.0, 3.0, 1.0, GRAY, SHAPE_CUBE, TAG_WALL);
    spawn3(0.0 - 12.0, 1.5, 0.0,   1.0, 3.0, 26.0, GRAY, SHAPE_CUBE, TAG_WALL);
    spawn3(12.0, 1.5, 0.0,         1.0, 3.0, 26.0, GRAY, SHAPE_CUBE, TAG_WALL);
}

func update() {
    // Kamera modunu canlı değiştir — üçü de aynı sahnede denenebilsin.
    if (key_pressed(K_1)) { mode = 1; camera_follow(player, 13.0, 9.0); }
    if (key_pressed(K_2)) { mode = 2; camera_orbit(player, 13.0, 9.0); }
    if (key_pressed(K_3)) { mode = 3; camera_fps(player, 1.4); }

    move3d(player, 8.0);
    if (jump_pressed()) { jump3d(player, 11.0); }
}

// Oyuncu bir altın küreye değince: küreyi al, +10.
func collect() {
    kill3d(other3d());
    score3d_add(10);
}

scene3d(900, 520, "Tulpar 3D — Kamera");
sky3d(rgb(58, 116, 200), rgb(196, 220, 240));
fog3d(0.018);
on_setup3d(setup);
on_update3d(update);
on_hit3d(TAG_PLAYER, TAG_ITEM, collect);
play3d();
