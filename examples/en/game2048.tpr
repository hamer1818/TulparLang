// 2048 — arcade engine (grid + swipe). Endless; score is the sum of merged
// numbers; the game ends when no move is left.
// English twin of examples/arcade_2048.tpr.
//
//   ./tulpar examples/en/game2048.tpr
//
// Swipe (mobile) or arrow keys / WASD to push all tiles one way. Equal numbers
// that meet merge (2+2=4 ...). Each move drops a new tile (90% "2", 10% "4") on
// an empty cell. When the board fills and no move remains, the game ends.
//
// Engine use is like snake: NO entities — state lives in a 4x4 array, drawing is
// manual via on_draw. scene/score/game-over/HUD come free from the engine.

import "arcade";

int GRID = 4;
array grid = [];       // 4x4 (row-major); 0 = empty
int moved = 0;         // did the last move change anything?
int gain = 0;          // last move's points (sum of merges)

// Square board, centered in the 640x480 world.
int CELL = 92;
int GAP = 8;
int OX = 124;          // (640 - (4*92+3*8)) / 2 ≈ 116, + gap margin
int OY = 74;

// Drop a random new tile on an empty cell (10% "4", 90% "2").
func new_tile() {
    array empties = [];
    for (int i = 0; i < 16; i = i + 1) {
        if (toInt(grid[i]) == 0) { push(empties, i); }
    }
    if (length(empties) == 0) { return; }
    int idx = toInt(empties[randint(0, length(empties) - 1)]);
    int v = 2;
    if (randint(0, 9) == 0) { v = 4; }
    grid[idx] = v;
}

// Runs on every (re)start: clear the board + drop two tiles.
func setup() {
    grid = [];
    for (int i = 0; i < 16; i = i + 1) { push(grid, 0); }
    moved = 0;
    gain = 0;
    new_tile();
    new_tile();
}

// Compress + merge + write back the 4 given indices (in travel order).
// Global `moved`/`gain` are updated (all four directions call this the same way).
func line_move(i0, i1, i2, i3) {
    array v = [];
    if (toInt(grid[i0]) != 0) { push(v, toInt(grid[i0])); }
    if (toInt(grid[i1]) != 0) { push(v, toInt(grid[i1])); }
    if (toInt(grid[i2]) != 0) { push(v, toInt(grid[i2])); }
    if (toInt(grid[i3]) != 0) { push(v, toInt(grid[i3])); }
    array out = [];
    int k = 0;
    while (k < length(v)) {
        if (k + 1 < length(v) && toInt(v[k]) == toInt(v[k + 1])) {
            int m = toInt(v[k]) * 2;
            push(out, m);
            gain = gain + m;
            k = k + 2;
        } else {
            push(out, toInt(v[k]));
            k = k + 1;
        }
    }
    while (length(out) < 4) { push(out, 0); }
    if (toInt(grid[i0]) != toInt(out[0])) { moved = 1; }
    if (toInt(grid[i1]) != toInt(out[1])) { moved = 1; }
    if (toInt(grid[i2]) != toInt(out[2])) { moved = 1; }
    if (toInt(grid[i3]) != toInt(out[3])) { moved = 1; }
    grid[i0] = toInt(out[0]); grid[i1] = toInt(out[1]);
    grid[i2] = toInt(out[2]); grid[i3] = toInt(out[3]);
}

// dir: 0=left 1=right 2=up 3=down
func do_move(dir) {
    moved = 0;
    gain = 0;
    if (dir == 0)      { line_move(0,1,2,3);   line_move(4,5,6,7);   line_move(8,9,10,11);  line_move(12,13,14,15); }
    else if (dir == 1) { line_move(3,2,1,0);   line_move(7,6,5,4);   line_move(11,10,9,8);  line_move(15,14,13,12); }
    else if (dir == 2) { line_move(0,4,8,12);  line_move(1,5,9,13);  line_move(2,6,10,14);  line_move(3,7,11,15); }
    else               { line_move(12,8,4,0);  line_move(13,9,5,1);  line_move(14,10,6,2);  line_move(15,11,7,3); }
    if (moved == 1) {
        if (gain > 0) { score_add(gain); }
        new_tile();
    }
}

// Any move left? (empty cell or a mergeable neighbor)
func can_move(): bool {
    for (int i = 0; i < 16; i = i + 1) {
        if (toInt(grid[i]) == 0) { return true; }
    }
    for (int r = 0; r < 4; r = r + 1) {
        for (int c = 0; c < 3; c = c + 1) {
            if (toInt(grid[r * 4 + c]) == toInt(grid[r * 4 + c + 1])) { return true; }
        }
    }
    for (int c = 0; c < 4; c = c + 1) {
        for (int r = 0; r < 3; r = r + 1) {
            if (toInt(grid[r * 4 + c]) == toInt(grid[(r + 1) * 4 + c])) { return true; }
        }
    }
    return false;
}

func frame() {
    int dir = 0 - 1;
    if (swiped("left")    || key_pressed("LEFT")  || key_pressed("A")) { dir = 0; }
    else if (swiped("right") || key_pressed("RIGHT") || key_pressed("D")) { dir = 1; }
    else if (swiped("up")    || key_pressed("UP")    || key_pressed("W")) { dir = 2; }
    else if (swiped("down")  || key_pressed("DOWN")  || key_pressed("S")) { dir = 3; }
    if (dir >= 0) {
        do_move(dir);
        if (!can_move()) { game_over(); }
    }
}

// Tile color (by value).
func tile_color(v): int {
    if (v == 0)    { return rgb(40, 44, 60); }
    if (v == 2)    { return rgb(120, 160, 220); }
    if (v == 4)    { return rgb(100, 200, 180); }
    if (v == 8)    { return rgb(230, 180, 90); }
    if (v == 16)   { return rgb(235, 150, 70); }
    if (v == 32)   { return rgb(235, 110, 80); }
    if (v == 64)   { return rgb(230, 80, 80); }
    if (v == 128)  { return rgb(240, 210, 100); }
    if (v == 256)  { return rgb(240, 205, 70); }
    if (v == 512)  { return rgb(240, 200, 50); }
    if (v == 1024) { return rgb(245, 195, 30); }
    return rgb(250, 190, 0);
}

func draw() {
    // Board frame
    rect(OX - GAP, OY - GAP, GRID * CELL + (GRID + 1) * GAP,
         GRID * CELL + (GRID + 1) * GAP, rgb(28, 30, 42));
    for (int r = 0; r < 4; r = r + 1) {
        for (int c = 0; c < 4; c = c + 1) {
            int v = toInt(grid[r * 4 + c]);
            int x = OX + c * (CELL + GAP);
            int y = OY + r * (CELL + GAP);
            rect(x, y, CELL, CELL, tile_color(v));
            if (v != 0) {
                str t = toString(v);
                int sz = 40;
                if (v >= 1000) { sz = 26; }
                else if (v >= 100) { sz = 34; }
                int col = rgb(30, 30, 40);
                if (v <= 4) { col = WHITE; }
                text(t, toInt(x + (CELL - measure_text(t, sz)) / 2.0),
                     toInt(y + (CELL - sz * 1.0) / 2.0), sz, col);
            }
        }
    }
}

scene(640, 480, "2048");
controls("SWIPE with your finger (mobile) / arrow keys (desktop)  |  Equal numbers merge");
control_scheme("none");    // no on-screen buttons — swipe gesture only (+desktop arrows)
star_goals(100, 400, 1000);   // endless: stars from score threshold (1/2/3)
on_start(setup);
on_frame(frame);
on_draw(draw);
play();
