// Tulpar Scene Editor — a STANDALONE APP.
// English twin of examples/scene3d_editor.tpr.
//
//   ./tulpar examples/en/scene3d_editor.tpr
//   ./tulpar build examples/en/scene3d_editor.tpr TameEngine && ./TameEngine
//   ./TameEngine my_scene.json        (open your own scene / create a new file)
//
// IN THE BROWSER:
//   mkdir -p assets && cp <some>.ttf assets/ui.ttf     (a readable font)
//   TULPAR_WEB_ASSETS=assets tulpar build --target=web \
//       examples/en/scene3d_editor.tpr -o editor
//   (serve over HTTP; file:// will not work)
// On the web, "Save" writes to the BROWSER's persistent storage (it survives
// a reload) and "DOWNLOAD" takes the scene out as a .json file.
//
// The editor is not opened from inside a game: you run it, build your scene,
// and pressing "PLAY" runs the game inside the editor's SCENE VIEW panel;
// "STOP" brings you back to editing. That is how Unity, Unreal and Godot work,
// and the difference from overlaying a running game is this: editing is the
// primary act, playing is one of its tools.
//
// SHORTCUTS: the full list lives INSIDE the editor — press H, or the "?"
// button in the menu bar. What follows is a summary; the on-screen list is
// the single source (the status bar no longer enumerates shortcuts, that
// line was getting truncated).
//   RIGHT MOUSE held + WASD/QE   free flight, mouse to look
//   Q / W / E / R                select / move / rotate / scale
//   1 / 2 / 3 / 4                select / move / SCALE / ROTATE  (different!)
//   F / G / SPACE                frame / grid / drop onto the ground
//   DEL / CTRL+D                 delete / duplicate
//   CTRL+C / CTRL+V              copy / paste (works ACROSS LEVELS)
//   CTRL+A                       select all
//   CTRL+Z / CTRL+Y              undo / redo
//   CTRL+S (or F5)               save
//   CTRL+SHIFT+S                 save as (file window)
//   H                            the shortcut list
//   F11                          toggle fullscreen
//   ESC                          close an open window / while playing: stop
// Letter keys are tool shortcuts ONLY while the right mouse button is NOT
// held; while it is held they are flight.
//
// FILES: "Open" in the menu lists the .json scenes on disk — the editor is no
// longer tied to the file it was launched with. "F. Kaydet" (save as) writes
// the scene to ANOTHER file and CTRL+S targets that file from then on; this
// is how you take a template and turn it into your own game. Clicking the
// file that is already open is a REVERT (unsaved work goes, but CTRL+Z still
// brings it back). Switching to a different file RESETS the undo history: if
// it did not, CTRL+Z would pull the previous scene into the new file and
// CTRL+S would write it there.
//
// LEVELS: the strip at the top of the hierarchy. "+ BOLUM EKLE" turns the
// scene into a multi-level one (the live scene becomes level 1); the arrows
// move between them. Switching levels does NOT lose work.
//
// Getting from one level to the NEXT needs an ending condition. Two ways:
//   • a rule:  "cleared: item -> SONRAKI BOLUM" (advance when the gold is gone)
//   • a zone:  place a zone, set its GIRINCE action to "sonraki bol" (an exit)
// On the last level "next level" WINS the game rather than hanging.
//
// ZONES: right-click -> "+ bolge". A zone has an on-enter action: win, lose,
// kill whoever entered (pits/lava), damage, add score, next level. A zone with
// no action does nothing at all — the scene check says so. Zones are drawn in
// the editor (the colour states their condition), clickable, arrow-key movable.
// They also have a SOUND: pick the file that plays on enter from the panel —
// the same sound list the rules use.
//
// DRAG A PANEL BY ITS TITLE: grab the "HIYERARSI" text and pull. While you
// drag, the target zone is highlighted in blue — the left third is the LEFT
// dock, the right third the RIGHT dock, the bottom quarter the BOTTOM dock.
// The middle is not a valid drop (releasing there cancels). The "x" at the
// right end of the title closes the panel; a hidden panel is not drawn and
// takes no space, its area goes to the scene view.
//
// Two panels in the same dock split it evenly — stacked in the side docks,
// side by side in the bottom one.
//
// The PANELLER button in the menu bar does the same from a list, and it is
// the way to bring a HIDDEN panel back (a hidden panel has no title bar, so
// it cannot reopen itself). "VARSAYILAN YERLESIM" restores both the docks
// and the sizes.
//
// Deliberately NOT done: ordering within a dock, TABS, and FLOATING windows.
// All three mean a separate window manager.
//
// PANEL BORDERS ARE DRAGGABLE: grab the line between the hierarchy and the
// scene view, between the scene view and the inspector, or the top of the
// console, and pull. The choice PERSISTS — it survives closing the engine and
// comes back on the next start (the UI scale too). The YERLESIM button in the
// menu bar restores the defaults; that is the way out if you push a border to
// the edge of the screen.
//
// THE WINDOW is resizable and maximizable — drag an edge, use the OS maximize
// button, or press F11 for fullscreen. Every panel and the scene view is
// recomputed for the new size.
//
// ON CLOSING: closing the window no longer loses unsaved work. raylib has no
// hook to cancel a close, so "are you sure?" cannot be asked — instead the
// live scene is written to `<file>.kurtarma.json` and the editor shows a
// KURTAR (recover) button in the menu bar next time it starts. Saving voids
// that file. Recovering is undoable (CTRL+Z) and the recovered work still
// counts as unsaved (the title keeps its asterisk).
//
// CAMERA: in the world panel. Mode (follow / orbit / first person), TARGET
// (the entity the camera watches — the button cycles through them),
// distance/height/fov, and whether the camera stops at walls. A camera with no
// target never moves; the scene check says so. The editor NAMES the target,
// because the scene format refers to entities by name — an unnamed target
// would silently break on save.
//
// Layout:
//   menu bar          New / Open / Save / Save As / Undo / Redo / PANELLER / ?
//   toolbar           tools on the left, PLAY-STOP CENTRED, grid
//   hierarchy | SCENE VIEW | inspector
//   console           the engine's diagnostic log
//   status bar
//
// The scene path is resolved against the WORKING DIRECTORY; run from the
// repo root.

import "scene3d";

// The scene path is resolved against the WORKING DIRECTORY. The editor should
// be runnable from the repo root, from the examples folder, and from next to
// the binary — so a few candidates are tried. Otherwise it is very easy to see
// an "empty scene" and conclude the editor is broken.
func scene_path(): str {
    // IN THE BROWSER there is no command line and no file system: `args()`
    // comes back empty and `file_exists` only sees files packed in with
    // TULPAR_WEB_ASSETS. A fixed name is chosen so the scene always lands in
    // the same place in browser storage ("sahne:<name>") — refresh and your
    // work is still there.
    if (is_web()) {
        if (file_exists("examples/scenes/toplayici.scene.json")) {
            return "examples/scenes/toplayici.scene.json";
        }
        return "scene.json";
    }
    // THE COMMAND LINE comes first: `./TameEngine my_scene.json`. Being able to
    // open only one embedded file made the editor useless for your own work.
    array a = args();
    if (length(a) > 1) { return a[1]; }
    if (file_exists("examples/scenes/toplayici.scene.json")) {
        return "examples/scenes/toplayici.scene.json";
    }
    if (file_exists("scenes/toplayici.scene.json")) {
        return "scenes/toplayici.scene.json";
    }
    if (file_exists("toplayici.scene.json")) { return "toplayici.scene.json"; }
    return "";
}

str SCENE = scene_path();

// If the file is missing we open with an empty world — the editor must open
// no matter what, never sit on a black screen because of an absent file.
str EMPTY = "{\"v\":1,\"world\":{\"title\":\"New Scene\"," +
            "\"sky\":{\"top\":[38,52,92],\"bottom\":[176,198,224]}," +
            "\"ground\":0,\"gravity\":26," +
            "\"camera\":{\"mode\":\"orbit\",\"dist\":16,\"height\":11}},\"entities\":[]}";

func setup() {
    // WEB: there is only one path (scene_path fixed it). If there is saved
    // work it opens, otherwise an empty scene. A missing file is NOT an error
    // here — telling someone to "run from the repo root" would be meaningless
    // in a browser.
    if (is_web()) {
        editor_file3d(SCENE);
        if (scene_file3d(SCENE) == 0) {
            scene_load3d(EMPTY);
            log3d("new scene (browser) — CTRL+S writes to browser storage");
        } else {
            log3d("scene opened: " + SCENE + " — " +
                  toString(alive_count3d()) + " entities");
        }
        log3d("the DOWNLOAD button takes the scene out as .json");
        return;
    }
    // A file given on the command line that does NOT yet exist is not an
    // error: it is the most natural way to create a new scene
    // (`./TameEngine new.json` -> empty scene, F5 writes it there).
    array a = args();
    if (length(a) > 1 && file_exists(a[1]) == false) {
        editor_file3d(a[1]);
        scene_load3d(EMPTY);
        log3d("new scene: " + a[1] + " (will be saved with F5)");
        return;
    }
    if (SCENE == "") {
        // Saving still needs a target.
        editor_file3d("scene.json");
        scene_load3d(EMPTY);
        log_err3d("no scene file found — opened an empty scene.");
        log_err3d("run from the repo root: ./TameEngine");
        return;
    }
    editor_file3d(SCENE);
    if (scene_file3d(SCENE) == 0) {
        scene_load3d(EMPTY);
        log_err3d("could not read scene: " + SCENE);
    } else {
        log3d("scene opened: " + SCENE + " — " +
              toString(alive_count3d()) + " entities");
    }
}

scene3d(1440, 820, "TameEngine");
editor_app3d(true);
on_setup3d(setup);
play3d();
