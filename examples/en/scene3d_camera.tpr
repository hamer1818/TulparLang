// scene3d — ROTATING camera (orbit + first person).
// English twin of examples/scene3d_camera.tpr.
//
//   ./tulpar examples/en/scene3d_camera.tpr
//
// Camera:  1 = fixed follow (the engine's first camera, never rotates)
//          2 = orbit / third person     3 = first person
// Look:    hold RIGHT mouse button and drag  |  Q / E to turn
//          wheel = zoom in/out (orbit mode)
//          in first person the cursor locks and the mouse IS the look
// Walk:    WASD / arrows — direction is RELATIVE TO THE CAMERA: turn the
//          camera and "forward" changes with it
// Jump:    SPACE          |  collect the gold spheres (+10)
// Touch:   left half = stick, right half = drag to look / tap to jump
//
// The game code is only setup + update + a pickup hook; the whole camera
// lives in the engine.

import "scene3d";

int K_1 = 49;   int K_2 = 50;   int K_3 = 51;

int player = 0;
int mode = 2;       // 1 = fixed, 2 = orbit, 3 = first person

func setup() {
    player = spawn3(0.0, 1.0, 0.0,   1.2, 2.0, 1.2, SKYBLUE, SHAPE_CUBE, TAG_PLAYER);
    camera_orbit(player, 13.0, 9.0);    // start in orbit — it can be rotated

    // Ground texture: tiles are what give a sense of scale. With a rotating
    // camera, distance is unreadable on a flat colour.
    int t = checker(128, 128, 8, rgb(150, 158, 168), rgb(120, 128, 140));
    ground_texture3d(t, 24.0);

    // Gold spheres to collect — spread across the arena, including the
    // corners so that turning the camera is actually required.
    spawn3(6.0, 1.0, 4.0,          1.0, 1.0, 1.0, GOLD, SHAPE_SPHERE, TAG_ITEM);
    spawn3(0.0 - 7.0, 1.0, 5.0,    1.0, 1.0, 1.0, GOLD, SHAPE_SPHERE, TAG_ITEM);
    spawn3(5.0, 1.0, 0.0 - 6.0,    1.0, 1.0, 1.0, GOLD, SHAPE_SPHERE, TAG_ITEM);
    spawn3(0.0 - 4.0, 1.0, 0.0 - 7.0, 1.0, 1.0, 1.0, GOLD, SHAPE_SPHERE, TAG_ITEM);
    spawn3(9.0, 1.0, 0.0 - 9.0,    1.0, 1.0, 1.0, GOLD, SHAPE_SPHERE, TAG_ITEM);

    // Pillars: fixed landmarks that make depth readable while rotating.
    spawn3(8.0, 1.5, 8.0,          1.4, 3.0, 1.4, rgb(120, 220, 140), SHAPE_CYL, TAG_PROP);
    spawn3(0.0 - 8.0, 1.5, 0.0 - 8.0, 1.4, 3.0, 1.4, rgb(120, 220, 140), SHAPE_CYL, TAG_PROP);
    spawn3(0.0 - 9.0, 2.0, 6.0,    1.6, 4.0, 1.6, ORANGE, SHAPE_CYL, TAG_PROP);

    // Walls (collision + push-out) — they enclose the arena.
    spawn3(0.0, 1.5, 0.0 - 12.0,   26.0, 3.0, 1.0, GRAY, SHAPE_CUBE, TAG_WALL);
    spawn3(0.0, 1.5, 12.0,         26.0, 3.0, 1.0, GRAY, SHAPE_CUBE, TAG_WALL);
    spawn3(0.0 - 12.0, 1.5, 0.0,   1.0, 3.0, 26.0, GRAY, SHAPE_CUBE, TAG_WALL);
    spawn3(12.0, 1.5, 0.0,         1.0, 3.0, 26.0, GRAY, SHAPE_CUBE, TAG_WALL);
}

func update() {
    // Switch camera mode live, so all three can be tried in one scene.
    if (key_pressed(K_1)) { mode = 1; camera_follow(player, 13.0, 9.0); }
    if (key_pressed(K_2)) { mode = 2; camera_orbit(player, 13.0, 9.0); }
    if (key_pressed(K_3)) { mode = 3; camera_fps(player, 1.4); }

    move3d(player, 8.0);
    if (jump_pressed()) { jump3d(player, 11.0); }
}

// Player touches a gold sphere: take it, +10.
func collect() {
    kill3d(other3d());
    score3d_add(10);
}

scene3d(900, 520, "Tulpar 3D - Camera");
sky3d(rgb(58, 116, 200), rgb(196, 220, 240));
fog3d(0.018);
on_setup3d(setup);
on_update3d(update);
on_hit3d(TAG_PLAYER, TAG_ITEM, collect);
play3d();
