// Tulpar 3D — Phase 2 animation: a rigged model from a file + skeletal
// animation. English twin of examples/tame3d_anim.tpr.
//
//   ./tulpar examples/en/tame3d_anim.tpr        (run from the repo root — the
//                                                asset path is relative)
//   TULPAR_WEB_ASSETS=examples/assets tulpar build --target=web \
//       examples/en/tame3d_anim.tpr out/anim
//
// robot.glb (a raylib sample asset, CC0) is loaded and its embedded animation
// is advanced by one frame per frame (anim_play) -> the skeleton deforms via
// CPU skinning. The camera orbits the model.
//
// For BLENDING between two clips, see examples/en/scene3d_character.tpr: the
// scene3d layer drives the weight itself so idle<->run does not cut in a
// single frame.

import "tame";

int robot   = 0;
int nframes = 0;
int frame   = 0;
int ac      = 0;

func main() {
    if (!window(840, 480, "Tulpar 3D - Animated Model")) { return; }
    set_fps(60);

    robot = load_model("examples/assets/robot.glb");
    if (robot < 0) {
        while (running()) {
            frame_begin();
            clear(rgb(30, 12, 12));
            text("could not load robot.glb (is examples/assets/ on the path?)", 20, 40, 20, RAYWHITE);
            frame_end();
        }
        close_window();
        return;
    }
    ac = anim_count(robot);
    if (ac > 0) { nframes = anim_frames(robot, 0); }

    while (running()) {
        float t = elapsed();
        float cx = sin(t * 0.4) * 9.0;
        float cz = cos(t * 0.4) * 9.0;

        // Advance the animation (looping on the frame count)
        if (nframes > 0) {
            frame = frame + 1;
            if (frame >= nframes) { frame = 0; }
            anim_play(robot, 0, frame);
        }

        frame_begin();
        clear(rgb(18, 20, 30));
        camera3d(cx, 6.0, cz,  0.0, 2.2, 0.0,  45.0);
        space_begin();
            grid(14, 1.0);
            draw_model(robot, 0.0, 0.0, 0.0,  1.0, WHITE);
        space_end();

        text("Tulpar 3D - Animated GLB (robot)", 12, 12, 20, RAYWHITE);
        text("clips: " + toString(ac) + "   frame: " + toString(frame) + "/" + toString(nframes),
             12, 38, 15, rgb(150, 160, 180));
        frame_end();
    }

    unload_model(robot);
    close_window();
}

main();
