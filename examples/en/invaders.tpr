// Space Invaders — arcade preset engine, 3 LEVELS.
// English twin of examples/arcade_uzay.tpr.
//
//   ./tulpar examples/en/invaders.tpr
//
// Left/Right (A/D) to move the ship, SPACE to fire. Clear the fleet (+10) →
// next level. Clear all 3 → YOU WIN. If the fleet descends onto you, or you
// touch its purple bullets, you lose. R to restart.
//
// Levels: 1) 3x5 slow   2) 4x6 fast   3) 4x7 fastest + the fleet SHOOTS BACK
//
// The fleet moves as one body (reverses + steps down at the edge), so the
// invaders are MV_NONE and we drive them in on_frame. A dead invader's handle
// stays in `fleet`, but since it's stale `alive()` returns false → no cleanup.

import "arcade";

int TAG_EBULLET = 6;    // enemy bullet (built-in tags are 1..5; you can pass your own int)

int ship = 0;
array fleet = [];       // this level's invader handles
int fdir = 1;           // fleet direction (+1 right, -1 left)
float fspeed = 55.0;    // fleet horizontal speed (px/s)
int f_shoots = 0;       // 1 = fleet shoots back (level 3)
int t = 0;              // frame counter

int SHIP_Y = 430;

// Global setup — runs before every level's function on each (re)load.
func setup() {
    clear_entities();
    fleet = [];
    fdir = 1;
    t = 0;
    ship = spawn(304, SHIP_Y, 32, 18, SKYBLUE, TAG_PLAYER, MV_NONE);
}

// Lay out a centered fleet. (A wrapper — not a callback, so it may take args.)
func build_fleet(rows, cols, y0, color) {
    int sp = 76;
    int width = (cols - 1) * sp + 32;
    int x0 = toInt((640 - width) / 2);
    for (int r = 0; r < rows; r = r + 1) {
        for (int c = 0; c < cols; c = c + 1) {
            int e = spawn(x0 + c * sp, y0 + r * 40, 32, 24, color, TAG_ENEMY, MV_NONE);
            push(fleet, e);
        }
    }
}

// --- Levels -----------------------------------------------------------------
func l1() { fspeed = 55.0;  f_shoots = 0; build_fleet(3, 5, 70, LIME); }
func l2() { fspeed = 85.0;  f_shoots = 0; build_fleet(4, 6, 60, GOLD); }
func l3() { fspeed = 115.0; f_shoots = 1; build_fleet(4, 7, 55, RED);  }

func on_frame_fn() {
    float dt = frame_time();
    if (dt <= 0.0) { dt = 0.0166667; }
    if (dt > 0.05) { dt = 0.05; }
    t = t + 1;

    // --- Ship: horizontal only -----------------------------------------------
    float gx = get_x(ship);
    if (key_down("LEFT")  || key_down("A")) { gx = gx - 390.0 * dt; }
    if (key_down("RIGHT") || key_down("D")) { gx = gx + 390.0 * dt; }
    if (gx < 0.0) { gx = 0.0; }
    if (gx > 608.0) { gx = 608.0; }
    set_pos(ship, gx, SHIP_Y);

    if (key_pressed("SPACE")) {
        bullet(gx + 13.0, SHIP_Y - 6.0, 6, 14, GOLD, 0, 0 - 470);
    }

    // --- Fleet: reverse + step down if any invader hit the edge ---------------
    bool at_edge = false;
    for (int i = 0; i < len(fleet); i = i + 1) {
        int e = fleet[i];
        if (!alive(e)) { continue; }
        float ex = get_x(e);
        if (ex < 8.0   && fdir < 0) { at_edge = true; }
        if (ex > 600.0 && fdir > 0) { at_edge = true; }
    }
    if (at_edge) { fdir = 0 - fdir; }

    for (int i = 0; i < len(fleet); i = i + 1) {
        int e = fleet[i];
        if (!alive(e)) { continue; }
        float ny = get_y(e);
        if (at_edge) { ny = ny + 22.0; }
        set_pos(e, get_x(e) + fdir * fspeed * dt, ny);
        if (ny > 396.0) { game_over(); }   // fleet reached the ship's row
    }

    // --- Fleet return fire (level 3) -----------------------------------------
    if (f_shoots == 1 && mod(t, 38) == 0) {
        array living = [];
        for (int i = 0; i < len(fleet); i = i + 1) {
            if (alive(fleet[i])) { push(living, fleet[i]); }
        }
        if (len(living) > 0) {
            int e = living[randint(0, len(living) - 1)];
            int m = spawn(get_x(e) + 13.0, get_y(e) + 24.0, 6, 14, MAGENTA, TAG_EBULLET, MV_VELOCITY);
            set_vel(m, 0, 280);
        }
    }
}

// Bullet hits an invader: both die, +10. If the fleet is cleared, next level.
func hit_cb() {
    kill(other());                           // me()=bullet (TAG_BULLET), other()=invader
    kill(me());
    score_add(10);
    if (tag_count(TAG_ENEMY) == 0) { next_level(); }
}

func lose_cb() { game_over(); }

language("en");
scene(640, 480, "Space Invaders");
controls("Left/Right or A/D: ship   SPACE: fire   |   Clear the fleet (+10)");
on_start(setup);
level(1, l1);
level(2, l2);
level(3, l3);
on_frame(on_frame_fn);
on_hit(TAG_BULLET, TAG_ENEMY,   hit_cb);
on_hit(TAG_PLAYER, TAG_ENEMY,   lose_cb);
on_hit(TAG_PLAYER, TAG_EBULLET, lose_cb);
play();
