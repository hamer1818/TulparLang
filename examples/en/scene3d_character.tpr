// scene3d — ANIMATED CHARACTER: rigged model + idle<->run blending.
// English twin of examples/scene3d_karakter.tpr.
//
//   ./tulpar examples/en/scene3d_character.tpr   (run from the repo root —
//                                                 the asset path is relative)
//   TULPAR_WEB_ASSETS=examples/assets tulpar build --target=web \
//       examples/en/scene3d_character.tpr -o out/character
//
// WASD / arrows: walk   |   SPACE: jump
//
// The thing to look at is the character's POSE. When it starts walking or
// stops, the pose does not change in a single frame — the two animations are
// blended over a quarter of a second (`anim_blend_rate3d`). A hard cut is
// what makes the animation obvious and the game look cheap.
//
// All the game code says about animation is which clip is idle and which is
// run (`anim3d`). The engine drives the frame counter, the speed threshold
// and the blend weight.

import "scene3d";

int player = 0;
int robot  = 0 - 1;
int smoke  = 0 - 1;

func setup() {
    // robot.glb — a raylib sample asset (CC0). It has two embedded animations.
    robot = load_model("examples/assets/robot.glb");

    if (robot < 0) {
        // Without the model the example must STILL open: a missing asset
        // should be a stated condition, not a black screen. The box player
        // stays playable.
        log_err3d("could not load robot.glb — run from the repo root");
        player = spawn3(0.0, 1.0, 0.0, 1.2, 2.0, 1.2, SKYBLUE,
                        SHAPE_CUBE, TAG_PLAYER);
    } else {
        player = spawn3_model(0.0, 0.0, 0.0, 1.0, robot, TAG_PLAYER);
        // 0 = idle, 1 = run (robot.glb's clip order). If there are fewer
        // clips than expected we do NOT want the run slot: -1 means "no run
        // clip" and the engine then turns blending off by itself.
        int run = 0 - 1;
        if (anim_count(robot) > 1) { run = 1; }
        anim3d(player, 0, run, 30.0);
        anim_blend_rate3d(4.0);        // a 0.25 s transition
        log3d("robot.glb: " + toString(anim_count(robot)) + " animation(s)");
    }

    // Smoke sheet: a 4x4 atlas. The frame advances over the particle's
    // lifetime (a flipbook), so the smoke OPENS UP — without an atlas the
    // same image would only shrink. Rotation matters here too: each puff
    // starts at a different angle and spins a different way, so the cloud
    // does not read as one solid thing.
    smoke = load_texture("examples/assets/smoke.png");
    if (smoke >= 0) {
        particle_texture3d(smoke, 4, 4);
        particle_spin3d(120.0);
    }

    camera_follow(player, 11.0, 7.0);

    // An area worth running around in: pillars in the corners, walls around.
    spawn3(9.0, 1.5, 9.0,   1.4, 3.0, 1.4, rgb(120, 220, 140), SHAPE_CYL, TAG_PROP);
    spawn3(0.0 - 9.0, 1.5, 9.0,   1.4, 3.0, 1.4, rgb(120, 220, 140), SHAPE_CYL, TAG_PROP);
    spawn3(9.0, 1.5, 0.0 - 9.0,   1.4, 3.0, 1.4, rgb(120, 220, 140), SHAPE_CYL, TAG_PROP);
    spawn3(0.0 - 9.0, 1.5, 0.0 - 9.0, 1.4, 3.0, 1.4, rgb(120, 220, 140), SHAPE_CYL, TAG_PROP);

    spawn3(0.0, 1.5, 0.0 - 14.0,  30.0, 3.0, 1.0, GRAY, SHAPE_CUBE, TAG_WALL);
    spawn3(0.0, 1.5, 14.0,        30.0, 3.0, 1.0, GRAY, SHAPE_CUBE, TAG_WALL);
    spawn3(0.0 - 14.0, 1.5, 0.0,  1.0, 3.0, 30.0, GRAY, SHAPE_CUBE, TAG_WALL);
    spawn3(14.0, 1.5, 0.0,        1.0, 3.0, 30.0, GRAY, SHAPE_CUBE, TAG_WALL);
}

func update() {
    move3d(player, 7.0);
    if (jump_pressed()) {
        jump3d(player, 11.0);
        // A puff of dust at the feet — so the smoke's opening is visible.
        particles3d(get3x(player), get3y(player) - 0.4,
                    get3z(player), 10, rgb(210, 205, 195), 2.4, 0.9);
    }
}

scene3d(900, 520, "Tulpar 3D - Animated Character");
on_setup3d(setup);
on_update3d(update);
play3d();
