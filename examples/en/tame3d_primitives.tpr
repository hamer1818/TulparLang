// Tulpar 3D — Phase 1: primitives + click-to-select (raycast).
// English twin of examples/tame3d_primitives.tpr.
//
//   ./tulpar examples/en/tame3d_primitives.tpr
//
// A ground plane + sphere / cylinder / wire-sphere / 3D line. CLICK a sphere
// with the mouse and it is selected (grows + glows). pick_sphere() casts the
// screen ray at a sphere and returns the distance on a hit — the logic is
// "smallest positive distance wins".

import "tame";

float sel = 0.0 - 1.0;          // selected sphere index (-1 = none)

// World position of the 3 spheres (constants rather than parallel arrays —
// this is a demo).
func sphere_x(i): float { if (i == 0) { return 0.0 - 3.0; } if (i == 1) { return 0.0; } return 3.0; }
func sphere_z(i): float { if (i == 0) { return 0.0; } if (i == 1) { return 0.0 - 2.0; } return 0.0; }

func main() {
    if (!window(820, 460, "Tulpar 3D - Primitives")) { return; }
    set_fps(60);

    while (running()) {
        float t = elapsed();
        float cx = sin(t * 0.5) * 10.0;
        float cz = cos(t * 0.5) * 10.0;

        // --- Click-to-select: take the nearest sphere that was hit ----------
        if (mouse_pressed(0)) {
            float mx = mouse_x();
            float my = mouse_y();
            float best = 1000000.0;
            float found = 0.0 - 1.0;
            for (int i = 0; i < 3; i = i + 1) {
                camera3d(cx, 7.0, cz,  0.0, 0.0, 0.0,  45.0);
                float d = pick_sphere(mx, my, sphere_x(i), 1.0, sphere_z(i), 1.0);
                if (d >= 0.0 && d < best) { best = d; found = i * 1.0; }
            }
            sel = found;
        }

        frame_begin();
        clear(rgb(16, 18, 26));
        camera3d(cx, 7.0, cz,  0.0, 0.0, 0.0,  45.0);   // eye, target, FOV

        space_begin();
            plane(0.0, 0.0, 0.0,  16.0, 16.0, rgb(30, 34, 48));   // ground
            grid(16, 1.0);

            // 3 spheres — the selected one is bigger and gold
            for (int i = 0; i < 3; i = i + 1) {
                float r = 1.0;
                int col = rgb(90, 200, 255);
                if (sel == i * 1.0) { r = 1.4; col = GOLD; }
                sphere(sphere_x(i), 1.0, sphere_z(i), r, col);
            }

            cylinder(0.0 - 5.0, 0.0, 4.0,  0.8, 3.0, rgb(255, 130, 90));  // cylinder
            sphere_wires(5.0, 1.5, 3.0,  1.3, 12, rgb(180, 255, 160));    // wire sphere
            line3d(0.0 - 6.0, 0.1, 0.0 - 6.0,  6.0, 0.1, 6.0, GOLD);      // 3D line
        space_end();

        text("Tulpar 3D - Phase 1: primitives + raycast", 14, 12, 20, RAYWHITE);
        text("CLICK a sphere -> it is selected (grows/glows)", 14, 38, 15, rgb(150, 160, 180));
        frame_end();
    }
    close_window();
}

main();
