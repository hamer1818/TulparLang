// --- Bölüm 6: yoğun 5 sıra, ortası boş + en hızlı top -----------------------
func tu_b6() {
    tu_topu_at(384, 0 - 480);
    tu_tugla_satir(72,  8, 32,  PURPLE);
    tu_tugla_satir(96,  8, 32,  VIOLET);
    tu_tugla_satir(120, 3, 32,  RED);
    tu_tugla_satir(120, 3, 320, RED);
    tu_tugla_satir(144, 8, 32,  ORANGE);
