// Tulpar Arcade — LAUNCHER: TÜM arcade oyunları tek pencerede / tek APK'da.
//
//   ./tulpar examples/arcade_launcher.tpr
//   tulpar build --target=android examples/arcade_launcher.tpr out   (mobil)
//
// Açılışta menü ızgarası; bir karta dokun (ya da ok tuşları + ENTER) → oyun
// başlar. Oyun içinde sağ-üst EV butonu (ya da ESC) → menü. Klavye + dokunma
// (D-pad + aksiyon) her oyunda çalışır.
//
// BU DOSYA ÜRETİLDİ (tools/make_arcade_launcher.py): her oyun examples/arcade_*.tpr
// dosyasından alınıp sembolleri <önek>_ ile namespace'lendi ve top-level kayıt
// bloğu `func <önek>_setup()` içine taşındı (sahne/oyna düşürüldü). Oyun mantığı
// aynen korunur; kaynak oyunlar hâlâ tek başına da çalışır.

import "arcade";

// ==========================================================================
//  Topla  (examples/arcade_topla.tpr, önek tp_)
// ==========================================================================
// Topla — arcade preset motoruyla "blok" tarzı bir oyun, 6 BÖLÜM.
//
//   ./tulpar examples/arcade_topla.tpr
//
// Ok tuşları / WASD ile oyuncuyu (mavi) sür. Sarı eşyaları topla (+10).
// Bölümün TÜM eşyalarını toplayınca sıradaki bölüme geçersin; 6 bölümü de
// bitirince KAZANDIN. Kırmızı düşmana değersen oyun biter, R ile baştan.
//
// Bölümler:  1) 3 eşya / 1 düşman   2) 5 eşya / 2 düşman   3) 6 eşya / 3 hızlı düşman
//            4) 7 eşya / 3 düşman   5) 8 eşya / 4 düşman   6) 9 eşya / 4 çok hızlı
//
// Dikkat et: TEK BİR oyun döngüsü, çarpışma kodu ya da çizim YOK. Motor
// hepsini yapıyor; sen sadece blokları yerleştiriyorsun.


array tp_dusmanlar = [];    // sekme mantığı için bölümün düşman handle'ları

// Düşman üret + sekmesi için listeye al. (Sarma fonksiyon — callback değil,
// argüman alabilir; 0-arg kısıtı sadece call() ile çağrılanlar için.)
func tp_dusman_ekle(x, y, vx, vy) {
    int e = uret(x, y, 24, 24, RED, TAG_ENEMY, MV_VELOCITY);
    hiz_ver(e, vx, vy);
    push(tp_dusmanlar, e);
}

// Global kurulum — her bölüm yüklemesinde bölüm fn'inden ÖNCE çalışır.
func tp_kur() {
    temizle();
    tp_dusmanlar = [];
    oyuncu(300, 220, 24, 24, BLUE);               // ok/WASD hazır
}

// --- Bölüm 1: 3 eşya, 1 düşman ----------------------------------------------
func tp_b1() {
    esya(80,  80,  18, 18, GOLD);
    esya(520, 90,  18, 18, GOLD);
    esya(120, 380, 18, 18, GOLD);
    tp_dusman_ekle(300, 40, 180, 140);
}

// --- Bölüm 2: 5 eşya, 2 düşman ----------------------------------------------
func tp_b2() {
    esya(80,  80,  18, 18, GOLD);
    esya(520, 90,  18, 18, GOLD);
    esya(120, 380, 18, 18, GOLD);
    esya(500, 360, 18, 18, GOLD);
    esya(300, 60,  18, 18, GOLD);
    tp_dusman_ekle(300, 40,  200, 160);
    tp_dusman_ekle(60,  440, 0 - 170, 190);
}

// --- Bölüm 3: 6 eşya, 3 hızlı düşman ----------------------------------------
func tp_b3() {
    esya(80,  80,  18, 18, GOLD);
    esya(520, 90,  18, 18, GOLD);
    esya(120, 380, 18, 18, GOLD);
    esya(500, 360, 18, 18, GOLD);
    esya(300, 60,  18, 18, GOLD);
    esya(60,  220, 18, 18, GOLD);
    tp_dusman_ekle(300, 40,  250, 210);
    tp_dusman_ekle(60,  440, 0 - 230, 240);
    tp_dusman_ekle(600, 240, 260, 0 - 220);
}

// --- Bölüm 4: 7 eşya, 3 daha hızlı düşman -----------------------------------
func tp_b4() {
    esya(60,  60,  18, 18, GOLD);
    esya(300, 60,  18, 18, GOLD);
    esya(560, 60,  18, 18, GOLD);
    esya(60,  240, 18, 18, GOLD);
    esya(560, 240, 18, 18, GOLD);
    esya(180, 400, 18, 18, GOLD);
    esya(440, 400, 18, 18, GOLD);
    tp_dusman_ekle(320, 40,  270, 230);
    tp_dusman_ekle(60,  440, 0 - 250, 260);
    tp_dusman_ekle(600, 240, 280, 0 - 240);
}

// --- Bölüm 5: 8 eşya, 4 düşman ----------------------------------------------
func tp_b5() {
    esya(60,  60,  18, 18, GOLD);
    esya(300, 50,  18, 18, GOLD);
    esya(560, 60,  18, 18, GOLD);
    esya(60,  220, 18, 18, GOLD);
    esya(560, 220, 18, 18, GOLD);
    esya(60,  400, 18, 18, GOLD);
    esya(300, 420, 18, 18, GOLD);
    esya(560, 400, 18, 18, GOLD);
    tp_dusman_ekle(300, 40,  290, 240);
    tp_dusman_ekle(60,  440, 0 - 270, 250);
    tp_dusman_ekle(600, 60,  0 - 280, 270);
    tp_dusman_ekle(320, 240, 300, 0 - 230);
}

// --- Bölüm 6: 9 eşya, 4 çok hızlı düşman ------------------------------------
func tp_b6() {
    esya(60,  60,  18, 18, GOLD);
    esya(300, 50,  18, 18, GOLD);
    esya(560, 60,  18, 18, GOLD);
    esya(60,  240, 18, 18, GOLD);
    esya(300, 240, 18, 18, GOLD);
    esya(560, 240, 18, 18, GOLD);
    esya(60,  420, 18, 18, GOLD);
    esya(300, 420, 18, 18, GOLD);
    esya(560, 420, 18, 18, GOLD);
    tp_dusman_ekle(300, 40,  320, 270);
    tp_dusman_ekle(60,  440, 0 - 300, 290);
    tp_dusman_ekle(600, 60,  0 - 310, 300);
    tp_dusman_ekle(600, 440, 0 - 300, 0 - 280);
}

// Düşmanlar duvara çarpınca seksin (motor MV_VELOCITY'yi sınırda tutmaz).
//
// NOT: hız `vx_of()` ile okunur — `_evx[id]` YANLIŞTIR: id bir handle'dır
// (gen*1048576 + slot), paralel diziler ise slot ile indekslenir.
// Yön kontrolü (`&& vx < 0.0`) kenarda titremeyi önler: sınırın dışındayken
// her karede tekrar ters çevirmek cismi oraya kilitlerdi.
func tp_her_kare_is() {
    for (int i = 0; i < len(tp_dusmanlar); i = i + 1) {
        int e = tp_dusmanlar[i];
        if (!yasiyor(e)) { continue; }
        float x = x_of(e);
        float y = y_of(e);
        float vx = vx_of(e);
        float vy = vy_of(e);
        if (x < 0.0   && vx < 0.0) { vx = 0.0 - vx; }
        if (x > 616.0 && vx > 0.0) { vx = 0.0 - vx; }
        if (y < 0.0   && vy < 0.0) { vy = 0.0 - vy; }
        if (y > 456.0 && vy > 0.0) { vy = 0.0 - vy; }
        hiz_ver(e, vx, vy);
    }
}

// Oyuncu eşyaya değince: topla, +10 puan. Bölümün son eşyasıysa sıradaki bölüm.
func tp_topla_cb() {
    patlama(x_of(oteki()) + 9.0, y_of(oteki()) + 9.0, GOLD);  // eşya parçacığı
    oldur(oteki());
    skor_ekle(10);
    if (tag_sayisi(TAG_ITEM) == 0) { bolum_gec(); }
}

// Oyuncu düşmana değince: oyun biter.
func tp_kaybet_cb() { oyun_bitti(); }

func tp_setup() {
    bilgi("Ok tuslari / WASD: hareket   |   Tum sarilari topla (+10), kirmiziya degme");
    baslangicta(tp_kur);
    bolum(1, tp_b1);
    bolum(2, tp_b2);
    bolum(3, tp_b3);
    bolum(4, tp_b4);
    bolum(5, tp_b5);
    bolum(6, tp_b6);
    her_kare(tp_her_kare_is);
    carpisinca(TAG_PLAYER, TAG_ITEM,  tp_topla_cb);
    carpisinca(TAG_PLAYER, TAG_ENEMY, tp_kaybet_cb);
}

// ==========================================================================
//  Zipla  (examples/arcade_zipla.tpr, önek zp_)
// ==========================================================================
// Zipla — platformer preset'i (yerçekimi + platformlar + zıplama), 6 BÖLÜM.
//
//   ./tulpar examples/arcade_zipla.tpr
//
// Sol/Sağ (A/D) ile yürü, SPACE / YUKARI ile zıpla. Yerçekimi, zemin ve
// `duvar()` platformlarına iniş hazır gelir. Platformları tırmanıp altın hedefe
// ulaş → +100 ve sıradaki bölüm. 6 bölümü de bitir → KAZANDIN.
// Fizik/çarpışma/döngü/çizim kodu YOK; bölüm fn'leri sadece düzeni kurar.
//
// Bölümler:  1) kolay, 2 platform   2) daha uzak/yüksek atlayışlar, 4 platform
//            3) dar platformlar + gidip gelen ölümcül engel
//            4) 5 platform zikzak + süpüren engel   5) 5 platform + 2 karşıt engel
//            6) dar platformlar + 2 hızlı engel (en zor)
//
// Zıplama payı (yercekimi 1400 / ziplama 640): tepe yüksekliği ~146px, havada
// kalma ~0.91sn → ~180px yatay. Düzenler bu yüzden ≤80px dikey / ≤140px yatay
// açıklıkla kuruldu; bu sınırları aşarsan bölüm bitirilemez hale gelir.


array zp_engeller = [];   // gidip gelen ölümcül engeller (bölüm başına)

// Engel üret + kenarda sekmesi için listeye al. vy!=0 ise dikey de gider.
func zp_engel_ekle(x, y, vx, vy) {
    int e = uret(x, y, 24, 24, RED, TAG_ENEMY, MV_VELOCITY);
    hiz_ver(e, vx, vy);
    push(zp_engeller, e);
}

// Global kurulum — her bölüm yüklemesinde bölüm fn'inden ÖNCE çalışır.
func zp_kur() {
    temizle();
    oyuncu_p(40, 380, 28, 28, SKYBLUE);          // platformer oyuncusu (tek satır)
    duvar(0, 448, 640, 32, DARKGRAY);            // zemin şeridi (her bölümde var)
    zp_engeller = [];
}

// --- Bölüm 1: iki platform, rahat atlayış -----------------------------------
func zp_b1() {
    duvar(160, 350, 130, 20, BROWN);
    duvar(380, 250, 130, 20, BROWN);
    esya(430, 212, 24, 24, GOLD);                // hedef: üst platformun üstünde
}

// --- Bölüm 2: dört platform, zikzak tırmanış --------------------------------
func zp_b2() {
    duvar(150, 372, 110, 20, BROWN);
    duvar(330, 292, 110, 20, BROWN);
    duvar(140, 212, 110, 20, BROWN);
    duvar(320, 140, 110, 20, BROWN);
    esya(365, 102, 24, 24, GOLD);
}

// --- Bölüm 3: dar platformlar + ölümcül engel -------------------------------
func zp_b3() {
    duvar(150, 372, 76, 20, BROWN);
    duvar(300, 300, 76, 20, BROWN);
    duvar(460, 228, 76, 20, BROWN);
    duvar(250, 156, 76, 20, BROWN);
    esya(288, 118, 24, 24, GOLD);
    // Yatay gidip gelen engel — tırmanış hattını keser (duvarları takmaz).
    zp_engel_ekle(60, 250, 170, 0);
}

// --- Bölüm 4: beş platform zikzak + orta şeritte süpüren engel ---------------
func zp_b4() {
    duvar(140, 376, 96, 20, BROWN);
    duvar(330, 300, 96, 20, BROWN);
    duvar(140, 224, 96, 20, BROWN);
    duvar(330, 148, 96, 20, BROWN);
    esya(366, 110, 24, 24, GOLD);                // en üst platformun üstünde
    zp_engel_ekle(300, 340, 200, 0);                // alt-orta şeridi süpürür
}

// --- Bölüm 5: beş platform + iki karşıt yönlü engel --------------------------
func zp_b5() {
    duvar(120, 388, 88, 20, BROWN);
    duvar(300, 316, 88, 20, BROWN);
    duvar(120, 244, 88, 20, BROWN);
    duvar(300, 172, 88, 20, BROWN);
    duvar(120, 104, 88, 20, BROWN);
    esya(150, 66, 24, 24, GOLD);
    zp_engel_ekle(300, 352, 210, 0);                // alt şerit
    zp_engel_ekle(300, 208, 0 - 190, 0);            // orta şerit (ters yön)
}

// --- Bölüm 6: dar platformlar + iki hızlı engel (en zor) --------------------
func zp_b6() {
    duvar(140, 392, 74, 20, BROWN);
    duvar(320, 324, 74, 20, BROWN);
    duvar(140, 256, 74, 20, BROWN);
    duvar(320, 188, 74, 20, BROWN);
    duvar(140, 120, 74, 20, BROWN);
    esya(168, 82, 24, 24, GOLD);
    zp_engel_ekle(320, 358, 230, 0);                // alt şerit (hızlı)
    zp_engel_ekle(320, 222, 0 - 210, 0);            // orta şerit (hızlı, ters)
}

// Engelleri ekran kenarlarında geri döndür (motor MV_VELOCITY'yi sınırda tutmaz).
func zp_her_kare_is() {
    for (int i = 0; i < len(zp_engeller); i = i + 1) {
        int e = zp_engeller[i];
        if (!yasiyor(e)) { continue; }
        float ex = x_of(e); float ey = y_of(e);
        float evx = vx_of(e); float evy = vy_of(e);
        if (ex < 20.0  && evx < 0.0) { evx = 0.0 - evx; }
        if (ex > 596.0 && evx > 0.0) { evx = 0.0 - evx; }
        if (ey < 20.0  && evy < 0.0) { evy = 0.0 - evy; }
        if (ey > 420.0 && evy > 0.0) { evy = 0.0 - evy; }
        hiz_ver(e, evx, evy);
    }
}

func zp_hedef_cb() {                                  // hedefe ulaş → sıradaki bölüm
    patlama(x_of(oteki()) + 12.0, y_of(oteki()) + 12.0, GOLD);
    skor_ekle(100);
    bolum_gec();
}
func zp_kaybet_cb() {                                 // engele değ → oyun biter
    patlama(x_of(ben()) + 14.0, y_of(ben()) + 14.0, ORANGE);
    oyun_bitti();
}

ziplama(640);
music_theme(2);   // neseli tema (platformer)

func zp_setup() {
    yercekimi(1400);
    bilgi("Sol/Sag veya A/D: yuru   SPACE/YUKARI: zipla   |   Altin hedefe ulas");
    baslangicta(zp_kur);
    bolum(1, zp_b1);
    bolum(2, zp_b2);
    bolum(3, zp_b3);
    bolum(4, zp_b4);
    bolum(5, zp_b5);
    bolum(6, zp_b6);
    her_kare(zp_her_kare_is);
    carpisinca(TAG_PLAYER, TAG_ITEM,  zp_hedef_cb);
    carpisinca(TAG_PLAYER, TAG_ENEMY, zp_kaybet_cb);
}

// ==========================================================================
//  Nisan  (examples/arcade_nisan.tpr, önek ni_)
// ==========================================================================
// Nisanci — yukarıdan-bakış atış oyunu, 6 BÖLÜM. ~35 satır oyun kodu.
//
//   ./tulpar examples/arcade_nisan.tpr
//
// Ok/WASD ile hareket, SPACE ile ateş et. Yukarıdan inen kırmızıları vur (+10).
// Hedef skora ulaş → sıradaki bölüm; 6 bölümü de bitir → KAZANDIN.
// Bir düşman sana değerse oyun biter, R ile baştan.
//
// Bölümler (skor bölümler arası KORUNDUĞU için hedefler kümülatiftir):
//   1) hedef 30   2) hedef 60   3) hedef 100
//   4) hedef 150  5) hedef 210  6) en hızlı, hedef 290
//
// mermi() ekrandan çıkınca motor onu kendisi siler. Döngü/çarpışma/çizim YOK.


int ni_player_id = 0;
int ni_t = 0;              // kare sayacı (periyodik düşman üretimi için)

int ni_spawn_period = 45;  // her N karede bir düşman
int ni_enemy_vy     = 120; // düşman iniş hızı (px/sn)
int ni_hedef        = 30;  // bu bölümü bitiren (kümülatif) skor

// Global kurulum — her bölüm yüklemesinde bölüm fn'inden ÖNCE çalışır.
func ni_kur() {
    temizle();
    ni_t = 0;
    ni_player_id = oyuncu(300, 420, 28, 28, SKYBLUE);
}

// --- Bölümler: düzen aynı, tempo/hedef değişir ------------------------------
func ni_b1() { ni_spawn_period = 45; ni_enemy_vy = 120; ni_hedef = 30;  }
func ni_b2() { ni_spawn_period = 30; ni_enemy_vy = 170; ni_hedef = 60;  }
func ni_b3() { ni_spawn_period = 20; ni_enemy_vy = 220; ni_hedef = 100; }
func ni_b4() { ni_spawn_period = 16; ni_enemy_vy = 260; ni_hedef = 150; }
func ni_b5() { ni_spawn_period = 13; ni_enemy_vy = 300; ni_hedef = 210; }
func ni_b6() { ni_spawn_period = 10; ni_enemy_vy = 340; ni_hedef = 290; }

func ni_her_kare_is() {
    ni_t = ni_t + 1;

    // Bölümün temposuna göre tepeden rastgele bir düşman düşür.
    if (mod(ni_t, ni_spawn_period) == 0) {
        int ex = randint(20, 600);
        int e = uret(ex, 0 - 20, 26, 26, RED, TAG_ENEMY, MV_VELOCITY);
        hiz_ver(e, 0, ni_enemy_vy);
    }

    // SPACE / aksiyon butonu → yukarı doğru mermi (klavye + dokunmatik).
    if (ates_basildi()) {
        mermi(x_of(ni_player_id) + 10.0, y_of(ni_player_id), 8, 14, GOLD, 0, 0 - 420);
    }

    // Hedef skora ulaşıldıysa sıradaki bölüm (son bölümde → KAZANDIN).
    if (skor() >= ni_hedef) { bolum_gec(); }
}

func ni_vur_cb() {                                       // mermi düşmana değince
    patlama(x_of(oteki()) + 13.0, y_of(oteki()) + 13.0, ORANGE);
    oldur(oteki());
    skor_ekle(10);
}
func ni_kaybet_cb() {                                    // düşman oyuncuya değince
    patlama(x_of(ni_player_id) + 14.0, y_of(ni_player_id) + 14.0, ORANGE);
    oyun_bitti();
}

music_theme(1);   // gergin tema (nisanci)
// Şerit 640px'e sığmalı — uzun metin sağdan kırpılır (bölüm/hedef zaten HUD'da).

func ni_setup() {
    bilgi("Ok/WASD: hareket   SPACE: ates   |   Kirmizilari vur (+10)");
    kontrol_semasi("yatay");   // mobilde sag/sol ok butonlari + ates butonu
    baslangicta(ni_kur);
    bolum(1, ni_b1);
    bolum(2, ni_b2);
    bolum(3, ni_b3);
    bolum(4, ni_b4);
    bolum(5, ni_b5);
    bolum(6, ni_b6);
    her_kare(ni_her_kare_is);
    carpisinca(TAG_BULLET, TAG_ENEMY,  ni_vur_cb);
    carpisinca(TAG_PLAYER, TAG_ENEMY,  ni_kaybet_cb);
}

// ==========================================================================
//  Tugla  (examples/arcade_tugla.tpr, önek tu_)
// ==========================================================================
// Tugla Kirma (Breakout) — arcade preset motoru, 6 BÖLÜM.
//
//   ./tulpar examples/arcade_tugla.tpr
//
// Sol/Sağ (A/D) ile raketi sür, topu düşürme. Tüm tuğlaları kır (+10) →
// sıradaki bölüm. 6 bölümü de bitir → KAZANDIN. R ile baştan.
//
// Bölümler: 1) 3 sıra düz duvar   2) piramit   3) boşluklu duvar + hızlı top
//           4) 4 dolu sıra   5) elmas/piramit karışık   6) yoğun 5 sıra + en hızlı
//
// Motorla eşleşme: tuğlalar `esya()` (TAG_ITEM), top `TAG_BULLET` + MV_VELOCITY,
// raket `TAG_PLAYER` + MV_NONE (yatay hareketi her_kare içinde sürüyoruz —
// MV_TOPDOWN 4 yöne giderdi, raket sadece sağa/sola gitmeli).


int tu_raket = 0;
int tu_top   = 0;
int tu_bounced = 0;        // top bu karede zaten sektirildi mi? (bkz. kir_cb)
float tu_bspeed = 0.0;     // topun GÜNCEL hız büyüklüğü — her tuğlada artar (tavana dek)
float tu_BSPEED_MAX = 620.0;

// Topu at + hız büyüklüğünü kaydet. Bölüm fn'leri bunu çağırır (yön + başlangıç
// hızını verir); sonrasında sekmeler bu büyüklüğü korur, tuğla kırışı artırır.
func tu_topu_at(vx, vy) {
    hiz_ver(tu_top, vx, vy);
    tu_bspeed = sqrt(vx * vx + vy * vy);
}

int tu_RAKET_W = 100;
int tu_RAKET_Y = 440;

// Global kurulum — her bölüm yüklemesinde bölüm fn'inden ÖNCE çalışır.
func tu_kur() {
    temizle();
    tu_raket = uret(270, tu_RAKET_Y, tu_RAKET_W, 14, SKYBLUE, TAG_PLAYER, MV_NONE);
    tu_top   = uret(316, 300, 12, 12, GOLD, TAG_BULLET, MV_VELOCITY);
}

// Bir sıra tuğla diz. (Sarma fonksiyon — callback değil, argüman alabilir;
// 0-arg kısıtı yalnız call() ile çağrılanlar için.)
func tu_tugla_satir(y, adet, x0, renk) {
    for (int i = 0; i < adet; i = i + 1) {
        esya(x0 + i * 72, y, 68, 18, renk);
    }
}

// --- Bölüm 1: 3 sıra düz duvar ----------------------------------------------
func tu_b1() {
    tu_topu_at(228, 0 - 300);
    tu_tugla_satir(80,  8, 32, RED);
    tu_tugla_satir(104, 8, 32, ORANGE);
    tu_tugla_satir(128, 8, 32, GOLD);
}

// --- Bölüm 2: piramit -------------------------------------------------------
func tu_b2() {
    tu_topu_at(264, 0 - 348);
