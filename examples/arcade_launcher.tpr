func tu_her_kare_is() {
    float dt = frame_time();
    if (dt <= 0.0) { dt = 0.0166667; }
    if (dt > 0.05) { dt = 0.05; }
    tu_bounced = 0;

    // --- Raket: sadece yatay -------------------------------------------------
    float rx = x_of(tu_raket);
    if (sol()) { rx = rx - 430.0 * dt; }   // klavye VEYA dokunmatik joystick
    if (sag()) { rx = rx + 430.0 * dt; }
    if (rx < 0.0) { rx = 0.0; }
    float rmax = 640.0 - tu_RAKET_W;
    if (rx > rmax) { rx = rmax; }
    konumla(tu_raket, rx, tu_RAKET_Y);

    // --- Top: kenarlardan sek ------------------------------------------------
    // Yön kontrolü (`&& bvx < 0.0`) kenarda titremeyi önler: sınırın dışındayken
    // her karede tekrar ters çevirmek topu oraya kilitlerdi.
    float bx  = x_of(tu_top);
    float by  = y_of(tu_top);
    float bvx = vx_of(tu_top);
    float bvy = vy_of(tu_top);
    if (bx < 0.0   && bvx < 0.0) { bvx = 0.0 - bvx; }
    if (bx > 628.0 && bvx > 0.0) { bvx = 0.0 - bvx; }
    if (by < 0.0   && bvy < 0.0) { bvy = 0.0 - bvy; }
    hiz_ver(tu_top, bvx, bvy);

    // Alt sınırı geçti → kaybettin.
    if (by > 474.0) { oyun_bitti(); }
}

// Top rakete değince: yukarı sek + rakete göre sapma ver (merkezden uzaklaştıkça
// daha yatay) — klasik breakout nişan alma hissi.
func tu_raket_cb() {
    int b = oteki();                       // ben()=raket (TAG_PLAYER), oteki()=top
    float bx = x_of(b);
    float sapma = (bx + 6.0) - (x_of(tu_raket) + tu_RAKET_W * 0.5);
    float nvx = sapma * 5.0;
    // Yatay bileşeni büyüklüğün %85'iyle sınırla; dikey bileşen kalanı → toplam
    // hız her zaman `bspeed` (tuğlalarla artırdığımız büyüklük) kalır.
    float capv = tu_bspeed * 0.85;
    if (nvx > capv) { nvx = capv; }
    if (nvx < 0.0 - capv) { nvx = 0.0 - capv; }
    float nvy = 0.0 - sqrt(tu_bspeed * tu_bspeed - nvx * nvx);   // her zaman YUKARI
    hiz_ver(b, nvx, nvy);
    konumla(b, bx, tu_RAKET_Y - 14.0);        // rakete gömülüp kilitlenmesin
}

// Top tuğlaya değince: tuğlayı kır, +10, dikey sek. Son tuğlaysa bölüm geç.
//
// `bounced` koruması: bir karede iki tuğlaya birden değince iki kez ters
// çevirmek topu eski yönüne döndürür (tuğlaların içinden geçer gibi görünür).
func tu_kir_cb() {
    int b = ben();                         // ben()=top (TAG_BULLET), oteki()=tuğla
    patlama(x_of(oteki()) + 34.0, y_of(oteki()) + 9.0, ORANGE);  // tuğla parçacığı
    oldur(oteki());
    skor_ekle(10);
    if (tu_bounced == 0) {
        // Her tuğlada topu HIZLANDIR (tavana dek) — yönü koru, büyüklüğü artır +
        // dikey sek. Böylece bölüm ilerledikçe oyun tempolanır (sabit yavaş kalmaz).
        tu_bspeed = tu_bspeed + 12.0;
        if (tu_bspeed > tu_BSPEED_MAX) { tu_bspeed = tu_BSPEED_MAX; }
        float vx = vx_of(b);
        float vy = 0.0 - vy_of(b);
        float m = sqrt(vx * vx + vy * vy);
        if (m > 0.0) { vx = vx / m * tu_bspeed; vy = vy / m * tu_bspeed; }
        hiz_ver(b, vx, vy);
        tu_bounced = 1;
    }
    if (tag_sayisi(TAG_ITEM) == 0) { bolum_gec(); }
}

// Mutlak değer (float) — tame'de yok.
func tu_abs_f(v): float {
    if (v < 0.0) { return 0.0 - v; }
    return v;
}

func tu_setup() {
    bilgi("Sol/Sag veya A/D: raket   |   Tum tuglalari kir (+10), topu dusurme");
    baslangicta(tu_kur);
    bolum(1, tu_b1);
    bolum(2, tu_b2);
    bolum(3, tu_b3);
    bolum(4, tu_b4);
    bolum(5, tu_b5);
    bolum(6, tu_b6);
    her_kare(tu_her_kare_is);
    carpisinca(TAG_PLAYER, TAG_BULLET, tu_raket_cb);
    carpisinca(TAG_BULLET, TAG_ITEM,   tu_kir_cb);
}

// ==========================================================================
//  Uzay  (examples/arcade_uzay.tpr, önek uz_)
// ==========================================================================
// Uzay Istilasi (Space Invaders) — arcade preset motoru, 6 BÖLÜM.
//
//   ./tulpar examples/arcade_uzay.tpr
//
// Sol/Sağ (A/D) ile gemiyi sür, SPACE ile ateş et. Filoyu temizle (+10) →
// sıradaki bölüm. 6 bölümü de bitir → KAZANDIN. Filo sana inerse ya da
// mor mermilerine değersen kaybedersin. R ile baştan.
//
// Bölümler: 1) 3x5 yavaş   2) 4x6 hızlı   3) 4x7 + filo GERİ ATEŞ eder
//           4) 5x7   5) 5x8 daha sık ateş   6) 6x8 en hızlı + en sık ateş
//
// Filo tek parça hareket eder (kenara değince yön değişir + bir kademe iner),
// bu yüzden düşmanlar MV_NONE ve hareketi her_kare içinde biz sürüyoruz.
// Ölen düşmanın handle'ı `filo` dizisinde kalır ama bayatladığı için
// `yasiyor()` false döner → ayrıca temizlemeye gerek yok.


int uz_TAG_EBULLET = 6;    // düşman mermisi (hazır tag'ler 1..5; kendi int'ini verebilirsin)

int uz_gemi = 0;
array uz_filo = [];        // bölümün düşman handle'ları
int uz_fdir = 1;           // filo yönü (+1 sağ, -1 sol)
float uz_fspeed = 55.0;    // filo yatay hızı (px/sn)
int uz_f_atis = 0;         // 1 = filo geri ateş eder (bölüm 3+)
int uz_f_period = 38;      // filo geri ateş periyodu (kare) — düştükçe daha sık
int uz_t = 0;              // kare sayacı

int uz_GEMI_Y = 430;

// Global kurulum — her bölüm yüklemesinde bölüm fn'inden ÖNCE çalışır.
func uz_kur() {
    temizle();
    uz_filo = [];
    uz_fdir = 1;
    uz_t = 0;
    uz_gemi = uret(304, uz_GEMI_Y, 32, 18, SKYBLUE, TAG_PLAYER, MV_NONE);
}

// Ortalanmış filo diz. (Sarma fonksiyon — callback değil, argüman alabilir.)
func uz_filo_kur(satir, sutun, y0, renk) {
    int sp = 76;
    int genislik = (sutun - 1) * sp + 32;
    int x0 = toInt((640 - genislik) / 2);
    for (int r = 0; r < satir; r = r + 1) {
        for (int c = 0; c < sutun; c = c + 1) {
            int e = uret(x0 + c * sp, y0 + r * 40, 32, 24, renk, TAG_ENEMY, MV_NONE);
            push(uz_filo, e);
        }
    }
}

// --- Bölümler ---------------------------------------------------------------
func uz_b1() { uz_fspeed = 55.0;  uz_f_atis = 0; uz_f_period = 38; uz_filo_kur(3, 5, 70, LIME);   }
func uz_b2() { uz_fspeed = 85.0;  uz_f_atis = 0; uz_f_period = 38; uz_filo_kur(4, 6, 60, GOLD);   }
func uz_b3() { uz_fspeed = 115.0; uz_f_atis = 1; uz_f_period = 38; uz_filo_kur(4, 7, 55, RED);    }
func uz_b4() { uz_fspeed = 145.0; uz_f_atis = 1; uz_f_period = 34; uz_filo_kur(5, 7, 55, GOLD);   }
func uz_b5() { uz_fspeed = 175.0; uz_f_atis = 1; uz_f_period = 30; uz_filo_kur(5, 8, 50, ORANGE); }
func uz_b6() { uz_fspeed = 210.0; uz_f_atis = 1; uz_f_period = 24; uz_filo_kur(6, 8, 45, RED);    }

func uz_her_kare_is() {
    float dt = frame_time();
    if (dt <= 0.0) { dt = 0.0166667; }
    if (dt > 0.05) { dt = 0.05; }
    uz_t = uz_t + 1;

    // --- Gemi: sadece yatay --------------------------------------------------
    float gx = x_of(uz_gemi);
    if (sol()) { gx = gx - 390.0 * dt; }   // klavye VEYA dokunmatik joystick
    if (sag()) { gx = gx + 390.0 * dt; }
    if (gx < 0.0) { gx = 0.0; }
    if (gx > 608.0) { gx = 608.0; }
    konumla(uz_gemi, gx, uz_GEMI_Y);

    if (ates_basildi()) {
        mermi(gx + 13.0, uz_GEMI_Y - 6.0, 6, 14, GOLD, 0, 0 - 470);
    }

    // --- Filo: kenara değen varsa yön değiştir + bir kademe in ---------------
    bool kenarda = false;
    for (int i = 0; i < len(uz_filo); i = i + 1) {
        int e = uz_filo[i];
        if (!yasiyor(e)) { continue; }
        float ex = x_of(e);
        if (ex < 8.0   && uz_fdir < 0) { kenarda = true; }
        if (ex > 600.0 && uz_fdir > 0) { kenarda = true; }
    }
    if (kenarda) { uz_fdir = 0 - uz_fdir; }

    for (int i = 0; i < len(uz_filo); i = i + 1) {
        int e = uz_filo[i];
        if (!yasiyor(e)) { continue; }
        float ny = y_of(e);
        if (kenarda) { ny = ny + 22.0; }
        konumla(e, x_of(e) + uz_fdir * uz_fspeed * dt, ny);
        if (ny > 396.0) { oyun_bitti(); }   // filo gemi hizasına indi
    }

    // --- Filo geri ateşi (bölüm 3) ------------------------------------------
    if (uz_f_atis == 1 && mod(uz_t, uz_f_period) == 0) {
        array canli = [];
        for (int i = 0; i < len(uz_filo); i = i + 1) {
            if (yasiyor(uz_filo[i])) { push(canli, uz_filo[i]); }
        }
        if (len(canli) > 0) {
            int e = canli[randint(0, len(canli) - 1)];
            int m = uret(x_of(e) + 13.0, y_of(e) + 24.0, 6, 14, MAGENTA, uz_TAG_EBULLET, MV_VELOCITY);
            hiz_ver(m, 0, 280);
        }
    }
}

// Mermi düşmana değince: ikisi de ölür, +10. Filo bittiyse sıradaki bölüm.
func uz_vur_cb() {
    // Konumu ÖLDÜRMEDEN önce oku (bayat handle 0 döner) — düşman merkezinde patlama.
    patlama(x_of(oteki()) + 16.0, y_of(oteki()) + 12.0, ORANGE);
    oldur(oteki());                          // ben()=mermi (TAG_BULLET), oteki()=düşman
    oldur(ben());
    skor_ekle(10);
    if (tag_sayisi(TAG_ENEMY) == 0) { bolum_gec(); }
}

func uz_kaybet_cb() { oyun_bitti(); }

music_theme(1);   // gergin tema (uzay)

func uz_setup() {
    bilgi("Sol/Sag veya A/D: gemi   SPACE: ates   |   Filoyu temizle (+10)");
    baslangicta(uz_kur);
    bolum(1, uz_b1);
    bolum(2, uz_b2);
    bolum(3, uz_b3);
    bolum(4, uz_b4);
    bolum(5, uz_b5);
    bolum(6, uz_b6);
    her_kare(uz_her_kare_is);
    carpisinca(TAG_BULLET, TAG_ENEMY,   uz_vur_cb);
    carpisinca(TAG_PLAYER, TAG_ENEMY,   uz_kaybet_cb);
    carpisinca(TAG_PLAYER, uz_TAG_EBULLET, uz_kaybet_cb);
}

// ==========================================================================
//  Labirent  (examples/arcade_labirent.tpr, önek la_)
// ==========================================================================
// Labirent (Kacis) — arcade preset motoru, 6 BÖLÜM.
//
//   ./tulpar examples/arcade_labirent.tpr
//
// Ok tuşları / WASD ile labirentte dolaş, tüm altın anahtarları topla (+10) →
// sıradaki bölüm. 6 bölümü de bitir → KAZANDIN. Koridorlarda devriye gezen
// kırmızılara değersen oyun biter, R ile baştan.
//
// Bölümler: 1) geniş labirent / 1 devriye   2) simetrik / 2 devriye
//           3) sık labirent / 3 hızlı devriye   4-6) dar mükemmel-maze,
//           artan devriye (2/3/4) ve hız — üreteçle kurulup ulaşılabilirlik
//           flood-fill ile doğrulandı.
//
// Harita ASCII olarak yazılır ve `ord()` ile okunur — 20x15 hücre × 32px = 640x480.
//   '#' duvar   '.' boşluk   'P' oyuncu   'A' anahtar   'E' devriye
// Bu sayede bölüm eklemek = bir dizi string yazmak.
//
// Oyuncu MV_TOPDOWN olduğu için duvarlardan motorun MTV çözümü geçirmez.
// Devriyeler MV_VELOCITY (duvar takmaz) → koridor sınırlarını kurulumda
// haritayı tarayarak hesaplayıp her_kare içinde geri döndürüyoruz.


// Izgara 20x15. Hücre 28px → 560x420; ekranın (640x480) üst 60px'i HUD'a
// (skor y=10, bilgi şeridi y=38) bırakılır, labirent x'te ortalanır.
// 32px hücreyle labirent tüm ekranı kaplıyor ve oyuncu HUD yazısının altında
// kalıyordu — o yüzden hücre küçültülüp aşağı kaydırıldı.
int la_HUC = 28;    // hücre boyutu (px)
int la_ENT = 20;    // oyuncu/devriye boyutu — koridorda paylı sığsın
int la_OFS = 4;     // hücre içi ortalama payı
int la_OX  = 40;    // labirentin sol kenarı ((640 - 20*28) / 2)
int la_OY  = 60;    // labirentin üst kenarı (HUD'un altı)

array la_M1 = [
    "####################",
    "#P.......#........A#",
    "#.#####..#..#####..#",
    "#.....#..#......#..#",
    "#####.#..####...#..#",
    "#........#..#...#..#",
    "#.####...#..#...#..#",
    "#.#..E...#..#......#",
    "#.#..#####..######.#",
    "#.#.............#..#",
    "#.#####.#######.#..#",
    "#.......#.....#....#",
    "#.#######.....#.####",
    "#A............#...A#",
    "####################"
];

array la_M2 = [
    "####################",
    "#P...#........#....#",
    "#.##.#.######.#.##.#",
    "#.#..#.#....#.#..#.#",
    "#.#.##.#.##.#.##.#.#",
    "#.#....#.#..#....#.#",
    "#.######.#..######.#",
    "#A..E....#.......A.#",
    "#.######.#..######.#",
    "#.#....#.#..#....#.#",
    "#.#.##.#.####.##.#.#",
    "#.#..#.#....E.#..#.#",
    "#.##.#.######.#.##.#",
    "#A...#........#...A#",
    "####################"
];

array la_M3 = [
    "####################",
    "#P..#....E....#...A#",
    "##..#.####.##.#.##.#",
    "#...#.#..#..#.#..#.#",
    "#.###.#.##..#.##.#.#",
    "#.#...#..#..#....#.#",
    "#.#.###..#..####.#.#",
    "#E..#....#.......#.#",
    "#.###.####.#####.#.#",
    "#.#...#....#...#.#.#",
    "#.#.###.####.#.#.#.#",
    "#.#.....#....#...#.#",
    "#.#######.####.###.#",
    "#A......E.....#....#",
    "####################"
];

// M4/M5/M6: garantili-bağlı maze üreteciyle (recursive backtracker) üretildi;
// flood-fill ile tüm anahtarların ulaşılabilir, devriyelerin yatay koridorda
// olduğu doğrulandı (scratchpad/maze_gen.py). Col 19 çift duvar — zararsız.
array la_M4 = [
    "####################",
    "#P#...#.....E.#...##",
    "#.#.#.#.###.#.#.#.##",
    "#.#.#.#.#...#.#A#.##",
    "#.#.#.#.#A###.###.##",
    "#.#.#.#.#...#.#...##",
    "#.#.#.#.###.#.#.####",
    "#...#.#.#...#.#...##",
    "#####.#.#.###.###.##",
    "#.E.#.#A#.#A#.....##",
    "#.#.#.###.#.#####.##",
    "#.#...#...#.#...#.##",
    "#.#####.###.#.#.#.##",
    "#.......#A....#...##",
    "####################"
];

array la_M5 = [
    "####################",
    "#P....#...E.......##",
    "#####.#.#########.##",
    "#.....#.#...#...#.##",
    "#.#####.#.#.#.#.#.##",
    "#.#E....#.#.A.#...##",
    "#.#.#####.#######.##",
    "#.#AE..A#...#A#...##",
    "#.#######.#.#.#.####",
    "#.#.....#.#.#.#.#A##",
    "#.#.###.#.#.#.#.#.##",
    "#.#.#...#A#.#.#...##",
    "#.#.#.#####.#.###.##",
    "#...#.......#.....##",
    "####################"
];

array la_M6 = [
    "####################",
    "#P..#A........#...##",
    "###.#####.###.#.#.##",
    "#.#.....#...#...#.##",
    "#.#####.###.#####.##",
    "#.#...#....E#..A#.##",
    "#.#.#.#######.###.##",
    "#...#......A#.....##",
    "#.#######.###.######",
    "#..E..#A#.....#...##",
    "#####.#.#########.##",
    "#A#...#..........E##",
    "#.#.#########.###.##",
    "#........E....#A..##",
    "####################"
];

array la_harita = [];       // güncel bölümün haritası
int la_oyuncu_id = 0;

array la_devriye = [];      // devriye handle'ları
array la_d_min = [];        // devriyenin koridor sol sınırı (px)
array la_d_max = [];        // devriyenin koridor sağ sınırı (px)

// Hücre duvar mı? (harita dışı = duvar)
func la_hucre_duvar(cx, cy): bool {
    if (cx < 0 || cx > 19 || cy < 0 || cy > 14) { return true; }
    return ord(la_harita[cy], cx) == 35;         // '#'
}

// (c,r) hücresindeki devriyenin yatay koridor sınırları — duvara dayanana dek tara.
func la_sol_sinir(c, r): int {
    for (int i = c; i >= 0; i = i - 1) {
        if (la_hucre_duvar(i, r)) { return (i + 1) * la_HUC + la_OX + la_OFS; }
    }
    return la_OX + la_OFS;
}
func la_sag_sinir(c, r): int {
    for (int i = c; i < 20; i = i + 1) {
        if (la_hucre_duvar(i, r)) { return (i - 1) * la_HUC + la_OX + la_OFS; }
    }
    return 19 * la_HUC + la_OX + la_OFS;
}

// Haritayı entity'lere çevir. (Sarma fonksiyon — callback değil, argüman alabilir.)
func la_harita_kur(m, dhiz) {
    la_harita = m;                               // sol/sag_sinir bunu okur → önce ata
    for (int r = 0; r < 15; r = r + 1) {
        for (int c = 0; c < 20; c = c + 1) {
            int ch = ord(la_harita[r], c);
            if (ch == 35) {                   // '#' duvar
                duvar(c * la_HUC + la_OX, r * la_HUC + la_OY, la_HUC, la_HUC, DARKBLUE);
            }
            if (ch == 65) {                   // 'A' anahtar
                esya(c * la_HUC + la_OX + 6, r * la_HUC + la_OY + 6, 16, 16, GOLD);
            }
            if (ch == 80) {                   // 'P' oyuncu
                la_oyuncu_id = oyuncu(c * la_HUC + la_OX + la_OFS, r * la_HUC + la_OY + la_OFS, la_ENT, la_ENT, SKYBLUE);
                hiz_ayarla(la_oyuncu_id, 210);
            }
            if (ch == 69) {                   // 'E' devriye
                int e = uret(c * la_HUC + la_OX + la_OFS, r * la_HUC + la_OY + la_OFS, la_ENT, la_ENT, RED, TAG_ENEMY, MV_VELOCITY);
                hiz_ver(e, dhiz, 0);
                push(la_devriye, e);
                push(la_d_min, la_sol_sinir(c, r));
                push(la_d_max, la_sag_sinir(c, r));
            }
        }
    }
}

// Global kurulum — her bölüm yüklemesinde bölüm fn'inden ÖNCE çalışır.
// (Oyuncu/duvar/anahtarların hepsini harita kurar, burada sadece sıfırlıyoruz.)
func la_kur() {
    temizle();
    la_devriye = [];
    la_d_min = [];
    la_d_max = [];
}

func la_b1() { la_harita_kur(la_M1, 110); }
func la_b2() { la_harita_kur(la_M2, 150); }
func la_b3() { la_harita_kur(la_M3, 190); }
func la_b4() { la_harita_kur(la_M4, 210); }
func la_b5() { la_harita_kur(la_M5, 240); }
func la_b6() { la_harita_kur(la_M6, 270); }

// Devriyeleri koridor sınırında geri döndür (MV_VELOCITY duvar takmaz).
func la_her_kare_is() {
    for (int i = 0; i < len(la_devriye); i = i + 1) {
        int e = la_devriye[i];
        if (!yasiyor(e)) { continue; }
        float ex  = x_of(e);
        float evx = vx_of(e);
        float lo  = la_d_min[i] * 1.0;
        float hi  = la_d_max[i] * 1.0;
        if (ex < lo && evx < 0.0) { konumla(e, lo, y_of(e)); hiz_ver(e, 0.0 - evx, 0); }
        if (ex > hi && evx > 0.0) { konumla(e, hi, y_of(e)); hiz_ver(e, 0.0 - evx, 0); }
    }
}

// Anahtar toplandı; bölümün sonuncusuysa sıradaki bölüm.
func la_topla_cb() {
    patlama(x_of(oteki()) + 8.0, y_of(oteki()) + 8.0, GOLD);  // anahtar parçacığı
    oldur(oteki());
    skor_ekle(10);
    if (tag_sayisi(TAG_ITEM) == 0) { bolum_gec(); }
}

func la_kaybet_cb() {
    patlama(x_of(la_oyuncu_id) + 10.0, y_of(la_oyuncu_id) + 10.0, ORANGE);
    oyun_bitti();
}

func la_setup() {
    bilgi("Ok tuslari / WASD: hareket   |   Tum anahtarlari topla (+10), devriyelere degme");
    kontrol_semasi("dpad");   // koridor oyununa 4 ok butonu joystick'ten iyi oturur
    baslangicta(la_kur);
    bolum(1, la_b1);
    bolum(2, la_b2);
    bolum(3, la_b3);
    bolum(4, la_b4);
    bolum(5, la_b5);
    bolum(6, la_b6);
    her_kare(la_her_kare_is);
    carpisinca(TAG_PLAYER, TAG_ITEM,  la_topla_cb);
    carpisinca(TAG_PLAYER, TAG_ENEMY, la_kaybet_cb);
}

// ==========================================================================
//  Karsiya  (examples/arcade_karsiya.tpr, önek ka_)
// ==========================================================================
// Karsiya Gec (Frogger) — arcade preset motoru, 6 BÖLÜM.
//
//   ./tulpar examples/arcade_karsiya.tpr
//
// Ok tuşları / WASD ile hareket et; akan araçlara değmeden en üstteki altın
// şeride ulaş (+50) → sıradaki bölüm. 6 bölümü de bitir → KAZANDIN.
// Bir araca değersen oyun biter, R ile baştan.
//
// Bölümler: 1) 3 şerit yavaş   2) 4 şerit   3) 5 şerit hızlı
//           4-6) 5 şerit, artan yoğunluk/hız (boşluk ~50px, geçilebilir)
//
// Her şerit birkaç MV_VELOCITY entity'si; motor onları kendi hızlarıyla sürer,
// biz sadece ekrandan çıkanı diğer taraftan geri sokuyoruz (sarma). Motor
// dünyanın 64px dışına taşan velocity entity'lerini otomatik öldürdüğü için
// sarmayı o sınırdan ÖNCE (±660) yapmak zorundayız.


int ka_oyuncu_id = 0;
array ka_arabalar = [];     // bölümün araç handle'ları

int ka_BASLA_X = 308;
int ka_BASLA_Y = 440;

// Global kurulum — her bölüm yüklemesinde bölüm fn'inden ÖNCE çalışır.
func ka_kur() {
    temizle();
    ka_arabalar = [];
    ka_oyuncu_id = oyuncu(ka_BASLA_X, ka_BASLA_Y, 24, 24, LIME);
    hiz_ayarla(ka_oyuncu_id, 230);
    // Hedef şerit (tek geniş bant). y=58: HUD'un (skor y=10, bilgi y=38..54)
    // ALTINDA kalmalı — y=10'dayken skor yazısı bandın üstüne biniyordu.
    esya(8, 58, 624, 26, GOLD);
}

// Bir şerit araç diz: `adet` araç eşit aralıklı, hepsi `hiz` ile akar.
// (Sarma fonksiyon — callback değil, argüman alabilir.)
func ka_serit(y, hiz, adet, renk) {
    int aralik = toInt(640 / adet);
    for (int i = 0; i < adet; i = i + 1) {
        int c = uret(i * aralik, y, 56, 28, renk, TAG_ENEMY, MV_VELOCITY);
        hiz_ver(c, hiz, 0);
        push(ka_arabalar, c);
    }
}

// --- Bölüm 1: 3 şerit, yavaş ------------------------------------------------
func ka_b1() {
    ka_serit(340, 90,       3, RED);
    ka_serit(250, 0 - 110,  3, ORANGE);
    ka_serit(160, 130,      3, MAROON);
}

// --- Bölüm 2: 4 şerit -------------------------------------------------------
func ka_b2() {
    ka_serit(370, 130,      4, RED);
    ka_serit(290, 0 - 150,  3, ORANGE);
    ka_serit(210, 170,      4, MAROON);
    ka_serit(130, 0 - 140,  3, PINK);
}

// --- Bölüm 3: 5 şerit, hızlı ------------------------------------------------
func ka_b3() {
    ka_serit(390, 180,      4, RED);
    ka_serit(320, 0 - 200,  4, ORANGE);
    ka_serit(250, 220,      5, MAROON);
    ka_serit(180, 0 - 190,  4, PINK);
    ka_serit(110, 240,      5, VIOLET);
}

// --- Bölüm 4: 5 şerit, daha yoğun/hızlı -------------------------------------
func ka_b4() {
    ka_serit(390, 200,      5, RED);
    ka_serit(320, 0 - 220,  5, ORANGE);
    ka_serit(250, 240,      6, MAROON);
    ka_serit(180, 0 - 210,  5, PINK);
    ka_serit(110, 260,      6, VIOLET);
}

// --- Bölüm 5: 5 şerit, çok yoğun --------------------------------------------
func ka_b5() {
    ka_serit(390, 230,      5, RED);
    ka_serit(320, 0 - 250,  6, ORANGE);
    ka_serit(250, 270,      6, MAROON);
    ka_serit(180, 0 - 240,  5, PINK);
    ka_serit(110, 290,      6, VIOLET);
}

// --- Bölüm 6: 5 şerit, en hızlı + en yoğun (boşluk ~50px, geçilebilir) -------
func ka_b6() {
    ka_serit(390, 260,      6, RED);
    ka_serit(320, 0 - 280,  6, ORANGE);
    ka_serit(250, 300,      6, MAROON);
    ka_serit(180, 0 - 270,  6, PINK);
    ka_serit(110, 300,      6, VIOLET);
}

// Ekrandan çıkan aracı diğer taraftan geri sok (motor sarma yapmaz).
func ka_her_kare_is() {
    for (int i = 0; i < len(ka_arabalar); i = i + 1) {
        int c = ka_arabalar[i];
        if (!yasiyor(c)) { continue; }
        float cx = x_of(c);
        if (vx_of(c) > 0.0 && cx > 660.0)       { konumla(c, 0.0 - 60.0, y_of(c)); }
        if (vx_of(c) < 0.0 && cx < 0.0 - 60.0)  { konumla(c, 660.0, y_of(c)); }
    }
}

func ka_hedef_cb()  {                                 // altın şeride ulaştın
    patlama(x_of(ka_oyuncu_id) + 12.0, y_of(ka_oyuncu_id) + 12.0, GOLD);
    skor_ekle(50);
    bolum_gec();
}
func ka_kaybet_cb() {                                 // araca değdin
    patlama(x_of(ka_oyuncu_id) + 12.0, y_of(ka_oyuncu_id) + 12.0, ORANGE);
    oyun_bitti();
}

func ka_setup() {
    bilgi("Ok tuslari / WASD: hareket   |   Araclara degmeden altin serite ulas (+50)");
    kontrol_semasi("dpad");   // serit serit ilerlemeye 4 ok butonu iyi oturur
    baslangicta(ka_kur);
    bolum(1, ka_b1);
    bolum(2, ka_b2);
    bolum(3, ka_b3);
    bolum(4, ka_b4);
    bolum(5, ka_b5);
    bolum(6, ka_b6);
    her_kare(ka_her_kare_is);
    carpisinca(TAG_PLAYER, TAG_ITEM,  ka_hedef_cb);
    carpisinca(TAG_PLAYER, TAG_ENEMY, ka_kaybet_cb);
}

// ==========================================================================
//  Ucus  (examples/arcade_ucus.tpr, önek uc_)
// ==========================================================================
// Ucus (Flappy) — arcade preset motoru, 3 BÖLÜM.
//
//   ./tulpar examples/arcade_ucus.tpr
//
// SPACE / YUKARI ile kanat çırp; boruların arasından geç. Her geçiş +1.
// Bölümdeki hedef sayıda boru geçince sıradaki bölüm; 6 bölümü de bitir →
// KAZANDIN. Boruya, tavana ya da zemine çarparsan oyun biter, R ile baştan.
//
// Bölümler: 1) geniş boşluk/yavaş  2) dar/hızlı  3) en dar/en hızlı
//           4-6) giderek daralan boşluk + hızlanan/daha sık boru, hedef 11/13/15
//
// Kuş MV_NONE: yerçekimi + kanat çırpma her_kare içinde ELLE sürülür (motorun
// MV_PLATFORM zıplaması sadece zemindeyken çalışır; flappy havada çırpar).
// Borular TAG_ENEMY + MV_VELOCITY: katı `duvar()` DEĞİL — duvar olsalardı motor
// kuşu MTV ile iterdi; biz çarpınca ölmesini istiyoruz. Motor ekrandan 64px
// çıkan velocity entity'lerini otomatik öldürür → boru temizliği bedava.


int uc_kus = 0;
float uc_kus_vy = 0.0;       // kuşun dikey hızı (px/sn, + aşağı)
int uc_basladi = 0;          // 0 = ilk çırpışı bekliyor (kuş asılı, fizik/boru yok)

// Fizik (deneyle ayarlandı — flappy hissi): duruştan zemine ~0.9sn (rahat
// tepki payı), bir çırpma ~0.7sn'lik yay çizer → ~1.4 çırpma/sn temposu.
// GRAV çok yüksekse kuş ilk boru gelmeden yere çakılır (ilk sürüm 1500 buydu).
float uc_GRAV = 1050.0;      // yerçekimi (px/sn^2)
float uc_CIRP = 400.0;       // kanat çırpma anlık yukarı hızı (px/sn)
int uc_KUS_X = 120;
int uc_ZEMIN = 452;          // zemin şeridinin y'si (kuş bunu geçerse ölür)

// Boru takibi (paralel diziler — motor içi değil, kendi durumumuz).
array uc_boru_ust = [];      // üst boru handle'ı
array uc_boru_x   = [];      // çift'in x'i (skor için)
array uc_boru_gecti = [];    // 1 = bu çift skorlandı
int uc_t = 0;                // kare sayacı (periyodik boru üretimi)

// Bölüm ayarları
int uc_bosluk = 150;         // boru boşluğu (px)
int uc_boru_hiz = 150;       // boruların sola akış hızı (px/sn)
int uc_spawn_period = 95;    // kaç karede bir boru çifti
int uc_hedef = 5;            // bu bölümü bitiren boru sayısı
int uc_gecen = 0;            // bu bölümde geçilen boru

// Global kurulum — her bölüm yüklemesinde bölüm fn'inden ÖNCE çalışır.
func uc_kur() {
    temizle();
    uc_boru_ust = [];
    uc_boru_x = [];
    uc_boru_gecti = [];
    uc_t = 0;
    uc_gecen = 0;
    uc_kus_vy = 0.0;
    uc_basladi = 0;
    uc_kus = uret(uc_KUS_X, 220, 26, 20, GOLD, TAG_PLAYER, MV_NONE);
    duvar(0, uc_ZEMIN, 640, 28, DARKGRAY);          // zemin (sadece görsel; ölüm elle)
}

// --- Bölümler ---------------------------------------------------------------
func uc_b1() { uc_bosluk = 160; uc_boru_hiz = 150; uc_spawn_period = 100; uc_hedef = 5;  }
func uc_b2() { uc_bosluk = 135; uc_boru_hiz = 195; uc_spawn_period = 82;  uc_hedef = 7;  }
func uc_b3() { uc_bosluk = 115; uc_boru_hiz = 240; uc_spawn_period = 68;  uc_hedef = 9;  }
func uc_b4() { uc_bosluk = 108; uc_boru_hiz = 270; uc_spawn_period = 62;  uc_hedef = 11; }
func uc_b5() { uc_bosluk = 100; uc_boru_hiz = 300; uc_spawn_period = 56;  uc_hedef = 13; }
func uc_b6() { uc_bosluk = 92;  uc_boru_hiz = 330; uc_spawn_period = 50;  uc_hedef = 15; }

// Bir boru çifti üret: üstte ve altta iki yeşil sütun, aralarında boşluk.
func uc_boru_uret() {
    int gy = randint(90, uc_ZEMIN - uc_bosluk - 40);   // boşluğun üst kenarı
    int usth = gy;                                // üst borunun yüksekliği
    int altY = gy + uc_bosluk;
    int alth = uc_ZEMIN - altY;
    int u = uret(660, 0, 52, usth, LIME, TAG_ENEMY, MV_VELOCITY);
    hiz_ver(u, 0 - uc_boru_hiz, 0);
    int a = uret(660, altY, 52, alth, LIME, TAG_ENEMY, MV_VELOCITY);
    hiz_ver(a, 0 - uc_boru_hiz, 0);
    push(uc_boru_ust, u);
    push(uc_boru_x, 660);
    push(uc_boru_gecti, 0);
}

func uc_her_kare_is() {
    float dt = frame_time();
    if (dt <= 0.0) { dt = 0.0166667; }
    if (dt > 0.05) { dt = 0.05; }
    // Çırpma: SPACE/UP/W klavye VEYA ekranın HERHANGİ bir yerine dokunma
    // (dokunuldu()). Buton/joystick çizilmez — ekran tamamı kontroldür.
    bool cirp = dokunuldu() || key_pressed("SPACE") || key_pressed("UP") || key_pressed("W");

    // Hazır durumu: ilk çırpışa kadar kuş asılı durur, fizik/boru başlamaz
    // (gerçek Flappy gibi — oyuncuya tepki payı). İlk çırpış oyunu başlatır.
    if (uc_basladi == 0) {
        if (cirp) { uc_basladi = 1; uc_kus_vy = 0.0 - uc_CIRP; }
        return;
    }

    // --- Kuş: yerçekimi + çırpma --------------------------------------------
    if (cirp) { uc_kus_vy = 0.0 - uc_CIRP; }
    uc_kus_vy = uc_kus_vy + uc_GRAV * dt;
    float ny = y_of(uc_kus) + uc_kus_vy * dt;
    if (ny < 0.0) { ny = 0.0; uc_kus_vy = 0.0; }
    konumla(uc_kus, uc_KUS_X, ny);
    if (ny + 20.0 >= uc_ZEMIN * 1.0) { oyun_bitti(); }   // zemine çarptı

    // --- Boru üretimi + skor (sadece oyun başladıysa) -----------------------
    uc_t = uc_t + 1;
    if (mod(uc_t, uc_spawn_period) == 0) { uc_boru_uret(); }

    for (int i = 0; i < len(uc_boru_ust); i = i + 1) {
        int u = uc_boru_ust[i];
        if (!yasiyor(u)) { continue; }
        // Boru kuşu geçti mi? (bir kez skorla)
        if (uc_boru_gecti[i] == 0 && x_of(u) + 52.0 < uc_KUS_X * 1.0) {
            uc_boru_gecti[i] = 1;
            patlama(uc_KUS_X + 13.0, y_of(uc_kus) + 10.0, GOLD);   // boru-geçiş parçacığı
            skor_ekle(1);
            uc_gecen = uc_gecen + 1;
            if (uc_gecen >= uc_hedef) { bolum_gec(); }
        }
    }
}

// Hazır durumunda "başla" ipucu (otomatik çizimin üstüne).
func uc_ciz_ek() {
    if (uc_basladi == 0) {
        str h = "Baslamak icin dokun ya da SPACE / YUKARI";
        text(h, (screen_width() - measure_text(h, 22)) / 2, 200, 22, WHITE);
    }
}

// Kuş boruya değince oyun biter.
func uc_kaybet_cb() { oyun_bitti(); }

func uc_setup() {
    bilgi("Dokun / SPACE / YUKARI: kanat cirp   |   Borularin arasindan gec (+1)");
    baslangicta(uc_kur);
    bolum(1, uc_b1);
    bolum(2, uc_b2);
    bolum(3, uc_b3);
    bolum(4, uc_b4);
    bolum(5, uc_b5);
    bolum(6, uc_b6);
    her_kare(uc_her_kare_is);
    ciz_ustune(uc_ciz_ek);
    carpisinca(TAG_PLAYER, TAG_ENEMY, uc_kaybet_cb);
}

// ==========================================================================
//  Goktasi  (examples/arcade_goktasi.tpr, önek go_)
// ==========================================================================
// Goktasi (dodge) — arcade preset motoru, 3 BÖLÜM.
//
//   ./tulpar examples/arcade_goktasi.tpr
//
// Sol/Sağ (A/D) ile kaç; yukarıdan düşen göktaşlarından sakın. Her bölümde
// belirtilen süre hayatta kal → sıradaki bölüm. 6 bölümü de bitir → KAZANDIN.
// Bir göktaşına değersen oyun biter, R ile baştan. Kaçtığın her taş +1.
//
// Bölümler: 1) 12 sn / seyrek-yavaş   2) 15 sn / sık-hızlı   3) 18 sn / yoğun
//           4-6) 21/24/28 sn, giderek daha sık ve hızlı taş
//
// Göktaşları TAG_ENEMY + MV_VELOCITY (aşağı düşer); motor ekrandan 64px çıkanı
// otomatik öldürür. "Kaçıldı" sayımı için taş handle'larını kendi dizimizde
// tutup ekranın altını geçince skorluyoruz (ölmeden önce yaşamıyor olurlar).


int go_oyuncu_id = 0;
array go_taslar = [];        // düşen göktaşı handle'ları (kaçış sayımı için)
float go_sure = 0.0;         // bu bölümde geçen süre (sn)
int go_t = 0;                // kare sayacı

// Bölüm ayarları
float go_HEDEF_SURE = 12.0;  // hayatta kalınacak süre (sn)
int go_spawn_period = 26;    // kaç karede bir taş
int go_tas_hiz = 210;        // düşme hızı (px/sn)
int go_tas_min = 22;         // taş boyut alt/üst sınırı
int go_tas_max = 40;

// Global kurulum — her bölüm yüklemesinde bölüm fn'inden ÖNCE çalışır.
func go_kur() {
    temizle();
    go_taslar = [];
    go_sure = 0.0;
    go_t = 0;
    go_oyuncu_id = oyuncu(300, 430, 30, 24, SKYBLUE);
    hiz_ayarla(go_oyuncu_id, 300);          // topdown taban hız (yatay kullanacağız)
}

// --- Bölümler ---------------------------------------------------------------
func go_b1() { go_HEDEF_SURE = 12.0; go_spawn_period = 28; go_tas_hiz = 200; }
func go_b2() { go_HEDEF_SURE = 15.0; go_spawn_period = 20; go_tas_hiz = 260; }
func go_b3() { go_HEDEF_SURE = 18.0; go_spawn_period = 14; go_tas_hiz = 320; }
func go_b4() { go_HEDEF_SURE = 21.0; go_spawn_period = 12; go_tas_hiz = 360; }
func go_b5() { go_HEDEF_SURE = 24.0; go_spawn_period = 11; go_tas_hiz = 400; }
func go_b6() { go_HEDEF_SURE = 28.0; go_spawn_period = 10; go_tas_hiz = 440; }

func go_her_kare_is() {
    float dt = frame_time();
    if (dt <= 0.0) { dt = 0.0166667; }
    if (dt > 0.05) { dt = 0.05; }
    go_t = go_t + 1;
    go_sure = go_sure + dt;

    // --- Oyuncu: sadece yatay (motor topdown 4 yöne giderdi) -----------------
    float px = x_of(go_oyuncu_id);
    if (sol()) { px = px - 300.0 * dt; }   // klavye VEYA dokunmatik joystick
    if (sag()) { px = px + 300.0 * dt; }
    if (px < 0.0) { px = 0.0; }
    if (px > 610.0) { px = 610.0; }
    konumla(go_oyuncu_id, px, 430);

    // --- Göktaşı üretimi -----------------------------------------------------
    if (mod(go_t, go_spawn_period) == 0) {
        int boyut = randint(go_tas_min, go_tas_max);
        int tx = randint(0, 640 - boyut);
        int e = uret(tx, 0 - boyut, boyut, boyut, MAROON, TAG_ENEMY, MV_VELOCITY);
        hiz_ver(e, 0, go_tas_hiz);
        push(go_taslar, e);
    }

    // --- Kaçış sayımı: altı geçen (artık ölü) taş +1 ------------------------
    for (int i = 0; i < len(go_taslar); i = i + 1) {
        int e = go_taslar[i];
        if (e < 0) { continue; }             // zaten sayıldı (işaretlendi)
        if (!yasiyor(e)) {                   // motor ekran dışında öldürdü → kaçıldı
            skor_ekle(1);
            go_taslar[i] = 0 - 1;               // bir daha sayma
        }
    }

    // --- Süre doldu → sıradaki bölüm ----------------------------------------
    if (go_sure >= go_HEDEF_SURE) { bolum_gec(); }
}

// Kalan süreyi ekrana yaz (HUD'un altına, otomatik skorun yanına ek).
func go_ciz_ek() {
    int kalan = toInt(go_HEDEF_SURE - go_sure) + 1;
    if (kalan < 0) { kalan = 0; }
    text("Kalan: " + toString(kalan) + " sn", 240, 12, 20, SKYBLUE);
}

func go_kaybet_cb() {
    patlama(x_of(go_oyuncu_id) + 15.0, y_of(go_oyuncu_id) + 12.0, ORANGE);  // çarpışma parçacığı
    oyun_bitti();
}

music_theme(1);   // gergin tema (goktasi)

func go_setup() {
    bilgi("Sol/Sag veya A/D: kac   |   Goktaslarindan sakin, sureyi doldur");
    kontrol_semasi("yatay");   // mobilde sag/sol ok butonlari
    baslangicta(go_kur);
    bolum(1, go_b1);
    bolum(2, go_b2);
    bolum(3, go_b3);
    bolum(4, go_b4);
    bolum(5, go_b5);
    bolum(6, go_b6);
    her_kare(go_her_kare_is);
    ciz_ustune(go_ciz_ek);
    carpisinca(TAG_PLAYER, TAG_ENEMY, go_kaybet_cb);
}

// ==========================================================================
//  Yilan  (examples/arcade_yilan.tpr, önek yi_)
// ==========================================================================
// Yilan — arcade motoruyla izgara yilani, 6 BOLUM (tame_snake'in arcade esi).
//
//   ./tulpar examples/arcade_yilan.tpr
//
// Kontroller: ok tuslari/WASD, mobilde dpad butonlari VEYA parmak kaydirma
// (kaydirildi() jesti — yilana en dogal his). Yem (kirmizi) ye -> buyu.
// Duvara, engele ya da kendine carpma. Her bolumde 5 yem -> sonraki bolum;
// 1) yavas  2) hizli  3) en hizli + iki dikey duvar   4) yatay bariyerler
// 5) uc dikey duvar (daha hizli)   6) dort duvarli maze (satir 7 koridoru acik).
// Skor bolumler arasi korunur (motorun bolum semantigi).
//
// Motor kullanimi: entity YOK — yilan durumu izgara dizilerinde, cizim
// ciz_ustune() ile elle. bolum()/skor/oyun-bitti/afis/HUD motordan bedava.
// Not: test kosucusunda COMPILE_ONLY (pencere dongusu CI'da bloklar).


// ---- Izgara ----------------------------------------------------------------
int yi_COLS = 20;
int yi_ROWS = 14;
int yi_CELL = 28;
int yi_OX = 40;          // oyun alani sol bosluk
int yi_OY = 64;          // HUD (skor+bilgi) altinda kalsin

// ---- Yilan durumu -----------------------------------------------------------
array yi_ysx = [];       // govde hucreleri (bas = son eleman)
array yi_ysy = [];
int yi_syuz = 0;         // govde uzunlugu
int yi_ydx = 1;          // aktif yon (hucre/adim)
int yi_ydy = 0;
int yi_nydx = 1;         // bekleyen yon (adimda uygulanir; 180 donus engellenir)
int yi_nydy = 0;
int yi_adim_kare = 8;    // her N karede bir adim — bolumle hizlanir
int yi_tik = 0;
int yi_yem_x = 0;
int yi_yem_y = 0;
int yi_yem_sayisi = 0;   // bu bolumde yenen yem (5 = bolum gec)
array yi_egx = [];       // engel hucreleri (yalniz 3. bolum)
array yi_egy = [];

func yi_engel_mi(cx, cy): bool {
    for (int i = 0; i < length(yi_egx); i = i + 1) {
        if (toInt(yi_egx[i]) == cx && toInt(yi_egy[i]) == cy) { return true; }
    }
    return false;
}

func yi_yilan_mi(cx, cy): bool {
    for (int i = 0; i < yi_syuz; i = i + 1) {
        if (toInt(yi_ysx[i]) == cx && toInt(yi_ysy[i]) == cy) { return true; }
    }
    return false;
}

func yi_yem_koy() {
    // Bos hucre bulana kadar dene (izgara kucuk, hizli biter).
    int deneme = 0;
    while (deneme < 500) {
        int cx = randint(0, yi_COLS - 1);
        int cy = randint(0, yi_ROWS - 1);
        if (!yi_yilan_mi(cx, cy) && !yi_engel_mi(cx, cy)) {
            yi_yem_x = cx; yi_yem_y = cy;
            return;
        }
        deneme = deneme + 1;
    }
}

// Yilani baslangic durumuna kur: 3 hucre, satir 7'de saga bakar.
func yi_yilan_kur() {
    yi_ysx = []; yi_ysy = []; yi_syuz = 0;
    push(yi_ysx, 3); push(yi_ysy, 7);
    push(yi_ysx, 4); push(yi_ysy, 7);
    push(yi_ysx, 5); push(yi_ysy, 7);
    yi_syuz = 3;
    yi_ydx = 1; yi_ydy = 0; yi_nydx = 1; yi_nydy = 0;
    yi_tik = 0; yi_yem_sayisi = 0;
    yi_yem_koy();
}

// 3. bolumun engelleri: iki dikey duvar (sutun 6 ve 13), yilanin baslangic
// satiri 7 acik birakilir ki dogus guvenli olsun.
func yi_engel_kur() {
    yi_egx = []; yi_egy = [];
    for (int r = 2; r < yi_ROWS - 2; r = r + 1) {
        if (r != 7) {
            push(yi_egx, 6);  push(yi_egy, r);
            push(yi_egx, 13); push(yi_egy, r);
        }
    }
}

// 4. bolum: iki yatay bariyer (satir 4 ve 10), ortada 2 hucrelik gecis; dogus
// satiri 7 tamamen acik.
func yi_engel_kur_b4() {
    yi_egx = []; yi_egy = [];
    for (int c = 3; c < 17; c = c + 1) {
        if (c != 9 && c != 10) {
            push(yi_egx, c); push(yi_egy, 4);
            push(yi_egx, c); push(yi_egy, 10);
        }
    }
}

// 5. bolum: uc dikey duvar (sutun 5/10/15), yalniz orta serit (6/7/8) acik.
func yi_engel_kur_b5() {
    yi_egx = []; yi_egy = [];
    for (int r = 1; r < yi_ROWS - 1; r = r + 1) {
        if (r != 6 && r != 7 && r != 8) {
            push(yi_egx, 5);  push(yi_egy, r);
            push(yi_egx, 10); push(yi_egy, r);
            push(yi_egx, 15); push(yi_egy, r);
        }
    }
}

// 6. bolum: dort dikey duvar (4/8/12/16), sasirtmali dikey gecisler; satir 7
// bir uctan bir uca acik koridor kalir (dogus + tas geçişi garanti).
func yi_engel_kur_b6() {
    yi_egx = []; yi_egy = [];
    for (int r = 1; r < yi_ROWS - 1; r = r + 1) {
        if (r != 7) {
            if (r != 3)  { push(yi_egx, 4);  push(yi_egy, r); }
            if (r != 10) { push(yi_egx, 8);  push(yi_egy, r); }
            if (r != 4)  { push(yi_egx, 12); push(yi_egy, r); }
            if (r != 9)  { push(yi_egx, 16); push(yi_egy, r); }
        }
    }
}

// ---- Bolumler ---------------------------------------------------------------
func yi_b1() { yi_adim_kare = 8; yi_egx = []; yi_egy = []; yi_yilan_kur(); }
func yi_b2() { yi_adim_kare = 6; yi_egx = []; yi_egy = []; yi_yilan_kur(); }
func yi_b3() { yi_adim_kare = 4; yi_engel_kur();    yi_yilan_kur(); }
func yi_b4() { yi_adim_kare = 4; yi_engel_kur_b4(); yi_yilan_kur(); }
func yi_b5() { yi_adim_kare = 3; yi_engel_kur_b5(); yi_yilan_kur(); }
func yi_b6() { yi_adim_kare = 3; yi_engel_kur_b6(); yi_yilan_kur(); }

// ---- Kare guncelleme --------------------------------------------------------
func yi_kare() {
    // Yon girisi: klavye/dpad butonlari (basili) VEYA kaydirma jesti (kalkis
    // kenari). 180 derece geri donus yasak.
    if ((sol() || kaydirildi("sol")) && yi_ydx != 1)             { yi_nydx = 0 - 1; yi_nydy = 0; }
    else if ((sag() || kaydirildi("sag")) && yi_ydx != 0 - 1)    { yi_nydx = 1; yi_nydy = 0; }
    else if ((yukari() || kaydirildi("yukari")) && yi_ydy != 1)  { yi_nydx = 0; yi_nydy = 0 - 1; }
    else if ((asagi() || kaydirildi("asagi")) && yi_ydy != 0 - 1){ yi_nydx = 0; yi_nydy = 1; }

    yi_tik = yi_tik + 1;
    if (yi_tik < yi_adim_kare) { return; }
    yi_tik = 0;

    yi_ydx = yi_nydx; yi_ydy = yi_nydy;
    int bx = toInt(yi_ysx[yi_syuz - 1]) + yi_ydx;
    int by = toInt(yi_ysy[yi_syuz - 1]) + yi_ydy;

    // Carpma: dis duvar / engel / kendi govdesi -> oyun bitti (titreşimli).
    if (bx < 0 || bx >= yi_COLS || by < 0 || by >= yi_ROWS
        || yi_engel_mi(bx, by) || yi_yilan_mi(bx, by)) {
        oyun_bitti();          // ölüm titreşimi + sesi motorda merkezî (game_over)
        return;
    }

    bool buyu = (bx == yi_yem_x && by == yi_yem_y);
    if (buyu) {
        push(yi_ysx, bx); push(yi_ysy, by);
        yi_syuz = yi_syuz + 1;
        skor_ekle(10);
        titret(60);
        patlama(yi_OX + bx * yi_CELL + 14, yi_OY + by * yi_CELL + 14, GOLD);  // yem parçacığı
        yi_yem_sayisi = yi_yem_sayisi + 1;
        if (yi_yem_sayisi >= 5) { bolum_gec(); return; }
        yi_yem_koy();
    } else {
        // Kuyrugu at: govdeyi sola kaydir, basi sona yaz (uzunluk sabit).
        for (int i = 0; i < yi_syuz - 1; i = i + 1) {
            yi_ysx[i] = yi_ysx[i + 1];
            yi_ysy[i] = yi_ysy[i + 1];
        }
        yi_ysx[yi_syuz - 1] = bx;
        yi_ysy[yi_syuz - 1] = by;
    }
}

// ---- Cizim ------------------------------------------------------------------
func yi_ciz() {
    // Oyun alani cercevesi
    rect_lines(yi_OX - 2, yi_OY - 2, yi_COLS * yi_CELL + 4, yi_ROWS * yi_CELL + 4, GRAY);
    // Engeller
    for (int i = 0; i < length(yi_egx); i = i + 1) {
        rect(yi_OX + toInt(yi_egx[i]) * yi_CELL, yi_OY + toInt(yi_egy[i]) * yi_CELL,
             yi_CELL, yi_CELL, rgb(120, 90, 200));
    }
    // Yem
    rect(yi_OX + yi_yem_x * yi_CELL + 3, yi_OY + yi_yem_y * yi_CELL + 3, yi_CELL - 6, yi_CELL - 6, RED);
    // Yilan (bas altin, govde yesil)
    for (int i = 0; i < yi_syuz; i = i + 1) {
        rect(yi_OX + toInt(yi_ysx[i]) * yi_CELL + 1, yi_OY + toInt(yi_ysy[i]) * yi_CELL + 1,
             yi_CELL - 2, yi_CELL - 2, i == yi_syuz - 1 ? GOLD : LIME);
    }
    // Bolum yem sayaci (skorun yaninda kalabalik etmesin diye alt kenarda)
    text("Yem: " + toString(yi_yem_sayisi) + "/5", yi_OX, yi_OY + yi_ROWS * yi_CELL + 6, 18, SKYBLUE);
}

// ---- Kayit ------------------------------------------------------------------

func yi_setup() {
    bilgi("Kaydir / dpad / ok tuslari: yon   |   5 yem = sonraki bolum");
    kontrol_semasi("dpad");   // mobilde 4 ok butonu; kaydirma jesti de calisir
    bolum(1, yi_b1);
    bolum(2, yi_b2);
    bolum(3, yi_b3);
    bolum(4, yi_b4);
    bolum(5, yi_b5);
    bolum(6, yi_b6);
    her_kare(yi_kare);
    ciz_ustune(yi_ciz);
}

// ==========================================================================
//  2048  (examples/arcade_2048.tpr, önek tf_)
// ==========================================================================
// 2048 — arcade motoru (ızgara + kaydırma). Sonsuz oynanır, skor birleşen
// sayıların toplamı; hamle kalmayınca oyun biter.
//
//   ./tulpar examples/arcade_2048.tpr
//
// Kaydır (mobil) ya da ok tuşları / WASD ile tüm taşları bir yöne it. Yan yana
// gelen aynı sayılar toplanır (2+2=4 ...). Her hamlede boş bir kareye yeni taş
// (%90 "2", %10 "4") düşer. Tahta dolup hamle kalmayınca oyun biter.
//
// Motor kullanımı yılan gibi: entity YOK — durum 4x4 dizide, çizim ciz_ustune
// ile elle. sahne/skor/oyun-bitti/HUD motordan bedava gelir.


int tf_GRID = 4;
array tf_grid = [];       // 4x4 (row-major); 0 = boş
int tf_moved = 0;         // son hamlede bir şey oynadı mı?
int tf_gain = 0;          // son hamlenin puanı (birleşmelerin toplamı)

// Kare tahta, 640x480 dünyada ortalanmış.
int tf_CELL = 92;
int tf_GAP = 8;
int tf_OX = 124;          // (640 - (4*92+3*8)) / 2 ≈ 116, +gap payı
int tf_OY = 74;

// Boş kareye rastgele yeni taş koy (%10 "4", %90 "2").
func tf_yeni_tas() {
    array boslar = [];
    for (int i = 0; i < 16; i = i + 1) {
        if (toInt(tf_grid[i]) == 0) { push(boslar, i); }
    }
    if (length(boslar) == 0) { return; }
    int idx = toInt(boslar[randint(0, length(boslar) - 1)]);
    int v = 2;
    if (randint(0, 9) == 0) { v = 4; }
    tf_grid[idx] = v;
}

// Her (re)başlatmada çağrılır: tahtayı sıfırla + iki taş koy.
func tf_kur() {
    tf_grid = [];
    for (int i = 0; i < 16; i = i + 1) { push(tf_grid, 0); }
    tf_moved = 0;
    tf_gain = 0;
    tf_yeni_tas();
    tf_yeni_tas();
}

// Verilen 4 index'i (gidiş yönünde) sıkıştır + birleştir + geri yaz.
// Global `moved`/`gain` güncellenir (dört yön aynı ilkeli çağırır).
func tf_satir(i0, i1, i2, i3) {
    array v = [];
    if (toInt(tf_grid[i0]) != 0) { push(v, toInt(tf_grid[i0])); }
    if (toInt(tf_grid[i1]) != 0) { push(v, toInt(tf_grid[i1])); }
    if (toInt(tf_grid[i2]) != 0) { push(v, toInt(tf_grid[i2])); }
    if (toInt(tf_grid[i3]) != 0) { push(v, toInt(tf_grid[i3])); }
    array out = [];
    int k = 0;
    while (k < length(v)) {
        if (k + 1 < length(v) && toInt(v[k]) == toInt(v[k + 1])) {
            int m = toInt(v[k]) * 2;
            push(out, m);
            tf_gain = tf_gain + m;
            k = k + 2;
        } else {
            push(out, toInt(v[k]));
            k = k + 1;
        }
    }
    while (length(out) < 4) { push(out, 0); }
    if (toInt(tf_grid[i0]) != toInt(out[0])) { tf_moved = 1; }
    if (toInt(tf_grid[i1]) != toInt(out[1])) { tf_moved = 1; }
    if (toInt(tf_grid[i2]) != toInt(out[2])) { tf_moved = 1; }
    if (toInt(tf_grid[i3]) != toInt(out[3])) { tf_moved = 1; }
    tf_grid[i0] = toInt(out[0]); tf_grid[i1] = toInt(out[1]);
    tf_grid[i2] = toInt(out[2]); tf_grid[i3] = toInt(out[3]);
}

// yon: 0=sol 1=sag 2=yukari 3=asagi
func tf_hamle(yon) {
    tf_moved = 0;
    tf_gain = 0;
    if (yon == 0)      { tf_satir(0,1,2,3);   tf_satir(4,5,6,7);   tf_satir(8,9,10,11);  tf_satir(12,13,14,15); }
    else if (yon == 1) { tf_satir(3,2,1,0);   tf_satir(7,6,5,4);   tf_satir(11,10,9,8);  tf_satir(15,14,13,12); }
    else if (yon == 2) { tf_satir(0,4,8,12);  tf_satir(1,5,9,13);  tf_satir(2,6,10,14);  tf_satir(3,7,11,15); }
    else               { tf_satir(12,8,4,0);  tf_satir(13,9,5,1);  tf_satir(14,10,6,2);  tf_satir(15,11,7,3); }
    if (tf_moved == 1) {
        if (tf_gain > 0) { skor_ekle(tf_gain); }
        tf_yeni_tas();
    }
}

// Hâlâ hamle var mı? (boş kare ya da birleşebilir komşu)
func tf_hamle_var(): bool {
    for (int i = 0; i < 16; i = i + 1) {
        if (toInt(tf_grid[i]) == 0) { return true; }
    }
    for (int r = 0; r < 4; r = r + 1) {
        for (int c = 0; c < 3; c = c + 1) {
            if (toInt(tf_grid[r * 4 + c]) == toInt(tf_grid[r * 4 + c + 1])) { return true; }
        }
    }
    for (int c = 0; c < 4; c = c + 1) {
        for (int r = 0; r < 3; r = r + 1) {
            if (toInt(tf_grid[r * 4 + c]) == toInt(tf_grid[(r + 1) * 4 + c])) { return true; }
        }
    }
    return false;
}

func tf_kare() {
    int yon = 0 - 1;
    if (kaydirildi("sol")    || key_pressed("LEFT")  || key_pressed("A")) { yon = 0; }
    else if (kaydirildi("sag")    || key_pressed("RIGHT") || key_pressed("D")) { yon = 1; }
    else if (kaydirildi("yukari") || key_pressed("UP")    || key_pressed("W")) { yon = 2; }
    else if (kaydirildi("asagi")  || key_pressed("DOWN")  || key_pressed("S")) { yon = 3; }
    if (yon >= 0) {
        tf_hamle(yon);
        if (!tf_hamle_var()) { oyun_bitti(); }
    }
}

// Taş rengi (değere göre).
func tf_tas_renk(v): int {
    if (v == 0)    { return rgb(40, 44, 60); }
    if (v == 2)    { return rgb(120, 160, 220); }
    if (v == 4)    { return rgb(100, 200, 180); }
    if (v == 8)    { return rgb(230, 180, 90); }
    if (v == 16)   { return rgb(235, 150, 70); }
    if (v == 32)   { return rgb(235, 110, 80); }
    if (v == 64)   { return rgb(230, 80, 80); }
    if (v == 128)  { return rgb(240, 210, 100); }
    if (v == 256)  { return rgb(240, 205, 70); }
    if (v == 512)  { return rgb(240, 200, 50); }
    if (v == 1024) { return rgb(245, 195, 30); }
    return rgb(250, 190, 0);
}

func tf_ciz() {
    // Tahta çerçevesi
    rect(tf_OX - tf_GAP, tf_OY - tf_GAP, tf_GRID * tf_CELL + (tf_GRID + 1) * tf_GAP,
         tf_GRID * tf_CELL + (tf_GRID + 1) * tf_GAP, rgb(28, 30, 42));
    for (int r = 0; r < 4; r = r + 1) {
        for (int c = 0; c < 4; c = c + 1) {
            int v = toInt(tf_grid[r * 4 + c]);
            int x = tf_OX + c * (tf_CELL + tf_GAP);
            int y = tf_OY + r * (tf_CELL + tf_GAP);
            rect(x, y, tf_CELL, tf_CELL, tf_tas_renk(v));
            if (v != 0) {
                str t = toString(v);
                int sz = 40;
                if (v >= 1000) { sz = 26; }
                else if (v >= 100) { sz = 34; }
                int col = rgb(30, 30, 40);
                if (v <= 4) { col = WHITE; }
                text(t, toInt(x + (tf_CELL - measure_text(t, sz)) / 2.0),
                     toInt(y + (tf_CELL - sz * 1.0) / 2.0), sz, col);
            }
        }
    }
}

yildiz_hedef(100, 400, 1000);   // sonsuz oyun: skor esiginden yildiz (1/2/3)

func tf_setup() {
    bilgi("Parmaginla KAYDIR (mobil) / ok tuslari (masaustu)  |  Ayni sayilar toplanir");
    kontrol_semasi("yok");    // ekranda buton YOK — sadece kaydirma jesti (+masaustu ok tuslari)
    baslangicta(tf_kur);
    her_kare(tf_kare);
    ciz_ustune(tf_ciz);
}

// ==========================================================================
//  Pong  (examples/arcade_pong.tpr, önek pg_)
// ==========================================================================
// Pong — arcade motoru, yapay zekâya karşı ralli. Sonsuz: her başarılı iaden
// +1; topu kaçırınca oyun biter. Skor = üst üste kaç kez iade ettiğin.
//
//   ./tulpar examples/arcade_pong.tpr
//
// Yukarı/Aşağı (W/S) ya da mobilde ok butonlarıyla sol raketi sür. Top hızlanır;
// AI raketi topu takip eder ama sınırlı hızda (yenilebilir). AI ıskalarsa top
// sağ duvardan seker (oyun sürer) — yalnız SEN ıskalayınca biter.
//
// Motor kullanımı: raketler + top entity; hareket/AI her_kare içinde, çarpışma
// callback'leri iade + sekme yapar.


int pg_player = 0;
int pg_ai = 0;
int pg_ball = 0;
float pg_bspeed = 300.0;   // top hızı (px/sn) — her iadede biraz artar
int pg_PW = 14;            // raket genişliği
int pg_PH = 90;            // raket yüksekliği

// Topu ortadan `dir` yönüne (−1 sol / +1 sağ) hafif dikey açıyla servis et.
func pg_servis(dir) {
    konumla(pg_ball, 313, 233);
    float ay = (random() - 0.5) * 1.2;
    hiz_ver(pg_ball, dir * pg_bspeed, sin(ay) * pg_bspeed);
}

func pg_kur() {
    temizle();
    pg_bspeed = 300.0;
    pg_player = uret(20,  195, pg_PW, pg_PH, SKYBLUE, TAG_PLAYER, MV_NONE);
    pg_ai     = uret(606, 195, pg_PW, pg_PH, RED,     TAG_ENEMY,  MV_NONE);
    pg_ball   = uret(313, 233, 14, 14, GOLD,    TAG_BULLET, MV_VELOCITY);
    pg_servis(0 - 1);
}

func pg_abs_f(v): float { if (v < 0.0) { return 0.0 - v; } return v; }

func pg_kare() {
    float dt = frame_time();
    if (dt <= 0.0) { dt = 0.0166667; }
    if (dt > 0.05) { dt = 0.05; }

    // Oyuncu raketi: yukarı/aşağı (klavye VEYA dokunmatik)
    float py = y_of(pg_player);
    if (yukari()) { py = py - 380.0 * dt; }
    if (asagi())  { py = py + 380.0 * dt; }
    if (py < 0.0) { py = 0.0; }
    if (py > 480.0 - pg_PH * 1.0) { py = 480.0 - pg_PH; }
    konumla(pg_player, 20, py);

    // AI raketi: topu takip et (sınırlı hız → yenilebilir)
    float ay = y_of(pg_ai);
    float hedef = y_of(pg_ball) - pg_PH * 0.5;
    float d = hedef - ay;
    float lim = 250.0 * dt;
    if (d > lim) { d = lim; }
    if (d < 0.0 - lim) { d = 0.0 - lim; }
    ay = ay + d;
    if (ay < 0.0) { ay = 0.0; }
    if (ay > 480.0 - pg_PH * 1.0) { ay = 480.0 - pg_PH; }
    konumla(pg_ai, 606, ay);

    // Top: üst/alt duvardan sek
    float bx = x_of(pg_ball);
    float by = y_of(pg_ball);
    float bvx = vx_of(pg_ball);
    float bvy = vy_of(pg_ball);
    if (by < 0.0 && bvy < 0.0) { bvy = 0.0 - bvy; }
    if (by > 480.0 - 14.0 && bvy > 0.0) { bvy = 0.0 - bvy; }
    hiz_ver(pg_ball, bvx, bvy);

    // Oyuncu ıskaladı → oyun biter
    if (bx < 0.0 - 14.0) { oyun_bitti(); return; }
    // AI ıskaladı → sağ duvardan sek (oyun sürer)
    if (bx > 640.0 && bvx > 0.0) {
        konumla(pg_ball, 640.0 - 16.0, by);
        hiz_ver(pg_ball, 0.0 - pg_abs_f(bvx), bvy);
    }
}

// Top oyuncu raketine değince: sağa sek + rakete göre açı + hızlan, +1.
func pg_vur_cb() {
    int b = oteki();
    float rel = (y_of(b) + 7.0) - (y_of(pg_player) + pg_PH * 0.5);
    pg_bspeed = pg_bspeed + 14.0;
    if (pg_bspeed > 540.0) { pg_bspeed = 540.0; }
    float nvy = (rel / (pg_PH * 0.5)) * pg_bspeed * 0.8;
    hiz_ver(b, pg_bspeed, nvy);
    konumla(b, 20.0 + pg_PW, y_of(b));
    skor_ekle(1);
    patlama(20.0 + pg_PW + 7.0, y_of(b) + 7.0, SKYBLUE);
}

// Top AI raketine değince: sola sek + açı (skor yok).
func pg_ai_cb() {
    int b = oteki();
    float rel = (y_of(b) + 7.0) - (y_of(pg_ai) + pg_PH * 0.5);
    float nvy = (rel / (pg_PH * 0.5)) * pg_bspeed * 0.8;
    hiz_ver(b, 0.0 - pg_bspeed, nvy);
    konumla(b, 606.0 - 14.0, y_of(b));
}

yildiz_hedef(5, 15, 30);        // sonsuz oyun: rally sayisindan yildiz (1/2/3)

func pg_setup() {
    bilgi("Yukari/Asagi veya W/S: raket  |  Topu kacirma, her iade +1");
    kontrol_semasi("dikey");  // mobilde YUKARI/ASAGI ok butonlari (raket dikey hareket)
    baslangicta(pg_kur);
    her_kare(pg_kare);
    carpisinca(TAG_PLAYER, TAG_BULLET, pg_vur_cb);
    carpisinca(TAG_ENEMY,  TAG_BULLET, pg_ai_cb);
}

// ==========================================================================
//  Vur  (examples/arcade_vur.tpr, önek vr_)
// ==========================================================================
// Vur (köstebek/refleks) — arcade motoru, 3x3 ızgara. Yanan kareye zamanında
// dokun (+1); köstebek kaçarsa (süre biterse) oyun biter. Her vuruşta süre
// kısalır → giderek hızlanır. Skor = kaç köstebeğe zamanında vurduğun.
//
//   ./tulpar examples/arcade_vur.tpr
//
// Saf dokunma (masaüstünde fare de dokunma sayılır). Hareket/joystick YOK.
// Motor kullanımı yılan/2048 gibi: durum global, çizim ciz_ustune ile elle.


int vr_GC = 3;            // 3x3
int vr_CELL = 120;
int vr_GAP = 16;
int vr_OX = 116;          // (640 - (3*120+2*16)) / 2 = 116
int vr_OY = 70;
int vr_mole = 0;          // aktif hücre (0..8), -1 = yok
float vr_mtimer = 0.0;    // bu köstebeğin kalan süresi (sn)
float vr_mlimit = 1.10;   // güncel süre limiti (her vuruşta kısalır)
int vr_prevn = 0;         // dokunma edge sayacı

func vr_hucre_x(i): int { return vr_OX + mod(i, vr_GC) * (vr_CELL + vr_GAP); }
func vr_hucre_y(i): int { return vr_OY + toInt(i / vr_GC) * (vr_CELL + vr_GAP); }

// Yeni köstebek: rastgele hücre (aynı yere düşme), süreyi sıfırla.
func vr_yeni_mole() {
    int m = randint(0, 8);
    if (m == vr_mole) { m = mod(m + 1, 9); }
    vr_mole = m;
    vr_mtimer = vr_mlimit;
}

func vr_kur() {
    vr_mlimit = 1.10;
    vr_mole = 0 - 1;
    vr_prevn = 0;
    vr_yeni_mole();
}

func vr_kare() {
    float dt = frame_time();
    if (dt <= 0.0) { dt = 0.0166667; }
    if (dt > 0.05) { dt = 0.05; }

    vr_mtimer = vr_mtimer - dt;
    if (vr_mtimer <= 0.0) { oyun_bitti(); return; }   // köstebek kaçtı

    int n = touch_count();
    bool tap = (n > 0) && (vr_prevn == 0);
    if (tap) {
        float tx = touch_x(0) * 1.0;
        float ty = touch_y(0) * 1.0;
        int mx = vr_hucre_x(vr_mole);
        int my = vr_hucre_y(vr_mole);
        if (tx >= mx * 1.0 && tx <= mx + vr_CELL && ty >= my * 1.0 && ty <= my + vr_CELL) {
            skor_ekle(1);
            patlama(mx + vr_CELL / 2, my + vr_CELL / 2, GOLD);
            if (vr_mlimit > 0.45) { vr_mlimit = vr_mlimit - 0.03; }   // hızlan
            vr_yeni_mole();
        }
    }
    vr_prevn = n;
}

func vr_ciz() {
    for (int i = 0; i < 9; i = i + 1) {
        int x = vr_hucre_x(i);
        int y = vr_hucre_y(i);
        if (i == vr_mole) {
            // Kalan süreye göre uyarı rengi (yeşilden kırmızıya)
            float k = vr_mtimer / vr_mlimit;
            if (k < 0.0) { k = 0.0; }
            if (k > 1.0) { k = 1.0; }
            rect(x, y, vr_CELL, vr_CELL, rgb(toInt(90 + 150 * (1.0 - k)), toInt(70 + 120 * k), 50));
            circle(x + vr_CELL / 2, y + vr_CELL / 2, toInt(vr_CELL / 3), rgb(240, 175, 60));
        } else {
            rect(x, y, vr_CELL, vr_CELL, rgb(38, 42, 58));
        }
    }
}

yildiz_hedef(10, 25, 50);       // sonsuz oyun: vurus sayisindan yildiz (1/2/3)

func vr_setup() {
    bilgi("Yanan kareye dokun (+1)  |  Kostebek kacmadan vur, giderek hizlanir");
    baslangicta(vr_kur);
    her_kare(vr_kare);
    ciz_ustune(vr_ciz);
}

