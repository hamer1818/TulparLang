// Tulpar 3D — Faz 1: primitifler + tıklama-seçim (raycast).
//
//   ./tulpar examples/tame3d_primitives.tpr
//
// Zemin düzlemi + küre / silindir / tel-küre / 3D çizgi. Fareyle bir küreye
// TIKLA → seçilir (büyür + parlar). pick_sphere() ekran ışınını küreye atar,
// vurursa mesafe döner — "en küçük pozitif mesafe = seçilen" mantığı.

import "tame";

float sel = 0.0 - 1.0;          // seçili küre indeksi (-1 = yok)

// 3 kürenin dünya konumu (paralel diziler yerine sabit — demo).
func sphere_x(i): float { if (i == 0) { return 0.0 - 3.0; } if (i == 1) { return 0.0; } return 3.0; }
func sphere_z(i): float { if (i == 0) { return 0.0; } if (i == 1) { return 0.0 - 2.0; } return 0.0; }

func main() {
    if (!window(820, 460, "Tulpar 3D — Primitifler")) { return; }
    set_fps(60);

    while (running()) {
        float t = elapsed();
        float cx = sin(t * 0.5) * 10.0;
        float cz = cos(t * 0.5) * 10.0;

        // --- Tıklama-seçim: en yakın vurulan küreyi seç ----------------------
        if (mouse_pressed(0)) {
            float mx = mouse_x();
            float my = mouse_y();
            float best = 1000000.0;
            float found = 0.0 - 1.0;
            for (int i = 0; i < 3; i = i + 1) {
                camera3d(cx, 7.0, cz,  0.0, 0.0, 0.0,  45.0);
                float d = pick_sphere(mx, my, sphere_x(i), 1.0, sphere_z(i), 1.0);
                if (d >= 0.0 && d < best) { best = d; found = i * 1.0; }
            }
            sel = found;
        }

        frame_begin();
        clear(rgb(16, 18, 26));
        camera3d(cx, 7.0, cz,  0.0, 0.0, 0.0,  45.0);   // göz, hedef, FOV

        space_begin();
            plane(0.0, 0.0, 0.0,  16.0, 16.0, rgb(30, 34, 48));   // zemin
            grid(16, 1.0);

            // 3 küre — seçili olan büyük + altın
            for (int i = 0; i < 3; i = i + 1) {
                float r = 1.0;
                int col = rgb(90, 200, 255);
                if (sel == i * 1.0) { r = 1.4; col = GOLD; }
                sphere(sphere_x(i), 1.0, sphere_z(i), r, col);
            }

            cylinder(0.0 - 5.0, 0.0, 4.0,  0.8, 3.0, rgb(255, 130, 90));  // silindir
            sphere_wires(5.0, 1.5, 3.0,  1.3, 12, rgb(180, 255, 160));    // tel-küre
            line3d(0.0 - 6.0, 0.1, 0.0 - 6.0,  6.0, 0.1, 6.0, GOLD);      // 3D çizgi
        space_end();

        text("Tulpar 3D — Faz 1: primitifler + raycast", 14, 12, 20, RAYWHITE);
        text("Bir kureye TIKLA -> secilir (buyur/parlar)", 14, 38, 15, rgb(150, 160, 180));
        frame_end();
    }
    close_window();
}

main();
