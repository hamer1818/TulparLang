// Tulpar 3D — Faz 4: ışıklandırma (yönlü güneş + nokta ışıklar).
//
//   ./tulpar examples/tame3d_lights.tpr
//
// BOŞLUK: ışığı aç/kapat — aynı sahne, düz renk vs gölgeli yüzey.
// Gömülü Blinn-Phong shader; asset dosyası yok, masaüstü GL3.3 ve
// web/Android GLES2 varyantları derleyicinin içinde.
//
// Dikkat: ışık açıkken küre/silindir/düzlem, normal'i doğru olan birim
// mesh'ler üzerinden çizilir (raylib'in immediate-mode DrawSphere'i normal
// üretmez, ışık altında yanlış gölgelenirdi) — bu tame içinde hallediliyor,
// oyun kodu değişmiyor.

import "tame";

bool isikli = true;
bool dokundu_onceki = false;   // dokunuşu kenar-tetikli okumak için

func main() {
    if (!window(880, 500, "Tulpar 3D — Isiklandirma")) { return; }
    set_fps(60);

    lights_on();
    sun(0.0 - 0.55, 0.0 - 1.0, 0.0 - 0.35, rgb(255, 246, 224));  // güneş (YÖN)
    point_light(1, 4.0, 3.0, 0.0 - 4.0, rgb(255, 120, 60));       // sıcak nokta
    point_light(2, 0.0 - 5.0, 2.5, 4.0, rgb(80, 140, 255));       // soğuk nokta
    ambient_light(rgb(40, 44, 60));

    while (running()) {
        float t = elapsed();

        // BOŞLUK (masaüstü) veya EKRANA DOKUN (mobil) → ışığı aç/kapat.
        // Dokunuşu kenar-tetikli okuyoruz: parmak basılı tutunca her karede
        // tekrar tetiklenip ışık titremesin.
        bool dokunuluyor = touch_count() > 0;
        if (key_pressed(32) || (dokunuluyor && !dokundu_onceki)) {
            isikli = !isikli;
            if (isikli) { lights_on(); } else { lights_off(); }
        }
        dokundu_onceki = dokunuluyor;

        float cx = sin(t * 0.3) * 13.0;
        float cz = cos(t * 0.3) * 13.0;

        frame_begin();
        clear(rgb(14, 16, 24));
        camera3d(cx, 7.5, cz,  0.0, 1.0, 0.0,  45.0);

        space_begin();
            plane(0.0, 0.0, 0.0,  26.0, 26.0, rgb(70, 74, 88));   // zemin
            // Küreler — ışığın en belirgin göründüğü yüzey (yumuşak geçiş).
            sphere(0.0 - 4.0, 1.6, 0.0,  1.6, rgb(220, 90, 90));
            sphere(0.0,       1.6, 0.0,  1.6, rgb(90, 200, 120));
            sphere(4.0,       1.6, 0.0,  1.6, rgb(110, 150, 240));
            // Kutular — yüzey normallerine göre farklı parlaklıkta yüzler.
            cube(0.0 - 7.0, 1.2, 0.0 - 5.0,  2.4, 2.4, 2.4, rgb(230, 190, 90));
            cube(7.0,       1.2, 0.0 - 5.0,  2.4, 2.4, 2.4, rgb(230, 190, 90));
            // Silindirler
            cylinder(0.0 - 4.0, 0.0, 5.0,  1.0, 3.2, rgb(190, 120, 220));
            cylinder(4.0,       0.0, 5.0,  1.0, 3.2, rgb(190, 120, 220));
        space_end();

        text("Tulpar 3D — Isiklandirma", 14, 12, 22, RAYWHITE);
        if (isikli) {
            text("Isik: ACIK  — BOSLUK / EKRANA DOKUN ile kapat", 14, 40, 16, rgb(150, 230, 150));
        } else {
            text("Isik: KAPALI — BOSLUK / EKRANA DOKUN ile ac", 14, 40, 16, rgb(230, 150, 150));
        }
        frame_end();
    }
    close_window();
}

main();
